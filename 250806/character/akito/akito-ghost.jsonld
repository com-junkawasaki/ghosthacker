{
  "@context": {
    "@base": "https://gftd.ai/ghost-hacker/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "gh": "https://gftd.ai/gh#",

    "Person": "https://schema.org/Person",
    "Ghost": "gh:Ghost",
    "Ability": "gh:Ability",

    "name": { "@id": "schema:name", "@type": "xsd:string" },
    "description": { "@id": "schema:description", "@type": "xsd:string" },
    "ghostType": { "@id": "gh:ghostType", "@type": "xsd:string" },
    "master": { "@id": "gh:master", "@type": "@id" },
    "hasAbility": { "@id": "gh:hasAbility", "@type": "@id" },
    "appearance": { "@id": "gh:appearance", "@type": "xsd:string" },
    "sameAs": { "@id": "schema:sameAs", "@type": "@id" }
  },
  "@graph": [
    {
      "@id": "ghost:kageboushi",
      "@type": ["Person", "Ghost"],
      "name": "Kageboushi (カゲボウシ)",
      "ghostType": "感情投影型",
      "description": "Akitoの喪失感と後悔が無意識に形となったGhost。Akito自身の影法師であり、封印した情熱や悲しみの化身。",
      "master": { "@id": "character:akito" },
      "hasAbility": [
        {
          "@id": "gh:Ability/FormMimicry",
          "@type": "Ability",
          "name": "形態模倣 (Form Mimicry)",
          "description": "Akitoの感情に呼応し、記憶の人物や風景、抽象イメージを断片的に映し出す。若き日のRenの姿をとることが多い。"
        },
        {
          "@id": "gh:Ability/NonInterference",
          "@type": "Ability",
          "name": "無干渉",
          "description": "外界に物理・情報的干渉を行わない。傍らに在り、心を映す鏡として機能する。"
        },
        {
          "@id": "gh:Ability/Uncontrollable",
          "@type": "Ability",
          "name": "制御不能",
          "description": "AkitoもこのGhostを明確に認識できず、意図的制御はできない。睡眠や深い思索時にふと現れる。"
        }
      ],
      "appearance": "定まった姿を持たない黒い影。輪郭は揺らぎ、人型やノイズのように掻き消える。声は発さないが存在自体が感情を物語る。",
      "sameAs": "250806/character/akito/ghost.md"
    }
  ]
}


