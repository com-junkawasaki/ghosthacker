  "@graph": [
    {
      "@id": "gh:PortraitPrompt/akito",
      "@type": "PortraitPrompt",
      "name": "Akito Portrait Prompt",
      "about": { "@id": "character:akito" },
      "subject": "50代後半の伝説的エンジニア／TOL共同設立者。静かで圧倒的な存在感と深い知性。",
      "appearance": "シャープな輪郭と目元の皺。白髪と髭は整えられ、神話的オーラ。ゆったりだが隙のない佇まい。",
      "style": "黒のハイネック＋ダークグレーの機能的ジャケット。黒レザーシューズ。左腕に精巧な機械式腕時計。",
      "lighting": "レンブラント風の陰影。単一光源が顔の半分を照らし、スクリーンの逆光が輪郭を縁取る。",
      "composition": "バストショット。静かにこちらを見る、または遠くを見つめる瞬間。静寂・知性・カリスマの重厚な物語性。",
      "quality": "超高解像度のシネマティックフォト（8K）。肌・衣服・瞳・背景機材の細部まで鮮明。",
      "sameAs": "250806/character/akito/portrait.md"
    }
  ]
}


