    "appearance": { "@id": "gh:appearance", "@type": "xsd:string" },
    "style": { "@id": "gh:style", "@type": "xsd:string" },
    "lighting": { "@id": "gh:lighting", "@type": "xsd:string" },
    "composition": { "@id": "gh:composition", "@type": "xsd:string" },
    "quality": { "@id": "gh:quality", "@type": "xsd:string" },
