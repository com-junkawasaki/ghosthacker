{
  "@context": {
    "@base": "https://gftd.ai/ghost-hacker/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "gh": "https://gftd.ai/gh#",

    "Person": "https://schema.org/Person",
    "Ghost": "gh:Ghost",
    "Ability": "gh:Ability",
    "name": { "@id": "schema:name", "@type": "xsd:string" },
    "description": { "@id": "schema:description", "@type": "xsd:string" },
    "ghostType": { "@id": "gh:ghostType", "@type": "xsd:string" },
    "master": { "@id": "gh:master", "@type": "@id" },
    "hasAbility": { "@id": "gh:hasAbility", "@type": "@id" },
    "appearance": { "@id": "gh:appearance", "@type": "xsd:string" },
    "sameAs": { "@id": "schema:sameAs", "@type": "@id" }
  },
  "@graph": [
    {
      "@id": "ghost:sudama",
      "@type": ["Person", "Ghost"],
      "name": "Sudama (スダマ)",
      "ghostType": "精霊型 / 共感増幅型",
      "description": "Aoiの純粋な魂に呼応して生まれた幼いGhost。木霊（すだま）に由来。",
      "master": { "@id": "character:aoi" },
      "hasAbility": [
        { "@id": "gh:Ability/EmotionVisualization", "@type": "Ability", "name": "感情の可視化", "description": "感情を色として感じ取り伝達。" },
        { "@id": "gh:Ability/PotentialGrowth", "@type": "Ability", "name": "成長性", "description": "Aoiの成長に伴い能力が発達。" },
        { "@id": "gh:Ability/PurityShield", "@type": "Ability", "name": "純粋性の盾", "description": "悪意あるGhostの精神攻撃を無意識に弾くことがある。" }
      ],
      "appearance": "淡い光に包まれた小さな子の姿。感情で光の色が変化し、Aoiの周囲を漂う。",
      "sameAs": "250806/character/aoi/ghost.md"
    }
  ]
}


