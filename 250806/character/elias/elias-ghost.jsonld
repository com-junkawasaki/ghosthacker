{
  "@context": {
    "@base": "https://gftd.ai/ghost-hacker/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "gh": "https://gftd.ai/gh#",

    "Person": "https://schema.org/Person",
    "Ghost": "gh:Ghost",
    "Ability": "gh:Ability",
    "name": { "@id": "schema:name", "@type": "xsd:string" },
    "description": { "@id": "schema:description", "@type": "xsd:string" },
    "ghostType": { "@id": "gh:ghostType", "@type": "xsd:string" },
    "master": { "@id": "gh:master", "@type": "@id" },
    "motif": { "@id": "gh:motif", "@type": "xsd:string" },
    "sameAs": { "@id": "schema:sameAs", "@type": "@id" }
  },
  "@graph": [
    {
      "@id": "ghost:logos",
      "@type": ["Person", "Ghost"],
      "name": "Logos",
      "ghostType": "Human-derived",
      "description": "Eliasの『愛したい』という祈りと神学的苦悩から生まれた新しい個。論理と対話でEliasを導く。",
      "master": { "@id": "character:elias" },
      "motif": "梟（知恵の象徴）。半透明の梟の姿で傍らに佇む。",
      "sameAs": "250806/character/elias/ghost.md"
    }
  ]
}


