{
  "@context": {
    "@base": "https://gftd.ai/ghost-hacker/",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "gh": "https://gftd.ai/gh#",

    "EmotionalPlan": "gh:EmotionalPlan",
    "EmotionalBeat": "gh:EmotionalBeat",
    "EmotionScore": "gh:EmotionScore",

    "episode": { "@id": "gh:episode", "@type": "@id" },
    "name": { "@id": "schema:name", "@type": "xsd:string" },
    "description": { "@id": "schema:description", "@type": "xsd:string" },
    "beats": { "@id": "gh:beats", "@type": "@id" },
    "position": { "@id": "gh:position", "@type": "xsd:integer" },
    "motifs": { "@id": "gh:motifs", "@type": "@id" },
    "targetVector": { "@id": "gh:targetVector", "@type": "@id" },
    "emotion": { "@id": "gh:emotion", "@type": "xsd:string" },
    "score": { "@id": "gh:score", "@type": "xsd:float" }
  },
  "@graph": [
    {
      "@id": "gh:EmotionalPlan/S1E1",
      "@type": "EmotionalPlan",
      "episode": { "@id": "gh:Episode/S1E1" },
      "name": "S1E1: 孤独→共感→緊張→解放→余韻",
      "description": "非分離の気配を示しつつ、孤独から解放と再生に至るアーク。",
      "beats": [
        {
          "@type": "EmotionalBeat",
          "position": 1,
          "name": "導入: 静かな孤独",
          "motifs": [ { "@id": "gh:Motif/Library" }, { "@id": "gh:Motif/Water" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "sadness", "score": 0.35 },
            { "@type": "EmotionScore", "emotion": "trust", "score": 0.2 },
            { "@type": "EmotionScore", "emotion": "anticipation", "score": 0.15 },
            { "@type": "EmotionScore", "emotion": "fear", "score": 0.1 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 2,
          "name": "共感の接続",
          "motifs": [ { "@id": "gh:Motif/NonSeparation" }, { "@id": "gh:Motif/Light" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "trust", "score": 0.3 },
            { "@type": "EmotionScore", "emotion": "anticipation", "score": 0.25 },
            { "@type": "EmotionScore", "emotion": "sadness", "score": 0.2 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 3,
          "name": "緊張の沈降",
          "motifs": [ { "@id": "gh:Motif/Static" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "fear", "score": 0.35 },
            { "@type": "EmotionScore", "emotion": "anger", "score": 0.2 },
            { "@type": "EmotionScore", "emotion": "disgust", "score": 0.15 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 4,
          "name": "転換: 非分離の発見",
          "motifs": [ { "@id": "gh:Motif/NonSeparation" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "surprise", "score": 0.15 },
            { "@type": "EmotionScore", "emotion": "trust", "score": 0.25 },
            { "@type": "EmotionScore", "emotion": "anticipation", "score": 0.2 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 5,
          "name": "解放と再生",
          "motifs": [ { "@id": "gh:Motif/Forgiveness" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "relief", "score": 0.35 },
            { "@type": "EmotionScore", "emotion": "joy", "score": 0.3 },
            { "@type": "EmotionScore", "emotion": "hope", "score": 0.25 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 6,
          "name": "余韻: 静かな肯定",
          "motifs": [ { "@id": "gh:Motif/Water" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "trust", "score": 0.35 },
            { "@type": "EmotionScore", "emotion": "relief", "score": 0.3 },
            { "@type": "EmotionScore", "emotion": "joy", "score": 0.2 }
          ]
        }
      ]
    },
    {
      "@id": "gh:EmotionalPlan/S2E2",
      "@type": "EmotionalPlan",
      "episode": { "@id": "gh:Episode/S2E2" },
      "name": "S2E2: 愛/依存の区別 → 赦しの手触り",
      "description": "所有的依存からケアとしての愛へ。痛みを通過して赦しに着地。",
      "beats": [
        {
          "@type": "EmotionalBeat",
          "position": 1,
          "name": "約束: やさしい始まり",
          "motifs": [ { "@id": "gh:Motif/Promise" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "anticipation", "score": 0.3 },
            { "@type": "EmotionScore", "emotion": "joy", "score": 0.25 },
            { "@type": "EmotionScore", "emotion": "trust", "score": 0.2 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 2,
          "name": "摩擦とズレ",
          "motifs": [ { "@id": "gh:Motif/Cat" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "sadness", "score": 0.25 },
            { "@type": "EmotionScore", "emotion": "fear", "score": 0.2 },
            { "@type": "EmotionScore", "emotion": "anger", "score": 0.15 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 3,
          "name": "代償の可視化",
          "motifs": [ { "@id": "gh:Motif/Debt" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "sadness", "score": 0.35 },
            { "@type": "EmotionScore", "emotion": "disgust", "score": 0.15 },
            { "@type": "EmotionScore", "emotion": "fear", "score": 0.15 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 4,
          "name": "転換: ケアの定義",
          "motifs": [ { "@id": "gh:Motif/Forgiveness" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "trust", "score": 0.25 },
            { "@type": "EmotionScore", "emotion": "anticipation", "score": 0.2 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 5,
          "name": "赦しと再接続",
          "motifs": [ { "@id": "gh:Motif/Forgiveness" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "relief", "score": 0.35 },
            { "@type": "EmotionScore", "emotion": "joy", "score": 0.25 },
            { "@type": "EmotionScore", "emotion": "hope", "score": 0.25 }
          ]
        },
        {
          "@type": "EmotionalBeat",
          "position": 6,
          "name": "余韻: 静かな承認",
          "motifs": [ { "@id": "gh:Motif/GoodFeeling" } ],
          "targetVector": [
            { "@type": "EmotionScore", "emotion": "trust", "score": 0.35 },
            { "@type": "EmotionScore", "emotion": "relief", "score": 0.3 },
            { "@type": "EmotionScore", "emotion": "joy", "score": 0.2 }
          ]
        }
      ]
    }
  ]
}


