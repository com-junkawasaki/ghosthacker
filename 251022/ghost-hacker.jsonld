    },

    {
      "@id": "character:lonely-rationalist",
      "@type": "Person",
      "name": "Lonely Rationalist",
      "description": "分離前提の理性主義。孤独バグの担体。",
      "gh:callsign": "SILENT-LIBRARIAN",
      "gh:persona": "静寂の司書",
      "gh:ghost": { "@id": "ghost:silent-librarian" }
    },
    {
      "@id": "ghost:silent-librarian",
