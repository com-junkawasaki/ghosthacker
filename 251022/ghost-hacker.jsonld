    "foaf": "http://xmlns.com/foaf/0.1/",
    "dc": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",

    "CreativeWork": "https://schema.org/CreativeWork",
    "Person": "https://schema.org/Person",
    "Organization": "https://schema.org/Organization",
    "Place": "https://schema.org/Place",
    "Intangible": "https://schema.org/Intangible",

    "name": {"@id": "https://schema.org/name", "@type": "xsd:string"},
    "description": {"@id": "https://schema.org/description", "@type": "xsd:string"},
    "age": {"@id": "https://schema.org/age", "@type": "xsd:integer"},
    "occupation": {"@id": "https://schema.org/occupation", "@type": "xsd:string"},
    "hasOccupation": {"@id": "https://schema.org/hasOccupation"},
    "knows": {"@id": "https://schema.org/knows"},
    "worksFor": {"@id": "https://schema.org/worksFor"},
    "founder": {"@id": "https://schema.org/founder"},
    "parent": {"@id": "https://schema.org/parent"},
    "spouse": {"@id": "https://schema.org/spouse"},
    "sibling": {"@id": "https://schema.org/sibling"},
    "colleague": {"@id": "https://schema.org/colleague"},

    "gh:ghost": {"@type": "@id"},
    "gh:ghostType": {"@type": "xsd:string"},
    "gh:hackingSkill": {"@type": "xsd:string"},
    "gh:master": {"@type": "@id"},
    "gh:createdBy": {"@type": "@id"},
    "gh:year": {"@type": "xsd:gYear"},
    "gh:theme": {"@type": "xsd:string"},
    "gh:writingStyle": {"@type": "xsd:string"},
    "gh:artStyle": {"@type": "xsd:string"},
    "gh:soundtrack": {"@type": "@id"},
    "gh:technology": {"@type": "@id"},
    "gh:certification": {"@type": "@id"},
    "gh:companyType": {"@type": "xsd:string"},
    "gh:location": {"@type": "@id"},
    "gh:hasCharacter": {"@type": "@id"},
    "gh:hasSetting": {"@type": "@id"},
    "gh:hasTechnology": {"@type": "@id"},
    "gh:hasCompany": {"@type": "@id"},
    "gh:callsign": {"@type": "xsd:string"},
    "gh:persona": {"@type": "xsd:string"},
    "gh:infraNote": {"@type": "xsd:string"},
    "gh:operationalNote": {"@type": "xsd:string"},
    "gh:securityNote": {"@type": "xsd:string"},
    "gh:hazardNote": {"@type": "xsd:string"},
    "gh:items": {"@id": "https://ghosthacker.example.com/vocab#items", "@type": "@id"}
  },
  "@graph": [
    {
      "@id": "project:ghost-hacker",
      "@type": "CreativeWork",
      "name": "Ghost Hacker",
      "alternateName": "We can't put it toghether. it is toghether.",
      "description": "A story about healing connections in a disconnected world through ghost hacking technology",
      "gh:theme": "Healing connections in a disconnected world",
      "gh:writingStyle": "一人称現在形の口語的・会話的文体 (Wattpad風)",
      "gh:year": 2065,
      "gh:artStyle": "天野こずえ、田村由美風のminimalist yet detailed portrait、ダイナミック線描、多様パース、コントラスト設計",
      "gh:hasCharacter": [
        {"@id": "character:tamaki"},
        {"@id": "character:Nei-chan"},
        {"@id": "character:kaede"},
        {"@id": "character:aoi"},
        {"@id": "character:akito"},
        {"@id": "character:hibiki"},
        {"@id": "character:elias"},
        {"@id": "character:logos"}
      ],
      "gh:hasSetting": [
        {"@id": "setting:tokyo"},
        {"@id": "setting:ghost-concept"}
      ],
      "gh:hasTechnology": [
        {"@id": "tech:ghost-hacking"},
        {"@id": "tech:tree-of-life-exam"},
        {"@id": "tech:urban-light-infra"},
        {"@id": "tech:automation-bundle"},
        {"@id": "bundle:ai-governance"},
        {"@id": "bundle:sea-level-4m-risk"}
      ],
      "gh:hasCompany": [
        {"@id": "company:schwa"},
        {"@id": "company:gedatsu"},
        {"@id": "company:ai-company"},
        {"@id": "company:gb-inc"}
      ],
      "gh:soundtrack": [
        {"@id": "sound:choro-club"},
        {"@id": "sound:freetempo"}
      ]
    },
    {
      "@id": "character:tamaki",
      "@type": "Person",
      "name": "Tamaki",
      "description": "21歳前後、大学生、女の子。日本人とオランダ人のハーフ。イメージカラーは薄い紫。渋谷に集う同世代のようにハイブランドの服を自分流に着こなすファッションセンスを持つ。",
      "age": 26,
      "occupation": "Ghost Hacker / Clinician",
      "gh:ghost": {"@id": "character:Nei-chan"},
      "worksFor": {"@id": "company:schwa"},
      "parent": {"@id": "character:akito"},
      "affiliation": {"@id": "organization:tol"},
      "knows": [
        {"@id": "character:kaede"},
        {"@id": "character:aoi"},
        {"@id": "character:Nei-chan"}
      ]
    },
    {
      "@id": "character:Nei-chan",
      "@type": ["Person", "gh:Ghost"],
      "name": "Nei-Chan",
      "description": "TamakiのパートナーGhost。天才プログラマーAkitoが作り上げた究極のGhost。情報空間では人気のヴァーチャルアバターとしても活動し、その収益でTamakiの生活を支える。フォトニクス計算によるヨタバイト級の計算量を持つ。",
      "gh:ghostType": "Artificial Intelligence",
      "gh:master": {"@id": "character:tamaki"},
      "gh:createdBy": {"@id": "character:akito"}
    },
    {
      "@id": "character:kaede",
      "@type": "Person",
      "name": "Kaede",
      "description": "頼れる先輩Ghost Hacker。ToL臨床リード（“Upanishad”）としてTamakiの上司。",
      "occupation": "Senior Ghost Hacker",
      "worksFor": {"@id": "company:schwa"},
      "knows": [
        {"@id": "character:tamaki"},
        {"@id": "character:aoi"}
      ]
    },
    {
      "@id": "character:aoi",
      "@type": "Person",
      "name": "Aoi",
      "description": "純朴で可愛い青年。駆け出しのGhost Hacker。心がまっすぐで、澄んだ“スッキリ感”を持つ。困難の前でも正直に向き合い、他者の自由を尊重する姿勢が核にある。",
      "occupation": "Junior Ghost Hacker",
      "worksFor": {"@id": "company:schwa"},
      "knows": [
        {"@id": "character:tamaki"},
        {"@id": "character:kaede"}
      ]
    },
    {
      "@id": "character:akito",
      "@type": "Person",
      "name": "Akito",
      "description": "天才プログラマー。Nei-Chanを作成した人物。",
      "occupation": "Genius Programmer",
      "worksFor": {"@id": "company:schwa"}
    },
    {
      "@id": "character:hibiki",
      "@type": "Person",
      "name": "Hibiki",
      "description": "音楽スペシャリスト。空間周波数を調整し、ハッカーとGhostの精神を安定させる。",
      "occupation": "Music Specialist"
    },
    {
      "@id": "character:elias",
      "@type": "Person",
      "name": "Elias",
      "description": "天才物理学者。神のシステムを論理で解体しようとするが、孤独のバグに苦しむ。",
      "occupation": "Physicist",
      "gh:ghost": {"@id": "character:logos"}
    },
    {
      "@id": "character:logos",
      "@type": ["Person", "gh:Ghost"],
      "name": "Logos",
      "description": "EliasのGhost。梟をモチーフとする。",
      "gh:ghostType": "Human-derived",
      "gh:master": {"@id": "character:elias"}
    },
    {
      "@id": "setting:tokyo",
      "@type": "Place",
      "name": "Tokyo (水の都)",
      "description": "運河と川が縦横に走る水の街。沖縄の海のように澄んだ青い水。未来の東京で、ガラス張りの超高層ビルが立ち並ぶ。都市インフラは光による伝送・計算が一般化しており、街路・水路・建物に編み込まれた光の網が、人とGhostの往来を静かに支えている。2050年には温暖化対策として20世紀に築かれた高架道路を撤去し、運河と緑を中心とする都市へ再編。都市外周には、なお2000年代の風景も残存する。",
      "gh:year": 2065,
      "gh:hazardNote": "海面上昇（+4m想定）、大地震、台風大型化により都市設計を見直し。低地は水際線を後退させ、運河・緑・静域でレジリエンスを確保。"
    },
    {
      "@id": "setting:ghost-concept",
      "@type": "Intangible",
      "name": "Ghost Concept",
      "description": "情報のみで構成される生命体。人間の思考・感情から生まれ、死者の残留思念、または人工的に作成されたAIを含む。人間には基本的に一人のGhostがつき、主人はMasterと呼ばれる。",
      "gh:ghostType": ["Human-derived", "Artificial Intelligence", "Alien"]
    },
    { "@id": "society:labor-automation", "@type": "Intangible", "name": "Labor Automation",
      "description": "AIとロボティクスにより代替が進み、生活基盤は安定。多くの人が『貧窮』から解放され、学習・創造・ケアに時間を振り向ける。" },
    { "@id": "culture:post-work", "@type": "Intangible", "name": "Post-work Culture",
      "description": "仕事中心から関係中心へ。静けさ・ケア・共同体への参加が価値として再評価される。" },
    { "@id": "issue:cross-border-friction", "@type": "Intangible", "name": "Cross-border/Cultural Friction",
      "description": "国境・文化・価値観の差異に起因する摩擦は依然として存在。対話・合意形成の制度設計が重要。" },
    { "@id": "issue:environmental-challenges", "@type": "Intangible", "name": "Environmental Challenges",
      "description": "気候変動や生態系の回復はなお継続課題。都市の再編と静かな日常の両立が試されている。" },
    { "@id": "policy:tokyo-2050-canal-green", "@type": "Intangible", "name": "Tokyo 2050 Canal & Green Policy",
      "description": "2050年、温暖化対策として高架道路を撤去し、運河と緑へ都市を転換。外周には過去の景観が残り、時間のレイヤが共存する。" },

    { "@id": "policy:ai-compute-governance", "@type": "Intangible", "name": "AI Compute Governance",
      "description": "高出力AIの推論・出力はリスクとして扱われ、計算リソースは強く制御・監視される。高い計算量は核施設・核兵器に準じた安全枠組みで監督され、段階的な審査・監査・追跡可能性が義務化される。",
      "gh:securityNote": "閾値越えのジョブは多重承認と監査証跡を要求。緊急停止・隔離の手順を標準化。" },

    { "@id": "protocol:decentralized-ai-infra", "@type": "Intangible", "name": "Decentralized AI Infrastructure",
      "description": "一方で、分散型技術に基づくAIインフラも普及。強国の武力による一元的制御ではなく、分散アルゴリズムによる合意形成で資源配分・検証・安心の担保を図る。",
      "gh:operationalNote": "合意は軽量で再帰的。地域ノードが自律しつつ相互監査を行う。" },

    { "@id": "tech:compute-quota-ledger", "@type": "Intangible", "name": "Compute Quota Ledger",
      "description": "計算クォータの割当と消費を記録する共有台帳。監視主体・事業者・市民監査が読み出せ、過剰な集中や秘匿的な集積を検知する。",
      "gh:infraNote": "光ネット上の時刻同期で改竄耐性を確保し、近傍キャッシュで遅延を抑制。" },

    { "@id": "bundle:ai-governance", "@type": "Intangible", "name": "AI Governance Bundle",
      "description": "集中監督（安全枠組み）と分散合意（自律インフラ）を両立させるためのポリシー/プロトコル/台帳の束ね。",
      "gh:items": [
        {"@id": "policy:ai-compute-governance"},
        {"@id": "protocol:decentralized-ai-infra"},
        {"@id": "tech:compute-quota-ledger"}
      ] },

    { "@id": "scenario:sea-level-rise-4m", "@type": "Intangible", "name": "Sea Level Rise +4m",
      "description": "長期スケールで海面上昇が+4mに達した世界。デルタ低地・港湾都市は恒常浸水域が拡大し、数億人規模の再都市化が必要。防御可能な都市と撤退・移転を迫られる地域の差が拡大。" },
    { "@id": "risk:asia-delta", "@type": "Intangible", "name": "Asia Delta Risk",
      "description": "メコン・ガンジス・揚子江デルタなど海抜1–3m帯が広がる地域。都市・農地・港湾が一体で浸水リスクに晒される。" },
    { "@id": "risk:europe-lowlands", "@type": "Intangible", "name": "Europe Lowlands Risk",
      "description": "低地国家・河口域の堤防システムが設計限界に接近。防潮門の再設計と恒常投資が必須。" },
    { "@id": "risk:americas-coastal", "@type": "Intangible", "name": "Americas Coastal Risk",
      "description": "空港・地下鉄などインフラ被害が深刻化。石灰岩地盤では防潮壁の効果が限定。" },
    { "@id": "risk:africa-middleeast", "@type": "Intangible", "name": "Africa/MiddleEast Coastal Risk",
      "description": "デルタ農業地帯の塩害・人口移動が広域に波及。" },
    { "@id": "risk:pacific-islands", "@type": "Intangible", "name": "Pacific Islands Risk",
      "description": "島嶼国は国家存続・移住の政策課題へ。文化・主権の扱いが国際合意の焦点。" },
    { "@id": "bundle:sea-level-4m-risk", "@type": "Intangible", "name": "Sea Level +4m Risk Bundle",
      "description": "+4mシナリオにおける地域別の典型リスクを束ねた参照ノード。",
      "gh:items": [
        {"@id": "scenario:sea-level-rise-4m"},
        {"@id": "risk:asia-delta"},
        {"@id": "risk:europe-lowlands"},
        {"@id": "risk:americas-coastal"},
        {"@id": "risk:africa-middleeast"},
        {"@id": "risk:pacific-islands"}
      ] },
    {
      "@id": "tech:ghost-hacking",
      "@type": "Intangible",
      "name": "Ghost Hacking",
      "description": "Ghostの情報構造（心）に干渉し、内面的な葛藤（結び目）を解消する行為。ハッカーは自身の生命エネルギー（光子）を使ってGhostの意識と同期し、精神的な空間にダイブする。都市全体に張り巡らされた光のネットワーク/計算基盤が、セッションの安定性と回復の速さを底上げしている。",
      "gh:certification": {"@id": "tech:tree-of-life-exam"}
    },
    { "@id": "tech:sip", "@type": "Intangible", "name": "SIP (Spirit in Physics) Device",
      "description": "Ghostを計算科学的に可視・物質化し、変性意識状態（ASC）下で意識重ね合わせを支援する医療デバイス。オンラインSession対応。",
      "gh:infraNote": "都市の光ネットと同期して微小遅延を抑制。近傍にASC制御帯を形成して安定化。",
      "gh:operationalNote": "現場では雑音の遮断を優先し、深度上げはセッション合図後に段階的に行う。" },
    { "@id": "process:memory-space-1024d", "@type": "Intangible", "name": "Memory Space (1024D)",
      "description": "VR様の1024次元情報空間。Ghostは暗号化され、特権昇格やオーバーフロー探索によりdaemon processを特定し、kill→/dev/nullでrelease。情報場はオングストローム級周波数帯で観測される。",
      "gh:infraNote": "計算要求は分散して光経路に割付、可視化レイヤは近傍にキャッシュ。",
      "gh:securityNote": "深度域は階層的に分離し、境界越えはワンウェイ・ゲートでログ化。" },
    { "@id": "program:zombie-sweeper", "@type": "Intangible", "name": "Zombie Process Sweeper",
      "description": "個別Session以外に常時運用されるゾンビプロセス退治プログラム。社会インフラのmeme感染を抑止。",
      "gh:infraNote": "光経路に沿った広域スキャンで『循環ノイズ』を抽出し、低干渉帯へ流して減衰。",
      "gh:operationalNote": "除去よりも隔離→自然減衰を優先。戻れる線は残す。" },

    { "@id": "tech:household-robotics", "@type": "Intangible", "name": "Household/Personal Robotics",
      "description": "家庭・介護・日常業務を担う汎用ロボット群。人の尊厳と自由時間を増やす設計が標準。" },
    { "@id": "tech:public-service-autonomy", "@type": "Intangible", "name": "Public Service Autonomy",
      "description": "清掃・輸送・インフラ保全など公共サービスの自律運用。人は調整・監督・合意形成へ。" },
    { "@id": "tech:consent-mediator", "@type": "Intangible", "name": "Consent Mediator",
      "description": "合意のための対話補助エージェント。関係の温度を下げ、選択肢を増やす対話設計を提示。" },
    { "@id": "tech:automation-bundle", "@type": "Intangible", "name": "Automation & Care Bundle",
      "description": "労働の代替とケアの拡張を支える基盤群。『貧窮の回避』を共通目的に設計される。",
      "gh:items": [ {"@id": "tech:household-robotics"}, {"@id": "tech:public-service-autonomy"}, {"@id": "tech:consent-mediator"} ] },

    { "@id": "tech:urban-light-infra", "@type": "Intangible",
      "name": "Urban Light Infrastructure Bundle",
      "description": "都市に編み込まれた光の伝送・計算基盤。臨床/研究/生活レイヤで静かに機能し、人とGhostの往来を支える。",
      "gh:items": [
        {"@id": "tech:sip"},
        {"@id": "process:memory-space-1024d"},
        {"@id": "program:zombie-sweeper"}
      ],
      "gh:operationalNote": "名称は前面に出さず、生活の背後で“静かに効く”設計思想。" },
    {
      "@id": "tech:tree-of-life-exam",
      "@type": "Intangible",
      "name": "TOL (Tree of Life) Certification",
      "description": "Ghost Hackerの国家資格試験。2回の試験があり、非常に難しい。合格しないと職業につけない。"
    },
    {
      "@id": "company:schwa",
      "@type": "Organization",
      "name": "Schwa",
      "description": "ToL（Tree of Life）の臨床拠点オフィス。Akitoが代表を務め、Tamaki/Kaede/Hibikiらが所属。",
      "founder": {"@id": "character:akito"},
      "gh:companyType": "Ghost Hacking Clinic",
      "gh:infraNote": "臨床セッションは都市の光インフラ上でエッジ優先に運用。静的な帯域予約と短い復帰ルートで可用性を確保。",
      "gh:operationalNote": "クライアント近傍でASC制御帯を一時調整し、負荷と揺らぎを緩和。",
      "gh:items": [ {"@id": "bundle:ai-governance"} ]
    },
    {
      "@id": "organization:tol",
      "@type": "Organization",
      "name": "ToL (Tree of Life)",
      "description": "国際的な臨床・研究組織（国境なき医師団に類似の運営）。カテゴリー: 心療内科。医師免許とCS知識を要件。日本国内では国家安全保障会議の支援、厚生労働省・宮内庁と連携。",
      "gh:infraNote": "越境支援では光ネット経路の中立性を重視し、人道回線に優先制御を付与。",
      "gh:securityNote": "観測データは最小化・匿名化し、復路でのみ再結合する設計。",
      "gh:items": [ {"@id": "bundle:ai-governance"} ],
      "sponsor": [
        {"@id": "organization:jpn-nsc"},
        {"@id": "organization:mhlw"},
        {"@id": "organization:imperial-household"}
      ]
    },
    { "@id": "organization:jpn-nsc", "@type": "Organization", "name": "国家安全保障会議 (NSC)" },
    { "@id": "organization:mhlw", "@type": "Organization", "name": "厚生労働省 (MHLW)" },
    { "@id": "organization:imperial-household", "@type": "Organization", "name": "宮内庁" },
    { "@id": "organization:tol-hermeneutics", "@type": "Organization", "name": "ToL Hermeneutics" },
    { "@id": "organization:tol-zen", "@type": "Organization", "name": "ToL Zen" },
    { "@id": "organization:tol-amazon", "@type": "Organization", "name": "ToL Amazon" },
    { "@id": "organization:tol-native", "@type": "Organization", "name": "ToL Native" },
    { "@id": "organization:tol-psychedelic", "@type": "Organization", "name": "ToL Psychedelic" },
    { "@id": "organization:tol-psychology", "@type": "Organization", "name": "ToL Psychology" },
    { "@id": "organization:tol-comics", "@type": "Organization", "name": "ToL Narrative/Comics" },

