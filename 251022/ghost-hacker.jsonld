{
  "@context": {
    "@base": "https://ghosthacker.example.com/",
    "@vocab": "https://schema.org/",
    "gh": "https://ghosthacker.example.com/vocab#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
