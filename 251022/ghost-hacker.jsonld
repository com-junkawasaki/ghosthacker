    },

    {
      "@id": "character:grief-suture",
      "@type": "Person",
      "name": "Grief Suture",
      "description": "凍結した悲嘆に現在を縫合する親。",
      "gh:callsign": "COLD-BATH",
      "gh:persona": "喪失の縫合者",
      "gh:ghost": { "@id": "ghost:cold-bath" }
    },
    {
      "@id": "ghost:cold-bath",
