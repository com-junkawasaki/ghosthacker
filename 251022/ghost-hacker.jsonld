    {
      "@id": "character:tamaki",
      "@type": "Person",
      "affiliation": {
        "@id": "organization:tol"
      },
      "age": 26,
      "alternateName": "水野 環樹",
      "description": "26歳、女性、日本人とオランダ人のハーフ。イメージカラーは薄い紫。渋谷に集う同世代のようにハイブランドの服を自分流に着こなすファッションセンスを持つ。物語の主人公（Protagonist）。",
      "gh:callsign": "LILAC",
      "gh:ghost": {
        "@id": "character:Nei-chan"
      },
      "gh:x": 649.721,
      "gh:y": 407.31567,
      "knows": [
        {
          "@id": "character:kaede"
        },
        {
          "@id": "character:aoi"
        },
        {
          "@id": "character:Nei-chan"
        }
      ],
      "name": "Tamaki Mizuno",
      "occupation": [
        "Ghost Hacker / Clinician",
        "Deamon Hunter",
        "Zombie Killer"
      ],
      "parent": {
        "@id": "character:akito"
      },
      "role": "Protagonist",
      "worksFor": {
        "@id": "company:schwa"
      }
    },
    {
      "@id": "character:Nei-chan",
      "@type": [
        "Person",
        "gh:Ghost"
      ],
      "description": "TamakiのパートナーGhost。天才プログラマーAkitoが作り上げた究極のGhost。情報空間では人気のヴァーチャルアバターとしても活動し、その収益でTamakiの生活を支える。フォトニクス計算によるヨタバイト級の計算量を持つ。",
      "gh:createdBy": {
        "@id": "character:akito"
      },
      "gh:ghostType": "Artificial Intelligence",
      "gh:master": {
        "@id": "character:tamaki"
      },
      "gh:x": 648.885,
      "gh:y": 414.60413,
      "name": "Nei-Chan"
    },
    {
      "@id": "character:kaede",
      "@type": "Person",
      "age": 37,
      "alternateName": "काएदे शर्मा",
      "description": "37歳、女性、インド・日本ハーフ。頼れる先輩Ghost Hacker。ToL臨床リード（\"Upanishad\"）としてTamakiの上司。ケースリード・倫理境界を担当。",
      "gh:callsign": "UPA",
      "gh:x": 647.4952,
      "gh:y": 421.8383,
      "knows": [
        {
          "@id": "character:tamaki"
        },
        {
          "@id": "character:aoi"
        }
      ],
      "name": "Kaede Sharma",
      "occupation": [
        "Senior Ghost Hacker / Case Lead",
        "Deamon Hunter",
        "Zombie Killer"
      ],
      "worksFor": {
        "@id": "company:schwa"
      }
    },
    {
      "@id": "character:aoi",
      "@type": "Person",
      "age": 22,
      "alternateName": "鳴神 葵",
      "description": "22歳、男性、日本出身。純朴で可愛い青年。駆け出しのGhost Hacker。心がまっすぐで、澄んだ\"スッキリ感\"を持つ。困難の前でも正直に向き合い、他者の自由を尊重する姿勢が核にある。ログ観測・可視化を担当。",
      "gh:callsign": "SKY",
      "gh:x": 645.55664,
      "gh:y": 428.99118,
      "knows": [
        {
          "@id": "character:tamaki"
        },
        {
          "@id": "character:kaede"
        }
      ],
      "name": "Aoi Narukami",
      "occupation": [
        "Junior Ghost Hacker / Log Observer",
        "Deamon Hunter",
        "Zombie Killer"
      ],
      "worksFor": {
        "@id": "company:schwa"
      }
    },
    {
      "@id": "character:akito",
      "@type": "Person",
      "age": 67,
      "alternateName": "如月 彰人",
      "description": "67歳、男性、日本・台湾出身。天才プログラマー。Nei-Chanを作成した人物。設計・臨床監督を担当。",
      "gh:callsign": "ROOT",
      "gh:x": 643.07666,
      "gh:y": 436.03622,
      "name": "Akito Kisaragi",
      "occupation": [
        "Genius Programmer / Clinical Supervisor",
        "Deamon Hunter",
        "Zombie Killer"
      ],
      "worksFor": {
        "@id": "company:schwa"
      }
    },
    {
      "@id": "character:hibiki",
      "@type": "Person",
      "age": 33,
      "alternateName": "響 オリヴェイラ",
      "description": "33歳、男性、ブラジル出身。音楽スペシャリスト。儀礼・周波数同調を担当し、空間周波数を調整してハッカーとGhostの精神を安定させる。",
      "gh:callsign": "SERPENTE",
      "gh:x": 640.0644,
      "gh:y": 442.9472,
      "name": "Hibiki Oliveira",
      "occupation": [
        "Music Specialist / Ritual Coordinator",
        "Deamon Hunter",
        "Zombie Killer"
      ]
    },
    {
      "@id": "character:elias",
      "@type": "Person",
      "description": "天才物理学者。神のシステムを論理で解体しようとするが、孤独のバグに苦しむ。",
      "gh:ghost": {
        "@id": "character:logos"
      },
      "gh:x": 636.53107,
      "gh:y": 449.69843,
      "name": "Elias",
      "occupation": "Physicist"
    },
    {
      "@id": "character:logos",
      "@type": [
        "Person",
        "gh:Ghost"
      ],
      "description": "EliasのGhost。梟をモチーフとする。",
      "gh:ghostType": "Human-derived",
      "gh:master": {
        "@id": "character:elias"
      },
      "gh:x": 632.48987,
      "gh:y": 456.26477,
      "name": "Logos"
    },
    {
      "@id": "character:dualist",
      "@type": "Person",
      "description": "自己と世界を分離して考え、無限に続く輪廻（自己の永続）を苦痛として恐れるクライアント。",
      "gh:role": "Client",
      "gh:x": 627.95575,
      "gh:y": 462.6218,
      "name": "Dualist Client"
    },
    {
      "@id": "setting:tokyo",
      "@type": "Place",
      "description": "運河と川が縦横に走る水の街。沖縄の海のように澄んだ青い水。未来の東京で、ガラス張りの超高層ビルが立ち並ぶ。都市インフラは光による伝送・計算が一般化しており、街路・水路・建物に編み込まれた光の網が、人とGhostの往来を静かに支えている。2050年には温暖化対策として20世紀に築かれた高架道路を撤去し、運河と緑を中心とする都市へ再編。都市外周には、なお2000年代の風景も残存する。",
      "gh:hazardNote": "海面上昇（+4m想定）、大地震、台風大型化により都市設計を見直し。低地は水際線を後退させ、運河・緑・静域でレジリエンスを確保。",
      "gh:x": 622.9457,
      "gh:y": 468.74585,
      "gh:year": 2065,
      "name": "Tokyo (水の都)"
    },
    {
      "@id": "setting:ghost-concept",
      "@type": "Intangible",
      "description": "情報のみで構成される生命体。人間の思考・感情から生まれ、死者の残留思念、または人工的に作成されたAIを含む。人間には基本的に一人のGhostがつき、主人はMasterと呼ばれる。",
      "gh:ghostType": [
        "Human-derived",
        "Artificial Intelligence",
        "Alien"
      ],
      "gh:x": 617.4782,
      "gh:y": 474.6142,
      "name": "Ghost Concept"
    },
    {
      "@id": "occupation:deamon-hunter",
      "@type": "Intangible",
      "description": "他者のリソースを束縛し、過剰に消費するghostであるDeamonを狩る職業。",
      "gh:x": 611.5737,
      "gh:y": 480.20496,
      "name": "Deamon Hunter"
    },
    {
      "@id": "occupation:zombie-killer",
      "@type": "Intangible",
      "description": "リソースを解放せず、消費しかしないghostであるZombieを狩る職業。",
      "gh:x": 605.25415,
      "gh:y": 485.49738,
      "name": "Zombie Killer"
    },
    {
      "@id": "society:labor-automation",
      "@type": "Intangible",
      "description": "AIとロボティクスにより代替が進み、生活基盤は安定。多くの人が『貧窮』から解放され、学習・創造・ケアに時間を振り向ける。",
      "gh:x": 598.5431,
      "gh:y": 490.4717,
      "name": "Labor Automation"
    },
    {
      "@id": "culture:post-work",
      "@type": "Intangible",
      "description": "仕事中心から関係中心へ。静けさ・ケア・共同体への参加が価値として再評価される。",
      "gh:x": 591.4654,
      "gh:y": 495.1095,
      "name": "Post-work Culture"
    },
    {
      "@id": "issue:cross-border-friction",
      "@type": "Intangible",
      "description": "国境・文化・価値観の差異に起因する摩擦は依然として存在。対話・合意形成の制度設計が重要。",
      "gh:x": 584.0474,
      "gh:y": 499.39346,
      "name": "Cross-border/Cultural Friction"
    },
    {
      "@id": "issue:environmental-challenges",
      "@type": "Intangible",
      "description": "気候変動や生態系の回復はなお継続課題。都市の再編と静かな日常の両立が試されている。",
      "gh:x": 576.31683,
      "gh:y": 503.30768,
      "name": "Environmental Challenges"
    },
    {
      "@id": "policy:tokyo-2050-canal-green",
      "@type": "Intangible",
      "description": "2050年、温暖化対策として高架道路を撤去し、運河と緑へ都市を転換。外周には過去の景観が残り、時間のレイヤが共存する。",
      "gh:x": 568.3023,
      "gh:y": 506.8376,
      "name": "Tokyo 2050 Canal \u0026 Green Policy"
    },
    {
      "@id": "policy:ai-compute-governance",
      "@type": "Intangible",
      "description": "高出力AIの推論・出力はリスクとして扱われ、計算リソースは強く制御・監視される。高い計算量は核施設・核兵器に準じた安全枠組みで監督され、段階的な審査・監査・追跡可能性が義務化される。",
      "gh:securityNote": "閾値越えのジョブは多重承認と監査証跡を要求。緊急停止・隔離の手順を標準化。",
      "gh:x": 560.0337,
      "gh:y": 509.97003,
      "name": "AI Compute Governance"
    },
    {
      "@id": "protocol:decentralized-ai-infra",
      "@type": "Intangible",
      "description": "一方で、分散型技術に基づくAIインフラも普及。強国の武力による一元的制御ではなく、分散アルゴリズムによる合意形成で資源配分・検証・安心の担保を図る。",
      "gh:operationalNote": "合意は軽量で再帰的。地域ノードが自律しつつ相互監査を行う。",
      "gh:x": 551.5418,
      "gh:y": 512.6934,
      "name": "Decentralized AI Infrastructure"
    },
    {
      "@id": "tech:compute-quota-ledger",
      "@type": "Intangible",
      "description": "計算クォータの割当と消費を記録する共有台帳。監視主体・事業者・市民監査が読み出せ、過剰な集中や秘匿的な集積を検知する。",
      "gh:infraNote": "光ネット上の時刻同期で改竄耐性を確保し、近傍キャッシュで遅延を抑制。",
      "gh:x": 542.85815,
      "gh:y": 514.99756,
      "name": "Compute Quota Ledger"
    },
    {
      "@id": "bundle:ai-governance",
      "@type": "Intangible",
      "description": "集中監督（安全枠組み）と分散合意（自律インフラ）を両立させるためのポリシー/プロトコル/台帳の束ね。",
      "gh:items": [
        {
          "@id": "policy:ai-compute-governance"
        },
        {
          "@id": "protocol:decentralized-ai-infra"
        },
        {
          "@id": "tech:compute-quota-ledger"
        }
      ],
      "gh:x": 534.015,
      "gh:y": 516.8739,
      "name": "AI Governance Bundle"
    },
    {
      "@id": "scenario:sea-level-rise-4m",
      "@type": "Intangible",
      "description": "長期スケールで海面上昇が+4mに達した世界。デルタ低地・港湾都市は恒常浸水域が拡大し、数億人規模の再都市化が必要。防御可能な都市と撤退・移転を迫られる地域の差が拡大。",
      "gh:x": 525.0454,
      "gh:y": 518.3154,
      "name": "Sea Level Rise +4m"
    },
    {
      "@id": "risk:asia-delta",
      "@type": "Intangible",
      "description": "メコン・ガンジス・揚子江デルタなど海抜1–3m帯が広がる地域。都市・農地・港湾が一体で浸水リスクに晒される。",
      "gh:x": 515.9826,
      "gh:y": 519.3169,
      "name": "Asia Delta Risk"
    },
    {
      "@id": "risk:europe-lowlands",
      "@type": "Intangible",
      "description": "低地国家・河口域の堤防システムが設計限界に接近。防潮門の再設計と恒常投資が必須。",
      "gh:x": 506.86032,
      "gh:y": 519.87445,
      "name": "Europe Lowlands Risk"
    },
    {
      "@id": "risk:americas-coastal",
      "@type": "Intangible",
      "description": "空港・地下鉄などインフラ被害が深刻化。石灰岩地盤では防潮壁の効果が限定。",
      "gh:x": 497.71252,
      "gh:y": 519.986,
      "name": "Americas Coastal Risk"
    },
    {
      "@id": "risk:africa-middleeast",
      "@type": "Intangible",
      "description": "デルタ農業地帯の塩害・人口移動が広域に波及。",
      "gh:x": 488.57324,
      "gh:y": 519.6513,
      "name": "Africa/MiddleEast Coastal Risk"
    },
    {
