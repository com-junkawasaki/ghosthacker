              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 5,
          "segmentText": "それとも縛るため？」\n\nAoiの喉仏が上下する。正直さは強さだ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
