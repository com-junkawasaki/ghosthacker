              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 13,
          "segmentText": "影が一瞬、濃くなる。抵抗。すぐに薄まる。小さな勝ち負けが交互に来る。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
