              "score": 0.071
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "Nei-chan「ASC、維持で。次、合図ちょうだい」\n私は足元で小さく神楽を一拍。テンポを半歩落とし、“待つ契約”のラインを部屋に敷く。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 1
            },
            {
              "@type": "EmotionScore",
