        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "運河沿いの緑が風に鳴る。遠くで、古い高架の残滓が静かに影になっていた。水の都の夜が深まり、光の網がやわらかく灯る。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
