              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "運河に朝の風。いい感じは、いつも静かで、強い。私は仲間たちと視線を交わし、次の依頼に備える。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "私は最後にもう一度、偽神の跡地を振り返る。恐れが抜けた空白は、静けさで満たされる。Renが手を挙げ、小さく笑った。「還ったね」",
          "emotionVector": [
