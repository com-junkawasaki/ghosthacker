              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "大事なのは“切り捨て”じゃない。不要なループを /dev/null に流しながら、残すべき関係線を守ること。私はTree of Lifeに触れ、手順を一つずつ実行する。",
          "emotionVector": [
            {
