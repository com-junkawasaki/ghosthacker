        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "// LOGICAL PARADOX: TRUST == ERROR\n\nEliasの孤独は、論理でできていた。正しさが堆積して壁になり、呼吸の入り口を塞いでいる。私はNei-chanから受け取った非分離のコードを展開し、渦の中心へと投げ入れる。境界をほどく語彙は、たいてい優しい声色をしている。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
