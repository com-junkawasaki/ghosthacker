              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 12,
          "segmentText": "Eliasが囁く。「僕、ずっと“正しさ”で守ってた」\n「うん。正しさは大事。でも、呼吸が先」\n\nHibikiが低音を挿す。渦の縁がほどける。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
