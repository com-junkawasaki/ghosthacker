              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 4,
          "segmentText": "「呼吸できる正義」を胸に置く。私は書類を閉じ、窓を少しだけ開ける。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
