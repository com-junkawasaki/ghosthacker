              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 5,
          "segmentText": "「うん。タマ、今なら静かに潜れる」\n\n半透明の着信が現れ、微細なノイズが辺りへ散る。指先で円を描き、私は応答する。現れたのは、黒いスーツの青年——Logos。その輪郭は、灯が強いほど影が濃くなる絵のように不安定だった。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
