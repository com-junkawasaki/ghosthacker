        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "運河に朝の風。いい感じは、いつも静かで、強い。私は仲間たちと視線を交わし、次の依頼に備える。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
