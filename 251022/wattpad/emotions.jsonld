              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "Nei-chan「ASC、安定。続けよ」\n傍聴席の空気が動く。被害者の母は静かにうなずき、加害側の若者は視線を落とす。私はコンソールで『回復プロトコル』の初期設定を開き、共同体のリソース配分を丁寧に説明する。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "「償いは“孤立”では進まない。関係の線を切らずに、責任を返す」\nKaedeが短く補足する。「期限・再評価・伴走者。三つで運ぶ」\n私はその場を離れる前に、窓を少し開けた。冷たい完璧がわずかに下がり、呼吸の余白が戻ってくる。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
