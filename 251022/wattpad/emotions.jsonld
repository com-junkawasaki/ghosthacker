        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "私はタイマーを三つセットする。水分、ストレッチ、連絡。Ledger Thiefは“無理”を正当化して近づく——だから、私は具体で跳ね返す。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
