            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "「信じて、待とう。いっしょに」\n静けさがひろがる。胸の奥に、安心と希望が灯る。今日は、これで十分だ。",
