              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 7,
          "segmentText": "Aoiが小さく笑う。「いい。怒りは炉に。外には信頼を」\n私は頷く。ゆっくり、安心が広がる。私たちは、希望のほうへスロットルを合わせ直した。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0.5
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0.5
            },
            {
              "@type": "EmotionScore",
