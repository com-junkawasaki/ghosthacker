        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "私は一拍置いて、言葉の温度を合わせる。境界を引くのは戦いじゃない。ケアの輪郭を整える作業だ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
