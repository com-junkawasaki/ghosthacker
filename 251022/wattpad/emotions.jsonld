          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "ゆっくりうなずく。静けさの中に安堵が置かれ、明日の希望が軽く灯る。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
