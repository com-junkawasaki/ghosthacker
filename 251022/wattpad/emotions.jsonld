              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 6,
          "segmentText": "扉を開ける前に、コップの水をひと口。のどの奥で、小さな安堵がひらく。",
