        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "Nei-chan「ASC、合わせる？」\n私は足元で神楽を一拍。合図。意識の解像度が静かに上がる。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
