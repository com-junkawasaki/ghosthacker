      "trajectory": [
        {
          "@type": "EmotionProfile",
          "position": 1,
          "segmentText": "# EP11-1 — コンプライアンスの鬼（Compliance Ogre）\n- POV: 私（Tamaki／環樹）\n- Beat: Decompile / Quiet Justice\n\n書類は完璧。だから臭う。私は行間を読む。Kaedeが指すログは、人間が置き去りにされた場所を示す。正義の名を借りた恐れが、現場を締め付けていた。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "私は彼（鬼）に名を与える。「あなたの名は、恐れの正当化」名は輪郭。輪郭があれば、道が拓ける。制度は敵じゃない。呼吸の仕方を忘れただけ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "小さくほぐれる。完璧は一歩退き、人間が半歩進む。私は拳を開いて、ゆっくり息を吐く。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 4,
          "segmentText": "「呼吸できる正義」を胸に置く。私は書類を閉じ、窓を少しだけ開ける。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
