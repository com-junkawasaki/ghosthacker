            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 4,
          "segmentText": "Kaedeの声は乾いた紙の音に似ている。「汚染、上がってる。慎重に」\nHibikiは音の処方箋を調律して、空気が少し柔らかくなる。Nei-chanは私の肩で、光の羽をひとあおぎした。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
