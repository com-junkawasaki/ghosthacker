          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 8,
          "segmentText": "私は目を閉じる。遠くでLedger Thiefの紙が破れる音がした——気がした。赤い帯は見えない。代わりに、淡い灯が点在する。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
