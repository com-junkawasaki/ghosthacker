            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 5,
          "segmentText": "室内が静まり、Hibikiの低い周波が床を滑る。Kaedeがセキュリティレールを敷設する。私は視線で礼を送った。いい感じは、だいたいチーム戦だ。独りで無理をしないのが、最良の勇気になる時がある。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
