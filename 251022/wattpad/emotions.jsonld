            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 7,
          "segmentText": "Aoiが小さく笑う。「いい。怒りは炉に。外には信頼を」\n私は頷く。ゆっくり、安心が広がる。私たちは、希望のほうへスロットルを合わせ直した。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0.5
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0.5
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 8,
          "segmentText": "私は拳を開いて、掌を見つめる。「赦す、も選べる」\nRenが短く笑った。「うん。和解のエンジンに切り替えよう」\n静かな冗談がひとつ落ち、部屋の空気は軽くなる。安堵、信頼、そして小さな喜びが回路を満たしはじめた。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
            },
