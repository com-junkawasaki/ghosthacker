              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 5,
          "segmentText": "夜。私は窓を開け、空気を一度入れ替える。運河の匂い。水の音。手帳にチェックを入れる。「水／OK、散歩／OK、連絡／OK」\n\n『OK』は、今日の私にしかつけられないハンコ。完璧は狙わない。戻れるように、道を残す。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
