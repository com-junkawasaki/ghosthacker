              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 4,
          "segmentText": "ミニケースが入る。依頼人は恋人のGhostへ「寂しい」を注ぎ続けて限界にした人。私は小さな診療室を開いて、問いを置く。「約束は、相手の自由を守るため？",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
