              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 5,
          "segmentText": "私は足元で、もう一度だけ神楽を一拍。終わりの合図。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
