          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 9,
          "segmentText": "いい感じは、明日もきっと、ここに戻る。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
