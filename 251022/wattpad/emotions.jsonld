              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "「助けたい。でも、止められない」\n「だから、止めるのは“あなたがやる”じゃない」\n境界を整えるのは、関係を壊す代わりに、関係を長くするためだ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
