          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "私はホワイトボードに二本の線を引く——『ケア』と『消耗』。同じ行為でも文脈で意味が反転することを、私は何度も見てきた。今日はそれを、図で見せる日だ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
