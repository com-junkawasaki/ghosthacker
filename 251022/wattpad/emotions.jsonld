              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "「わたしは在る」\nその言葉は誰かの所有物ではない。恐れが手を離し、関係が立ち上がる。Neroは去っていく。勝利じゃない。還るだけだ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.2593
