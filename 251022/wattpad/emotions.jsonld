        },
        {
          "@type": "EmotionProfile",
          "position": 6,
          "segmentText": "静けさが、回路の新しい標準になる。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0
