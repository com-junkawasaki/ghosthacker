              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 4,
          "segmentText": "「Hibiki、準備を」\n「合図して」\n\n私は渦の核に掌を重ね、そっと名を外す。「孤独」とは呼ばない。ただ、痛みと呼ぶ。名を変えると、対象の硬度が少しだけ変わる。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0.5455
            },
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 0.4545
            },
            {
