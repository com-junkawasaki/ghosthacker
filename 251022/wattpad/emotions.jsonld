              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "監視は『所有の鎖（Chain of Care）』の変種——善意で正当化される支配だ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
