            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 5,
          "segmentText": "窓の外で、風がひとつ角を曲がる。私たちは声を荒げないまま、うなずきを交換した。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
