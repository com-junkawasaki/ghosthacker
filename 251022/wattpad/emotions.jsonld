              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 5,
          "segmentText": "「今」\n原色が奔り、アヤワスカが空間の結び目を解体する。ページが蝶になって舞い、影は輪郭を失って光に還る。私は体を起こし、静けさの中でただ在った。いい感じが、戻ってくる。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.3333
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0.3333
            },
