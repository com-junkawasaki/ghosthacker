              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "「わたしは在る」\nその言葉は誰かの所有物ではない。恐れが手を離し、関係が立ち上がる。Neroは去っていく。勝利じゃない。還るだけだ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.2593
            },
            {
              "@type": "EmotionScore",
              "emotion": "relief",
              "score": 0.2593
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0.2593
            },
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 0.2222
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "anger",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "surprise",
              "score": 0
            },
            {
              "@type": "EmotionScore",
