              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 2,
          "segmentText": "「ケアは、相手の選択肢を増やす」私は最後の確認を置く。依頼人は涙を拭き、「待つ契約」にサインした。怖さは残る。でも、強さも残る。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0.6471
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0.3529
            },
            {
              "@type": "EmotionScore",
