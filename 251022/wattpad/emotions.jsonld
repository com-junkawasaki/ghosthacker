              "@type": "EmotionScore",
              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 3,
          "segmentText": "『自己メンテ・プロトコル v1』\n1) 水分：300ml × 3回／日\n2) 散歩：10–20分（音はHibiki推奨）\n3) 食事：タンパク質＋温かい汁物\n4) 連絡：3→1へ、夜は“待つ契約”\n5) 睡眠：同時刻入眠、スマホ部屋の外\n\nAoiがにやりとする。「スマホ、外？」\n「外」\n「Tamakiが？」\n「私が」\n\n笑いが落ちる。小さな笑いは、場の免疫だ。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "trust",
              "score": 0.3438
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0.2187
            },
            {
