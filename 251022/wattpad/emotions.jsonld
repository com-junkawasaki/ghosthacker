              "emotion": "relief",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "hope",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 4,
          "segmentText": "スイッチが切れる音はしない。ただ、静かになる。私は目を閉じる。Rage Engineがスロットリングされ、関係の線がもう一度、結び直される。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
