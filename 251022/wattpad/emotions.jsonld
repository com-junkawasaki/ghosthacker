              "emotion": "disgust",
              "score": 0
            }
          ]
        },
        {
          "@type": "EmotionProfile",
          "position": 4,
          "segmentText": "私は“理由”を短く書く。『よくする準備』『やり直しの手順』。理由は短く、行動は具体に。Ledger Thiefの長い説明に対抗するには、短さが効く。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "anticipation",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
