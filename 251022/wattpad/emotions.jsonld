      "trajectory": [
        {
          "@type": "EmotionProfile",
          "position": 1,
          "segmentText": "# EP8-2 — I AM THAT I AM（収束）\n- POV: 私（Tamaki／環樹）\n- Beat: Release / Return\n\n恐れは輪郭を得て、小さくなる。私は彼に道を示す。「還ろう」\n原色の川が流れ、Tree of Lifeが静かに受け止める。胸の奥で、はっきりと在る。「I AM」。",
          "emotionVector": [
            {
              "@type": "EmotionScore",
              "emotion": "fear",
              "score": 1
            },
            {
              "@type": "EmotionScore",
              "emotion": "joy",
              "score": 0
            },
            {
              "@type": "EmotionScore",
              "emotion": "sadness",
              "score": 0
            },
            {
              "@type": "EmotionScore",
