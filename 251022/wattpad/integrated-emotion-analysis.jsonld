                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 8,
              "segmentText": "彼は胸に手を当て、一歩だけ前へ出る。閉じていた拳がほどけ、指先が震えた。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
