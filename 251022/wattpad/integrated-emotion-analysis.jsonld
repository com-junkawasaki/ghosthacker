                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "Kaedeが報告する。「Nero Opsの署名があるボットが、特定のキーワードで怒りを増幅させてる。Compliance Ogreのロジックと酷似」\n「うん。怒りは“秩序”の道具にしやすい」私は答える。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0.6154
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0.3846
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "「まず、スロットル」\n私は深呼吸を分け与えるみたいに、空間のテンポを落とす。Hibikiの周波数で部屋の角が柔らかくなる。Nei-chanが温度を1℃だけ上げる。わずかな“いい感じ”は、意外に効く。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 4,
              "segmentText": "Nei-chan「ASC、低めで。合図で上げる」\n\n依頼人のGhostに、私は小さな問いを置く。「その投稿は、あなたを自由にした？」怒りは正しいこともある。けれど、正しさが自由を奪うなら、それは“偽神”だ。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0.5556
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0.4444
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 5,
              "segmentText": "スイッチが切れる音はしない。ただ、静かになる。私は目を閉じる。Rage Engineがスロットリングされ、関係の線がもう一度、結び直される。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
