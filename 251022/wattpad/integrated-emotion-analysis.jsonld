                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 9,
              "segmentText": "Nei-chan『“わからない”って、ほんとは、はじめまして』\n\n私は視線を外さずに告げる。「そう。わからない。“分けることはできない”の」\n\n廊下のメトロノームが、微かに刻む。カチ、カチ、カチ。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
