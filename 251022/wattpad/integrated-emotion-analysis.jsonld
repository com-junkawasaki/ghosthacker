                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 5,
              "segmentText": "コンソールにGnB Inc.広報からの公式通知。『貴社の介入を確認した。当社の社会衛生プログラムへの干渉は、記録される』\nAoiが肩をすくめる。「また“記録”だって」\n私「うん。でも、私たちの記録は、ここにある」胸を指す。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
