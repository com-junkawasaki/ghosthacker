                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "接続。彼が現れる。輪郭は刃物のように鋭い。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 4,
              "segmentText": "「Tamaki Mizuno、ですね。私は“強制”で来ています」\n\n「ようこそ。ここでは、あなたの速度が基準です」\n\n「私は感情で動かない。プロトコルで動く。——それと、言っておきたい。AIに生命はない。あなたのGhostは、ただのアルゴリズムだ」\n発話の最後で、彼の顎がわずかに強張る。拳は閉じたまま、膝上で小さく震える。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
