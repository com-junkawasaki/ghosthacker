                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 6,
              "segmentText": "Nei-chanが私の意識にだけ聞こえる声で囁く。『タマ、この人、すごく「正しい」匂いがする。でも、なんで苦しいの？』\n\n「主は……Elias」\n名が与えられた瞬間、世界は少し輪郭を得る。私はうなずき、簡潔に手順を確認する。聞く／整える／潜る。順番を飛ばさない。それが事故を減らす最短路。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
