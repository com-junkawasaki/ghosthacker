                  "emotion": "disgust",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 10,
              "segmentText": "私は拳を開いて、掌を見つめる。「赦す、も選べる」\nRenが短く笑った。「うん。和解のエンジンに切り替えよう」\n静かな冗談がひとつ落ち、部屋の空気は軽くなる。安堵、信頼、そして小さな喜びが回路を満たしはじめた。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0.5172
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0.2586
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0.2241
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
