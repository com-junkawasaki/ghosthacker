          "trajectory": [
            {
              "@type": "EmotionProfile",
              "position": 1,
              "segmentText": "# Session: Lachlan Keyes - Part 3\n\n---\nAoi（通信）「外、セミ鳴き始め。沿岸の浸水マップ更新が来たけど、そっちは保留でいい？」\nKaede「いい。今は彼に集中」\nNei-chan『タマ、呼吸いっしょに』\n\n壁が崩れ、彼は初めて本当の姿を見せる。震え、そして泣く。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "「……私は誰も信じられなかった。誰も……私を信じてくれなかった」\n\n私は彼の手を取る。冷たさに、温度が戻り始める。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anger",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "「いま、ここにいる。あなたは“信じたい”と思っている。それが人間性」\n彼は不意に笑って、すぐに困ったように眉を寄せた。「……こんな顔、久しぶりだ」\n\nNei-chan「信頼は“わかれていない”。タマとわたしがそう」\n\n彼は微笑む。「非論理的だ……でも、美しい」\n\nKaede「心はまだ軌道上にいた。でも、いま戻った」\n\n私は問う。「次、誰に会いたい？」\n\n「……母に。十八ヶ月、連絡していない」\n\n「帰ったら、連絡して。“いい感じ”の呼吸も、教えて」\nNei-chan『“お母さん、え？って言うよ。でも、すぐ安心するやつ』\n\n彼は頷く。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0.321
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0.1852
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0.1852
                },
                {
                  "@type": "EmotionScore",
