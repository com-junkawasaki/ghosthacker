            {
              "@type": "EmotionProfile",
              "position": 4,
              "segmentText": "Millia Stuart, 30, Digital Artist.**\n\nKaedeのノートが添付されている。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
