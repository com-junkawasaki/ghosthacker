                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
