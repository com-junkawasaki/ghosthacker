              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 13,
              "segmentText": "「……私は、誰かに触れたかった。しかし怖かった。裏切りが」\n\n「“怖い”は、望みの裏返し。何も望まなければ、怖くない」\n\n壁が透明になり、揺れる彼が見える。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
