                  "emotion": "relief",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "静けさがひろがる。胸の奥に、安心と希望が灯る。今日は、これで十分だ。",
              "emotionVector": [
