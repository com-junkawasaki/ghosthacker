                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 7,
              "segmentText": "Nei-chanが補足する。『彼のghostは、肉体の死とgeneの断絶を極端に恐れている。あなたという主体が消えることへの恐怖。それが彼のバグの核心みたい』\n\n「死は終わりじゃない。ただの変化なのにね」私は小さく息を吐く。「私たちは、私たちのmemeを子や文化や社会に繋いでいく。そうやって、孤独からも解放される。彼の苦しみは、その繋がりが見えなくなっていること」\n\nGhost Hackerの仕事は、そういう固まったmemeを解放して、流れに戻すことだ。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0.375
                },
                {
                  "@type": "EmotionScore",
