              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "今日はMilliaの“魂の癒着（Complex）”の切除手術。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
