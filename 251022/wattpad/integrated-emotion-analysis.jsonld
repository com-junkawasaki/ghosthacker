                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 6,
              "segmentText": "コンソールにNero Opsからのテキスト。『感情の非効率な拡散は、社会の安定を損なう。我々はそれを“正常化”する』\n「正常化、だって」Aoiが呆れたように言う。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
