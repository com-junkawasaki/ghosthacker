            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "「これが\"愛\"、これが\"信用\"、そしてこれが\"信頼\"」\n\nLeoが前のめりになる。Milliaは少し身を引く。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
