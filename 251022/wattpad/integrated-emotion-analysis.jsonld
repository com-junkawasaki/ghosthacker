            },
            {
              "@type": "EmotionProfile",
              "position": 5,
              "segmentText": "Nei-chanが私の背でぱた、と羽を震わせる。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
