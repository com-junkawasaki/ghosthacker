                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 4,
              "segmentText": "「いま、ここにいる。あなたは“信じたい”と思っている。それが人間性」\n彼は不意に笑って、すぐに困ったように眉を寄せた。「……こんな顔、久しぶりだ」\n\nNei-chan「信頼は“わかれていない”。タマとわたしがそう」\n\n彼は微笑む。「非論理的だ……でも、美しい」\n\nKaedeの声が通信に入る。彼女の声には、安堵が混じっている。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0.4643
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0.2679
                },
                {
                  "@type": "EmotionScore",
