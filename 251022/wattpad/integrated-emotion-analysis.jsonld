                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "Kaede「湿度が高い。こういう夜は、心が重くなりやすい。気をつけて」\n\nHibiki「Tudo bem, Kaede!",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
