                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 7,
              "segmentText": "画面がぼやけ、二人が現れる。Leoは情熱的で、Milliaは繊細で、でも……どこか、空洞がある。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
