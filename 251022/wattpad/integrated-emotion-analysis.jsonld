                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 7,
              "segmentText": "「では、その水は『どこからどこまで』があなた？」\n\n彼の時間が止まる。唇はコップに触れたまま。数秒——永遠。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
