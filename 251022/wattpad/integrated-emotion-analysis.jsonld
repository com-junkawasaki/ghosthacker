                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 25,
              "segmentText": "Tamakiさんなら、可愛いからいいよ！」\n\nMillia（肘で小突く）「……」\n\nLeo「痛っ」\n\nTamakiはペットボトルを受け取り、一口飲む。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
