            {
              "@type": "EmotionProfile",
              "position": 11,
              "segmentText": "壁が微かに鳴る。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
