                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "朝の運河。私は手帳に一行を書く。「We can't put it toghether.",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
