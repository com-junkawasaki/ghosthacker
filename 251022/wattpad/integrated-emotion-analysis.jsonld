            },
            {
              "@type": "EmotionProfile",
              "position": 7,
              "segmentText": "窓辺の光はやわらかい。希望は声を上げない——けれど、確かにここにある。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
