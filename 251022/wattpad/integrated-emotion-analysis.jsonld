            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "私は彼（鬼）に名を与える。「あなたの名は、恐れの正当化」名は輪郭。輪郭があれば、道が拓ける。制度は敵じゃない。呼吸の仕方を忘れただけ。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0.5556
                },
                {
