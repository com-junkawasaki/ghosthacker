            },
            {
              "@type": "EmotionProfile",
              "position": 8,
              "segmentText": "空気が少し柔らかくなる。Nei-chanは私の肩で、光の羽をひとあおぎした。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
