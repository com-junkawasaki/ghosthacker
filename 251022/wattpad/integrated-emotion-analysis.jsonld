                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "Kaede「GnB Inc.の広報声明が出てる。『不要な情報のループは、社会の健全性を損なうため、定期的な衛生管理の一環として清掃している』と」\n私「“清掃”ね。誰の“不要”なんだろう」\n\n大事なのは“切り捨て”じゃない。不要なループを /dev/null に流しながら、残すべき関係線を守ること。私はTree of Lifeに触れ、手順を一つずつ実行する。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
