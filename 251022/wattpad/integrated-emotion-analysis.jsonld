                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 4,
              "segmentText": "Nei-chanが肩に触れる。「ASC、落とすね」\n「うん。ありがとう」\n\nKaede「明日の午前、短いリハ入れる？」\n「入れよう。半歩のリハ」\nHibikiが頷く。階段の踊り場に、静かな余白が生まれる。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
