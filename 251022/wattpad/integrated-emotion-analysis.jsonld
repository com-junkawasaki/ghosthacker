                  "emotion": "relief",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "hope",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "「AIに生命なんてない。君の“Ghost”はただのプログラムだ」\n\nNei-chanが私の背で小さく羽をたたむ。私は頷くだけ。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
