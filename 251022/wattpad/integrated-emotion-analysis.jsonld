                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "原色の川が流れ、Tree of Lifeが静かに受け止める。胸の奥で、はっきりと在る。「I AM」。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
