                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 6,
              "segmentText": "「その飲んだ水は、あなた？」\n\n沈黙。額に皺が寄る。「……違う、と思う」\n\n「もう一口、どうぞ」\n\n彼はコップの口に唇を触れ、その瞬間。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
