                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
