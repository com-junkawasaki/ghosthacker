            },
            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "「……私は誰も信じられなかった。誰も……私を信じてくれなかった」\n\n私は彼の手を取る。冷たさに、温度が戻り始める。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
