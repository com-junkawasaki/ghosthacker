            {
              "@type": "EmotionProfile",
              "position": 3,
              "segmentText": "接続。彼が現れる。輪郭は刃物のように鋭い。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
