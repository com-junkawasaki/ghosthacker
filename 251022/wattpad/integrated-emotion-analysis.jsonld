                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "surprise",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "trust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "disgust",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "relief",
                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "「タマ、次の人、壁が厚い」\n\n「うん。速度は合わせる」\n\n私は足元で神楽を一拍。ASC制御を半歩上げる。",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "anticipation",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
