                  "score": 0
                }
              ]
            },
            {
              "@type": "EmotionProfile",
              "position": 2,
              "segmentText": "Kaede「気圧が下がってる。こういう日は、感情が不安定になりやすい。呼吸を深めに、Tamaki」\n\nHibiki「Ei, Tamaki!",
              "emotionVector": [
                {
                  "@type": "EmotionScore",
                  "emotion": "fear",
                  "score": 1
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "joy",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
                  "emotion": "sadness",
                  "score": 0
                },
                {
                  "@type": "EmotionScore",
