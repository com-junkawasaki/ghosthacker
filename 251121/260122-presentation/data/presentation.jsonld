  "id": "gh:presentation/ghosthacker-a3",
  "type": "gh:PresentationBoard",
  "name": "GHOST HACKER — A3 Presentation Board",
  "meta": {
    "oneLiner": "AI時代の情報攻撃を“物理現象”として描く、ハッキング×心理×組織の少年漫画。",
    "hook": "情報が『質量』を持ったとき、嘘は『幽霊』になる。",
    "audience": "週刊少年ジャンプ編集部向け",
    "tags": [
      "Cyber",
      "Thriller",
      "Shonen",
      "AI",
      "Corporate",
      "Ghost",
      "CISSP",
      "CISA",
      "情報安全確保支援士"
    ]
  },
