{
  "name": "storyboard-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --threshold error",
    "dev:backend": "export WORKSPACE_ROOT=../../.. && export PORT=8081 && cd backend && go run cmd/server/main.go",
    "dev:worker": "export WORKSPACE_ROOT=../../.. && cd backend && go run cmd/worker/main.go",
    "buf:generate": "cd backend && buf generate"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^25.0.10",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "lucide-svelte": "^0.562.0"
  }
}
