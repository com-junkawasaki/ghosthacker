# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git curl

# Install buf CLI using go install
# Note: go install installs to $GOPATH/bin, which is typically $HOME/go/bin
ENV PATH=$PATH:/root/go/bin
RUN go install github.com/bufbuild/buf/cmd/buf@latest && \
    buf --version

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy proto files and buf config
COPY proto/ ./proto/
COPY buf.yaml buf.gen.yaml ./

# Generate proto files using buf (run from project root)
RUN buf generate --path proto

# Copy source code
COPY . .

# Build server only
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/server ./cmd/server/main.go

# Development stage
FROM golang:1.25-alpine AS development

WORKDIR /app

RUN apk add --no-cache git ca-certificates curl

# Install buf CLI using go install
# Note: go install installs to $GOPATH/bin, which is typically $HOME/go/bin
ENV PATH=$PATH:/root/go/bin
RUN go install github.com/bufbuild/buf/cmd/buf@latest && \
    buf --version

# Install air for hot reload (use latest version compatible with Go 1.25)
RUN go install github.com/air-verse/air@latest

COPY go.mod go.sum ./
RUN go mod download

# Copy proto files and buf config
COPY proto/ ./proto/
COPY buf.yaml buf.gen.yaml ./

# Generate proto files (run from project root)
RUN buf generate --path proto

# Copy source for hot reload
COPY . .

EXPOSE 8081

CMD ["air", "-c", ".air.toml"]

# Production stage
FROM alpine:latest AS production

WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY --from=builder /app/server /app/server

EXPOSE 8081

CMD ["/app/server"]
