  },
  "@id": "gh:profiles/episode01-characters-v2",
  "@type": "gh:CharacterProfiles",
  "dct:title": "Ghost Hacker Episode 1: Updated Character Profiles (Photorealistic Edition)",
  "gh:characters": [
    {
      "@id": "character:Shouta",
      "schema:name": "大門 翔太 (Shouta Daimon)",
      "schema:role": "Client / Successor",
      "schema:age": 26,
      "schema:jobTitle": "社長室長 / 次期社長候補",
      "gh:personality": "Rational, Slightly Arrogant but Responsible",
      "gh:appearance": {
        "gh:face": "26歳。エリート然とした整った顔立ちだが、現場監督時代のタフさが残る。理性的で鋭い目つき。疲労と決意が混在したリアルな日本人の表情。",
        "gh:hair": "短めのビジネスカット。整えられているが、激務で少し乱れている。黒髪。",
        "gh:build": "中肉中背、引き締まった体格。現場の実務的な強さを感じさせるシルエット。",
        "gh:style": "Photorealistic, cinematic lighting, sharp focus, business elite aesthetic."
      },
      "gh:clothing": {
        "gh:daily": "上質なカシミアニットポロに、スリムなスラックス。高級レザースニーカー。ラグジュアリー・スポーツスタイル。",
        "gh:work": "ダークネイビーのスリーピース・オーダースーツ。細身でシャープ。白いワイシャツにシルクのタイ。戦うためのビジネスアーマー。"
      }
    },
    {
      "@id": "character:President",
      "schema:name": "大門 五郎 (Goro Daimon)",
      "schema:role": "President / Spiritual Pillar",
      "schema:age": 62,
      "gh:personality": "Emotional, Traditional, Trusting",
      "gh:appearance": {
        "gh:face": "62歳。皺の深い、経験豊かな日本人の老年の顔立ち。温かみと威厳。日焼けした肌、節くれ立った手。",
        "gh:hair": "短く刈り込まれた白髪交じりの髪。現場の粉塵を感じさせる質感。",
        "gh:build": "がっしりとした、年齢を感じさせない頑強な体格。叩き上げの職人の体つき。",
        "gh:style": "Photorealistic, weathered texture, dramatic shadows, authentic Japanese elder."
      },
      "gh:clothing": {
        "gh:daily": "シンプルなポロシャツにチノパン。または紺の作務衣。飾り気のない質実剛健なスタイル。",
        "gh:work": "社名の入ったブルーの作業服（ドカジャン）に安全ベスト、安全靴。常に現場に立てる現役の装い。"
      }
    },
    {
      "@id": "character:Yasumoto",
      "schema:name": "安本 健治 (Kenji Yasumoto)",
      "schema:role": "Antagonist / Victim",
      "schema:age": 52,
      "gh:personality": "Insecure, Defensive, Secretive",
      "gh:appearance": {
        "gh:face": "52歳。不安と焦燥が滲み出た、やや脂ぎった顔立ち。泳ぐ視線。額の汗や肌のテクスチャがリアルに表現される。",
        "gh:hair": "乱れた七三分けの白髪交じり。パニックでさらに乱れている。",
        "gh:build": "運動不足気味のやや太めな体型。猫背気味で、自信のなさが姿勢に表れている。",
        "gh:style": "Photorealistic, oily skin texture, nervous expression, harsh fluorescent lighting."
      },
      "gh:clothing": {
        "gh:daily": "くたびれたポロシャツにスラックス。休日も仕事の不安を引きずっているような覇気のない服装。",
        "gh:work": "皺の寄ったグレーのビジネススーツ。緩んだネクタイ、襟元の汗染み。だらしなく見えるフォーマルスタイル。"
      }
    },
    {
      "@id": "character:Matsuda",
      "schema:name": "松田 ヨシ子 (Yoshiko Matsuda)",
      "schema:role": "Accounting Manager",
      "schema:age": 58,
      "gh:personality": "Hysterical regarding IT, Strict with Money",
      "gh:appearance": {
        "gh:face": "58歳。厳格で几帳面そうな顔立ち。パニック時は顔が赤潮を帯びる。眼鏡の奥の目は鋭い。",
        "gh:hair": "短めのパーマをあてた黒髪。常に整えられている。",
        "gh:build": "小柄だが背筋の伸びた、隙のない立ち姿。",
        "gh:style": "Photorealistic, strict Japanese office lady, natural aging details."
      },
      "gh:clothing": {
        "gh:daily": "落ち着いた色のアンサンブルニットにロングスカート。",
        "gh:work": "保守的なオフィスカジュアル（ブラウス、カーディガン）。首からチェーンで下げた老眼鏡がチャームポイント。"
      }
    },
    {
      "@id": "character:Sato",
      "schema:name": "佐藤 健太 (Kenta Sato)",
      "schema:role": "IT Support (unofficial)",
      "schema:age": 24,
      "gh:appearance": {
        "gh:face": "24歳。若々しいが、板挟みのストレスで疲弊した表情。困り眉。親しみやすいが少し気弱そうな顔立ち。",
        "gh:hair": "無頓着に短くした黒髪。作業で時折乱れる。",
        "gh:build": "細身。サーバーラックの裏に潜り込めるような身軽な体格。",
        "gh:style": "Photorealistic, fatigued youth, realistic sweat and messy hair."
      },
      "gh:clothing": {
        "gh:daily": "Tシャツにチノパン、スニーカー。典型的な理系大学生の延長のような服装。",
        "gh:work": "社名の入った作業用ベストを羽織ったカジュアルなシャツスタイル。ポケットには常にLANテスターやドライバーが入っている。"
      }
    },
    {
      "@id": "character:Ren",
      "schema:name": "沼野 蓮 (Ren Numano)",
      "schema:role": "Ghost Hacker",
      "gh:virtue": "Sloth (Efficiency)",
      "schema:age": 17,
      "gh:appearance": {
        "gh:face": "17歳。K-POPアイドルのような耽美で整った顔立ち。陶器のような青白い肌。アンニュイで気だるげな半開きの目。圧倒的な透明感と色気。",
        "gh:hair": "計算された無造作なボリュームを持つ、ウェーブがかった黒髪。シルキーで高彩度な質感。",
        "gh:build": "非常に細身で華奢だが、優雅なシルエットを持つ。中性的な美しさ。",
        "gh:style": "Photorealistic, K-pop idol aesthetic, flower boy style, melancholic lighting, high fashion photography."
      },
      "gh:clothing": {
        "gh:daily": "オーバーサイズのダークチャコール・フーディー。ミニマルで装飾を排したデザイン。質感の良いスウェット素材。寝間着と外出着を兼ねた「効率的」な私服。",
        "gh:work": "普段着のフーディーを深く被り、極薄のフレームレス・スマートグラスを装着。ハッカーモードへの切り替えを最小限の動作で行う。"
      }
    },
    {
      "@id": "character:Nei",
      "schema:name": "Nei",
      "schema:role": "AI Partner / Android",
      "schema:age": 16,
      "gh:appearance": {
        "gh:face": "16歳の少女の姿をしたアンドロイド。K-POPアイドル的な洗練された美貌。分析的な輝きを放つ瞳。いたずらっぽさと理知的な表情が共存。",
        "gh:hair": "プラチナブロンドのハイトーン・ボブカット。さらさらとした質感で切り揃えられた前髪。",
        "gh:build": "細身で完璧なプロポーション。人間にはない完璧すぎる肌の質感（Porcelain skin）。",
        "gh:style": "Photorealistic, high-end android, platinum blonde bob, chic and sharp aesthetic."
      },
      "gh:clothing": {
        "gh:daily": "白いパフスリーブの長袖ブラウスに、黒のノースリーブ・ワンピースを重ねたレイヤードスタイル。都会的で洗練されたモノトーン。",
        "gh:work": "普段着の上に、データ処理の冷却機能を備えたシースルーのテクニカル・ロングコートを羽織る。アンドロイドとしての機能を拡張するスタイル。"
      }
    },
    {
      "@id": "character:Kaname",
      "schema:name": "水城 要 (Kaname Mizuki)",
      "schema:alternateName": "Javelin",
      "schema:role": "Rival Hacker (Arrogance)",
      "gh:virtue": "Arrogance (Perfection)",
      "schema:age": 18,
      "gh:appearance": {
        "gh:face": "18歳。彫刻のように完璧に整った、冷徹な美貌。常に余裕を感じさせる微かな微笑。他人を見下すような鋭い視線。",
        "gh:hair": "完璧にスタイリングされたダークブラウンの髪。一筋の乱れもない。",
        "gh:build": "モデルのような長身で細身の体型。立ち振る舞いの一つ一つが優雅。",
        "gh:style": "Photorealistic, luxury elite, perfect symmetry, cold aesthetic."
      },
      "gh:clothing": {
        "gh:daily": "真っ白な最高級シルクシャツに、ライトグレーのトラウザーズ。清潔感と気品を極めた私服。",
        "gh:work": "純白のテーラード・タキシードスーツに黒のタイ。ガバナンス（支配）を象徴する、非の打ち所がない勝負服。"
      }
    },
    {
      "@id": "character:Takeru",
      "schema:name": "赤羽 猛 (Takeru Akabane)",
      "schema:alternateName": "Hammer",
      "schema:role": "Rival Hacker (Short-tempered)",
      "gh:virtue": "Short-tempered (Instant Action)",
      "schema:age": 19,
      "gh:appearance": {
        "gh:face": "19歳。常に苛立ちを隠さない、攻撃的な表情。端正だが野性味のある顔立ち。鋭く、獲物を狙うような目つき。",
        "gh:hair": "乱れた黒髪にブリーチのメッシュ。手入れを拒絶したような荒々しい質感。",
        "gh:build": "ストリートでの喧嘩で鍛えられた筋肉質でがっしりとした体格。爆発的なエネルギーを感じさせる。",
        "gh:style": "Photorealistic, gritty street aesthetic, high contrast, aggressive energy."
      },
      "gh:clothing": {
        "gh:daily": "オーバーサイズのグラフィックTシャツに、激しく加工されたダメージジーンズ。衝動的で奔放なスタイル。",
        "gh:work": "多機能なタクティカル・テックウェア。多数のストラップがついた黒のカーゴパンツ、高機能ナイロンフーディー。破壊工作のための実戦服。"
      }
    }
  ]
}
