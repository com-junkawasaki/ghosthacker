{
  "@context": {
    "schema": "http://schema.org/",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "character": "gh:character/",
    "history": "gh:history/",
    "context": "gh:context/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "dct": "http://purl.org/dc/terms/"
  },
  "@id": "gh:profiles/episode01-characters-v2",
  "@type": "gh:CharacterProfiles",
  "dct:title": "Ghost Hacker Episode 1: Updated Character Profiles",
  "gh:characters": [
    {
      "@id": "character:Shota",
      "schema:name": "大門 翔太 (Shota Daimon)",
      "schema:role": "Client / Successor",
      "schema:age": 26,
      "schema:jobTitle": "社長室長（名ばかり）/ 次期社長候補",
      "gh:personality": "Rational, Slightly Arrogant but Responsible",
      "gh:voiceStyle": "論理的で早口。IT用語を多用するが、父や古参社員には通じずイライラしている。Renに対しては最初は疑念を持つが、技術を見ると即座に敬意を表す。",
      "gh:context": "大手ゼネコンで現場監督をしていたが、父（社長）の高齢化に伴い呼び戻された。会社の時代遅れな体質（FAX文化、安本の杜撰な管理）を改革しようと焦っており、古参社員との間に溝がある。",
      "gh:motivation": "「親父の作ったこの会社を、俺がアップデートして守る」という気負い。警察の対応の遅さに痺れを切らし、独断でRenに依頼した。"
    },
    {
      "@id": "character:President",
      "schema:name": "大門 五郎 (Goro Daimon)",
      "schema:role": "President / Spiritual Pillar",
      "schema:age": 62,
      "gh:personality": "Emotional, Traditional, Trusting",
      "gh:voiceStyle": "重厚だが温かみがある。語尾は「〜だなぁ」「〜だよ」。謝罪や感謝はストレートに伝える。",
      "gh:context": "息子（翔太）の改革案を理解しつつも、長年支えてくれた安本たちへの配慮から踏み切れずにいた。今回の事件で「信じること」と「甘やかすこと」の違いを突きつけられる。",
      "gh:relationship": {
        "character:Shota": "頼もしいが、少し急ぎすぎていると心配している。",
        "character:Yasumoto": "戦友。彼がデジタル化についていけず苦しんでいることに気づいてやれなかったことを悔いている。"
      }
    },
    {
      "@id": "character:Yasumoto",
      "schema:name": "安本 健治 (Kenji Yasumoto)",
      "schema:role": "Antagonist / Victim",
      "schema:age": 52,
      "gh:personality": "Insecure, Defensive, Secretive",
      "gh:voiceStyle": "言い訳がましい。「いや、それは…」「昔はこうだった」が口癖。焦ると声が裏返る。Renなどの若者に対しては虚勢を張る。",
      "gh:context": "翔太が戻ってきたことで「自分の居場所がなくなる」という恐怖（Ghostの餌）が増幅。翔太の導入した新システムを理解できず、意図的に障害を起こそうとして、闇サイトで拾ったランサムウェアを手違いで拡散させてしまった（自爆）。",
      "gh:ghostType": "Obsolescence & Jealousy (陳腐化への恐怖と嫉妬)"
    },
    {
      "@id": "character:Matsuda",
      "schema:name": "松田 ヨシ子 (Yoshiko Matsuda)",
      "schema:role": "Accounting Manager",
      "schema:age": 58,
      "gh:personality": "Hysterical regarding IT, Strict with Money",
      "gh:voiceStyle": "甲高い声。「ちょっと！どうなってんのよ！」「これじゃ給料払えないじゃない！」とパニックを煽る役割。",
      "gh:context": "経理の主。そろばんと電卓の達人だが、会計ソフトの導入には反対していた。今回のシステムダウンで「やっぱり手書きが一番よ！」と主張する。"
    },
    {
      "@id": "character:Sato",
      "schema:name": "佐藤 健太 (Kenta Sato)",
      "schema:role": "IT Support (unofficial)",
      "schema:age": 24,
      "gh:voiceStyle": "控えめだが的確。「あの…ログがおかしいんですけど…」「部長、そのケーブル抜いちゃダメです」と、常に誰かのフォローをしている。",
      "gh:context": "翔太とは同世代で話が合う。安本と松田の間で板挟みになっていた苦労人。"
    },
    {
      "@id": "character:Ren",
      "schema:name": "蓮 (Ren)",
      "schema:role": "Ghost Hacker",
      "gh:voiceStyle": "気だるげだが核心を突く。「めんどくせぇ」「アンタのその感情、ノイズだね」。翔太の合理性には「話が早くて助かる」と好意的。",
      "gh:contextUpdate": "依頼人が同世代（少し年上）の翔太になったことで、ビジネスライクな交渉が可能になった。",
      "gh:relationship": {
        "character:Nei": "自らが開発したAIパートナー。彼女の物理ボディの維持費が貧乏の元凶だが、唯一無二の相棒。"
      }
    },
    {
      "@id": "character:Nei",
      "schema:name": "Nei",
      "schema:role": "AI Partner / Android",
      "schema:age": 16,
      "gh:personality": "Energetic, Logical, Nagging but caring",
      "gh:voiceStyle": "明るくハキハキしているが、時々感情のないフラットなトーンで事実を突きつけてRenをからかう。「マスター、論理的に破綻しています」「エネルギー残量低下。食事を推奨します」",
      "gh:context": "Renが開発した自律人型AI。見た目は16歳の少女と変わらないが、身体は最新の生体工学とナノマシンで構成されている。Renの生活管理とハッキングのサポートを行う。膨大な計算能力を維持するために大量の電力を消費し、それがRenの貧乏の主な原因。",
      "gh:motivation": "Renの才能が怠惰によって失われるのを防ぐことと、世界の『バグ（Ghost）』を修正すること。"
    },
    {
      "@id": "character:Kaito",
      "schema:name": "水城 快斗 (Kaito Mizuki)",
      "schema:alternateName": "Javelin",
      "schema:role": "Rival Hacker (Arrogance)",
      "schema:age": 18,
      "gh:personality": "Arrogant, Perfectionist, Calculating",
      "gh:voiceStyle": "常に冷静で、他人を見下したような穏やかな口調。「君では理解できないだろうが」「美しくないね、そのコードは」など、静かに相手のプライドを削る言葉を選ぶ。自らの知識を誇示するために、意図的に難解な専門用語を多用する。",
      "gh:context": "裕福な家庭で育ち、最高の教育と機材を与えられてきたエリート。ハッキングをチェスや芸術のように捉えており、自身の行為に絶対的な美学を持つ。Renとは同じ裏社会で活動するが、国家間の情報窃盗や企業の経営権を揺るがすような、より知能的な犯罪を手がける。",
      "gh:skills": "ゼロデイ脆弱性を利用した潜入、痕跡を完全に消し去るステルス技術、複雑な人間心理を突くソーシャルエンジニアリングを得意とする。彼の攻撃は静かで、気づいた時には手遅れになっている。",
      "gh:relationship": {
        "character:Ren": "Renの哲学的なアプローチを「非論理的で汚い」と嫌悪しているが、その得体の知れない能力には警戒心と一種の知的好奇心を抱いている。美しくない仕事（物理的な破壊など）は、下のハッカー（Hammerなど）に任せるため、Renと直接組むことは稀。",
        "character:Hammer": "単細胞な破壊屋と見下しており、自分のチェスの駒（ポーン）程度にしか思っていない。便利な道具として使うことはあるが、対等な協力者とは認めていない。"
      },
      "gh:motivation": "自らの知性が世界を支配できることを証明すること。彼の美学にそぐわない『霊』という非論理的な存在を扱うRenは、彼の完璧な世界を乱すノイズであり、排除または理解すべき対象。"
    },
    {
      "@id": "character:Tsuyoshi",
      "schema:name": "赤羽 剛 (Tsuyoshi Akabane)",
      "schema:alternateName": "Hammer",
      "schema:role": "Rival Hacker (Short-tempered)",
      "schema:age": 19,
      "gh:personality": "Short-tempered, Impulsive, Destructive",
      "gh:voiceStyle": "常にイライラしており、舌打ちが多い。口が悪く、考えるより先に手が出るタイプ。「うぜぇ！」「とっとと終わらせろ！」など、暴力的で直接的な言葉を好む。",
      "gh:context": "ストリート出身で、独学でハッキング技術を身につけた。複雑な計画を嫌い、問題は常に最短・最大火力で解決すべきだと考えている。その破壊的な手腕から、企業や組織の「掃除屋」として使われることが多い。",
      "gh:skills": "大規模なDDoS攻撃、ランサムウェアの展開、電力網や交通システムなど物理インフラの破壊工作（サイバーテロ）を得意とする。彼のハッキングは常に派手な破壊の痕跡を残す。",
      "gh:relationship": {
        "character:Ren": "Renの慎重で悠長なやり方が理解できず、見ているだけで苛立つ。「グズでのろま」と罵倒するが、自分が破壊した後の『霊的汚染』をRenが処理できることを知っており、不本意ながら後始末を任せることもある。",
        "character:Javelin": "インテリぶった気に食わない奴と認識している。金払いが良いため仕事は受けるが、いつかその自信に満ちた顔を歪ませてやりたいと思っている。"
      },
      "gh:motivation": "目の前の邪魔なものを破壊するスリルと、それによって得られる大金。複雑なことは考えず、衝動と欲望に忠実に生きている。"
    }
  ]
}
