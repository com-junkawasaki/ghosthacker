  "gh:companies": [
    {
      "@id": "company:KojimaLogistics",
      "@type": "gh:CompanyProfile",
      "schema:name": "小島ロジスティクス株式会社 (Kojima Logistics Co., Ltd.)",
      "gh:arc": "Arc B",
      "schema:location": {
        "@type": "schema:Place",
        "schema:address": "神奈川県川崎市川崎区 (Kawasaki, Kawasaki-ku)",
        "schema:description": "京浜工業地帯に隣接する物流拠点。自動車部品のジャストインタイム配送を担う一次サプライヤー。"
      },
      "schema:employeeCount": 320,
      "schema:foundingDate": "1978",
      "gh:businessType": "自動車部品物流（トヨタ系サプライチェーンの一次下請け）",
      "gh:atmosphere": "24時間稼働の物流センター。始業の鐘が絶対。遅延は死活問題。現場は『急げ』の空気が支配。VPNで本社・工場と接続しているが、セキュリティよりスピード優先。",

      "gh:organizationChart": {
        "gh:description": "典型的な日本の物流会社。現場と本社の温度差が大きい。",
        "gh:levels": [
          {
            "gh:level": 1,
            "gh:title": "経営層",
            "gh:positions": [
              {"gh:title": "代表取締役社長", "gh:name": "小島 雄三 (Yuzo Kojima)", "gh:characterId": "character:KojimaYuzo"},
              {"gh:title": "専務取締役（営業統括）", "gh:name": "三浦 正人 (Masato Miura)", "gh:characterId": "character:MiuraMasato"}
            ]
          },
          {
            "gh:level": 2,
            "gh:title": "部長クラス",
            "gh:positions": [
              {"gh:title": "物流本部長", "gh:name": "山下 剛 (Tsuyoshi Yamashita)", "gh:characterId": "character:YamashitaTsuyoshi"},
              {"gh:title": "情報システム部長", "gh:name": "田村 誠一 (Seiichi Tamura)", "gh:characterId": "character:TamuraSeiichi"}
            ]
          },
          {
            "gh:level": 3,
            "gh:title": "現場リーダー",
            "gh:positions": [
              {"gh:title": "川崎センター長", "gh:name": "佐々木 健太 (Kenta Sasaki)", "gh:characterId": "character:SasakiKenta"},
              {"gh:title": "システム運用チーフ", "gh:name": "遠藤 理沙 (Risa Endo)", "gh:characterId": "character:EndoRisa"}
            ]
          }
        ]
      },

      "gh:keyCharacters": [
        {
          "@id": "character:YamashitaTsuyoshi",
          "schema:name": "山下 剛 (Tsuyoshi Yamashita)",
          "schema:role": "物流本部長 / クライアント",
          "schema:age": 48,
          "gh:personality": "『始業絶対』の信念。現場叩き上げ。スピード至上主義で、セキュリティより納期。今回の事件で「短気」が招いた災厄を目の当たりにする。",
          "gh:relationship": "Takeruの手順主義と最初は衝突するが、最終的にその価値を認める。",
          "gh:ghost": "『始業の鐘』- 締切のプレッシャーが物理化したGhost。秒針の刃が首元に迫る形で顕現。"
        },
        {
          "@id": "character:TamuraSeiichi",
          "schema:name": "田村 誠一 (Seiichi Tamura)",
          "schema:role": "情報システム部長 / 内部協力者",
          "schema:age": 42,
          "gh:personality": "温厚だが優柔不断。現場の『急げ』に押されてVPN接続を許可してしまった。技術はわかるが政治に弱い。",
          "gh:relationship": "Takeruの技術を尊敬。内部から情報提供する。",
          "gh:function": "技術的な説明役。Takeruの専門用語を現場向けに翻訳。"
        },
        {
          "@id": "character:SasakiKenta",
          "schema:name": "佐々木 健太 (Kenta Sasaki)",
          "schema:role": "川崎センター長 / 現場代表",
          "schema:age": 35,
          "gh:personality": "熱血漢。部下思い。『止めるな』と『守れ』の板挟み。最終的にTakeruの『止めて守る』を受け入れる。",
          "gh:relationship": "Takeruと同世代。最初は反発するが、手順の意味を理解して協力者に。"
        },
        {
          "@id": "character:EndoRisa",
          "schema:name": "遠藤 理沙 (Risa Endo)",
          "schema:role": "システム運用チーフ / 技術サポート",
          "schema:age": 28,
          "gh:personality": "冷静沈着。セキュリティの重要性を理解しているが、現場で発言力がない。Takeruの介入で初めて声を上げる。",
          "gh:relationship": "Takeruの技術力に感銘。事件後、セキュリティ強化の推進役に。"
        }
      ],

      "gh:incidentReport": {
        "@id": "incident:251121-SupplyChain",
        "dct:date": "2026-11-25",
        "dct:title": "サプライチェーン攻撃によるライン停止",
        "gh:symptoms": [
          "VPN経由での不正アクセス検知",
          "在庫管理システムのデータ改ざん",
          "コンベヤ制御システムへの横展開",
          "『始業の鐘』に間に合わせようとした場当たり的再起動が被害拡大"
        ],
        "gh:impact": "トヨタ系サプライチェーン全体への波及リスク。数十億円規模の損害可能性。",
        "gh:rootCause": "リスク計算を放棄した『短気』な判断。場当たり的VPN接続と証拠を消す再起動指示。"
      }
    },

    {
      "@id": "company:TokaiSecurities",
      "@type": "gh:CompanyProfile",
