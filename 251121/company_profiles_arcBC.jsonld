      "gh:arc": "Arc C",
      "schema:location": {
        "@type": "schema:Place",
        "schema:address": "東京都千代田区丸の内 (Tokyo, Chiyoda-ku, Marunouchi)",
        "schema:description": "丸の内のガラス張り高層ビル。老舗証券会社の本社。表は洗練されているが、内部は旧態依然。"
      },
      "schema:employeeCount": 2800,
      "schema:foundingDate": "1952",
      "gh:businessType": "総合証券（リテール・機関投資家向け）",
      "gh:atmosphere": "金融庁ガイドライン遵守を誇る。だが『遵守した』ことが免罪符になり、実効性の検証が甘い。大理石のロビー、ガラス会議室、形式主義が支配。",

      "gh:organizationChart": {
        "gh:description": "伝統的な金融機関の縦割り組織。規程は完璧だが運用が形骸化。",
        "gh:levels": [
          {
            "gh:level": 1,
            "gh:title": "経営層",
            "gh:positions": [
