              {"gh:title": "専務取締役（リスク管理統括）", "gh:name": "黒田 雅彦 (Masahiko Kuroda)", "gh:characterId": "character:KurodaMasahiko"}
            ]
          },
          {
            "gh:level": 2,
            "gh:title": "部長クラス",
            "gh:positions": [
              {"gh:title": "コンプライアンス部長", "gh:name": "白石 悠子 (Yuko Shiraishi)", "gh:characterId": "character:ShiraishiYuko"},
              {"gh:title": "情報セキュリティ部長", "gh:name": "中村 俊介 (Shunsuke Nakamura)", "gh:characterId": "character:NakamuraShunsuke"},
              {"gh:title": "システム統括部長", "gh:name": "橋本 大輔 (Daisuke Hashimoto)", "gh:characterId": "character:HashimotoDaisuke"}
            ]
          },
          {
            "gh:level": 3,
            "gh:title": "実務担当",
            "gh:positions": [
              {"gh:title": "内部監査課長", "gh:name": "青木 玲奈 (Reina Aoki)", "gh:characterId": "character:AokiReina"},
              {"gh:title": "SOCアナリスト", "gh:name": "木村 翔 (Sho Kimura)", "gh:characterId": "character:KimuraSho"}
            ]
          }
        ]
      },

      "gh:keyCharacters": [
        {
          "@id": "character:KurodaMasahiko",
          "schema:name": "黒田 雅彦 (Masahiko Kuroda)",
          "schema:role": "専務取締役 / 主要対話相手",
          "schema:age": 58,
          "gh:personality": "金融庁ガイドライン遵守を絶対視。『規程を守っている』が口癖。形式主義の権化だが、根は責任感がある。Kanameに論破されて目が覚める。",
          "gh:relationship": "Kanameの最大の対話相手。傲慢さを指摘され、最終的に改革を受け入れる。",
          "gh:ghost": "『規程の城』- ガイドライン文書で築かれた砂の城。見た目は堅牢だが、一点を突くと崩れる。"
        },
        {
          "@id": "character:ShiraishiYuko",
          "schema:name": "白石 悠子 (Yuko Shiraishi)",
          "schema:role": "コンプライアンス部長 / 内部協力者",
          "schema:age": 45,
          "gh:personality": "元金融庁職員。ガイドラインの『最低ライン』の意味を本当に理解している数少ない人物。だが社内で孤立。",
          "gh:relationship": "Kanameのおじさん経由で紹介。内部から情報提供し、改革を後押し。",
          "gh:function": "規制の本質を説明する役割。『満たした≠安全』を体現。"
        },
        {
          "@id": "character:NakamuraShunsuke",
          "schema:name": "中村 俊介 (Shunsuke Nakamura)",
          "schema:role": "情報セキュリティ部長 / 技術対話相手",
          "schema:age": 40,
          "gh:personality": "技術はわかるが政治に潰される。『ログインMFAだけでは不十分』と提言したが却下された過去。Kanameの介入で再び声を上げる。",
          "gh:relationship": "Kanameの技術的な対話相手。支援士同士の専門会話。"
        },
        {
          "@id": "character:AokiReina",
          "schema:name": "青木 玲奈 (Reina Aoki)",
          "schema:role": "内部監査課長 / 若手協力者",
          "schema:age": 32,
          "gh:personality": "CISA取得を目指す若手。形骸化した監査に疑問を持っている。Kanameの監査眼に感銘を受け、弟子入り志願。",
          "gh:relationship": "Kanameの理想を体現しようとする若手。事件後の改革推進役。"
        }
      ],

      "gh:incidentReport": {
        "@id": "incident:251121-AccountFraud",
        "dct:date": "2026-11-28",
        "dct:title": "顧客口座不正出金事件",
        "gh:symptoms": [
          "複数顧客の受取口座が無断変更",
          "変更直後の大口出金",
          "ログインMFAは突破されていない（セッションハイジャック）",
          "重要操作へのMFA未適用が露呈",
          "ログは存在したが相関分析されておらず検知遅延"
        ],
        "gh:impact": "顧客資産流出。金融庁への報告義務。レピュテーションリスク。",
        "gh:rootCause": "『金融庁ガイドライン遵守』という傲慢。最低ラインを満たしただけで安心し、重要操作MFA・異常検知・冷却期間・24/7監視・委託先統制が不十分だった。"
      }
    }
  ],

  "gh:mizukiFamily": {
    "@id": "gh:family/Mizuki",
    "dct:title": "水城家 - 金融界の影の実力者",
    "gh:description": "表向きは没落した旧華族。だが金融・法曹界に広がる人脈と情報網を持つ。Kanameのおじさんが現当主として、一族の復興を静かに進めている。",
    "gh:members": [
      {
        "@id": "character:MizukiShinji",
        "schema:name": "水城 慎司 (Shinji Mizuki)",
        "schema:role": "Kanameのおじさん / 影の支援者",
        "schema:age": 52,
        "gh:relationship": "Kanameの父の弟。Kanameの才能を見出し、金融業界の案件を紹介する。",
        "gh:background": {
          "gh:education": "東京大学法学部卒",
          "gh:career": [
            "元財務省主計局",
            "元金融庁総務企画局",
            "現在は複数の金融機関の社外取締役"
          ],
          "gh:expertise": [
            "金融規制",
            "コーポレートガバナンス",
            "不正調査"
          ]
        },
        "gh:personality": {
          "gh:appearance": "気弱そうな中年男性。丸眼鏡、やや猫背、地味なグレーのスーツ。誰もが侮る風貌。",
          "gh:reality": "金融業界の不正、業界の闘、組織構造の問題を熟知。一族のポジションを高めるため、戦略的にKanameを活用。だがKanameへの愛情は本物。",
          "gh:speech": "「いやぁ、僕なんかが口出しすることじゃないんですが…」と謙遜しながら、核心を突く。",
          "gh:intellect": "法律、会計、IT、組織論のすべてに精通。表に出ない参謀タイプ。"
        },
        "gh:function": {
          "gh:storyRole": "Kanameを企業に紹介するフィクサー。表向きは『親戚の紹介』だが、実際は一族の戦略の一環。",
          "gh:dialoguePartner": "Kanameと知的な会話を交わし、金融業界の構造的問題を解説する役割。",
          "gh:futurePlot": "一族の野望と、Kanameの正義感の間で、将来的に葛藤が生まれる伏線。"
        }
      },
      {
        "@id": "character:Kaname",
        "gh:familyPosition": "水城家本家の長男",
        "gh:relationToShinji": "甥。慎司の兄の息子。",
        "gh:familyDynamic": "両親は事故で他界。慎司が後見人的立場。Kanameは叔父の知性を尊敬しつつも、その計算高さに違和感を感じることも。"
      }
    ]
  }
}
