{
  "@id": "page:11",
  "@type": "gh:MangaPage",
  "gh:panels": [
    {
      "dialogue": [
        {
          "speaker": "Ren",
          "text": "Nei、SIP起動。こいつを物理レイヤーに固定する。"
        }
      ],
      "panel:id": 1,
      "visual": "Ren、スマホを操作。「SIP Device: ON」"
    },
    {
      "dialogue": [
        {
          "speaker": "Nei",
          "text": "承知いたしました。SIPシークエンスを開始します。"
        }
      ],
      "panel:id": 2,
      "visual": "空間がデジタルノイズに包まれ、Ghostの質量が増す。"
    },
    {
      "dialogue": [
        {
          "speaker": "Ghost",
          "text": "消エロオォォ！！"
        }
      ],
      "panel:id": 3,
      "visual": "Ghostが暴れ、棚をなぎ倒す。物理的な破壊力があることを示す。"
    }
  ]
}