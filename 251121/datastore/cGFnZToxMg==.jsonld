{
  "@id": "page:12",
  "@type": "gh:MangaPage",
  "gh:panels": [
    {
      "dialogue": [
        {
          "speaker": "Shouta",
          "text": "くそっ！松田さん、下がって！"
        }
      ],
      "panel:id": 1,
      "visual": "翔太、とっさに松田を庇う。"
    },
    {
      "dialogue": [
        {
          "speaker": "Ren",
          "text": "その「自分が一番」っていうエゴ。ノイズが多すぎるんだよ。"
        }
      ],
      "panel:id": 2,
      "visual": "Renの手元にデータの光が集まり、斧（Digital Axe）を形成する。"
    },
    {
      "dialogue": [
        {
          "speaker": "Ren",
          "text": "デリートしてやる。"
        }
      ],
      "panel:id": 3,
      "visual": "Ren、踏み込む。"
    }
  ]
}