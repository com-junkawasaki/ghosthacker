{
  "@id": "page:14",
  "@type": "gh:MangaPage",
  "gh:panels": [
    {
      "dialogue": [
        {
          "speaker": "Ghost",
          "text": "俺ハ…タダ…認メテ…欲シカッ……"
        }
      ],
      "panel:id": 1,
      "visual": "Ghostが霧散し、安本が崩れ落ちる。"
    },
    {
      "dialogue": [
        {
          "speaker": "Sato",
          "text": "あ…！画面が戻った！サーバーも認識してます！"
        }
      ],
      "panel:id": 2,
      "visual": "オフィスに静寂が戻る。モニターのロック画面が消え、デスクトップが表示される。"
    },
    {
      "dialogue": [
        {
          "speaker": "Yasumoto",
          "text": "うう…すまん…すまん…"
        }
      ],
      "panel:id": 3,
      "visual": "安本、床に座り込んで泣く。"
    }
  ]
}