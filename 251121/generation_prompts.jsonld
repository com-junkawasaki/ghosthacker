        {
          "@id": "gh:panelPrompt/p15-1",
          "pageId": "page:15",
          "panelIndex": 1,
          "promptEn": "The company president, Goro Daimon, stands at the office entrance in his work clothes. He looks shocked and confused by the disastrous scene before him."
        },
        {
          "@id": "gh:panelPrompt/p15-2",
          "pageId": "page:15",
          "panelIndex": 2,
