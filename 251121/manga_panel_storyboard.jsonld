{
  "@context": {
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "schema": "http://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "panel": "gh:panelIndex",
    "purpose": "gh:narrativePurpose",
    "shot": "gh:shotType",
    "prompt": "gh:runwayPrompt"
  },
  "@id": "gh:storyboard/manga-season1-panels",
  "@type": "gh:MangaPanelStoryboard",
  "dct:title": "Ghost Hacker Season 1: Manga Panel (Cut) Storyboard",
  "dct:description": "Granular panel-by-panel storyboard prompts for Manga production, optimized for Runway video generation. Each page contains 1-8 cuts based on visual impact and rhythm.",
  "gh:globalStyle": "Professional monochrome manga art, high-contrast black and white, crisp line art, heavy screentone shading, halftone dot texture, modern seinen manga aesthetic, sharp focus, manga scanlation style.",
  "gh:mangaPrinciples": {
    "gh:layoutLogic": "Impression (1-3 panels for impact) vs. Rhythm (4-8 panels for development/dialogue)",
    "gh:pageUnit": "1-8 panels per page",
    "gh:lastPanelRule": "Mini-cliffhanger (pull) to make the reader turn the page",
    "gh:runwayConstraints": "Maximum 3 entities per prompt, cinematic camera/lighting terms, no dialogue text."
  },
  "gh:episodes": [
    {
      "gh:episode": 1,
      "dct:title": "牙を剥く内部の影",
      "gh:pages": [
        {
          "gh:pageNumber": 1,
          "gh:layoutType": "Information Heavy",
          "gh:panels": [
            {
              "panel": 1,
              "purpose": "Context",
              "shot": "Wide Angle",
              "prompt": "Wide Angle, Professional monochrome manga art. A historical evolution chart from primitive man to modern human, heavy ink strokes, high contrast background. Dramatic shadows."
            },
            {
              "panel": 2,
              "purpose": "History",
              "shot": "Medium Shot",
              "prompt": "Medium Shot, Professional monochrome manga art. Silhouette of a giant ancient Buddha statue and totem poles, halftone texture, glowing faintly behind a modern data server rack. Sharp line art."
            },
            {
              "panel": 3,
              "purpose": "Context",
              "shot": "Bird's Eye View",
              "prompt": "Bird's Eye View, Professional monochrome manga art. Tokyo city 2026 at night, rivers of neon data streams between skyscrapers, dense screentone for sky, crisp outlines."
            }
          ]
        },
        {
          "gh:pageNumber": 2,
          "gh:layoutType": "High Impact",
          "gh:panels": [
            {
              "panel": 1,
              "purpose": "Highlight",
              "shot": "Full Page Vertical",
              "prompt": "Full Page Vertical, Professional monochrome manga art. (Ren: 17-year-old male, messy voluminous black hair) and (Nei: android, blonde hair) floating in a vortex of digital grids and collapsing buildings. High-contrast ink drawing, heavy screentone."
            }
          ]
        },
        {
          "gh:pageNumber": 4,
          "gh:layoutType": "Rhythm",
          "gh:panels": [
            {
              "panel": 1,
              "purpose": "Daily Life",
              "shot": "Medium Shot",
              "prompt": "Medium Shot, Professional monochrome manga art. (Ren: 17-year-old male, dark hoodie) slouching deeply in a high-end ergonomic chair, picking his ear. Rim lighting from window, crisp line art, halftone dot shading."
            },
            {
              "panel": 2,
              "purpose": "Reaction",
              "shot": "Close-up",
              "prompt": "Close-up, Professional monochrome manga art. (Nei: 16-year-old android, blonde hair) looking exasperated, holding a tablet. Detailed expressive eyes, dense screentone on clothing, sharp focus."
            },
            {
              "panel": 3,
              "purpose": "Dialogue",
              "shot": "Two Shot / Medium Shot",
              "prompt": "Two Shot, Medium Shot, Professional monochrome manga art. Ren and Nei. Nei pointing at a tablet screen with a 'LOW FUNDS' icon. Cluttered tech-office background with detailed textures, dramatic office lighting."
            },
            {
              "panel": 17,
              "purpose": "Pull",
              "shot": "Extreme Close-up",
              "prompt": "Extreme Close-up, Professional monochrome manga art. Ren's sharp half-lidded eye suddenly wide and alert. High contrast, intense ink-drawn eyelashes, halftone texture."
            }
          ]
        },
        {
          "gh:pageNumber": 5,
          "gh:layoutType": "Rhythm",
          "gh:panels": [
            {
              "panel": 1,
              "purpose": "Action",
              "shot": "Low Angle / Medium Shot",
              "prompt": "Low Angle, Medium Shot, Professional monochrome manga art. (Shouta: 26-year-old male, navy suit) stepping into the office. Serious facial expression, sweat on brow, rim lighting from the door frame."
            },
            {
              "panel": 2,
              "purpose": "Action",
              "shot": "Medium Shot",
              "prompt": "Medium Shot, Professional monochrome manga art. (Ren: 17-year-old male) standing up slowly from his chair, intense eye contact with Shouta. Strong shadows, halftone shading on hoodie."
            },
            {
              "panel": 3,
              "purpose": "Dialogue",
              "shot": "Close-up",
              "prompt": "Close-up, Professional monochrome manga art. (Shouta: 26-year-old male) looking weary and pleading. Intricate facial line work, heavy screentone on his dark suit, sharp focus on eyes."
            },
            {
              "panel": 4,
              "purpose": "Action",
              "shot": "Tracking Shot / Medium Shot",
              "prompt": "Medium Shot, Professional monochrome manga art. Ren grabbing a laptop bag and a USB drive, (Nei: android) following closely behind. High-speed line effects, crisp outlines, dynamic perspective."
            }
          ]
        },
        {
          "gh:pageNumber": 6,
          "gh:layoutType": "Rhythm",
          "gh:panels": [
            {
              "panel": 1,
              "purpose": "Context",
              "shot": "Wide Shot",
              "prompt": "Wide Shot, Professional monochrome manga art. Interior of an old Japanese construction office. Scattered blueprints, FAX machines, 50 staff in panic. Harsh fluorescent lighting, dense screentone for depth."
            },
            {
              "panel": 2,
              "purpose": "Reaction",
              "shot": "Close-up",
              "prompt": "Close-up, Professional monochrome manga art. (Matsuda: 58-year-old woman) with permed hair, face distorted in panic, holding two telephone receivers. High contrast, halftone dot texture on her face."
            },
            {
              "panel": 3,
              "purpose": "Action",
              "shot": "Low Angle / Close-up",
              "prompt": "Low Angle, Close-up, Professional monochrome manga art. (Sato: 24-year-old male) sweating, looking up from under a dark server rack. Tangled cables like snakes in the background, sharp line work."
            },
            {
              "panel": 4,
              "purpose": "Reaction",
              "shot": "Medium Shot",
              "prompt": "Medium Shot, Professional monochrome manga art. (Ren: 17-year-old male) surveying the office mess with a cynical smile. Rim light from computer screens, detailed office equipment in halftone."
            }
          ]
        },
        {
          "gh:pageNumber": 7,
          "gh:layoutType": "High Impact",
          "gh:panels": [
            {
              "panel": 1,
              "purpose": "Conflict",
              "shot": "Medium Shot",
              "prompt": "Medium Shot, Professional monochrome manga art. (Yasumoto: 52-year-old sweaty male) pointing an aggressive finger. High-contrast ink drawing, popping veins on neck, heavy shadows under eyes."
            },
            {
              "panel": 2,
              "purpose": "Action",
              "shot": "Close-up",
              "prompt": "Close-up, Professional monochrome manga art. (Ren: 17-year-old male) adjusting his smart-glasses. Reflection of a terrified Yasumoto in the glass lens, sharp focus, intricate line art."
            },
            {
              "panel": 3,
              "purpose": "Highlight",
              "shot": "Medium Shot / Low Angle",
              "prompt": "Medium Shot, Low Angle, Professional monochrome manga art, surreal. AR Vision: A massive, black shadowy hand of a Ghost emerging from (Yasumoto: 52-year-old male)'s back. Glitch effects, intense screentone contrast."
            }
          ]
        }
      ]
    }
  ]
}
