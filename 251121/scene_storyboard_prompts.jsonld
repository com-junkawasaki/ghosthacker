      "gh:scenes": [
        { "gh:scene": "Morning After", "gh:prompt": "photorealistic, 8k. Quiet office, the team trying to work. (Shouta: 26-year-old male) looking at (Yasumoto: 52-year-old male) with mixed feelings. Soft morning light." },
        { "gh:scene": "The Crash", "gh:prompt": "photorealistic, 8k. Every screen turning red simultaneously. Panic returns. (Shouta: 26-year-old male) slamming his fist on the desk. Dramatic red lighting." },
        { "gh:scene": "Ren's Return", "gh:prompt": "photorealistic, 8k. (Ren: 17-year-old male) entering the office, looking even more tired. 'I told you forgiveness is negligence.' Cold, sharp look." },
        { "gh:scene": "SBOM Analysis", "gh:prompt": "photorealistic, 8k. (Nei: android, blonde bob) projecting a complex 3D supply-chain map. 'The poison came from the vendor.' Glowing blue lines in a dark room." },
        { "gh:scene": "The Confrontation", "gh:prompt": "photorealistic, 8k. (Ren: 17-year-old male) forcing (Shouta: 26-year-old male) to sign a strict security policy. Tension, weight of responsibility." },
        { "gh:scene": "Vendor Link", "gh:prompt": "photorealistic, 8k. A dark server room at a mysterious external company. A single red light blinking. The next lead. Mysterious, cold." }
