        { "gh:scene": "Toru's Despair", "gh:prompt": "photorealistic, 8k. (Toru Sasaki: 34-year-old male) sweating in a dark room, surrounded by monitors. (Reika Kujoin: 45-year-old woman) shadow looming over him." },
        { "gh:scene": "Audit Hacking", "gh:prompt": "photorealistic, 8k. (Kaname: 18-year-old male) and (Nei: android, blonde bob) collaborating. 'You audit, I analyze.' Unexpected high-level technical synergy." },
        { "gh:scene": "The Golden Ghost", "gh:prompt": "photorealistic, 8k. The rule knight turning into a golden dragon made of stolen currency. It flies through the financial district at night." },
