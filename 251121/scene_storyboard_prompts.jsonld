        { "gh:scene": "Trio Gathering", "gh:prompt": "photorealistic, 8k. (Ren: 17-year-old male) standing between (Shouta: 26-year-old male) and (President: 62-year-old male). Breaking the old family myths. Dramatic three-way shot." },
        { "gh:scene": "Digital Ritual", "gh:prompt": "photorealistic, 8k. (Ren: 17-year-old male) using a digital rope tool to bind the ghost. Blue energy threads weaving through the office air." },
