  "dct:title": "Ghost Hacker Season 1: Detailed Scene-by-Scene Storyboard Prompts",
  "dct:description": "Detailed cinematic prompts for every major scene in Season 1, optimized for photorealistic AI video generation.",
  "gh:globalStyle": "photorealistic, 8k, raw photo, cinematic lighting, dramatic shadows, high contrast, sharp focus, masterpiece.",
  "gh:episodes": [
    {
      "gh:episode": 1,
      "dct:title": "Arc A-1: 牙を剥く内部の影",
      "gh:scenes": [
        { "gh:page": 1, "gh:scene": "History of Spirit", "gh:prompt": "photorealistic, 8k. A historical montage: primitive humans around a fire, silhouettes of giant Buddha and totem poles superimposed on modern Tokyo skyscraper data streams. Cinematic, epic scale." },
        { "gh:page": 2, "gh:scene": "Title Shot", "gh:prompt": "photorealistic, 8k, cyberpunk. (Ren: 17-year-old Japanese male, messy black hair) and (Nei: android, blonde bob) floating in a vortex of digital grids and city fragments. 'GHOST Hacker' title logo." },
        { "gh:page": 4, "gh:scene": "Ren's Daily Life", "gh:prompt": "photorealistic, 8k. (Ren: 17-year-old male, hoodie) slouching lazily in a modern office chair. (Nei: android, blonde bob) nagging him with a tablet. Natural light, cluttered high-tech room." },
        { "gh:page": 5, "gh:scene": "Shouta's Visit", "gh:prompt": "photorealistic, 8k. (Shouta: 26-year-old Japanese man, navy suit) at the office door, looking desperate. (Ren: 17-year-old male) looking annoyed. Intense eye contact." },
        { "gh:page": 6, "gh:scene": "Daimon Construction Office", "gh:prompt": "photorealistic, 8k. Chaotic 1980s-style Japanese office. (Matsuda: 58-year-old woman) screaming on phone. (Sato: 24-year-old male) under a desk with cables. Dust in the air, harsh fluorescent lights." },
        { "gh:page": 7, "gh:scene": "Yasumoto and Ghost Aura", "gh:prompt": "photorealistic, 8k. (Yasumoto: 52-year-old sweaty Japanese man) arguing. AR POV: a dark, shadowy figure of jealousy clinging to his back. Gritty, high contrast." },
        { "gh:page": 8, "gh:scene": "Fast Hacking", "gh:prompt": "photorealistic, 8k. Close-up of (Ren: 17-year-old male) hands typing at blinding speed. Code reflecting in his sharp eyes. Blurred background of the busy office." },
        { "gh:page": 9, "gh:scene": "Exposing the Insider", "gh:prompt": "photorealistic, 8k. (Ren: 17-year-old male) pointing at (Yasumoto: 52-year-old male). Office staff staring in shock. Dramatic lighting on Ren's accusatory face." },
        { "gh:page": 10, "gh:scene": "Ghost Emergence", "gh:prompt": "photorealistic, 8k, horror. A monster made of LAN cables and paper documents tearing out of (Yasumoto: 52-year-old male)'s shadow. Glitchy air, screams." },
        { "gh:page": 11, "gh:scene": "SIP Activation", "gh:prompt": "photorealistic, 8k, sci-fi. (Ren: 17-year-old male) holding a smartphone showing 'SIP: ON'. Blue digital grid spreading across the room, anchoring the Ghost." },
        { "gh:page": 12, "gh:scene": "Axe Formation", "gh:prompt": "photorealistic, 8k, vfx. Glowing blue particles forming a massive digital axe in (Ren: 17-year-old male)'s hand. (Shouta: 26-year-old male) shielding (Matsuda: 58-year-old woman) in the background." },
        { "gh:page": 13, "gh:scene": "The Final Chop", "gh:prompt": "photorealistic, 8k, action. (Ren: 17-year-old male) leaping mid-air, striking the Ghost's core with the digital axe. Explosion of data and light. Motion blur." },
        { "gh:page": 14, "gh:scene": "Ghost Dissolution", "gh:prompt": "photorealistic, 8k. The cable monster turning into white ash and digital sparks. (Yasumoto: 52-year-old male) weeping on the floor. Office screens coming back to life." },
        { "gh:page": 15, "gh:scene": "President's Return", "gh:prompt": "photorealistic, 8k. (President: 62-year-old Japanese man, work clothes) entering the messy office. (Shouta: 26-year-old male) making a heavy decision. Emotional scene." },
        { "gh:page": 16, "gh:scene": "Recovery", "gh:prompt": "photorealistic, 8k. (Matsuda: 58-year-old woman) cheering at a bank screen. (Ren: 17-year-old male) walking away, looking at his phone. Relief." },
        { "gh:page": 17, "gh:scene": "Epilogue", "gh:prompt": "photorealistic, 8k. (Ren: 17-year-old male) and (Nei: android, blonde bob) walking in Kamata at dusk. Neon signs, orange sunset. Ren smirking at his bank balance." }
      ]
    },
    {
      "gh:episode": 2,
