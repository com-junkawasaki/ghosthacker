  "gh:criminalEcosystem": {
    "@id": "ecosystem:unnamed-season1",
    "@type": "gh:CriminalEcosystem",
    "schema:name": "TBD (ecosystem name to be decided)",
    "gh:positioning": "A financially-motivated ecosystem that exploits supply chains and market psychology to profit (ransom, laundering, and market operations).",
    "gh:frontActorTeams": [
      {
        "@id": "gh:actorTeam/seigi-hero",
        "@type": "gh:ActorTeam",
        "schema:name": "SEIGI_HERO",
        "gh:representative": {
          "@id": "character:HERO",
          "@type": "gh:Antagonist",
          "schema:name": "HERO",
          "gh:legalName": "佐藤 ヒロシ (Hiroshi Sato)",
          "gh:note": "SEIGI_HEROの代表格。海外拠点で『正義』を名乗り、告発と破壊を混同する。痛くてダサいが悪意はある。理解はできても同情されない。"
        },
        "gh:note": "A 'painful' Japanese actor team operating from overseas. They believe they are justice, but are morally weak, shallow, and easily ridden by the ecosystem. The story understands their psychology but does not sympathize; they must atone and rehabilitate.",
        "gh:homeGhostCore": {
          "@type": "gh:Ghost",
          "schema:name": "親に逆らえない怒りの転写 (Parent Rage Displacement)",
          "gh:description": "They cannot confront their real parents, so they redirect resentment toward the state, companies, and strangers. 'Justice' becomes a mask for cowardice and approval-seeking."
        },
        "gh:operations": [
          {
            "schema:name": "Ore-ore style fraud / social engineering",
            "gh:note": "They run phone/DM-based fraud patterns and human manipulation alongside cybercrime."
          },
          {
            "schema:name": "Yami-baito recruitment (gig-style crime)",
            "gh:channels": ["X", "LINE"],
            "gh:note": "They recruit disposable runners/operators via social platforms and messaging apps."
          },
          {
            "schema:name": "Supply-chain enabled intrusion (ecosystem-provided)",
            "gh:note": "They do not build sophisticated software; they buy/rent access, loaders, and ransomware kits from the ecosystem."
          }
        ],
        "gh:capabilities": [
          "low-skill coordination",
          "social engineering and recruitment",
          "operational harassment and disruption",
          "acting as an affiliate for larger ransomware/market ops"
        ],
        "gh:weaknesses": [
          "poor OPSEC",
          "ego-driven bragging",
          "inconsistent stories",
          "traceable payment and recruitment patterns"
        ],
        "gh:seasonOutcome": {
          "gh:episode": 12,
          "gh:result": "Identified and arrested (overseas base) through international coordination.",
          "gh:involvedOrgs": ["org:mpd-cyber", "org:npa-cyber", "org:interpol", "org:fbi", "org:europol-ec3", "org:nca-nccu", "org:sesc", "org:tse"]
        }
      }
    ],
    "gh:components": [
      { "schema:name": "Initial Access Brokers (IAB)", "gh:does": "Sell/auction access (credentials, footholds) across victims and suppliers." },
      { "schema:name": "Access-as-a-Service / Malware loaders", "gh:does": "Provide delivery mechanisms and persistence kits." },
      { "schema:name": "RaaS Operators", "gh:does": "Provide ransomware tooling and negotiation infrastructure." },
      { "schema:name": "Affiliates", "gh:does": "Execute intrusions and deploy payloads; vary by region, causing signature drift." },
      { "schema:name": "Data Theft / Leak Ops", "gh:does": "Operate double extortion: theft + threat of exposure." },
      { "schema:name": "PsyOps / Narrative Ops", "gh:does": "Amplify fear through leaks, timing, and rumors to move markets." },
      { "schema:name": "Market Ops", "gh:does": "Profit via short-selling/options/arbitrage around disruption and panic." },
      { "schema:name": "Laundering Ops", "gh:does": "Crypto mixing/OTC conversion/nominee networks; evades tracing." },
      { "schema:name": "Bulletproof Hosting / Infra Providers", "gh:does": "Provide resilient infrastructure, fast rotation, and takedown resistance." },
      { "schema:name": "Exploit Supply / Vulnerability Brokers", "gh:does": "Supply exploits; prioritize widely deployed supply-chain software." }
    ],
    "gh:realWorldAnalogyNote": "Real-world financially motivated groups and ecosystems exist (e.g., ransomware-as-a-service and access brokers). This story uses a fictionalized ecosystem and does not claim attribution for specific historical incidents.",
    "gh:inspiration": [
      "RaaS-style ecosystems (general)",
      "Access broker markets (general)",
      "Market manipulation as a motive (fictionalized connection)"
    ],
    "gh:askulLink": {
      "schema:name": "Askul-like disruption → market profit mechanism",
      "gh:note": "Uses a real-world style of large-scale disruption as inspiration. In the story, the ecosystem designs disruption timing to influence market psychology and profit via positions."
    }
  },
  "gh:seasonStructure": {
    "gh:format": "One company = one major incident (case). Each case spans 1–3 episodes to cover technical response → governance/practice → Ghost resolution.",
    "gh:episodes": [
      {
        "@id": "gh:episode/s01e01",
        "gh:number": 1,
        "dct:title": "Arc A-1: 牙を剥く内部の影",
        "gh:arc": "arc:A",
        "gh:company": "org:daimon-construction",
        "gh:focusVirtue": "gh:virtue/sloth",
        "gh:mainCharacters": ["character:Ren", "character:Nei"],
        "gh:incident": {
          "schema:name": "Ransomware + Insider (initial detonation)",
          "gh:surface": "全システム停止・電話鳴り止まず・給与/工事/発注が止まる",
          "gh:root": "情と曖昧さで設計を放棄した運用（権限/ログ/バックアップ不明）+ 内部の出来心"
        },
        "gh:openingHook": "『会社が止まった』という依頼。現場は“努力”で回しているように見えるが、Renは一目で“設計放棄”を嗅ぐ。",
        "gh:practiceBeats": [
          "初動：隔離・証拠保全（勝手に電源を切らせない）",
          "最小復旧：重要業務の優先順位と代替手段を整理",
          "侵入点の仮説：既知の穴（KEV）と人為ミスを並行で追う"
        ],
        "gh:ghostBattle": {
          "schema:name": "疎外感/陳腐化の恐怖のGhost（LANケーブルと紙束の巨体）",
          "gh:visual": "古い規程書・紙・ケーブルが絡み合い、責任の所在が見えない霧を吐く",
          "gh:turn": "Neiが『急所（既知の穴）』を可視化→Renが最短で核を割る"
        },
        "gh:conflict": "社長は『情』で収めようとし、翔太は揺れる。Renは“許し”が再発を作ると感じて怒りが増す。",
        "gh:cliffhanger": "社長が安本を許そうとした瞬間、Renが止める。『それは「怠惰」だ。』額縁ルールが黒く滲む。",
        "gh:evidenceProduced": [
          "端末/ログ/侵入経路の一次証拠（のちにJPCERT/警察に渡せる形）",
          "内部端末からの実行痕跡（『出来心』の具体化）"
        ]
      },
      {
        "@id": "gh:episode/s01e02",
        "gh:number": 2,
        "dct:title": "Arc A-2: 許しの毒（CISSPで殴る）",
        "gh:arc": "arc:A",
        "gh:company": "org:daimon-construction",
        "gh:focusVirtue": "gh:virtue/sloth",
        "gh:mainCharacters": ["character:Ren", "character:Nei"],
        "gh:openingHook": "復旧直後、再侵害の兆候。『終わったことにした』ツケが襲う。",
        "gh:practiceBeats": [
          "再発防止の条件：権限剥奪・職務分掌・ログ保全・バックアップの棚卸し",
          "“許す”を設計へ：条件付き復帰、監査可能性、責任境界の確定",
          "証拠が消える前に“手順で止める”"
        ],
        "gh:ghostBattle": {
          "schema:name": "善意の顔をした『見て見ぬふり』Ghost（額縁ルールの呪い）",
          "gh:visual": "先代の額縁から文字が滲み、笑顔の仮面になって人を黙らせる",
          "gh:turn": "Renは個人を裁かず、環境を変える“最小の設計”を強制する"
        },
        "gh:conflict": "『家族みたいな会社』という価値観 vs 再発の確率。情が“怠惰”に変わる瞬間をRenが暴く。",
        "gh:cliffhanger": "Neiが検知：外部から“委託先経由”の足跡。『供給網に匂いがあります』",
        "gh:evidenceProduced": [
          "委託/外部ベンダ起点のアクセス痕跡（サプライチェーン線）",
          "監査に耐える形の証跡パッケージ（捜査引き渡し前提）"
        ]
      },
      {
        "@id": "gh:episode/s01e03",
        "gh:number": 3,
        "dct:title": "Arc A-3: 偽りの声、真実の瞳（情の再設計）",
        "gh:arc": "arc:A",
        "gh:company": "org:daimon-construction",
        "gh:focusVirtue": "gh:virtue/sloth",
        "gh:mainCharacters": ["character:Ren", "character:Nei"],
        "gh:openingHook": "取引先でBEC発生。『至急振込』が“善意の急ぎ”として侵入する。",
        "gh:practiceBeats": [
          "送金/承認の“場”を作る（コールバック・二者承認・MFA）",
          "人を責めず、プロセスを責める（再発を止める仕組み化）",
          "取引先も含めて“連鎖”として対策する"
        ],
        "gh:ghostBattle": {
          "schema:name": "焦りのGhost（『今すぐ』の糸が経理の手を操る）",
          "gh:turn": "Renが“怠惰にできる仕組み”＝確認の手順を定着させ、糸を切る"
        },
        "gh:conflict": "翔太は“スピードの正義”に揺れるが、Renは『速さのために人が燃えるのは怠惰』と切り捨てる。",
        "gh:cliffhanger": "痕跡が物流/配車の基盤へ。Nei『次は物理に来ます』→Arc Bへ。",
        "gh:evidenceProduced": [
          "詐欺送金先の口座/暗号資産ルートの端緒（後のSESC線）",
          "X/LINE由来のリクルート断片（闇バイト線の予兆）"
        ]
      },
      {
        "@id": "gh:episode/s01e04",
        "gh:number": 4,
        "dct:title": "Arc B-1: 都市の心臓を止める者（猛 登場）",
        "gh:arc": "arc:B",
        "gh:company": "org:jinpu-mobility",
        "gh:focusVirtue": "gh:virtue/short-tempered",
        "gh:mainCharacters": ["character:Ren", "character:Nei", "character:Takeru"],
        "gh:openingHook": "配車/物流が詰まり、街が止まる。現場は『待つ』ことを強いられる。",
        "gh:practiceBeats": [
          "OT/IoTの緊急遮断と安全側停止（人命優先）",
          "分離・迂回・手動運用の発動（止め方の手順）",
          "KEV起点の侵入疑いを現場で切り分け"
        ],
        "gh:ghostBattle": {
          "schema:name": "我慢のGhost（鎖で現場を締め上げる）",
