  "gh:criminalEcosystem": {
    "@id": "ecosystem:unnamed-season1",
    "@type": "gh:CriminalEcosystem",
    "schema:name": "TBD (ecosystem name to be decided)",
    "gh:positioning": "A financially-motivated ecosystem that exploits supply chains and market psychology to profit (ransom, laundering, and market operations).",
    "gh:components": [
      { "schema:name": "Initial Access Brokers (IAB)", "gh:does": "Sell/auction access (credentials, footholds) across victims and suppliers." },
      { "schema:name": "Access-as-a-Service / Malware loaders", "gh:does": "Provide delivery mechanisms and persistence kits." },
      { "schema:name": "RaaS Operators", "gh:does": "Provide ransomware tooling and negotiation infrastructure." },
      { "schema:name": "Affiliates", "gh:does": "Execute intrusions and deploy payloads; vary by region, causing signature drift." },
      { "schema:name": "Data Theft / Leak Ops", "gh:does": "Operate double extortion: theft + threat of exposure." },
      { "schema:name": "PsyOps / Narrative Ops", "gh:does": "Amplify fear through leaks, timing, and rumors to move markets." },
      { "schema:name": "Market Ops", "gh:does": "Profit via short-selling/options/arbitrage around disruption and panic." },
      { "schema:name": "Laundering Ops", "gh:does": "Crypto mixing/OTC conversion/nominee networks; evades tracing." },
      { "schema:name": "Bulletproof Hosting / Infra Providers", "gh:does": "Provide resilient infrastructure, fast rotation, and takedown resistance." },
      { "schema:name": "Exploit Supply / Vulnerability Brokers", "gh:does": "Supply exploits; prioritize widely deployed supply-chain software." }
    ],
    "gh:realWorldAnalogyNote": "Real-world financially motivated groups and ecosystems exist (e.g., ransomware-as-a-service and access brokers). This story uses a fictionalized ecosystem and does not claim attribution for specific historical incidents.",
    "gh:inspiration": [
      "RaaS-style ecosystems (general)",
      "Access broker markets (general)",
      "Market manipulation as a motive (fictionalized connection)"
    ],
    "gh:askulLink": {
      "schema:name": "Askul-like disruption → market profit mechanism",
      "gh:note": "Uses a real-world style of large-scale disruption as inspiration. In the story, the ecosystem designs disruption timing to influence market psychology and profit via positions."
    }
  },
  "gh:seasonStructure": {
    "gh:format": "One company = one major incident (case). Each case spans 1–3 episodes to cover technical response → governance/practice → Ghost resolution.",
    "gh:arcs": [
      {
        "@id": "arc:A",
        "schema:name": "Arc A - Daimon (Sloth / environmental negligence)",
        "gh:episodes": [1, 2, 3],
        "gh:coreGhost": "Forgiveness-as-negligence; legacy rules as a curse",
        "gh:finalLine": "それは「怠惰」だ。"
      },
      {
        "@id": "arc:B",
        "schema:name": "Arc B - JINPU (Short-tempered / KPI-only impatience)",
        "gh:episodes": [4, 5, 6],
        "gh:coreGhost": "Speed that forces endurance; numbers that command people",
        "gh:finalLine": "あんたら、短気だな。"
      },
      {
        "@id": "arc:C",
        "schema:name": "Arc C - BYAKUDAN (Arrogance / rules using people)",
        "gh:episodes": [7, 8, 9],
        "gh:coreGhost": "Rigid procedures and pride; responsibility evasion by rules",
        "gh:finalLine": "それは傲慢ですね。"
      },
      {
        "@id": "arc:D",
        "schema:name": "Arc D - Cross-supply-chain / market ops (Ecosystem Ghost)",
        "gh:episodes": [10, 11, 12],
        "gh:coreGhost": "The ecosystem itself: supply-chain parasitism + market psychology",
        "gh:finalLine": "Ghost is not a person. It's the market of negligence."
      }
    ]
  }
}

