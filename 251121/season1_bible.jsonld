      "@id": "role:jp-cyber-analyst",
      "schema:name": "日本のサイバー分析官（広域調整）",
      "gh:responsibilities": ["複数事案の関連付け", "TTPの整理", "国際照会の整理", "組織間調整"]
    },
    {
      "@id": "role:market-investigator",
      "schema:name": "市場犯罪調査官（SESC/取引監視）",
      "gh:responsibilities": ["不審な売買の検知", "空売り・オプションの動き", "風説/情報操作の追跡", "証券会社への照会"]
    },
    {
      "@id": "role:cert-coordination-analyst",
      "schema:name": "CERTアナリスト（IoC/TTP共有）",
      "gh:responsibilities": ["IoC共有", "注意喚起", "マルウェア分析", "被害組織の横連携"]
    },
    {
      "@id": "role:international-liaison",
      "schema:name": "国際連携（INTERPOL/FBI/Europol/NCA）",
      "gh:responsibilities": ["国際照会", "押収インフラの解析共有", "暗号資産追跡", "越境手配"]
    }
  ],
