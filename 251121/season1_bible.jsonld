  "@id": "gh:season/01",
  "@type": ["gh:SeasonBible", "prov:Entity"],
  "dct:title": "Ghost Hacker - Season 1 Bible (Case Study / Crime Ecosystem)",
  "dct:description": "Season 1 focuses on financially-motivated international cybercrime as an ecosystem (not a single group). Each arc targets one organization with one incident, spanning 1–3 episodes. The story resolves not only technical issues, but also Ghosts: memes/emotions/places that cause incidents to repeat.",
  "gh:corePrinciples": [
    "Practical cybersecurity: real terminology and repeatable practices (incident response, governance, auditing, recovery).",
    "Ghosts are social/memetic: emotions, norms, rules, and places that 'possess' people and organizations.",
    "The enemy is an ecosystem: brokers, affiliates, operators, laundering, and market manipulation."
  ],
  "gh:virtues": [
    {
      "@id": "gh:virtue/sloth",
      "schema:name": "Sloth (Efficiency)",
      "gh:meaning": "To make people able to be lazy safely: eliminate waste, remove forced suffering, design environments that do not require heroics."
    },
    {
      "@id": "gh:virtue/arrogance",
      "schema:name": "Arrogance (Rule-making)",
      "gh:meaning": "To let people live with dignity: rules must not use people; people rewrite rules. 'Perfection' is redesign, not stubbornness."
    },
    {
      "@id": "gh:virtue/short-tempered",
      "schema:name": "Short-tempered (Instant Action)",
      "gh:meaning": "To stop unnecessary endurance: act fast so people don't suffer. Planning is fast and humane, not KPI-only."
    }
  ],
  "gh:catchphrases": [
    {
      "gh:character": "character:Ren",
      "gh:virtue": "gh:virtue/sloth",
      "schema:text": "それは「怠惰」だ。",
      "gh:target": "Organizations that replace design/controls with emotion, forgiveness, and ambiguity (environmental negligence)."
    },
    {
      "gh:character": "character:Kaname",
      "gh:virtue": "gh:virtue/arrogance",
      "schema:text": "それは傲慢ですね。",
      "gh:target": "Rules that control people; prideful rigidity that harms living systems; procedures used to evade responsibility."
    },
    {
      "gh:character": "character:Takeru",
      "gh:virtue": "gh:virtue/short-tempered",
      "schema:text": "あんたら、短気だな。",
      "gh:target": "KPI-only planning; impatience disguised as efficiency that forces humans to endure and breaks the field."
    }
  ],
  "gh:companies": [
    {
      "@id": "org:daimon-construction",
      "@type": "gh:VictimOrganization",
      "schema:name": "大門建設 (Daimon Construction)",
      "gh:arcLabel": "A",
      "gh:surfaceImage": "真面目・家族的・現場主義（努力しているように見える）",
      "gh:essence": "怠惰（設計放棄）：情で片付け、責任と権限の境界が曖昧で、再発防止を先送りする。",
      "gh:companyGhosts": [
        "先代が壁に掛けた『額縁ルール』",
        "前例",
        "見て見ぬふり（善意の顔）"
      ],
      "gh:incidentType": "Ransomware + Insider / Operational shutdown",
      "gh:caseInspirationNote": "Inspired by real-world incidents in Japan (e.g., large logistics/EC disruptions), but treated as a fictional case."
    },
    {
      "@id": "org:jinpu-mobility",
      "@type": "gh:VictimOrganization",
      "schema:name": "迅風モビリティ (JINPU Mobility)",
      "gh:arcLabel": "B",
      "gh:surfaceImage": "データドリブン・KPI最強・効率的（スマートに見える）",
      "gh:essence": "短気（人を削る計画）：目先の数値が唯一の計画になり、心や場や情緒を含めた計画が欠落する。",
      "gh:companyGhosts": [
        "『今すぐ』",
        "『遅れ＝罪』",
        "数字が人を使う"
      ],
      "gh:incidentType": "OT/IoT disruption + cascading supply chain impact"
    },
    {
      "@id": "org:byakudan-financial",
      "@type": "gh:VictimOrganization",
      "schema:name": "白檀フィナンシャル (BYAKUDAN Financial)",
      "gh:arcLabel": "C",
      "gh:surfaceImage": "堅牢・低リスク・規程が強い（ちゃんとしているように見える）",
      "gh:essence": "傲慢（ルールの硬直）：意地を通して窮屈になり、例外を悪とすることで現場が死ぬ。ルールが人を使う。",
      "gh:companyGhosts": [
        "『規程は絶対』",
        "『例外＝悪』",
        "責任回避の稟議迷路"
      ],
      "gh:incidentType": "Cloud governance failure + fraud/money laundering vector"
    },
    {
      "@id": "org:askul-like",
      "@type": "gh:ReferenceOrganization",
      "schema:name": "アスクル級の大手EC/物流（着想元）",
      "gh:note": "A real-world incident is used as inspiration for the narrative mechanism: disruption can move markets. The story does not assert real attribution.",
      "gh:marketLink": "Attack → disruption → news/psychology → price movement → profit"
    }
  ],
