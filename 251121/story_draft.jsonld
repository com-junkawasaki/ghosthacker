  },
  "@id": "gh:episode/draft-251121",
  "@type": "gh:Episode",
  "dct:title": "Ghost Hacker: Pilot Draft (Updated)",
  "dct:temporal": "2026",
  "dct:description": "霊長類の進化、そして情報生命体Ghostへの変遷を描く導入エピソード",
  "gh:theme": [
    "Spirit Evolution",
    "Information Physics",
    "Landauer's Principle",
    "Business Succession",
    "Digital Divide"
  ],
  "gh:characters": [
    {
      "@id": "character:Ren",
      "@type": "gh:Protagonist",
      "schema:name": "Ren"
    },
    {
      "@id": "character:Nei",
      "@type": "gh:Assistant",
      "schema:name": "Nei",
      "schema:description": "Renが開発した自律人型AI。見た目は16歳の少女と変わらない。"
    },
    {
      "@id": "character:Shota",
      "@type": "gh:Client",
      "schema:name": "Shota Daimon",
      "schema:description": "大門建設の社長の息子。26歳。会社の改革を志すが、古参社員との壁に悩む。",
      "gh:role": "Client / Successor"
    },
    {
      "@id": "character:Yasumoto",
      "@type": "gh:Antagonist",
      "schema:name": "Kenji Yasumoto",
      "gh:role": "Possessed Victim / General Affairs Manager",
      "gh:ghostType": "Obsolescence & Jealousy"
    },
    {
      "@id": "character:President",
      "@type": "gh:SupportingRole",
      "schema:name": "Goro Daimon",
      "gh:role": "President / Spiritual Pillar"
    },
    {
      "@id": "character:Matsuda",
      "@type": "gh:SupportingRole",
      "schema:name": "Yoshiko Matsuda",
      "gh:role": "Accounting Manager"
    },
    {
      "@id": "character:Sato",
      "@type": "gh:SupportingRole",
      "schema:name": "Kenta Sato",
      "gh:role": "IT Support (unofficial)"
    }
  ],
  "gh:scenes": [
    {
      "@id": "scene:01_Introduction",
      "schema:name": "History of Spirit",
      "gh:content": "猿から人、霊への進化。シャーマニズムから現代の情報社会（量子、核融合）への変遷。"
    },
    {
      "@id": "scene:02_DailyLife",
      "schema:name": "Ren's Room",
      "gh:content": "怠惰なRenと、仕事を急かすNeiの掛け合い。金欠状態の提示。"
    },
    {
      "@id": "scene:03_Consultation",
      "schema:name": "Shota's Request",
      "gh:participants": ["character:Ren", "character:Nei", "character:Shota"],
      "gh:content": "翔太がRenの元を訪れる。父には内緒で、会社の危機（ランサムウェア感染疑義）を救ってほしいと依頼。"
    },
    {
      "@id": "scene:04_Investigation",
      "schema:name": "Daimon Construction",
      "gh:participants": ["character:Ren", "character:Shota", "character:Yasumoto", "character:Matsuda", "character:Sato"],
      "gh:content": "蒲田のオフィス。パニック状態の経理（松田）と挙動不審な安本。Renは安本に取り憑いたGhostを見抜く。"
    },
    {
      "@id": "scene:05_Confrontation",
      "schema:name": "Exposing the Ghost",
      "gh:content": "Renが安本の犯行（自作自演・横領）を暴く。逆上した安本のGhost（嫉妬と恐怖）が実体化し、オフィスを破壊し始める。"
    },
    {
      "@id": "scene:06_Combat",
      "schema:name": "Physicalizing and Deletion",
      "gh:action": [
        "Ren activates SIP Device",
        "Ghost materializes completely",
        "Shota protects Matsuda",
        "Ren uses Axe to delete the Ghost"
      ]
    },
    {
      "@id": "scene:07_Resolution",
      "schema:name": "Succession",
      "gh:participants": ["character:Ren", "character:Shota", "character:President", "character:Yasumoto"],
      "gh:content": "事件解決。戻ってきた社長に対し、翔太は安本を庇いつつも、自分が会社を変えていく決意を固める。"
    }
  ]
}
