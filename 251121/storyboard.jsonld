{
  "@context": {
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "schema": "http://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "character": "gh:character/",
    "arc": "gh:arc/",
    "panel": "gh:panelIndex",
    "purpose": "gh:narrativePurpose",
    "shot": "gh:shotType",
    "prompt": "gh:runwayPrompt"
  },
  "@id": "gh:storyboard/master-season1",
  "@type": ["gh:MasterStoryboard", "prov:Entity"],
  "dct:title": "Ghost Hacker Season 1: Master Storyboard (Monochrome Manga Edition)",
  "dct:description": "Unified narrative framework and visual storyboard for Season 1. Includes full arc structures, episode beats, and Runway-optimized prompts in Professional Monochrome Manga style.",
  "gh:globalStyle": "Professional monochrome manga art, high-contrast black and white, crisp line art, heavy screentone shading, halftone dot texture, modern seinen manga aesthetic, sharp focus, manga scanlation style.",
  "gh:mangaPrinciples": {
    "gh:layoutLogic": "Impression (1-3 panels for impact) vs. Rhythm (4-8 panels for development/dialogue)",
    "gh:runwayConstraints": "Maximum 3 entities per prompt, cinematic camera/lighting terms, no dialogue text."
  },
  "gh:narrativeFramework": {
    "gh:arcs": [
      {
        "@id": "arc:A",
        "schema:name": "Arc A: Sloth - environmental negligence",
        "gh:episodes": [1, 2, 3],
        "gh:coreGhost": "善意の呪い (Curse of Goodwill)",
        "gh:finalLine": "それは「怠惰」だ。"
      },
      {
        "@id": "arc:B",
        "schema:name": "Arc B: Short-tempered - Never-Ending Clock",
        "gh:episodes": [4, 5, 6],
        "gh:coreGhost": "終わらぬ時計 (Never-Ending Clock)",
        "gh:finalLine": "あんたら、短気だな。"
      },
      {
        "@id": "arc:C",
        "schema:name": "Arc C: Arrogance - rules using people",
        "gh:episodes": [7, 8, 9],
        "gh:coreGhost": "例外狩り (Exception Hunter)",
        "gh:finalLine": "それは傲慢ですね。"
      },
      {
        "@id": "arc:D",
        "schema:name": "Arc D: Ecosystem - market of negligence",
        "gh:episodes": [10, 11, 12],
        "gh:coreGhost": "The Ecosystem itself",
        "gh:finalLine": "Ghost is not a person. It's the market of negligence."
      }
    ]
  },
  "gh:episodes": [
    {
      "gh:episode": 1,
      "dct:title": "牙を剥く内部の影",
      "gh:pages": [
        {
          "gh:pageNumber": 1,
          "gh:panels": [
            { "panel": 1, "shot": "Wide Angle", "prompt": "Wide Angle, Professional monochrome manga art. A historical evolution chart from primitive man to modern human, heavy ink strokes, high contrast. Dramatic shadows." },
            { "panel": 2, "shot": "Medium Shot", "prompt": "Medium Shot, Professional monochrome manga art. Silhouette of a giant ancient Buddha statue and totem poles, halftone texture, glowing behind a modern data server rack. Sharp line art." },
            { "panel": 3, "shot": "Bird's Eye View", "prompt": "Bird's Eye View, Professional monochrome manga art. Tokyo city 2026 at night, rivers of neon data streams between skyscrapers, dense screentone for sky." }
          ]
        },
        {
          "gh:pageNumber": 2,
          "gh:panels": [
            { "panel": 1, "shot": "Full Page Vertical", "prompt": "Full Page Vertical, Professional monochrome manga art. (Ren: 17-year-old male, messy black hair) and (Nei: android, blonde hair) floating in a vortex of digital grids and collapsing buildings. High-contrast ink drawing, heavy screentone." }
          ]
        },
        {
          "gh:pageNumber": 4,
          "gh:panels": [
            { "panel": 1, "shot": "Medium Shot", "prompt": "Medium Shot, Professional monochrome manga art. (Ren: 17-year-old male, dark hoodie) slouching deeply in his Okamura Cruise and Atlas ergonomic workstation, picking his ear. Rim lighting, crisp line art." },
            { "panel": 2, "shot": "Close-up", "prompt": "Close-up, Professional monochrome manga art. (Nei: android, blonde hair) looking exasperated, holding a tablet. Detailed expressive eyes, dense screentone." },
            { "panel": 3, "shot": "Two Shot", "prompt": "Two Shot, Medium Shot, Professional monochrome manga art. Ren and Nei. Nei pointing at a tablet screen with a 'LOW FUNDS' icon. Cluttered tech-office background with USM Haller furniture and server racks." },
            { "panel": 4, "shot": "Extreme Close-up", "prompt": "Extreme Close-up, Professional monochrome manga art. Ren's sharp half-lidded eye suddenly wide and alert. High contrast, intense ink strokes." }
          ]
        }
      ]
    },
    {
      "gh:episode": 2,
      "dct:title": "許しの毒",
      "gh:scenes": [
        { "gh:scene": "Morning After", "prompt": "Wide Shot, Professional monochrome manga art. Quiet office, (Shouta: 26-year-old male) looking at (Yasumoto: 52-year-old male) with mixed feelings. Soft morning light through blinds, delicate line work." },
        { "gh:scene": "The Crash", "prompt": "Close-up, Professional monochrome manga art. Computer screens turning black with large white 'CRITICAL ERROR' text. (Shouta: 26-year-old male) slamming fist on desk. Dramatic shadows, impact lines." },
        { "gh:scene": "Ren's Return", "prompt": "Low Angle, Medium Shot, Professional monochrome manga art. (Ren: 17-year-old male) entering the office, looking tired. Sharp half-lidded eyes, voluminous black hair. Intense presence." },
        { "gh:scene": "SBOM Analysis", "prompt": "Wide Shot, Professional monochrome manga art. (Nei: android, blonde hair) projecting a complex 3D holographic map of a software supply chain. Glowing blue lines against dark background, intricate data textures." },
        { "gh:scene": "The Confrontation", "prompt": "Two Shot, Medium Shot, Professional monochrome manga art. (Ren: 17-year-old male) handing a strict security policy document to (Shouta: 26-year-old male). High contrast, heavy screentone on suits." },
        { "gh:scene": "Vendor Link", "prompt": "Medium Shot, Professional monochrome manga art. A single red light blinking on a dark server in a mysterious vendor's room. Ominous atmosphere, deep ink shadows." }
      ]
    },
    {
      "gh:episode": 3,
      "dct:title": "善意の呪い",
      "gh:scenes": [
        { "gh:scene": "The Masked Ghost", "prompt": "Surreal Shot, Professional monochrome manga art. A giant smiling traditional mask floating in the office, made of 'goodwill' characters. Halftone fog, dramatic contrast." },
        { "gh:scene": "Trio Gathering", "prompt": "Two Shot, Professional monochrome manga art. (Ren: 17-year-old male) and (Shouta: 26-year-old male) standing before (President: 62-year-old male). Breaking family myths, intense composition." },
        { "gh:scene": "Final Battle", "prompt": "Action Shot, Professional monochrome manga art. Ren striking the mask ghost with a digital axe. Mask shattering like ceramic, sharp shards, high-speed line effects." }
      ]
    },
    {
      "gh:episode": 4,
      "dct:title": "終わらぬ時計",
      "gh:scenes": [
        { "gh:scene": "Logistics Chaos", "prompt": "Wide Shot, Professional monochrome manga art. Massive Japanese warehouse (Jinpu Mobility) at 4 AM. Trucks stuck in rows, (Makoto Baba: 54-year-old manager) stressed. Gritty industrial textures, heavy ink." },
        { "gh:scene": "Takeru's Arrival", "prompt": "Action Shot, Low Angle, Professional monochrome manga art. (Takeru: 19-year-old male, techwear, bleached hair highlights) jumping off a moving truck. Carrying a heavy crowbar. Dynamic pose, speed lines." },
        { "gh:scene": "Forced Reboot", "prompt": "Medium Shot, Professional monochrome manga art. (Makoto Baba: 54-year-old male) reaching for a master switch. (Takeru: 19-year-old male) blocking him with a crowbar. Sparks of friction, high contrast." },
        { "gh:scene": "The Clock Ghost", "prompt": "Surreal Shot, Wide Angle, Professional monochrome manga art. A mechanical nightmare clock with bladed needles looming over warehouse conveyor belts. Halftone dot texture for the ghostly aura." },
        { "gh:scene": "Dark Bait Discovery", "prompt": "Close-up, Professional monochrome manga art. (Tsubasa: 23-year-old driver) holding a glowing malicious USB device. (Takeru: 19-year-old male) grabbing his wrist. Intense eye contact, sharp line art." },
        { "gh:scene": "The Challenge", "prompt": "Medium Shot, Professional monochrome manga art. (Takeru: 19-year-old male) looking at (Ren: 17-year-old male) via a video call on a rugged handheld. Rivalry atmosphere, dramatic lighting." }
      ]
    },
    {
      "gh:episode": 5,
      "dct:title": "Doneがない地獄",
      "gh:scenes": [
        { "gh:scene": "Infinite Loop", "prompt": "Surreal Shot, Professional monochrome manga art. Warehouse workers moving in mechanical, exhausted loops. Glitch effects, repetitive patterns, heavy ink shading." },
        { "gh:scene": "Technical Fight", "prompt": "Action Shot, Professional monochrome manga art. (Takeru: 19-year-old male) using a digital hammer to smash data packets. Neon-style effects in black and white, dynamic shadows." }
      ]
    },
    {
      "gh:episode": 6,
      "dct:title": "終端刻印",
      "gh:scenes": [
        { "gh:scene": "Hammer Strike", "prompt": "Action Shot, Professional monochrome manga art. (Takeru: 19-year-old male) delivering a massive overhead strike on the Clock Ghost. Explosion of gears and light, intense impact lines." }
      ]
    },
    {
      "gh:episode": 7,
      "dct:title": "空の要塞の崩壊",
      "gh:scenes": [
        { "gh:scene": "Luxury Lobby", "prompt": "Wide Shot, Professional monochrome manga art. Byakudan Financial's marble lobby. (Kaname: 18-year-old male, white suit) walking elegantly. Cold, sterile architecture, high contrast black and white." },
        { "gh:scene": "Governance Audit", "prompt": "Two Shot, Close-up, Professional monochrome manga art. (Reika Kujoin: 45-year-old woman) glaring at (Toru Sasaki: 34-year-old male). Intense psychological pressure shown through heavy shadows under eyes." },
        { "gh:scene": "Kaname's Wrench", "prompt": "Medium Shot, Professional monochrome manga art. (Kaname: 18-year-old male) holding a chrome torque wrench. Detailed metallic reflections, crisp outlines, arrogant expression." },
        { "gh:scene": "Knight of Rules", "prompt": "Surreal Shot, Professional monochrome manga art. A ghost knight in armor made of paper regulations in a sterile server room. Intricate paper textures, dense screentone." },
        { "gh:scene": "The Leak", "prompt": "Close-up, Professional monochrome manga art. Data leaking as liquid from a marble wall crack. (Kaname: 18-year-old male) watching with a cold smile. Sharp focus, detailed line work." },
        { "gh:scene": "Arrogance Call", "prompt": "Medium Shot, Professional monochrome manga art. (Kaname: 18-year-old male) calling (Ren: 17-year-old male). Arrogant stance, luxury office background, dramatic rim lighting." }
      ]
    },
    {
      "gh:episode": 8,
      "dct:title": "消えた資産の足跡",
      "gh:scenes": [
        { "gh:scene": "Blockchain Void", "prompt": "Sci-fi Shot, Professional monochrome manga art. (Kaname: 18-year-old male) walking through a dark space of floating digital cubes. Intricate line art, glowing data structures." }
      ]
    },
    {
      "gh:episode": 9,
      "dct:title": "それは傲慢ですね",
      "gh:scenes": [
        { "gh:scene": "Breaking the Spear", "prompt": "Action Shot, Professional monochrome manga art. (Kaname: 18-year-old male) catching a paper spear with a gloved hand. 'It's arrogant,' cold smile, shattering effect." }
      ]
    },
    {
      "gh:episode": 10,
      "dct:title": "群れのGhost",
      "gh:scenes": [
        { "gh:scene": "Rooftop Meeting", "prompt": "Wide Shot, Professional monochrome manga art. Ren, Takeru, and Kaname on a Shinjuku rooftop. Rain, neon reflections in black ink, cinematic composition." },
        { "gh:scene": "Global Panic", "prompt": "Montage, Professional monochrome manga art. News reports on multiple screens showing SEIGI_HERO logo. Social unrest, glitch effects, halftone dot textures." },
        { "gh:scene": "HERO's Stream", "prompt": "Medium Shot, Professional monochrome manga art. (HERO: 30-year-old male) shouting into a mic. Flashy tactical jacket, tacky luxury room. Aggressive energy, heavy ink shading." },
        { "gh:scene": "Trace the Recruitment", "prompt": "Wide Shot, Professional monochrome manga art. (Nei: android, blonde hair) analyzing digital recruitment connections forming a web. Fine line art, complex network visualization." },
        { "gh:scene": "The Market Ghost", "prompt": "Surreal Shot, Professional monochrome manga art. A giant ghost made of ticker tapes and faces swirling around Tokyo Tower. Intense screentone contrast, epic scale." },
        { "gh:scene": "Police Coordination", "prompt": "Two Shot, Professional monochrome manga art. (Hatori Koichi: 45-year-old elite) and (Isa Reiji: 42-year-old detective) at NPA HQ. Tense atmosphere, detailed facial features." }
      ]
    },
    {
      "gh:episode": 11,
      "dct:title": "崩壊する信頼",
      "gh:scenes": [
        { "gh:scene": "International Coordination", "prompt": "Split Screen, Professional monochrome manga art. (Isa: detective), (Maya Rahman: liaison), and (Ethan Cole: FBI) in their offices. Coordination, serious expressions, sharp line art." }
      ]
    },
    {
      "gh:episode": 12,
      "dct:title": "逮捕",
      "gh:scenes": [
        { "gh:scene": "The Raid", "prompt": "Action Shot, Professional monochrome manga art. SWAT team bursting through glass. (HERO: 30-year-old male) in terror. Motion blur, debris, high contrast flashlights." },
        { "gh:scene": "Final Resolution", "prompt": "Close-up, Professional monochrome manga art. (Ren: 17-year-old male) pressing a key. Screen reflecting on his cold smile. Sharp focus on his eyes." },
        { "gh:scene": "Epilogue", "prompt": "Medium Shot, Professional monochrome manga art. (Ren: 17-year-old male) asleep in chair. (Nei: android) placing blanket. Morning light, peaceful atmosphere, fine lines." }
      ]
    }
  ]
