{
  "@context": {
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "schema": "http://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "character": "gh:character/",
    "arc": "gh:arc/",
    "panel": "gh:panelIndex",
    "purpose": "gh:narrativePurpose",
    "shot": "gh:shotType",
    "prompt": "gh:runwayPrompt",
    "properties": "gh:shotProperties"
  },
  "@id": "gh:storyboard/master-season1",
  "@type": ["gh:MasterStoryboard", "prov:Entity"],
  "dct:title": "Ghost Hacker Season 1: Master Storyboard (ARIA Cinematic Base)",
  "dct:description": "Unified narrative framework and visual storyboard for Season 1. Full page/panel breakdowns with ARIA-style realistic cinematic prompts. Emphasizes luminous atmosphere and extreme ocular detail.",
  "gh:globalStyle": "ARIA-style: Luminous atmosphere, soft diffused natural light, pristine air, highly detailed expressive eyes, intricate iris patterns, sharp catchlights. 8k photorealistic, shot on 35mm/85mm lenses.",
  "gh:mangaPrinciples": {
    "gh:layoutLogic": "Impression (1-3 panels) vs. Rhythm (4-8 panels)",
    "gh:runwayConstraints": "Maximum 3 entities per prompt, cinematic camera/lighting terms, no dialogue text, ARIA aesthetic."
  },
  "gh:narrativeFramework": {
    "gh:arcs": [
      { "@id": "arc:A", "schema:name": "Arc A: Sloth", "gh:episodes": [1, 2, 3] },
      { "@id": "arc:B", "schema:name": "Arc B: Short-tempered", "gh:episodes": [4, 5, 6] },
      { "@id": "arc:C", "schema:name": "Arc C: Arrogance", "gh:episodes": [7, 8, 9] },
      { "@id": "arc:D", "schema:name": "Arc D: Ecosystem", "gh:episodes": [10, 11, 12] }
    ]
  },
  "gh:episodes": [
    {
      "gh:episode": 1,
      "dct:title": "牙を剥く内部の影",
      "gh:pages": [
        {
          "gh:pageNumber": 4,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Wide Shot",
              "properties": {
                "gh:distance": "Wide Shot",
                "gh:angle": "Back View, Eye Level",
                "gh:atmosphere": "ARIA-style: Soft diffused morning light, luminous clean air",
                "gh:composition": "One-point perspective, centered subject",
                "gh:focus": "Deep focus"
              },
              "prompt": "Wide Shot, Back View, Eye Level. ARIA-style: Luminous atmosphere, soft diffused light from right window, clean air. (Ren:1.2) sitting at a minimalist white ergonomic desk, back to camera, facing dual monitors. One-point perspective, 35mm wide lens, 8k photorealistic, serene mood."
            },
            {
              "panel": 2,
              "shot": "Close-up",
              "properties": {
                "gh:distance": "Close-up",
                "gh:angle": "Frontal",
                "gh:atmosphere": "Soft bokeh, high-end portrait lighting",
                "gh:eyeDetail": "Intricate blue iris patterns, sharp catchlights, crystal clear eyes"
              },
              "prompt": "Close-up, Frontal. ARIA-style: (Nei:1.2) looking at camera with an exasperated expression. Intricate glowing blue iris patterns, sharp sparkling catchlights in crystalline eyes, extreme ocular detail. Soft diffused light, 85mm lens, f/1.2, creamy bokeh, 8k photorealistic."
            },
            {
              "panel": 3,
              "shot": "Medium Shot",
              "properties": {
                "gh:distance": "Medium Shot",
                "gh:angle": "Side View",
                "gh:atmosphere": "Clean luminous air, natural office light",
                "gh:composition": "Two shot"
              },
              "prompt": "Medium Shot, Side View. ARIA-style: Ren and Nei in a tech-filled office with USM Haller furniture. Nei pointing at a tablet screen. Soft diffused lighting, clean air, 35mm lens, 8k photorealistic."
            },
            {
              "panel": 4,
              "shot": "Extreme Close-up",
              "properties": {
                "gh:distance": "Extreme Close-up",
                "gh:angle": "Ocular focus",
                "gh:eyeDetail": "Extreme iris detail, deep silver-grey crystalline texture"
              },
              "prompt": "Extreme Close-up, Ocular Focus. ARIA-style: Ren's eye suddenly wide and alert. Extreme iris detail, silver-grey crystalline texture, sharp sparkling catchlights, visible eye-lashes. Dramatic soft lighting, 100mm macro lens, 8k photorealistic."
            }
          ]
        },
        {
          "gh:pageNumber": 1,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Wide Angle",
              "properties": { "gh:atmosphere": "ARIA-style: Luminous mist, ethereal light" },
              "prompt": "Wide Angle. ARIA-style: Luminous mist, soft diffused light. A detailed evolution chart from primitive man to modern human, superimposed on a pristine primeval forest. 8k, aerial perspective."
            }
          ]
        }
      ]
    }
  ]
}
