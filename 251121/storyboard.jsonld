                "gh:aperture": "f/1.2",
                "gh:focus": "shallow depth of field, creamy bokeh",
                "gh:angle": "frontal",
                "gh:eyeDetail": "highly detailed expressive eyes, intricate iris patterns, sharp sparkling catchlights, crystalline ocular texture"
              },
              "gh:runwayPrompt": "Close-up, frontal, ARIA-style. Yuto's anxious eyes and trembling hand reaching toward a vibrating phone on his desk in soft morning light. shot on 85mm prime, f/1.2, cinematic live-action.",
              "visual": "朝。Yutoの指が震えながらスマホに伸びる。",
              "environment": "env:home-desk",
              "characters": ["character:Yuto"],
              "dialogue": [
                { "speaker": "Yuto", "text": "……やめて。" }
              ],
