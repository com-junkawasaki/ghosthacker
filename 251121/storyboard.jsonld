  "dct:title": "Ghost Hacker Season 1: Master Storyboard (Monochrome Manga Edition)",
  "dct:description": "Unified narrative framework and visual storyboard for Season 1. Includes full arc structures, episode beats, and Runway-optimized prompts in Professional Monochrome Manga style.",
  "gh:globalStyle": "Professional monochrome manga art, high-contrast black and white, crisp line art, heavy screentone shading, halftone dot texture, modern seinen manga aesthetic, sharp focus, manga scanlation style.",
  "gh:mangaPrinciples": {
    "gh:layoutLogic": "Impression (1-3 panels for impact) vs. Rhythm (4-8 panels for development/dialogue)",
    "gh:runwayConstraints": "Maximum 3 entities per prompt, cinematic camera/lighting terms, no dialogue text."
  },
  "gh:narrativeFramework": {
    "gh:arcs": [
      {
        "@id": "arc:A",
        "schema:name": "Arc A: Sloth - environmental negligence",
        "gh:episodes": [1, 2, 3],
        "gh:coreGhost": "善意の呪い (Curse of Goodwill)",
        "gh:finalLine": "それは「怠惰」だ。"
      },
      {
        "@id": "arc:B",
        "schema:name": "Arc B: Short-tempered - Never-Ending Clock",
        "gh:episodes": [4, 5, 6],
        "gh:coreGhost": "終わらぬ時計 (Never-Ending Clock)",
        "gh:finalLine": "あんたら、短気だな。"
      },
      {
        "@id": "arc:C",
        "schema:name": "Arc C: Arrogance - rules using people",
        "gh:episodes": [7, 8, 9],
        "gh:coreGhost": "例外狩り (Exception Hunter)",
        "gh:finalLine": "それは傲慢ですね。"
      },
      {
        "@id": "arc:D",
        "schema:name": "Arc D: Ecosystem - market of negligence",
        "gh:episodes": [10, 11, 12],
        "gh:coreGhost": "The Ecosystem itself",
        "gh:finalLine": "Ghost is not a person. It's the market of negligence."
      }
    ]
  },
