  "dct:description": "Full Season 1 storyboard: episodes are ordered by gh:episodeIndex and identified by date-based gh:episodeId (stable). Realistic live-action Runway base prompts with ARIA aesthetic (clean luminous air, soft light) and structured shot properties.",
  "dct:title": "Ghost Hacker Season 1: Master Storyboard (ARIA Cinematic Base - FULL)",
  "gh:characters": [
    {
      "@id": "character:Ren",
      "dct:description": "17歳。スマートだが少し気怠げ。論理と手順で状況を切り分け、AXEでGhostの“繋がり”を断つ。",
      "gh:voice": {
        "gh:favorites": [
          "あー",
          "そうだな",
          "とりあえず",
          "先に",
          "スクショ",
          "ログイン",
          "パス",
          "二段階",
          "パスキー",
          "切る",
          "コマンド"
        ],
        "gh:sampleLines": [
          "あー。そうだな、やるか。",
          "先にスクショ撮る。そのあとで消す。",
          "まずパス変える。二段階はそのあと。",
          "めんどいけど…順番だけは守る。"
        ],
        "gh:sentenceTraits": [
          "conversational",
          "short-to-medium sentences",
          "ellipses and fillers (\"あー\", \"んー\")",
          "thinks fast when addressed",
          "no shouting"
        ],
        "gh:style": "smart, lethargic teen; speaks casually but precise when needed",
        "gh:taboos": [
          "熱血長台詞",
          "過剰な敬語",
          "名詞だけの命令を連発しすぎる"
        ]
      },
      "schema:name": "Ren"
    },
    {
      "@id": "character:Nei",
      "dct:description": "17歳。端的で冷静。結論を先に出し、証拠化と手順化でチームを前に進める。",
      "gh:voice": {
        "gh:favorites": [
          "まず",
          "落ち着いて",
          "順番",
          "スクショ",
          "リンク",
          "ログイン",
          "二段階",
          "ブロック",
          "通報",
          "別アカ"
        ],
        "gh:sampleLines": [
          "まず落ち着こ。順番でいける。",
          "スクショ撮って。消される前に。",
          "リンクは踏まない。今はそれだけで勝ち。",
          "別アカで一言だけ出す。『踏まないで』って。",
          "二段階、入れよ。できるとこから。"
        ],
        "gh:sentenceTraits": [
          "conclusion-first",
          "short",
          "calm",
          "practical",
          "no drama"
        ],
        "gh:style": "cool, plain, teen; concise and practical",
        "gh:taboos": [
          "医療っぽい言い回し",
          "法律/監査っぽい単語連発",
          "長い比喩",
          "回りくどい前置き"
        ]
      },
      "schema:name": "Nei"
    },
    {
      "@id": "character:NeiPuni",
      "dct:description": "『NEIちゃんのアドバイス』用のメタUIマスコット。読者にだけ見える案内役。短く、やさしく、冷静に。",
      "gh:voice": {
        "gh:favorites": [
          "ここ！",
          "これだけ",
          "まず",
          "スクショ",
          "設定",
          "OK"
        ],
        "gh:sampleLines": [
          "NEIちゃんのアドバイス！",
          "まずこれ。いったん止めよ。",
          "次。スクショ。",
          "設定いこ。画面みて。",
          "OK。次いこ。"
        ],
        "gh:sentenceTraits": [
          "very short",
          "friendly",
          "simple words",
          "one-action-per-line"
        ],
        "gh:style": "meta UI mascot; super concise, cute but not sugary",
        "gh:taboos": [
          "説教",
          "専門用語の連打",
          "長文"
        ]
      },
      "schema:name": "Nei (Puni)"
    },
    {
      "@id": "character:Takeru",
      "dct:description": "17歳。短気で即断即決。現場の“遅さ”が許せず、計測と切り分けで『終端（Done）』を作る。OSCP/GXPN。",
      "schema:name": "Takeru"
    },
    {
      "@id": "character:Kaname",
      "dct:description": "17歳。学生起業のエリート。『最低ライン遵守』を免罪符にするのを嫌い、国内規制だけでなく国際的な統制要求まで含めて“絶対ルール”として設計し直す。CISA/情報処理安全確保支援士。",
      "gh:voice": {
        "gh:favorites": [
          "監査",
          "統制",
          "証跡",
          "例外なし",
          "最低ライン",
          "絶対ルール"
        ],
        "gh:sampleLines": [
          "監査不合格。",
          "それは傲慢ですね。",
          "規程は免罪符じゃない。"
        ],
        "gh:sentenceTraits": [
          "short",
          "verdict-first",
          "no hedging"
        ],
        "gh:style": "cold, exacting, rule-driven, confident",
        "gh:taboos": [
          "情に流される慰め",
          "曖昧な約束"
        ]
      },
      "schema:name": "Kaname"
    },
    {
      "@id": "character:Shouta",
      "dct:description": "大門建設の若手（スーツ姿）。依頼者。焦燥しているが目は鋭い。",
      "schema:name": "Daimon Shouta"
    },
    {
      "@id": "character:Matsuda",
      "dct:description": "経理の松田（おばちゃん）。給与計算に追われ叫ぶ。",
      "schema:name": "Matsuda"
    },
    {
      "@id": "character:Sato",
      "dct:description": "若手社員の佐藤。PC裏でケーブルをいじり混乱している。",
      "schema:name": "Sato"
    },
    {
      "@id": "character:Yasumoto",
      "dct:description": "総務部長の安本。汗だくで挙動不審。嫉妬と恐怖のGhostを抱える。",
      "schema:name": "Yasumoto"
    },
    {
      "@id": "character:President",
      "dct:description": "大門建設 社長（大門五郎）。作業着姿で戻ってくる。",
      "schema:name": "Daimon Goro"
    },
    {
      "@id": "character:PreviousPresident",
      "dct:description": "大門建設の先代社長（故人）。『家族』『情』『現場第一』で回してきた時代の象徴。",
      "schema:name": "Daimon Ichiro"
    },
    {
      "@id": "character:GhostYasumoto",
      "dct:description": "安本から分離したGhost。古い書類とケーブルの塊の怪物。",
      "schema:name": "Ghost (Yasumoto)"
    },
    {
      "@id": "character:GhostPresident",
      "dct:description": "社長の“善意”から生まれるGhost。『許し』『絆』『家族』の笑顔の紙仮面が、口と責任を静かに塞ぐ。",
      "schema:name": "Ghost (President)"
    },
    {
      "@id": "character:GhostPreviousPresident",
      "dct:description": "先代の“文化”から生まれるGhost。古い社訓フレームと社判（ハンコ）を核に、善意の言葉で権限の穴を増殖させる。",
      "schema:name": "Ghost (Previous President)"
    },
    {
      "@id": "character:GhostClock",
      "dct:description": "『始業の鐘』だけが鳴り続け、針が刃になるGhost。締切と焦りが“終端（Done）”を奪い、現場の首元に迫る。",
      "schema:name": "Ghost (Clock)"
    },
    {
