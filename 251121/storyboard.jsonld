  "@id": "gh:storyboard/master-season1",
  "@type": [
    "gh:MasterStoryboard",
    "prov:Entity"
  ],
  "dct:title": "Ghost Hacker Season 1: Master Storyboard (ARIA Cinematic Base - FULL)",
  "dct:description": "Full Season 1 storyboard: episodes are ordered by gh:episodeIndex and identified by date-based gh:episodeId (stable). Realistic live-action Runway base prompts with ARIA aesthetic (clean luminous air, soft light) and structured shot properties.",
  "gh:globalStyle": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air. Emphasize detailed expressive eyes with intricate iris patterns and sharp catchlights.",
  "gh:runwayConstraints": "Max 3 key entities per prompt (2 characters + 1 prop/ghost), no dialogue text, stable shot schema via gh:shotProperties.",
  "prov:wasDerivedFrom": [
    { "@id": "gh:presentation/ghosthacker-a3" },
    { "@id": "gh:board/ghosthacker" },
    { "@id": "gh:data/incident-master-plan-final" }
  ],
  "gh:meta": {
    "gh:oneLiner": "AI時代の情報攻撃を“物理現象”として描く、ハッキング×心理×組織の少年漫画。",
    "gh:hook": "情報が『質量』を持ったとき、嘘は『幽霊』になる。",
    "gh:audience": "週刊少年ジャンプ編集部向け",
    "gh:tags": [
      "Cyber",
      "Thriller",
      "Shonen",
      "AI",
      "Corporate",
      "Ghost",
      "CISSP",
      "CISA",
      "情報安全確保支援士"
    ]
  },
  "gh:environments": [
    { "@id": "env:evolution-nature", "dct:title": "Evolution nature backdrop", "dct:description": "猿からヒトへの進化図が置かれる荒々しい自然背景。" },
    { "@id": "env:historical-montage", "dct:title": "Historical montage", "dct:description": "洞窟の火と壁画、巨大仏・トーテム・儀式が薄く重なる歴史モンタージュ。" },
    { "@id": "env:tokyo-2026-aerial", "dct:title": "Tokyo 2026 cityscape", "dct:description": "2026年の東京。高層ビル、電子データ、サーバーファーム、ドローン物流。" },
    { "@id": "env:cyberspace-title", "dct:title": "Cyberspace title page", "dct:description": "デジタルグリッドと都市片が融合・崩壊・再構築するサイバー空間。縦長タイトルロゴ。" },
    { "@id": "env:ren-office", "dct:title": "Ren office", "dct:description": "コンクリート壁と木床の清潔なオフィス（Ren/Neiの拠点）。" },
    { "@id": "env:kamata-daimon-office", "dct:title": "Daimon Construction office (Kamata)", "dct:description": "蒲田の大門建設オフィス。古びたビル内、電話が鳴り止まない修羅場。" },
    { "@id": "env:intertitle-black", "dct:title": "Intertitle (black)", "dct:description": "黒背景のタイトルカード（白文字）。" },
    { "@id": "env:kamata-street-evening", "dct:title": "Kamata street (evening)", "dct:description": "夕暮れの蒲田の雑踏。事件後の余韻。" },
    { "@id": "env:cschool-classroom", "dct:title": "C-school classroom", "dct:description": "通信制高校C高校の教室。個別ブース、静かな授業。" },
    { "@id": "env:cschool-hallway", "dct:title": "C-school hallway", "dct:description": "C高校の廊下。人の気配はあるが静か。" },
    { "@id": "env:cschool-consult", "dct:title": "C-school consultation room", "dct:description": "C高校の相談スペース。少人数で話せる静かな場所。" },
    { "@id": "env:home-desk", "dct:title": "Home desk", "dct:description": "自室の机。スマホ通知、ノート、PC。" },
    { "@id": "env:smartphone-screen", "dct:title": "Smartphone screen", "dct:description": "スマホの画面（通知・設定・チャット等のインサート）。" },
    { "@id": "env:news-hacker-board", "dct:title": "News Hacker board", "dct:description": "掲示板 News Hacker。HNで助言が飛び交う。" },
    { "@id": "env:quiet-room", "dct:title": "Quiet room", "dct:description": "落ち着いて説明できる小部屋（支援・相談の場）。" },
    { "@id": "env:station-night-street", "dct:title": "Station night street", "dct:description": "駅近の夜道。ネオン、緊張、スマホの光。" },
    { "@id": "env:cschool-exterior-dusk", "dct:title": "C-school exterior (dusk)", "dct:description": "C高校の外観。夕方の柔らかい光、帰る生徒。" },
    { "@id": "env:elite-school-campus", "dct:title": "Elite school campus", "dct:description": "都内有名校のキャンパス。洗練された建築、起業家気質の空気。" },
    { "@id": "env:meeting-neutral", "dct:title": "Neutral meeting place", "dct:description": "立場の違う人物が落ち着いて話す中立的な場所。" },
    { "@id": "env:street-day", "dct:title": "Street (daytime)", "dct:description": "昼の街。息がしやすい光、再出発の気配。" },
    { "@id": "env:logistics-warehouse", "dct:title": "Logistics warehouse", "dct:description": "大規模物流倉庫。トラック、コンベヤ、管制室モニタ、夜明けの靄。『急げ』の圧が満ちる現場。" },
    { "@id": "env:cschool-virtual-campus", "dct:title": "C-school virtual campus", "dct:description": "C高校のバーチャル空間（仮想校舎）。アバター、浮遊UI、授業の出欠や課題が見える。" },
    { "@id": "env:sns-timeline", "dct:title": "Smartphone SNS timeline", "dct:description": "スマホのSNSタイムライン（投稿・リプ・いいね・リポストが流れる）。誹謗中傷や拡散の温度が伝わる。" }
  ],
  "gh:characters": [
    {
      "@id": "character:Ren",
      "schema:name": "Ren",
      "dct:description": "17歳。スマートだが少し気怠げ。論理と手順で状況を切り分け、AXEでGhostの“繋がり”を断つ。",
      "gh:voice": {
        "gh:style": "smart, slightly lethargic, low-energy confidence",
        "gh:sentenceTraits": ["short clauses", "ellipses", "no shouting"],
        "gh:favorites": ["入口", "鍵", "鎖", "切る", "見える化", "熱"],
        "gh:taboos": ["熱血長台詞", "過剰な敬語"],
        "gh:sampleLines": [
          "…まず入口。",
          "消せない。だから、切る。",
          "怖さは手順に変えられる。"
        ]
      }
    },
    {
      "@id": "character:Nei",
      "schema:name": "Nei",
      "dct:description": "17歳。端的で冷静。結論を先に出し、証拠化と手順化でチームを前に進める。",
      "gh:voice": {
        "gh:style": "concise, calm, clinical",
        "gh:sentenceTraits": ["conclusion-first", "imperatives", "minimal emotion words"],
        "gh:favorites": ["結論", "証拠", "止血", "手順", "分離"],
        "gh:taboos": ["長い比喩", "回りくどい前置き"],
        "gh:sampleLines": [
          "結論。証拠。",
          "今は止血。あとで整理。",
          "慌てない。順番。"
        ]
      }
    },
    { "@id": "character:Takeru", "schema:name": "Takeru", "dct:description": "17歳。短気で即断即決。現場の“遅さ”が許せず、計測と切り分けで『終端（Done）』を作る。OSCP/GXPN。" },
    { "@id": "character:Shouta", "schema:name": "Daimon Shouta", "dct:description": "大門建設の若手（スーツ姿）。依頼者。焦燥しているが目は鋭い。" },
    { "@id": "character:Matsuda", "schema:name": "Matsuda", "dct:description": "経理の松田（おばちゃん）。給与計算に追われ叫ぶ。" },
    { "@id": "character:Sato", "schema:name": "Sato", "dct:description": "若手社員の佐藤。PC裏でケーブルをいじり混乱している。" },
    { "@id": "character:Yasumoto", "schema:name": "Yasumoto", "dct:description": "総務部長の安本。汗だくで挙動不審。嫉妬と恐怖のGhostを抱える。" },
    { "@id": "character:President", "schema:name": "Daimon Goro", "dct:description": "大門建設 社長（大門五郎）。作業着姿で戻ってくる。" },
    { "@id": "character:PreviousPresident", "schema:name": "Daimon Ichiro", "dct:description": "大門建設の先代社長（故人）。『家族』『情』『現場第一』で回してきた時代の象徴。" },
    { "@id": "character:GhostYasumoto", "schema:name": "Ghost (Yasumoto)", "dct:description": "安本から分離したGhost。古い書類とケーブルの塊の怪物。" },
    { "@id": "character:GhostPresident", "schema:name": "Ghost (President)", "dct:description": "社長の“善意”から生まれるGhost。『許し』『絆』『家族』の笑顔の紙仮面が、口と責任を静かに塞ぐ。" },
    { "@id": "character:GhostPreviousPresident", "schema:name": "Ghost (Previous President)", "dct:description": "先代の“文化”から生まれるGhost。古い社訓フレームと社判（ハンコ）を核に、善意の言葉で権限の穴を増殖させる。" },
    { "@id": "character:GhostClock", "schema:name": "Ghost (Clock)", "dct:description": "『始業の鐘』だけが鳴り続け、針が刃になるGhost。締切と焦りが“終端（Done）”を奪い、現場の首元に迫る。" },
    {
      "@id": "character:Yuto",
      "schema:name": "Sato Yuto",
      "schema:givenName": "Yuto",
      "schema:familyName": "Sato",
      "schema:alternateName": ["Yuto"],
      "dct:description": "C高校の友人。限定ブランドへの憧れからSNS上の格安販売に手を出し、迷惑連絡と乗っ取り被害に怯える。"
    },
    {
      "@id": "character:YutoMother",
      "schema:name": "Sato Keiko",
      "schema:givenName": "Keiko",
      "schema:familyName": "Sato",
      "schema:alternateName": ["Keiko", "Mom", "ママ"],
      "dct:description": "Yutoの母。家計と生活を回しつつ、異変に最初に気づく。"
    },
    {
      "@id": "character:YutoFather",
      "schema:name": "Sato Daichi",
      "schema:givenName": "Daichi",
      "schema:familyName": "Sato",
      "schema:alternateName": ["Daichi", "Dad", "パパ"],
      "dct:description": "Yutoの父。冷静だが、請求の現実を前に声が固くなる。"
    },
    {
      "@id": "character:Akira",
      "schema:name": "Kurokawa Akira",
      "schema:givenName": "Akira",
      "schema:familyName": "Kurokawa",
      "schema:alternateName": ["Akira", "Aki", "アキ"],
      "dct:description": "Yutoのクラスメイト。流行に敏感で“限定ドロップ”を自慢したがる。口は軽いが悪気は薄い。"
    },
    {
      "@id": "character:Saki",
      "schema:name": "Mizuno Saki",
      "schema:givenName": "Saki",
      "schema:familyName": "Mizuno",
      "schema:alternateName": ["Saki", "Saki-chan", "サキ"],
      "dct:description": "Yutoのクラスメイト。観察眼が鋭く、空気を読む。羨望と警戒のバランスが取れている。"
    },
    {
      "@id": "character:Ryo",
      "schema:name": "Tachibana Ryo",
      "schema:givenName": "Ryo",
      "schema:familyName": "Tachibana",
      "schema:alternateName": ["Ryo", "Ryo-chi", "リョウ"],
      "dct:description": "Yutoのクラスメイト。ノリで拡散しがち。被害が出ると怒りが先に出るタイプ。"
    },
    {
      "@id": "character:Mei",
      "schema:name": "Sakuraba Mei",
      "schema:givenName": "Mei",
      "schema:familyName": "Sakuraba",
      "schema:alternateName": ["Mei", "Mei-chan", "メイ"],
      "dct:description": "Yutoのクラスメイト。会話の中心にいるムードメーカー。友だち思いだが、SNSでの距離感が近い。"
    },
    {
      "@id": "character:Kota",
      "schema:name": "Hiramatsu Kota",
      "schema:givenName": "Kota",
      "schema:familyName": "Hiramatsu",
      "schema:alternateName": ["Kota", "Ko-ta", "コータ"],
      "dct:description": "Yutoのクラスメイト。ガジェット好きで“便利”優先。『大手なら安全』と信じやすい。"
    },
    {
      "@id": "character:Kenta",
      "schema:name": "Kenta",
      "schema:alternateName": ["Kento"],
      "dct:description": "C高校の生徒。誹謗中傷被害の相談者。高校生っぽい口語で揺れながらも、最後は手順で踏みとどまる。",
      "gh:voice": {
        "gh:style": "teen, anxious, reactive",
        "gh:sentenceTraits": ["slang", "hesitation", "short bursts"],
        "gh:favorites": ["マジ", "やばい", "無理", "なんで"],
        "gh:taboos": ["難解な専門用語を自分から使う"],
        "gh:sampleLines": [
          "え、マジ…？",
          "無理…でも、消しても増える…なんで？",
          "俺じゃないって言ってんのに…"
        ]
      }
    },
    { "@id": "character:Mina", "schema:name": "Mina", "dct:description": "闇バイトに巻き込まれた学生。口座/番号の売買で追い詰められる。" }
  ],
  "gh:episodes": [
    {
      "gh:episode": 1,
      "gh:episodeIndex": 1,
      "gh:episodeId": "episode:260123-cschool-privacy",
      "dct:title": "パスワードは覚えるな",
      "gh:presentationTagline": "Arc 0 | High School & Privacy",
      "gh:arc": "Arc 0",
      "gh:industry": "Student life (高校生)",
      "gh:mainCharacter": "character:Ren",
      "gh:supportingCharacters": ["character:Nei"],
      "gh:realCase": "Credential stuffing / personal data leak → spam calls & spam email",
      "gh:sinContrast": "Careless Reuse (Convenience) vs. Trust (Password Manager + Aliases)",
      "gh:nistFocus": ["PR.AA (Identity Management)", "PR.AC (Access Control)", "PR.DS (Data Security)"],
      "gh:incidentDescription": "C高校で二つの被害が連鎖する。Yutoは連絡先流出と使い回しで迷惑連絡に追い詰められ、Kentaは誹謗中傷の拡散に刺される。RenとNeiは「情報は消せない」という現実（ランダウアーの定理＝消去には熱が出る）を前提に、Ghost（情報霊）が具現化する“繋がり”を見える化し、AXEで鎖を断って沈静化させる。最後に残るのは、誰でも再現できる手順――読者の“入口”にも効く勝ち方だ。",
      "gh:pages": [
        {
          "gh:pageNumber": 1,
          "gh:panels": [
