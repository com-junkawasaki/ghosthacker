  "@id": "gh:storyboard/master-season1",
  "@type": [
    "gh:MasterStoryboard",
    "prov:Entity"
  ],
  "dct:title": "Ghost Hacker Season 1: Master Storyboard (ARIA Cinematic Base - FULL)",
  "dct:description": "Full Season 1 storyboard: episodes are ordered by gh:episodeIndex and identified by date-based gh:episodeId (stable). Realistic live-action Runway base prompts with ARIA aesthetic (clean luminous air, soft light) and structured shot properties.",
  "gh:globalStyle": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air. Emphasize detailed expressive eyes with intricate iris patterns and sharp catchlights.",
  "gh:runwayConstraints": "Max 3 key entities per prompt (2 characters + 1 prop/ghost), no dialogue text, stable shot schema via gh:shotProperties.",
  "prov:wasDerivedFrom": [
    { "@id": "gh:presentation/ghosthacker-a3" },
    { "@id": "gh:board/ghosthacker" },
    { "@id": "gh:data/incident-master-plan-final" }
  ],
  "gh:meta": {
    "gh:oneLiner": "AI時代の情報攻撃を“物理現象”として描く、ハッキング×心理×組織の少年漫画。",
    "gh:hook": "情報が『質量』を持ったとき、嘘は『幽霊』になる。",
    "gh:audience": "週刊少年ジャンプ編集部向け",
    "gh:tags": [
      "Cyber",
      "Thriller",
      "Shonen",
      "AI",
      "Corporate",
      "Ghost",
      "CISSP",
      "CISA",
      "情報安全確保支援士"
    ]
  },
  "gh:environments": [
    { "@id": "env:evolution-nature", "dct:title": "Evolution nature backdrop", "dct:description": "猿からヒトへの進化図が置かれる荒々しい自然背景。" },
    { "@id": "env:historical-montage", "dct:title": "Historical montage", "dct:description": "洞窟の火と壁画、巨大仏・トーテム・儀式が薄く重なる歴史モンタージュ。" },
    { "@id": "env:tokyo-2026-aerial", "dct:title": "Tokyo 2026 cityscape", "dct:description": "2026年の東京。高層ビル、電子データ、サーバーファーム、ドローン物流。" },
    { "@id": "env:cyberspace-title", "dct:title": "Cyberspace title page", "dct:description": "デジタルグリッドと都市片が融合・崩壊・再構築するサイバー空間。縦長タイトルロゴ。" },
    { "@id": "env:ren-office", "dct:title": "Ren office", "dct:description": "コンクリート壁と木床の清潔なオフィス（Ren/Neiの拠点）。" },
    { "@id": "env:kamata-daimon-office", "dct:title": "Daimon Construction office (Kamata)", "dct:description": "蒲田の大門建設オフィス。古びたビル内、電話が鳴り止まない修羅場。" },
    { "@id": "env:intertitle-black", "dct:title": "Intertitle (black)", "dct:description": "黒背景のタイトルカード（白文字）。" },
    { "@id": "env:kamata-street-evening", "dct:title": "Kamata street (evening)", "dct:description": "夕暮れの蒲田の雑踏。事件後の余韻。" },
    { "@id": "env:cschool-classroom", "dct:title": "C-school classroom", "dct:description": "通信制高校C高校の教室。個別ブース、静かな授業。" },
    { "@id": "env:cschool-hallway", "dct:title": "C-school hallway", "dct:description": "C高校の廊下。人の気配はあるが静か。" },
    { "@id": "env:cschool-consult", "dct:title": "C-school consultation room", "dct:description": "C高校の相談スペース。少人数で話せる静かな場所。" },
    { "@id": "env:home-desk", "dct:title": "Home desk", "dct:description": "自室の机。スマホ通知、ノート、PC。" },
    { "@id": "env:smartphone-screen", "dct:title": "Smartphone screen", "dct:description": "スマホの画面（通知・設定・チャット等のインサート）。" },
    { "@id": "env:news-hacker-board", "dct:title": "News Hacker board", "dct:description": "掲示板 News Hacker。HNで助言が飛び交う。" },
    { "@id": "env:quiet-room", "dct:title": "Quiet room", "dct:description": "落ち着いて説明できる小部屋（支援・相談の場）。" },
    { "@id": "env:station-night-street", "dct:title": "Station night street", "dct:description": "駅近の夜道。ネオン、緊張、スマホの光。" }
  ],
  "gh:characters": [
    { "@id": "character:Shouta", "schema:name": "Daimon Shouta", "dct:description": "大門建設の若手（スーツ姿）。依頼者。焦燥しているが目は鋭い。" },
    { "@id": "character:Matsuda", "schema:name": "Matsuda", "dct:description": "経理の松田（おばちゃん）。給与計算に追われ叫ぶ。" },
    { "@id": "character:Sato", "schema:name": "Sato", "dct:description": "若手社員の佐藤。PC裏でケーブルをいじり混乱している。" },
    { "@id": "character:Yasumoto", "schema:name": "Yasumoto", "dct:description": "総務部長の安本。汗だくで挙動不審。嫉妬と恐怖のGhostを抱える。" },
    { "@id": "character:President", "schema:name": "Daimon Goro", "dct:description": "大門建設 社長（大門五郎）。作業着姿で戻ってくる。" },
    { "@id": "character:GhostYasumoto", "schema:name": "Ghost (Yasumoto)", "dct:description": "安本から分離したGhost。古い書類とケーブルの塊の怪物。" },
    { "@id": "character:Yuto", "schema:name": "Yuto", "dct:description": "C高校の友人。漏えい由来の迷惑連絡に怯える。" },
    { "@id": "character:Kenta", "schema:name": "Kenta", "dct:description": "C高校の生徒。誹謗中傷被害の相談者。" },
    { "@id": "character:Mina", "schema:name": "Mina", "dct:description": "闇バイトに巻き込まれた学生。口座/番号の売買で追い詰められる。" }
  ],
  "gh:episodes": [
    {
      "gh:episode": 1,
      "gh:episodeIndex": 1,
      "gh:episodeId": "episode:260123-cschool-privacy",
      "dct:title": "Arc 0-1: 晒された連絡先",
      "gh:presentationTagline": "Arc 0 | High School & Privacy",
      "gh:arc": "Arc 0",
      "gh:industry": "Student life (高校生)",
      "gh:mainCharacter": "character:Ren",
      "gh:supportingCharacters": ["character:Nei"],
      "gh:realCase": "Credential stuffing / personal data leak → spam calls & spam email",
      "gh:sinContrast": "Careless Reuse (Convenience) vs. Trust (Password Manager + Aliases)",
      "gh:nistFocus": ["PR.AA (Identity Management)", "PR.AC (Access Control)", "PR.DS (Data Security)"],
      "gh:incidentDescription": "C高校の友達のメールアドレスと電話番号が流出し、迷惑メール・迷惑電話が止まらない。RenとNeiが“漏れた入口”を特定し、パスワードマネジャーとメールエイリアス運用で再発を止める。News Hacker では hn: null_pencil_axe が匿名で助言し、別の常連 aka_chise1 / 3pa11er3apiv0t も書き込むが、互いの素性は知らない。",
      "gh:pages": [
        {
          "gh:pageNumber": 1,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Wide Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Wide Shot",
                "gh:lens": "35mm",
                "gh:aperture": "f/2.8",
                "gh:focus": "deep focus",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Wide Shot, eye level, ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air. Early morning desk: a student bag, notebook, and a smartphone vibrating nonstop with unknown calls and spam notifications. shot on 35mm, f/2.8, cinematic live-action.",
              "visual": "朝の机。通学バッグとノートの横で、スマホが知らない番号の着信で震え続けている。",
              "environment": "env:home-desk",
              "characters": ["character:Yuto"],
              "dialogue": [
                { "speaker": "Yuto", "text": "……知らない番号、また。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 2,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Full Page Vertical",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "strong vertical composition, centered subject",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Wide Shot",
                "gh:lens": "24mm",
                "gh:aperture": "f/4",
                "gh:focus": "deep focus",
                "gh:angle": "vertical framing"
              },
              "gh:runwayPrompt": "Full Page Vertical, vertical framing, ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air. Title shot: (Ren: 17-year-old male, slim build, messy wavy black hair, sharp half-lidded eyes) and (Nei: 17-year-old female high school student, platinum blonde bob) in a quiet correspondence high school classroom. Behind them, translucent overlays: password manager vault, email aliases, and a dark marketplace listing. The vertical title 'GHOST Hacker'. shot on 24mm, f/4, cinematic live-action.",
              "visual": "C高校の静かな教室。RenとNei。背後に“パスワード保管庫”“メールの別名”“闇市場のリスト”が薄く重なるタイトルページ。",
              "environment": "env:cschool-classroom",
              "characters": ["character:Ren", "character:Nei"],
              "dialogue": [
                { "speaker": "Narration", "text": "Ghost Hacker。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 3,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Wide Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Wide Shot",
                "gh:lens": "35mm",
                "gh:aperture": "f/2.8",
                "gh:focus": "deep focus",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Wide Shot, eye level, ARIA-style. C-school classroom: individual study booths and laptops, quiet lesson atmosphere. shot on 35mm, f/2.8, cinematic live-action.",
              "visual": "個別ブースが並ぶC高校の教室。静かな授業の空気。",
              "environment": "env:cschool-classroom",
              "characters": ["character:Ren", "character:Nei"],
              "dialogue": [
                { "speaker": "Nei", "text": "C高校、静かすぎて余計に目立つね。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 4,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Medium Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Medium Shot",
                "gh:lens": "50mm",
                "gh:aperture": "f/1.8",
                "gh:focus": "subject focus, soft background",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Medium Shot, eye level, ARIA-style. (Ren: 17-year-old male) at a booth during class, half-lidded eyes, typing notes with calm efficiency. shot on 50mm, f/1.8, cinematic live-action.",
              "visual": "授業中のRen。淡々とノートを取っている。",
              "environment": "env:cschool-classroom",
              "characters": ["character:Ren"],
              "dialogue": [
                { "speaker": "Ren", "text": "困ってるなら、言えばいい。黙るほど長引く。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 5,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Medium Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Medium Shot",
                "gh:lens": "50mm",
                "gh:aperture": "f/1.8",
                "gh:focus": "subject focus, soft background",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Medium Shot, eye level, ARIA-style. A nearby student (Yuto: 16-year-old male, anxious eyes, neat hair) flinches as his phone lights up with unknown calls during class. shot on 50mm, f/1.8, cinematic live-action.",
              "visual": "隣の席のYuto。授業中にスマホが光って、着信にビクッとする。",
              "environment": "env:cschool-classroom",
              "characters": ["character:Yuto"],
              "dialogue": [
                { "speaker": "Yuto", "text": "変なサイト登録しただけで…こんなに来るの？" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 6,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Insert Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Insert",
                "gh:lens": "50mm",
                "gh:aperture": "f/2.0",
                "gh:focus": "sharp focus on object/screen",
                "gh:angle": "over-shoulder or top-down insert"
              },
              "gh:runwayPrompt": "Insert Shot, top-down, ARIA-style. Phone screen: dozens of missed calls from unknown numbers, spam SMS, and emails titled 'urgent' and 'verification' (no readable long text). shot on 50mm, f/2.0, cinematic live-action.",
              "visual": "スマホ画面。知らない番号の不在着信が並び、迷惑SMSと迷惑メール通知が止まらない。",
              "environment": "env:smartphone-screen",
              "characters": ["character:Yuto"],
              "dialogue": [
                { "speaker": "Yuto", "text": "通知が怖い…ずっと見られてる気がする。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 7,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Medium Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Medium Shot",
                "gh:lens": "50mm",
                "gh:aperture": "f/1.8",
                "gh:focus": "subject focus, soft background",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Medium Shot, eye level, ARIA-style. (Nei: 17-year-old female high school student) notices Yuto's panic and looks at Ren with a 'this is serious' expression. shot on 50mm, f/1.8, cinematic live-action.",
              "visual": "NeiがYutoの様子に気づいて、Renを見る。『これ、放っておけない』という目。",
              "environment": "env:cschool-classroom",
              "characters": ["character:Nei", "character:Ren", "character:Yuto"],
              "dialogue": [
                { "speaker": "Nei", "text": "一人で抱えたら潰れるよ。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 8,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Wide Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Wide Shot",
                "gh:lens": "35mm",
                "gh:aperture": "f/2.8",
                "gh:focus": "deep focus",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Wide Shot, eye level, ARIA-style. After class hallway: Ren and Nei talk with Yuto away from others. Yuto shows his phone, embarrassed. shot on 35mm, f/2.8, cinematic live-action.",
              "visual": "放課後の廊下。RenとNeiがYutoのスマホを覗き込み、周りに聞こえない距離で話す。",
              "environment": "env:cschool-hallway",
              "characters": ["character:Ren", "character:Nei", "character:Yuto"],
              "dialogue": [
                { "speaker": "Ren", "text": "最初に“入口”を聞く。いつ、どこで登録した？" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 9,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Medium Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Medium Shot",
                "gh:lens": "50mm",
                "gh:aperture": "f/1.8",
                "gh:focus": "subject focus, soft background",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Medium Shot, eye level, ARIA-style. Yuto gestures: he signed up for a 'free coupon' site, then everything started. Ren listens, expression flat; Nei looks worried. shot on 50mm, f/1.8, cinematic live-action.",
              "visual": "Yutoが気まずそうに手振りで説明する。Renは無表情、Neiは心配そう。",
              "environment": "env:cschool-hallway",
              "characters": ["character:Yuto", "character:Ren", "character:Nei"],
              "dialogue": [
                { "speaker": "Yuto", "text": "無料クーポン…メアドと電話、入れた。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 10,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Insert Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Insert",
                "gh:lens": "50mm",
                "gh:aperture": "f/2.0",
                "gh:focus": "sharp focus on object/screen",
                "gh:angle": "over-shoulder or top-down insert"
              },
              "gh:runwayPrompt": "Insert Shot, top-down, ARIA-style. Ren opens a breach-check style page and types Yuto's email; warning indicators and leak dates appear (no real brands). shot on 50mm, f/2.0, cinematic live-action.",
              "visual": "漏えいチェックの画面。Yutoのメールを入れると、警告と日付が並ぶ。",
              "environment": "env:smartphone-screen",
              "characters": ["character:Ren"],
              "dialogue": [
                { "speaker": "Ren", "text": "確認する。漏れた“事実”は、怖いけど武器になる。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 11,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Close-up",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Close-up",
                "gh:lens": "85mm prime",
                "gh:aperture": "f/1.2",
                "gh:focus": "shallow depth of field, creamy bokeh",
                "gh:angle": "frontal",
                "gh:eyeDetail": "highly detailed expressive eyes, intricate iris patterns, sharp sparkling catchlights, crystalline ocular texture"
              },
              "gh:runwayPrompt": "Close-up, frontal, ARIA-style. Ren's eyes reflect a list of breached services and dates. shot on 85mm prime, f/1.2, cinematic live-action.",
              "visual": "Renの瞳に、漏えいしたサービス名と日付が反射する。",
              "environment": "env:cschool-hallway",
              "characters": ["character:Ren"],
              "dialogue": [
                { "speaker": "Ren", "text": "……複数。つまり“使い回し”が効く。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 12,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Medium Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Medium Shot",
                "gh:lens": "50mm",
                "gh:aperture": "f/1.8",
                "gh:focus": "subject focus, soft background",
                "gh:angle": "eye level"
              },
              "gh:runwayPrompt": "Medium Shot, eye level, ARIA-style. Yuto admits he reused the same password across sites, ashamed. shot on 50mm, f/1.8, cinematic live-action.",
              "visual": "俯くYuto。小声で打ち明ける。",
              "environment": "env:cschool-hallway",
              "characters": ["character:Yuto"],
              "dialogue": [
                { "speaker": "Yuto", "text": "パスワード…同じの、ずっと。" }
              ]
            }
          ]
        },
        {
          "gh:pageNumber": 13,
          "gh:panels": [
            {
              "panel": 1,
              "shot": "Insert Shot",
              "gh:shotProperties": {
                "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
                "gh:composition": "clean composition, clear subject separation",
                "gh:lighting": "soft diffused daylight, gentle shadows",
                "gh:distance": "Insert",
                "gh:lens": "50mm",
                "gh:aperture": "f/2.0",
                "gh:focus": "sharp focus on object/screen",
                "gh:angle": "over-shoulder or top-down insert"
              },
              "gh:runwayPrompt": "Insert Shot, ARIA-style. A login attempt alert on Yuto's email account: multiple countries, many failed tries. shot on 50mm, f/2.0, cinematic live-action.",
              "visual": "ログイン試行の警告。世界中からの失敗ログが並ぶ。",
              "environment": "env:smartphone-screen",
