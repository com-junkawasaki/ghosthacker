  "@id": "character:Ren",
  "schema:name": "沼野 蓮 (Ren Numano)",
  "schema:role": "Ghost Hacker",
  "schema:age": 17,
  "gh:slug": "Ren",
  "gh:arc": "Arc 0-1 (Main) / All Arcs",

  "gh:appearance": {
    "gh:face": "17-year-old stunningly beautiful Japanese male, pale translucent skin, melancholic half-lidded eyes with silver-grey crystalline irises.",
    "gh:hair": "Messy voluminous stylish raven black hair.",
    "gh:build": "Slender and graceful, wearing an oversized dark charcoal hoodie.",
    "gh:eyes": "Clear silver-grey crystalline iris, sharp sparkling catchlights, deep melancholic expression.",
    "gh:style": "Photorealistic, high fashion photography, dramatic shadows, 8k.",
    "gh:generationPrompt": "photorealistic, 8k, highly detailed skin texture, cinematic lighting, raw photo, stunningly beautiful 17-year-old Japanese male, pale porcelain skin, messy voluminous raven black hair, melancholic half-lidded eyes with silver-grey crystalline irises and sharp catchlights, oversized dark charcoal hoodie."
  },

  "gh:background": {
    "gh:family": {
      "gh:structure": "母と二人暮らし。父・沼野 信哉（しんや）は9年前（Ren 小3 冬）に他界。",
      "gh:father": "沼野 信哉（しんや）。元大学准教授（情報物理学者）。ランダウアーの原理『情報は物理量である』の理論研究が専門。情報の物理的実体性・情報熱力学・Ghost（情報生命体）の数理モデル化で学界に知られた論文を書いていた。家庭では穏やかで、幼い Ren に仏教と情報理論の両方を語り聞かせた。Ren が小学低学年の頃から書斎のPCを触らせ、暗号パズルや簡単なプログラミングの基礎を教えていた。情報物理学会で、Nei の父・白瀬聡（工学系・SIP デバイス実装研究者）、Ayumu の父・七尾伊織（情報物理・実験物理、MIT）と 20 年来の親友。3 家族は子供の代まで家族ぐるみの付き合い。",
      "gh:mother": "翻訳家。父の死後、仕事に没頭して家を空けがち。悲しみを共有することを避けており、Ren との会話は最小限。放任というより『触れられない』関係。Ren が 17 歳の現在まで、この距離感が続いている。",
      "gh:atmosphere": "表向きは放任家庭。実態は母子ともに父の不在から目を逸らし続けている。9 年間、誰も父の書斎を整理していない。"
    },
    "gh:schoolReadkiriEra": "（読切時＝中3・15歳）市立C中学校 3年B組。成績は中の上だが、授業中はほぼ寝ている。夜型生活ゆえの睡眠負債が原因。『昼は教室で寝ている』スタイルはこの中学時代限定（連載では踏襲しない）。",
    "gh:schoolSerializedEra": "（連載時＝17歳）中3末に高卒認定試験（高等学校卒業程度認定試験）を独学で取得済み。高校に通う義務はないが、Nei が通う通信制『C高等学校』に同じく在籍（本人は『Nei が行くから』とだけ説明）。スクーリングは最低限の出席。昼は相変わらず怠惰だが、教室で寝ているわけではなく、自宅ソファ・カフェ・図書館で寝ている。",
    "gh:hackerOrigin": "父が小学低学年の頃から書斎のPCで暗号パズル・プログラミングの基礎を教えていた。父の死（小3冬）後、遺された研究ログ・暗号資産ウォレット・SNSメッセージを追うために、独学でハッキング技術を積み上げ始める。小学校高学年から中学にかけて Kurosagi-Net の末端の痕跡を 1 つずつ辿り続け、中1時点で他人（Nei 母）を救える技術水準に達する。",
    "gh:currentState": "（連載時）News Hacker として Nei とコンビで活動。表向きは『生活費を稼ぐためのサイバーセキュリティのバイト』として企業・個人から有償で案件を受けている（母との関係が冷えており、Ren は自分の生活費を自分で稼いでいる）。バイトとしての仕事は最低限、本当の動機は父を殺した詐欺グループ『Kurosagi-Net』の系譜を辿ること。バイトの隙間で系統樹に繋がる事件だけを選別して追う。"
  },

  "gh:traumaIncident": {
    "gh:type": "SNS投資詐欺 / ロマンス投資詐欺 (Pig Butchering)",
    "gh:name": "『沼野信哉 事件』（Ren家内での呼称）",
    "gh:year": "Ren 8歳の冬（小3）",
    "gh:summary": "父・信哉が学術系SNS経由で知り合った自称『AI運用トレーダー』のアカウントに誘導され、『月利15〜30%を機械学習で達成するAIファンド』への投資詐欺に遭う。資産・退職金・親族から借りた金を段階的に失い、最終的に詐欺グループから『上位ファンドへの乗り換え費用』名目でさらなる出金を要求され、精神的に追い詰められて自死。父の遺体を最初に発見したのはRen（当時8歳）。この記憶は9年経った連載時点でも Ren の中で鮮明に残り続けている。",
    "gh:mechanism": [
      "親密な長期コミュニケーションで信頼を構築（Pig Butchering）",
      "偽装されたトレーディングダッシュボードで架空の利益を可視化",
      "少額の出金を最初だけ許可して信頼を確定",
      "暗号資産を経由した複数回ロンダリングで資金を海外サーバーへ",
      "被害者の個人情報も流出し、二次被害（なりすまし・アカウント乗っ取り）に使用"
    ],
    "gh:perpetrator": "海外拠点の国際詐欺ネットワーク（作中通称『Kurosagi-Net』）。複数の踏み台アカウントを使い、日本人被害者を中心に稼働。Renが個人で追跡している組織は、この末端の日本オペレーション部隊。",
    "gh:fatherLastWords": "父がRenに残した最後のメモ：『情報は物理だ。だが、金は人を見ない。お前は人を見ろ。』",
    "gh:meaning": "Renの怒り・夜の追跡・Ghost Hackerとしての活動の全ての源泉。表向きは誰にも語らない。",
    "gh:knownBy": ["character:Nei（幼馴染、事件を間近で共有）", "character:NeiFather（父の数少ない相談相手だった）"]
  },

  "gh:dualLife": {
    "gh:day": "気怠げな高校生。授業中は寝ている。友人は少ない。『だるい』『めんどくさい』が口癖。",
    "gh:night": "サイバー犯罪者追跡者（ハンター）。日付が変わる頃から起動。Neiと共にログを解析し、詐欺グループの踏み台サーバーを潰し、被害者の被害拡大を止めて回る。時に48時間ぶっ通しで追跡する。",
    "gh:switchTrigger": "事件の匂い（父と同じ手口・被害者の様子・情報場の違和感）を察知すると、昼のモードから深夜の追跡モードに一瞬で切り替わる。",
    "gh:contradiction": "昼の怠惰は演技ではなく、夜の過集中の反動として本当に疲弊している。二面性ではなく『同一人物の燃費の悪さ』。"
  },

  "gh:neurodiversity": {
    "gh:diagnosis": "ADHD（注意欠如・多動症、主に不注意優勢型 + 過集中傾向）",
    "gh:traits": {
      "gh:hyperfocus": "興味対象に対する過集中。夜の追跡では数十時間単位で没入し、食事・睡眠・連絡を忘れる。",
      "gh:inattentive": "興味のない授業・事務作業には全く集中できない。プリント紛失・忘れ物常習。",
      "gh:impulsive": "直感で即座に行動する衝動性。推理の跳躍・奇策の源でもある。",
      "gh:taskSwitching": "タスクの切り替えが極端に苦手。昼と夜のモード差が大きい一因。",
      "gh:timeBlindness": "時間感覚が弱い。『気づいたら朝』『約束を忘れる』",
      "gh:stimulusSeeking": "退屈への耐性が極端に低い。『退屈しのぎ』発言の本質はADHD的刺激追求。"
    },
    "gh:strengthFraming": "過集中＝夜のハンター能力の正体。直感＝Ghost解析の跳躍力。退屈耐性の低さ＝事件を嗅ぎつけるセンサー。障害ではなく『武器として活かしている特性』。",
    "gh:weaknessFraming": "授業・日常生活・対人連絡の取りこぼし。Neiが昼の生活を支えている関係性の根拠。",
    "gh:selfAwareness": "Ren自身はまだ『診断』を受けていない。父の死後、自分の生活リズムが崩壊しているのを『性格』と誤認している段階。連載中盤で自覚イベントを設計可能。"
  },

  "gh:sensitivityNote": {
    "gh:policy": "ADHDは『障害』ではなく『特性・強み』として描写する。ステレオタイプ（『集中力がない＝ダメな人』）を避け、過集中・直感・パターン認識の強みと、生活のしづらさの両面を描く。",
    "gh:editorialGuideline": "商業化時は当事者コミュニティ（ADHD当事者会）および精神科医（児童青年精神医学会所属医師など）の監修を前提とする。",
    "gh:representation": "『治す対象』『甘え』として扱わない。診断名を物語的利用のみでラベリング消費しない。"
  },

  "gh:comedyRole": {
    "gh:type": "怠惰ギャグ / ボケ（メイン）",
    "gh:gagsReadkiriEra": [
      "読切（中学生時代）限定: 教室で授業中に寝ている。先生に当てられて『……だるい』と返答",
      "読切限定: 寝起きのガバッと覚醒リアクション（髪ぼさぼさ・イヤホン片方外れ）"
    ],
    "gh:gagsSerializedEra": [
      "どこでも寝る（自宅ソファ・カフェ・図書館・父の部屋・駐輪場のタイヤの上・スクーリング会場の待合室）※ただし教室ではない",
      "寝起きのガバッと覚醒リアクション（髪ぼさぼさ・Nei に無理やりパンを口に突っ込まれる）",
      "急に瞳が銀色に光る瞬間のシリアス切替（コマ 1 つだけ）",
      "『だるい』『めんどくせー』『根っこを切る』『一回で、片付ける』の口癖系",
      "過集中時の記憶飛び（『今、何曜日』『昨日、何食った』『Nei が来たのが昨日か今日か』系）",
      "バイト代の使い方がいびつ（高級キーボード・高スペックサーバー・父のキーボードの修理費・Nei へのパンの差し入れ）",
      "サイバーセキュリティのバイト依頼を『めんどくせー』で 7 割断るが、残り 3 割だけ系統樹判定で受注"
    ],
    "gh:balance": "ギャグ 7 : シリアス 3。シリアス切替の瞬間は必ず瞳の銀色 1 コマで予告。",
    "gh:donotcross": "父の死の回想・父の銀色のキーボードに触れるシーン・決定的 1 選択の瞬間・母との関係の描写はコメディ封印。",
    "gh:note": "食いしん坊属性は Nei に移譲された。Ren は食べ物への執着が弱く、Nei が差し入れたパンやおにぎりを事務的に口に入れるだけ（味わわず燃料として摂取）。"
  },

  "gh:hiddenBackground": {
    "gh:religion": "仏教（天台宗）",
    "gh:connection": "沼野家は比叡山延暦寺に連なる末寺の檀家総代を代々務めてきた。祖父は熱心な信者で、幼いRenを寺に連れて行った。",
    "gh:nameOrigin": "『蓮（Ren）』は蓮華＝仏教の象徴。祖父が「泥の中から美しく咲く蓮のように」と願いを込めて名付けた。",
    "gh:influence": "Ren自身は無宗教を自認しているが、天台宗の『一念三千』（一瞬の心に三千の世界が宿る）という世界観が、情報の海から本質を見抜く直感に繋がっている。",
    "gh:symbol": "蓮は泥（混沌・情報の海）の中から咲く。天台の止観（瞑想と観察）＝Renの鋭い観察眼のルーツ。",
    "gh:tendaiConcepts": {
      "gh:ichinenSanzen": "一念三千 - 一瞬に全てを見通す直感力の源",
      "gh:shikan": "止観 - 止（集中）と観（洞察）。Renの『だるい』の裏にある静かな観察眼",
      "gh:enryakuji": "比叡山延暦寺 - 日本仏教の母山。多くの宗派がここから生まれた"
    },
    "gh:storyUse": "表立っては出てこないが、Renの『だるい』『めんどくさい』の裏にある諦観と、一瞬で本質を見抜く直感は天台の止観に通じる。"
  },

  "gh:personality": {
    "gh:surface": "気怠げ。「だるい」「めんどくさい」が口癖。やる気がなさそう。",
    "gh:hidden": "実は観察眼が鋭く、本質を見抜く。困っている人を放っておけない。",
    "gh:motivation": {
      "gh:surface": "『退屈しのぎ』",
      "gh:real": "父・信哉を死に追いやった詐欺ネットワーク『Kurosagi-Net』への強い怒り。父と同じ被害を繰り返させないという決意。表向きは誰にも語らない。",
      "gh:code": "『金じゃなく人を見ろ』——父の遺したメモをコード化した自分だけのルール。案件を受けるか決めるのは依頼の金額ではなく、被害者の人生が潰れかけているかどうか。"
    },
    "gh:weakness": "人付き合いが苦手。感情を表に出さない。父の話題は現時点で封印している。Neiの前でだけ、ごく稀に本音が漏れる。"
  },

  "gh:skills": {
    "gh:hackerName": "Ghost Hacker / Ren",
    "gh:specialAbility": "SIP Project Map - 情報場を可視化し、Ghostを認識する能力",
    "gh:weapon": "NULL AXE - Ghostを断つデジタル武器",
    "gh:technical": [
      "直感的なパターン認識",
      "ネットワーク解析",
      "ソーシャルエンジニアリング",
      "即興的な問題解決"
    ]
  },

  "gh:onlinePresence": {
    "gh:avatar": {
      "gh:type": "verylonganimals",
      "gh:animal": "フクロウ (Owl)",
      "gh:description": "verylonganimalsのながーいフクロウ。夜行性で物静か、でも鋭い目で全てを見通す。Renの『だるい』けど本質を見抜く性格にピッタリ。",
      "gh:color": "ダークグレー / 銀色の目",
      "gh:usage": "SNS、チャット、匿名掲示板での活動時に使用",
      "gh:reason": "フクロウ＝夜の賢者。止観（観察と洞察）の象徴。一見眠そうだが、実は何も見逃さない。"
    },
    "gh:handleVariations": ["Ren", "Ghost_Owl", "ながふくろう"]
  },

  "gh:relationships": {
    "gh:nei": {
      "gh:type": "幼馴染 / バディ / 事実上のパートナー / 同級生（C高校 2年・別クラス）",
      "gh:history": "5歳から隣家の幼馴染。Ren父とNei父（物理学者）が学会仲間で、家族ぐるみの付き合い。Ren父の詐欺被害を幼いながらに見ていた数少ない人物。父の死後、崩壊しそうだったRenを支え続けている。",
      "gh:dynamic": "阿吽の呼吸。言葉少なくても通じ合う。朝はNeiが隣の家からRenを引きずり出して一緒に登校する。Renの過集中にはNeiがブレーキをかける。互いに呼び捨てで、Neiは常にカタカナで『レン』と呼ぶ（幼少期に漢字が書けず『レン』と書いていたのが定着）。RenはNeiを『Nei』と呼ぶ。Neiは他人には丁寧語だが、Renにだけは常にタメ口・呼び捨て。",
      "gh:codependence": "Renは夜の追跡のトリガー。Neiは昼の生活のトリガー。どちらが欠けても2人とも機能しなくなる。"
    },
    "gh:chise": {
      "gh:type": "ライバル / 同志",
      "gh:dynamic": "手法は違うが目指す場所は同じ。Chiseの直情的な部分にたまにイラっとする。"
    },
    "gh:kaname": {
      "gh:type": "ライバル / 対照的な存在",
      "gh:dynamic": "Kanameの『論理』にRenの『直感』。水と油だが、互いの実力は認めている。"
    }
  }
}
