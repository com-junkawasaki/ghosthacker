  "dct:title": "Arc 0-2: 「恥じゃない。残すのが一番強い」",
  "gh:arc": "Arc 0",
  "gh:episode": 2,
  "gh:episodeId": "episode:260123-cschool-defamation",
  "gh:episodeIndex": 2,
  "gh:storyOutline": "story-outline.jsonld",
  "gh:tagline": "消すな。残せ。それが一番強い武器になる。",
  "gh:theme": "ネット上の誹謗中傷・ドクシングに対する正しい対処法",
  "gh:incidentDescription": "都立工科高校の人気ゲーム配信者・黒田涼（2年）がドクシング被害に遭う。住所を特定され、誹謗中傷が拡散、自宅や学校に嫌がらせが届く。元eスポーツ部エースで休学中の赤羽千世（HN: aka_chise1）が後輩の危機に立ち上がり、証拠保全から法的対処までを指揮する。",
  "gh:industry": "Student life (高校生)",
  "gh:mainCharacter": "character:Chise",
  "gh:mainLocation": "org:TokyoTechHighSchool",
  "gh:supportingCharacters": [
    "character:RyoKuroda",
    "character:ShotaHayashi",
    "character:YuiTanaka",
    "character:DaichiMori"
  ],
  "gh:nistFocus": [
    "PR.AA (Identity Management)",
    "DE.CM (Continuous Monitoring)",
    "RS.CO (Response Communications)"
  ],
  "gh:actStructure": [
    {
      "@id": "act:1-daily-life",
      "gh:actNumber": 1,
      "gh:actTitle": "日常と異変",
      "gh:actTitleEn": "Normal Life & Signs of Trouble",
      "gh:pageRange": [1, 2],
      "gh:narrativePurpose": "Ryoの配信者としての日常と、突然のドクシング攻撃開始を描く"
    },
    {
      "@id": "act:2-escalation",
