  "gh:castOfCharacters": [
    {
      "@id": "character:Chise",
      "gh:description": "都立工科高校の3年生（休学中）。元eスポーツ部エース。赤羽八幡神社の宮司の孫娘。HN: aka_chise1。",
      "gh:role": "主人公 / 問題解決者"
    },
    {
      "@id": "character:RyoKuroda",
      "gh:description": "2年生の人気ゲーム配信者。登録者5万人。明るく人懐っこいが繊細。",
      "gh:role": "被害者"
    },
    {
      "@id": "character:ShotaHayashi",
      "gh:description": "3年生。実家はラーメン屋。RyoをChiseに紹介する。",
      "gh:role": "Chiseの親友 / 橋渡し役"
    },
    {
      "@id": "character:YuiTanaka",
      "gh:description": "3年生（情報科首席）。証拠保全の技術的サポートを担当。",
      "gh:role": "技術サポート"
    },
    {
      "@id": "character:DaichiMori",
      "gh:description": "Chiseの元友人。裏社会の情報を持つ。",
      "gh:role": "情報提供者（グレー）"
    }
  ],
  "gh:educationalContent": {
    "gh:keyTakeaways": [
      "削除する前にスクショ・URLを保存する",
      "日時とともに時系列で記録する",
      "サイバー犯罪相談窓口（#9110）に連絡",
      "発信者情報開示請求という法的手段がある",
      "被害者は悪くない。声を上げることは恥ずかしいことじゃない"
    ],
    "gh:mainMessage": "ネット上の誹謗中傷は犯罪。一人で抱え込まず、証拠を残して専門家に相談することが大切。",
    "gh:resources": [
      "警察庁サイバー犯罪相談窓口",
