{
  "@context": {
    "act": "gh:act/",
    "character": "gh:character/",
    "dct": "http://purl.org/dc/terms/",
    "dialogue": "gh:dialogue",
    "env": "gh:environment/",
    "environment": "gh:environment",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "panel": "gh:panelIndex",
    "prompt": "gh:runwayPrompt",
    "properties": "gh:shotProperties",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "http://schema.org/",
    "shot": "gh:shotType",
    "speaker": "gh:speaker",
    "text": "gh:text",
    "visual": "gh:visual"
  },
  "@id": "act:1-introduction",
  "@type": ["gh:Act", "prov:Entity"],
  "gh:actNumber": 1,
  "gh:actTitle": "日常と誘惑",
  "gh:actTitleEn": "Daily Life & Temptation",
  "gh:pageRange": [1, 7],
  "gh:emotionalArc": "平穏 → 誘惑 → 決断",
  "gh:narrativePurpose": "読者をYutoに同一化させ、詐欺への導線を描く",
  "gh:keyBeat": "hook",
  "gh:pages": [
    {
      "gh:act": "act:1-introduction",
      "gh:pageBeat": {
        "gh:emotionalShift": "ゆるい幸福 → ほんの一瞬の焦り/欲",
        "gh:hook": "「限定」という言葉が、Yutoの指を動かす",
        "gh:tempo": "loose → tiny sting",
        "gh:turn": "日常の軽口の中に、違和感の種（スマホ/通知/欲望）を落とす"
      },
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "characters": ["character:Yuto", "character:Akira", "character:Mei", "character:Saki", "character:Kota"],
          "dialogue": [
            {
              "gh:delivery": "椅子にだらっともたれて、語尾を伸ばす。小さく笑って、みんなを巻き込む。",
              "gh:emotion": "relief",
              "gh:pauseAfterMs": 120,
              "gh:subtext": "『今日くらい楽したい』っていう等身大の共有",
              "speaker": "Sakuraba Mei (Mei-chan)",
              "text": "今日さ、体育ないの神〜。"
            },
            {
              "gh:delivery": "軽く笑って合わせる。笑い終わりに、机の上のスマホへ視線が一瞬だけ落ちる。",
              "gh:emotion": "light",
              "gh:pauseAfterMs": 180,
              "gh:subtext": "楽しいのに、どこか落ち着かない"予兆"がある",
              "speaker": "Yuto",
              "text": "わかるわかる。昼まで生きれるわー"
            }
          ],
          "environment": "env:cschool-classroom",
          "gh:imagePrompt": "Wide Shot, ARIA-style. 休憩時間の教室。Yutoが男女混じりのクラスメイトと楽しそうに話している。Renは気怠そうに壁にもたれ、Neiは本を読んでいる。luminous atmosphere, soft diffused natural light, pristine clean air. shot on 35mm, f/2.8, cinematic live-action.",
          "gh:runwayPrompt": "Wide Shot, ARIA-style. 休憩時間の教室。Yutoが男女混じりのクラスメイトと楽しそうに話している。Renは気怠そうに壁にもたれ、Neiは本を読んでいる。luminous atmosphere, soft diffused natural light, pristine clean air. shot on 35mm, f/2.8, cinematic live-action.",
          "gh:shotProperties": {
            "gh:angle": "eye level",
            "gh:aperture": "f/2.8",
            "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
            "gh:composition": "clean composition, clear subject separation",
            "gh:distance": "Wide Shot",
            "gh:focus": "deep focus",
            "gh:lens": "35mm",
            "gh:lighting": "soft diffused daylight, gentle shadows"
          },
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "休憩時間の教室。Yutoが男女混じりのクラスメイトと楽しそうに話している。Renは気怠そうに壁にもたれ、Neiは本を読んでいる。"
        }
      ]
    },
    {
      "gh:act": "act:1-introduction",
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "characters": ["character:Akira"],
          "dialogue": [
            {
              "gh:delivery": "少し早口。得意げに「限定」を強調して、周りの視線を確かめる。",
              "gh:emotion": "pride",
              "gh:pauseAfterMs": 120,
              "gh:subtext": "羨望を集めたい／優位に立ちたい",
              "speaker": "Kurokawa Akira (Aki)",
              "text": "見て見て！これ限定販売なんだぜ！もう手に入らない！"
            },
            {
              "gh:delivery": "羨ましそうに目を輝かせて見つめる。",
              "gh:emotion": "envy",
              "gh:pauseBeforeMs": 180,
              "gh:subtext": "「欲しい」が小さく刺さる",
              "speaker": "Yuto",
              "text": "いいなー！うらやましい！"
            }
          ],
          "environment": "env:cschool-classroom",
          "gh:imagePrompt": "Insert Shot, ARIA-style. Akiraが限定ブランドの若者向けファッションアイテムを自慢する。周囲が羨ましがる。Yutoも「いいなぁ」と目を輝かせる。luminous atmosphere, soft diffused natural light, pristine clean air. shot on 50mm, f/2.0, cinematic live-action.",
          "gh:runwayPrompt": "Insert Shot, ARIA-style. Akiraが限定ブランドの若者向けファッションアイテムを自慢する。周囲が羨ましがる。Yutoも「いいなぁ」と目を輝かせる。luminous atmosphere, soft diffused natural light, pristine clean air. shot on 50mm, f/2.0, cinematic live-action.",
          "gh:shotProperties": {
            "gh:angle": "top-down insert",
            "gh:aperture": "f/2.0",
            "gh:atmosphere": "ARIA-style: luminous atmosphere, soft diffused natural light, pristine clean air",
            "gh:composition": "clean composition, clear subject separation",
            "gh:distance": "Insert",
            "gh:focus": "sharp focus on object/screen",
            "gh:lens": "50mm",
            "gh:lighting": "soft diffused daylight, gentle shadows"
          },
          "panel": 1,
          "shot": "Insert Shot",
          "visual": "Akiraが限定ブランドの若者向けファッションアイテムを自慢する。周囲が羨ましがる。Yutoも「いいなぁ」と目を輝かせる。"
        }
      ]
    },
    {
      "gh:act": "act:1-introduction",
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "静かな場所ほど、通知は刺さる。"
