      "gh:act": "act:1-introduction",
      "gh:pageBeat": {
        "gh:emotionalShift": "ゆるい幸福 → ほんの一瞬の焦り/欲",
        "gh:hook": "「限定」という言葉が、Yutoの指を動かす",
        "gh:tempo": "loose → tiny sting",
        "gh:turn": "日常の軽口の中に、違和感の種（スマホ/通知/欲望）を落とす"
      },
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "characters": [
            "character:Yuto",
            "character:Akira",
            "character:Mei",
            "character:Saki",
            "character:Kota"
          ],
          "dialogue": [
            {
              "gh:delivery": "椅子にだらっともたれて、語尾を伸ばす。小さく笑って、みんなを巻き込む。",
              "gh:emotion": "relief",
              "gh:pauseAfterMs": 120,
              "gh:subtext": "『今日くらい楽したい』っていう等身大の共有",
              "speaker": "Sakuraba Mei (Mei-chan)",
              "text": "今日さ、体育ないの神〜。"
            },
            {
              "gh:delivery": "軽く笑って合わせる。笑い終わりに、机の上のスマホへ視線が一瞬だけ落ちる。",
              "gh:emotion": "light",
              "gh:pauseAfterMs": 180,
              "gh:subtext": "楽しいのに、どこか落ち着かない“予兆”がある",
              "speaker": "Yuto",
              "text": "わかるわかる。昼まで生きれるわー"
            }
          ],
          "environment": "env:cschool-classroom",
          "gh:actingDirection": {
            "gh:blocking": "机を囲む輪。Yutoは中心寄り、Renは少し離れて気怠げに壁にもたれ、Neiは窓際で本に視線を落としている。",
            "gh:eyeLine": "会話→スマホ→また会話（違和感はまだ言語化しない）",
            "gh:gesture": "Meiは伸び、Yutoは頬を緩めつつ指先だけ落ち着かない。Renは欠伸。Neiはページをめくる。",
            "gh:microBeats": [
              "笑い声が落ち着く",
              "スマホが小さく震える/通知が光る（気づくか気づかないかの境界）",
              "Yutoが『見なかったこと』にして会話へ戻る"
            ],
            "gh:tempo": "loose"
          },
          "gh:imagePrompt": "Wide Shot, ARIA-style. 休憩時間の教室。Yutoが男女混じりのクラスメイトと楽しそうに話している。Renは気怠そうに壁にもたれ、Neiは本を読んでいる。. luminous atmosphere, soft diffused natural light, pristine clean air. shot on 35mm, f/2.8, cinematic live-action.",
          "gh:runwayPrompt": "Wide Shot, ARIA-style. 休憩時間の教室。Yutoが男女混じりのクラスメイトと楽しそうに話している。Renは気怠そうに壁にもたれ、Neiは本を読んでいる。. luminous atmosphere, soft diffused natural light, pristine clean air. shot on 35mm, f/2.8, cinematic live-action.",
          "gh:shotProperties": {
