  "gh:arc": "Arc 0",
  "gh:castOfCharacters": [
    {
      "@id": "character:Kaname",
      "gh:description": "星蘭学院3年。生徒会副会長。水城家の跡取り。HN: 3pa11er3apiv0t。法と論理で戦う。",
      "gh:role": "主人公 / 問題解決者"
    },
    {
      "@id": "character:SoraAoyama",
      "gh:description": "2年生の特待生。母子家庭で経済的に苦しい。真面目で努力家だがプライドが高い。",
      "gh:role": "被害者"
    },
    {
      "@id": "character:RikaShirakawa",
      "gh:description": "3年生。法律事務所パートナーの娘。ソラの異変に最初に気づく。",
      "gh:role": "生徒会長 / 協力者"
    },
    {
      "@id": "character:KenjiOhara",
      "gh:description": "3年生。サッカー部キャプテン。Kanameの孤立を防ぐ存在。",
      "gh:role": "Kanameの親友"
    },
    {
      "@id": "character:TakashiNomura",
      "gh:description": "星蘭の卒業生。投資詐欺グループの末端斡旋役。",
      "gh:role": "黒幕 / 闇バイト斡旋者"
    },
    {
      "@id": "character:MizukiShinji",
      "gh:description": "元官僚。金融業界に詳しい。Kanameに解決の糸口を示す。",
      "gh:role": "Kanameの叔父 / アドバイザー"
    }
  ],
  "gh:educationalContent": {
    "gh:keyTakeaways": [
      "『簡単に稼げる』仕事には裏がある",
      "一度でも応じると、脅迫材料にされる",
      "脅されても、相談すれば助けてもらえる",
      "被害者は罪に問われないことが多い（早期相談が重要）",
      "口座や携帯を売ると、犯罪に使われて自分が加害者扱いされるリスク"
    ],
    "gh:mainMessage": "闇バイトは一度始めると抜け出しにくい。でも、被害者として助けを求めれば必ず道はある。",
    "gh:resources": [
      "警察相談ダイヤル #9110",
      "消費者ホットライン 188",
      "法テラス（日本司法支援センター）",
      "ヤング・テレホン（各都道府県警察）",
      "金融庁「詐欺的な投資勧誘」注意喚起"
    ],
    "gh:warningSignsOfDarkJob": [
      "高すぎる報酬（時給1万円以上など）",
      "仕事内容が曖昧",
      "身分証や口座情報を要求される",
      "秘密厳守を強調される",
      "最初は簡単な仕事から始まる"
    ]
  },
  "gh:episodeIndex": 3,
  "gh:incidentSummary": {
    "gh:description": "特待生の青山ソラが、経済的理由から『簡単な情報収集バイト』に手を出す。最初は軽い仕事だったが、次第に親の仕事に関わる機密情報を要求されるように。断ろうとすると過去の活動記録で脅迫される。",
    "gh:nistFocus": [
      "ID.RA (Risk Assessment)",
      "PR.AA (Identity/Access)",
      "RS.AN (Response Analysis)"
    ],
    "gh:type": "闇バイト（情報売買・特殊詐欺への加担）",
    "gh:victim": "character:SoraAoyama"
  },
