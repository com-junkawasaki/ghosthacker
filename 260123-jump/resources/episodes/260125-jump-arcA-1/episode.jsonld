    },
    {
      "gh:pageNumber": 20,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:President"],
          "dialogue": [
            {"speaker": "Ren", "text": "…ちょっと待てよ。"},
            {"speaker": "President", "text": "ん？君は…？"},
            {"speaker": "Shouta", "text": "親父、この人がシステムを復旧してくれた専門家で…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Renが立ち上がり、社長に近づく。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "社長さん。一つ聞いていい？"},
            {"speaker": "Ren", "text": "安本さんに、いくら予算出してた？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "Renと社長が向き合う。空気が変わる。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "予算…？そりゃあ、必要な分は…"},
            {"speaker": "Ren", "text": "具体的に。年間いくら？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "社長が言葉に詰まる。"
        }
      ]
    },
    {
      "gh:pageNumber": 21,
      "gh:panels": [
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "答えられないよね。『必要な分』なんて出してないから。"},
            {"speaker": "Ren", "text": "経理見た。IT関連予算、5年前から毎年削減されてる。"},
            {"speaker": "Ren", "text": "去年なんてゼロだ。備品購入費すらない。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Renが淡々と事実を突きつける。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "そ、それは…景気が厳しくて…"},
            {"speaker": "Ren", "text": "じゃあ人員は？安本さん以外にシステム担当いた？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "社長が言葉を失う。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "いない。30年間、安本さん一人。"},
            {"speaker": "Ren", "text": "引き継ぎもない。マニュアルもない。評価制度もない。"},
            {"speaker": "Ren", "text": "全部、『安本に任せとけ』で済ませてきた。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renの目が鋭く光る。"
        }
      ]
    },
    {
      "gh:pageNumber": 22,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:President"],
          "dialogue": [
            {"speaker": "Ren", "text": "社長さん。あんたが今やったこと、わかってる？"},
            {"speaker": "Ren", "text": "『水に流す』『家族だ』…聞こえはいいけどさ。"},
            {"speaker": "Ren", "text": "それって、『原因を考えない』ってことだよ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Renが社長を見据える。周囲が息を呑む。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "安本さんは限界だった。"},
            {"speaker": "Ren", "text": "予算もない、人もいない、評価もない。"},
            {"speaker": "Ren", "text": "そんな環境で30年。誰だって壊れる。"}
          ],
