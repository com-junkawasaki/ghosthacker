      ]
    },
    {
      "gh:pageNumber": 17,
      "gh:panels": [
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "何があったんだ！！"},
            {"speaker": "SE", "text": "ガチャッ"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "社長・大門五郎（60代）が作業着姿で駆け込む。"
        },
        {
          "characters": ["character:President", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "President", "text": "安本！！どうしたんだお前…！"},
            {"speaker": "Yasumoto", "text": "社長…私は…私は…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "社長が安本に駆け寄る。"
        },
        {
          "characters": ["character:Shouta", "character:President"],
          "dialogue": [
            {"speaker": "Shouta", "text": "…親父。落ち着いて聞いてくれ。"},
            {"speaker": "Shouta", "text": "今回のシステム障害…安本さんが起こしたんだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "翔太が苦渋の表情で説明。"
        }
      ]
    },
    {
      "gh:pageNumber": 18,
      "gh:panels": [
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…何だと…？"},
            {"speaker": "President", "text": "安本…お前が…？30年の付き合いだぞ…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Close-up",
          "visual": "社長の顔。信じられないという表情。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "…すみません、社長…"},
            {"speaker": "Yasumoto", "text": "でも…でも俺は…限界だったんです…"},
            {"speaker": "Yasumoto", "text": "誰も…誰も俺の話を聞いてくれなかった…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "安本が涙ながらに訴える。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…………"},
            {"speaker": "President", "text": "…安本。今回のことは…水に流す。"},
            {"speaker": "President", "text": "お前は家族だ。これからも一緒にやっていこう。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "社長が安本の肩に手を置く。優しい表情。"
