  "dct:title": "Arc A-1: 「俺の居場所を奪うな」",
  "gh:arc": "Arc A",
  "gh:episode": 2,
  "gh:episodeId": "episode:260125-jump-arcA-1",
  "gh:episodeIndex": 2,
  "gh:industry": "Construction (建設)",
  "gh:mainCharacter": "character:Ren",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "東京・蒲田。下町の中小企業が軒を連ねる街。"}
          ],
          "environment": "env:kamata-morning",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "早朝の蒲田。古いビルと新しいビルが混在。遠くに羽田空港へ向かう飛行機。"
        },
        {
          "characters": [],
          "dialogue": [
            {"speaker": "SE", "text": "リリリリリ！！リリリリリ！！"},
            {"speaker": "Narration", "text": "その日――大門建設は『死んだ』。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Wide Shot",
          "visual": "オフィス内。複数の電話が同時に鳴り響く。PC画面は全て真っ黒。社員たちがパニック状態。"
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "ちょっとぉ！！何なのよこれ！！"},
            {"speaker": "Matsuda", "text": "パソコン全部動かないじゃない！！明日給料日なのよ！？"},
            {"speaker": "Matsuda", "text": "50人分の給与振込、どうすんのよ！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "経理部長・松田（50代女性）が電話を2本抱えながら叫んでいる。"
        },
        {
          "characters": ["character:Sato"],
          "dialogue": [
            {"speaker": "Sato", "text": "松田部長！叩いても蹴っても無駄っす！サーバーごと全滅です！"},
            {"speaker": "Sato", "text": "画面見てください…！身代金要求が出てます…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "若手社員・佐藤がPCの画面を指差す。英語の脅迫文が表示されている。"
        },
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "身代金ァ！？うちみたいな会社狙ってどうすんのよ！！"},
            {"speaker": "Matsuda", "text": "安本さんは！？システム担当の安本さんはどこ！？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "松田の焦りに満ちた表情。"
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "落ち着いてください！！"},
            {"speaker": "Shouta", "text": "今、専門家を呼んでます！俺が何とかします！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "大門翔太（26歳）が駆け込んでくる。スーツは乱れ、明らかに寝ていない。"
        },
        {
          "characters": ["character:Matsuda", "character:Shouta"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "翔太くん！社長は！？お父さんは！？"},
            {"speaker": "Shouta", "text": "親父は現場です！戻るまで2時間かかる！"},
            {"speaker": "Shouta", "text": "警察にも通報しました！でも証拠保全で手一杯らしくて…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "翔太と松田。緊迫した空気。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta (Monologue)", "text": "（くそっ…！来週の入札に向けて、全データまとめてたのに…！）"},
            {"speaker": "Shouta (Monologue)", "text": "（30年分の施工実績、顧客情報、全部…！！）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太の目。焦燥と怒りが入り混じる。"
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "――同時刻。東京・世田谷区。"}
          ],
          "environment": "env:ren-office-exterior",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "閑静な住宅街。コンクリート打ちっぱなしのモダンな建物。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "SE", "text": "zzz...zzz..."}
          ],
          "environment": "env:ren-office",
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "薄暗い部屋。複数のモニター。チェアでRenが完全に眠っている。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "レン。起きてください。緊急です。"},
            {"speaker": "Ren", "text": "んー…あと5時間…"},
            {"speaker": "Nei", "text": "報酬、前払いで100万来てます。"},
            {"speaker": "Ren", "text": "…………起きた。"}
          ],
          "environment": "env:ren-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "Neiが呆れ顔。Renの片目がうっすら開く。"
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "大門建設。蒲田の中堅ゼネコン。創業60年。"},
            {"speaker": "Nei", "text": "今朝、全システムがランサムウェアでダウン。"},
            {"speaker": "Ren", "text": "ふーん。で、なんで俺ら？普通のセキュリティ会社で十分でしょ。"}
          ],
          "environment": "env:ren-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Neiがタブレットで説明。Renはコーヒーを淹れている。"
        },
        {
          "characters": ["character:Nei"],
          "dialogue": [
            {"speaker": "Nei", "text": "依頼者曰く、『内部に犯人がいるかもしれない』。"},
            {"speaker": "Nei", "text": "『表沙汰にせず、犯人も特定してほしい』と。"}
          ],
          "environment": "env:ren-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Neiの真剣な表情。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "あー…身内の恥は晒したくない。でも放っておけない。"},
            {"speaker": "Ren", "text": "だから『闇医者』を呼んだってわけだ。"},
            {"speaker": "Ren", "text": "…だりー。でも100万は捨てがたい。行くか。"}
          ],
          "environment": "env:ren-office",
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "Renがフードを被る。眠そうだが、目は鋭い。"
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "characters": ["character:Shouta", "character:Ren"],
          "dialogue": [
            {"speaker": "Narration", "text": "――1時間後。大門建設。"},
            {"speaker": "Shouta", "text": "あなたがRenさん…！？"},
            {"speaker": "Shouta", "text": "え…その…高校生…？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "オフィス入り口。翔太が目を見開く。フード姿のRen。"
        },
        {
          "characters": ["character:Ren", "character:Shouta"],
          "dialogue": [
            {"speaker": "Ren", "text": "17歳。高2。年齢で仕事選ぶなら他当たれば？"},
            {"speaker": "Shouta", "text": "待ってください！！"},
            {"speaker": "Shouta", "text": "すみません…！藁にもすがる思いなんです…！"},
            {"speaker": "Shouta", "text": "お願いします…！うちを助けてください…！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "翔太が深々と頭を下げる。Renは無表情で見下ろす。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren (Monologue)", "text": "（…本気の目だな）"},
            {"speaker": "Ren", "text": "頭上げなよ。みっともない。"},
            {"speaker": "Ren", "text": "Nei、機材。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renの目が一瞬だけ柔らかくなる。"
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Sato"],
          "dialogue": [
            {"speaker": "Ren", "text": "状況。手短に。"},
            {"speaker": "Sato", "text": "は、はい！今朝6時、全端末が起動不能に！"},
            {"speaker": "Sato", "text": "サーバーもアクセス不能！身代金要求の画面だけが…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Renが空いた席に座りノートPCを開く。佐藤が説明。"
        },
        {
          "characters": ["character:Ren", "character:Sato"],
          "dialogue": [
            {"speaker": "Ren", "text": "バックアップは？"},
            {"speaker": "Sato", "text": "…最後が3ヶ月前で…"},
            {"speaker": "Ren", "text": "3ヶ月。なんで？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renの目が細くなる。"
        },
        {
          "characters": ["character:Sato", "character:Shouta"],
          "dialogue": [
            {"speaker": "Sato", "text": "安本さんが…システム担当の安本部長が、『動いてるから大丈夫』って…"},
            {"speaker": "Shouta", "text": "俺も何度も言ったんです！見直そうって！"},
            {"speaker": "Shouta", "text": "でもあの人、いつも『忙しい』『予算がない』って…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "翔太が悔しそうに拳を握る。"
        }
      ]
    },
    {
      "gh:pageNumber": 8,
      "gh:panels": [
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "SE", "text": "ガチャッ"},
            {"speaker": "Yasumoto", "text": "な…何やってるんだ！！"},
            {"speaker": "Yasumoto", "text": "部外者を勝手に入れるな！！私がなんとかする！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "安本部長（50代男性）がオフィスに飛び込む。スーツは乱れ、顔は青白い。"
        },
        {
          "characters": ["character:Shouta", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "Shouta", "text": "安本さん！今までどこに…！何度電話しても…！"},
            {"speaker": "Yasumoto", "text": "う、うるさい！私は30年この会社にいるんだ！"},
            {"speaker": "Yasumoto", "text": "部外者に触らせる権限なんて誰にもない！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "安本が翔太を睨む。額に汗。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "…ふーん。"},
            {"speaker": "Ren (Monologue)", "text": "（この人…何かを隠してる）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renが安本を観察している。その目は鋭い。"
        }
      ]
    },
    {
      "gh:pageNumber": 9,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "Ren", "text": "パッチは2年放置。ファイアウォール設定は初期値のまま。"},
            {"speaker": "Ren", "text": "バックアップは3ヶ月前。アクセス権限の管理もザル。"},
            {"speaker": "Ren", "text": "…30年いて、これ？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Renが画面を見ながら淡々と言う。安本の顔がこわばる。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "だ、黙れ…！お前に何がわかる…！"},
            {"speaker": "Yasumoto", "text": "毎日毎日、予算削減だ人員削減だと言われて…！"},
            {"speaker": "Yasumoto", "text": "一人で全部やってるんだぞ…！誰も手伝わないのに…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "安本が声を荒げる。その目には怒りと…哀しみ。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "レン。見つけました。侵入経路。"},
            {"speaker": "Ren", "text": "…どこから？"},
            {"speaker": "Nei", "text": "総務部長の端末。安本さんのPCです。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "Neiがタブレットを見せる。Renの目が細くなる。"
        }
      ]
    },
    {
      "gh:pageNumber": 10,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "Ren", "text": "…あんたの端末から、ランサムウェアがダウンロードされてる。"},
            {"speaker": "Yasumoto", "text": "っ…！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "安本の顔が凍りつく。"
        },
        {
          "characters": ["character:Matsuda", "character:Sato", "character:Shouta"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "え…？安本さんが犯人ってこと…！？"},
            {"speaker": "Sato", "text": "う、嘘でしょ…！？"},
            {"speaker": "Shouta", "text": "安本さん…！なんで…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Wide Shot",
          "visual": "全員が安本を見つめる。オフィスが凍りつく。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "…………"},
            {"speaker": "Yasumoto", "text": "…そうだよ。俺がやった。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "安本が俯く。その声は震えている。"
        }
      ]
    },
    {
      "gh:pageNumber": 11,
      "gh:panels": [
        {
          "characters": ["character:Shouta", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "Shouta", "text": "なんでだよ…！！なんでこんなこと…！！"},
            {"speaker": "Yasumoto", "text": "…お前にはわからないだろうな、大門の息子には…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "翔太が詰め寄る。安本が睨み返す。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "30年だぞ…！30年、この会社のシステムを俺一人で守ってきたんだ！"},
            {"speaker": "Yasumoto", "text": "なのにお前が来て、『システム刷新だ』『効率化だ』って…！"},
            {"speaker": "Yasumoto", "text": "俺の…俺の居場所を奪おうとしやがって…！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "安本が絶叫。目に涙が浮かんでいる。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "予算もない！人もいない！評価もされない！"},
            {"speaker": "Yasumoto", "text": "それでも『動いてるから大丈夫だろ』って…！"},
            {"speaker": "Yasumoto", "text": "誰も俺のことなんか見てなかった…！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "安本の顔が歪む。怒りと哀しみと絶望が混在。"
        }
      ]
    },
    {
      "gh:pageNumber": 12,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:GhostYasumoto"],
          "dialogue": [
            {"speaker": "Ren (Monologue)", "text": "（…来た）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "POV Shot",
          "visual": "Renの視界が変わる。安本の背後に黒い靄が立ち上り、人型の影が浮かぶ。"
        },
        {
          "characters": ["character:GhostYasumoto"],
          "dialogue": [
            {"speaker": "GhostYasumoto", "text": "俺ノ…居場所ヲ…"},
            {"speaker": "GhostYasumoto", "text": "奪ウナアアア！！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Wide Shot",
          "visual": "安本の体からGhostが分離。古い書類とケーブルが絡まった異形。巨大化していく。"
        },
        {
          "characters": ["character:Shouta", "character:Matsuda", "character:Sato"],
          "dialogue": [
            {"speaker": "Shouta", "text": "な…なんだこれ…！！"},
            {"speaker": "Matsuda", "text": "きゃあああ！！"},
            {"speaker": "Sato", "text": "う、嘘だろ…！？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Wide Shot",
          "visual": "社員たちがパニック。Ghostが天井に届くほど巨大化。"
        }
      ]
    },
    {
      "gh:pageNumber": 13,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Nei"],
          "dialogue": [
            {"speaker": "Nei", "text": "レン！SIP起動しますか！？"},
            {"speaker": "Ren", "text": "やるしかないでしょ。"},
            {"speaker": "Ren", "text": "Nei、SIP起動。物理レイヤーに固定。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "RenとNei。周囲は混乱だが、二人だけが冷静。"
        },
        {
          "characters": ["character:GhostYasumoto", "character:Ren"],
          "dialogue": [
            {"speaker": "GhostYasumoto", "text": "消エロオオオ！！！"},
            {"speaker": "SE", "text": "ドゴォォン！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Action Shot",
          "visual": "GhostがLANケーブルの触手を振り回し、机を吹き飛ばす。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "…遅い。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Action Shot",
          "visual": "Renが軽やかにかわす。手にデジタルな光が集まる。"
        }
      ]
    },
    {
      "gh:pageNumber": 14,
      "gh:panels": [
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "あんたの気持ちはわかる。"},
            {"speaker": "Ren", "text": "30年、一人で頑張ってきた。誰にも評価されなかった。"},
            {"speaker": "Ren", "text": "…でもさ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Renの手に巨大なデジタルの斧が形成される。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "だからって、他の50人を巻き込んでいい理由にはならない。"},
            {"speaker": "Ren", "text": "あんたの『居場所』を守るために、会社を壊すのは違う。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renの目は鋭いが、どこか哀しげ。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "レン！核、見えます！胸部中央！"},
            {"speaker": "Ren", "text": "了解。…終わらせる。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Action Shot",
          "visual": "Renが跳躍。Ghostに向かって突進。"
        }
      ]
    },
    {
      "gh:pageNumber": 15,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:GhostYasumoto"],
          "dialogue": [
            {"speaker": "Ren", "text": "Kill。切る。"},
            {"speaker": "SE", "text": "ZBAAAAAAAN！！！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Full Page Splash",
          "visual": "大ゴマ。一閃。Renの斧がGhostの核を両断。光の爆発。"
