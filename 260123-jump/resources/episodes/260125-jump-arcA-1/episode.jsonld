    {
      "gh:pageNumber": 16,
      "gh:panels": [
        {
          "characters": ["character:GhostYasumoto"],
          "dialogue": [
            {"speaker": "GhostYasumoto", "text": "俺ハ…タダ…認メテ…欲シカッ…タダケ…ダ…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Ghostが霧散。その表情は苦悶と哀しみ。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "う…ううう…"},
            {"speaker": "Yasumoto", "text": "すまん…すまん…みんな…すまん…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "安本が崩れ落ち、涙を流しながら謝る。"
        },
        {
          "characters": ["character:Sato"],
          "dialogue": [
