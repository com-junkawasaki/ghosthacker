    {
      "gh:pageNumber": 14,
      "gh:panels": [
        {
          "characters": ["character:Yasumoto", "character:Ren"],
          "dialogue": [
            {
              "speaker": "Yasumoto",
              "text": "な…！生意気な…！私は30年この会社に…！"
