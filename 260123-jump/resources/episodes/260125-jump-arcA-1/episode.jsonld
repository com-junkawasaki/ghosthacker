    {
      "gh:pageNumber": 25,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Shouta"],
          "dialogue": [
            {
              "speaker": "Shouta",
              "text": "取引…？"
            },
            {
              "speaker": "Ren",
              "text": "データは復旧した。ついでに、安本さんが横領してた金も、隠し口座ハックして戻しておいた。"
            },
            {
              "speaker": "Shouta",
              "text": "横領…！？"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "翔太が驚愕。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "カジノで溶かした穴埋めに、経理をいじってた。"
            },
            {
              "speaker": "Ren",
              "text": "新システム入れたら、それがバレる。だから抵抗してた。"
            },
            {
              "speaker": "Ren",
              "text": "…全部繋がってるんだよ。『怠惰』は。"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renが淡々と説明。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {
              "speaker": "Shouta",
              "text": "…………"
            },
            {
              "speaker": "Shouta",
              "text": "…Renさん。あんたは一体…"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太がRenを見つめる。畏怖と感謝が入り混じる目。"
        }
      ]
    },
    {
      "gh:pageNumber": 26,
      "gh:panels": [
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "Ghost Hacker。"
            },
            {
              "speaker": "Ren",
              "text": "…人間の歪んだ情報が、化け物になることがある。"
            },
            {
              "speaker": "Ren",
              "text": "俺はそいつを『切る』。それだけ。"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Renが背を向けながら言う。"
        },
        {
          "characters": ["character:Ren", "character:Shouta"],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "あとは自分で考えな。安本さんをどうするか、会社をどうするか。"
            },
            {
              "speaker": "Ren",
              "text": "俺の仕事はここまで。"
            },
            {
              "speaker": "Shouta",
              "text": "待ってくれ！"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "Renが出口に向かう。翔太が呼び止める。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {
              "speaker": "Shouta",
              "text": "…ありがとう。あんたのおかげで、俺も目が覚めた。"
            },
            {
              "speaker": "Shouta",
              "text": "これからは…俺がちゃんとやる。会社も、システムも。"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太の目に決意の光。"
        }
      ]
    },
    {
      "gh:pageNumber": 27,
      "gh:panels": [
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "…そ。"
            },
            {
              "speaker": "Ren",
              "text": "でも一つだけ言っとく。"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Renが振り返る。"
        },
        {
          "characters": ["character:Ren", "character:Shouta"],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "社長さんも、あんたも、安本さんも…"
            },
            {
              "speaker": "Ren",
              "text": "みんな『怠惰』だったんだよ。"
            },
            {
              "speaker": "Ren",
              "text": "『動いてるから大丈夫』って、考えることをサボってた。"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renの目が鋭い。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "次は、俺がいなくても自分で考えな。"
            },
            {
              "speaker": "Ren",
              "text": "あんた、怠惰だな。"
            }
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renがニヤリと笑う。挑発的だが、どこか温かみがある。"
        }
      ]
    },
    {
      "gh:pageNumber": 28,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Nei"],
          "dialogue": [
            {
              "speaker": "Nei",
              "text": "お疲れ様でした。今回の報酬、かなりの額ですね。"
            },
            {
              "speaker": "Ren",
              "text": "だりー…帰って寝る…"
            }
          ],
          "environment": "env:kamata-street-evening",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "夕暮れの蒲田。RenとNeiが歩いている。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {
              "speaker": "Nei",
              "text": "でも、今回の件…気になることがあります。"
            },
            {
              "speaker": "Ren",
              "text": "…何？"
            },
            {
              "speaker": "Nei",
              "text": "安本さんがダウンロードしたマルウェア。出所を追ったら…"
            },
            {
              "speaker": "Nei",
              "text": "もっと大きな組織に繋がってました。"
