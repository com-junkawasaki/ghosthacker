  "dct:title": "Arc A-2: 「あんたが怠惰だ」",
  "gh:arc": "Arc A",
  "gh:episode": 3,
  "gh:episodeId": "episode:260125-jump-arcA-2",
  "gh:episodeIndex": 3,
  "gh:industry": "Construction (建設)",
  "gh:mainCharacter": "character:Ren",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "characters": ["character:President", "character:Ren"],
          "dialogue": [
            {"speaker": "President", "text": "…何だと…？"},
            {"speaker": "President", "text": "今、なんと言った…？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Close-up",
          "visual": "社長の顔。怒りで顔が紅潮している。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "聞こえなかった？もう一回言おうか。"},
            {"speaker": "Ren", "text": "社長。あんたが一番、怠惰だって言ったんだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renは一歩も引かない。冷静な目。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "この…！！"},
            {"speaker": "President", "text": "どこの馬の骨とも知れんガキが…！！"},
            {"speaker": "President", "text": "60年この会社を守ってきた俺に向かって…！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "社長が激昂。拳を握りしめる。"
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "characters": ["character:Shouta", "character:President"],
          "dialogue": [
            {"speaker": "Shouta", "text": "親父！落ち着いて！"},
            {"speaker": "President", "text": "黙れ翔太！！"},
            {"speaker": "President", "text": "こんな奴を呼んだのはお前か！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "翔太が社長を止めようとする。社長は息子にも怒りを向ける。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "怒るのは勝手だけどさ。"},
            {"speaker": "Ren", "text": "その前に、一つ見せたいものがあるんだよね。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Renがノートパソコンの画面を操作。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "レン。準備できました。"},
            {"speaker": "Ren", "text": "ありがと。…じゃあ、見せるよ。"},
            {"speaker": "Ren", "text": "この会社の『本当の闇』を。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "NeiとRen。真剣な表情。"
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "復旧作業中に、面白いものを見つけた。"},
            {"speaker": "Ren", "text": "経理システムのログ。過去5年分。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Insert Shot",
          "visual": "画面に経理データが表示されている。"
        },
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "っ…！"},
            {"speaker": "Matsuda (Monologue)", "text": "（なんで経理のログを…！？）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "松田の顔が一瞬引きつる。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "安本さん。あんた、会社の金に手をつけてないよね？"},
            {"speaker": "Yasumoto", "text": "え…？当たり前だ…！俺はそんなこと…！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "安本が困惑。Renは彼を見ていない。別の人物を見ている。"
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Matsuda"],
          "dialogue": [
            {"speaker": "Ren", "text": "だよね。安本さんは金には手を出してない。"},
            {"speaker": "Ren", "text": "…でも、誰かは出してる。"},
            {"speaker": "Ren", "text": "松田さん。経理部長のあなただ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Renが松田を指差す。全員の視線が松田に集中。"
        },
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "な…！何を言ってるの！？"},
            {"speaker": "Matsuda", "text": "私がそんなことするわけないでしょ！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "松田が声を荒げる。しかし目が泳いでいる。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "過去5年間で、約2000万円。"},
            {"speaker": "Ren", "text": "架空の経費精算、存在しない取引先への支払い。"},
            {"speaker": "Ren", "text": "全部、あんたの操作履歴が残ってる。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Insert Shot",
          "visual": "画面に不正送金の履歴が次々と表示される。"
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "characters": ["character:President", "character:Shouta", "character:Sato"],
          "dialogue": [
            {"speaker": "President", "text": "松田…！お前…！！"},
            {"speaker": "Shouta", "text": "2000万…！？"},
            {"speaker": "Sato", "text": "うそだろ…松田部長が…？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "オフィス中が騒然。"
        },
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "ち、違う…！それは…！"},
            {"speaker": "Matsuda", "text": "…………っ"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "松田が言葉に詰まる。逃げ場がない。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "で、ここからが本題。"},
            {"speaker": "Ren", "text": "なんでこの不正が5年も発覚しなかったか、わかる？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "Renが全員を見渡す。"
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "この会社、アクセス権限がめちゃくちゃだ。"},
            {"speaker": "Ren", "text": "経理部長が全データに触れる。総務部長も触れる。"},
            {"speaker": "Ren", "text": "誰が何を見れて、何を変えられるか、全く管理されてない。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "Renが画面を指しながら説明。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "本来なら、経理データは経理だけ。システムはIT担当だけ。"},
            {"speaker": "Ren", "text": "それが『最小権限の原則』ってやつ。"},
            {"speaker": "Ren", "text": "でもこの会社は、『便利だから』で全員がフルアクセス。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renの鋭い目。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "だから松田さんは不正ができた。"},
            {"speaker": "Ren", "text": "そして安本さんは、全部のシステムを一人で見なきゃいけなかった。"},
            {"speaker": "Ren", "text": "組織図に基づいた権限設計が、まるでなかった。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "Renが社長を見据える。"
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:President"],
          "dialogue": [
            {"speaker": "Ren", "text": "社長。これ、誰の責任だと思う？"},
            {"speaker": "President", "text": "…………"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "社長が言葉を失う。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "システムの設計は、経営の責任だ。"},
            {"speaker": "Ren", "text": "誰に何を任せるか。どこまで権限を与えるか。"},
            {"speaker": "Ren", "text": "それを決めるのは、トップの仕事。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renの真剣な表情。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "あんたはそれを全部、現場に丸投げした。"},
            {"speaker": "Ren", "text": "『動いてるから大丈夫』『安本に任せとけ』『松田に任せとけ』。"},
            {"speaker": "Ren", "text": "…それが『怠惰』だって言ってるんだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renの目がギラリと光る。"
        }
      ]
    },
    {
      "gh:pageNumber": 8,
      "gh:panels": [
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…………"},
            {"speaker": "President", "text": "…俺が…俺のせいで…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Close-up",
          "visual": "社長の顔から血の気が引く。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "社長…俺も悪かったんです…"},
            {"speaker": "Yasumoto", "text": "でも…でも、本当に限界だったんです…"},
            {"speaker": "Yasumoto", "text": "誰かに助けを求めたかった…でも、言える空気じゃなかった…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "安本が涙ながらに訴える。"
        },
        {
          "characters": ["character:President", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "President", "text": "安本…すまなかった…"},
            {"speaker": "President", "text": "俺は…お前の苦しみに気づいてやれなかった…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "社長が安本の前で頭を下げる。"
        }
      ]
    },
    {
      "gh:pageNumber": 9,
      "gh:panels": [
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "…………"},
            {"speaker": "Matsuda", "text": "…もういいわ。"},
            {"speaker": "Matsuda", "text": "そうよ。私がやったわ。2000万、使い込んだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "松田が観念したように言う。"
        },
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "20年もこの会社で働いて…給料はろくに上がらない。"},
            {"speaker": "Matsuda", "text": "残業代も出ない。ボーナスはカット。"},
            {"speaker": "Matsuda", "text": "でも『家族だから』で我慢しろって…バカにしてるわ！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "松田の顔に怒りと悲しみ。"
        },
        {
          "characters": ["character:Matsuda", "character:Ren"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "この会社は、人を大事にしてこなかった。"},
            {"speaker": "Matsuda", "text": "だから私も、会社を大事にしなかった。それだけよ。"},
            {"speaker": "Ren (Monologue)", "text": "（…また、同じだ）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "松田とRen。Renの表情は複雑。"
        }
      ]
    },
    {
      "gh:pageNumber": 10,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:GhostMatsuda"],
          "dialogue": [
            {"speaker": "Ren (Monologue)", "text": "（来る…もう一体）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "POV Shot",
          "visual": "Renの視界。松田の背後に黒い靄が立ち上る。"
        },
        {
          "characters": ["character:GhostMatsuda"],
          "dialogue": [
            {"speaker": "GhostMatsuda", "text": "誰モ…私ヲ…見テクレナカッタ…"},
            {"speaker": "GhostMatsuda", "text": "ダカラ…私モ…見ナイ…！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Wide Shot",
          "visual": "松田からGhostが分離。札束と帳簿が絡まった異形。安本のGhostとは違う形状。"
        },
        {
          "characters": ["character:Shouta", "character:Sato"],
          "dialogue": [
            {"speaker": "Shouta", "text": "また…！！"},
            {"speaker": "Sato", "text": "まだいたのかよ…！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "翔太と佐藤が驚愕。"
        }
      ]
    },
    {
      "gh:pageNumber": 11,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Nei"],
          "dialogue": [
            {"speaker": "Nei", "text": "レン！同時に二体は…！"},
            {"speaker": "Ren", "text": "わかってる。でも、これで最後だ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "RenとNei。緊迫した表情。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "この会社の『怠惰』が生んだGhostは、二体。"},
            {"speaker": "Ren", "text": "安本さんの『認められたい』。松田さんの『報われたい』。"},
            {"speaker": "Ren", "text": "…どっちも、見てもらえなかった苦しみだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renの手に再びデジタルの斧が形成される。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "Nei、SIP出力最大。一気に終わらせる。"},
            {"speaker": "Nei", "text": "了解。出力120%。いけます。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Action Shot",
          "visual": "Renが跳躍。光が弾ける。"
        }
      ]
    },
    {
      "gh:pageNumber": 12,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:GhostMatsuda"],
          "dialogue": [
            {"speaker": "Ren", "text": "あんたの怒りはわかる。"},
            {"speaker": "Ren", "text": "でも、金を盗んでも何も変わらない。"},
            {"speaker": "Ren", "text": "…終わりだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Action Shot",
          "visual": "Renが松田のGhostに斬りかかる。"
        },
        {
          "characters": ["character:Ren", "character:GhostMatsuda"],
          "dialogue": [
            {"speaker": "SE", "text": "SLASH！！"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Full Page Splash",
          "visual": "大ゴマ。一閃。松田のGhostが両断される。札束が紙吹雪のように舞い散る。"
        }
      ]
    },
    {
      "gh:pageNumber": 13,
      "gh:panels": [
        {
          "characters": ["character:GhostMatsuda"],
          "dialogue": [
            {"speaker": "GhostMatsuda", "text": "誰カ…気ヅイテ…ホシカッタダケ…ナノニ…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "松田のGhostが霧散。哀しげな表情。"
        },
        {
          "characters": ["character:Matsuda"],
          "dialogue": [
            {"speaker": "Matsuda", "text": "…………"},
            {"speaker": "Matsuda", "text": "…私…何やってたんだろう…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "松田が崩れ落ちる。虚ろな目。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "…………"},
            {"speaker": "Ren (Monologue)", "text": "（Ghostを斬っても、根本は変わらない）"},
            {"speaker": "Ren (Monologue)", "text": "（変わるのは…人間だ）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renの目。どこか哀しげ。"
        }
      ]
    },
    {
      "gh:pageNumber": 14,
      "gh:panels": [
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…………"},
            {"speaker": "President", "text": "…俺は、とんでもない過ちを犯していたんだな…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "社長が椅子に座り込む。老いて見える。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "『動いてるから大丈夫』…それが俺の口癖だった。"},
            {"speaker": "President", "text": "でも本当は、『考えたくなかった』だけだ。"},
            {"speaker": "President", "text": "面倒なことは全部、現場に押し付けてた…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "社長の目に涙が浮かぶ。"
        },
        {
          "characters": ["character:Shouta", "character:President"],
          "dialogue": [
            {"speaker": "Shouta", "text": "親父…"},
            {"speaker": "President", "text": "翔太。お前は正しかった。"},
            {"speaker": "President", "text": "システムを変えようとしたお前を、俺は邪魔してた…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "社長が翔太の方を向く。"
        }
      ]
    },
    {
      "gh:pageNumber": 15,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:President"],
          "dialogue": [
            {"speaker": "Ren", "text": "社長さん。"},
            {"speaker": "President", "text": "…なんだ。まだ説教か。"},
            {"speaker": "Ren", "text": "いや。一つだけ言っておく。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Renが社長に歩み寄る。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "さっき『怠惰』って言ったけど、あんたは一つだけ怠けてなかった。"},
            {"speaker": "President", "text": "…何？"},
            {"speaker": "Ren", "text": "『家族を守りたい』って気持ちは本物だろ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renが珍しく柔らかい表情。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "その気持ちがあるなら、まだやり直せる。"},
            {"speaker": "Ren", "text": "…今度は『気持ち』だけじゃなく、『仕組み』で守ればいい。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renの目。鋭いが、温かみがある。"
        }
      ]
    },
    {
      "gh:pageNumber": 16,
      "gh:panels": [
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…仕組み、か。"},
            {"speaker": "President", "text": "…そうだな。今まで、俺はそれを避けてきた。"},
            {"speaker": "President", "text": "『面倒だ』『金がかかる』『今のままでいい』…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Close-up",
          "visual": "社長が自分を振り返る。"
        },
        {
          "characters": ["character:President", "character:Shouta"],
          "dialogue": [
            {"speaker": "President", "text": "翔太。"},
            {"speaker": "Shouta", "text": "…何、親父。"},
            {"speaker": "President", "text": "…任せていいか。この会社の『仕組み』作り、お前に。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "社長が翔太を真っ直ぐ見る。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "…………"},
            {"speaker": "Shouta", "text": "…任された。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太の目に決意の光。"
        }
      ]
    },
    {
      "gh:pageNumber": 17,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Nei"],
          "dialogue": [
            {"speaker": "Nei", "text": "…これでいいんですか、レン。"},
            {"speaker": "Ren", "text": "何が？"},
            {"speaker": "Nei", "text": "松田さんの不正、2000万。警察には…？"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "RenとNeiが小声で話す。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "それは社長たちが決めること。俺の仕事じゃない。"},
            {"speaker": "Ren", "text": "…ま、証拠は全部渡してあるから、好きにすればいい。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renが肩をすくめる。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "俺たちの仕事は終わり。"},
            {"speaker": "Ren", "text": "…だりー。帰って寝る。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "Renが出口に向かう。"
        }
      ]
    },
    {
      "gh:pageNumber": 18,
      "gh:panels": [
        {
          "characters": ["character:Shouta", "character:Ren"],
          "dialogue": [
            {"speaker": "Shouta", "text": "Renさん！"},
            {"speaker": "Ren", "text": "ん？"},
            {"speaker": "Shouta", "text": "…ありがとうございました。本当に。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "翔太がRenに頭を下げる。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "俺…今日、目が覚めました。"},
            {"speaker": "Shouta", "text": "システムを変えるだけじゃダメだ。人を見なきゃいけなかった。"},
            {"speaker": "Shouta", "text": "安本さんも、松田さんも…俺は何も見えてなかった。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "翔太の真剣な表情。"
        },
        {
          "characters": ["character:Ren", "character:Shouta"],
          "dialogue": [
            {"speaker": "Ren", "text": "…そ。じゃ、頑張って。"},
            {"speaker": "Shouta", "text": "え…それだけ？"},
            {"speaker": "Ren", "text": "それだけ。俺は寝たいんで。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "Renがあくびをしながら背を向ける。翔太が拍子抜け。"
        }
      ]
    },
    {
      "gh:pageNumber": 19,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Nei"],
          "dialogue": [
            {"speaker": "Nei", "text": "お疲れ様でした。今回は大変でしたね。"},
            {"speaker": "Ren", "text": "うん。Ghostが二体は久しぶりだった。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "夕暮れの蒲田。RenとNeiが歩いている。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "でも、根本的な原因は同じでしたね。"},
            {"speaker": "Nei", "text": "『見てもらえなかった』『認めてもらえなかった』…"},
            {"speaker": "Ren", "text": "…そうだね。結局、人の問題だ。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "二人で歩きながら話す。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "システムは道具でしかない。使う人間が歪んでたら、道具も歪む。"},
            {"speaker": "Ren", "text": "…でも、道具の設計が悪かったら、人も歪みやすくなる。"},
            {"speaker": "Ren", "text": "両方が大事なんだよ、本当は。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renの横顔。夕日に照らされている。"
        }
      ]
    },
    {
      "gh:pageNumber": 20,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "Ghostは斬れた。"}
          ],
          "environment": "env:tokyo-skyline-evening",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "東京の夕景。ビル群のシルエット。"
        },
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "でも、本当の戦いはこれからだ。"}
          ],
          "environment": "env:tokyo-skyline-evening",
          "panel": 2,
          "shot": "Wide Shot",
          "visual": "夕日が沈んでいく。"
        },
        {
