  "dct:title": "Arc A-3: 「仕組みで守れ」",
  "gh:arc": "Arc A",
  "gh:episode": 4,
  "gh:episodeId": "episode:260125-jump-arcA-3",
  "gh:episodeIndex": 4,
  "gh:industry": "Construction (建設)",
  "gh:mainCharacter": "character:Shouta",
  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "characters": ["character:Ren", "character:Nei"],
          "dialogue": [
            {"speaker": "Narration", "text": "――RenとNeiが去った後。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "夕暮れの蒲田。RenとNeiの後ろ姿が遠ざかる。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "今回は大変でしたね。Ghost二体は久しぶりでした。"},
            {"speaker": "Ren", "text": "うん。でも、根っこは同じだった。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "二人で歩きながら話す。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "『見てもらえなかった』『認めてもらえなかった』…"},
            {"speaker": "Ren", "text": "安本さんも松田さんも、同じ苦しみだった。"},
            {"speaker": "Ren", "text": "でも、選んだ道が違った。それだけだ。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 3,
          "shot": "Close-up",
          "visual": "Renの横顔。夕日に照らされる。"
        }
      ]
    },
    {
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "安本さんは温情で済みましたけど…松田さんは逮捕。"},
            {"speaker": "Nei", "text": "同じ原因なのに、この差は…なんか、複雑ですね。"},
            {"speaker": "Ren", "text": "…そうだな。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "Neiが少し沈んだ表情。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "でも、盗んだ金は戻らない。"},
            {"speaker": "Ren", "text": "被害者がいる以上、責任は取らなきゃいけない。"},
            {"speaker": "Ren", "text": "…それが、社会ってやつだ。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 2,
          "shot": "Close-up",
          "visual": "Renの真剣な表情。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "Ren", "text": "俺たちにできるのは、Ghostを斬ること。"},
            {"speaker": "Ren", "text": "その後のことは、人間が決める。"},
            {"speaker": "Ren", "text": "…だりー。帰って寝よ。"}
          ],
          "environment": "env:kamata-street-evening",
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "Renがあくびをしながら歩く。"
        }
      ]
    },
    {
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "――同時刻。大門建設。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "夕暮れのオフィス。まだ数人が残っている。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "…………"},
            {"speaker": "Shouta (Monologue)", "text": "（俺は、何をすべきなんだ…）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "翔太が机に向かっている。真剣な表情。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta (Monologue)", "text": "（Renさんは言った。『仕組みを作れ』と）"},
            {"speaker": "Shouta (Monologue)", "text": "（気持ちだけじゃダメ。仕組みで守らなきゃいけない）"},
            {"speaker": "Shouta (Monologue)", "text": "（…具体的に、何をすればいい？）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太がパソコンに向かう。"
        }
      ]
    },
    {
      "gh:pageNumber": 4,
      "gh:panels": [
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "…よし。"},
            {"speaker": "Shouta", "text": "まずは、現状の整理からだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Medium Shot",
          "visual": "翔太がホワイトボードに向かう。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "問題点。一つ、アクセス権限が管理されてない。"},
            {"speaker": "Shouta", "text": "二つ、システム担当が安本さん一人だった。"},
            {"speaker": "Shouta", "text": "三つ、バックアップ体制がなかった。"},
            {"speaker": "Shouta", "text": "四つ、経理のチェック体制がなかった。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Insert Shot",
          "visual": "ホワイトボードに書き出された問題点。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "…これを全部、『仕組み』で防ぐ。"},
            {"speaker": "Shouta", "text": "規定を作る。マニュアルを作る。チェック体制を作る。"},
            {"speaker": "Shouta", "text": "誰が何をするか、明確にする。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太の決意に満ちた目。"
        }
      ]
    },
    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "characters": ["character:President", "character:Shouta"],
          "dialogue": [
            {"speaker": "President", "text": "翔太。まだ残ってたのか。"},
            {"speaker": "Shouta", "text": "親父。…ちょっと、考えることがあって。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "社長が戻ってくる。翔太を見つける。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…そうか。"},
            {"speaker": "President", "text": "俺も、考えてた。今日のこと。"},
            {"speaker": "President", "text": "あのガキ…Renって子に言われたこと。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "社長が遠くを見る目。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "『怠惰』か。確かにその通りだった。"},
            {"speaker": "President", "text": "俺は、考えることを避けてきた。"},
            {"speaker": "President", "text": "『動いてるから大丈夫』で、全部逃げてた。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "社長の自省の表情。"
        }
      ]
    },
    {
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "characters": ["character:Shouta", "character:President"],
          "dialogue": [
            {"speaker": "Shouta", "text": "親父。俺、規定を作ろうと思う。"},
            {"speaker": "President", "text": "規定？"},
            {"speaker": "Shouta", "text": "うん。情報セキュリティ規定、経理規定、職務分掌規定…"},
            {"speaker": "Shouta", "text": "『誰が何をするか』を、全部文書にする。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "翔太がホワイトボードを指しながら説明。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…大変な作業だな。うちみたいな中小企業で、そこまで…"},
            {"speaker": "Shouta", "text": "だからこそ必要なんだ、親父。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "社長が難色を示す。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "大企業は人数が多いから、自然とチェックが働く。"},
            {"speaker": "Shouta", "text": "でもうちは50人だ。一人に任せきりになりやすい。"},
            {"speaker": "Shouta", "text": "だから『仕組み』で補わないと、また同じことが起きる。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太の真剣な表情。"
        }
      ]
    },
    {
      "gh:pageNumber": 7,
      "gh:panels": [
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "…………"},
            {"speaker": "President", "text": "…わかった。やれ、翔太。"},
            {"speaker": "President", "text": "俺も協力する。今度こそ、逃げない。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Close-up",
          "visual": "社長が頷く。決意の表情。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "…ありがとう、親父。"},
            {"speaker": "Shouta", "text": "一緒に、この会社を作り直そう。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "父と子が向き合う。"
        },
        {
          "characters": ["character:Yasumoto"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "…俺も、手伝わせてください。"},
            {"speaker": "Yasumoto", "text": "30年、システムやってきた経験、役立てたい。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Medium Shot",
          "visual": "安本がオフィスの隅から声をかける。"
        }
      ]
    },
    {
      "gh:pageNumber": 8,
      "gh:panels": [
        {
          "characters": ["character:Shouta", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "Shouta", "text": "安本さん…！"},
            {"speaker": "Yasumoto", "text": "俺が一番、この会社のシステムの弱点を知ってる。"},
            {"speaker": "Yasumoto", "text": "…だから、俺が直す。今度こそ、ちゃんとやる。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "安本が翔太に歩み寄る。"
        },
        {
          "characters": ["character:President", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "President", "text": "安本…すまなかった。お前の力、借りたい。"},
            {"speaker": "Yasumoto", "text": "社長…俺こそ、すみませんでした。"},
            {"speaker": "Yasumoto", "text": "今度は…ちゃんと話します。困ったら、相談します。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Two Shot",
          "visual": "社長と安本が握手。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "よし。じゃあ、始めよう。"},
            {"speaker": "Shouta", "text": "大門建設の、新しい『仕組み』作りを。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太が笑顔で宣言。"
        }
      ]
    },
    {
      "gh:pageNumber": 9,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "――2週間後。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "大門建設オフィス。以前より整理されている。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "ふぅ…やっと形になってきた…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "翔太が机に向かっている。目の下にクマ。"
        },
        {
          "characters": [],
          "dialogue": [],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Wide Shot",
          "visual": "翔太の机の上には大量のファイルが積まれている。"
        }
      ]
    },
    {
      "gh:pageNumber": 10,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "『情報セキュリティ基本規定』"},
            {"speaker": "Narration", "text": "『アクセス権限管理規定』"},
            {"speaker": "Narration", "text": "『バックアップ運用規定』"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Insert Shot",
          "visual": "ファイルの背表紙が映る。きちんとラベリングされている。"
        },
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "『経理業務規定』"},
            {"speaker": "Narration", "text": "『内部統制規定』"},
            {"speaker": "Narration", "text": "『職務分掌規定』"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Insert Shot",
          "visual": "さらに積まれたファイル。"
        },
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "『インシデント対応マニュアル』"},
            {"speaker": "Narration", "text": "『システム運用手順書』"},
            {"speaker": "Narration", "text": "『人事評価制度規定』"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Insert Shot",
          "visual": "机の上に山のように積まれた規定類。"
        }
      ]
    },
    {
      "gh:pageNumber": 11,
      "gh:panels": [
        {
          "characters": ["character:Sato", "character:Shouta"],
          "dialogue": [
            {"speaker": "Sato", "text": "翔太さん…これ、全部作ったんすか…？"},
            {"speaker": "Shouta", "text": "まあ…安本さんにも手伝ってもらったけど。"},
            {"speaker": "Sato", "text": "すげえ…何冊あるんすか…"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "佐藤が驚愕の表情で規定類を見つめる。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "12冊。でも、これで終わりじゃない。"},
            {"speaker": "Shouta", "text": "運用して、問題があれば直す。継続的に改善していく。"},
            {"speaker": "Shouta", "text": "『仕組み』は作って終わりじゃない。育てていくものだ。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "翔太の疲れているが充実した表情。"
        },
        {
          "characters": ["character:Yasumoto", "character:Shouta"],
          "dialogue": [
            {"speaker": "Yasumoto", "text": "翔太くん。アクセス権限の設定、終わったぞ。"},
            {"speaker": "Shouta", "text": "ありがとうございます、安本さん。"},
            {"speaker": "Yasumoto", "text": "これで、経理データは経理しか触れない。俺も触れなくなった。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "安本がノートパソコンを持ってくる。"
        }
      ]
    },
    {
      "gh:pageNumber": 12,
      "gh:panels": [
        {
          "characters": ["character:Shouta", "character:Yasumoto"],
          "dialogue": [
            {"speaker": "Shouta", "text": "『最小権限の原則』ですね。"},
            {"speaker": "Yasumoto", "text": "ああ。必要な人に、必要な権限だけ。"},
            {"speaker": "Yasumoto", "text": "これなら、俺一人で全部やらなくていい。楽になった。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Two Shot",
          "visual": "翔太と安本が笑顔で話す。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "翔太、安本。ご苦労だな。"},
            {"speaker": "President", "text": "…見てたぞ。お前たちの頑張り。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "社長がコーヒーを持って入ってくる。"
        },
        {
          "characters": ["character:President"],
          "dialogue": [
            {"speaker": "President", "text": "俺も、変わらなきゃな。"},
            {"speaker": "President", "text": "『動いてるから大丈夫』は、もう言わない。"},
            {"speaker": "President", "text": "毎月、ちゃんと報告会やろう。俺も出る。"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "社長の真剣な表情。"
        }
      ]
    },
    {
      "gh:pageNumber": 13,
      "gh:panels": [
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta", "text": "…ありがとう、親父。"},
            {"speaker": "Shouta (Monologue)", "text": "（Renさんが言ってたこと、少しわかった気がする）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 1,
          "shot": "Close-up",
          "visual": "翔太の穏やかな表情。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta (Monologue)", "text": "（『仕組み』は、人を縛るものじゃない）"},
            {"speaker": "Shouta (Monologue)", "text": "（人を守るものだ）"},
            {"speaker": "Shouta (Monologue)", "text": "（安本さんみたいに追い詰められる人を、作らないために）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 2,
          "shot": "Close-up",
          "visual": "翔太が規定類を見つめる。"
        },
        {
          "characters": ["character:Shouta"],
          "dialogue": [
            {"speaker": "Shouta (Monologue)", "text": "（松田さんみたいに犯罪に走る人を、作らないために）"},
            {"speaker": "Shouta (Monologue)", "text": "（『仕組み』で、人を守る）"},
            {"speaker": "Shouta (Monologue)", "text": "（…これが、俺のやるべきことだ）"}
          ],
          "environment": "env:kamata-daimon-office",
          "panel": 3,
          "shot": "Close-up",
          "visual": "翔太の決意に満ちた目。"
        }
      ]
    },
    {
      "gh:pageNumber": 14,
      "gh:panels": [
        {
          "characters": [],
          "dialogue": [
            {"speaker": "Narration", "text": "――同時刻。東京・世田谷区。"}
          ],
          "environment": "env:ren-office",
          "panel": 1,
          "shot": "Wide Shot",
          "visual": "Renの拠点。モニターの光だけが灯っている。"
        },
        {
          "characters": ["character:Ren"],
          "dialogue": [
            {"speaker": "SE", "text": "zzz...zzz..."}
          ],
          "environment": "env:ren-office",
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Renがソファで爆睡している。"
        },
        {
          "characters": ["character:Nei", "character:Ren"],
          "dialogue": [
            {"speaker": "Nei", "text": "レン。大門建設から連絡が来てます。"},
            {"speaker": "Ren", "text": "んー…なに…"},
            {"speaker": "Nei", "text": "『規定類が完成した。礼を言いたい』と。"}
          ],
          "environment": "env:ren-office",
          "panel": 3,
          "shot": "Two Shot",
          "visual": "Neiがタブレットを見せる。Renが薄目を開ける。"
