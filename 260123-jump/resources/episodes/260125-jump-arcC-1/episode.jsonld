            {
              "speaker": "Narration",
              "text": "規程は守った。…でも、守った“だけ”だった。"
            },
            {
              "speaker": "Kaname (Offscreen)",
              "text": "監査不合格。会議も不合格。"
            }
          ],
          "environment": "env:finance-hq",
