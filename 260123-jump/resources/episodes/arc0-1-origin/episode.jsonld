      "gh:pov": "Ren",
      "gh:script": [
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "集中した目で",
          "gh:text": "俺がハックするのは——『常識（呪い）』という、情報（言葉）だ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "きっかけを作ったのは、お前。そこは、認めろ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "だが ——"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "悪口を書いたのは、お前じゃない"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "それを、晒したのも、お前じゃない"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "Sakiを、直接、傷つけた責任は、お前じゃ、ない"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Daemon",
          "gh:text": "う、うるさいっ！！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "お前は、犯人の道具に、されたんだ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "責任の、中身を、取り違えるな！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "斧を水平に突き出し。声を、安全第一テープの外側のクラスメイト全員に、向けて",
          "gh:text": "——お前らも、聞け"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "罵ったお前らも、被害者だ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "Yutoを、責めても、何も終わらない"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "次の被害者が、また、同じ流れで、潰されるだけだ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "怒りは、アクターに"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "——俺とNeiは、7年、それを、知ってる"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "悪いのは、アクターだ"
        },
        {
          "gh:type": "insert",
          "gh:text": "Yutoを縛る鎖のような言葉『全部あんたのせいだ』"
        },
        {
          "gh:type": "narration",
          "gh:text": "Ren、NULL AXEを、振り上げる。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "——/dev/null SLASH!!"
        },
        {
          "gh:type": "narration",
          "gh:text": "一閃。Daemonそのものではなく、呪いの言葉が、シャノンの文字列になって、砕け散った。Yutoを縛っていた鎖が、断ち切られる。Daemonが、ふっと、消え始める。"
        }
      ],
      "gh:pageNote": "視点: Ren"
    },
