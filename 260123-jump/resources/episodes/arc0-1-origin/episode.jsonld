      "gh:pov": "Yuto",
      "gh:script": [
        {
          "gh:type": "narration",
          "gh:text": "翌朝、C中学校3年B組。Yutoが教室に入った瞬間、空気が凍った。30人の目が、彼を、一斉に、見る。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Akira",
          "gh:text": "おい、昨日の夜、お前のリンク、何だよ！？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "え、リンク……？"
        },
        {
          "gh:type": "screen",
          "gh:text": "Neli（Yuto名義・友達全員宛に一斉送信）：『みんな見て！限定スニーカー、半額で譲ってる神サイト、見つけた！このリンクから → [怪しいURL]』"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Akira",
          "gh:text": "俺も、クラスの半分も、お前からの通知で、このリンク、送られてきたんだよ！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "そんな、俺、送ってない……！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Akira",
          "gh:text": "でも、お前のアカウントから来てんだよ！"
        },
        {
          "gh:type": "narration",
          "gh:text": "そこへ、Meiが、青ざめた顔で前に出てきた。震えている。目は下を向いている。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Mei",
          "gh:text": "……私、リンク、踏んじゃって……"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "え……"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Mei",
          "gh:text": "私の鍵付きアカウント、全部……公開に、なってる"
        },
        {
          "gh:type": "narration",
          "gh:text": "Meiがスマホを差し出す。画面には、Meiの鍵付きだったSNSの投稿が、全件、公開の設定で晒されていた。"
        }
      ],
