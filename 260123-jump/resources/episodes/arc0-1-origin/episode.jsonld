          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:emotion": "淡々と",
          "gh:text": "Daemonも倒せたね"
        },
        {
          "gh:type": "narration",
          "gh:text": "Yutoは、立ち上がって、深く、頭を下げた。クラスメイトに、向かって。"
        },
