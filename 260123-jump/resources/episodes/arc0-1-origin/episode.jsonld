      "gh:pov": "Nei / Ren / Yuto",
      "gh:script": [
        {
          "gh:type": "narration",
          "gh:text": "Neiはタブレットで、パスワードマネージャのアプリを開く。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "パスワードマネージャーを使う"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "い、いや。なんかよくわかんなくて、使っていないけど。携帯変えたら消えるの嫌だし。。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "大丈夫。端末を変えても、引き継がれる。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "そうだったんだ..."
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "これを使って自分でパスワードを覚えない。機械に任せる"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "……それ、ズルじゃない？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "机に頬杖",
          "gh:text": "ズルじゃない"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "人間の記憶力で、覚える方が、ムリがある。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "そのためのパスワードマネージャーだ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "……"
        },
        {
          "gh:type": "narration",
          "gh:text": "Yutoが、自分のスマホで、Neli / Margasnit / V / ゲーム、全サイトで切り替える。教室の隅で15分。完了。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "机から、目だけ動かして",
          "gh:text": "——通った"
        }
      ],
      "gh:pageNote": "視点: Nei / Ren / Yuto"
