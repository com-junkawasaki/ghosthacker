      "gh:pov": "Ren",
      "gh:script": [
        {
          "gh:type": "dialogue",
          "gh:speaker": "Saki",
          "gh:emotion": "まだ怒って",
          "gh:text": "謝っても、許されないよ……！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:emotion": "怯えず、正面から",
          "gh:text": "うん。悪かった"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "でも——俺の不注意と、Meiの愚痴と、それを晒したアクターは、別の話だ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "俺が背負うのは、1つだけ。リンクを広めた、不注意"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Saki",
          "gh:text": "……"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Mei",
          "gh:text": "私も……ごめん"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Akira",
          "gh:text": "俺も、お前のアカウント乗っ取りのこと、責めすぎた"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "壁にNULL AXEを立てかけ、欠伸しながら",
          "gh:text": "本当に悪いやつは、偽サイトを仕事にしてる奴らだ。1人に背負わすな"
        },
        {
          "gh:type": "narration",
          "gh:text": "クラスに、少しずつ、空気が、戻る。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "Yuto, おまえの端末に残ってるアクターの情報、ログをもらってもいいか？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "え、うん。もちろん、いいけど、、"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "ありがとう"
        },
        {
          "gh:type": "narration",
          "gh:text": "情報場の残響の中で、Renは、Daemonの残滓から、アクターの痕跡を、すくい上げていった。"
        },
        {
          "gh:type": "evidence-list",
          "gh:items": [
            "詐欺サイトのロゴファイル（メタデータ込み・作成者署名）",
            "C2通信の暗号トンネルのhash断片",
            "Bot制御APIの署名フォーマット",
            "運用時間帯（UTC+7基準のシフト）"
          ]
        },
        {
          "gh:type": "narration",
          "gh:text": "Renは、それを、nueに、1行で、投げた。"
        },
        {
          "gh:type": "dm",
          "gh:speaker": "Ren → nue",
          "gh:text": "ログ、4種、投げる。7年前、と、同じ系統に、見える。確認してくれ。"
        },
        {
          "gh:type": "narration",
          "gh:text": "5秒。nueから、即返信。"
        },
        {
          "gh:type": "dm",
          "gh:speaker": "nue → Ren",
          "gh:text": "受信。……hash、完全一致。7年前の、father caseの、同じファミリー。"
        },
        {
          "gh:type": "dm",
          "gh:speaker": "nue → Ren",
          "gh:text": "俺の側、いま動く。FBI IC3と、Interpol Cybercrime Directoratに、エスカレートする。"
        },
        {
          "gh:type": "dm",
          "gh:speaker": "nue → Ren",
          "gh:text": "君は、そのまま、教室で、寝てろ。後で、共有する。"
        },
        {
          "gh:type": "dm",
          "gh:speaker": "nue → Ren",
          "gh:text": "——追えるかもしれないな、犯人に。7年ぶりに。"
        },
        {
          "gh:type": "narration",
          "gh:text": "Renの瞳が、もう一度、銀色に、光った。ほんの1mm、口の端が、上がった。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "小声、自分に",
          "gh:text": "……動いた"
        },
        {
          "gh:type": "scene-change",
          "gh:text": "—— その頃、バンコクの雑居ビルの一室 ——"
        },
        {
          "gh:type": "panel",
          "gh:text": "中東系の若い男、ディスプレイ、ティーカップを取り落とす"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "black0awdOperator",
          "gh:text": "——え、なんで、落ちた……？"
        },
        {
          "gh:type": "screen",
          "gh:text": "active_accounts: 1件減"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "black0awdOperator",
          "gh:text": "……いや、まだ、823件、動いてる……大丈夫"
        },
        {
          "gh:type": "narration",
          "gh:text": "——だが、画面の端で、別のアラートが、静かに点滅していた。"
        },
        {
          "gh:type": "alert",
          "gh:text": "【Inbound probe / Source: nue (US) — Honeypot triggered】"
        },
