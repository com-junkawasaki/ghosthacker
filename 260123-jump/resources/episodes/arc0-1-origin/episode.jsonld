      "gh:pov": "Nei",
      "gh:script": [
        {
          "gh:type": "narration",
          "gh:text": "Neiは自分のタブレットをYutoの机に置き、Have I Been Pwnedのサイトを見せた。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "ここに、藤崎くんのメールアドレス、入れてください"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "え、入れていいの？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "大丈夫です。自分のアドレスを、自分で調べるサイトです"
        },
        {
          "gh:type": "screen",
          "gh:text": "（入力）→ 4件の漏洩履歴。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "藤崎くんのアドレス、4サービスで、過去に漏れています"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "……え"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "今回の詐欺が初めてじゃないです。今回が、トドメです"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "……"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "同じパスワード、使い回してましたよね"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "……うん……"
        }
      ],
      "gh:neiPuniColumn": "パスワード再利用が、一番よく見る被害原因です。1つ漏れると、全部漏れる構造です",
