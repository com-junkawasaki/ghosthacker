        {
          "@id": "panel:2mrA5tJNiAzQ",
          "characters": [
            "character:RenMiddleSchool",
            "character:NeiMiddleSchool"
          ],
          "dialogue": [
            {
              "speaker": "Ren",
              "text": "父さんのロックも、計算で開けようとしてた",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "——間違ってた",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "父さんは、情報と人を、同じものとして、扱えって、書いてた",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "人の感情も、情報だ。情報も、人の感情と、同じように扱う",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "同じベクトルに揃った人々のネットワークに加わるたびに、計算能力が、指数関数的に増える",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "人々のベクトルを揃えるたびに、難易度が、下がる",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "努力、友情、勝利",
              "type": "dialogue"
            },
            {
              "speaker": "Nei",
              "text": "ジャンプ三原則",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "父さんが、方程式化してた、やつだ",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "個々の努力で、仲間と整列して、計算的に勝つ",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "——ゴーストハッカーの、戦闘原理だ",
              "type": "dialogue"
            },
            {
              "speaker": "Ren",
              "text": "1件ずつ、ベクトルを、揃えてくと、父さんの、犯人まで、繋がるし、父さんが残したパスワードロックも、開く",
              "type": "dialogue"
            }
