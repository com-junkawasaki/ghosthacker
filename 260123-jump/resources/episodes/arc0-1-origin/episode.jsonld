      "gh:pov": "Nei / Ren",
      "gh:script": [
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:emotion": "淡々と、Akiraに",
          "gh:text": "あれはNULL AXE。情報を、物質化した斧だから、物理的には当たりません"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Akira",
          "gh:text": "い、いや、見た目、めっちゃ斧なんだけど……！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "情報的には、斧。物理的には、ほぼゼロ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Saki",
          "gh:text": "……意味わかんない"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "NULL AXEを構えながら、低く",
          "gh:text": "Nei、ちょっとでかいのが、来るかも"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "隔離プロセスできるか"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "はい"
        },
        {
          "gh:type": "narration",
          "gh:text": "Neiは、おもむろに、カバンから、「安全第一、キープアウト」と書かれた黄色いテープを取り出した。"
