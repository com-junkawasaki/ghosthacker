              "gh:type": "dialogue"
            }
          ]
        }
      ],
      "gh:pov": "Ren",
      "gh:script": [
        {
          "gh:type": "narration",
          "gh:text": "世界が、反転した。教室の黒板、窓、机、クラスメイトの姿が、黒と青のワイヤーフレームに変容し、現実と二重に見える。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "クラスメイト",
          "gh:text": "な、なに!? VR!?"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Mei",
          "gh:text": "うわっ、何これ……！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Akira",
          "gh:text": "なんだ、教室がデジタルに……！"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Saki",
          "gh:text": "きゃー！オバケ！"
        },
        {
          "gh:type": "narration",
          "gh:text": "空中に、グロテスクな黒い塊が、いくつも、浮かんでいる。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "あれ……？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:emotion": "淡々と、解説モード",
          "gh:text": "これは情報空間コンピューティング。空間に情報空間を投影したもの。イメージが、質量に変換された世界。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "特に生命の感情、想い、思考から生まれたものをゴースト、霊と定義している"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "悪意の形、、だな"
        },
        {
          "gh:type": "narration",
          "gh:text": "——その時、Renの目が、1つの塊で、止まった。Yutoの背中の塊の表面で、詐欺サイトのロゴが、ちらりと、浮かんで、消えた。配色。アイコンの傾き。影の付け方。Renの瞳が、銀色に、光った。"
        },
        {
          "gh:type": "monologue",
          "gh:speaker": "Ren",
          "gh:text": "——このロゴ。7年前、父さんのプロジェクトを潰した、あのランサムウェアの、ロックスクリーンに、出てた、マーク。配色。アイコンの傾き。影の付け方。——同じ作者の、署名だ。7年経って、同じアクターが、まだ、稼働してる。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "小声、Neiにだけ",
          "gh:text": "Nei"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "ん"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "——あいつらに繋がってる"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "うん。知ってた"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "いつから"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "昨日、藤崎くんのスマートフォンで"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "……そうか"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:emotion": "淡々",
          "gh:text": ""
        }
      ],
      "gh:pageNote": "視点: Ren"
    },
