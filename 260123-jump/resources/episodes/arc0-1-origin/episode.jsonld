      "gh:pov": "Yuto / Nei / Ren",
      "gh:script": [
        {
          "gh:type": "narration",
          "gh:text": "Yutoの胸の内側で、何か、重いものが、脈を打った。"
        },
        {
          "gh:type": "sfx",
          "gh:text": "ドクン。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:emotion": "胸を押さえて",
          "gh:text": "……痛い"
        },
        {
          "gh:type": "narration",
          "gh:text": "周囲は、誰も、気づかない。窓際の蓮の席に、Neiが、いつの間にか、立っていた。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "ゴースト…"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:emotion": "小声、寝ているRenに",
          "gh:text": "ねぇ、レン"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "寝ながら、目だけ開けて",
          "gh:text": "ん"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "レンのお父さんの研究、覚えている？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "もちろん。「情報は物理量」ランダウアーの原理を量子コンピューターに応用する研究だ。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "パパが、Holon Deviceに搭載できたんだって。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "一瞬の間",
          "gh:text": "白瀬博士が？Holon Deviceに？"
        },
        {
          "gh:type": "narration",
          "gh:text": "Renが驚きの表情をみせる。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "うん。それでこれ、パパがレンくんにって"
        },
        {
          "gh:type": "narration",
          "gh:text": "Neiが小型のデバイスをレンにおもむろに渡す。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "博士から、、これはなんなんだ？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "Spirit in Physics"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "情報に「質量」を持たせる"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "父さんの研究テーマ..."
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "ベータ版だって"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "ベータ版(開発者向け)か、、"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "なんで、いまコレを？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "パパがね、レンくんならこれで”ゴースト”もハックできるだろうって"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "ゴーストハック、、情報場をハックするか。"
