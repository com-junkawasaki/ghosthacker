      "gh:pov": "Nei / Ren",
      "gh:script": [
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "次"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "はい"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "パスワードは何文字以上が安全だと思う？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "えっ、8文字とか...?"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "8文字だと..., 1日だな"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "な、何が？"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "パスワードが解析されるのが"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "ええっ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "最低でも12文字、16文字以上じゃないと、すぐに解析されてしまうよ"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "サイトごとに違う、16文字以上のランダムなパスワードを使うようにしよう"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "そんなの絶対に覚えられないよ..."
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "パスワードは、覚えるな"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Yuto",
          "gh:text": "……え"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Nei",
          "gh:text": "自分でパスワードを覚えない。機械に任せる"
        }
      ],
