      "gh:panels": [
        {
          "@id": "panel:oFLWR9TcfBWC",
          "characters": [
            "character:Ren",
            "character:Nei"
          ],
          "dialogue": [
            {
              "speaker": "Saki",
              "text": "いくら？",
              "type": "dialogue"
            },
            {
              "speaker": "Akira",
              "text": "定価2万5千。転売だと5万超えてた",
              "type": "dialogue"
            },
            {
              "speaker": "Mei",
              "text": "お年玉、吹っ飛んだ？",
              "type": "dialogue"
            },
            {
              "speaker": "Akira",
              "text": "来年の分も前借り",
              "type": "dialogue"
            },
            {
              "speaker": "Akira",
              "text": "Yutoも欲しいんだろ？顔に書いてあるぞ",
              "type": "dialogue"
            },
            {
              "speaker": "Yuto",
              "text": "え、いや、まぁ……カッコいいなって……",
              "type": "dialogue"
            },
            {
              "speaker": "Yuto",
              "text": "……2万5千、か。お年玉、貯めれば……",
              "type": "monologue"
            },
            {
              "speaker": "Mei",
              "text": "ねぇ、Akiraさあ、本当はスニーカーより、アレ欲しいんでしょ?",
              "type": "dialogue"
            },
            {
              "speaker": "Akira",
              "text": "アレ?",
              "type": "dialogue"
            },
            {
              "speaker": "Mei",
              "text": "Holonium Vision",
              "type": "dialogue"
            },
            {
              "speaker": "Saki",
              "text": "あー、現実空間でゲームができるやつ?",
              "type": "dialogue"
            },
            {
              "speaker": "Akira",
              "text": "うっ……バレた。本命はそっち",
              "type": "dialogue"
            },
            {
              "speaker": "Mei",
              "text": "でも、まだ市販されてないでしょ?",
              "type": "dialogue"
            },
            {
              "speaker": "Akira",
              "text": "来年、コンシューマ版出るって噂。100万らしい",
              "type": "dialogue"
            },
            {
              "speaker": "Saki",
              "text": "100万!? 高っ",
              "type": "dialogue"
            },
            {
              "speaker": "Akira",
              "text": "だってめちゃくちゃリアルな仮想世界で遊べるんだぞ。論文には10年前から書いてあるけど、実物が見られるのは、俺たちが最初の世代だ",
              "type": "dialogue"
            },
            {
              "speaker": "Mei",
              "text": "Akira、そういう熱意だけは、本物だよね……",
              "type": "dialogue"
            },
            {
              "speaker": "Saki",
              "text": "ニュースで見た。情報物理応用研究所の試作機、まだ世界に数台って",
              "type": "dialogue"
            },
            {
              "speaker": "Yuto",
              "text": "Holonium Vision、聞いたことはある。Ghost — 空間コンピューティング、現実に情報空間——を、目に見える形にする装置、らしい。学校の理科の先生も、「あと数年で、世界が変わる」と言っていた。——でも、実物は、見たことがない。",
              "type": "monologue"
            },
            {
              "speaker": "Ren",
              "text": "……ねむい",
              "type": "dialogue"
            }
          ],
