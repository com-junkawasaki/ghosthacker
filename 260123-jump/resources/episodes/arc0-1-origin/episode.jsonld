      "gh:pov": "Ren",
      "gh:script": [
        {
          "gh:type": "dialogue",
          "gh:speaker": "Daemon",
          "gh:emotion": "Yutoの歪んだ顔、絶望と怒りで",
          "gh:text": "今更、遅い！ 何をしてもやったものはどうにもならない！！"
        },
        {
          "gh:type": "narration",
          "gh:text": "Daemonの波が、Renに、襲いかかる。Ren、吹き飛ばされる。膝を、片膝つく。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Daemon",
          "gh:text": "だろ!? お前は、一生、許されない——"
        },
        {
          "gh:type": "narration",
          "gh:text": "Ren、ゆっくりと、立ち上がる。"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "静かに、しかし、力強く",
          "gh:text": "——そうだな"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:text": "やったものは、元に戻せない"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Daemon",
          "gh:text": "——"
        },
        {
          "gh:type": "dialogue",
          "gh:speaker": "Ren",
          "gh:emotion": "NULL AXEを、構えながら",
          "gh:text": "だがな——"
        }
      ],
      "gh:pageNote": "視点: Ren"
