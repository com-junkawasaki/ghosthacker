  "gh:mainCharacter": "character:Ren",
  "gh:organization": "org:KounanMiddleSchool",
  "gh:timeframe": "3年前（2023年春）",
  "gh:setting": "港南第一中学校 2年B組",
  "gh:realCase": "Phishing / Account Takeover",
  "gh:nistFocus": [
    "PR.AA (Identity Management)",
    "PR.AC (Access Control)",
    "PR.DS (Data Security)"
  ],
