  "gh:supportCharacters": ["character:Ren", "character:Nei", "character:Mei", "character:Yuto"],
  "gh:nistFocus": [
    "PR.DS (Data Security)",
    "PR.AC (Access Control)",
    "ID.RA (Risk Assessment)"
  ],
