  "gh:presentationTagline": "Arc 0 | Digital Footprint & Privacy",
  "gh:realCase": "SNS位置特定事件 / アイドルストーカー事件(2019)",
  "gh:securityLesson": {
    "gh:topic": "デジタルフットプリントとプライバシー保護",
    "gh:keyPoints": [
      "写真の背景から位置が特定される危険性",
      "Exifメタデータに含まれる位置情報",
      "SNS投稿パターンから行動が分析される",
      "公開範囲設定の重要性",
      "過去の投稿も危険な情報源になる"
    ],
    "gh:countermeasures": [
      "写真投稿前の背景チェック",
      "メタデータ削除設定",
      "位置情報タグの無効化",
      "公開範囲を友達のみに設定",
      "定期的な過去投稿の見直し"
    ]
  },
  "gh:ghostDescription": {
    "gh:name": "承認欲求の亡霊 (Ghost of Validation)",
    "gh:appearance": "無数の「いいね」「ハート」「フォロワー数」が渦巻く人型の影。顔は常に見る人の欲しがる反応を映し出す鏡になっている。",
    "gh:symbolism": "SNSでの承認欲求が肥大化し、プライバシーを犠牲にしてまで「見られたい」「認められたい」という欲望の具現化。",
    "gh:weakness": "本当の自分を認識し、数字に依存しない自己肯定感を得ることで力を失う。"
  }
}
