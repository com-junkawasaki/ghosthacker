[{:gh/arc "Arc B", :gh/slug "KojimaLogistics", :gh/incidentReport "{:id \"incident:260125-jump-SupplyChain\", :dct/date \"2026-11-25\", :dct/title \"サプライチェーン攻撃によるライン停止\", :gh/ghost #:gh{:form \"秒針の刃が首元に迫る時計の怪物\", :name \"始業の鐘\", :origin \"締切のプレッシャーが物理化\"}, :gh/impact \"トヨタ系サプライチェーン全体への波及リスク。数十億円規模の損害可能性。\", :gh/rootCause \"リスク計算を放棄した『短気』な判断。場当たり的VPN接続と証拠を消す再起動指示。\", :gh/symptoms [\"VPN経由での不正アクセス検知\" \"在庫管理システムのデータ改ざん\" \"コンベヤ制御システムへの横展開\" \"『始業の鐘』に間に合わせようとした場当たり的再起動が被害拡大\"]}", :schema/employeeCount 320, :gh/atmosphere "24時間稼働の物流センター。始業の鐘が絶対。遅延は死活問題。現場は『急げ』の空気が支配。VPNで本社・工場と接続しているが、セキュリティよりスピード優先。", :gh/organizationChart "#:gh{:description \"典型的な日本の物流会社。現場と本社の温度差が大きい。\", :levels [#:gh{:level 1, :positions [#:gh{:characterId \"character:KojimaYuzo\", :name \"小島 雄三 (Yuzo Kojima)\", :title \"代表取締役社長\"} #:gh{:characterId \"character:MiuraMasato\", :name \"三浦 正人 (Masato Miura)\", :title \"専務取締役（営業統括）\"}], :title \"経営層\"} #:gh{:level 2, :positions [#:gh{:characterId \"character:YamashitaTsuyoshi\", :title \"物流本部長\"} #:gh{:characterId \"character:TamuraSeiichi\", :title \"情報システム部長\"}], :title \"部長クラス\"} #:gh{:level 3, :positions [#:gh{:characterId \"character:SasakiKenta\", :title \"川崎センター長\"} #:gh{:characterId \"character:EndoRisa\", :title \"システム運用チーフ\"}], :title \"現場リーダー\"}]}", :gh/type "gh:CompanyProfile", :schema/foundingDate "1978", :schema/name "小島ロジスティクス株式会社 (Kojima Logistics Co., Ltd.)", :gh/id "company:2hwbkQ7QZVVOmyEzUsmOE", :gh/businessType "自動車部品物流（トヨタ系サプライチェーンの一次下請け）", :db/id -1, :gh/keyCharacters "[{:id \"character:YamashitaTsuyoshi\", :gh/role \"物流本部長 / クライアント\", :gh/sourceFile \"characters/YamashitaTsuyoshi/profile.jsonld\"} {:id \"character:TamuraSeiichi\", :gh/role \"情報システム部長 / 内部協力者\", :gh/sourceFile \"characters/TamuraSeiichi/profile.jsonld\"} {:id \"character:SasakiKenta\", :gh/role \"川崎センター長 / 現場代表\", :gh/sourceFile \"characters/SasakiKenta/profile.jsonld\"} {:id \"character:EndoRisa\", :gh/role \"システム運用チーフ / 技術サポート\", :gh/sourceFile \"characters/EndoR