  "@id": "family:Mizuki",
  "@type": "gh:FamilyProfile",
  "schema:name": "水城家 (Mizuki Family)",
  "dct:title": "水城家 - 金融界の影の実力者",
  "gh:description": "表向きは没落した旧華族。だが金融・法曹界に広がる人脈と情報網を持つ。Kanameのおじさんが現当主として、一族の復興を静かに進めている。",

  "gh:history": {
    "gh:origin": "明治期に財閥系銀行の創業に関わった旧華族",
    "gh:decline": "戦後の財閥解体で表舞台から退く",
    "gh:present": "金融・法曹界に広がる人脈で影響力を維持",
    "gh:goal": "一族の復興と金融界での地位回復"
  },

  "gh:members": [
    {
      "@id": "character:MizukiShinji",
      "gh:sourceFile": "characters/MizukiShinji/profile.jsonld",
      "gh:familyPosition": "現当主（Kanameの叔父）",
      "gh:role": "影の支援者 / フィクサー"
    },
    {
      "@id": "character:Kaname",
      "gh:sourceFile": "characters/Kaname/profile.jsonld",
      "gh:familyPosition": "本家の長男",
      "gh:role": "一族の期待を背負う / 主人公"
    }
  ],

  "gh:familyDynamic": {
    "gh:shinjiKanameRelation": {
      "gh:type": "叔父・甥",
      "gh:history": "Kanameの両親は事故で他界。慎司が後見人的立場。",
      "gh:currentState": "Kanameは叔父の知性を尊敬しつつも、その計算高さに違和感を感じることも。",
      "gh:tension": "正義 vs 一族の利益"
    }
  },

  "gh:storyFunction": {
    "gh:arcC": {
      "gh:introduction": "慎司おじさんが『親戚の優秀な若者』としてKanameを東海証券に紹介。",
      "gh:surfaceMotivation": "甥の才能を活かして企業を助ける",
      "gh:hiddenMotivation": "水城家の金融界での影響力拡大"
    },
    "gh:futurePlot": {
      "gh:foreshadowing": "Arc Dで明かされる水城家の過去と、慎司の真の目的",
      "gh:conflict": "Kanameの正義感と一族の野望の衝突"
    }
  }
}
