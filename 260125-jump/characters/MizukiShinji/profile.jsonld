  },

  "gh:personality": {
    "gh:public": "気弱そうな中年男性。丸眼鏡、やや猫背、地味なグレーのスーツ。誰もが侮る風貌。",
    "gh:private": "金融業界の不正、業界の闇、組織構造の問題を熟知。一族のポジションを高めるため、戦略的にKanameを活用。だがKanameへの愛情は本物。",
    "gh:speech": "「いやぁ、僕なんかが口出しすることじゃないんですが…」と謙遜しながら、核心を突く。",
    "gh:intellect": "法律、会計、IT、組織論のすべてに精通。表に出ない参謀タイプ。"
  },

  "gh:relationships": {
    "gh:kaname": {
      "gh:type": "甥（兄の息子）",
      "gh:role": "後見人的立場",
      "gh:dynamic": "才能を見出し、金融業界の案件を紹介。戦略的だが愛情も本物。"
    }
  },

  "gh:storyFunction": {
    "gh:role": "Kanameを企業に紹介するフィクサー。表向きは『親戚の紹介』だが、実際は一族の戦略の一環。",
    "gh:dialoguePartner": "Kanameと知的な会話を交わし、金融業界の構造的問題を解説する役割。",
    "gh:futurePlot": "一族の野望と、Kanameの正義感の間で、将来的に葛藤が生まれる伏線。"
  }
}
