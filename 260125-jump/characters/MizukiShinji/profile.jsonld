  "gh:appearance": {
    "gh:face": "52-year-old Japanese male, seemingly timid and unassuming expression, round glasses, slightly hunched posture. Behind the mild exterior, sharp intelligent eyes that notice everything.",
    "gh:hair": "Thinning black hair with gray streaks, neatly combed but unremarkable.",
    "gh:build": "Slim, average height, forgettable presence. Wears plain gray suits that blend in.",
    "gh:eyes": "Behind round glasses, dark intelligent eyes with subtle sharp catchlights. Eyes that see through deception.",
    "gh:style": "Photorealistic, understated elegance, bureaucratic aesthetic, 8k.",
    "gh:generationPrompt": "photorealistic, 8k, highly detailed skin texture, cinematic lighting, raw photo, 52-year-old Japanese male, seemingly timid expression, round glasses, thinning gray-streaked hair, plain gray suit, hunched posture but sharp intelligent eyes behind glasses, natural office lighting."
