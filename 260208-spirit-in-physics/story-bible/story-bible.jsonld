{
  "@context": {
    "@base": "https://ghosthacker.gftd.ai/spirit-in-physics/",
    "schema": "https://schema.org/",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "name": { "@id": "schema:name", "@type": "xsd:string" },
    "description": { "@id": "schema:description", "@type": "xsd:string" },
    "alternateName": { "@id": "schema:alternateName", "@type": "xsd:string" },
    "dateCreated": { "@id": "schema:dateCreated", "@type": "xsd:string" },
    "inLanguage": { "@id": "schema:inLanguage", "@type": "xsd:string" },
    "genre": { "@id": "schema:genre", "@type": "xsd:string" },
    "about": { "@id": "schema:about" },
    "hasPart": { "@id": "schema:hasPart", "@type": "@id" },
    "isPartOf": { "@id": "schema:isPartOf", "@type": "@id" },
    "position": { "@id": "schema:position", "@type": "xsd:integer" },
    "Season": "gh:Season",
    "Volume": "gh:Volume",
    "Chapter": "gh:Chapter",
    "Character": "gh:Character",
    "WorldEvent": "gh:WorldEvent",
    "Theme": "gh:Theme",
