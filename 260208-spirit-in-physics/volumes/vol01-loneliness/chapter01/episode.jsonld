      "marginalia": [
        { "@type": "Philosophy", "en": "Buber + Levinas. The face of the Other. Anti-Havah moment.", "ja": "ブーバー＋レヴィナス。他者の顔。アンチ・ハヴァの瞬間。" }
      ],
