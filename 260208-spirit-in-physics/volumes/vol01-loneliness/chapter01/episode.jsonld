    {
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "characters": [
            "character:logos"
          ],
          "dialogue": [
            {
              "speaker": "Logos",
              "text": "主は……Elias"
            }
          ],
          "panel": 1,
          "shot": "Close-up",
          "visual": "Logosの唇。「主は……Elias」と名を告げる瞬間。"
        },
        {
          "characters": [
            "character:tamaki"
          ],
          "dialogue": [
            {
              "speaker": "Narration",
              "text": "名が与えられた瞬間、世界は少し輪郭を得る。私はうなずき、簡潔に手順を確認する。聞く／整える／潜る。"
            }
          ],
          "panel": 2,
          "shot": "Medium Wide Shot",
          "visual": "名が与えられた瞬間、部屋の空気が微かに変わる。輪郭が少しだけ明確になる。"
        },
        {
          "characters": [
            "character:nei"
          ],
          "dialogue": [
            {
              "speaker": "Nei-chan",
              "text": "彼のghostは、肉体の死とgeneの断絶を極端に恐れている。それが彼のバグの核心みたい"
            }
          ],
          "panel": 3,
          "shot": "Close-up",
          "visual": "Nei-chanの分析。精神の声として浮遊テキスト。"
        }
      ]
    },
