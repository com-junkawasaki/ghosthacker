        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": { "en": "Kaede taps her tablet, pulling up a spec sheet. Professional, efficient.", "ja": "楓がタブレットを叩き、スペックシートを出す。プロフェッショナル、効率的。" },
          "gh:dialogue": [
            { "gh:speaker": "Kaede", "en": "Run the diagnostics first. Spec sheet is here. Any issues, flag them before activation.", "ja": "まず診断を走らせて。スペックシートはここ。問題があれば起動前に報告。" }
          ]
