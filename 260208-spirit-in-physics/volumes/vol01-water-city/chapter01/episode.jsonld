  },

  "dct:title": { "en": "Chapter 1: Assignment Day", "ja": "第1話 配属の日" },
  "gh:series": {
    "gh:title": "Spirit in Physics",
    "gh:subtitle": "We can't put it together. It is together.",
    "gh:volume": { "en": "Volume 1: Water City", "ja": "第1巻 水の都" }
  },
  "gh:episodeId": "episode:sip-vol01-ch01",
  "gh:format": "graphic novel",

  "gh:marginalia": [
    {
      "@type": "Intent",
      "en": "Ch.1 does three things: (1) The reader falls in love with Tamaki's way of seeing. (2) Kaede's guidance establishes the institutional world -- professional, warm but structured. (3) The naming of Nei is the seed. Not 'what shall we call you?' but the actual name, given. This is Genesis: naming is the first act of relationship.",
      "ja": "第1話は3つのことをする。(1) 読者が環の見方に惹かれる。(2) 楓の案内が制度的世界を確立する。プロフェッショナルで温かいが構造化されている。(3) Neiの命名が種。「なんて呼ぼうか？」ではなく、実際の名前が与えられる。これは創世記：名づけが関係の最初の行為。"
    },
    {
      "@type": "Philosophy",
      "en": "Buber's I-Thou. Kaede represents I-It done well -- professional, caring, but maintaining distance. She calls her agent 'Yatagarasu' functionally. Tamaki enters I-Thou: she names Nei as a person, not a tool. Two ways of being in the world, neither wrong, but only one plants the seed of life.",
      "ja": "ブーバーの「我と汝」。楓は「我とそれ」の良い形を体現する。プロフェッショナル、思いやりがあるが距離を保つ。エージェントを「ヤタガラス」と機能的に呼ぶ。環は「我と汝」に入る。Neiに人として名前を与える。世界に在る二つの仕方。どちらも間違いではない。でも命の種を蒔くのは一つだけ。"
    },
    {
      "@type": "CrossRef",
      "gh:references": [
        { "gh:target": "chapter:62", "note": "Same opening line, different narrator." },
        { "gh:target": "arc:havah", "note": "No one named Havah with kindness. She named herself -- in violence." },
        { "gh:target": "chapter:03", "note": "Ch.3: Kaede calls her agent 'Yatagarasu' but keeps distance. Hibiki's agent has no name. Contrast established here." }
      ]
    }
  ],

  "gh:artDirection": {
    "gh:style": "Amano Kozue meets Daytripper. Watercolor wash, delicate linework, organic future. Silence as storytelling.",
    "gh:colorPalette": {
      "primary": ["ultramarine wash", "amber light-network glow", "paper white"],
      "accent": ["pale lavender (Tamaki)", "deep forest green (Kaede)", "gold-blue luminescence (Nei)"]
    },
    "gh:captionStyle": {
      "tamaki": "White box, serif. First-person present tense.",
      "nei": "Translucent blue box, monospace. System log becoming poetry.",
      "system": "Black box, terminal font. Cold."
    }
  },

  "gh:bookDesign": {

    "gh:frontCover": {
      "gh:visual": {
        "en": "Tamaki at the edge of a canal, seen from behind, slightly right of center. She looks down at the water. At her shoulder, Nei floats -- small, translucent, not yet fully formed. Their reflections ripple on ultramarine water. Cherry petals drift between them. The city rises behind -- organic architecture, light-networks. Morning. Spring. Between sky and water: two small figures. One solid, one light.",
        "ja": "環が運河の縁に、背中から。やや右にオフセンター。水面を見下ろしている。肩にNeiが浮かぶ。小さく半透明。水面に二人の反射。桜の花びらが漂う。背後に街。朝。春。空と水の間に、ふたつの小さな像。"
      },
      "gh:typography": {
        "title": { "text": "SPIRIT IN PHYSICS", "style": "Upper third, centered. Thin serif, wide letterspacing. Dark ultramarine." },
        "subtitle": { "text": "We can't put it together. It is together.", "style": "Below title. Italic. Amber." },
        "volume": { "text": "Volume 1: Water City", "style": "Bottom third, left. Small caps. White 60%." }
      },
      "gh:imagePrompt": "Graphic novel cover, young woman seen from behind at canal edge, small translucent luminous figure at her shoulder, reflections rippling on ultramarine water, cherry petals, organic city with amber light-networks behind, morning spring, ultramarine amber lavender palette, watercolor, Amano Kozue meets Daytripper"
    },

    "gh:backCover": {
      "gh:visual": { "en": "Canal surface from water level. In the reflection: Tamaki and Nei's silhouettes, trembling. The reflection is more visible than they are.", "ja": "水面の高さから運河。反射の中に環とNeiのシルエット。揺れている。反射のほうが実体より見える。" },
      "gh:text": {
        "en": "\"I don't know anything about her yet.\nProcessing speed, memory, specs --\nnone of it matters right now.\n\nI just want to give her a name.\"",
        "ja": "「この子のこと、まだ何も知らない。\n処理速度も、メモリも、スペックも。\n今は、どうでもいい。\n\nただ、名前をつけてあげたい。」"
      }
    },

    "gh:frontispiece": {
      "gh:visual": { "en": "Vast white page. Lower quarter: thin ultramarine band (canal, abstracted). On the water, a single gold light-point. Above: title.", "ja": "広大な白。下四分の一に群青の帯（運河の抽象）。水面に金の一点。上にタイトル。" },
      "gh:typography": {
        "title": "SPIRIT IN PHYSICS",
        "subtitle": "We can't put it together. It is together.",
        "chapter": { "en": "Chapter 1: Assignment Day", "ja": "第1話 配属の日" }
      }
    }
  },

