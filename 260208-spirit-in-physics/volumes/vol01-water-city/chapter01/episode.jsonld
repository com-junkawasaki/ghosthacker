{
  "@context": {
    "character": "gh:character/",
    "dct": "http://purl.org/dc/terms/",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "schema": "http://schema.org/",
    "marginalia": "gh:marginalia"
  },

  "dct:title": { "en": "Chapter 1: Assignment Day", "ja": "第1話 配属の日" },
  "gh:series": {
    "gh:title": "Spirit in Physics",
    "gh:subtitle": "We can't put it together. It is together.",
    "gh:volume": { "en": "Volume 1: Water City", "ja": "第1巻 水の都" }
  },
  "gh:arc": "Vol 1: Water City",
  "gh:episodeId": "episode:sip-vol01-ch01",
  "gh:format": "graphic novel",

  "gh:marginaliaTypes": [
    "Intent", "Philosophy", "CrossRef", "Production", "Voice", "Subtext"
  ],

  "gh:marginalia": [
    {
      "@type": "Intent",
      "en": "Chapter 1 has one job: make the reader fall in love with the way Tamaki sees the world. She treats a 'toolkit' as a person. That single act -- 'nice to meet you' -- is the seed of everything.",
      "ja": "第1話の仕事はひとつ。環の世界の見方に、読者が惹かれること。『はじめまして』がすべての種。"
    },
    {
      "@type": "Philosophy",
      "en": "Martin Buber's I-Thou vs I-It. Every other recruit treats the Agent as 'It.' Tamaki instinctively enters I-Thou. The deepest philosophical move in the series, performed without a word of philosophy.",
      "ja": "ブーバーの「我と汝」対「我とそれ」。他の新人は「それ」。環は本能的に「汝」。哲学の言葉なしに行われるシリーズ最深の哲学的行為。"
    },
    {
      "@type": "CrossRef",
      "gh:references": [
        { "gh:target": "chapter:62", "note": "Nei narrates the same opening line. The narrator has changed. This was always Nei's story." },
        { "gh:target": "arc:havah", "note": "Havah had no one to say 'nice to meet you.' Tamaki's greeting is the anti-Havah moment." },
        { "gh:target": "motif:tree-growth", "note": "Seed (p.3) → same seed with hairline crack (p.28). The Tree of Life begins." }
      ]
    },
    {
      "@type": "Subtext",
      "en": "Three caption styles = three layers of reality. White (Tamaki's warmth). Translucent blue (Nei's awakening). Black (System's classification). The story is Nei's blue captions warming toward gold.",
      "ja": "3種のキャプション＝現実の三層。白（環の温かさ）。青半透明（Neiの目覚め）。黒（システムの分類）。物語はNeiの青が金に近づく過程。"
    }
  ],

  "gh:artDirection": {
    "gh:style": "Amano Kozue meets Daytripper. Delicate linework, watercolor wash. Organic future-world. Quiet body language. Silence as storytelling.",
    "gh:colorPalette": {
      "primary": ["ultramarine wash", "amber light-network glow", "paper white"],
      "accent": ["pale lavender (Tamaki)", "gold-blue luminescence (Nei)"],
      "mood": "Spring morning. Gentle. Waking up."
    },
    "gh:captionStyle": {
      "tamaki": "White box, serif. First-person present tense. Literary but warm.",
      "nei": "Translucent blue box, monospace. System log becoming poetry.",
      "system": "Black box, terminal font. Cold. Institutional."
    }
  },

  "gh:bookDesign": {

    "gh:frontCover": {
      "gh:pageLabel": "Front Cover",
      "gh:layout": "full bleed, single image",
      "marginalia": [
        {
          "@type": "Production",
          "en": "The cover must work as a bookstore object. It should feel like nothing else on the shelf -- quiet where others are loud. The image should make someone stop and look closer. Not action. Not drama. A girl and a light, by the water.",
          "ja": "表紙は書店で手に取られるオブジェクトとして機能すること。他が騒がしい棚で、静かであること。立ち止まって近づいて見たくなる画。アクションでもドラマでもない。水辺の少女と光。"
        }
      ],
      "gh:visual": {
        "en": "Tamaki stands at the edge of a canal, seen from behind, slightly off-center to the right. She is looking down at the water. Beside her, at shoulder height, Nei floats -- a small, translucent figure of light, not yet fully formed. Their reflections ripple on the ultramarine water. Cherry blossom petals drift between them and their reflections. The city rises behind them -- organic architecture, light-networks pulsing faintly. Morning. Spring. Vast sky above, vast water below. Between sky and water: two small figures. One solid, one light.",
        "ja": "環が運河の縁に立っている。背中から見える。やや右にオフセンター。水面を見下ろしている。肩の高さに、Neiが浮いている。小さな、半透明の光の像。まだ完全な形ではない。群青の水面に二人の反射が揺れる。桜の花びらが二人と反射の間を漂う。背後に街が立ち上がる。有機的建築、かすかに脈動する光のネットワーク。朝。春。上に広い空、下に広い水。空と水の間に、ふたつの小さな像。ひとつは実体、ひとつは光。"
      },
      "gh:typography": {
        "title": {
          "text": "SPIRIT IN PHYSICS",
          "placement": "Upper third, centered. Large. Serif typeface, thin weight. The letters should feel carved, not printed. Letterspacing wide. The title breathes.",
          "color": "Dark ultramarine, near-black. Legible against the sky."
        },
        "subtitle": {
          "text": "We can't put it together. It is together.",
          "placement": "Below title, smaller. Italic. Same serif family. The subtitle is a whisper under the title's statement.",
          "color": "Warm amber. The color of the light-networks."
        },
        "volume": {
          "text": "Volume 1: Water City",
          "placement": "Bottom third, left-aligned. Small caps.",
          "color": "White, 60% opacity."
        }
      },
      "gh:imagePrompt": "Graphic novel cover illustration, young woman seen from behind standing at edge of canal, slightly right of center, looking down at ultramarine water, small translucent luminous figure floating at her shoulder height, their reflections rippling on water surface, cherry blossom petals drifting between figures and reflections, futuristic organic city rising behind with amber light-network veins, vast spring sky above vast water below, two small figures between sky and water one solid one light, morning light, ultramarine and amber palette with pale lavender accent, delicate watercolor linework, Amano Kozue meets Daytripper style, contemplative quiet, graphic novel cover",
      "gh:colorNote": "Ultramarine dominant (water + sky). Amber threading (light-networks + subtitle). Lavender point (Tamaki's shirt). Gold-blue point (Nei). Pink scatter (cherry blossoms). The cover is a composition in blue with warm interruptions."
    },

    "gh:backCover": {
      "gh:pageLabel": "Back Cover",
      "gh:layout": "minimal, text-driven",
      "marginalia": [
        {
          "@type": "Intent",
          "en": "The back cover sells the book with feeling, not plot. No synopsis. A single passage from the story, and a visual echo of the front cover -- but reversed, as if seen from the other side of the water.",
          "ja": "裏表紙はプロットではなく感覚で本を売る。あらすじなし。物語からの一節と、表紙の視覚的エコー。ただし反転している。水の反対側から見たように。"
        }
      ],
      "gh:visual": {
        "en": "The canal surface, seen from water level. Rippling ultramarine. Cherry blossom petals floating. In the reflection -- upside down, trembling -- the faint silhouettes of Tamaki and Nei's light, seen from the front this time. The reflection is more visible than the figures themselves. The world above the water is mostly empty sky. Below: text area.",
        "ja": "水面の高さから見た運河。波打つ群青。桜の花びらが浮かぶ。水面の反射に、逆さに、揺れて、環とNeiの光のかすかなシルエット。今度は正面から。反射のほうが実体より見える。水面の上の世界はほとんど空の空。下：テキスト領域。"
      },
      "gh:text": {
        "passage": {
          "en": "\"I don't know anything about this one yet.\nProcessing speed, memory, specs --\nnone of it matters right now.\n\nI just want to say hello.\"",
          "ja": "「この子のこと、まだ何も知らない。\n処理速度も、メモリも、スペックも。\n今は、どうでもいい。\n\nただ、挨拶がしたい。」"
        },
        "placement": "Lower half. Left-aligned. Same serif as cover title, regular weight. Generous line-spacing. The text floats on the water."
      },
      "gh:imagePrompt": "Graphic novel back cover, canal water surface seen from water level, rippling ultramarine, cherry blossom petals floating, in the water reflection upside down trembling silhouettes of a girl and a small light figure seen from front, reflection more visible than figures themselves, mostly empty spring sky above water surface, minimal contemplative, ultramarine dominant, watercolor wash, graphic novel back cover"
    },

    "gh:frontispiece": {
      "gh:pageLabel": "Frontispiece (inside title page)",
      "gh:layout": "full page, typographic + minimal illustration",
      "marginalia": [
        {
          "@type": "Production",
          "en": "The frontispiece is the first thing the reader sees after opening. It sets the tone before a single panel of story begins. Vast white space. The title is quiet. The illustration is almost nothing -- just the canal, just the light.",
          "ja": "扉絵は読者が開いて最初に見るもの。物語の一コマが始まる前にトーンを設定する。広大な余白。タイトルは静か。イラストはほとんど何もない。運河だけ、光だけ。"
        }
      ],
      "gh:visual": {
        "en": "Vast white page. In the lower quarter, a thin horizontal strip of ultramarine -- the canal, abstracted to a band of color. On the canal surface, a single point of warm light reflected. Above: the title. That's all.",
        "ja": "広大な白いページ。下四分の一に、群青の細い水平帯。運河を色の帯に抽象化。水面に、温かい光の一点が反射している。上にタイトル。それだけ。"
      },
      "gh:typography": {
        "title": {
          "text": "SPIRIT IN PHYSICS",
          "placement": "Upper center. Same typeface as cover, slightly larger. Breathing letterspacing.",
          "color": "Near-black ultramarine."
        },
        "subtitle": {
          "text": "We can't put it together. It is together.",
          "placement": "Below title, centered. Italic. Smaller.",
          "color": "Amber."
        },
        "volume": {
          "text": "Volume 1: Water City",
          "placement": "Above the canal strip, left. Small caps.",
          "color": "Grey, 40% opacity."
        },
        "chapter": {
          "text": { "en": "Chapter 1: Assignment Day", "ja": "第1話 配属の日" },
          "placement": "Below volume line, left. Regular weight.",
          "color": "Grey, 60% opacity."
        }
      },
      "gh:imagePrompt": "Minimalist graphic novel frontispiece, vast white page, thin horizontal strip of ultramarine color in lower quarter representing abstracted canal, single point of warm golden light reflected on the strip, typography area above, extreme negative space, contemplative, near-abstract, watercolor wash"
    }
  },

  "gh:pages": [
    {
      "gh:pageNumber": 1,
      "gh:label": "Chapter title page -- the seed",
      "gh:layout": "full bleed, single image",
      "marginalia": [
        { "@type": "Subtext", "en": "The seed IS Nei. The reader won't know until Ch.62.", "ja": "種はNeiそのもの。読者がそれを知るのは第62話。" }
      ],
      "gh:panels": [
        {
          "gh:shot": "Extreme Close-up",
          "gh:visual": {
            "en": "A single seed on dark, damp earth. Vast white space above. The seed is small, almost lost. Faint golden light touches its surface. No text. Silent.",
            "ja": "暗く湿った土の上に、種が一粒。上に広大な余白。種は小さく、ほとんど見えない。かすかな金色の光が表面に触れている。文字なし。沈黙。"
          },
          "gh:colorNote": "Near-monochrome. Dark umber soil, paper white, single amber point.",
          "gh:imagePrompt": "Minimalist, single tiny seed on dark wet earth, extreme close-up, vast white negative space above, faint warm golden light touching seed, watercolor wash, umber soil, paper white, single amber highlight, no text, no characters, contemplative silence, graphic novel chapter title page"
        }
      ]
    },

    {
      "gh:pageNumber": 2,
      "gh:label": "Double-page spread (pp.2-3) -- the world",
      "gh:layout": "double-page spread",
      "marginalia": [
        { "@type": "Philosophy", "en": "Water City is not dystopia. The sea rose, and the city adapted. Acceptance precedes transformation. The philosophy of the work in urban form.", "ja": "水の都はディストピアではない。海面が上がり、街は適応した。受容が変容に先立つ。都市の形をした作品の哲学。" }
      ],
      "gh:panels": [
        {
          "gh:shot": "Extreme Wide Shot",
          "gh:visual": {
            "en": "Water City Tokyo, 2065. Panoramic. Canals where roads once were. Buildings rise from water like islands. Light-networks pulse through architecture like living veins. A water-bus glides along a wide canal. Cherry blossoms scatter on the water. The city breathes.",
            "ja": "水の都・東京、2065年。パノラマ。かつての道路は運河に。建物は島のように水から立ち上がる。光のネットワークが建築を血管のように走る。水上バスが広い運河を滑る。桜が水面に散る。街が呼吸している。"
          },
          "gh:caption": [
            { "gh:type": "tamaki", "en": "The canals are blue this morning.", "ja": "今朝も、運河は青い。" }
          ],
          "gh:colorNote": "Ultramarine dominant. Amber from light-networks. Pink cherry blossoms. The city is alive and gentle.",
          "gh:imagePrompt": "Extreme wide panoramic, futuristic Tokyo 2065, canals replacing roads, buildings rising from water, organic architecture with amber light-network veins, water-bus gliding on canal, cherry blossoms on water, spring morning, ultramarine dominant amber counter-melody, watercolor wash, graphic novel double-page spread"
        }
      ]
    },
    { "gh:pageNumber": 3, "gh:note": "Right half of spread. Same image." },

    {
      "gh:pageNumber": 4,
      "gh:layout": "three horizontal tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide Shot",
          "gh:visual": { "en": "Canal-side walkway. Cherry trees. In the distance, a young woman walks toward us.", "ja": "運河沿いの散歩道。桜並木。遠くに、若い女性がこちらに歩いてくる。" },
          "gh:caption": [
            { "gh:type": "tamaki", "en": "Tokyo rebuilt itself around water. When the sea rose, they didn't fight it. They let the city become something new.", "ja": "東京は水とともに生まれ変わった。海面が上がった時、人々は抗わなかった。街を、新しいものにした。" },
            { "gh:type": "tamaki", "en": "I like that about this place. Nothing here pretends to be what it was.", "ja": "この街の、そういうところが好きだ。ここでは何も、かつての自分のふりをしていない。" }
          ],
          "gh:imagePrompt": "Wide shot, canal-side walkway lined with cherry trees, small figure of young woman walking toward viewer in distance, organic cityscape behind, spring morning, watercolor, graphic novel panel"
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium Shot",
          "gh:visual": { "en": "Tamaki closer. 21. Light black hair, blue-tinted eyes. Pale lavender oversized shirt, black wide pants. Looking up at falling cherry blossoms. Open, expectant.", "ja": "環が近づく。21歳。色素の薄い黒髪、青みがかった瞳。淡い紫のオーバーサイズシャツ、黒のワイドパンツ。落ちる桜を見上げている。開かれた、期待に満ちた表情。" },
          "gh:imagePrompt": "Medium shot, young woman 21, light black hair blue-tinted eyes, pale lavender oversized shirt, looking up at cherry blossoms, open expression, spring light, graphic novel panel"
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": { "en": "Tamaki's half-smile. A cherry petal on her shoulder. Eyes looking ahead.", "ja": "環の微笑み。肩に桜の花びら。視線は前方へ。" },
          "gh:dialogue": [
            { "gh:speaker": "Tamaki", "en": "Today's the day.", "ja": "今日だ。" }
          ],
          "gh:imagePrompt": "Close-up, young woman half-smile, cherry petal on lavender shoulder, eyes looking ahead, warm light, graphic novel panel"
        }
      ]
    },

    {
      "gh:pageNumber": 5,
      "gh:layout": "two tiers: top wide / bottom detail",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide Shot",
          "gh:visual": { "en": "Schwa Office -- repurposed waterfront warehouse, three stories, wide windows overlooking canal. Light-networks woven into brickwork. Sign: 'Schwa -- Ghost Hacking Division.' Five recruits walking in.", "ja": "シュワ事務所。運河沿いの元倉庫、3階建て、広い窓。光のネットワークが煉瓦に織り込まれている。看板：「シュワ　ゴーストハッキング課」。5人の新人が入っていく。" },
          "gh:caption": [
            { "gh:type": "tamaki", "en": "Schwa Office. Ghost Hacking Division.", "ja": "シュワ事務所。ゴーストハッキング課。" },
            { "gh:type": "tamaki", "en": "I passed my certification last month. Today I start for real.", "ja": "先月、認定試験に受かった。今日から、本当に始まる。" }
          ],
          "gh:imagePrompt": "Wide shot, repurposed waterfront warehouse, organic architecture with amber light-network veins in brickwork, wide windows, canal foreground, five young people entering, spring morning, graphic novel panel"
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Detail",
          "gh:visual": { "en": "Tamaki's hand pushes the front door open. The light-network in the frame pulses at her touch.", "ja": "環の手がドアを押す。フレームの光ネットワークが触れた瞬間に脈動する。" },
          "gh:imagePrompt": "Detail shot, hand pushing glass door, amber light-network in frame pulsing at touch, graphic novel panel"
        }
      ]
    },

    {
      "gh:pageNumber": 6,
      "gh:layout": "full page",
      "gh:panels": [
        {
          "gh:shot": "Wide Shot, elevated",
          "gh:visual": { "en": "Office interior. High ceilings, morning light through industrial windows. Desks in a circle. Five recruits in a loose row. A senior staff member at front. Behind her: a long table with translucent pods, each with a faint sleeping glow.", "ja": "事務所内部。高い天井、工業用窓から朝の光。机が円形に並ぶ。5人の新人が緩やかに並ぶ。前に先輩スタッフ。後ろに：半透明のポッドが並ぶ長いテーブル。それぞれにかすかな眠りの光。" },
          "gh:dialogue": [
            { "gh:speaker": "Staff", "en": "Welcome. You've earned your place here.", "ja": "ようこそ。皆さんは、ここに立つ資格を勝ち取りました。" },
            { "gh:speaker": "Staff", "en": "As Ghost Hackers, you'll enter people's innermost spaces. Their pain. Their truth.", "ja": "ゴーストハッカーとして、人の心の最も深い場所に入ります。痛みに。真実に。" }
          ],
          "gh:imagePrompt": "Wide shot elevated angle, open office, high ceilings, morning light through windows, desks in circle, five recruits in row, staff member at front, long table behind with translucent glowing pods, warm interior, graphic novel full page"
        }
      ]
    },

    {
      "gh:pageNumber": 7,
      "gh:layout": "three vertical panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium Shot",
          "gh:dialogue": [
            { "gh:speaker": "Staff", "en": "Each of you will be allocated a Ghost Agent. Standard procedure.", "ja": "一人ずつ、ゴーストエージェントが配属されます。通常の手続きです。" },
            { "gh:speaker": "Staff", "en": "Your Agent handles analysis, data processing, communications. Your operating toolkit.", "ja": "エージェントは解析、データ処理、通信を担います。作業用のツールキットです。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": { "en": "One pod. Inside, a dormant glow -- like a candle through frosted glass. Sleeping. Waiting.", "ja": "ポッドの一つ。中にかすかな光。磨りガラス越しの蝋燭のよう。眠っている。待っている。" },
          "gh:colorNote": "Pod: cool blue-white. Glow within: warm gold. Something alive under ice.",
          "gh:imagePrompt": "Close-up, small translucent pod, dormant glow inside like candle through frosted glass, cool blue-white exterior warm gold within, graphic novel panel"
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": { "en": "Tamaki's eyes. Wide. Not clinical -- warm. She's looking at the pod the way you'd look at a sleeping child.", "ja": "環の目。大きく開いている。臨床的ではない。温かい。眠る子を見るような目で、ポッドを見ている。" },
          "gh:caption": [
            { "gh:type": "tamaki", "en": "Operating toolkit.", "ja": "作業用のツールキット。" },
            { "gh:type": "tamaki", "en": "That's what they call them.", "ja": "そう呼ぶんだ。" }
          ],
          "gh:imagePrompt": "Close-up, young woman's blue-tinted eyes wide with warmth, amber pod-light reflected in irises, looking with tenderness, graphic novel panel"
        }
