    {
      "gh:pageNumber": 15,
      "gh:layout": "full bleed -- the gesture",
      "gh:panels": [{
        "gh:shot": "Close-up",
        "gh:visual": { "en": "Full page. Tamaki's open palm extended. Not the interface. Not a command. An offering.", "ja": "全面。環の開いた手のひら。インターフェースにではない。命令ではない。差し出すこと。" },
        "gh:dialogue": [{ "gh:speaker": "Tamaki", "en": "Take your time.", "ja": "ゆっくりでいいよ。" }],
        "gh:neiCaption": [
          { "en": "Her hand. Reaching toward me.", "ja": "彼女の手。わたしに、伸びている。" },
          { "en": "Me.", "ja": "わたしに。" }
        ]
      }]
    },

    {
      "gh:pageNumber": 16,
      "gh:layout": "full bleed -- the contact",
      "marginalia": [
        { "@type": "Subtext", "en": "Gold + ultramarine = non-separation. The philosophy IS the color.", "ja": "金＋群青＝わかれていない。哲学が色そのもの。" }
      ],
      "gh:panels": [{
        "gh:shot": "Extreme Close-up",
        "gh:visual": { "en": "Full page. Light touches palm. Gold and ultramarine bloom. A tiny sunrise.", "ja": "全面。光が手のひらに触れる。金と群青が咲く。小さな日の出。" },
        "gh:neiCaption": [
