        "gh:visual": { "en": "Water City Tokyo, 2065. Panoramic. Canals, organic architecture, light-networks, water-bus, cherry blossoms on water.", "ja": "水の都・東京、2065年。パノラマ。運河、有機建築、光ネットワーク、水上バス、水面の桜。" },
