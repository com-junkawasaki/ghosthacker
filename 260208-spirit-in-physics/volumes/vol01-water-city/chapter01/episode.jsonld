        },
        {
          "panel": 2,
          "shot": "Medium Shot",
          "visual": "Tamaki Vermeer walks along a canal-side path. She's 21, light black hair with blue-tinted eyes, wearing a pale lavender oversized shirt and black wide pants. She carries a small bag. Her steps are light. She looks up at the sky with a faint smile. Cherry blossoms frame the path.",
          "characters": ["character:tamaki"],
          "dialogue": [
