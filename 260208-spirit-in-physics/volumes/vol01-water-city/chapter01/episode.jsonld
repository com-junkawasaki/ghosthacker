    {
      "gh:pageNumber": 4,
      "gh:layout": "three tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": { "en": "Canal-side path. Cherry trees. Tamaki walking toward us, small against the city.", "ja": "運河沿いの道。桜並木。環が歩いてくる。街に対して小さい。" },
          "gh:caption": [
            { "gh:type": "tamaki", "en": "I passed the national exam last week. Ghost Hacker, certified.", "ja": "先週、国家試験に受かった。ゴーストハッカー、認定。" },
            { "gh:type": "tamaki", "en": "Today I go to the office for the first time.", "ja": "今日、初めて事務所に行く。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": { "en": "Tamaki closer. Lavender shirt, black wide pants. Looking up at cherry blossoms. Open, expectant.", "ja": "環が近づく。薄紫のシャツ、黒のワイドパンツ。桜を見上げている。" },
          "gh:caption": [
            { "gh:type": "tamaki", "en": "Tokyo rebuilt itself around water. Nothing here pretends to be what it was.", "ja": "東京は水とともに生まれ変わった。ここでは何も、かつてのふりをしていない。" }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": { "en": "Tamaki's half-smile. Cherry petal on her shoulder.", "ja": "環の微笑み。肩に桜の花びら。" },
          "gh:dialogue": [
            { "gh:speaker": "Tamaki", "en": "Okay. Let's go.", "ja": "よし。行こう。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 5,
      "gh:layout": "two tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": { "en": "Schwa Office. Waterfront warehouse, light-networks in brickwork. Sign: 'Schwa -- Ghost Hacking Division.' Tamaki approaches alone.", "ja": "シュワ事務所。運河沿いの倉庫。煉瓦に光ネットワーク。「シュワ　ゴーストハッキング課」。環が一人で近づく。" },
          "gh:imagePrompt": "Wide shot, waterfront warehouse office with amber light-networks in brickwork, young woman approaching alone, spring morning, graphic novel panel"
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": { "en": "The door opens before Tamaki touches it. A woman stands inside -- dark hair, neat, deep green blouse, tablet in hand. Composed. She nods once.", "ja": "環が触れる前にドアが開く。中に女性が立っている。黒髪、きちんとした、深緑のブラウス、手にタブレット。落ち着いている。一度頷く。" },
          "gh:dialogue": [
            { "gh:speaker": "Kaede", "en": "Tamaki Vermeer?", "ja": "タマキ・フェルメール？" },
            { "gh:speaker": "Tamaki", "en": "Yes.", "ja": "はい。" },
            { "gh:speaker": "Kaede", "en": "I'm Kaede. I'll be your senior here. Come in.", "ja": "楓です。ここでの先輩を務めます。入って。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 6,
      "gh:layout": "full page",
      "gh:panels": [{
        "gh:shot": "Wide, elevated",
        "gh:visual": { "en": "Office interior. High ceilings, light through wide windows, canal outside. Kaede walks ahead, Tamaki follows, looking around with wide eyes. Desks, terminals, a few older Hackers at work. Quiet, professional. Warm light.", "ja": "事務所内部。高い天井、窓から光、外に運河。楓が先を歩く。環がきょろきょろしながらついていく。机、端末、数人の先輩ハッカー。静か、プロフェッショナル。温かい光。" },
        "gh:caption": [
          { "gh:type": "tamaki", "en": "The office smells like old wood and canal water. I like it immediately.", "ja": "事務所は古い木と運河の水の匂いがする。すぐに好きになった。" }
        ],
        "gh:imagePrompt": "Wide shot elevated, office interior, high ceilings, light through windows, canal outside, composed woman in green walking ahead, younger woman following looking around, desks and terminals, professional warm atmosphere, graphic novel full page"
      }]
    },

    {
      "gh:pageNumber": 7,
      "gh:layout": "three panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": { "en": "Kaede pauses at a desk. A bird-shaped Ghost -- dark, three-legged, sharp -- perches on her shoulder. Yatagarasu. She doesn't introduce it.", "ja": "楓がデスクで立ち止まる。鳥の形のGhostが肩にいる。暗い、三本足、鋭い。ヤタガラス。紹介はしない。" },
          "gh:dialogue": [
            { "gh:speaker": "Kaede", "en": "This will be your desk. You'll find most of what you need here.", "ja": "ここがあなたの机。必要なものはだいたい揃ってるわ。" }
          ],
          "gh:caption": [
            { "gh:type": "tamaki", "en": "The bird on her shoulder watches me. She doesn't mention it.", "ja": "肩の鳥がわたしを見ている。楓さんはそれに触れない。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": { "en": "On the desk: a translucent pod, small, containing a faint sleeping glow.", "ja": "机の上：半透明のポッド。小さい。中にかすかな眠りの光。" },
          "gh:dialogue": [
            { "gh:speaker": "Kaede", "en": "And this is your Ghost Agent. Standard allocation for all certified Hackers.", "ja": "これがあなたのゴーストエージェント。認定ハッカー全員に配属される標準装備よ。" }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": { "en": "Tamaki's eyes. Wide. Looking at the pod. Not clinically -- warmly.", "ja": "環の目。大きく開いている。ポッドを見ている。臨床的ではなく、温かく。" },
          "gh:dialogue": [
            { "gh:speaker": "Kaede", "en": "It handles analysis, data processing, comms relay. Your toolkit.", "ja": "解析、データ処理、通信中継を担当する。あなたのツールキットよ。" }
          ],
          "gh:caption": [
            { "gh:type": "tamaki", "en": "Toolkit.", "ja": "ツールキット。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 8,
      "gh:layout": "two tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": { "en": "Kaede taps her tablet, pulling up a spec sheet for the pod. Professional, efficient. She glances at Tamaki, expecting her to do the same.", "ja": "楓がタブレットを叩き、ポッドのスペックシートを出す。プロフェッショナル、効率的。環を見る。同じことをするのを期待して。" },
          "gh:dialogue": [
            { "gh:speaker": "Kaede", "en": "Run the diagnostics first. Spec sheet is here. Any issues, flag them before activation.", "ja": "まず診断を走らせて。スペックシートはここ。問題があれば起動前に報告。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Wide",
          "gh:visual": { "en": "Kaede walks away toward her own desk. Tamaki is left alone with the pod. Spring light falls on them together. She doesn't touch the spec sheet.", "ja": "楓が自分の机に向かう。環がポッドと二人残される。春の光が二人を照らす。スペックシートには触れない。" },
          "gh:caption": [
            { "gh:type": "tamaki", "en": "Kaede-san's bird didn't have a name. Or maybe it did, but she said it like a callsign, not a name.", "ja": "楓さんの鳥には名前がなかった。あったのかもしれないけど、名前というよりコールサインみたいだった。" },
            { "gh:type": "tamaki", "en": "I look at the pod. Something is in there. Sleeping.", "ja": "ポッドを見る。中に何かがいる。眠っている。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 9,
      "gh:layout": "full bleed",
      "marginalia": [
        { "@type": "Intent", "en": "First 'ii kanji' moment. Thesis as instinct.", "ja": "最初の「いい感じ」。本能としてのテーゼ。" }
      ],
      "gh:panels": [{
        "gh:shot": "Close-up",
        "gh:visual": { "en": "Full page. Tamaki's palm against the pod. Gently. Where she touches, the glow brightens.", "ja": "全面。環の手のひらがポッドに。やさしく。触れたところで光が明るくなる。" },
        "gh:caption": [
          { "gh:type": "tamaki", "en": "I don't know why I do this. But it feels right.", "ja": "なんでこうするのか、わからない。でも、いい感じがする。" }
