    },

    {
      "gh:pageNumber": 8,
      "gh:layout": "two tiers: top montage / bottom contrast",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Montage",
          "gh:visual": { "en": "Other recruits at work. Quick cuts: hand tapping pod, holographic spec-sheet, diagnostic graphs. Efficient. Clinical.", "ja": "他の新人たち。素早いカット：ポッドを叩く手、ホログラフィックスペックシート、診断グラフ。効率的。臨床的。" },
          "gh:dialogue": [
            { "gh:speaker": "Recruit A", "en": "4.2 petaflops baseline. Solid.", "ja": "ベースライン4.2ペタフロップス。問題なし。" },
            { "gh:speaker": "Recruit B", "en": "Lag on the emotional resonance module. Filing for recalibration.", "ja": "感情共鳴モジュールにラグ。再調整を申請する。" }
          ],
          "gh:colorNote": "Cool blue-white. Clinical. No warmth."
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Wide Shot",
          "gh:visual": { "en": "Contrast. Tamaki alone at her desk. Pod untouched, glowing faintly. She just stands there. Spring light falls across her and the pod together -- a pool of gold in a sea of clinical blue.", "ja": "対比。環だけが机の前に立っている。ポッドには触れていない。かすかに光っている。彼女はただ、見ている。春の光が彼女とポッドを一緒に照らす。臨床的な青の海の中に、金色の水たまり。" },
          "gh:dialogue": [
            { "gh:speaker": "Recruit C", "en": "Hey, Vermeer. Running your specs?", "ja": "おい、フェルメール。スペック確認しないのか。" },
            { "gh:speaker": "Tamaki", "en": "In a moment.", "ja": "もうちょっと。" }
          ],
          "gh:imagePrompt": "Wide shot, young woman alone at desk, untouched glowing pod, spring light creating pool of warm gold around them, contrast with cool blue holographic light at other desks, graphic novel panel"
        }
      ]
    },

    {
      "gh:pageNumber": 9,
      "gh:layout": "full bleed",
      "marginalia": [
        { "@type": "Intent", "en": "The first 'ii kanji' moment. She trusts feeling before reason. The thesis disguised as instinct.", "ja": "最初の「いい感じ」。理屈より先に感覚を信じる。本能に偽装されたテーゼ。" }
      ],
      "gh:panels": [
        {
          "gh:shot": "Close-up",
