  "dct:title": "Vol.2 Ch.7 — 夏の光",
  "dct:title_en": "Chapter 7: Summer Light",
  "dct:title_ja": "第7話 夏の光",
  "gh:arc": "Vol 2: Life",
  "gh:episodeId": "episode:sip-vol02-ch07",
  "gh:format": "graphic novel",
  "gh:characters": [
    { "@id": "character:tamaki", "gh:name": "Tamaki" },
    { "@id": "character:nei", "gh:name": "Nei" },
