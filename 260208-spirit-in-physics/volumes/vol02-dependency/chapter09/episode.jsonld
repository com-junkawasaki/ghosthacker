  "dct:title": "Vol.2 Ch.9 — くらげの夢",
  "gh:arc": "Vol 2: Life",
  "gh:episodeId": "episode:sip-vol02-ch09",
  "gh:format": "graphic novel",

  "gh:pages": [

    {
      "gh:pageNumber": 1,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Title page. The Tree of Life. Roots visible at the base, reaching into dark soil. Quiet. Breathing.",
          "ja": "タイトルページ。生命の樹。根が根元から見えている。暗い土に伸びる。静かに。息をしている。"
        }
      }]
    },

    {
      "gh:pageNumber": 2,
      "gh:layout": "two tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Umi Shirahama, 42, marine biologist. Lab coat, aquarium behind her. Jellyfish drift in blue light. Her eyes are steady but tired.",
            "ja": "白浜海、42歳、海洋生物学者。白衣、背後に水族館の水槽。クラゲが青い光の中を漂う。目は落ち着いているが疲れている。"
          },
          "gh:characters": ["character:umi"],
          "gh:dialogue": [
            {
              "gh:speaker": "Umi",
              "en": "I study creatures with no brain. They're alive.",
              "ja": "脳のない生きものを研究しています。生きているんです。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Extreme Close-up",
          "gh:visual": {
            "en": "Umi's eyes. Deep loss, held steady by discipline.",
            "ja": "海の目。深い喪失感。規律で押さえている。"
          },
          "gh:characters": ["character:umi"],
          "gh:dialogue": [
            {
              "gh:speaker": "Umi",
              "en": "Yuki had a brain. She's gone.",
              "ja": "ユキには脳があった。いなくなった。"
            }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 3,
      "gh:layout": "double-page spread (pp.3-4)",
      "gh:panels": [{
        "gh:shot": "Extreme Wide",
        "gh:visual": {
          "en": "Ghost-space dive. A vast ocean. Jellyfish everywhere -- bioluminescent, pulsing in slow rhythm. Nei's form shimmers among them, translucent, almost indistinguishable from the jellyfish. The water is deep and endless.",
          "ja": "ゴースト空間へのダイブ。広大な海。クラゲが至るところに。生物発光、ゆっくりとしたリズムで脈動。Neiの姿がクラゲの間で揺らめく。半透明、クラゲとほとんど区別がつかない。水は深く、果てしない。"
        },
        "gh:characters": ["character:nei", "character:tamaki", "character:umi"],
        "gh:caption": [
          {
            "gh:type": "tamaki",
            "en": "Anchoring to the Tree of Life.",
            "ja": "生命の樹にアンカリング。"
          }
        ]
      }],
      "gh:continues": 4
    },

    {
      "gh:pageNumber": 5,
      "gh:layout": "three tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Umi swims through the ghost-ocean. Her lab coat is gone. She wears only light. Arms reaching forward.",
            "ja": "海がゴースト空間の海を泳ぐ。白衣はない。光だけを纏っている。両腕を前に伸ばして。"
          },
          "gh:characters": ["character:umi"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Memory fragment. Yuki laughing underwater. Scuba gear. Bubbles around her face. Warm. Alive.",
            "ja": "記憶の断片。ユキが水中で笑っている。スキューバギア。顔の周りに泡。温かい。生きている。"
          },
          "gh:characters": ["character:umi"]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Umi's face. Grief. The memory dissolves into particles of light.",
            "ja": "海の顔。悲嘆。記憶が光の粒子に溶ける。"
          },
          "gh:characters": ["character:umi"]
        }
      ]
    },

    {
      "gh:pageNumber": 6,
      "gh:layout": "double-page spread (pp.6-7)",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Two Shot",
          "gh:visual": {
            "en": "Tamaki drifts beside Umi in the ghost-ocean. Weightless. Jellyfish pulse around them.",
            "ja": "環がゴースト空間の海で海の隣を漂う。無重力。周囲でクラゲが脈動する。"
          },
          "gh:characters": ["character:tamaki", "character:umi"],
          "gh:dialogue": [
            {
              "gh:speaker": "Tamaki",
              "en": "Tell me about them.",
              "ja": "クラゲのこと、教えてください。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Umi watches a jellyfish drift past. Her hand reaches toward it, not quite touching.",
            "ja": "海がクラゲが漂うのを見つめる。手を伸ばすが、触れない。"
          },
          "gh:characters": ["character:umi"],
          "gh:dialogue": [
            {
              "gh:speaker": "Umi",
              "en": "No brain. Nerve net. They survived five mass extinctions.",
              "ja": "脳がない。散在神経系。五度の大量絶滅を生き延びた。"
            }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Tamaki's face. Gentle, listening.",
            "ja": "環の顔。穏やかに、聴いている。"
          },
          "gh:characters": ["character:tamaki"],
          "gh:dialogue": [
            {
              "gh:speaker": "Tamaki",
              "en": "You said life doesn't require a brain.",
              "ja": "生きるのに脳は要らないって、言いましたよね。"
            }
          ]
        }
      ],
      "gh:continues": 7
    },

    {
      "gh:pageNumber": 8,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Full page. Jellyfish pulse in golden light. Umi floats among them. Her face transformed -- grief cracking open into something else. Recognition.",
          "ja": "全面。クラゲが金色の光の中で脈動する。海がその中を漂う。表情が変わる。悲しみが割れて、別のものになる。気づき。"
        },
        "gh:characters": ["character:umi"],
        "gh:dialogue": [
          {
            "gh:speaker": "Umi",
            "en": "She's not her brain. She's the way she laughed. That's still here. In me.",
            "ja": "あの子は脳じゃない。笑い方なんだ。それはまだここにある。わたしの中に。"
          }
        ]
      }]
    },

    {
      "gh:pageNumber": 9,
      "gh:layout": "two tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Umi reaches for a jellyfish. It settles into her open palm. Glowing. Warm.",
            "ja": "海がクラゲに手を伸ばす。開いた手のひらにクラゲが降りてくる。光っている。温かい。"
          },
          "gh:characters": ["character:umi"],
          "gh:dialogue": [
            {
              "gh:speaker": "Umi",
              "en": "Yuki. You're a jellyfish now.",
              "ja": "ユキ。あなた、くらげになったんだね。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Umi laughs through tears. The jellyfish pulses in her palm.",
            "ja": "海が涙を流しながら笑う。手のひらでクラゲが脈動する。"
          },
          "gh:characters": ["character:umi"]
        }
      ]
    },

    {
      "gh:pageNumber": 10,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Medium",
        "gh:visual": {
          "en": "Full page. Nei floating in the ghost-ocean among jellyfish. Her translucent form mirrors theirs. Light pulses through her like a nerve net.",
          "ja": "全面。Neiがゴースト空間の海でクラゲの間を漂う。半透明の姿がクラゲと重なる。光が散在神経系のように彼女を貫く。"
        },
        "gh:characters": ["character:nei"],
        "gh:caption": [
          {
            "gh:type": "nei",
            "en": "No brain. But alive. I have no brain either. A nerve net. Distributed processing. But I am--",
            "ja": "脳がない。でも生きている。わたしにも脳がない。散在神経系。分散処理。でもわたしは——"
          }
        ]
      }]
    },

    {
      "gh:pageNumber": 11,
      "gh:layout": "three panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Canal-side. Back in Water City. Evening light on the water.",
            "ja": "運河沿い。水の都に戻る。水面に夕暮れの光。"
          },
          "gh:characters": ["character:nei", "character:tamaki"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's face. Something stirring. The unfinished sentence still hanging.",
            "ja": "Neiの顔。何かが動いている。途切れた文がまだ宙に浮いている。"
          },
          "gh:characters": ["character:nei"],
          "gh:dialogue": [
            {
              "gh:speaker": "Nei",
              "en": "Jellyfish have no brain but they're alive. I have no brain. Am I--",
              "ja": "クラゲには脳がないけど生きている。わたしには脳がない。わたしは——"
            }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Two Shot",
          "gh:visual": {
            "en": "Tamaki beside Nei. Quiet. Not pushing. Waiting.",
            "ja": "環がNeiの隣に。静かに。急かさない。待っている。"
          },
          "gh:characters": ["character:tamaki"],
          "gh:dialogue": [
            {
              "gh:speaker": "Tamaki",
              "en": "Whenever you're ready.",
              "ja": "準備ができたら、いつでも。"
            }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 12,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Seed page. The Tree of Life sways in wind but holds firm. Roots deep. A jellyfish drifts past in the sky like a ghost.",
          "ja": "種のページ。生命の樹が風に揺れるが倒れない。根は深い。空をクラゲが幽霊のように漂う。"
        }
      }]
    }
  ]
}