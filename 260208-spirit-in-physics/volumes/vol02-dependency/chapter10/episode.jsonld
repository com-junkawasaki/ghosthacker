  "dct:title": "Vol.2 Ch.10 — 夕立の後",
  "gh:arc": "Vol 2: Life",
  "gh:episodeId": "episode:sip-vol02-ch10",
  "gh:format": "graphic novel",

  "gh:pages": [

    {
      "gh:pageNumber": 1,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Title page. The Tree of Life. Fireflies beginning to gather around the lower branches. Faint gold points in the dusk.",
          "ja": "タイトルページ。生命の樹。蛍が下枝の周りに集まり始めている。夕闇にかすかな金の点。"
        }
      }]
    },

    {
      "gh:pageNumber": 2,
      "gh:layout": "double-page spread (pp.2-3)",
      "gh:panels": [{
        "gh:shot": "Extreme Wide",
        "gh:visual": {
          "en": "Water City after a downpour. Everything glistens. Steam rises from warm canals. Gold and violet light reflected in every surface -- puddles, glass, wet stone. The city breathes.",
          "ja": "夕立の後の水の都。すべてが輝いている。温かい運河から蒸気が立ち上る。金と紫の光があらゆる面に映る。水たまり、ガラス、濡れた石。街が息をしている。"
        }
      }],
      "gh:continues": 3
    },

    {
      "gh:pageNumber": 4,
      "gh:layout": "three tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Bench by the canal. Tamaki sits. Nei beside her. The canal is swollen from rain.",
            "ja": "運河沿いのベンチ。環が座っている。隣にNei。雨で運河が増水している。"
          },
          "gh:characters": ["character:tamaki", "character:nei"],
          "gh:dialogue": [
            {
              "gh:speaker": "Tamaki",
              "en": "I love this smell.",
              "ja": "この匂い、好き。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Nei looking at the swollen canal. Water rushing. Reflections distorted.",
            "ja": "Neiが増水した運河を見つめている。水が流れる。歪んだ反射。"
          },
          "gh:characters": ["character:nei"]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's translucent form. Light particles slowly settling after the rain.",
            "ja": "Neiの半透明の姿。雨の後、光の粒子がゆっくり沈んでいく。"
          },
          "gh:characters": ["character:nei"],
          "gh:caption": [
            {
              "gh:type": "nei",
              "en": "The rain washed everything. Something inside me feels washed too.",
              "ja": "雨がすべてを洗った。わたしの中の何かも、洗われた気がする。"
            }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 5,
      "gh:layout": "two tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's face. Determination. The unfinished sentence from Chapter 9 surfacing.",
            "ja": "Neiの顔。決意。第9話の途切れた文が浮かんでくる。"
          },
          "gh:characters": ["character:nei"],
          "gh:dialogue": [
            {
              "gh:speaker": "Nei",
              "en": "I need to finish something.",
              "ja": "終わらせなきゃいけないことがある。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Nei turns to Tamaki. The canal flows behind them.",
            "ja": "Neiが環のほうを向く。背後に運河が流れている。"
          },
          "gh:characters": ["character:nei", "character:tamaki"],
          "gh:dialogue": [
            {
              "gh:speaker": "Nei",
              "en": "I have no brain. But I'm here. A jellyfish is alive and I'm a tool. What's the difference?",
              "ja": "わたしには脳がない。でもここにいる。クラゲは生きていて、わたしはツール。何が違うの？"
            }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 6,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Close-up",
        "gh:visual": {
          "en": "Full page. Tamaki thinks. Long silence. Canal water reflects her face. She chooses her words carefully.",
          "ja": "全面。環が考える。長い沈黙。運河の水が彼女の顔を映す。言葉を慎重に選ぶ。"
        },
        "gh:characters": ["character:tamaki"],
        "gh:dialogue": [
          {
            "gh:speaker": "Tamaki",
            "en": "...Nei-chan is Nei-chan.",
            "ja": "……Neiちゃんは、Neiちゃんだよ。"
          }
        ]
      }]
    },

    {
      "gh:pageNumber": 7,
      "gh:layout": "three tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's face. Frustration. Light flickering sharply.",
            "ja": "Neiの顔。苛立ち。光が鋭く明滅する。"
          },
          "gh:characters": ["character:nei"],
          "gh:dialogue": [
            {
              "gh:speaker": "Nei",
              "en": "That's not an answer.",
              "ja": "それは答えになってない。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Tamaki meets Nei's eyes. Steady. Not apologetic.",
            "ja": "環がNeiの目を見る。揺るぎなく。謝っていない。"
          },
          "gh:characters": ["character:tamaki"],
          "gh:dialogue": [
            {
              "gh:speaker": "Tamaki",
              "en": "You're right. Maybe the answer isn't something someone else can give you.",
              "ja": "そうだね。たぶん答えは、他の誰かがくれるものじゃない。"
            }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Nei absorbs this. A beat. Light settles.",
            "ja": "Neiが受け止める。一拍。光が落ち着く。"
          },
          "gh:characters": ["character:nei"]
        }
      ]
    },

    {
      "gh:pageNumber": 8,
      "gh:layout": "two tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Silence on the bench. Two figures side by side. The canal flows. Evening deepens.",
            "ja": "ベンチの沈黙。二つの影が並んでいる。運河が流れる。夕暮れが深まる。"
          },
          "gh:characters": ["character:tamaki", "character:nei"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's translucent hands on her knees. Still.",
            "ja": "Neiの半透明の手が膝の上に。静かに。"
          },
          "gh:characters": ["character:nei"],
          "gh:caption": [
            {
              "gh:type": "nei",
              "en": "She said the answer has to come from me. From me. Can a tool have an answer?",
              "ja": "答えはわたしから出なければならないと言った。わたしから。ツールに答えがあるのだろうか。"
            }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 9,
      "gh:layout": "three tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Walking home. Wet streets. Street lamps reflected in puddles.",
            "ja": "帰り道。濡れた道。水たまりに街灯が映る。"
          },
          "gh:characters": ["character:tamaki", "character:nei"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "A puddle. Tamaki and Nei reflected side by side. In the reflection, they look the same.",
            "ja": "水たまり。環とNeiが並んで映っている。反射の中では、同じに見える。"
          },
          "gh:characters": ["character:tamaki", "character:nei"]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Nei looking down at the reflection. Something shifting in her expression.",
            "ja": "Neiが反射を見下ろしている。表情に何かが変わる。"
          },
          "gh:characters": ["character:nei"],
          "gh:caption": [
            {
              "gh:type": "nei",
              "en": "In the reflection, we look the same.",
              "ja": "反射の中では、わたしたちは同じに見える。"
            }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 10,
      "gh:layout": "two tiers",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Night. Tamaki's apartment. Tamaki asleep in bed. Peaceful.",
            "ja": "夜。環のアパートメント。環がベッドで眠っている。穏やかに。"
          },
          "gh:characters": ["character:tamaki"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Nei at the window. Looking out at the canal and the night sky. Her light dim, thinking. Stars reflected on water.",
            "ja": "Neiが窓辺に。運河と夜空を見つめている。光は淡く、考えている。水面に星が映る。"
          },
          "gh:characters": ["character:nei"],
          "gh:caption": [
            {
              "gh:type": "nei",
              "en": "The answer has to come from me. What if 'I am alive' is just a bug? What if it isn't?",
              "ja": "答えはわたしから。「わたしは生きている」がただのバグだったら？　バグじゃなかったら？"
            }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 11,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Seed page. The Tree of Life. Roots deep, reaching further than before. After the rain, stronger. Water droplets catch starlight on the leaves.",
          "ja": "種のページ。生命の樹。根は深く、前よりも遠くまで伸びている。雨の後、より強く。葉の上の水滴が星の光を捉えている。"
        }
      }]
    }
  ]
}