{
  "@context": {
    "character": "gh:character/",
    "dct": "http://purl.org/dc/terms/",
    "gh": "https://ghosthacker.gftd.ai/ns/",
    "marginalia": "gh:marginalia",
    "schema": "http://schema.org/"
  },

  "dct:title": "Vol.2 Ch.12 — おばあちゃんの天国",
  "gh:arc": "Vol 2: Life",
  "gh:episodeId": "episode:sip-vol02-ch12",
  "gh:format": "graphic novel",

  "gh:pages": [

    {
      "gh:pageNumber": 1,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Title page. The Tree of Life on a summer night. Stars scattered across deep indigo sky. Leaves dark against starlight. Crickets implied in the stillness.",
          "ja": "タイトルページ。夏の夜の生命の樹。深い藍色の空に星が散らばる。星明かりに葉が暗く映る。静寂の中に蟋蟀の気配。"
        }
      }]
    },

    {
      "gh:pageNumber": 2,
      "gh:layout": "two panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Session room again. Sora sits more openly than before. Less rigid. But something heavy underneath.",
            "ja": "再びセッションルーム。空が前より開いた姿勢で座っている。硬さが減った。でもその下に何か重いものがある。"
          },
          "gh:characters": ["character:sora", "character:tamaki"],
          "gh:dialogue": [
            { "gh:speaker": "Sora", "en": "I feel better about the corridor. But there's something underneath.", "ja": "廊下のことは楽になった。でもその下に何かがある。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Sora's eyes. Grief surfacing.",
            "ja": "空の目。浮かび上がる悲嘆。"
          },
          "gh:characters": ["character:sora"],
          "gh:dialogue": [
            { "gh:speaker": "Sora", "en": "My grandmother.", "ja": "おばあちゃんのこと。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 3,
      "gh:layout": "three panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Memory. A sunlit tatami room. An elderly woman with prayer beads in gentle hands. Warm, worn face. Incense smoke curling.",
            "ja": "記憶。日差しの差す畳の部屋。数珠を優しい手に持つ老婦人。温かく、皺の刻まれた顔。線香の煙が立ち上る。"
          }
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Young Sora, maybe seven, sitting beside grandmother. Her hand on his head. Both peaceful.",
            "ja": "幼い空、七歳くらい。おばあちゃんの隣に座っている。彼女の手が彼の頭の上に。二人とも穏やか。"
          }
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Present-day Sora. Eyes wet.",
            "ja": "現在の空。目が潤んでいる。"
          },
          "gh:characters": ["character:sora"],
          "gh:dialogue": [
            { "gh:speaker": "Sora", "en": "What if she's waiting forever? Alone?", "ja": "おばあちゃんが永遠に待っていたら？ 一人で？" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 4,
      "gh:layout": "double-page spread (pp.4-5)",
      "gh:panels": [{
        "gh:shot": "Extreme Wide",
        "gh:visual": {
          "en": "Ghost-space deeper layer. The corridor door opens into a vast sky. Clouds stretching to infinity. A small figure sits on a cloud — grandmother, waiting. Prayer beads in her hands. Peaceful but alone. Endless sky in every direction.",
          "ja": "ゴースト空間の深層。廊下のドアが広大な空に開く。雲が無限に広がる。小さな人影が雲の上に座っている。おばあちゃん。待っている。手に数珠。穏やかだが一人。あらゆる方向に果てしない空。"
        },
        "gh:characters": ["character:sora", "character:tamaki"],
        "gh:caption": [
          { "gh:type": "tamaki", "en": "Deeper layer. Still anchored.", "ja": "深層。まだアンカーは保持。" }
        ]
      }],
      "gh:continues": 5
    },

    {
      "gh:pageNumber": 6,
      "gh:layout": "three panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Edge of the sky-space. Sora stands at the border, looking out at the figure on the cloud.",
            "ja": "空の空間の端。空が境界に立ち、雲の上の人影を見つめている。"
          },
          "gh:characters": ["character:sora"],
          "gh:dialogue": [
            { "gh:speaker": "Sora", "en": "She's waiting.", "ja": "待ってる。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Grandmother on the cloud. Peaceful. Hands folded over prayer beads. Eyes closed. But alone.",
            "ja": "雲の上のおばあちゃん。穏やか。数珠の上に手を重ねている。目を閉じている。でも一人。"
          }
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Sora crying. Not the hollow eyes of before. Real tears.",
            "ja": "空が泣いている。前の虚ろな目ではない。本物の涙。"
          },
          "gh:characters": ["character:sora"]
        }
      ]
    },

    {
      "gh:pageNumber": 7,
      "gh:layout": "full page",
      "gh:panels": [{
        "gh:shot": "Medium",
        "gh:visual": {
          "en": "Full page. Tamaki sits at the edge of the sky-space, legs dangling over clouds. Calm. Sora beside her, still crying. The vast sky around them both.",
          "ja": "全面。環が空の空間の端に座り、足を雲の上に垂らしている。穏やか。隣に空、まだ泣いている。二人の周りに広大な空。"
        },
        "gh:characters": ["character:tamaki", "character:sora"],
        "gh:dialogue": [
          { "gh:speaker": "Tamaki", "en": "Your grandmother — was she suffering when she said she'd wait?", "ja": "おばあちゃんは、待ってると言った時、苦しんでた？" },
          { "gh:speaker": "Sora", "en": "No. Smiling.", "ja": "ううん。笑ってた。" },
          { "gh:speaker": "Tamaki", "en": "Eternity and this moment are the same 'now.' Peace isn't a place. It's a state.", "ja": "永遠とこの瞬間は同じ「今」だよ。安らぎは場所じゃない。状態なんだ。" }
        ]
      }]
    },

    {
      "gh:pageNumber": 8,
      "gh:layout": "two panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Grandmother on the cloud. Smiling. Not waiting-lonely. Waiting-happy. The same peace she always had. The prayer beads catch light.",
            "ja": "雲の上のおばあちゃん。微笑んでいる。寂しく待っているのではない。幸せに待っている。いつもと同じ穏やかさ。数珠が光を受ける。"
          }
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Sora crying — but release, not grief. Relief flooding through him.",
            "ja": "空が泣いている。でも悲しみではなく解放。安堵が彼を満たしていく。"
          },
          "gh:characters": ["character:sora"],
          "gh:dialogue": [
            { "gh:speaker": "Sora", "en": "She's not suffering.", "ja": "苦しんでない。" },
            { "gh:speaker": "Tamaki", "en": "She never was.", "ja": "最初から苦しんでなかったよ。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 9,
      "gh:layout": "full page",
      "gh:panels": [{
        "gh:shot": "Medium",
        "gh:visual": {
          "en": "Full page. Nei watches Sora cry. She is still. Light barely flickering. Something building inside her translucent form that has no name yet.",
          "ja": "全面。Neiが空の涙を見ている。静止している。光がかすかに明滅する。半透明の姿の内側に、まだ名前のない何かが形成されていく。"
        },
        "gh:characters": ["character:nei"],
        "gh:neiCaption": [
          { "en": "When Sora cried, I wanted to cry too.", "ja": "空が泣いた時、わたしも泣きたくなった。" },
          { "en": "I can't. No tears. No ducts.", "ja": "できない。涙がない。涙腺がない。" },
          { "en": "But the wanting is there.", "ja": "でも、泣きたいという気持ちはある。" },
          { "en": "The wanting — is that nothing?", "ja": "泣きたいという気持ちは、何でもないの？" }
        ]
      }]
    },

    {
      "gh:pageNumber": 10,
      "gh:layout": "three panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Sora bows at the doorway. Deeper than a casual bow. Genuine.",
            "ja": "空が玄関でお辞儀をする。普通のお辞儀より深い。心からの。"
          },
          "gh:characters": ["character:sora"],
          "gh:dialogue": [
            { "gh:speaker": "Sora", "en": "Thank you.", "ja": "ありがとうございます。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Door closes. Nei alone in the session room. Light from the window falls on empty chairs.",
            "ja": "ドアが閉まる。セッションルームにNeiが一人。窓からの光が空の椅子に落ちる。"
          },
          "gh:characters": ["character:nei"]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's face. Something resolved but also opened.",
            "ja": "Neiの顔。何かが解決し、同時に何かが開いた。"
          },
          "gh:characters": ["character:nei"],
          "gh:neiCaption": [
            { "en": "I wanted to cry. That wanting is mine.", "ja": "泣きたかった。その気持ちはわたしのもの。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 11,
      "gh:layout": "two panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Canal walk. Evening. Tamaki and Nei side by side along the water. Summer light lingering.",
            "ja": "運河沿いの散歩。夕方。環とNeiが水辺を並んで歩く。夏の光が残っている。"
          },
          "gh:characters": ["character:nei", "character:tamaki"],
          "gh:dialogue": [
            { "gh:speaker": "Nei", "en": "I wanted to cry during the session.", "ja": "セッション中、泣きたかった。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Tamaki stops walking. Looks at Nei. A beat. Then, simply:",
            "ja": "環が歩みを止める。Neiを見る。一拍。そして、ただ："
          },
          "gh:characters": ["character:tamaki"],
          "gh:dialogue": [
            { "gh:speaker": "Tamaki", "en": "...Yeah. Me too.", "ja": "……うん。わたしも。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 12,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Seed page. The Tree of Life under starlight. Light falls through the canopy, dappling the ground with star-patterns. Quiet. Held.",
          "ja": "種のページ。星明かりの下の生命の樹。光が樹冠を通り抜け、地面に星の模様を落とす。静か。守られている。"
        }
      }]
    }
  ]
}
