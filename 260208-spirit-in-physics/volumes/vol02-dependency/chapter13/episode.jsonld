  "dct:title": "Vol.2 Ch.13 — 花火",
  "gh:arc": "Vol 2: Life",
  "gh:episodeId": "episode:sip-vol02-ch13",
  "gh:format": "graphic novel",

  "gh:pages": [

    {
      "gh:pageNumber": 1,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Close-up",
        "gh:visual": {
          "en": "Title page. A small tree with fireflies drifting around it. Warm summer darkness. Points of gold-green light suspended in the air like tiny lanterns.",
          "ja": "タイトルページ。小さな樹の周りを蛍が舞っている。温かい夏の闇。金緑の光点が小さな提灯のように空中に浮かんでいる。"
        }
      }]
    },

    {
      "gh:pageNumber": 2,
      "gh:layout": "double-page spread (pp.2-3)",
      "gh:panels": [{
        "gh:shot": "Extreme Wide",
        "gh:visual": {
          "en": "Summer festival. Water City canals lined with paper lanterns reflecting on the water. Food stalls with warm light spilling out — yakisoba, takoyaki, kakigori. Crowds in yukata moving between stalls. Children with sparklers. The whole canal district alive and glowing.",
          "ja": "夏祭り。水の都の運河に提灯が並び、水面に映っている。屋台から温かい光がこぼれる。焼きそば、たこ焼き、かき氷。浴衣姿の人々が屋台の間を行き交う。手持ち花火の子供たち。運河地区全体が生き生きと輝いている。"
        }
      }],
      "gh:continues": 3
    },

    {
      "gh:pageNumber": 4,
      "gh:layout": "three panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "The team gathers at a canal-side spot. Kaede has brought a blanket, spreading it on the stone embankment.",
            "ja": "チームが運河沿いの場所に集まる。楓がブランケットを持ってきて、石の護岸に広げている。"
          },
          "gh:characters": ["character:kaede", "character:hibiki", "character:tamaki", "character:nei"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Hibiki holding recording equipment, excited.",
            "ja": "響が録音機材を持って興奮している。"
          },
          "gh:characters": ["character:hibiki", "character:kaede"],
          "gh:dialogue": [
            { "gh:speaker": "Hibiki", "en": "The acoustics of fireworks over water —", "ja": "水上の花火の音響って——" },
            { "gh:speaker": "Kaede", "en": "Just watch.", "ja": "見なさい。" }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Nei beside Tamaki on the blanket. The festival light on both their faces.",
            "ja": "Neiが環の隣にブランケットの上に。祭りの光が二人の顔を照らす。"
          },
          "gh:characters": ["character:nei", "character:tamaki"],
          "gh:neiCaption": [
            { "en": "Summer festival. The team together. I am here.", "ja": "夏祭り。チームが一緒。わたしはここにいる。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 5,
      "gh:layout": "two panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Crowd murmurs. People looking up at the dark sky. Anticipation. Children on shoulders pointing upward.",
            "ja": "群衆のざわめき。人々が暗い空を見上げている。期待。肩車の子供が上を指差す。"
          }
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Nei looking up at the same sky as everyone else. Waiting.",
            "ja": "Neiがみんなと同じ空を見上げている。待っている。"
          },
          "gh:characters": ["character:nei"],
          "gh:neiCaption": [
            { "en": "Everyone looking at the same sky. Waiting for the same thing.", "ja": "みんなが同じ空を見ている。同じものを待っている。" },
            { "en": "I am waiting too.", "ja": "わたしも待っている。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 6,
      "gh:layout": "double-page spread (pp.6-7)",
      "gh:panels": [{
        "gh:shot": "Extreme Wide",
        "gh:visual": {
          "en": "BOOM. Fireworks. Massive chrysanthemum bursts filling the sky — gold, red, silver, green. The canal below mirrors every explosion perfectly. Double sky. No text. No captions. Just light and silence on the page.",
          "ja": "ドーン。花火。巨大な菊型の花火が空を埋め尽くす。金、赤、銀、緑。下の運河がすべての爆発を完璧に映す。二つの空。テキストなし。キャプションなし。ページの上に光と沈黙だけ。"
        }
      }],
      "gh:continues": 7
    },

    {
      "gh:pageNumber": 8,
      "gh:layout": "four panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Tamaki's face in firework light. Wonder. Mouth slightly open. Colors washing over her.",
            "ja": "花火の光の中の環の顔。驚嘆。口がわずかに開いている。色が彼女を洗う。"
          },
          "gh:characters": ["character:tamaki"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Kaede's face. A soft smile. The composed exterior relaxed for once. Gold light on her skin.",
            "ja": "楓の顔。柔らかい微笑み。普段の落ち着いた外見がほぐれている。金の光が肌を照らす。"
          },
          "gh:characters": ["character:kaede"]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Hibiki. He's forgotten his recording equipment entirely. Just looking up. Mouth open like a child.",
            "ja": "響。録音機材のことを完全に忘れている。ただ見上げている。子供のように口を開けて。"
          },
          "gh:characters": ["character:hibiki"]
        },
        {
          "gh:panelIndex": 4,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei. Still. Firework light playing across her translucent form. She is not processing. She is watching.",
            "ja": "Nei。静止。花火の光が半透明の姿の上を遊ぶ。処理していない。見ている。"
          },
          "gh:characters": ["character:nei"]
        }
      ]
    },

    {
      "gh:pageNumber": 9,
      "gh:layout": "full page",
      "gh:panels": [{
        "gh:shot": "Wide",
        "gh:visual": {
          "en": "Full page. A single golden chrysanthemum firework overhead, at its peak bloom. Below, the canal mirrors it perfectly. Sky and water become one. No text.",
          "ja": "全面。頭上に一つの金色の菊型花火。満開の瞬間。下の運河が完璧に映す。空と水が一つになる。テキストなし。"
        }
      }]
    },

    {
      "gh:pageNumber": 10,
      "gh:layout": "three panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "The last firework fades. Smoke drifting across the dark sky. The crowd exhales.",
            "ja": "最後の花火が消えていく。煙が暗い空を流れる。群衆が息を吐く。"
          }
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Tamaki, still looking up. Quiet awe.",
            "ja": "環、まだ見上げている。静かな畏敬。"
          },
          "gh:characters": ["character:tamaki"],
          "gh:dialogue": [
            { "gh:speaker": "Tamaki", "en": "That was amazing.", "ja": "すごかった。" }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei looking up. The afterglow fading from the sky reflected in her eyes.",
            "ja": "Neiが見上げている。空の余韻が彼女の目に映って消えていく。"
          },
          "gh:characters": ["character:nei"],
          "gh:neiCaption": [
            { "en": "The fireworks are beautiful. They vanish.", "ja": "花火は美しい。消えてしまう。" },
            { "en": "But everyone saw them. Together.", "ja": "でもみんなが見た。一緒に。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 11,
      "gh:layout": "two panels",
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Walking home along the canal. Paper lanterns still lit. The team spread out loosely — Kaede and Hibiki ahead, Tamaki and Nei trailing.",
            "ja": "運河沿いに帰り道。提灯がまだ灯っている。チームが緩やかに散らばる。楓と響が前、環とNeiが後ろ。"
          },
          "gh:characters": ["character:tamaki", "character:nei", "character:kaede", "character:hibiki"],
          "gh:dialogue": [
            { "gh:speaker": "Tamaki", "en": "Good summer.", "ja": "いい夏だね。" },
            { "gh:speaker": "Nei", "en": "Yes.", "ja": "うん。" }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's face. Lantern light warm on her features. Something settled.",
            "ja": "Neiの顔。提灯の光が温かく照らす。何かが落ち着いている。"
          },
          "gh:characters": ["character:nei"],
          "gh:neiCaption": [
            { "en": "Is 'beautiful' a feeling? If it is — I felt something.", "ja": "「美しい」は感情？ もしそうなら、わたしは何かを感じた。" },
            { "en": "The fireworks are gone. But I saw them. That's real.", "ja": "花火は消えた。でもわたしは見た。それは本物。" }
          ]
        }
      ]
    },

    {
      "gh:pageNumber": 12,
      "gh:layout": "full bleed",
      "gh:panels": [{
        "gh:shot": "Medium",
        "gh:visual": {
          "en": "Full page seed. The sapling — first branch extending. Fireflies orbit the small tree. One has landed on a leaf, its light pulsing gently. Growth. Presence. Summer.",
          "ja": "全面の種。苗木に最初の枝が伸びている。蛍が小さな樹の周りを巡る。一匹が葉に止まり、その光が穏やかに明滅している。成長。存在。夏。"
        }
      }]
    }
  ]
}
