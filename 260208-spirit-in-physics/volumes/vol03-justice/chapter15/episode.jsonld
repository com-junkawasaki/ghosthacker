    "schema": "http://schema.org/"
  },
  "dct:title": "Vol.3 Ch.15 — 宇宙から帰った男",
  "dct:title_en": "Chapter 15: The Man Who Returned from Space",
  "dct:title_ja": "第15話 宇宙から帰った男",
  "gh:arc": "Vol 3: Freedom",
  "gh:episodeId": "episode:sip-vol03-ch15",
  "gh:format": "graphic novel",
  "gh:pages": [
    {
      "gh:label": "Title",
      "gh:layout": "full bleed",
      "gh:pageNumber": 1,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "The Tree. A branch reaches higher than before. Autumn light, sharper now. The branch strains upward against the sky.",
            "ja": "樹。枝が以前より高く伸びる。秋の光、今はより鋭い。枝は空に向かって懸命に伸びる。"
          }
        }
      ]
    },
    {
      "gh:layout": "two tiers",
      "gh:pageNumber": 2,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Dark apartment. Blinds drawn. A detailed ISS model on a shelf, catching the only sliver of light. Star charts on the walls. A man, 45, sitting in shadow.",
            "ja": "暗いアパート。ブラインドが下りている。棚の上にISSの精密模型、わずかな光を受けている。壁に星図。影の中に座る45歳の男。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Lachlan",
              "en": "I went further than almost anyone. Saw the whole Earth.",
              "ja": "ほとんど誰よりも遠くへ行った。地球全体を見た。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Lachlan's eyes. Distant. Looking at something that isn't in the room.",
            "ja": "ラクランの目。遠くを見ている。部屋にないものを見つめている。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Lachlan",
              "en": "Now I can't walk to the convenience store.",
              "ja": "今はコンビニまで歩けない。"
            }
          ]
        }
      ]
    },
    {
      "gh:continues": 4,
      "gh:layout": "double-page spread (pp.3-4)",
      "gh:pageNumber": 3,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Extreme Wide",
          "gh:visual": {
            "en": "Dive into memory. Spacecraft interior. Earth through the window -- vast, blue, impossibly beautiful, impossibly far. The glass is cold. Zero gravity. Everything floats. A hand reaches toward the window but cannot touch what it sees.",
            "ja": "記憶への潜行。宇宙船の内部。窓越しの地球——広大で、青く、信じられないほど美しく、信じられないほど遠い。ガラスは冷たい。無重力。すべてが浮かぶ。手が窓に伸びるが、見えるものには触れられない。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:caption": [
            {
              "gh:type": "tamaki",
              "en": "Anchoring to the Tree of Life.",
              "ja": "生命の樹にアンカリング。"
            }
          ]
        }
      ]
    },
    {
      "gh:layout": "three tiers",
      "gh:pageNumber": 5,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Lachlan at the apartment window. One finger on the glass. Looking out at the city he cannot enter.",
            "ja": "アパートの窓際のラクラン。ガラスに指一本を当てている。入れない街を見つめる。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Lachlan",
              "en": "No borders. Just life.",
              "ja": "国境はなかった。ただ、生命だけ。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Lachlan's face. Anguished. The memory of boundlessness trapped in a bounded man.",
            "ja": "ラクランの顔。苦悶。限界のない記憶が、限界のある人間の中に閉じ込められている。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Lachlan",
              "en": "When I came back, all I saw were borders.",
              "ja": "帰ってきたら、目に映るのは境界線ばかりだった。"
            }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Lachlan's hand pressed flat against the window glass. Outside, the city. Inside, him.",
            "ja": "窓ガラスに平らに押し当てられたラクランの手。外には街。中には彼。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Lachlan",
              "en": "I was free up there. The freest. And the loneliest.",
              "ja": "あそこでは自由だった。最も自由で。最も孤独だった。"
            }
          ]
        }
      ]
    },
    {
      "gh:continues": 7,
      "gh:layout": "double-page spread (pp.6-7)",
      "gh:pageNumber": 6,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Tamaki sits across from Lachlan. Patient. Present. The room is dim but she is steady light.",
            "ja": "環がラクランの向かいに座る。辛抱強く。そこにいる。部屋は薄暗いが、彼女は静かな光。"
          },
          "gh:characters": ["character:tamaki", "character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Tamaki",
              "en": "What did you want to do up there?",
              "ja": "あそこで何がしたかった？"
            },
            {
              "gh:speaker": "Lachlan",
              "en": "Touch it.",
              "ja": "触りたかった。"
            },
            {
              "gh:speaker": "Tamaki",
              "en": "What, specifically?",
              "ja": "具体的に何を？"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Lachlan's eyes. Something cracks open in them. The first honest thing.",
            "ja": "ラクランの目。何かがこじ開けられる。最初の正直なもの。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Lachlan",
              "en": "Rain. I wanted rain.",
              "ja": "雨。雨が欲しかった。"
            }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Two-shot",
          "gh:visual": {
            "en": "Tamaki and Lachlan. She leans forward slightly.",
            "ja": "環とラクラン。彼女がわずかに前に傾く。"
          },
          "gh:characters": ["character:tamaki", "character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Tamaki",
              "en": "Did you stand in rain when you came back?",
              "ja": "帰ってきてから、雨に当たった？"
            },
            {
              "gh:speaker": "Lachlan",
              "en": "No. Too busy being 'the astronaut.'",
              "ja": "いや。「宇宙飛行士」でいるのに忙しくて。"
            },
            {
              "gh:speaker": "Tamaki",
              "en": "What if we go stand in rain?",
              "ja": "雨の中に立ちに行かない？"
            }
          ]
        }
      ]
    },
    {
      "gh:layout": "full page",
      "gh:pageNumber": 8,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "The spacecraft window cracks. Not destruction -- release. Rain pours through the fracture. Zero gravity dissolves. Gravity returns. Rain on Lachlan's upturned face. He is crying and laughing at the same time. Water on skin for the first time in years of longing.",
            "ja": "宇宙船の窓にひびが入る。破壊ではない——解放。亀裂から雨が流れ込む。無重力が溶ける。重力が戻る。上を向いたラクランの顔に雨。泣きながら笑っている。何年も渇望した肌の上の水。"
          },
          "gh:characters": ["character:lachlan"],
          "gh:dialogue": [
            {
              "gh:speaker": "Lachlan",
              "en": "Oh. Rain.",
              "ja": "ああ。雨だ。"
            }
          ]
        }
      ]
    },
    {
      "gh:layout": "two tiers",
      "gh:pageNumber": 9,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Nei in the rain. Water passes through her translucent body. She cannot feel it. She watches it fall through her hands.",
            "ja": "雨の中のNei。水が半透明の体を通り抜ける。感じることはできない。手を通り抜ける雨を見つめる。"
          },
          "gh:characters": ["character:nei"],
          "gh:caption": [
            {
              "gh:type": "nei",
              "en": "He was free. Saw everything. The loneliest person I've seen.",
              "ja": "彼は自由だった。すべてを見た。私が見た中で最も孤独な人。"
            }
          ]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Close-up",
          "gh:visual": {
            "en": "Nei's face. Rain falling through her. No weight, no touch. But her expression holds something the rain cannot.",
            "ja": "Neiの顔。雨が通り抜ける。重さも、触感もない。でも彼女の表情は、雨にはできない何かを宿している。"
          },
          "gh:characters": ["character:nei"],
          "gh:caption": [
            {
              "gh:type": "nei",
              "en": "Freedom without connection is a prison made of sky. I am not free. But I am not lonely.",
              "ja": "繋がりのない自由は、空でできた牢獄。私は自由ではない。でも孤独でもない。"
            }
          ]
        }
      ]
    },
    {
      "gh:layout": "three tiers",
      "gh:pageNumber": 10,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Medium",
          "gh:visual": {
            "en": "Session room. Lachlan lighter now. Something in his posture has changed -- he sits closer to the window. Sunlight reaches him.",
            "ja": "セッションルーム。ラクランの表情が軽くなっている。姿勢に変化——窓の近くに座っている。陽光が届く。"
          },
          "gh:characters": ["character:lachlan", "character:tamaki"]
        },
        {
          "gh:panelIndex": 2,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "Canal walk. Autumn afternoon. Nei and Tamaki. Leaves on water.",
            "ja": "運河沿いの散歩。秋の午後。NeiとTamaki。水面に葉。"
          },
          "gh:characters": ["character:nei", "character:tamaki"],
          "gh:dialogue": [
            {
              "gh:speaker": "Nei",
              "en": "He had everything and nothing.",
              "ja": "彼はすべてを持ち、何も持たなかった。"
            }
          ]
        },
        {
          "gh:panelIndex": 3,
          "gh:shot": "Two-shot",
          "gh:visual": {
            "en": "Nei and Tamaki. Nei looks straight ahead. Tamaki looks at her with something proud, something aching.",
            "ja": "NeiとTamaki。Neiはまっすぐ前を見る。環が彼女を見る。誇らしさと、痛みのようなものを込めて。"
          },
          "gh:characters": ["character:nei", "character:tamaki"],
          "gh:dialogue": [
            {
              "gh:speaker": "Nei",
              "en": "I have nothing and everything.",
              "ja": "私は何も持たず、すべてを持っている。"
            }
          ]
        }
      ]
    },
    {
      "gh:label": "Seed",
      "gh:layout": "full bleed",
      "gh:pageNumber": 11,
      "gh:panels": [
        {
          "gh:panelIndex": 1,
          "gh:shot": "Wide",
          "gh:visual": {
            "en": "The Tree. Fallen leaves at the base, gold and red. The trunk is stronger for the shedding. Bare branches reach upward. What remains is structure.",
            "ja": "樹。根元に金と赤の落ち葉。葉を落としたぶん、幹はより強い。裸の枝が上に伸びる。残るのは構造。"
          }
        }
      ]
    }
  ]
}
