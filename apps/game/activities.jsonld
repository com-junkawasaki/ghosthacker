{
  "@context": {
    "@version": 1.1,
    "id": "@id",
    "type": "@type",
    "ex": "https://ghosthacker.example.com/game#",
    "cpm": "https://example.org/cpm#",
    "dct": "http://purl.org/dc/terms/",
    "name": "dct:title",
    "description": "dct:description",
    "dependsOn": {"@id": "cpm:dependsOn", "@container": "@set"},
    "produces": {"@id": "cpm:produces", "@container": "@set"}
  },
  "@graph": [
    {
      "id": "ex:GenerateGhost",
      "type": "ex:Activity",
      "name": "Generate Ghost",
      "description": "性格診断・価値観・感情反応スタイルからゴーストを生成",
      "dependsOn": [],
      "produces": [{"@id": "ex:Ghost"}]
    },
    {
      "id": "ex:SolveTimelinePuzzle",
      "type": "ex:Activity",
      "name": "Solve Timeline Puzzle",
      "description": "イベントカードを時系列順に並び替える",
      "dependsOn": [{"@id": "ex:GenerateGhost"}],
      "produces": [{"@id": "ex:TimelineOrder"}]
    },
    {
      "id": "ex:SolveCausalityPuzzle",
      "type": "ex:Activity",
      "name": "Solve Causality Puzzle",
      "description": "イベント間の因果関係を修正する",
      "dependsOn": [{"@id": "ex:SolveTimelinePuzzle"}],
      "produces": [{"@id": "ex:CausalLinks"}]
    },
    {
      "id": "ex:SolveEmotionPuzzle",
      "type": "ex:Activity",
      "name": "Solve Emotion Puzzle",
      "description": "イベントに適切な感情ラベルを割り当てる",
      "dependsOn": [{"@id": "ex:SolveCausalityPuzzle"}],
      "produces": [{"@id": "ex:EmotionLabels"}]
    },
    {
      "id": "ex:UpdateGhostState",
      "type": "ex:Activity",
      "name": "Update Ghost State",
      "description": "パズル操作結果に基づいてゴースト状態を更新",
      "dependsOn": [{"@id": "ex:SolveEmotionPuzzle"}],
      "produces": [{"@id": "ex:UpdatedGhostState"}]
    },
    {
      "id": "ex:GenerateInsight",
      "type": "ex:Activity",
      "name": "Generate Insight",
      "description": "修正後の因果グラフから気づきモノローグを生成",
      "dependsOn": [{"@id": "ex:UpdateGhostState"}],
      "produces": [{"@id": "ex:GhostInsight"}],
      "status": "implemented"
    },
    {
      "id": "ex:CompleteSession",
      "type": "ex:Activity",
      "name": "Complete Session",
      "description": "セッションを完了し、リフレクションを追加",
      "dependsOn": [{"@id": "ex:GenerateInsight"}],
      "produces": [{"@id": "ex:CompletedSession"}],
      "status": "implemented"
    }
  ]
}

