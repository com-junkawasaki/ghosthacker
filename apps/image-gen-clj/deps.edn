{:paths ["src" "resources"]

 ;; Ghost Hacker image-gen — cljc replacement for apps/image-gen (Python/
 ;; Diffusers-on-MPS FastAPI service). See ADR-2607131400: only the plain
 ;; txt2img /generate-panel path is migrated here. Delegates the actual
 ;; fleet dispatch to kotoba-lang/murakumo's own hardened render client
 ;; (murakumo.infer.gateway/generate-image!, murakumo.infer.media/run-job!
 ;; underneath) rather than reimplementing it — that library already has
 ;; real crash-recovery (consecutive-miss detection, /queue cross-check)
 ;; that this repo's earlier draft duplicated ad hoc. /generate-cinematic
 ;; (-fast) and IP-Adapter reference conditioning stay on the Python
 ;; service for now (see README "Known gaps" — RealVisXL_V4.0[-Lightning]
 ;; checkpoints and a verified IP-Adapter weight file are not confirmed
 ;; present on the fleet nodes; faking either would silently change output).
 :deps
 {kotoba-lang/murakumo {:local/root "../../../../kotoba-lang/murakumo"}
  kotoba-lang/bytes    {:local/root "../../../../kotoba-lang/bytes"}
  ;; murakumo.infer.media/.gateway/.fleet/.ssh's own deps — kotoba-lang/
  ;; murakumo's deps.edn is the bb-facing one and doesn't declare these
  ;; (bb has them built in); the JVM classpath needs them as real Maven
  ;; deps (org.babashka/http-client is the standalone-published coordinate
  ;; for babashka.http-client, confirmed 2026-07-13 — babashka/http-client
  ;; is NOT the right artifact id).
  babashka/process         {:mvn/version "0.5.22"}
  org.babashka/http-client {:mvn/version "0.4.22"}
  cheshire/cheshire        {:mvn/version "5.13.0"}

  http-kit/http-kit   {:mvn/version "2.8.0"}
  metosin/reitit-ring {:mvn/version "0.7.2"}
  ring/ring-core      {:mvn/version "1.12.2"}
  metosin/jsonista    {:mvn/version "0.3.11"}
  org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {:run {:main-opts ["-m" "ghosthacker.image-gen.server"]}}}
