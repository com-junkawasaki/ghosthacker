  "id": "https://gftd.ai/goal/epub-editor-wellbecoming",
  "type": "cpm:Goal",
  "name": "Enable users to create and edit EPUB books with AI assistance",
  "description": "Users achieve well-becoming through intuitive EPUB editing experience with AI-powered writing assistance. The tool enables seamless creation, editing, and export of EPUB books with rich text editing, chapter management, media handling, and AI-powered features like text generation, summarization, proofreading, and translation.",
  "createdAt": "2025-01-27T00:00:00Z",
  "updatedAt": "2025-01-27T00:00:00Z",
  
  "targetUser": {
    "@id": "https://gftd.ai/user/individual-author",
    "type": "cpm:PersonType",
    "name": "Individual Author",
    "description": "Single user creating and editing EPUB books for personal use"
  },
  
  "objective": [
    {
      "id": "https://gftd.ai/objective/intuitive-editing",
      "name": "Intuitive EPUB Editing",
      "description": "Provide WYSIWYG editing experience for EPUB content using Tiptap editor"
    },
    {
      "id": "https://gftd.ai/objective/ai-assistance",
      "name": "AI-Powered Writing Assistance",
      "description": "Integrate AI Generator for text generation, summarization, proofreading, and translation"
    },
    {
      "id": "https://gftd.ai/objective/structure-management",
      "name": "Structure Management",
      "description": "Enable easy management of chapters, metadata, and media assets"
    },
    {
      "id": "https://gftd.ai/objective/epub-export",
      "name": "EPUB Export",
      "description": "Export edited content to standard EPUB 3.0 format"
    }
  ],
  
  "successCriteria": [
    {
      "id": "https://gftd.ai/criteria/editing-performance",
      "name": "Editing Performance",
      "description": "Smooth editing experience with <100ms response time for text operations"
    },
    {
      "id": "https://gftd.ai/criteria/epub-compliance",
      "name": "EPUB Compliance",
      "description": "Exported EPUB files conform to EPUB 3.0 specification"
    },
    {
      "id": "https://gftd.ai/criteria/ai-quality",
      "name": "AI Quality",
      "description": "AI-generated content meets user expectations for quality and relevance"
    }
  ]
}

