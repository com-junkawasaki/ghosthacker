{
  "name": "storyboard-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --threshold error --diagnostic-sources js,svelte",
