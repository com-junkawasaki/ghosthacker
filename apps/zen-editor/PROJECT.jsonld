{
  "@context": {
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "project": "https://gftd.ai/project/ontology/"
  },
  "@type": "gh:Project",
  "name": "Ghost Hacker Zen Editor",
  "description": "A dedicated local editor for Ghost Hacker story production, featuring Zen mode text editing and Graph Topology visualization.",
  "status": "A2A_Active",
  "data_integration": {
    "manifest": "251022/wattpad/manifest.json integrated for file navigation",
    "topology": "251022/ghost-hacker.jsonld parsed for world-building visualization",
    "manuscripts": "Full access to Wattpad episode parts"
  },
  "ai_integration": {
    "openrouter": "Claude 3.5 Sonnet driven persona emulation (A2A)",
    "hume": "Real-time emotion vector mapping for characters and settings"
  },
  "technologies": [
    "Tauri",
    "SvelteKit",
    "Prosemirror",
    "Go",
    "gRPC",
    "Temporal",
    "Kubernetes",
    "OpenRouter",
    "Hume AI",
    "Git",
    "MCP (Model Context Protocol)"
  ],
  "architecture": {
    "frontend": {
      "framework": "SvelteKit",
      "ui_shell": "Tauri",
      "editor": "Prosemirror (Svelte-integrated)",
      "visualization": "Zen Graph Topology (Custom SVG/Canvas)",
      "communication": "ConnectRPC (gRPC-web)"
    },
    "backend": {
      "language": "Go",
      "api": "gRPC Server (MCP-enabled)",
      "workflow_engine": "Temporal",
      "orchestration": "Kubernetes (k8s)"
    },
    "integrations": [
      {
        "name": "Git",
        "purpose": "Document version control and branching"
      },
      {
        "name": "OpenRouter",
        "purpose": "Entity extraction and story graph generation"
      },
      {
        "name": "Hume AI",
        "purpose": "Semantic emotion analysis of the narrative"
      },
      {
        "name": "MCP (Model Context Protocol)",
        "purpose": "Standardized tool invocation for AI and backend services"
      }
    ]
  },
  "features": [
    {
      "name": "Zen Mode",
      "description": "Distraction-free markdown editing using Prosemirror with Svelte bindings."
    },
    {
      "name": "Graph Topology Mode",
      "description": "Live visualization of story entities and relationships. Now supporting Block-level granularity and rich relationship types (contains, precedes, appearsIn, translationOf)."
    },
    {
      "name": "Multi-Agent Interaction (A2A)",
      "description": "Conversational UI to talk with characters, environments, and objects. Supporting block-level context for precise interactions."
    },
    {
      "name": "Git Versioning",
      "description": "Integrated git workflows for branch management and history tracking."
    }
  ],
  "roadmap": [
    {
      "step": "1. Initialize Tauri + SvelteKit project structure",
      "status": "completed"
    },
    {
      "step": "2. Implement Prosemirror editor with Svelte",
      "status": "completed"
    },
    {
      "step": "3. Setup Go gRPC backend and Temporal worker",
      "status": "completed"
    },
    {
      "step": "4. Implement AI entity extraction and graph visualization",
      "status": "completed"
    },
    {
      "step": "5. Integrate Hume AI and Git workflows",
      "status": "completed"
    },
    {
      "step": "6. Refactor backend to MCP + gRPC Connect architecture",
      "status": "completed"
    },
    {
      "step": "7. Implement A2A Multi-Agent Interaction UI",
      "status": "completed"
    },
    {
      "step": "8. Implement Block-level node extraction and categorization",
      "status": "completed"
    },
    {
      "step": "9. Implement LLM Link Analysis Tool (MCP)",
      "status": "completed"
    },
    {
      "step": "10. Implement GraphRAG Configuration (Pattern 1 + Pattern 5)",
      "status": "completed"
    }
  ]
}
