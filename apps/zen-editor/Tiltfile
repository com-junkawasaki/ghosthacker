# Tiltfile for Zen Editor

# Frontend (SvelteKit + pnpm)
local_resource(
    'zen-frontend',
    cmd='pnpm run dev',
    deps=['src', 'vite.config.ts', 'svelte.config.js', 'package.json'],
    links=['http://localhost:1420']
)

# Backend (Go Server)
local_resource(
    'zen-backend-server',
    cmd='cd backend && export WORKSPACE_ROOT=../../.. && export PORT=8080 && go run cmd/server/main.go',
    deps=['backend/cmd/server', 'backend/internal', 'backend/proto', 'backend/go.mod', 'backend/go.sum'],
    links=['http://localhost:8080/health']
)

# Backend (Go Worker)
local_resource(
    'zen-backend-worker',
    cmd='cd backend && export WORKSPACE_ROOT=../../.. && go run cmd/worker/main.go',
    deps=['backend/cmd/worker', 'backend/internal', 'backend/proto', 'backend/go.mod', 'backend/go.sum']
)

# Neo4j Database
docker_compose('docker-compose.yaml')
