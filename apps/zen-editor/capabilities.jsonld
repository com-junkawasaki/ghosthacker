{
  "@context": {
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "capability": "https://gftd.ai/capability/ontology/"
  },
  "@type": "gh:CapabilitySet",
  "name": "Zen Editor Capabilities",
  "capabilities": [
    {
      "@id": "cap:topology_exploration",
      "name": "Graph Topology Exploration",
      "description": "Visualize and navigate story entities and relationships in a 2D/3D force-directed graph.",
      "acceptance_criteria": [
        "Nodes and edges are loaded from the backend on startup.",
        "Selecting a node highlights it and shows its details in the right pane.",
        "Switching viewpoints (Timeline, Characters, etc.) updates the graph layout and camera."
      ]
    },
    {
      "@id": "cap:file_management",
      "name": "Direct File Management",
      "description": "Browse and edit raw JSON-LD and Markdown files within the project data directory.",
      "acceptance_criteria": [
        "File tree is visible in the sidebar when 'Files' mode is active.",
        "Clicking a file opens its content in the Zen Editor.",
        "Saving changes in the editor persists the data back to the local filesystem via gRPC."
      ]
    },
    {
      "@id": "cap:scene_assembler",
      "name": "3D Scene Assembler",
      "description": "Compose 3D scenes using GLTF models and spatial positioning.",
      "acceptance_criteria": [
        "3D nodes with gltfPath are rendered in the Assembler view.",
        "Nodes can be selected and their 3D properties (position, rotation, scale) are visible.",
        "3D transform updates are saved to the backend."
      ]
    },
    {
      "@id": "cap:zen_writing",
      "name": "Zen Writing Experience",
      "description": "Distraction-free writing environment with real-time feedback.",
      "acceptance_criteria": [
        "Prosemirror editor provides a clean writing interface.",
        "Emotion meters update based on the text content (Hume AI integration).",
        "Manuscript blocks are correctly sequenced and saved."
      ]
    }
  ]
}
