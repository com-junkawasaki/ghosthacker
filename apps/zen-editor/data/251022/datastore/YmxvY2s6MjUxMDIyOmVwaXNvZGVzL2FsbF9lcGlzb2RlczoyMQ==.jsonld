  "gh:content": {
    "en": "“Death isn’t an end. It’s just change,” I exhale softly. “We carry our memes forward through children, through culture, through society. That is how we are released from loneliness. His pain is that he can no longer perceive those connections.”",
    "ja": "私は視線で礼を送った。"
  },
  "gh:index": 21
}