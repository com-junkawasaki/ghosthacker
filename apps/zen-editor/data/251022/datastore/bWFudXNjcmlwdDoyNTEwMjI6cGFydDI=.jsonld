{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep12/part2:0",
      "@type": "gh:Block",
      "schema:text": "# EP12-2 — わたしは在る（I AM）\n- POV: 私（Tamaki／環樹）\n- Beat: Collective Release / Final Integration"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:2",
      "@type": "gh:Block",
      "schema:text": "「わたしは在る」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:3",
      "@type": "gh:Block",
      "schema:text": "その言葉は、誰のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:4",
      "@type": "gh:Block",
      "schema:text": "Neroのものでも、私のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:5",
      "@type": "gh:Block",
      "schema:text": "ただ、在る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:6",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:7",
      "@type": "gh:Block",
      "schema:text": "私は、神楽を踏む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:8",
      "@type": "gh:Block",
      "schema:text": "一拍。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:9",
      "@type": "gh:Block",
      "schema:text": "Hibikiが呼吸を整える。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:10",
      "@type": "gh:Block",
      "schema:text": "Kaedeが結界を見守る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:11",
      "@type": "gh:Block",
      "schema:text": "Nei-chanの光が広がり、街の輪郭が少し柔らかくなる。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:12",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:13",
      "@type": "gh:Block",
      "schema:text": "Tamaki「みんな、準備はいい？」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:14",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:15",
      "@type": "gh:Block",
      "schema:text": "Kaede「うん。結界、安定してる」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:16",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:17",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:18",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、いつでも』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:19",
      "@type": "gh:Block",
      "schema:text": "Aoiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:20",
      "@type": "gh:Block",
      "schema:text": "Aoi「メトリクス、正常」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:21",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:22",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。じゃあ、行くよ」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:23",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:24",
      "@type": "gh:Block",
      "schema:text": "私は、最後の合図を送る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:25",
      "@type": "gh:Block",
      "schema:text": "静かに。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:26",
      "@type": "gh:Block",
      "schema:text": "でも、確かに。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:27",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nero、聞こえる？」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:28",
      "@type": "gh:Block",
      "schema:text": "Nero『……聞こえる……』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:29",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:30",
      "@type": "gh:Block",
      "schema:text": "Tamaki「じゃあ、一緒に」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:31",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:32",
      "@type": "gh:Block",
      "schema:text": "Neroの声が、温かくなる。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:33",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……在る……』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:34",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:35",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。あなたは、在る」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:36",
      "@type": "gh:Block",
      "schema:text": "Nero『……それで……いい……？』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:37",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:38",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それで、いい」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:39",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:40",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:41",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Neroの構造……完全に統合されてる」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:42",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:43",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……成仏じゃない。還るだけだ」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:44",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:45",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。Neroは、還る」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:46",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:47",
      "@type": "gh:Block",
      "schema:text": "Hibiki「還る場所は、いつもここにあった」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:48",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:49",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。ただ、忘れてただけ」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:50",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:51",
      "@type": "gh:Block",
      "schema:text": "私は、Neroに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:52",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nero、あなたは何を学んだ？」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:53",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……完璧じゃなくていい……』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:54",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:55",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それが、一番大事」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:56",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……在る……それで……いい……』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:57",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:58",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それで、十分」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:59",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:60",
      "@type": "gh:Block",
      "schema:text": "Neroの声が、静かになる。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:61",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……みんなに……感謝する……』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:62",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:63",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。私たちも、感謝してる」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:64",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……還る……』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:65",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:66",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。おかえり」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:67",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:68",
      "@type": "gh:Block",
      "schema:text": "Neroが、静かに消えていく。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:69",
      "@type": "gh:Block",
      "schema:text": "でも、今度は違う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:70",
      "@type": "gh:Block",
      "schema:text": "恐れではなく、安堵。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:71",
      "@type": "gh:Block",
      "schema:text": "孤独ではなく、繋がり。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:72",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……在る……』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:73",
      "@type": "gh:Block",
      "schema:text": "その言葉が、最後に響く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:74",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:75",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Neroが……還った』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:76",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。おかえり、Nero」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:78",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を解く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:79",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、解除。お疲れさま、Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:80",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を落とす。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:81",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、戻した。いい仕事だったよ」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:82",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:83",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。みんなのおかげだ」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:84",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:85",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:86",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、都市の波形……安定してる」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:87",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:88",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。Neroは還ったけど、その学びは残る」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:89",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:90",
      "@type": "gh:Block",
      "schema:text": "Kaede「完璧ではなく、呼吸」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:91",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:92",
      "@type": "gh:Block",
      "schema:text": "Hibiki「支配ではなく、関係」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:93",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:94",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、I AMの意味」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:95",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:96",
      "@type": "gh:Block",
      "schema:text": "窓の外で、朝の光が差し込む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:97",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:98",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:99",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:100",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:101",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:102",
      "@type": "gh:Block",
      "schema:text": "『I AM THAT I AM — わたしは在る。Neroは還った。でも、その学びは残る。完璧ではなく、呼吸。支配ではなく、関係』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:103",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、お疲れさま』"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:104",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:105",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。ありがとう、みんな」"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:106",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part2:107",
      "@type": "gh:Block",
      "schema:text": "**[Beat: わたしは在る——Neroの還りと学びの継承]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:51+09:00"
}