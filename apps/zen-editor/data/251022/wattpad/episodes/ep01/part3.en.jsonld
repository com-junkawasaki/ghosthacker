{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep01/part3.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP1-3 — Afterglow (Question)\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Resolution / Afterthoughts"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:1",
      "@type": "gh:Block",
      "schema:text": "“He… was reborn.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:2",
      "@type": "gh:Block",
      "schema:text": "“Mm.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:3",
      "@type": "gh:Block",
      "schema:text": "“Tamaki, your hands are shaking.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:4",
      "@type": "gh:Block",
      "schema:text": "“A little. I’m okay.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:5",
      "@type": "gh:Block",
      "schema:text": "Outside the window, the canal sinks into orange. I place a question on my chest."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:6",
      "@type": "gh:Block",
      "schema:text": "“Did we really ‘save’ him?”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:7",
      "@type": "gh:Block",
      "schema:text": "Nei-chan smiles. “Salvation isn’t singular. When you called it ‘pain,’ I felt Elias’s wall soften. ‘Correctness’ alone left him breathless. His meme will find new connections and return to the flow. He’s a little freer of the fear of death now.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:8",
      "@type": "gh:Block",
      "schema:text": "Kaede draws her shoulders in; her voice is calm again."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:9",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Next case is already in.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:10",
      "@type": "gh:Block",
      "schema:text": "She smiles a little."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:11",
      "@type": "gh:Block",
      "schema:text": "I laugh. “Then let’s start the next one from ‘feeling good’ again.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:12",
      "@type": "gh:Block",
      "schema:text": "I open my notebook and add a final line: ‘Questions beget relationships.’ I write Elias and Logos’s names small beside it and close the page."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:13",
      "@type": "gh:Block",
      "schema:text": "Green along the canal sings in the wind. Far away, remnants of the old elevated line fall into quiet shadow. Night deepens in the city of water, and the lattice of light glows softly."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:14",
      "@type": "gh:Block",
      "schema:text": "Nei-chan touches my shoulder. “Dropping ASC.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:15",
      "@type": "gh:Block",
      "schema:text": "“Yeah. Thank you.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:16",
      "@type": "gh:Block",
      "schema:text": "Kaede returns to comms, voice gentle: “Short rehearsal tomorrow morning?”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:17",
      "@type": "gh:Block",
      "schema:text": "“Let’s do it. A half-step rehearsal.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:18",
      "@type": "gh:Block",
      "schema:text": "Hibiki joins, his usual cheer back: “Tudo bem! Looking forward to it.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:19",
      "@type": "gh:Block",
      "schema:text": "He nods."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:20",
      "@type": "gh:Block",
      "schema:text": "On the stair landing, a quiet margin opens."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:21",
      "@type": "gh:Block",
      "schema:text": "I tap a final one-beat kagura. The sign for ending."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:22",
      "@type": "gh:Block",
      "schema:text": "Logos smiles faintly. “Will my lord be able to return?”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:23",
      "@type": "gh:Block",
      "schema:text": "“Yes. The way back is already here.”"
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:24",
      "@type": "gh:Block",
      "schema:text": "The wind turns the corner. The night is soft and strong."
    },
    {
      "@id": "block:251022:episodes/ep01/part3.en:25",
      "@type": "gh:Block",
      "schema:text": "I close my notebook and take one breath in my chest. ‘Release → afterglow’ settles, quietly."
    }
  ],
  "updatedAt": "2026-01-12T19:01:34+09:00"
}