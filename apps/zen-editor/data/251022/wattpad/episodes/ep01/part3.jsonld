  "@id": "manuscript:251022:part3",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep01/part3:0",
      "@type": "gh:Block",
      "schema:text": "# EP1-3 — 余韻（問い）\n- POV: 私（Tamaki／環樹）\n- Beat: Resolution / Afterthoughts"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:1",
      "@type": "gh:Block",
      "schema:text": "「彼は……生まれ変わりました」\n「うん」\n「Tamaki、手は震えてる」\n「少しだけ。だいじょうぶ」"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:2",
      "@type": "gh:Block",
      "schema:text": "窓の外、運河が橙に沈む。私は問いを胸に置く。\n「私たちは、本当に“救った”のかな」\nNei-chanが微笑む。「救いは一つじゃない。タマが『痛み』って呼んだとき、Eliasの壁が少し融けた気がした。正しさだけじゃ、息ができなかったんだね。彼のmemeが、また新しい繋がりを得て、流れに戻っていく。死の恐怖からも、少しだけ自由になれたはずだよ」\nKaedeが肩をすめる。彼女の声には、いつもの冷静さが戻っている。"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:3",
      "@type": "gh:Block",
      "schema:text": "Kaede「次の案件、入ってる」"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:4",
      "@type": "gh:Block",
      "schema:text": "彼女は少し微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:5",
      "@type": "gh:Block",
      "schema:text": "私は笑った。「じゃあ、次も\"いい感じ\"から始めよう」\n私は手帳を開き、最後に一行を書く。『問いは、関係を生む』。EliasとLogosの名前を小さく並べ、ページを閉じる。\n運河沿いの緑が風に鳴る。遠くで、古い高架の残滓が静かに影になっていた。水の都の夜が深まり、光の網がやわらかく灯る。\nNei-chanが肩に触れる。「ASC、落とすね」\n「うん。ありがとう」"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:6",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声は、優しい。"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:7",
      "@type": "gh:Block",
      "schema:text": "Kaede「明日の午前、短いリハ入れる？」"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:8",
      "@type": "gh:Block",
      "schema:text": "「入れよう。半歩のリハ」"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:9",
      "@type": "gh:Block",
      "schema:text": "Hibikiの声も通信に入る。彼の声には、いつもの陽気さが戻っている。"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:10",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Tudo bem! リハ、楽しみだね」"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:11",
      "@type": "gh:Block",
      "schema:text": "彼が頷く。"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:12",
      "@type": "gh:Block",
      "schema:text": "階段の踊り場に、静かな余白が生まれる。"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:13",
      "@type": "gh:Block",
      "schema:text": "私は足元で、もう一度だけ神楽を一拍。終わりの合図。\nLogosが小さく笑う。「主は、戻れると思う？」\n「うん。戻れる。戻り方は、もうここにある」"
    },
    {
      "@id": "block:251022:episodes/ep01/part3:14",
      "@type": "gh:Block",
      "schema:text": "風が角を曲がる。夜はやわらかく、強い。\n私は手帳を閉じ、胸で一呼吸。『解放→余韻』が、静かに定着する。"
    }
  ],
  "updatedAt": "2026-01-12T19:01:34+09:00"
}