  "@id": "manuscript:251022:part1",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep02/part1:0",
      "@type": "gh:Block",
      "schema:text": "# S1E2-1 — 死ねない恐怖"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:1",
      "@type": "gh:Block",
      "schema:text": "- POV: 私（Tamaki／環樹）\n- Beat: 新しい依頼"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:2",
      "@type": "gh:Block",
      "schema:text": "今回のクライアントは、死ねないことを恐れていた。"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:3",
      "@type": "gh:Block",
      "schema:text": "「私は無限に続くんですか？ このまま、何度も、何度も？」"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:4",
      "@type": "gh:Block",
      "schema:text": "彼の声は、乾いた葉が擦れるような音を立てていた。永遠の繰り返しという牢獄。その恐怖が、彼のGhostを苛んでいた。"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:5",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが私の隣で静かに告げる。『彼は、自分が個別の存在（individual）だと強く信じすぎている。だから、終わりのない輪廻が罰のように感じられるんだ』"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:6",
      "@type": "gh:Block",
      "schema:text": "「そうだね」私は同意する。「彼は、自分が宇宙そのものの一部だってことを忘れてる」"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:7",
      "@type": "gh:Block",
      "schema:text": "私たちの仕事は、彼が自分と世界の境界線を融かし、大いなる流れに還る手助けをすること。無為自然。ただ、在るがままにあること。"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:8",
      "@type": "gh:Block",
      "schema:text": "「Tamakiがいつも『いい感じ』を大切にするのは、そのためでもあるんだよね」Nei-chanが言う。"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:9",
      "@type": "gh:Block",
      "schema:text": "「うん。だって、私たちの『いい感じ』は、次の宇宙の『いい感じ』に繋がっていくから」"
    },
    {
      "@id": "block:251022:episodes/ep02/part1:10",
      "@type": "gh:Block",
      "schema:text": "自己の境界が幻想だと知れば、死も生も、ただの波になる。私はクライアントに向き直り、静かに、そして深く、呼吸を合わせた。"
    }
  ],
  "updatedAt": "2026-01-12T19:01:34+09:00"
}