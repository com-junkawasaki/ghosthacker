  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep02/part2:0",
      "@type": "gh:Block",
      "schema:text": "# S1E2-2 — 無限回廊"
    },
    {
      "@id": "block:251022:episodes/ep02/part2:1",
      "@type": "gh:Block",
      "schema:text": "- POV: 私（Tamaki／環樹）\n- Beat: Dive / Confrontation"
    },
    {
      "@id": "block:251022:episodes/ep02/part2:2",
      "@type": "gh:Block",
      "schema:text": "ダイブした先は、無限に続く廊下だった。同じ扉、同じ窓、同じ光。どこまで進んでも風景は変わらず、終わりがない。クライアントの精神は、このループに囚われている。"
    },
    {
      "@id": "block:251022:episodes/ep02/part2:3",
      "@type": "gh:Block",
      "schema:text": "『自己と世界を完全に分けて考えているんだ』Nei-chanが分析する。『だから、自己が永遠に続くという観念が、牢獄になっている』"
    },
    {
      "@id": "block:251022:episodes/ep02/part2:4",
      "@type": "gh:Block",
      "schema:text": "彼の恐怖の正体は、二元論（デュアリズム）の袋小路。私は廊下の真ん中で立ち止まり、壁に手を触れる。冷たい。けれど、幻じゃない。彼が固く信じ込んでいる現実だ。"
    },
    {
      "@id": "block:251022:episodes/ep02/part2:5",
      "@type": "gh:Block",
      "schema:text": "「この壁を、融かさないとね」"
    },
    {
      "@id": "block:251022:episodes/ep02/part2:6",
      "@type": "gh:Block",
      "schema:text": "私はASCの制御を一段階上げる。風景の粒子が粗くなり、世界の継ぎ目が見え始める。ループの綻びを探す。彼が「自分」だと思っているものの外側へ、出口を作るために。"
    }
  ],
  "updatedAt": "2026-01-12T19:01:35+09:00"
}