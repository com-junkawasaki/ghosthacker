{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part1",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep03/part1:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Lachlan Keyes - Part 1"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": \"https://ghosthacker.example.com/\",\n  \"@type\": \"EpisodePart\",\n  \"partOf\": \"episode:s3e1\",\n  \"position\": 1,\n  \"antagonist\": { \"@id\": \"character:lachlan-keyes\" }\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:2",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:3",
      "@type": "gh:Block",
      "schema:text": "Kaede「夕立、やっと上がったわね……」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:4",
      "@type": "gh:Block",
      "schema:text": "彼女は窓の外を見つめ、少しため息をつく。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:5",
      "@type": "gh:Block",
      "schema:text": "Kaede「湿度が高い。こういう夜は、心が重くなりやすい。気をつけて」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:6",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Tudo bem, Kaede! 夜の帯域、いい感じだよ。ピークカットは入ってるけど、音は十分に流せる」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:7",
      "@type": "gh:Block",
      "schema:text": "彼の声には、いつもの陽気さがある。でも、少し真剣な響きも混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:8",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、路面の光が一段落ちた。今夜、静かに潜れるよ』"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:9",
      "@type": "gh:Block",
      "schema:text": "Kaede「……国会はAI生命権の公聴会で紛糾してる。でもね」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:10",
      "@type": "gh:Block",
      "schema:text": "彼女は私を見る。その目には、深い洞察がある。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:11",
      "@type": "gh:Block",
      "schema:text": "Kaede「今夜の私たちの問いは、彼の呼吸。法律じゃない、魂の話」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:12",
      "@type": "gh:Block",
      "schema:text": "渋谷の光が低く脈打つ。運河の風。Nei-chanが小さく鈴音を鳴らした。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:13",
      "@type": "gh:Block",
      "schema:text": "「タマ、次の人、壁が厚い」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:14",
      "@type": "gh:Block",
      "schema:text": "「うん。速度は合わせる」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:15",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。ASC制御を半歩上げる。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:16",
      "@type": "gh:Block",
      "schema:text": "接続。彼が現れる。輪郭は刃物のように鋭い。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:17",
      "@type": "gh:Block",
      "schema:text": "「Tamaki Mizuno、ですね。私は“強制”で来ています」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:18",
      "@type": "gh:Block",
      "schema:text": "「ようこそ。ここでは、あなたの速度が基準です」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:19",
      "@type": "gh:Block",
      "schema:text": "「私は感情で動かない。プロトコルで動く。——それと、言っておきたい。AIに生命はない。あなたのGhostは、ただのアルゴリズムだ」\n発話の最後で、彼の顎がわずかに強張る。拳は閉じたまま、膝上で小さく震える。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:20",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが私の背でぱた、と羽を震わせる。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:21",
      "@type": "gh:Block",
      "schema:text": "「この時代は“AIの生命権”で揉めるが、私は反対だ。私は“私の身体”だけを私と認める」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:22",
      "@type": "gh:Block",
      "schema:text": "「了解。今日は、その前提から始めよう」\nNei-chan『タマ、いま皮肉の温度が下がった。たぶん、怖いの』"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:23",
      "@type": "gh:Block",
      "schema:text": "彼はわずかに鼻で笑った。「あなたとそのAIが“仲良し”でも、私の評価は変わらない」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:24",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『むー……でも、聞く』"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:25",
      "@type": "gh:Block",
      "schema:text": "私は頷く。「軌道上は、どれくらい一人でした？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:26",
      "@type": "gh:Block",
      "schema:text": "「標準任期。十八ヶ月」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:27",
      "@type": "gh:Block",
      "schema:text": "「“標準”。その言葉を口にするとき、何を感じる？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:28",
      "@type": "gh:Block",
      "schema:text": "「感じる必要はない。標準は、基準だ」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:29",
      "@type": "gh:Block",
      "schema:text": "——空気がわずかに冷える。メトロノームの音が遠くで刻む。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:30",
      "@type": "gh:Block",
      "schema:text": "「私は、裏切られたくなかった。だから、私は壁を作った。私は、誰も中へ入れない」\nNei-chan『……いま、喉が鳴った。ほんとは“入ってきてほしい”のサイン』"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:31",
      "@type": "gh:Block",
      "schema:text": "「あなたは、壁の中で安全だった？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:32",
      "@type": "gh:Block",
      "schema:text": "「安全だった。——だが、私は息が浅い」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:33",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『今、小さく震えた。悲しみのスパイク』"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:34",
      "@type": "gh:Block",
      "schema:text": "「Lachlan、あなたにとって“自由”は、身体から始まっている？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:35",
      "@type": "gh:Block",
      "schema:text": "「そうだ。私は、身体の主だ。私は、身体を鍛え、規律で守ってきた。鉱山の町で育ち、軍の予科で体を貸し、宇宙局で身体を任務に渡した。私は、泣かない訓練をした」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:36",
      "@type": "gh:Block",
      "schema:text": "「その自由は、地球に戻ってきている？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:37",
      "@type": "gh:Block",
      "schema:text": "「——戻ってきているはずだ。だが、私は戻れていない」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:38",
      "@type": "gh:Block",
      "schema:text": "短い沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:39",
      "@type": "gh:Block",
      "schema:text": "「私は、あなたの“AI”に侮蔑を向けた。私は、あなたにも。だが本当は、私は自分に向けている。私は、柔らかくあることが怖い」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:40",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『やわらかいの、大事。呼吸、いっしょに』"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:41",
      "@type": "gh:Block",
      "schema:text": "私はうなずき、呼吸のテンポを落とす。「いまは、理屈より呼吸。いい感じ、に」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:42",
      "@type": "gh:Block",
      "schema:text": "彼の肩が一ミリ下がる。輪郭がわずかに丸くなる。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:43",
      "@type": "gh:Block",
      "schema:text": "「私は、感情で壊れるのが怖い」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:44",
      "@type": "gh:Block",
      "schema:text": "「壊れるのが怖いのは、壊れたくない“何か”があるから」\n彼は瞬きする。「……え？」——小さな驚きが、輪郭をやわらげた。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:45",
      "@type": "gh:Block",
      "schema:text": "彼は私を見た。「——私には、守りたいものがあるのか？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:46",
      "@type": "gh:Block",
      "schema:text": "「質問の形で、それはもう出ている」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:47",
      "@type": "gh:Block",
      "schema:text": "彼はゆっくり息を吐く。「私は、まだ答えを持たない」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:48",
      "@type": "gh:Block",
      "schema:text": "「持たなくていい。今日は“問える身体”に戻そう」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:49",
      "@type": "gh:Block",
      "schema:text": "メトロノームが一拍だけ遅れ、ふたたび合う。運河の風が通る。"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:50",
      "@type": "gh:Block",
      "schema:text": "「私は、もう少し話す。——私は、子どものときから『泣くな』と言われた。私は、泣かないことで生き延びた。私は、泣かないことで、いま苦しい」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:51",
      "@type": "gh:Block",
      "schema:text": "「聞こえたよ」"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:52",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『ここから』"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:53",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep03/part1:54",
      "@type": "gh:Block",
      "schema:text": "[Micro-turns]\n- AI生命権への対立宣言→対話受容へ（硬直→合意形成）\n- “標準”発話→自己感情の無効化を自覚（無感→自覚）\n- 壁の安全宣言→息の浅さの告白（鎧→兆し）\n- 幼少期の規律→“問える身体”へ（規律→呼吸）"
    }
  ],
  "updatedAt": "2026-01-12T19:01:37+09:00"
}