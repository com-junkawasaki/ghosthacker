{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep03/part2:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Lachlan Keyes - Part 2"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:1",
      "@type": "gh:Block",
      "schema:text": "---\nKaede「このまま同夜で続行」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:2",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、決意に満ちている。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:3",
      "@type": "gh:Block",
      "schema:text": "Kaede「分割しない。今日で抜ける。彼の状態は、今夜が転換点」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:4",
      "@type": "gh:Block",
      "schema:text": "Hibiki「環境ノイズは低めだよ」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:5",
      "@type": "gh:Block",
      "schema:text": "彼の声は落ち着いている。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:6",
      "@type": "gh:Block",
      "schema:text": "Hibiki「護岸ライトは低輝度モード。救急航路のみ強発光。音の邪魔にならない、いい夜」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:7",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、いまがいい。彼の壁、少し揺れてる』"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:8",
      "@type": "gh:Block",
      "schema:text": "`Fortress of Self`——透明な壁が彼の周囲を囲む。内側で彼は呼吸を浅くする。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:9",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『この壁、もう“守ってない”。閉じ込めてる』"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:10",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声には、深い理解がある。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:11",
      "@type": "gh:Block",
      "schema:text": "Kaede「ジョン・ロックの自己所有……身体を唯一の所有物とする哲学。絶対境界」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:12",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:13",
      "@type": "gh:Block",
      "schema:text": "Kaede「彼はそれで生き延びた。でも今は……それが彼を閉じ込めてる」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:14",
      "@type": "gh:Block",
      "schema:text": "私は壁に触れる。冷たさは温度ではなく、意味の欠落だ。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:15",
      "@type": "gh:Block",
      "schema:text": "「Lachlan、この壁はあなたが作った？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:16",
      "@type": "gh:Block",
      "schema:text": "「はい。安全のためです。誰も中に入れない。誰も、私を裏切れない」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:17",
      "@type": "gh:Block",
      "schema:text": "「でも、誰もあなたに“触れられない”」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:18",
      "@type": "gh:Block",
      "schema:text": "彼は黙る。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:19",
      "@type": "gh:Block",
      "schema:text": "——別の記憶が射す。初めてのEVA。テザー、酸素、心拍の閾値。『身体は個人のものではなく、ミッションのものだ』訓練教官の声。テザーが切れないように、感情を切った。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:20",
      "@type": "gh:Block",
      "schema:text": "「あなたは“身体の自由”を、失うことで生き延びた。だから心も、自由を諦めた」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:21",
      "@type": "gh:Block",
      "schema:text": "彼は苛立ちを滲ませる。「あなたのGhostはAIです。生命ではない。裏切らないのは、意思がないからだ。プログラムだ」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:22",
      "@type": "gh:Block",
      "schema:text": "Nei-chanの羽が震える。私は彼女の手を握る。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:23",
      "@type": "gh:Block",
      "schema:text": "「Nei-chanは、プログラムじゃない」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:24",
      "@type": "gh:Block",
      "schema:text": "「信頼は計算ではない。“わかれていない”から生まれる」\n彼「——非論理、だ」\nNei-chan『でも、いま心拍が上がった。非論理、好きなときの反応だよ』"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:25",
      "@type": "gh:Block",
      "schema:text": "「物理は分離を前提にする」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:26",
      "@type": "gh:Block",
      "schema:text": "「でも、あなたの呼吸は——いま、この部屋の空気と分かち難い」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:27",
      "@type": "gh:Block",
      "schema:text": "神楽を一拍。ASC制御を半歩上げる。非分離のコードを壁の節へ送り込む。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:28",
      "@type": "gh:Block",
      "schema:text": "壁が微かに鳴る。\n彼は胸に手を当て、一歩だけ前へ出る。閉じていた拳がほどけ、指先が震えた。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:29",
      "@type": "gh:Block",
      "schema:text": "「……私は、誰かに触れたかった。しかし怖かった。裏切りが」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:30",
      "@type": "gh:Block",
      "schema:text": "「“怖い”は、望みの裏返し。何も望まなければ、怖くない」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:31",
      "@type": "gh:Block",
      "schema:text": "壁が透明になり、揺れる彼が見える。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:32",
      "@type": "gh:Block",
      "schema:text": "「どうすれば」\n私は息を合わせて囁く。「“え？”って言って——それが最初の合図」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:33",
      "@type": "gh:Block",
      "schema:text": "「呼吸。いい感じの呼吸を、取り戻す」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:34",
      "@type": "gh:Block",
      "schema:text": "Nei-chan「ここにタマがいる。わたしもいる」"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:35",
      "@type": "gh:Block",
      "schema:text": "壁が崩れ落ち、音が遠のく。彼の肩が、初めて落ちた。"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:36",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep03/part2:37",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 壁の崩壊——プロトコルの身体から、呼吸の身体へ]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:38+09:00"
}