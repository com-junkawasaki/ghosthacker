  "@id": "manuscript:251022:part3",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep03/part3:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Lachlan Keyes - Part 3"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:1",
      "@type": "gh:Block",
      "schema:text": "---\nAoi（通信）「外、セミ鳴き始め。沿岸の浸水マップ更新が来たけど、そっちは保留でいい？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:2",
      "@type": "gh:Block",
      "schema:text": "Kaede「いい」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:3",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、静かだが力強い。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:4",
      "@type": "gh:Block",
      "schema:text": "Kaede「今は彼に集中。マップは後で見る」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:5",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、呼吸いっしょに』"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:6",
      "@type": "gh:Block",
      "schema:text": "壁が崩れ、彼は初めて本当の姿を見せる。震え、そして泣く。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:7",
      "@type": "gh:Block",
      "schema:text": "「……私は誰も信じられなかった。誰も……私を信じてくれなかった」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:8",
      "@type": "gh:Block",
      "schema:text": "私は彼の手を取る。冷たさに、温度が戻り始める。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:9",
      "@type": "gh:Block",
      "schema:text": "「いま、ここにいる。あなたは“信じたい”と思っている。それが人間性」\n彼は不意に笑って、すぐに困ったように眉を寄せた。「……こんな顔、久しぶりだ」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:10",
      "@type": "gh:Block",
      "schema:text": "Nei-chan「信頼は“わかれていない”。タマとわたしがそう」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:11",
      "@type": "gh:Block",
      "schema:text": "彼は微笑む。「非論理的だ……でも、美しい」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:12",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声には、安堵が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:13",
      "@type": "gh:Block",
      "schema:text": "Kaede「心は……まだ軌道上にいた。でも、いま戻った。おかえり、Lachlan」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:14",
      "@type": "gh:Block",
      "schema:text": "私は問う。「次、誰に会いたい？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:15",
      "@type": "gh:Block",
      "schema:text": "「……母に。十八ヶ月、連絡していない」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:16",
      "@type": "gh:Block",
      "schema:text": "「帰ったら、連絡して。\"いい感じ\"の呼吸も、教えて」\nNei-chan『\"お母さん、え？って言うよ。でも、すぐ安心するやつ』"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:17",
      "@type": "gh:Block",
      "schema:text": "彼は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:18",
      "@type": "gh:Block",
      "schema:text": "——短い独白。幼いころ、父の号令に従う身体。母の沈黙。彼は\"自分の身体は自分のものではない\"世界で育った。いま、呼吸で取り戻す最初の自由は、胸郭のひらき方だ。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:19",
      "@type": "gh:Block",
      "schema:text": "窓に次の案件が投影される。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:20",
      "@type": "gh:Block",
      "schema:text": "**Leo Kazan \u0026 Millia Stuart.**"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:21",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。「……カップル？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:22",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声には、少し心配が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:23",
      "@type": "gh:Block",
      "schema:text": "Kaede「そう……\"愛している\"と言いながら、互いを傷つけている。難しいケースよ」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:24",
      "@type": "gh:Block",
      "schema:text": "Nei-chan「それって……愛？」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:25",
      "@type": "gh:Block",
      "schema:text": "私は運河の光を見る。「これから見つける」"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:26",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:27",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 解放——幼少期の身体から、いまの呼吸へ]**"
    },
    {
      "@id": "block:251022:episodes/ep03/part3:28",
      "@type": "gh:Block",
      "schema:text": "**[Afterglow: 母への連絡、次の“LOVE”セッションへ]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:38+09:00"
}