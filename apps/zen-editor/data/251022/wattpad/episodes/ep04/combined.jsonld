{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:combined",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep04/combined:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Leo Kazan \u0026 Millia Stuart - Part 1"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": \"https://ghosthacker.example.com/\",\n  \"@type\": \"EpisodePart\",\n  \"partOf\": \"episode:s3e2\",\n  \"position\": 1,\n  \"antagonist\": [\n    { \"@id\": \"character:leo-kazan\" },\n    { \"@id\": \"character:millia-stuart\" }\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:2",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:3",
      "@type": "gh:Block",
      "schema:text": "Kaede「今朝は川霧ね……」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:4",
      "@type": "gh:Block",
      "schema:text": "彼女の声には、少し心配が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:5",
      "@type": "gh:Block",
      "schema:text": "Kaede「気圧が下がってる。こういう日は、感情が不安定になりやすい。呼吸を深めに、Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:6",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Ei, Tamaki! 帯域は安定してるよ。昼のピークカットも解除済み。音はばっちり流せる」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:7",
      "@type": "gh:Block",
      "schema:text": "彼の声は明るいが、どこか気遣いがある。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:8",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、今日はカップル。空気、ちょっと熱い』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:9",
      "@type": "gh:Block",
      "schema:text": "朝の光が渋谷の運河を照らす。Nei-chanがキッチンで何か作っている——彼女は食べないくせに、私のために料理をするのが好きだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:10",
      "@type": "gh:Block",
      "schema:text": "「タマ、今日は大変だよ。カップルセッションだって」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:11",
      "@type": "gh:Block",
      "schema:text": "私はコーヒーを淹れながら、ToLのファイルを開く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:12",
      "@type": "gh:Block",
      "schema:text": "**Leo Kazan, 38, Director of Humanitarian NGO. Millia Stuart, 30, Digital Artist.**"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:13",
      "@type": "gh:Block",
      "schema:text": "Kaedeのノートが添付されている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:14",
      "@type": "gh:Block",
      "schema:text": "*「この二人は、お互いを\"愛している\"と言っている。でも、Milliaはリストカットを繰り返し、LeoはMilliaを\"救おうとして\"疲弊している。彼らの関係性は、共依存の可能性が高い」*"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:15",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが私の横に座る。「タマ、\"愛\"って何？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:16",
      "@type": "gh:Block",
      "schema:text": "私は笑う。「愛。知っているよ——でも、今は“待っている”」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:17",
      "@type": "gh:Block",
      "schema:text": "Nei-chan「えー？ それだと、わかんない！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:18",
      "@type": "gh:Block",
      "schema:text": "Kaede「二人とも、もうセッションが始まるわ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:19",
      "@type": "gh:Block",
      "schema:text": "Kaedeが通信に入る。彼女の声は、いつもより少し緊張している。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:20",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki……このセッションは、難しい。私も救急で何度も見てきた——\"愛\"の名の下に、互いを傷つけ合うカップル」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:21",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:22",
      "@type": "gh:Block",
      "schema:text": "Kaede「LeoのGhostはアダム・スミスの道徳感情論。他者からの\"共感\"を求める哲学。MilliaのGhostはJ.S.ミルの個人の自由と、日本の家父長制の\"祖霊の鎖\"。二つのGhostが彼女を引き裂いてる」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:23",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声には、深い共感がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:24",
      "@type": "gh:Block",
      "schema:text": "Kaede「彼らは互いに、相手を\"救おう\"として……相手を傷つけている。トリアージで言えば、共倒れ寸前よ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:25",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が部屋に入り込む。温かいが、どこか悲しい音色。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:26",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Tamaki……二人の周波数、聴いてごらん」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:27",
      "@type": "gh:Block",
      "schema:text": "彼の声は、いつもより静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:28",
      "@type": "gh:Block",
      "schema:text": "Hibiki「完全に非同期。彼らは\"同じ言葉\"を使ってるけど、その意味が全然違う。音楽で言えば、別の曲を同時に演奏してるみたいだ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:29",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。Nei-chanに合図し、神楽を小さく踏む。ASC制御の準備。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:30",
      "@type": "gh:Block",
      "schema:text": "画面がぼやけ、二人が現れる。Leoは情熱的で、Milliaは繊細で、でも……どこか、空洞がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:31",
      "@type": "gh:Block",
      "schema:text": "「Tamaki Mizuno、ですね。私はLeo Kazan。こちらはMillia」\nNei-chan（小声）『情熱、強め。ミリアは薄いガード』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:32",
      "@type": "gh:Block",
      "schema:text": "Leoの声は温かい。でも、その奥に、疲労がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:33",
      "@type": "gh:Block",
      "schema:text": "Milliaは小さく微笑む。でも、その笑顔は、壊れそうだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:34",
      "@type": "gh:Block",
      "schema:text": "「お二人は……“愛し合っている”と聞きました」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:35",
      "@type": "gh:Block",
      "schema:text": "Leoが即座に答える。「はい。私はMilliaを愛しています。彼女は……私の全てです」\nLeoの指が、無意識にMilliaの手を強く握る。Milliaは一瞬だけ手を引き、すぐに戻す。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:36",
      "@type": "gh:Block",
      "schema:text": "Milliaの笑顔が、少し凍る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:37",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが囁く。『タマ、Milliaの感情メトリクス……\"愛\"じゃなくて、\"罪悪感\"が強い』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:38",
      "@type": "gh:Block",
      "schema:text": "私はMilliaに尋ねる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:39",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたは……Leoを愛していますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:40",
      "@type": "gh:Block",
      "schema:text": "彼女の視線が泳ぐ。そして、小さく言った。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:41",
      "@type": "gh:Block",
      "schema:text": "「……私は、Leoに\"愛されている\"のが……怖いです」\nLeoの喉が鳴る。「……ごめん」\nLeo「え……？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:42",
      "@type": "gh:Block",
      "schema:text": "Leoの表情が崩れる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:43",
      "@type": "gh:Block",
      "schema:text": "「Millia……なぜ？ 今日は、仕事の選択の相談だろ？ ボードにも家族にも、友達にも、みんなに説明しなきゃで——」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:44",
      "@type": "gh:Block",
      "schema:text": "Tamaki「予約は、どなたが？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:45",
      "@type": "gh:Block",
      "schema:text": "Millia「……私です。Leoが“楽しそうに”悩むのを見てると、うれしくて——でも、不安にもなって」\nTamaki「うれしい？」\nMillia「……Leoの家族の話、好きです。温かいから」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:46",
      "@type": "gh:Block",
      "schema:text": "Leo（明るく）「ノー天気って言われます。でも、ぼくは前向きにやれると思ってて」\nLeo「うちの家族はいつも応援してくれるし、親友も多い。だから——大丈夫だと思ってた」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:47",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。ここからが本番。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:48",
      "@type": "gh:Block",
      "schema:text": "「Leo、あなたは\"共感\"を、与えるものだと思っていますね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:49",
      "@type": "gh:Block",
      "schema:text": "彼が驚いて私を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:50",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたは\"愛\"を、返さなければならない借金だと思っていますね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:51",
      "@type": "gh:Block",
      "schema:text": "彼女の目が、涙を浮かべる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:52",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが静かに告げる。『タマ、二人とも……\"愛\"を、取引だと思ってる』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:53",
      "@type": "gh:Block",
      "schema:text": "私は二人に向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:54",
      "@type": "gh:Block",
      "schema:text": "「お二人は、\"愛\"と\"信用\"を、混同しています。そして、\"信頼\"を、忘れています」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:55",
      "@type": "gh:Block",
      "schema:text": "Leoが問う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:56",
      "@type": "gh:Block",
      "schema:text": "「……それは、どう違うんですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:57",
      "@type": "gh:Block",
      "schema:text": "私は笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:58",
      "@type": "gh:Block",
      "schema:text": "「それを、これから見つけましょう」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:59",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Leo \u0026 Milliaセッション開始——愛、信用、信頼の混乱]**"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:60",
      "@type": "gh:Block",
      "schema:text": "Tamaki「信用の経済から行くね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki「その机の前のコップの水、私に100円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:62",
      "@type": "gh:Block",
      "schema:text": "Leo「え？ うーん……売れる！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:63",
      "@type": "gh:Block",
      "schema:text": "Millia「……売れる」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。これが“他人”の経済＝信用の経済。お金と契約の世界」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:65",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は、信頼と共感の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:66",
      "@type": "gh:Block",
      "schema:text": "Tamaki「その水、知らない人にあげますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:67",
      "@type": "gh:Block",
      "schema:text": "Leo「えー、知らない人は嫌だな。もらったものだけど！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:68",
      "@type": "gh:Block",
      "schema:text": "Millia（沈黙）"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:69",
      "@type": "gh:Block",
      "schema:text": "Tamaki「その水、私にくれますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:70",
      "@type": "gh:Block",
      "schema:text": "Leo「えぇ？ Tamakiさんなら、可愛いからいいよ！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:71",
      "@type": "gh:Block",
      "schema:text": "Millia（肘で小突く）「……」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:72",
      "@type": "gh:Block",
      "schema:text": "Leo「痛っ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:73",
      "@type": "gh:Block",
      "schema:text": "Tamakiはペットボトルを受け取り、一口飲む。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:74",
      "@type": "gh:Block",
      "schema:text": "Tamaki「これが“友達”の経済＝共感と信頼の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:75",
      "@type": "gh:Block",
      "schema:text": "Leo「え、どういうこと？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:76",
      "@type": "gh:Block",
      "schema:text": "Tamaki「“可愛いから”“Tamakiだから”。関係が価値を生む。知らない人では立ち上がらない、感情と共感の価値」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたが“あなた”と感じているもの——知識、文化、経験。形がなくても価値がある」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:78",
      "@type": "gh:Block",
      "schema:text": "Leo「はー。なるほど。たしかに。Tamakiさんならもっと高くてもよかったのに！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:79",
      "@type": "gh:Block",
      "schema:text": "Millia（つねる）"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:80",
      "@type": "gh:Block",
      "schema:text": "Leo「いたダダダ！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:81",
      "@type": "gh:Block",
      "schema:text": "# Session: Leo Kazan \u0026 Millia Stuart - Part 2"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:82",
      "@type": "gh:Block",
      "schema:text": "---\nKaede「同一セッション、続行」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:83",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、落ち着いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:84",
      "@type": "gh:Block",
      "schema:text": "Kaede「ここで決着を急がない。救急のトリアージと同じ——焦ると、見落とす」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:85",
      "@type": "gh:Block",
      "schema:text": "Hibiki「場の音、一段下げるね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:86",
      "@type": "gh:Block",
      "schema:text": "彼の声は、とても優しい。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:87",
      "@type": "gh:Block",
      "schema:text": "Hibiki「二人の呼吸に合わせて。音楽は、呼吸を映す鏡だから」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:88",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、いまミリアの肩、少し下がった』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:89",
      "@type": "gh:Block",
      "schema:text": "私は二人の間に、三つの円を描く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:90",
      "@type": "gh:Block",
      "schema:text": "「これが\"愛\"、これが\"信用\"、そしてこれが\"信頼\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:91",
      "@type": "gh:Block",
      "schema:text": "Leoが前のめりになる。Milliaは少し身を引く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:92",
      "@type": "gh:Block",
      "schema:text": "「\"信用\"は、取引です。あなたが私に何かをくれたら、私もあなたに何かをあげる。それは、等価交換です」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:93",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが補足する。「銀行がお金を貸すのは、\"信用\"。返ってくる前提で渡す」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:94",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:95",
      "@type": "gh:Block",
      "schema:text": "「\"信頼\"は、計算じゃない。それは、\"わかれていない\"ということです。私がNei-chanを信頼するのは、彼女が私の一部だから」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:96",
      "@type": "gh:Block",
      "schema:text": "Milliaが小さく声を出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:97",
      "@type": "gh:Block",
      "schema:text": "「……でも、私たちは……\"わかれている\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:98",
      "@type": "gh:Block",
      "schema:text": "私は笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:99",
      "@type": "gh:Block",
      "schema:text": "「本当に？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:100",
      "@type": "gh:Block",
      "schema:text": "私は彼女に尋ねる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:101",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたがLeoを見るとき、あなたは何を感じますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:102",
      "@type": "gh:Block",
      "schema:text": "彼女の目が涙を浮かべる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:103",
      "@type": "gh:Block",
      "schema:text": "「……彼が、苦しんでいるのを見ると……私も、苦しいです」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:104",
      "@type": "gh:Block",
      "schema:text": "「それは、なぜですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:105",
      "@type": "gh:Block",
      "schema:text": "「……私のせいだから」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:106",
      "@type": "gh:Block",
      "schema:text": "私は首を横に振る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:107",
      "@type": "gh:Block",
      "schema:text": "「違います。それは、あなたとLeoが\"わかれていない\"からです。あなたは、彼の痛みを、自分の痛みとして感じている」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:108",
      "@type": "gh:Block",
      "schema:text": "Leoが驚いて言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:109",
      "@type": "gh:Block",
      "schema:text": "「……それは、共感、ですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:110",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:111",
      "@type": "gh:Block",
      "schema:text": "「いいえ。それは、\"拡張された自己\"です」\nLeo「……え？」\nNei-chan『いま、“え？”入った』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:112",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声には、深い洞察がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:113",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki……アダム・スミスは『道徳感情論』で、共感を\"他者の立場に立つこと\"として説明した」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:114",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:115",
      "@type": "gh:Block",
      "schema:text": "Kaede「でもね、それは実は、\"個人\"という境界線を前提にしてる。Leo、あなたは\"個人として\"Milliaを理解しようとしている。でも……それが逆に、彼女を孤立させてるの」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:116",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声には、救急医として何度も見てきた痛みへの共感がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:117",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が部屋に入る。温かいが、少し悲しい音色。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:118",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Leo……あなたの\"共感\"、聴いてごらん」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:119",
      "@type": "gh:Block",
      "schema:text": "彼の声は優しいが、真実を告げている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:120",
      "@type": "gh:Block",
      "schema:text": "Hibiki「それは実は、\"信用\"の一種なんだ。『私があなたを理解したら、あなたも私を理解してくれる』——それは、取引の音だよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:121",
      "@type": "gh:Block",
      "schema:text": "Leoの顔が青ざめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:122",
      "@type": "gh:Block",
      "schema:text": "「……私は、Milliaを……取引の対象にしていたんですか？」\n彼の声が掠れる。視線が膝に落ちる。Milliaは無意識にテーブル上の水に手を伸ばし、口を湿らせる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:123",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:124",
      "@type": "gh:Block",
      "schema:text": "「あなたは、彼女を\"救おう\"としていました。でも、彼女は\"救われたい\"と思っていなかった。彼女は、ただ……\"わかれていない\"存在が欲しかった」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:125",
      "@type": "gh:Block",
      "schema:text": "Nei-chanがMilliaに近づく。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:126",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたがリストカットをするのは、\"祖霊の鎖\"を切ろうとしているから。でも、その鎖は、あなた一人では切れない」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:127",
      "@type": "gh:Block",
      "schema:text": "Milliaが震える声で言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:128",
      "@type": "gh:Block",
      "schema:text": "「……私は、一人でいたい。でも、一人は怖い……」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:129",
      "@type": "gh:Block",
      "schema:text": "私は彼女の手を取る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:130",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたは\"個人\"という境界線に囚われています。でも、\"個人\"は幻想です。あなたは、すでにLeoと\"わかれていない\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:131",
      "@type": "gh:Block",
      "schema:text": "私はLeoを見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:132",
      "@type": "gh:Block",
      "schema:text": "「Leo、あなたも、Milliaと\"わかれていない\"。だから、彼女の痛みが、あなたを疲弊させる」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:133",
      "@type": "gh:Block",
      "schema:text": "私は二人に告げる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:134",
      "@type": "gh:Block",
      "schema:text": "「お二人は、\"愛\"を\"個人の感情\"だと思っている。でも、\"愛\"は、\"拡張された自己\"です。あなたたちは、すでに一つになっている。それを、認めればいい」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:135",
      "@type": "gh:Block",
      "schema:text": "Leoの目が、涙を浮かべる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:136",
      "@type": "gh:Block",
      "schema:text": "「……私は、Milliaを\"一人の個人\"として尊重しようとしていました。でも、それが……彼女を孤立させていた」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:137",
      "@type": "gh:Block",
      "schema:text": "Milliaが泣きながら言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:138",
      "@type": "gh:Block",
      "schema:text": "「……私は、自由でいたかった。でも、\"自由\"は……孤独だった」\nLeoが彼女の方へ体を傾ける。彼女はほんの少しだけ肩を預ける。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:139",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:140",
      "@type": "gh:Block",
      "schema:text": "「自由は、\"わかれていない\"ことと矛盾しないよ。タマは私の一部だけど、私もタマの一部。でも、私たちはそれぞれ、違う」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:141",
      "@type": "gh:Block",
      "schema:text": "私は二人に尋ねる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:142",
      "@type": "gh:Block",
      "schema:text": "「お二人は、\"拡張された自己\"として、どう生きたいですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:143",
      "@type": "gh:Block",
      "schema:text": "Leoが笑う。初めて、本当に笑った。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:144",
      "@type": "gh:Block",
      "schema:text": "「……私は、Milliaと\"わかれていない\"存在でいたい。取引じゃなく、ただ……一緒にいたい」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:145",
      "@type": "gh:Block",
      "schema:text": "Milliaが微笑む。初めて、本当に微笑んだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:146",
      "@type": "gh:Block",
      "schema:text": "「……私も、Leoと\"わかれていない\"存在でいたい。でも、\"私\"も大事にしたい」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:147",
      "@type": "gh:Block",
      "schema:text": "私は笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:148",
      "@type": "gh:Block",
      "schema:text": "「それでいい。それが、\"愛\"です」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:149",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:150",
      "@type": "gh:Block",
      "schema:text": "**[Beat: \"愛\"と\"信用\"と\"信頼\"の違いの発見——拡張された自己の気づき]**"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:151",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:152",
      "@type": "gh:Block",
      "schema:text": "Tamaki「では次は“愛と家族”の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:153",
      "@type": "gh:Block",
      "schema:text": "Milliaがわずかに反応する。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:154",
      "@type": "gh:Block",
      "schema:text": "Tamakiは何も言わない。十数秒の沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:155",
      "@type": "gh:Block",
      "schema:text": "Tamakiは、Milliaが少し口をつけたコップを静かに取り、黙って一口。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:156",
      "@type": "gh:Block",
      "schema:text": "二人「えっ？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:157",
      "@type": "gh:Block",
      "schema:text": "Tamakiはコップをもとの位置へ戻す。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:158",
      "@type": "gh:Block",
      "schema:text": "（その時、Milliaがコップを戻す手首に、白く薄い線が幾つか見えた。私は目を伏せ、何も言わない。Nei-chanがそっと震える）\nNei-chan（小声）『タマ……見えた』\nTamaki（小声）「うん。いまは、待つ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:159",
      "@type": "gh:Block",
      "schema:text": "Tamaki「——これが“愛と家族”の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:160",
      "@type": "gh:Block",
      "schema:text": "Leo「……？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:161",
      "@type": "gh:Block",
      "schema:text": "Tamaki「お金も共感もいらない。“自他非分離”の経済。おうちの冷蔵庫と一緒」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:162",
      "@type": "gh:Block",
      "schema:text": "Leo「ああっ。たしかに！ よく勝手に食べられる！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:163",
      "@type": "gh:Block",
      "schema:text": "Tamaki（笑いながら）「うん。大きくなると線引きが出てくるけど、小さい時は、あなたもお父さんやお母さんから、たくさん受け取っている。会社で言うと“合併”。同じお財布、同じもの。苦しみも悲しみも一緒」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:164",
      "@type": "gh:Block",
      "schema:text": "Milliaは何も言わず、怒りと悲しみ、困惑を混ぜた表情で俯く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:165",
      "@type": "gh:Block",
      "schema:text": "# Session: Leo Kazan \u0026 Millia Stuart - Part 3"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:166",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:167",
      "@type": "gh:Block",
      "schema:text": "Kaede「ここから……核心」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:168",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、緊張している。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:169",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、慎重に。救急で言えば、これから一番デリケートな処置に入る」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:170",
      "@type": "gh:Block",
      "schema:text": "Hibiki「場の音、もう一段下げるね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:171",
      "@type": "gh:Block",
      "schema:text": "彼の声は、とても静かで、優しい。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:172",
      "@type": "gh:Block",
      "schema:text": "Hibiki「二人の呼吸に完全同期させる。音が、二人を包むように」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:173",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、ミリアの手首……見えてる？』\nTamaki（小声）「うん。でも、今は待つ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:174",
      "@type": "gh:Block",
      "schema:text": "私は二人を見つめる。Leoは前のめりで、Milliaは少し身を引いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:175",
      "@type": "gh:Block",
      "schema:text": "Tamaki「では、最後の質問に行くね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:176",
      "@type": "gh:Block",
      "schema:text": "私は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:177",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは友人を1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:178",
      "@type": "gh:Block",
      "schema:text": "Leo「え、それは絶対売らないよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:179",
      "@type": "gh:Block",
      "schema:text": "Leoは即答する。でも、Milliaは沈黙している。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:180",
      "@type": "gh:Block",
      "schema:text": "Tamaki「じゃあ、あなたの友人との関係には1億円以上の価値がある、ということだね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:181",
      "@type": "gh:Block",
      "schema:text": "Leo「おー！ なるほど！ そうかも！ たしかに！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:182",
      "@type": "gh:Block",
      "schema:text": "Leoは嬉しそうに頷く。Milliaは小さく頷くだけ。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:183",
      "@type": "gh:Block",
      "schema:text": "Tamaki「では、あそこに昔、道ですれ違っただけの人は売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:184",
      "@type": "gh:Block",
      "schema:text": "空間の背景に、薄く街並みのコンテキストが現れる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:185",
      "@type": "gh:Block",
      "schema:text": "Leo「え？ どういうこと」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:186",
      "@type": "gh:Block",
      "schema:text": "Tamaki「昔、道ですれ違っただけの人。その人と二度と会えない。ただそれだけ。——1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:187",
      "@type": "gh:Block",
      "schema:text": "Leo「んー……それなら売るかも」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:188",
      "@type": "gh:Block",
      "schema:text": "Milliaが小さく声を出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:189",
      "@type": "gh:Block",
      "schema:text": "Millia「（小声）……売る」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:190",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。人と関係で価値は異なる。関係性には価値がある」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:191",
      "@type": "gh:Block",
      "schema:text": "私は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:192",
      "@type": "gh:Block",
      "schema:text": "Tamaki「金融資本は20京円の市場がある。でも、社会資本はその数千倍の価値がある。世界の経済は\"共感と関係\"で動いている」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:193",
      "@type": "gh:Block",
      "schema:text": "Leoが頷く。Milliaは俯いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:194",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次の質問。——あなたの片目を1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:195",
      "@type": "gh:Block",
      "schema:text": "Leoの表情が変わる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:196",
      "@type": "gh:Block",
      "schema:text": "Leo「……目！？ 1億円か……」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:197",
      "@type": "gh:Block",
      "schema:text": "彼は少し考え込む。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:198",
      "@type": "gh:Block",
      "schema:text": "Leo「……悩むけど……売れない」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:199",
      "@type": "gh:Block",
      "schema:text": "Milliaが小さく声を出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:200",
      "@type": "gh:Block",
      "schema:text": "Millia「……売る、かも」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:201",
      "@type": "gh:Block",
      "schema:text": "Leoが驚いて彼女を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:202",
      "@type": "gh:Block",
      "schema:text": "Leo「え！ 売るの？！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:203",
      "@type": "gh:Block",
      "schema:text": "Milliaは何も言わない。ただ、俯いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:204",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。ここからが、本当の核心。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:205",
      "@type": "gh:Block",
      "schema:text": "Tamaki「最後の質問」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:206",
      "@type": "gh:Block",
      "schema:text": "私は二人を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:207",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの家族を1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:208",
      "@type": "gh:Block",
      "schema:text": "Leo「え、それは絶対売らない」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:209",
      "@type": "gh:Block",
      "schema:text": "Leoは即答する。でも、Milliaは沈黙している。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:210",
      "@type": "gh:Block",
      "schema:text": "長い沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:211",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、ミリアの感情メトリクス……すごく揺れてる』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:212",
      "@type": "gh:Block",
      "schema:text": "Tamaki「10億円なら？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:213",
      "@type": "gh:Block",
      "schema:text": "Leo「売らない！」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:214",
      "@type": "gh:Block",
      "schema:text": "Leoは力強く言う。でも、Milliaは……"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:215",
      "@type": "gh:Block",
      "schema:text": "Millia「……売る」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:216",
      "@type": "gh:Block",
      "schema:text": "Leo「ええ？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:217",
      "@type": "gh:Block",
      "schema:text": "Leoが驚いて彼女を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:218",
      "@type": "gh:Block",
      "schema:text": "Milliaは俯き、肩が震える。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:219",
      "@type": "gh:Block",
      "schema:text": "そして、泣き出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:220",
      "@type": "gh:Block",
      "schema:text": "Leo「ど、どうしたの？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:221",
      "@type": "gh:Block",
      "schema:text": "Leoが驚く。彼は、どうしたらいいかわからない。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:222",
      "@type": "gh:Block",
      "schema:text": "Milliaは泣きじゃくって、何も答えない。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:223",
      "@type": "gh:Block",
      "schema:text": "そして、絞り出すような声で言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:224",
      "@type": "gh:Block",
      "schema:text": "Millia「1円でも……いくらでも売りたい……」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:225",
      "@type": "gh:Block",
      "schema:text": "私はそれには触れず、Milliaに静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:226",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。愛と関係性の経済の見分け方は\"売れるか売れないか\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:227",
      "@type": "gh:Block",
      "schema:text": "私は彼女の目を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:228",
      "@type": "gh:Block",
      "schema:text": "Tamaki「自分と\"感じている\"か否かなの」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:229",
      "@type": "gh:Block",
      "schema:text": "Leo「な、なるほど……」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:230",
      "@type": "gh:Block",
      "schema:text": "Leoは言いつつ、この場でどうしたらいいかわからない。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:231",
      "@type": "gh:Block",
      "schema:text": "私はMilliaに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:232",
      "@type": "gh:Block",
      "schema:text": "Tamaki「でも、家族だからといって売ってはいけないわけじゃないよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:233",
      "@type": "gh:Block",
      "schema:text": "Milliaは少し泣き止む。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:234",
      "@type": "gh:Block",
      "schema:text": "Millia「……売ってもいいんですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:235",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、震えている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:236",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。家族も自分か否か。それはあなたが決めていい」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:237",
      "@type": "gh:Block",
      "schema:text": "私は静かに続ける。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:238",
      "@type": "gh:Block",
      "schema:text": "Tamaki「日本の文化では家族は無条件に自分であることを前提にされている。西洋の価値観ではパートナーが自分であることを神に誓う」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:239",
      "@type": "gh:Block",
      "schema:text": "私は彼女の目を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:240",
      "@type": "gh:Block",
      "schema:text": "Tamaki「\"あなたを愛している\"という嘘をつく人を愛さなくていいの」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:241",
      "@type": "gh:Block",
      "schema:text": "Leoがギョッとしながら困惑している。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:242",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの共感と魂を奪う、束縛する人、共感の搾取。それは許されることではない」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:243",
      "@type": "gh:Block",
      "schema:text": "Millia「でも……売りたくても、切りたくても切れない……」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:244",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、絶望に満ちている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:245",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それはね。自分の体の一部になっているからだよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:246",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:247",
      "@type": "gh:Block",
      "schema:text": "Tamaki「それが\"complex\"。心身複合体、spiritになっている。魂が癒着しているの」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:248",
      "@type": "gh:Block",
      "schema:text": "Tamaki「体が離れていても、魂が繋がってしまっている。そして魂を切ることは、自分の体を切ることと一緒」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:249",
      "@type": "gh:Block",
      "schema:text": "私は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:250",
      "@type": "gh:Block",
      "schema:text": "Tamaki「魂を切ると、出血する。だから切ると痛みがある」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:251",
      "@type": "gh:Block",
      "schema:text": "その時、Milliaがコップを戻す手首に、白く薄い線が幾つか見えた。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:252",
      "@type": "gh:Block",
      "schema:text": "リストカットの跡。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:253",
      "@type": "gh:Block",
      "schema:text": "私は目を伏せ、何も言わない。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:254",
      "@type": "gh:Block",
      "schema:text": "Nei-chan（小声）『タマ……見えた』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:255",
      "@type": "gh:Block",
      "schema:text": "Tamaki（小声）「うん。いまは、待つ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:256",
      "@type": "gh:Block",
      "schema:text": "私はMilliaに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:257",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたには勇気がある。でもちゃんと切るのは専門家に任せようね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:258",
      "@type": "gh:Block",
      "schema:text": "Millia「……どうしたらいいですか、Dr. Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:259",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、小さいが、希望が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:260",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。手続きと……麻酔と手術だね。ちょっと聞いてみるね」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:261",
      "@type": "gh:Block",
      "schema:text": "Milliaの目に、小さな光が灯る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:262",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:263",
      "@type": "gh:Block",
      "schema:text": "「うん。専門家がいる。Dr. イタコ」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:264",
      "@type": "gh:Block",
      "schema:text": "私は彼女の目を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:265",
      "@type": "gh:Block",
      "schema:text": "「——あなたは、自由になれる」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:266",
      "@type": "gh:Block",
      "schema:text": "Leoが、ゆっくりとMilliaの手を取る。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:267",
      "@type": "gh:Block",
      "schema:text": "Leo「ミリア。ぼくは……ずっと一緒にいる」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:268",
      "@type": "gh:Block",
      "schema:text": "彼の声は優しい。でも、力強い。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:269",
      "@type": "gh:Block",
      "schema:text": "Milliaが、涙のまま、小さく笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:270",
      "@type": "gh:Block",
      "schema:text": "Millia「……先生、お願いします」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:271",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:272",
      "@type": "gh:Block",
      "schema:text": "「大丈夫。あなたは一人じゃない。Leoも、私たちも、一緒にいる」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:273",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、二人の手、繋がってる。あったかい』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:274",
      "@type": "gh:Block",
      "schema:text": "Leoが、ゆっくりとMilliaの手を取る。今度は、迷いなく。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:275",
      "@type": "gh:Block",
      "schema:text": "Leo「ミリア。ぼくは……ずっと一緒にいる。どんな手術でも、その後も」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:276",
      "@type": "gh:Block",
      "schema:text": "Milliaが、涙のまま、小さく笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:277",
      "@type": "gh:Block",
      "schema:text": "Millia「……ありがとう」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:278",
      "@type": "gh:Block",
      "schema:text": "Nei-chanの声が、優しく響く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:279",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、二人の手、繋がってる。あったかい』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:280",
      "@type": "gh:Block",
      "schema:text": "私は二人を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:281",
      "@type": "gh:Block",
      "schema:text": "「次のステップは、Dr. イタコのセッション。——でも、今日はここまで。二人で、ゆっくり話して」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:282",
      "@type": "gh:Block",
      "schema:text": "Leoが頷く。Milliaも、静かに頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:283",
      "@type": "gh:Block",
      "schema:text": "セッションルームの光が、少しずつ戻っていく。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:284",
      "@type": "gh:Block",
      "schema:text": "Milliaの表情が、ほんの少し、柔らかくなる。重荷が、少しだけ軽くなったように見える。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:285",
      "@type": "gh:Block",
      "schema:text": "Leo「……ミリア、これから、どうなるかわからないけど……でも、一緒に進もう」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:286",
      "@type": "gh:Block",
      "schema:text": "Millia「……うん。ありがとう、Leo」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:287",
      "@type": "gh:Block",
      "schema:text": "彼女の声に、初めて、安心の色が混じる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:288",
      "@type": "gh:Block",
      "schema:text": "二人の輪郭が、安定する。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:289",
      "@type": "gh:Block",
      "schema:text": "そして、初めて——本当に、お互いを見ている。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:290",
      "@type": "gh:Block",
      "schema:text": "私は、静かに微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:291",
      "@type": "gh:Block",
      "schema:text": "「大丈夫。あなたたちは、もう一人じゃない。これから、新しい道が開ける」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:292",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、二人、すごくあったかい。希望の色してる。キラキラしてる』"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:293",
      "@type": "gh:Block",
      "schema:text": "Leoが、Milliaの手をそっと握る。Milliaも、握り返す。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:294",
      "@type": "gh:Block",
      "schema:text": "二人の間に、静かな信頼が流れる。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:295",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:296",
      "@type": "gh:Block",
      "schema:text": "「うん。これから、きっと大丈夫。一歩ずつ、進んでいける」"
    },
    {
      "@id": "block:251022:episodes/ep04/combined:297",
      "@type": "gh:Block",
      "schema:text": "Milliaが、小さく微笑む。涙はまだ乾いていないけれど、その目には——希望がある。"
    }
  ],
