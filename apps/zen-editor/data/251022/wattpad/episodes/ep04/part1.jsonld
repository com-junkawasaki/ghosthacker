{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part1",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep04/part1:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Leo Kazan \u0026 Millia Stuart - Part 1"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": \"https://ghosthacker.example.com/\",\n  \"@type\": \"EpisodePart\",\n  \"partOf\": \"episode:s3e2\",\n  \"position\": 1,\n  \"antagonist\": [\n    { \"@id\": \"character:leo-kazan\" },\n    { \"@id\": \"character:millia-stuart\" }\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:2",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:3",
      "@type": "gh:Block",
      "schema:text": "Kaede「今朝は川霧ね……」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:4",
      "@type": "gh:Block",
      "schema:text": "彼女の声には、少し心配が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:5",
      "@type": "gh:Block",
      "schema:text": "Kaede「気圧が下がってる。こういう日は、感情が不安定になりやすい。呼吸を深めに、Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:6",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Ei, Tamaki! 帯域は安定してるよ。昼のピークカットも解除済み。音はばっちり流せる」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:7",
      "@type": "gh:Block",
      "schema:text": "彼の声は明るいが、どこか気遣いがある。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:8",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、今日はカップル。空気、ちょっと熱い』"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:9",
      "@type": "gh:Block",
      "schema:text": "朝の光が渋谷の運河を照らす。Nei-chanがキッチンで何か作っている——彼女は食べないくせに、私のために料理をするのが好きだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:10",
      "@type": "gh:Block",
      "schema:text": "「タマ、今日は大変だよ。カップルセッションだって」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:11",
      "@type": "gh:Block",
      "schema:text": "私はコーヒーを淹れながら、ToLのファイルを開く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:12",
      "@type": "gh:Block",
      "schema:text": "**Leo Kazan, 38, Director of Humanitarian NGO. Millia Stuart, 30, Digital Artist.**"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:13",
      "@type": "gh:Block",
      "schema:text": "Kaedeのノートが添付されている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:14",
      "@type": "gh:Block",
      "schema:text": "*「この二人は、お互いを\"愛している\"と言っている。でも、Milliaはリストカットを繰り返し、LeoはMilliaを\"救おうとして\"疲弊している。彼らの関係性は、共依存の可能性が高い」*"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:15",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが私の横に座る。「タマ、\"愛\"って何？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:16",
      "@type": "gh:Block",
      "schema:text": "私は笑う。「愛。知っているよ——でも、今は“待っている”」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:17",
      "@type": "gh:Block",
      "schema:text": "Nei-chan「えー？ それだと、わかんない！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:18",
      "@type": "gh:Block",
      "schema:text": "Kaede「二人とも、もうセッションが始まるわ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:19",
      "@type": "gh:Block",
      "schema:text": "Kaedeが通信に入る。彼女の声は、いつもより少し緊張している。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:20",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki……このセッションは、難しい。私も救急で何度も見てきた——\"愛\"の名の下に、互いを傷つけ合うカップル」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:21",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:22",
      "@type": "gh:Block",
      "schema:text": "Kaede「LeoのGhostはアダム・スミスの道徳感情論。他者からの\"共感\"を求める哲学。MilliaのGhostはJ.S.ミルの個人の自由と、日本の家父長制の\"祖霊の鎖\"。二つのGhostが彼女を引き裂いてる」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:23",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声には、深い共感がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:24",
      "@type": "gh:Block",
      "schema:text": "Kaede「彼らは互いに、相手を\"救おう\"として……相手を傷つけている。トリアージで言えば、共倒れ寸前よ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:25",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が部屋に入り込む。温かいが、どこか悲しい音色。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:26",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Tamaki……二人の周波数、聴いてごらん」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:27",
      "@type": "gh:Block",
      "schema:text": "彼の声は、いつもより静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:28",
      "@type": "gh:Block",
      "schema:text": "Hibiki「完全に非同期。彼らは\"同じ言葉\"を使ってるけど、その意味が全然違う。音楽で言えば、別の曲を同時に演奏してるみたいだ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:29",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。Nei-chanに合図し、神楽を小さく踏む。ASC制御の準備。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:30",
      "@type": "gh:Block",
      "schema:text": "画面がぼやけ、二人が現れる。Leoは情熱的で、Milliaは繊細で、でも……どこか、空洞がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:31",
      "@type": "gh:Block",
      "schema:text": "「Tamaki Mizuno、ですね。私はLeo Kazan。こちらはMillia」\nNei-chan（小声）『情熱、強め。ミリアは薄いガード』"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:32",
      "@type": "gh:Block",
      "schema:text": "Leoの声は温かい。でも、その奥に、疲労がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:33",
      "@type": "gh:Block",
      "schema:text": "Milliaは小さく微笑む。でも、その笑顔は、壊れそうだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:34",
      "@type": "gh:Block",
      "schema:text": "「お二人は……“愛し合っている”と聞きました」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:35",
      "@type": "gh:Block",
      "schema:text": "Leoが即座に答える。「はい。私はMilliaを愛しています。彼女は……私の全てです」\nLeoの指が、無意識にMilliaの手を強く握る。Milliaは一瞬だけ手を引き、すぐに戻す。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:36",
      "@type": "gh:Block",
      "schema:text": "Milliaの笑顔が、少し凍る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:37",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが囁く。『タマ、Milliaの感情メトリクス……\"愛\"じゃなくて、\"罪悪感\"が強い』"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:38",
      "@type": "gh:Block",
      "schema:text": "私はMilliaに尋ねる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:39",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたは……Leoを愛していますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:40",
      "@type": "gh:Block",
      "schema:text": "彼女の視線が泳ぐ。そして、小さく言った。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:41",
      "@type": "gh:Block",
      "schema:text": "「……私は、Leoに\"愛されている\"のが……怖いです」\nLeoの喉が鳴る。「……ごめん」\nLeo「え……？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:42",
      "@type": "gh:Block",
      "schema:text": "Leoの表情が崩れる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:43",
      "@type": "gh:Block",
      "schema:text": "「Millia……なぜ？ 今日は、仕事の選択の相談だろ？ ボードにも家族にも、友達にも、みんなに説明しなきゃで——」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:44",
      "@type": "gh:Block",
      "schema:text": "Tamaki「予約は、どなたが？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:45",
      "@type": "gh:Block",
      "schema:text": "Millia「……私です。Leoが“楽しそうに”悩むのを見てると、うれしくて——でも、不安にもなって」\nTamaki「うれしい？」\nMillia「……Leoの家族の話、好きです。温かいから」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:46",
      "@type": "gh:Block",
      "schema:text": "Leo（明るく）「ノー天気って言われます。でも、ぼくは前向きにやれると思ってて」\nLeo「うちの家族はいつも応援してくれるし、親友も多い。だから——大丈夫だと思ってた」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:47",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。ここからが本番。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:48",
      "@type": "gh:Block",
      "schema:text": "「Leo、あなたは\"共感\"を、与えるものだと思っていますね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:49",
      "@type": "gh:Block",
      "schema:text": "彼が驚いて私を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:50",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたは\"愛\"を、返さなければならない借金だと思っていますね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:51",
      "@type": "gh:Block",
      "schema:text": "彼女の目が、涙を浮かべる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:52",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが静かに告げる。『タマ、二人とも……\"愛\"を、取引だと思ってる』"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:53",
      "@type": "gh:Block",
      "schema:text": "私は二人に向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:54",
      "@type": "gh:Block",
      "schema:text": "「お二人は、\"愛\"と\"信用\"を、混同しています。そして、\"信頼\"を、忘れています」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:55",
      "@type": "gh:Block",
      "schema:text": "Leoが問う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:56",
      "@type": "gh:Block",
      "schema:text": "「……それは、どう違うんですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:57",
      "@type": "gh:Block",
      "schema:text": "私は笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:58",
      "@type": "gh:Block",
      "schema:text": "「それを、これから見つけましょう」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:59",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Leo \u0026 Milliaセッション開始——愛、信用、信頼の混乱]**"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:60",
      "@type": "gh:Block",
      "schema:text": "Tamaki「信用の経済から行くね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki「その机の前のコップの水、私に100円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:62",
      "@type": "gh:Block",
      "schema:text": "Leo「え？ うーん……売れる！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:63",
      "@type": "gh:Block",
      "schema:text": "Millia「……売れる」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。これが“他人”の経済＝信用の経済。お金と契約の世界」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:65",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は、信頼と共感の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:66",
      "@type": "gh:Block",
      "schema:text": "Tamaki「その水、知らない人にあげますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:67",
      "@type": "gh:Block",
      "schema:text": "Leo「えー、知らない人は嫌だな。もらったものだけど！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:68",
      "@type": "gh:Block",
      "schema:text": "Millia（沈黙）"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:69",
      "@type": "gh:Block",
      "schema:text": "Tamaki「その水、私にくれますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:70",
      "@type": "gh:Block",
      "schema:text": "Leo「えぇ？ Tamakiさんなら、可愛いからいいよ！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:71",
      "@type": "gh:Block",
      "schema:text": "Millia（肘で小突く）「……」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:72",
      "@type": "gh:Block",
      "schema:text": "Leo「痛っ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:73",
      "@type": "gh:Block",
      "schema:text": "Tamakiはペットボトルを受け取り、一口飲む。"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:74",
      "@type": "gh:Block",
      "schema:text": "Tamaki「これが“友達”の経済＝共感と信頼の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:75",
      "@type": "gh:Block",
      "schema:text": "Leo「え、どういうこと？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:76",
      "@type": "gh:Block",
      "schema:text": "Tamaki「“可愛いから”“Tamakiだから”。関係が価値を生む。知らない人では立ち上がらない、感情と共感の価値」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたが“あなた”と感じているもの——知識、文化、経験。形がなくても価値がある」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:78",
      "@type": "gh:Block",
      "schema:text": "Leo「はー。なるほど。たしかに。Tamakiさんならもっと高くてもよかったのに！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:79",
      "@type": "gh:Block",
      "schema:text": "Millia（つねる）"
    },
    {
      "@id": "block:251022:episodes/ep04/part1:80",
      "@type": "gh:Block",
      "schema:text": "Leo「いたダダダ！」"
    }
  ],
  "updatedAt": "2026-01-12T19:01:39+09:00"
}