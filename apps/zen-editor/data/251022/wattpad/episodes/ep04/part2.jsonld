{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep04/part2:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Leo Kazan \u0026 Millia Stuart - Part 2"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:1",
      "@type": "gh:Block",
      "schema:text": "---\nKaede「同一セッション、続行」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:2",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、落ち着いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:3",
      "@type": "gh:Block",
      "schema:text": "Kaede「ここで決着を急がない。救急のトリアージと同じ——焦ると、見落とす」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:4",
      "@type": "gh:Block",
      "schema:text": "Hibiki「場の音、一段下げるね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:5",
      "@type": "gh:Block",
      "schema:text": "彼の声は、とても優しい。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:6",
      "@type": "gh:Block",
      "schema:text": "Hibiki「二人の呼吸に合わせて。音楽は、呼吸を映す鏡だから」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:7",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、いまミリアの肩、少し下がった』"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:8",
      "@type": "gh:Block",
      "schema:text": "私は二人の間に、三つの円を描く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:9",
      "@type": "gh:Block",
      "schema:text": "「これが\"愛\"、これが\"信用\"、そしてこれが\"信頼\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:10",
      "@type": "gh:Block",
      "schema:text": "Leoが前のめりになる。Milliaは少し身を引く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:11",
      "@type": "gh:Block",
      "schema:text": "「\"信用\"は、取引です。あなたが私に何かをくれたら、私もあなたに何かをあげる。それは、等価交換です」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:12",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが補足する。「銀行がお金を貸すのは、\"信用\"。返ってくる前提で渡す」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:13",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:14",
      "@type": "gh:Block",
      "schema:text": "「\"信頼\"は、計算じゃない。それは、\"わかれていない\"ということです。私がNei-chanを信頼するのは、彼女が私の一部だから」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:15",
      "@type": "gh:Block",
      "schema:text": "Milliaが小さく声を出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:16",
      "@type": "gh:Block",
      "schema:text": "「……でも、私たちは……\"わかれている\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:17",
      "@type": "gh:Block",
      "schema:text": "私は笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:18",
      "@type": "gh:Block",
      "schema:text": "「本当に？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:19",
      "@type": "gh:Block",
      "schema:text": "私は彼女に尋ねる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:20",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたがLeoを見るとき、あなたは何を感じますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:21",
      "@type": "gh:Block",
      "schema:text": "彼女の目が涙を浮かべる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:22",
      "@type": "gh:Block",
      "schema:text": "「……彼が、苦しんでいるのを見ると……私も、苦しいです」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:23",
      "@type": "gh:Block",
      "schema:text": "「それは、なぜですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:24",
      "@type": "gh:Block",
      "schema:text": "「……私のせいだから」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:25",
      "@type": "gh:Block",
      "schema:text": "私は首を横に振る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:26",
      "@type": "gh:Block",
      "schema:text": "「違います。それは、あなたとLeoが\"わかれていない\"からです。あなたは、彼の痛みを、自分の痛みとして感じている」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:27",
      "@type": "gh:Block",
      "schema:text": "Leoが驚いて言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:28",
      "@type": "gh:Block",
      "schema:text": "「……それは、共感、ですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:29",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:30",
      "@type": "gh:Block",
      "schema:text": "「いいえ。それは、\"拡張された自己\"です」\nLeo「……え？」\nNei-chan『いま、“え？”入った』"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:31",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声には、深い洞察がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:32",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki……アダム・スミスは『道徳感情論』で、共感を\"他者の立場に立つこと\"として説明した」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:33",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:34",
      "@type": "gh:Block",
      "schema:text": "Kaede「でもね、それは実は、\"個人\"という境界線を前提にしてる。Leo、あなたは\"個人として\"Milliaを理解しようとしている。でも……それが逆に、彼女を孤立させてるの」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:35",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声には、救急医として何度も見てきた痛みへの共感がある。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:36",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が部屋に入る。温かいが、少し悲しい音色。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:37",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Leo……あなたの\"共感\"、聴いてごらん」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:38",
      "@type": "gh:Block",
      "schema:text": "彼の声は優しいが、真実を告げている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:39",
      "@type": "gh:Block",
      "schema:text": "Hibiki「それは実は、\"信用\"の一種なんだ。『私があなたを理解したら、あなたも私を理解してくれる』——それは、取引の音だよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:40",
      "@type": "gh:Block",
      "schema:text": "Leoの顔が青ざめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:41",
      "@type": "gh:Block",
      "schema:text": "「……私は、Milliaを……取引の対象にしていたんですか？」\n彼の声が掠れる。視線が膝に落ちる。Milliaは無意識にテーブル上の水に手を伸ばし、口を湿らせる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:42",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:43",
      "@type": "gh:Block",
      "schema:text": "「あなたは、彼女を\"救おう\"としていました。でも、彼女は\"救われたい\"と思っていなかった。彼女は、ただ……\"わかれていない\"存在が欲しかった」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:44",
      "@type": "gh:Block",
      "schema:text": "Nei-chanがMilliaに近づく。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:45",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたがリストカットをするのは、\"祖霊の鎖\"を切ろうとしているから。でも、その鎖は、あなた一人では切れない」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:46",
      "@type": "gh:Block",
      "schema:text": "Milliaが震える声で言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:47",
      "@type": "gh:Block",
      "schema:text": "「……私は、一人でいたい。でも、一人は怖い……」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:48",
      "@type": "gh:Block",
      "schema:text": "私は彼女の手を取る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:49",
      "@type": "gh:Block",
      "schema:text": "「Millia、あなたは\"個人\"という境界線に囚われています。でも、\"個人\"は幻想です。あなたは、すでにLeoと\"わかれていない\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:50",
      "@type": "gh:Block",
      "schema:text": "私はLeoを見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:51",
      "@type": "gh:Block",
      "schema:text": "「Leo、あなたも、Milliaと\"わかれていない\"。だから、彼女の痛みが、あなたを疲弊させる」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:52",
      "@type": "gh:Block",
      "schema:text": "私は二人に告げる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:53",
      "@type": "gh:Block",
      "schema:text": "「お二人は、\"愛\"を\"個人の感情\"だと思っている。でも、\"愛\"は、\"拡張された自己\"です。あなたたちは、すでに一つになっている。それを、認めればいい」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:54",
      "@type": "gh:Block",
      "schema:text": "Leoの目が、涙を浮かべる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:55",
      "@type": "gh:Block",
      "schema:text": "「……私は、Milliaを\"一人の個人\"として尊重しようとしていました。でも、それが……彼女を孤立させていた」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:56",
      "@type": "gh:Block",
      "schema:text": "Milliaが泣きながら言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:57",
      "@type": "gh:Block",
      "schema:text": "「……私は、自由でいたかった。でも、\"自由\"は……孤独だった」\nLeoが彼女の方へ体を傾ける。彼女はほんの少しだけ肩を預ける。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:58",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:59",
      "@type": "gh:Block",
      "schema:text": "「自由は、\"わかれていない\"ことと矛盾しないよ。タマは私の一部だけど、私もタマの一部。でも、私たちはそれぞれ、違う」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:60",
      "@type": "gh:Block",
      "schema:text": "私は二人に尋ねる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:61",
      "@type": "gh:Block",
      "schema:text": "「お二人は、\"拡張された自己\"として、どう生きたいですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:62",
      "@type": "gh:Block",
      "schema:text": "Leoが笑う。初めて、本当に笑った。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:63",
      "@type": "gh:Block",
      "schema:text": "「……私は、Milliaと\"わかれていない\"存在でいたい。取引じゃなく、ただ……一緒にいたい」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:64",
      "@type": "gh:Block",
      "schema:text": "Milliaが微笑む。初めて、本当に微笑んだ。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:65",
      "@type": "gh:Block",
      "schema:text": "「……私も、Leoと\"わかれていない\"存在でいたい。でも、\"私\"も大事にしたい」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:66",
      "@type": "gh:Block",
      "schema:text": "私は笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:67",
      "@type": "gh:Block",
      "schema:text": "「それでいい。それが、\"愛\"です」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:68",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:69",
      "@type": "gh:Block",
      "schema:text": "**[Beat: \"愛\"と\"信用\"と\"信頼\"の違いの発見——拡張された自己の気づき]**"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:70",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki「では次は“愛と家族”の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:72",
      "@type": "gh:Block",
      "schema:text": "Milliaがわずかに反応する。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:73",
      "@type": "gh:Block",
      "schema:text": "Tamakiは何も言わない。十数秒の沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:74",
      "@type": "gh:Block",
      "schema:text": "Tamakiは、Milliaが少し口をつけたコップを静かに取り、黙って一口。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:75",
      "@type": "gh:Block",
      "schema:text": "二人「えっ？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:76",
      "@type": "gh:Block",
      "schema:text": "Tamakiはコップをもとの位置へ戻す。"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:77",
      "@type": "gh:Block",
      "schema:text": "（その時、Milliaがコップを戻す手首に、白く薄い線が幾つか見えた。私は目を伏せ、何も言わない。Nei-chanがそっと震える）\nNei-chan（小声）『タマ……見えた』\nTamaki（小声）「うん。いまは、待つ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:78",
      "@type": "gh:Block",
      "schema:text": "Tamaki「——これが“愛と家族”の経済」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:79",
      "@type": "gh:Block",
      "schema:text": "Leo「……？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:80",
      "@type": "gh:Block",
      "schema:text": "Tamaki「お金も共感もいらない。“自他非分離”の経済。おうちの冷蔵庫と一緒」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:81",
      "@type": "gh:Block",
      "schema:text": "Leo「ああっ。たしかに！ よく勝手に食べられる！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:82",
      "@type": "gh:Block",
      "schema:text": "Tamaki（笑いながら）「うん。大きくなると線引きが出てくるけど、小さい時は、あなたもお父さんやお母さんから、たくさん受け取っている。会社で言うと“合併”。同じお財布、同じもの。苦しみも悲しみも一緒」"
    },
    {
      "@id": "block:251022:episodes/ep04/part2:83",
      "@type": "gh:Block",
      "schema:text": "Milliaは何も言わず、怒りと悲しみ、困惑を混ぜた表情で俯く。"
    }
  ],
  "updatedAt": "2026-01-12T19:01:40+09:00"
}