{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep04/part3.en:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Leo Kazan \u0026 Millia Stuart - Part 3"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:2",
      "@type": "gh:Block",
      "schema:text": "Kaede: “From here… the core.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:3",
      "@type": "gh:Block",
      "schema:text": "Tension in her voice."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:4",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, carefully. In ER terms, we’re entering the most delicate procedure.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:5",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Dropping the room one more step.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:6",
      "@type": "gh:Block",
      "schema:text": "Very quiet and kind."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:7",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “I’ll sync completely to their breathing. Let sound hold them.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:8",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, Millia’s wrist… can you see it?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:9",
      "@type": "gh:Block",
      "schema:text": "Tamaki (small): “Yes. Not yet.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:10",
      "@type": "gh:Block",
      "schema:text": "I look at them. Leo leans in; Millia pulls back slightly."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:11",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Then, final question.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:12",
      "@type": "gh:Block",
      "schema:text": "I leave a beat."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:13",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Would you sell a friend for 100 million yen?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:14",
      "@type": "gh:Block",
      "schema:text": "Leo: “Eh—that I would never sell.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:15",
      "@type": "gh:Block",
      "schema:text": "He answers instantly. Millia is silent."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:16",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Then your friendship is worth more than 100 million.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:17",
      "@type": "gh:Block",
      "schema:text": "Leo: “Oh! I see! Yeah! Totally!” He nods happily. Millia nods only slightly."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:18",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Then—would you sell someone you once passed on the street long ago?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:19",
      "@type": "gh:Block",
      "schema:text": "The background thins to a street scene."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:20",
      "@type": "gh:Block",
      "schema:text": "Leo: “Eh? What do you mean?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:21",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Someone you only passed once. You will never meet again. —Would you sell them for 100 million?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:22",
      "@type": "gh:Block",
      "schema:text": "Leo: “Hm… in that case, I might.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:23",
      "@type": "gh:Block",
      "schema:text": "Millia (small): “...I would.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:24",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Right. Value differs by relation. Relationships have value.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:25",
      "@type": "gh:Block",
      "schema:text": "I leave a beat."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:26",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Financial capital is a 2,000 trillion-dollar market. Social capital is worth thousands of times more. The world’s economy runs on sympathy and relation.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:27",
      "@type": "gh:Block",
      "schema:text": "Leo nods. Millia looks down."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:28",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next question. —Would you sell one of your eyes for 100 million?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:29",
      "@type": "gh:Block",
      "schema:text": "Leo’s face changes."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:30",
      "@type": "gh:Block",
      "schema:text": "Leo: “...An eye!? 100 million….” He thinks. “...I’d struggle… but I wouldn’t.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:31",
      "@type": "gh:Block",
      "schema:text": "Millia (small): “...I might.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:32",
      "@type": "gh:Block",
      "schema:text": "Leo turns to her, shocked: “What? You’d sell?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:33",
      "@type": "gh:Block",
      "schema:text": "She says nothing, still looking down."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:34",
      "@type": "gh:Block",
      "schema:text": "I take a deep breath. Now the core."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:35",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Final question.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:36",
      "@type": "gh:Block",
      "schema:text": "I look at them."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:37",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Would you sell your family for 100 million?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:38",
      "@type": "gh:Block",
      "schema:text": "Leo: “Eh—that I would never.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:39",
      "@type": "gh:Block",
      "schema:text": "He answers at once. Millia is silent."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:40",
      "@type": "gh:Block",
      "schema:text": "A long silence."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:41",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, Millia’s emotional metrics… shaking hard.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:42",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “What about a billion?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:43",
      "@type": "gh:Block",
      "schema:text": "Leo: “No!” Firm. Millia—"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:44",
      "@type": "gh:Block",
      "schema:text": "Millia: “...I would.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:45",
      "@type": "gh:Block",
      "schema:text": "Leo: “Eh?” He looks at her."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:46",
      "@type": "gh:Block",
      "schema:text": "Millia looks down, shoulders shivering, then bursts into tears."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:47",
      "@type": "gh:Block",
      "schema:text": "Leo: “Wh-what’s wrong?” He’s lost."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:48",
      "@type": "gh:Block",
      "schema:text": "Millia sobs without answer, then forces out words:"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:49",
      "@type": "gh:Block",
      "schema:text": "Millia: “For one yen… for any amount… I want to sell them…”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:50",
      "@type": "gh:Block",
      "schema:text": "I do not touch that, and speak gently to her instead."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:51",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. The way to tell the economy of love and relationship is ‘can it be sold or not.’”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:52",
      "@type": "gh:Block",
      "schema:text": "I meet her eyes."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:53",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Whether you feel it as ‘yourself’ or not.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:54",
      "@type": "gh:Block",
      "schema:text": "Leo: “I—I see…” He still doesn’t know what to do here."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:55",
      "@type": "gh:Block",
      "schema:text": "I turn to Millia."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:56",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “But even if it’s ‘family,’ it isn’t that you must not sell.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:57",
      "@type": "gh:Block",
      "schema:text": "She stops crying a little."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:58",
      "@type": "gh:Block",
      "schema:text": "Millia: “...It’s okay to sell?”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:59",
      "@type": "gh:Block",
      "schema:text": "Her voice shakes."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:60",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Family too—whether they are ‘you’ or not. You decide.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:61",
      "@type": "gh:Block",
      "schema:text": "I continue softly."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:62",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “In Japanese culture, family is assumed unconditionally to be oneself. In the West, a partner is sworn as oneself before God.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:63",
      "@type": "gh:Block",
      "schema:text": "I hold her gaze."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “You don’t have to love someone who lies, saying ‘I love you.’”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:65",
      "@type": "gh:Block",
      "schema:text": "Leo startles, lost."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:66",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Someone who seizes your sympathy and soul, who binds you—sympathy extraction. That must not be allowed.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:67",
      "@type": "gh:Block",
      "schema:text": "Millia: “But… even if I want to sell, to cut, I can’t cut it off…” Despair."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:68",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Because it has become part of your body.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:69",
      "@type": "gh:Block",
      "schema:text": "I speak quietly."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:70",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “That’s ‘complex.’ A psycho-somatic complex—become spirit. Souls have adhered.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Even if bodies are apart, souls remain bound. Cutting the soul is the same as cutting your body.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:72",
      "@type": "gh:Block",
      "schema:text": "I leave a small pause."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:73",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Cut the soul and it bleeds. Cutting hurts.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:74",
      "@type": "gh:Block",
      "schema:text": "At that moment I see faint white lines on her wrist. Scars of self-harm."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:75",
      "@type": "gh:Block",
      "schema:text": "I lower my eyes and say nothing."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:76",
      "@type": "gh:Block",
      "schema:text": "Nei-chan (small): “Tama… I saw.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki (small): “Mm. Not yet.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:78",
      "@type": "gh:Block",
      "schema:text": "I face Millia."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:79",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “You have courage. But for a proper cut, leave it to a specialist.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:80",
      "@type": "gh:Block",
      "schema:text": "Millia: “...What should I do, Dr. Tamaki?” A small voice with a hint of hope."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:81",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Procedure… anesthesia and surgery. Let me ask.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:82",
      "@type": "gh:Block",
      "schema:text": "Light returns to her eyes."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:83",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:84",
      "@type": "gh:Block",
      "schema:text": "“Yes. There is a specialist. Dr. Itako.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:85",
      "@type": "gh:Block",
      "schema:text": "I meet her gaze."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:86",
      "@type": "gh:Block",
      "schema:text": "“—You can be free.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:87",
      "@type": "gh:Block",
      "schema:text": "Leo slowly takes her hand."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:88",
      "@type": "gh:Block",
      "schema:text": "Leo: “Millia. I’ll… be with you.” Gentle and firm."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:89",
      "@type": "gh:Block",
      "schema:text": "Millia smiles through tears: “...Doctor, please.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:90",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:91",
      "@type": "gh:Block",
      "schema:text": "“It’s okay. You’re not alone. Leo, and all of us, are with you.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:92",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, their hands—holding. Warm.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:93",
      "@type": "gh:Block",
      "schema:text": "Leo takes her hand again—this time, without hesitation."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:94",
      "@type": "gh:Block",
      "schema:text": "Leo: “Millia. I’ll… be with you. Through any operation. After, too.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:95",
      "@type": "gh:Block",
      "schema:text": "Millia smiles through tears: “...Thank you.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:96",
      "@type": "gh:Block",
      "schema:text": "Nei-chan, gently: “Tama, their hands—holding. Warm.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:97",
      "@type": "gh:Block",
      "schema:text": "I look at them."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:98",
      "@type": "gh:Block",
      "schema:text": "“Next step is Dr. Itako’s session. —For today, that’s all. Talk slowly, together.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:99",
      "@type": "gh:Block",
      "schema:text": "Leo nods. Millia nods quietly."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:100",
      "@type": "gh:Block",
      "schema:text": "The room’s light slowly returns."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:101",
      "@type": "gh:Block",
      "schema:text": "Millia’s face softens, just a little. A burden lifts, just a little."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:102",
      "@type": "gh:Block",
      "schema:text": "Leo: “...Millia, I don’t know what happens next, but… we’ll move forward together.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:103",
      "@type": "gh:Block",
      "schema:text": "Millia: “...Yes. Thank you, Leo.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:104",
      "@type": "gh:Block",
      "schema:text": "For the first time, relief colors her voice."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:105",
      "@type": "gh:Block",
      "schema:text": "Their outlines stabilize."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:106",
      "@type": "gh:Block",
      "schema:text": "For the first time—they truly look at each other."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:107",
      "@type": "gh:Block",
      "schema:text": "I smile, quietly."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:108",
      "@type": "gh:Block",
      "schema:text": "“It’s okay. You’re no longer alone. A new road will open.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:109",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, so warm. The color of hope. Sparkly.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:110",
      "@type": "gh:Block",
      "schema:text": "Leo holds her hand; she squeezes back."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:111",
      "@type": "gh:Block",
      "schema:text": "A quiet trust flows between them."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:112",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:113",
      "@type": "gh:Block",
      "schema:text": "“Yes. It’ll be okay. One step at a time.”"
    },
    {
      "@id": "block:251022:episodes/ep04/part3.en:114",
      "@type": "gh:Block",
      "schema:text": "Millia smiles small. Tears not yet dry, but—hope in her eyes."
    }
  ],
  "updatedAt": "2026-01-12T19:01:40+09:00"
}