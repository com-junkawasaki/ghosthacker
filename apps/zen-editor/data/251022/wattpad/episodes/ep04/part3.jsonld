{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep04/part3:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Leo Kazan \u0026 Millia Stuart - Part 3"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:2",
      "@type": "gh:Block",
      "schema:text": "Kaede「ここから……核心」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:3",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、緊張している。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:4",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、慎重に。救急で言えば、これから一番デリケートな処置に入る」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:5",
      "@type": "gh:Block",
      "schema:text": "Hibiki「場の音、もう一段下げるね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:6",
      "@type": "gh:Block",
      "schema:text": "彼の声は、とても静かで、優しい。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:7",
      "@type": "gh:Block",
      "schema:text": "Hibiki「二人の呼吸に完全同期させる。音が、二人を包むように」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:8",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、ミリアの手首……見えてる？』\nTamaki（小声）「うん。でも、今は待つ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:9",
      "@type": "gh:Block",
      "schema:text": "私は二人を見つめる。Leoは前のめりで、Milliaは少し身を引いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:10",
      "@type": "gh:Block",
      "schema:text": "Tamaki「では、最後の質問に行くね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:11",
      "@type": "gh:Block",
      "schema:text": "私は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:12",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは友人を1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:13",
      "@type": "gh:Block",
      "schema:text": "Leo「え、それは絶対売らないよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:14",
      "@type": "gh:Block",
      "schema:text": "Leoは即答する。でも、Milliaは沈黙している。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:15",
      "@type": "gh:Block",
      "schema:text": "Tamaki「じゃあ、あなたの友人との関係には1億円以上の価値がある、ということだね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:16",
      "@type": "gh:Block",
      "schema:text": "Leo「おー！ なるほど！ そうかも！ たしかに！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:17",
      "@type": "gh:Block",
      "schema:text": "Leoは嬉しそうに頷く。Milliaは小さく頷くだけ。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:18",
      "@type": "gh:Block",
      "schema:text": "Tamaki「では、あそこに昔、道ですれ違っただけの人は売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:19",
      "@type": "gh:Block",
      "schema:text": "空間の背景に、薄く街並みのコンテキストが現れる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:20",
      "@type": "gh:Block",
      "schema:text": "Leo「え？ どういうこと」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:21",
      "@type": "gh:Block",
      "schema:text": "Tamaki「昔、道ですれ違っただけの人。その人と二度と会えない。ただそれだけ。——1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:22",
      "@type": "gh:Block",
      "schema:text": "Leo「んー……それなら売るかも」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:23",
      "@type": "gh:Block",
      "schema:text": "Milliaが小さく声を出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:24",
      "@type": "gh:Block",
      "schema:text": "Millia「（小声）……売る」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:25",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。人と関係で価値は異なる。関係性には価値がある」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:26",
      "@type": "gh:Block",
      "schema:text": "私は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:27",
      "@type": "gh:Block",
      "schema:text": "Tamaki「金融資本は20京円の市場がある。でも、社会資本はその数千倍の価値がある。世界の経済は\"共感と関係\"で動いている」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:28",
      "@type": "gh:Block",
      "schema:text": "Leoが頷く。Milliaは俯いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:29",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次の質問。——あなたの片目を1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:30",
      "@type": "gh:Block",
      "schema:text": "Leoの表情が変わる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:31",
      "@type": "gh:Block",
      "schema:text": "Leo「……目！？ 1億円か……」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:32",
      "@type": "gh:Block",
      "schema:text": "彼は少し考え込む。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:33",
      "@type": "gh:Block",
      "schema:text": "Leo「……悩むけど……売れない」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:34",
      "@type": "gh:Block",
      "schema:text": "Milliaが小さく声を出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:35",
      "@type": "gh:Block",
      "schema:text": "Millia「……売る、かも」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:36",
      "@type": "gh:Block",
      "schema:text": "Leoが驚いて彼女を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:37",
      "@type": "gh:Block",
      "schema:text": "Leo「え！ 売るの？！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:38",
      "@type": "gh:Block",
      "schema:text": "Milliaは何も言わない。ただ、俯いている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:39",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。ここからが、本当の核心。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:40",
      "@type": "gh:Block",
      "schema:text": "Tamaki「最後の質問」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:41",
      "@type": "gh:Block",
      "schema:text": "私は二人を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:42",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの家族を1億円で売れますか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:43",
      "@type": "gh:Block",
      "schema:text": "Leo「え、それは絶対売らない」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:44",
      "@type": "gh:Block",
      "schema:text": "Leoは即答する。でも、Milliaは沈黙している。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:45",
      "@type": "gh:Block",
      "schema:text": "長い沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:46",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、ミリアの感情メトリクス……すごく揺れてる』"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:47",
      "@type": "gh:Block",
      "schema:text": "Tamaki「10億円なら？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:48",
      "@type": "gh:Block",
      "schema:text": "Leo「売らない！」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:49",
      "@type": "gh:Block",
      "schema:text": "Leoは力強く言う。でも、Milliaは……"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:50",
      "@type": "gh:Block",
      "schema:text": "Millia「……売る」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:51",
      "@type": "gh:Block",
      "schema:text": "Leo「ええ？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:52",
      "@type": "gh:Block",
      "schema:text": "Leoが驚いて彼女を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:53",
      "@type": "gh:Block",
      "schema:text": "Milliaは俯き、肩が震える。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:54",
      "@type": "gh:Block",
      "schema:text": "そして、泣き出す。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:55",
      "@type": "gh:Block",
      "schema:text": "Leo「ど、どうしたの？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:56",
      "@type": "gh:Block",
      "schema:text": "Leoが驚く。彼は、どうしたらいいかわからない。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:57",
      "@type": "gh:Block",
      "schema:text": "Milliaは泣きじゃくって、何も答えない。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:58",
      "@type": "gh:Block",
      "schema:text": "そして、絞り出すような声で言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:59",
      "@type": "gh:Block",
      "schema:text": "Millia「1円でも……いくらでも売りたい……」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:60",
      "@type": "gh:Block",
      "schema:text": "私はそれには触れず、Milliaに静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。愛と関係性の経済の見分け方は\"売れるか売れないか\"」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:62",
      "@type": "gh:Block",
      "schema:text": "私は彼女の目を見る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:63",
      "@type": "gh:Block",
      "schema:text": "Tamaki「自分と\"感じている\"か否かなの」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:64",
      "@type": "gh:Block",
      "schema:text": "Leo「な、なるほど……」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:65",
      "@type": "gh:Block",
      "schema:text": "Leoは言いつつ、この場でどうしたらいいかわからない。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:66",
      "@type": "gh:Block",
      "schema:text": "私はMilliaに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:67",
      "@type": "gh:Block",
      "schema:text": "Tamaki「でも、家族だからといって売ってはいけないわけじゃないよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:68",
      "@type": "gh:Block",
      "schema:text": "Milliaは少し泣き止む。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:69",
      "@type": "gh:Block",
      "schema:text": "Millia「……売ってもいいんですか？」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:70",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、震えている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。家族も自分か否か。それはあなたが決めていい」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:72",
      "@type": "gh:Block",
      "schema:text": "私は静かに続ける。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:73",
      "@type": "gh:Block",
      "schema:text": "Tamaki「日本の文化では家族は無条件に自分であることを前提にされている。西洋の価値観ではパートナーが自分であることを神に誓う」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:74",
      "@type": "gh:Block",
      "schema:text": "私は彼女の目を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:75",
      "@type": "gh:Block",
      "schema:text": "Tamaki「\"あなたを愛している\"という嘘をつく人を愛さなくていいの」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:76",
      "@type": "gh:Block",
      "schema:text": "Leoがギョッとしながら困惑している。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの共感と魂を奪う、束縛する人、共感の搾取。それは許されることではない」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:78",
      "@type": "gh:Block",
      "schema:text": "Millia「でも……売りたくても、切りたくても切れない……」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:79",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、絶望に満ちている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:80",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それはね。自分の体の一部になっているからだよ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:81",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:82",
      "@type": "gh:Block",
      "schema:text": "Tamaki「それが\"complex\"。心身複合体、spiritになっている。魂が癒着しているの」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:83",
      "@type": "gh:Block",
      "schema:text": "Tamaki「体が離れていても、魂が繋がってしまっている。そして魂を切ることは、自分の体を切ることと一緒」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:84",
      "@type": "gh:Block",
      "schema:text": "私は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:85",
      "@type": "gh:Block",
      "schema:text": "Tamaki「魂を切ると、出血する。だから切ると痛みがある」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:86",
      "@type": "gh:Block",
      "schema:text": "その時、Milliaがコップを戻す手首に、白く薄い線が幾つか見えた。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:87",
      "@type": "gh:Block",
      "schema:text": "リストカットの跡。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:88",
      "@type": "gh:Block",
      "schema:text": "私は目を伏せ、何も言わない。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:89",
      "@type": "gh:Block",
      "schema:text": "Nei-chan（小声）『タマ……見えた』"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:90",
      "@type": "gh:Block",
      "schema:text": "Tamaki（小声）「うん。いまは、待つ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:91",
      "@type": "gh:Block",
      "schema:text": "私はMilliaに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたには勇気がある。でもちゃんと切るのは専門家に任せようね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:93",
      "@type": "gh:Block",
      "schema:text": "Millia「……どうしたらいいですか、Dr. Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:94",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、小さいが、希望が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:95",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。手続きと……麻酔と手術だね。ちょっと聞いてみるね」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:96",
      "@type": "gh:Block",
      "schema:text": "Milliaの目に、小さな光が灯る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:97",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:98",
      "@type": "gh:Block",
      "schema:text": "「うん。専門家がいる。Dr. イタコ」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:99",
      "@type": "gh:Block",
      "schema:text": "私は彼女の目を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:100",
      "@type": "gh:Block",
      "schema:text": "「——あなたは、自由になれる」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:101",
      "@type": "gh:Block",
      "schema:text": "Leoが、ゆっくりとMilliaの手を取る。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:102",
      "@type": "gh:Block",
      "schema:text": "Leo「ミリア。ぼくは……ずっと一緒にいる」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:103",
      "@type": "gh:Block",
      "schema:text": "彼の声は優しい。でも、力強い。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:104",
      "@type": "gh:Block",
      "schema:text": "Milliaが、涙のまま、小さく笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:105",
      "@type": "gh:Block",
      "schema:text": "Millia「……先生、お願いします」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:106",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:107",
      "@type": "gh:Block",
      "schema:text": "「大丈夫。あなたは一人じゃない。Leoも、私たちも、一緒にいる」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:108",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、二人の手、繋がってる。あったかい』"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:109",
      "@type": "gh:Block",
      "schema:text": "Leoが、ゆっくりとMilliaの手を取る。今度は、迷いなく。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:110",
      "@type": "gh:Block",
      "schema:text": "Leo「ミリア。ぼくは……ずっと一緒にいる。どんな手術でも、その後も」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:111",
      "@type": "gh:Block",
      "schema:text": "Milliaが、涙のまま、小さく笑う。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:112",
      "@type": "gh:Block",
      "schema:text": "Millia「……ありがとう」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:113",
      "@type": "gh:Block",
      "schema:text": "Nei-chanの声が、優しく響く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:114",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、二人の手、繋がってる。あったかい』"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:115",
      "@type": "gh:Block",
      "schema:text": "私は二人を見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:116",
      "@type": "gh:Block",
      "schema:text": "「次のステップは、Dr. イタコのセッション。——でも、今日はここまで。二人で、ゆっくり話して」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:117",
      "@type": "gh:Block",
      "schema:text": "Leoが頷く。Milliaも、静かに頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:118",
      "@type": "gh:Block",
      "schema:text": "セッションルームの光が、少しずつ戻っていく。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:119",
      "@type": "gh:Block",
      "schema:text": "Milliaの表情が、ほんの少し、柔らかくなる。重荷が、少しだけ軽くなったように見える。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:120",
      "@type": "gh:Block",
      "schema:text": "Leo「……ミリア、これから、どうなるかわからないけど……でも、一緒に進もう」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:121",
      "@type": "gh:Block",
      "schema:text": "Millia「……うん。ありがとう、Leo」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:122",
      "@type": "gh:Block",
      "schema:text": "彼女の声に、初めて、安心の色が混じる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:123",
      "@type": "gh:Block",
      "schema:text": "二人の輪郭が、安定する。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:124",
      "@type": "gh:Block",
      "schema:text": "そして、初めて——本当に、お互いを見ている。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:125",
      "@type": "gh:Block",
      "schema:text": "私は、静かに微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:126",
      "@type": "gh:Block",
      "schema:text": "「大丈夫。あなたたちは、もう一人じゃない。これから、新しい道が開ける」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:127",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、二人、すごくあったかい。希望の色してる。キラキラしてる』"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:128",
      "@type": "gh:Block",
      "schema:text": "Leoが、Milliaの手をそっと握る。Milliaも、握り返す。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:129",
      "@type": "gh:Block",
      "schema:text": "二人の間に、静かな信頼が流れる。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:130",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:131",
      "@type": "gh:Block",
      "schema:text": "「うん。これから、きっと大丈夫。一歩ずつ、進んでいける」"
    },
    {
      "@id": "block:251022:episodes/ep04/part3:132",
      "@type": "gh:Block",
      "schema:text": "Milliaが、小さく微笑む。涙はまだ乾いていないけれど、その目には——希望がある。"
    }
  ],
  "updatedAt": "2026-01-12T19:01:40+09:00"
}