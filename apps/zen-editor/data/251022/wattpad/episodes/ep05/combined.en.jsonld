{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:combined.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep05/combined.en:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 1"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": \"https://ghosthacker.example.com/\",\n  \"@type\": \"EpisodePart\",\n  \"partOf\": \"episode:s3e3\",\n  \"position\": 1,\n  \"antagonist\": { \"@id\": \"ghost:the-ancestors-chain\" }\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:2",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:3",
      "@type": "gh:Block",
      "schema:text": "Lower level of the Shibuya canal, Schwa’s operating room. Black walls, low luminance. Hibiki’s frequency flows faintly through the space."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:4",
      "@type": "gh:Block",
      "schema:text": "Today is Millia’s surgery to remove the ‘adhesion of soul (Complex).’"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:5",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Pressure is… stable this morning.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:6",
      "@type": "gh:Block",
      "schema:text": "Calm voice, laced with tension."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:7",
      "@type": "gh:Block",
      "schema:text": "Kaede: “But we’re diving deep. I’ve been present at many spiritual surgeries… it’s nerve-wracking every time.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:8",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Tudo bem, Kaede. I’ve fully isolated the room’s band. Zero external noise. Sound, light—everything tuned for Millia’s healing.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:9",
      "@type": "gh:Block",
      "schema:text": "He’s more serious than usual, still warm."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:10",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, they say it hurts. Are you okay?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:11",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:12",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “I’m okay. We’re ready.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:13",
      "@type": "gh:Block",
      "schema:text": "Kaede: “...Pain will come. We are cutting soul.” She lowers her gaze."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:14",
      "@type": "gh:Block",
      "schema:text": "Kaede: “But the procedure is exact. We all protect Millia. Tamaki, you guide. Hibiki, as anesthesiologist, carries ‘anesthesia of awareness.’ Dr. Itako operates.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:15",
      "@type": "gh:Block",
      "schema:text": "ER-calm, with deep compassion."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:16",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Understood.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:17",
      "@type": "gh:Block",
      "schema:text": "I stand at the center. This is an OR for spirit, not flesh. The pain is real."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:18",
      "@type": "gh:Block",
      "schema:text": "The door opens."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:19",
      "@type": "gh:Block",
      "schema:text": "Millia and Leo enter."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:20",
      "@type": "gh:Block",
      "schema:text": "Millia’s eyes hold resolve and fear; her fingertips tremble."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:21",
      "@type": "gh:Block",
      "schema:text": "Leo cups her hand; worry on his face."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:22",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, both are tense. But they’re ready.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:23",
      "@type": "gh:Block",
      "schema:text": "Hibiki steps forward. The badge of anesthesia glints on his coat."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:24",
      "@type": "gh:Block",
      "schema:text": "He meets Millia’s eyes with a gentle smile."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:25",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Millia, first tell me your intention. Why do you dive today?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:26",
      "@type": "gh:Block",
      "schema:text": "Soft voice with professional gravity."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:27",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Ayahuasca is not just anesthesia. Your intention sets the vector of healing.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:28",
      "@type": "gh:Block",
      "schema:text": "Millia breathes in."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:29",
      "@type": "gh:Block",
      "schema:text": "Millia: “...To cut the ‘chain of house’ I inherited from my mother.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:30",
      "@type": "gh:Block",
      "schema:text": "Trembling voice, with resolve."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:31",
      "@type": "gh:Block",
      "schema:text": "Millia: “To live my freedom.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:32",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods deeply, eyes warm with respect."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:33",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Muito bem. Don’t forget that intention. I’ll protect your awareness and lead you gently into depth.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:34",
      "@type": "gh:Block",
      "schema:text": "He signals to Kaede."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:35",
      "@type": "gh:Block",
      "schema:text": "Consent appears in hologram, blue-white light filling the room."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:36",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Final consent before operation.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:37",
      "@type": "gh:Block",
      "schema:text": "ER-calm, warm."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:38",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Anesthesia (Ayahuasca protocol), installation of informational field, intraoperative guidance, handling of records. I’ll read each, slowly. Millia, stop anytime to ask.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:39",
      "@type": "gh:Block",
      "schema:text": "She reads, carefully."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:40",
      "@type": "gh:Block",
      "schema:text": "Millia listens intently. Leo nods by her side."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:41",
      "@type": "gh:Block",
      "schema:text": "Reading complete, Millia overlaps hands to sign—trembling, without hesitation."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:42",
      "@type": "gh:Block",
      "schema:text": "Leo signs the support consent. Resolve and worry mix on his face."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:43",
      "@type": "gh:Block",
      "schema:text": "Kaede: “...Thank you. We will protect you with everything.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:44",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Then, I’ll begin anesthesia.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:45",
      "@type": "gh:Block",
      "schema:text": "He meets her gaze."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:46",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “I’ll install Ayahuasca code into the information field. You will ingest. But this is not coercion. You choose.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:47",
      "@type": "gh:Block",
      "schema:text": "Millia nods."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:48",
      "@type": "gh:Block",
      "schema:text": "He pauses, smiling gently."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:49",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “—Before that, three breaths. With me. Matching breath calms the heart.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:50",
      "@type": "gh:Block",
      "schema:text": "He inhales, slow and warm."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:51",
      "@type": "gh:Block",
      "schema:text": "Millia follows."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:52",
      "@type": "gh:Block",
      "schema:text": "One breath—"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:53",
      "@type": "gh:Block",
      "schema:text": "Slow, deep."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:54",
      "@type": "gh:Block",
      "schema:text": "Two breaths—"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:55",
      "@type": "gh:Block",
      "schema:text": "Deeper."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:56",
      "@type": "gh:Block",
      "schema:text": "Three breaths—"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:57",
      "@type": "gh:Block",
      "schema:text": "The air in the room shifts."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:58",
      "@type": "gh:Block",
      "schema:text": "A small device glows in Hibiki’s hand."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:59",
      "@type": "gh:Block",
      "schema:text": "Blue-white light fills the room."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:60",
      "@type": "gh:Block",
      "schema:text": "A vine-like UI unfurls in the information space."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:61",
      "@type": "gh:Block",
      "schema:text": "Code is woven, quietly."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:62",
      "@type": "gh:Block",
      "schema:text": "Beautiful, and a little uncanny."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:63",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, this… is very complex.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:64",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “I’ll be DJ through the operation—continuously generating the field.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:65",
      "@type": "gh:Block",
      "schema:text": "Quiet, firm; eyes in deep focus."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:66",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Sound, light, scent—everything will support your healing. I’ll protect your awareness as anesthesiologist, while I weave the field with music.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:67",
      "@type": "gh:Block",
      "schema:text": "He smiles a little."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:68",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Do not fear. I’ll be listening to your breath the whole time.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:69",
      "@type": "gh:Block",
      "schema:text": "Millia nods—resolve, and a trace of relief."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:70",
      "@type": "gh:Block",
      "schema:text": "She takes the cup in both hands. Warm."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:71",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Millia… do you choose to drink now?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:72",
      "@type": "gh:Block",
      "schema:text": "Gentle."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:73",
      "@type": "gh:Block",
      "schema:text": "She thinks a little, then says with resolve:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:74",
      "@type": "gh:Block",
      "schema:text": "Millia: “...Yes. I choose it.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:75",
      "@type": "gh:Block",
      "schema:text": "She drinks."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:76",
      "@type": "gh:Block",
      "schema:text": "Her throat bobs."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:77",
      "@type": "gh:Block",
      "schema:text": "Bitterness spreads across her tongue."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:78",
      "@type": "gh:Block",
      "schema:text": "Leo supports her shoulder."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:79",
      "@type": "gh:Block",
      "schema:text": "Leo: “It’s okay. I’m here.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:80",
      "@type": "gh:Block",
      "schema:text": "Nei-chan squeezes my hand."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:81",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, it begins.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:82",
      "@type": "gh:Block",
      "schema:text": "I tap a small kagura, raise ASC."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:83",
      "@type": "gh:Block",
      "schema:text": "The air changes."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:84",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako emerges from the back."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:85",
      "@type": "gh:Block",
      "schema:text": "Young, speaking old; a glamorous elder."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:86",
      "@type": "gh:Block",
      "schema:text": "“Patient, good stability. Hibiki, phase of the field?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:87",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Stable. Gentle descent to alpha. Gamma suppressed.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:88",
      "@type": "gh:Block",
      "schema:text": "The room pulses low."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:89",
      "@type": "gh:Block",
      "schema:text": "Millia’s outline trembles."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:90",
      "@type": "gh:Block",
      "schema:text": "A black ‘chain’ appears behind her."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:91",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, that’s…”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:92",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako raises a scalpel of light and smiles slightly."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:93",
      "@type": "gh:Block",
      "schema:text": "“I usually do sutures, but fine, I’ll cut this time.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:94",
      "@type": "gh:Block",
      "schema:text": "Confidence, easy."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:95",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “Tamaki, hold the position of awareness.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:96",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:97",
      "@type": "gh:Block",
      "schema:text": "“Millia, I’m here. Do not fear. We go together.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:98",
      "@type": "gh:Block",
      "schema:text": "She meets my eyes—trust."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:99",
      "@type": "gh:Block",
      "schema:text": "—The operation begins."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:100",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 2"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:101",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:102",
      "@type": "gh:Block",
      "schema:text": "Millia’s scream fills the room."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:103",
      "@type": "gh:Block",
      "schema:text": "Pain of the body. Pain of the soul."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:104",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako’s scalpel bites into the chain."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:105",
      "@type": "gh:Block",
      "schema:text": "Black pus-like matter spills."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:106",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, this… is very heavy.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:107",
      "@type": "gh:Block",
      "schema:text": "Hibiki keeps weaving the field as DJ."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:108",
      "@type": "gh:Block",
      "schema:text": "Low band receives the fear; filigree highs support the instant of ‘cut.’"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:109",
      "@type": "gh:Block",
      "schema:text": "The wall-lights sync to breath, the informational ground stabilizes."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:110",
      "@type": "gh:Block",
      "schema:text": "Hibiki’s hand keeps time."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:111",
      "@type": "gh:Block",
      "schema:text": "“...Decades of fixed intent congealed.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:112",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako mutters—quiet, heavy."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:113",
      "@type": "gh:Block",
      "schema:text": "I grip Millia’s hand tight."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:114",
      "@type": "gh:Block",
      "schema:text": "“What do you see?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:115",
      "@type": "gh:Block",
      "schema:text": "She trembles and answers:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:116",
      "@type": "gh:Block",
      "schema:text": "“...My mother.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:117",
      "@type": "gh:Block",
      "schema:text": "Tears in her voice."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:118",
      "@type": "gh:Block",
      "schema:text": "“A mother who looks not at me, but at an ideal daughter.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:119",
      "@type": "gh:Block",
      "schema:text": "The chain peels, bit by bit."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:120",
      "@type": "gh:Block",
      "schema:text": "Black pus drops to the floor."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:121",
      "@type": "gh:Block",
      "schema:text": "“You were treated as a ‘part of the house.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:122",
      "@type": "gh:Block",
      "schema:text": "The scalpel goes deep."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:123",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Sorrow mixed with anger. ‘Unforgivable’ is rising.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:124",
      "@type": "gh:Block",
      "schema:text": "Kaede joins, ER-calm with deep compassion:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:125",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Millia… put it into language.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:126",
      "@type": "gh:Block",
      "schema:text": "She pauses."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:127",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Lifting repression needs words. Speak it, release it.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:128",
      "@type": "gh:Block",
      "schema:text": "I prompt her."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:129",
      "@type": "gh:Block",
      "schema:text": "“What do you want to say to your mother?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:130",
      "@type": "gh:Block",
      "schema:text": "She trembles—then screams:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:131",
      "@type": "gh:Block",
      "schema:text": "“I am not your doll!”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:132",
      "@type": "gh:Block",
      "schema:text": "Her voice reverberates."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:133",
      "@type": "gh:Block",
      "schema:text": "“I have feelings! I have a life!”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:134",
      "@type": "gh:Block",
      "schema:text": "Light flashes."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:135",
      "@type": "gh:Block",
      "schema:text": "The chain snaps."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:136",
      "@type": "gh:Block",
      "schema:text": "Her scream melts into sobs—then into a long exhale."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:137",
      "@type": "gh:Block",
      "schema:text": "Leo closes his eyes and wipes a tear."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:138",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “That’s right. Without saying it, it won’t cut.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:139",
      "@type": "gh:Block",
      "schema:text": "Millia continues:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:140",
      "@type": "gh:Block",
      "schema:text": "“I want to be free!”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:141",
      "@type": "gh:Block",
      "schema:text": "Strong."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:142",
      "@type": "gh:Block",
      "schema:text": "“I want to be with Leo!”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:143",
      "@type": "gh:Block",
      "schema:text": "Crying, she shouts:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:144",
      "@type": "gh:Block",
      "schema:text": "“But not ‘for the house’—for me!”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:145",
      "@type": "gh:Block",
      "schema:text": "The chain is fully severed."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:146",
      "@type": "gh:Block",
      "schema:text": "Silence falls."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:147",
      "@type": "gh:Block",
      "schema:text": "Hibiki’s tones move toward softer keys."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:148",
      "@type": "gh:Block",
      "schema:text": "The room shifts."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:149",
      "@type": "gh:Block",
      "schema:text": "Millia says quietly:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:150",
      "@type": "gh:Block",
      "schema:text": "“...I thought I ‘couldn’t forgive’ my mother.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:151",
      "@type": "gh:Block",
      "schema:text": "Her voice is calmer."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:152",
      "@type": "gh:Block",
      "schema:text": "“But my mother was bound by a ‘chain’ too.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:153",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako sets down the scalpel."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:154",
      "@type": "gh:Block",
      "schema:text": "“Understanding is born only after anger passes. Forgiveness is not the freezing of emotion.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:155",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Prepare to ascend.” Gentle reassurance."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:156",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Raising to beta. Slowly, safely.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:157",
      "@type": "gh:Block",
      "schema:text": "His hand changes rhythm, lifting awareness gently from depth."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:158",
      "@type": "gh:Block",
      "schema:text": "Sound softens."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:159",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako nods quietly—stern eyes, a soft mouth."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:160",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “To stop the bleeding, I’ll embed a temporary ‘protective spirit model.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:161",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...Transmute her mother’s ghost?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:162",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “A likeness.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:163",
      "@type": "gh:Block",
      "schema:text": "She reaches into Millia’s information space."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:164",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “It’ll dissolve in about ten years. Once the tissue stabilizes, it will fall away.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:165",
      "@type": "gh:Block",
      "schema:text": "Light wraps Millia."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:166",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “No more chain.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:167",
      "@type": "gh:Block",
      "schema:text": "Joy in her voice."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:168",
      "@type": "gh:Block",
      "schema:text": "Millia’s outline stabilizes."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:169",
      "@type": "gh:Block",
      "schema:text": "Her eyelids quiver."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:170",
      "@type": "gh:Block",
      "schema:text": "Leo embraces her."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:171",
      "@type": "gh:Block",
      "schema:text": "Leo: “...Good. Really, good.” Tears trembling."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:172",
      "@type": "gh:Block",
      "schema:text": "Millia smiles small: “...I’m free.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:173",
      "@type": "gh:Block",
      "schema:text": "Her voice is gentle."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:174",
      "@type": "gh:Block",
      "schema:text": "Warmth returns to the room."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:175",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:176",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Excision of the chain—release of anger; ascent supported by the DJ’d field]**"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:177",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 3"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:178",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:179",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Ascent complete.” Gentle relief in his voice."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:180",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Well done, Millia. Let’s move to recovery. Returning bands to normal.” Professional reassurance."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:181",
      "@type": "gh:Block",
      "schema:text": "Kaede: “I’ll do the post-op explanation.” Calm again, with warmth."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:182",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Rest now. Good work.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:183",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, Millia’s outline is glowing. Beautiful.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:184",
      "@type": "gh:Block",
      "schema:text": "The operation is over."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:185",
      "@type": "gh:Block",
      "schema:text": "No chain binds her back."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:186",
      "@type": "gh:Block",
      "schema:text": "Her outline is light; for the first time, she looks truly free."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:187",
      "@type": "gh:Block",
      "schema:text": "She smiles faintly; tears trace her cheeks."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:188",
      "@type": "gh:Block",
      "schema:text": "Leo touches her brow—then laughs shortly."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:189",
      "@type": "gh:Block",
      "schema:text": "Leo: “...Good.” His voice shakes with relief."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:190",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako puts away the cup."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:191",
      "@type": "gh:Block",
      "schema:text": "“Well, that’s that.” Her tone returns to usual."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:192",
      "@type": "gh:Block",
      "schema:text": "“There shouldn’t be aftereffects, but if you feel ‘phantom chain pain,’ come back.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:193",
      "@type": "gh:Block",
      "schema:text": "Millia bows: “...Thank you, Dr. Itako.” Gratitude fills her voice."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:194",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako laughs: “No need for thanks.” She pats Millia’s shoulder. “Live free—that’s thanks.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:195",
      "@type": "gh:Block",
      "schema:text": "Kaede returns, calm: “I’ll handle the admin afterward.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:196",
      "@type": "gh:Block",
      "schema:text": "Kaede: “We’ll enroll you in the Children \u0026 Families Agency’s protection program. I’ll prepare all documents.” ER-surety."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:197",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Visits… you decide. No compulsion.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:198",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako adds:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:199",
      "@type": "gh:Block",
      "schema:text": "“And—we’re putting your mother in the program as well.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:200",
      "@type": "gh:Block",
      "schema:text": "Millia looks up, surprised."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:201",
      "@type": "gh:Block",
      "schema:text": "“Her operation is scheduled at another facility. You wouldn’t know your mother’s father’s ghost directly, right?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:202",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako smiles a little."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:203",
      "@type": "gh:Block",
      "schema:text": "“A no-good one who won’t face karma. Our excellent hackers will release it, quick.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:204",
      "@type": "gh:Block",
      "schema:text": "Leo turns to me."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:205",
      "@type": "gh:Block",
      "schema:text": "“Tamaki, thanks to you, Millia—and we—truly became ‘not separate.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:206",
      "@type": "gh:Block",
      "schema:text": "I smile: “That was your choice. We only lit the path.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:207",
      "@type": "gh:Block",
      "schema:text": "Millia says softly: “...I want to see my mother again. But not as ‘a daughter’—as ‘a person.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:208",
      "@type": "gh:Block",
      "schema:text": "Nei-chan smiles: “That’s good. Your mother will be glad.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:209",
      "@type": "gh:Block",
      "schema:text": "Hibiki returns the bands; the room brightens to normal."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:210",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, good work. These three sessions were all one ‘LOVE’ theme. Lachlan—‘loneliness and trust.’ Leo and Millia—‘credit vs. trust vs. love.’ And Millia—‘possession vs. love.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:211",
      "@type": "gh:Block",
      "schema:text": "I gaze out the window. The canal’s lattice of light sinks into dusk."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:212",
      "@type": "gh:Block",
      "schema:text": "“...Love is hard.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:213",
      "@type": "gh:Block",
      "schema:text": "Nei-chan returns to my shoulder."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:214",
      "@type": "gh:Block",
      "schema:text": "“But you know love. You love me. I love you.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:215",
      "@type": "gh:Block",
      "schema:text": "I smile: “Yes. That is ‘not being separate.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:216",
      "@type": "gh:Block",
      "schema:text": "Family peeks in the doorway—Leo’s family and siblings, worried."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:217",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “You can come in. Spirit vital is stable.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:218",
      "@type": "gh:Block",
      "schema:text": "Leo’s family enters. Leo stands by Millia’s bed and holds her hand."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:219",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “Good. Leave gene and meme.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:220",
      "@type": "gh:Block",
      "schema:text": "They startle briefly, then laugh together."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:221",
      "@type": "gh:Block",
      "schema:text": "Leo and Millia leave, hand in hand. For the first time, they truly see each other."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:222",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako steps to my side and speaks small:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:223",
      "@type": "gh:Block",
      "schema:text": "“Tamaki, you too will face your ‘chain’ one day.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:224",
      "@type": "gh:Block",
      "schema:text": "I look at her, surprised."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:225",
      "@type": "gh:Block",
      "schema:text": "“...My chain?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:226",
      "@type": "gh:Block",
      "schema:text": "She smiles: “Yes. You are young. But there is adhesion in you as well. It will surface. Come again then.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:227",
      "@type": "gh:Block",
      "schema:text": "She leaves. I think a little."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:228",
      "@type": "gh:Block",
      "schema:text": "Nei-chan, worried: “Tama, you okay?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:229",
      "@type": "gh:Block",
      "schema:text": "I smile: “I’m okay. Now, the next session.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:230",
      "@type": "gh:Block",
      "schema:text": "The canal sinks into sunset."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:231",
      "@type": "gh:Block",
      "schema:text": "The next session means another ‘pain.’"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:232",
      "@type": "gh:Block",
      "schema:text": "But I am ready."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:233",
      "@type": "gh:Block",
      "schema:text": "Nei-chan. Kaede. Hibiki. Dr. Itako."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:234",
      "@type": "gh:Block",
      "schema:text": "And I have breathing that feels good."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:235",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:236",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Operation complete—Millia’s freedom and Tamaki’s foreboding]**"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:237",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:238",
      "@type": "gh:Block",
      "schema:text": "The next day."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:239",
      "@type": "gh:Block",
      "schema:text": "Millia wakes in recovery."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:240",
      "@type": "gh:Block",
      "schema:text": "Leo is at her side; his family watches, worried."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:241",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako enters."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:242",
      "@type": "gh:Block",
      "schema:text": "“Spirit vital is stable. You’re fine.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:243",
      "@type": "gh:Block",
      "schema:text": "Millia nods quietly."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:244",
      "@type": "gh:Block",
      "schema:text": "Kaede (comms): “Your mother will also enter the protection program. Operation scheduled at another facility. The ‘chain of ancestors’ across generations—we’ll release it.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:245",
      "@type": "gh:Block",
      "schema:text": "Millia nods: “...I’ll visit. Not now—someday.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:246",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Yes. You decide that ‘someday.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:247",
      "@type": "gh:Block",
      "schema:text": "I look out the window."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:248",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Freedom doesn’t contradict non-separation. You are free—and we are ‘not separate.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:249",
      "@type": "gh:Block",
      "schema:text": "The canal light pulses quietly."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:250",
      "@type": "gh:Block",
      "schema:text": "Afterglow lasts long."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:251",
      "@type": "gh:Block",
      "schema:text": "Leo and Millia leave holding hands."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:252",
      "@type": "gh:Block",
      "schema:text": "They look truly free—for the first time."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:253",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako stands beside me."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:254",
      "@type": "gh:Block",
      "schema:text": "“Good work, Tamaki.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:255",
      "@type": "gh:Block",
      "schema:text": "I smile: “Thank you.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:256",
      "@type": "gh:Block",
      "schema:text": "She turns serious:"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:257",
      "@type": "gh:Block",
      "schema:text": "“But don’t forget. Your ‘chain’ will show one day.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:258",
      "@type": "gh:Block",
      "schema:text": "I look, surprised."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:259",
      "@type": "gh:Block",
      "schema:text": "“...My chain?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:260",
      "@type": "gh:Block",
      "schema:text": "She smiles: “Yes. You are young. There is adhesion in you, too. It will surface. Come again then.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:261",
      "@type": "gh:Block",
      "schema:text": "She leaves. I think a little."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:262",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, you okay?”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:263",
      "@type": "gh:Block",
      "schema:text": "I smile: “I’m okay. Now, the next session.”"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:264",
      "@type": "gh:Block",
      "schema:text": "Outside, the canal sinks into sunset."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:265",
      "@type": "gh:Block",
      "schema:text": "Light’s lattice ripples on the water."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:266",
      "@type": "gh:Block",
      "schema:text": "A new morning will come."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:267",
      "@type": "gh:Block",
      "schema:text": "We will face someone’s ‘pain’ again."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:268",
      "@type": "gh:Block",
      "schema:text": "That is fine."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:269",
      "@type": "gh:Block",
      "schema:text": "That is our work."
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:270",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/combined.en:271",
      "@type": "gh:Block",
      "schema:text": "**[Afterglow: Quiet residue—Leo and Millia holding hands; a foreboding of Tamaki’s own ‘chain’]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:41+09:00"
}