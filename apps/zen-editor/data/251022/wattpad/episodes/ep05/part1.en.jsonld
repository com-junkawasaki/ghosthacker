{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part1.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep05/part1.en:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 1"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": \"https://ghosthacker.example.com/\",\n  \"@type\": \"EpisodePart\",\n  \"partOf\": \"episode:s3e3\",\n  \"position\": 1,\n  \"antagonist\": { \"@id\": \"ghost:the-ancestors-chain\" }\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:2",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:3",
      "@type": "gh:Block",
      "schema:text": "Lower level of the Shibuya canal, Schwa’s operating room. Black walls, low luminance. Hibiki’s frequency flows faintly through the space."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:4",
      "@type": "gh:Block",
      "schema:text": "Today is Millia’s surgery to remove the ‘adhesion of soul (Complex).’"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:5",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Pressure is… stable this morning.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:6",
      "@type": "gh:Block",
      "schema:text": "Calm voice, laced with tension."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:7",
      "@type": "gh:Block",
      "schema:text": "Kaede: “But we’re diving deep. I’ve been present at many spiritual surgeries… it’s nerve-wracking every time.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:8",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Tudo bem, Kaede. I’ve fully isolated the room’s band. Zero external noise. Sound, light—everything tuned for Millia’s healing.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:9",
      "@type": "gh:Block",
      "schema:text": "He’s more serious than usual, still warm."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:10",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, they say it hurts. Are you okay?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:11",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:12",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “I’m okay. We’re ready.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:13",
      "@type": "gh:Block",
      "schema:text": "Kaede: “...Pain will come. We are cutting soul.” She lowers her gaze."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:14",
      "@type": "gh:Block",
      "schema:text": "Kaede: “But the procedure is exact. We all protect Millia. Tamaki, you guide. Hibiki, as anesthesiologist, carries ‘anesthesia of awareness.’ Dr. Itako operates.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:15",
      "@type": "gh:Block",
      "schema:text": "ER-calm, with deep compassion."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:16",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Understood.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:17",
      "@type": "gh:Block",
      "schema:text": "I stand at the center. This is an OR for spirit, not flesh. The pain is real."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:18",
      "@type": "gh:Block",
      "schema:text": "The door opens."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:19",
      "@type": "gh:Block",
      "schema:text": "Millia and Leo enter."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:20",
      "@type": "gh:Block",
      "schema:text": "Millia’s eyes hold resolve and fear; her fingertips tremble."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:21",
      "@type": "gh:Block",
      "schema:text": "Leo cups her hand; worry on his face."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:22",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, both are tense. But they’re ready.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:23",
      "@type": "gh:Block",
      "schema:text": "Hibiki steps forward. The badge of anesthesia glints on his coat."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:24",
      "@type": "gh:Block",
      "schema:text": "He meets Millia’s eyes with a gentle smile."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:25",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Millia, first tell me your intention. Why do you dive today?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:26",
      "@type": "gh:Block",
      "schema:text": "Soft voice with professional gravity."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:27",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Ayahuasca is not just anesthesia. Your intention sets the vector of healing.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:28",
      "@type": "gh:Block",
      "schema:text": "Millia breathes in."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:29",
      "@type": "gh:Block",
      "schema:text": "Millia: “...To cut the ‘chain of house’ I inherited from my mother.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:30",
      "@type": "gh:Block",
      "schema:text": "Trembling voice, with resolve."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:31",
      "@type": "gh:Block",
      "schema:text": "Millia: “To live my freedom.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:32",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods deeply, eyes warm with respect."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:33",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Muito bem. Don’t forget that intention. I’ll protect your awareness and lead you gently into depth.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:34",
      "@type": "gh:Block",
      "schema:text": "He signals to Kaede."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:35",
      "@type": "gh:Block",
      "schema:text": "Consent appears in hologram, blue-white light filling the room."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:36",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Final consent before operation.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:37",
      "@type": "gh:Block",
      "schema:text": "ER-calm, warm."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:38",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Anesthesia (Ayahuasca protocol), installation of informational field, intraoperative guidance, handling of records. I’ll read each, slowly. Millia, stop anytime to ask.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:39",
      "@type": "gh:Block",
      "schema:text": "She reads, carefully."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:40",
      "@type": "gh:Block",
      "schema:text": "Millia listens intently. Leo nods by her side."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:41",
      "@type": "gh:Block",
      "schema:text": "Reading complete, Millia overlaps hands to sign—trembling, without hesitation."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:42",
      "@type": "gh:Block",
      "schema:text": "Leo signs the support consent. Resolve and worry mix on his face."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:43",
      "@type": "gh:Block",
      "schema:text": "Kaede: “...Thank you. We will protect you with everything.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:44",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Then, I’ll begin anesthesia.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:45",
      "@type": "gh:Block",
      "schema:text": "He meets her gaze."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:46",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “I’ll install Ayahuasca code into the information field. You will ingest. But this is not coercion. You choose.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:47",
      "@type": "gh:Block",
      "schema:text": "Millia nods."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:48",
      "@type": "gh:Block",
      "schema:text": "He pauses, smiling gently."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:49",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “—Before that, three breaths. With me. Matching breath calms the heart.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:50",
      "@type": "gh:Block",
      "schema:text": "He inhales, slow and warm."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:51",
      "@type": "gh:Block",
      "schema:text": "Millia follows."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:52",
      "@type": "gh:Block",
      "schema:text": "One breath—"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:53",
      "@type": "gh:Block",
      "schema:text": "Slow, deep."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:54",
      "@type": "gh:Block",
      "schema:text": "Two breaths—"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:55",
      "@type": "gh:Block",
      "schema:text": "Deeper."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:56",
      "@type": "gh:Block",
      "schema:text": "Three breaths—"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:57",
      "@type": "gh:Block",
      "schema:text": "The air in the room shifts."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:58",
      "@type": "gh:Block",
      "schema:text": "A small device glows in Hibiki’s hand."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:59",
      "@type": "gh:Block",
      "schema:text": "Blue-white light fills the room."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:60",
      "@type": "gh:Block",
      "schema:text": "A vine-like UI unfurls in the information space."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:61",
      "@type": "gh:Block",
      "schema:text": "Code is woven, quietly."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:62",
      "@type": "gh:Block",
      "schema:text": "Beautiful, and a little uncanny."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:63",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, this… is very complex.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:64",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “I’ll be DJ through the operation—continuously generating the field.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:65",
      "@type": "gh:Block",
      "schema:text": "Quiet, firm; eyes in deep focus."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:66",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Sound, light, scent—everything will support your healing. I’ll protect your awareness as anesthesiologist, while I weave the field with music.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:67",
      "@type": "gh:Block",
      "schema:text": "He smiles a little."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:68",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Do not fear. I’ll be listening to your breath the whole time.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:69",
      "@type": "gh:Block",
      "schema:text": "Millia nods—resolve, and a trace of relief."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:70",
      "@type": "gh:Block",
      "schema:text": "She takes the cup in both hands. Warm."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:71",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Millia… do you choose to drink now?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:72",
      "@type": "gh:Block",
      "schema:text": "Gentle."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:73",
      "@type": "gh:Block",
      "schema:text": "She thinks a little, then says with resolve:"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:74",
      "@type": "gh:Block",
      "schema:text": "Millia: “...Yes. I choose it.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:75",
      "@type": "gh:Block",
      "schema:text": "She drinks."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:76",
      "@type": "gh:Block",
      "schema:text": "Her throat bobs."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:77",
      "@type": "gh:Block",
      "schema:text": "Bitterness spreads across her tongue."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:78",
      "@type": "gh:Block",
      "schema:text": "Leo supports her shoulder."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:79",
      "@type": "gh:Block",
      "schema:text": "Leo: “It’s okay. I’m here.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:80",
      "@type": "gh:Block",
      "schema:text": "Nei-chan squeezes my hand."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:81",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, it begins.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:82",
      "@type": "gh:Block",
      "schema:text": "I tap a small kagura, raise ASC."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:83",
      "@type": "gh:Block",
      "schema:text": "The air changes."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:84",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako emerges from the back."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:85",
      "@type": "gh:Block",
      "schema:text": "Young, speaking old; a glamorous elder."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:86",
      "@type": "gh:Block",
      "schema:text": "“Patient, good stability. Hibiki, phase of the field?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:87",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Stable. Gentle descent to alpha. Gamma suppressed.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:88",
      "@type": "gh:Block",
      "schema:text": "The room pulses low."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:89",
      "@type": "gh:Block",
      "schema:text": "Millia’s outline trembles."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:90",
      "@type": "gh:Block",
      "schema:text": "A black ‘chain’ appears behind her."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:91",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, that’s…”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:92",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako raises a scalpel of light and smiles slightly."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:93",
      "@type": "gh:Block",
      "schema:text": "“I usually do sutures, but fine, I’ll cut this time.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:94",
      "@type": "gh:Block",
      "schema:text": "Confidence, easy."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:95",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “Tamaki, hold the position of awareness.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:96",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:97",
      "@type": "gh:Block",
      "schema:text": "“Millia, I’m here. Do not fear. We go together.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:98",
      "@type": "gh:Block",
      "schema:text": "She meets my eyes—trust."
    },
    {
      "@id": "block:251022:episodes/ep05/part1.en:99",
      "@type": "gh:Block",
      "schema:text": "—The operation begins."
    }
  ],
  "updatedAt": "2026-01-12T19:01:41+09:00"
}