{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part1",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep05/part1:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 1\nsss\n```json\n{\n  \"@context\": \"https://ghosthacker.example.com/\",\n  \"@type\": \"EpisodePart\",\n  \"partOf\": \"episode:s3e3\",\n  \"position\": 1,\n  \"antagonist\": { \"@id\": \"ghost:the-ancestors-chain\" }\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:2",
      "@type": "gh:Block",
      "schema:text": "渋谷の運河下層、Schwaの手術室。黒い壁、低い照度。空間にはHibikiの周波数が薄く流れている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:3",
      "@type": "gh:Block",
      "schema:text": "今日はMilliaの\"魂の癒着（Complex）\"の切除手術。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:4",
      "@type": "gh:Block",
      "schema:text": "Kaede「今朝の気圧は……安定してる」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:5",
      "@type": "gh:Block",
      "schema:text": "彼女の声は静かだが、緊張が滲んでいる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:6",
      "@type": "gh:Block",
      "schema:text": "Kaede「でもね、Tamaki。これから深く潜る。霊的手術は、私も何度も立ち会ってきたけど……毎回、緊張する」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:7",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Tudo bem, Kaede。手術室の帯域、完全に隔離したよ。外部ノイズはゼロ。音も光も、全部Milliaの治癒のために調整済み」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:8",
      "@type": "gh:Block",
      "schema:text": "彼の声はいつもより真剣だが、温かさがある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:9",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、痛いって聞いた。大丈夫？』"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:10",
      "@type": "gh:Block",
      "schema:text": "私は深く息を吸う。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:11",
      "@type": "gh:Block",
      "schema:text": "Tamaki「大丈夫。私たちは準備ができている」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:12",
      "@type": "gh:Block",
      "schema:text": "Kaede「……痛みは伴う。魂を切るんだから」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:13",
      "@type": "gh:Block",
      "schema:text": "彼女は少し目を伏せる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:14",
      "@type": "gh:Block",
      "schema:text": "Kaede「でも手順は厳格。私たち全員が、Milliaを守る。Tamaki、あなたはガイド。Hibikiが麻酔科医として\"意識の麻酔\"を担当。Dr. イタコが執刀」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:15",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声は、救急医のそれだ。冷静だが、深い共感がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:16",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。わかってる」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:17",
      "@type": "gh:Block",
      "schema:text": "私は手術室の中央に立つ。ここは、魂の手術室。物理的な手術ではない。でも、痛みは本物。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:18",
      "@type": "gh:Block",
      "schema:text": "扉が開く音。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:19",
      "@type": "gh:Block",
      "schema:text": "MilliaとLeoが入ってくる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:20",
      "@type": "gh:Block",
      "schema:text": "Milliaの瞳は決意と恐れの両方。指先が小刻みに震えている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:21",
      "@type": "gh:Block",
      "schema:text": "Leoはその手を包む。彼の顔にも、不安が浮かんでいる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:22",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、二人とも緊張してる。でも、覚悟はできてる』"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:23",
      "@type": "gh:Block",
      "schema:text": "Hibikiが前へ出る。白衣の胸元に、麻酔科医の資格章が光っている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:24",
      "@type": "gh:Block",
      "schema:text": "彼はMilliaの目を見て、優しく微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:25",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Millia、まず\"intention（意図）\"を聞かせて。今日は何のために潜る？」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:26",
      "@type": "gh:Block",
      "schema:text": "彼の声は優しいが、麻酔科医としての真剣さがある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:27",
      "@type": "gh:Block",
      "schema:text": "Hibiki「アヤワスカは、ただの麻酔じゃない。あなたの意図が、治癒の方向を決める」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:28",
      "@type": "gh:Block",
      "schema:text": "Milliaは深く息を吸う。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:29",
      "@type": "gh:Block",
      "schema:text": "Millia「……母から受け継いだ\"家\"の鎖を切るため」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:30",
      "@type": "gh:Block",
      "schema:text": "彼女の声は震えている。でも、決意がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:31",
      "@type": "gh:Block",
      "schema:text": "Millia「自分の自由を生きるため」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:32",
      "@type": "gh:Block",
      "schema:text": "Hibikiは深く頷く。彼の目には、温かさと尊敬がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:33",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Muito bem（とてもいい）。その意図を、最後まで忘れないで。ぼくは麻酔科医として、あなたの意識を守りながら、深い場所へ連れて行く」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:34",
      "@type": "gh:Block",
      "schema:text": "Hibikiが、Kaedeへ合図する。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:35",
      "@type": "gh:Block",
      "schema:text": "空間にホログラムの同意書が投影される。青白い光が、部屋を照らす。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:36",
      "@type": "gh:Block",
      "schema:text": "Kaede「手術前最終同意」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:37",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、救急医のそれ——冷静だが、温かい。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:38",
      "@type": "gh:Block",
      "schema:text": "Kaede「麻酔（アヤワスカ・プロトコル）、情報場インストール、術中ガイド、記録の扱い。一つずつ、ゆっくり読み上げるね。Millia、わからないことがあったら、いつでも止めていい」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:39",
      "@type": "gh:Block",
      "schema:text": "Kaedeが、ゆっくりと読み上げる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:40",
      "@type": "gh:Block",
      "schema:text": "彼女の声には、深い配慮がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:41",
      "@type": "gh:Block",
      "schema:text": "Milliaは真剣に聞いている。Leoも、彼女の横で頷いている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:42",
      "@type": "gh:Block",
      "schema:text": "読み上げ完了後、Milliaは手を重ねてサインする。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:43",
      "@type": "gh:Block",
      "schema:text": "彼女の手は震えているが、迷いはない。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:44",
      "@type": "gh:Block",
      "schema:text": "Leoもサポート同意にサイン。彼の顔には、決意と不安が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:45",
      "@type": "gh:Block",
      "schema:text": "Kaede「……ありがとう。私たちは、全力であなたを守る」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:46",
      "@type": "gh:Block",
      "schema:text": "Hibiki「では、麻酔に入るね」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:47",
      "@type": "gh:Block",
      "schema:text": "Hibikiは、Milliaの目を優しく見つめる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:48",
      "@type": "gh:Block",
      "schema:text": "Hibiki「アヤワスカ・コードを情報場にインストールする。あなたは\"ingest（摂取）\"する。でもね、これは強制じゃない。あなたが選ぶ」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:49",
      "@type": "gh:Block",
      "schema:text": "Milliaは頷く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:50",
      "@type": "gh:Block",
      "schema:text": "Hibikiは少し間を置き、優しく微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:51",
      "@type": "gh:Block",
      "schema:text": "Hibiki「——その前に、三呼吸。ぼくと一緒に。呼吸を合わせると、心が落ち着くから」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:52",
      "@type": "gh:Block",
      "schema:text": "Hibikiが深く息を吸う。彼の呼吸は、ゆっくりで、温かい。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:53",
      "@type": "gh:Block",
      "schema:text": "Milliaも、それに合わせる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:54",
      "@type": "gh:Block",
      "schema:text": "一呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:55",
      "@type": "gh:Block",
      "schema:text": "ゆっくりと、深く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:56",
      "@type": "gh:Block",
      "schema:text": "二呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:57",
      "@type": "gh:Block",
      "schema:text": "さらに深く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:58",
      "@type": "gh:Block",
      "schema:text": "三呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:59",
      "@type": "gh:Block",
      "schema:text": "部屋の空気が、変わる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:60",
      "@type": "gh:Block",
      "schema:text": "Hibikiの手元で小さな端末が光る。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:61",
      "@type": "gh:Block",
      "schema:text": "青白い光が、部屋を満たす。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:62",
      "@type": "gh:Block",
      "schema:text": "室内の\"情報空間\"に蔓模様のUIが展開される。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:63",
      "@type": "gh:Block",
      "schema:text": "コードが静かに編み込まれる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:64",
      "@type": "gh:Block",
      "schema:text": "美しい、でも少し不気味な光景。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:65",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これ……すごく複雑』"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:66",
      "@type": "gh:Block",
      "schema:text": "Hibiki「今からDJとして、術中の場を生成し続けるよ」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:67",
      "@type": "gh:Block",
      "schema:text": "Hibikiの声は、静かだが力強い。彼の目には、深い集中がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:68",
      "@type": "gh:Block",
      "schema:text": "Hibiki「音と光と匂い——すべてがあなたの治癒を支援するように。ぼくは麻酔科医として、あなたの意識を守りながら、音楽で場を編む」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:69",
      "@type": "gh:Block",
      "schema:text": "彼は少し微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:70",
      "@type": "gh:Block",
      "schema:text": "Hibiki「怖くないよ。ぼくがずっと、あなたの呼吸を聴いてる」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:71",
      "@type": "gh:Block",
      "schema:text": "Milliaは頷く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:72",
      "@type": "gh:Block",
      "schema:text": "彼女の目には、決意と、少しの安心がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:73",
      "@type": "gh:Block",
      "schema:text": "Hibikiから渡されたカップを両手で支える。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:74",
      "@type": "gh:Block",
      "schema:text": "カップは、温かい。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:75",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Millia……いま飲むことを、あなた自身が選ぶ？」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:76",
      "@type": "gh:Block",
      "schema:text": "彼の声は、とても優しい。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:77",
      "@type": "gh:Block",
      "schema:text": "Milliaは少し考える。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:78",
      "@type": "gh:Block",
      "schema:text": "そして、決意を込めて言う。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:79",
      "@type": "gh:Block",
      "schema:text": "Millia「……はい。私が選びます」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:80",
      "@type": "gh:Block",
      "schema:text": "彼女は一口、飲む。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:81",
      "@type": "gh:Block",
      "schema:text": "喉が上下する。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:82",
      "@type": "gh:Block",
      "schema:text": "苦い味が、口の中に広がる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:83",
      "@type": "gh:Block",
      "schema:text": "Leoが彼女の肩を支える。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:84",
      "@type": "gh:Block",
      "schema:text": "Leo「大丈夫。ぼくがここにいる」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:85",
      "@type": "gh:Block",
      "schema:text": "Nei-chanが私の手を握る。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:86",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、始まる』"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:87",
      "@type": "gh:Block",
      "schema:text": "私は神楽を小さく踏み、ASC制御を上げる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:88",
      "@type": "gh:Block",
      "schema:text": "部屋の空気が変わる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:89",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコが奥から現れる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:90",
      "@type": "gh:Block",
      "schema:text": "若く、しかし口調は老練。グラマーな老婆。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:91",
      "@type": "gh:Block",
      "schema:text": "「患者、状態良好。Hibiki、場の位相は？」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:92",
      "@type": "gh:Block",
      "schema:text": "Hibiki「安定。アルファへ緩やかに降下中。ガンマは抑制」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:93",
      "@type": "gh:Block",
      "schema:text": "部屋が低く脈を打つ。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:94",
      "@type": "gh:Block",
      "schema:text": "Milliaの輪郭が揺れる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:95",
      "@type": "gh:Block",
      "schema:text": "彼女の背後に、黒い\"鎖\"が見える。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:96",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、あれが……』"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:97",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコは光のメスを掲げる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:98",
      "@type": "gh:Block",
      "schema:text": "そして、少し笑う。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:99",
      "@type": "gh:Block",
      "schema:text": "「ほんとは私は縫合専門なんだけどね。いいよ、今回は切開もやろうじゃないか」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:100",
      "@type": "gh:Block",
      "schema:text": "彼女の声には、自信がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:101",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコ「Tamaki、意識の位置取りは頼んだ」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:102",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:103",
      "@type": "gh:Block",
      "schema:text": "「Millia、ここにいる。怖くない。いっしょに行く」"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:104",
      "@type": "gh:Block",
      "schema:text": "Milliaが私を見る。その目には、信頼がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part1:105",
      "@type": "gh:Block",
      "schema:text": "——手術が始まる。"
    }
  ],
  "updatedAt": "2026-01-12T19:01:42+09:00"
}