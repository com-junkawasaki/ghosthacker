{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep05/part2.en:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 2"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:2",
      "@type": "gh:Block",
      "schema:text": "Millia’s scream fills the room."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:3",
      "@type": "gh:Block",
      "schema:text": "Pain of the body. Pain of the soul."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:4",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako’s scalpel bites into the chain."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:5",
      "@type": "gh:Block",
      "schema:text": "Black pus-like matter spills."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:6",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, this… is very heavy.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:7",
      "@type": "gh:Block",
      "schema:text": "Hibiki keeps weaving the field as DJ."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:8",
      "@type": "gh:Block",
      "schema:text": "Low band receives the fear; filigree highs support the instant of ‘cut.’"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:9",
      "@type": "gh:Block",
      "schema:text": "The wall-lights sync to breath, the informational ground stabilizes."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:10",
      "@type": "gh:Block",
      "schema:text": "Hibiki’s hand keeps time."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:11",
      "@type": "gh:Block",
      "schema:text": "“...Decades of fixed intent congealed.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:12",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako mutters—quiet, heavy."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:13",
      "@type": "gh:Block",
      "schema:text": "I grip Millia’s hand tight."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:14",
      "@type": "gh:Block",
      "schema:text": "“What do you see?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:15",
      "@type": "gh:Block",
      "schema:text": "She trembles and answers:"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:16",
      "@type": "gh:Block",
      "schema:text": "“...My mother.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:17",
      "@type": "gh:Block",
      "schema:text": "Tears in her voice."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:18",
      "@type": "gh:Block",
      "schema:text": "“A mother who looks not at me, but at an ideal daughter.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:19",
      "@type": "gh:Block",
      "schema:text": "The chain peels, bit by bit."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:20",
      "@type": "gh:Block",
      "schema:text": "Black pus drops to the floor."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:21",
      "@type": "gh:Block",
      "schema:text": "“You were treated as a ‘part of the house.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:22",
      "@type": "gh:Block",
      "schema:text": "The scalpel goes deep."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:23",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Sorrow mixed with anger. ‘Unforgivable’ is rising.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:24",
      "@type": "gh:Block",
      "schema:text": "Kaede joins, ER-calm with deep compassion:"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:25",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Millia… put it into language.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:26",
      "@type": "gh:Block",
      "schema:text": "She pauses."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:27",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Lifting repression needs words. Speak it, release it.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:28",
      "@type": "gh:Block",
      "schema:text": "I prompt her."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:29",
      "@type": "gh:Block",
      "schema:text": "“What do you want to say to your mother?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:30",
      "@type": "gh:Block",
      "schema:text": "She trembles—then screams:"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:31",
      "@type": "gh:Block",
      "schema:text": "“I am not your doll!”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:32",
      "@type": "gh:Block",
      "schema:text": "Her voice reverberates."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:33",
      "@type": "gh:Block",
      "schema:text": "“I have feelings! I have a life!”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:34",
      "@type": "gh:Block",
      "schema:text": "Light flashes."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:35",
      "@type": "gh:Block",
      "schema:text": "The chain snaps."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:36",
      "@type": "gh:Block",
      "schema:text": "Her scream melts into sobs—then into a long exhale."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:37",
      "@type": "gh:Block",
      "schema:text": "Leo closes his eyes and wipes a tear."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:38",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “That’s right. Without saying it, it won’t cut.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:39",
      "@type": "gh:Block",
      "schema:text": "Millia continues:"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:40",
      "@type": "gh:Block",
      "schema:text": "“I want to be free!”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:41",
      "@type": "gh:Block",
      "schema:text": "Strong."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:42",
      "@type": "gh:Block",
      "schema:text": "“I want to be with Leo!”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:43",
      "@type": "gh:Block",
      "schema:text": "Crying, she shouts:"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:44",
      "@type": "gh:Block",
      "schema:text": "“But not ‘for the house’—for me!”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:45",
      "@type": "gh:Block",
      "schema:text": "The chain is fully severed."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:46",
      "@type": "gh:Block",
      "schema:text": "Silence falls."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:47",
      "@type": "gh:Block",
      "schema:text": "Hibiki’s tones move toward softer keys."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:48",
      "@type": "gh:Block",
      "schema:text": "The room shifts."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:49",
      "@type": "gh:Block",
      "schema:text": "Millia says quietly:"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:50",
      "@type": "gh:Block",
      "schema:text": "“...I thought I ‘couldn’t forgive’ my mother.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:51",
      "@type": "gh:Block",
      "schema:text": "Her voice is calmer."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:52",
      "@type": "gh:Block",
      "schema:text": "“But my mother was bound by a ‘chain’ too.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:53",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako sets down the scalpel."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:54",
      "@type": "gh:Block",
      "schema:text": "“Understanding is born only after anger passes. Forgiveness is not the freezing of emotion.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:55",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Prepare to ascend.” Gentle reassurance."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:56",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Raising to beta. Slowly, safely.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:57",
      "@type": "gh:Block",
      "schema:text": "His hand changes rhythm, lifting awareness gently from depth."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:58",
      "@type": "gh:Block",
      "schema:text": "Sound softens."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:59",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako nods quietly—stern eyes, a soft mouth."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:60",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “To stop the bleeding, I’ll embed a temporary ‘protective spirit model.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...Transmute her mother’s ghost?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:62",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “A likeness.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:63",
      "@type": "gh:Block",
      "schema:text": "She reaches into Millia’s information space."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:64",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “It’ll dissolve in about ten years. Once the tissue stabilizes, it will fall away.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:65",
      "@type": "gh:Block",
      "schema:text": "Light wraps Millia."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:66",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “No more chain.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:67",
      "@type": "gh:Block",
      "schema:text": "Joy in her voice."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:68",
      "@type": "gh:Block",
      "schema:text": "Millia’s outline stabilizes."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:69",
      "@type": "gh:Block",
      "schema:text": "Her eyelids quiver."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:70",
      "@type": "gh:Block",
      "schema:text": "Leo embraces her."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:71",
      "@type": "gh:Block",
      "schema:text": "Leo: “...Good. Really, good.” Tears trembling."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:72",
      "@type": "gh:Block",
      "schema:text": "Millia smiles small: “...I’m free.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:73",
      "@type": "gh:Block",
      "schema:text": "Her voice is gentle."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:74",
      "@type": "gh:Block",
      "schema:text": "Warmth returns to the room."
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:75",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part2.en:76",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Excision of the chain—release of anger; ascent supported by the DJ’d field]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:42+09:00"
}