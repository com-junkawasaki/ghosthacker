{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep05/part2:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 2"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:2",
      "@type": "gh:Block",
      "schema:text": "Milliaの叫びが部屋に響く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:3",
      "@type": "gh:Block",
      "schema:text": "痛みの叫び。魂の叫び。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:4",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコのメスが鎖に食い込む。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:5",
      "@type": "gh:Block",
      "schema:text": "黒い膿のようなものが溢れ出す。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:6",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これ……すごく重い』"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:7",
      "@type": "gh:Block",
      "schema:text": "HibikiはDJとして場を編み続ける。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:8",
      "@type": "gh:Block",
      "schema:text": "低域は不安を受け止め、微細な高域が\"切断\"の瞬間を支援する。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:9",
      "@type": "gh:Block",
      "schema:text": "壁面の光は呼吸に同期し、情報空間の地床が安定する。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:10",
      "@type": "gh:Block",
      "schema:text": "Hibikiの手が、リズムを刻む。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:11",
      "@type": "gh:Block",
      "schema:text": "「……何十年分の念が凝固してる」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:12",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコが呟く。その声は、静かだが重い。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:13",
      "@type": "gh:Block",
      "schema:text": "私はMilliaの手を強く握る。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:14",
      "@type": "gh:Block",
      "schema:text": "「いま、何が見える？」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:15",
      "@type": "gh:Block",
      "schema:text": "Milliaは震えながら答える。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:16",
      "@type": "gh:Block",
      "schema:text": "「……母が見えます」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:17",
      "@type": "gh:Block",
      "schema:text": "彼女の声は涙で濡れている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:18",
      "@type": "gh:Block",
      "schema:text": "「私ではなく、理想の娘を見ている母が」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:19",
      "@type": "gh:Block",
      "schema:text": "鎖が少しずつ剥がれる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:20",
      "@type": "gh:Block",
      "schema:text": "黒い膿が、床に落ちる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:21",
      "@type": "gh:Block",
      "schema:text": "「お前は\"家の部品\"として扱われた」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:22",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコのメスが深く入る。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:23",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『悲しみと怒りが混ざってる。いま\"許せない\"が立ち上がった』"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:24",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声は、救急医のそれ——冷静だが、深い共感がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:25",
      "@type": "gh:Block",
      "schema:text": "Kaede「Millia……それを言語化して」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:26",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:27",
      "@type": "gh:Block",
      "schema:text": "Kaede「抑圧の解除には、言葉が要る。声に出して、解放して」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:28",
      "@type": "gh:Block",
      "schema:text": "私は促す。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:29",
      "@type": "gh:Block",
      "schema:text": "「母に、何を言いたい？」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:30",
      "@type": "gh:Block",
      "schema:text": "Milliaは震える。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:31",
      "@type": "gh:Block",
      "schema:text": "そして、叫ぶ。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:32",
      "@type": "gh:Block",
      "schema:text": "「私はあなたの人形じゃない！」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:33",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、部屋中に響く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:34",
      "@type": "gh:Block",
      "schema:text": "「私の感情がある！ 私の人生がある！」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:35",
      "@type": "gh:Block",
      "schema:text": "光が閃く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:36",
      "@type": "gh:Block",
      "schema:text": "鎖が音を立てて切れる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:37",
      "@type": "gh:Block",
      "schema:text": "Milliaの叫びは嗚咽へ変わる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:38",
      "@type": "gh:Block",
      "schema:text": "やがて長い吐息に解ける。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:39",
      "@type": "gh:Block",
      "schema:text": "Leoは目を閉じ、手の甲で涙を拭った。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:40",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコが言う。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:41",
      "@type": "gh:Block",
      "schema:text": "「そうだ、それを言わなきゃ切れない」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:42",
      "@type": "gh:Block",
      "schema:text": "Milliaは続ける。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:43",
      "@type": "gh:Block",
      "schema:text": "「私は自由でいたい！」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:44",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、力強い。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:45",
      "@type": "gh:Block",
      "schema:text": "「Leoと一緒にいたい！」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:46",
      "@type": "gh:Block",
      "schema:text": "彼女は泣きながら叫ぶ。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:47",
      "@type": "gh:Block",
      "schema:text": "「でも\"家のため\"じゃない、私のため！」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:48",
      "@type": "gh:Block",
      "schema:text": "鎖が完全に切断される。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:49",
      "@type": "gh:Block",
      "schema:text": "静けさが降りる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:50",
      "@type": "gh:Block",
      "schema:text": "Hibikiの音が、より柔らかい調性へ遷移する。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:51",
      "@type": "gh:Block",
      "schema:text": "部屋の空気が、変わる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:52",
      "@type": "gh:Block",
      "schema:text": "Milliaが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:53",
      "@type": "gh:Block",
      "schema:text": "「……私は母を\"許せない\"と思っていた」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:54",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、穏やかになっている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:55",
      "@type": "gh:Block",
      "schema:text": "「でも、母も\"鎖\"に縛られていた」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:56",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコはメスを置く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:57",
      "@type": "gh:Block",
      "schema:text": "「怒りを通って初めて理解が生まれる。許しは感情の凍結ではない」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:58",
      "@type": "gh:Block",
      "schema:text": "Hibiki「上昇準備」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:59",
      "@type": "gh:Block",
      "schema:text": "彼の声は、優しく、安心感がある。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:60",
      "@type": "gh:Block",
      "schema:text": "Hibiki「場をβ帯域へ引き上げる。ゆっくりと、安全に」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:61",
      "@type": "gh:Block",
      "schema:text": "Hibikiの手が、リズムを変える。麻酔科医として、意識を深い場所から優しく引き上げる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:62",
      "@type": "gh:Block",
      "schema:text": "音が、柔らかくなる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:63",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコは静かに頷く。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:64",
      "@type": "gh:Block",
      "schema:text": "その視線は厳しいが、口元だけがやわらぐ。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:65",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコ「出血止めのために、仮の\"保護用スピリットモデル\"を埋め込むよ」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:66",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……お母さんのゴーストを変換？」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:67",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコ「似姿だ」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:68",
      "@type": "gh:Block",
      "schema:text": "彼女は、Milliaの情報空間に手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:69",
      "@type": "gh:Block",
      "schema:text": "Dr. イタコ「十年もすれば自壊する。組織が安定すれば自然に外れる」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:70",
      "@type": "gh:Block",
      "schema:text": "光が、Milliaの周りを包む。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:71",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『もう、鎖はない』"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:72",
      "@type": "gh:Block",
      "schema:text": "Nei-chanの声は、嬉しそうだ。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:73",
      "@type": "gh:Block",
      "schema:text": "Milliaの輪郭が安定する。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:74",
      "@type": "gh:Block",
      "schema:text": "瞼が震える。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:75",
      "@type": "gh:Block",
      "schema:text": "Leoが彼女を抱きしめる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:76",
      "@type": "gh:Block",
      "schema:text": "Leo「……よかった。本当に、よかった」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:77",
      "@type": "gh:Block",
      "schema:text": "彼の声は、涙で震えている。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:78",
      "@type": "gh:Block",
      "schema:text": "Milliaが小さく笑う。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:79",
      "@type": "gh:Block",
      "schema:text": "「……自由になったよ」"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:80",
      "@type": "gh:Block",
      "schema:text": "彼女の声は、穏やかだ。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:81",
      "@type": "gh:Block",
      "schema:text": "部屋の空気が、温かくなる。"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:82",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part2:83",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 鎖の切除——怒りの解放、DJの場に支えられた浮上]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:43+09:00"
}