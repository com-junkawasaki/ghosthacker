{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep05/part3.en:0",
      "@type": "gh:Block",
      "schema:text": "# Session: Dr. Itako - Spiritual Surgery - Part 3"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:2",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Ascent complete.” Gentle relief in his voice."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:3",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Well done, Millia. Let’s move to recovery. Returning bands to normal.” Professional reassurance."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:4",
      "@type": "gh:Block",
      "schema:text": "Kaede: “I’ll do the post-op explanation.” Calm again, with warmth."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:5",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Rest now. Good work.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:6",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, Millia’s outline is glowing. Beautiful.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:7",
      "@type": "gh:Block",
      "schema:text": "The operation is over."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:8",
      "@type": "gh:Block",
      "schema:text": "No chain binds her back."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:9",
      "@type": "gh:Block",
      "schema:text": "Her outline is light; for the first time, she looks truly free."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:10",
      "@type": "gh:Block",
      "schema:text": "She smiles faintly; tears trace her cheeks."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:11",
      "@type": "gh:Block",
      "schema:text": "Leo touches her brow—then laughs shortly."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:12",
      "@type": "gh:Block",
      "schema:text": "Leo: “...Good.” His voice shakes with relief."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:13",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako puts away the cup."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:14",
      "@type": "gh:Block",
      "schema:text": "“Well, that’s that.” Her tone returns to usual."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:15",
      "@type": "gh:Block",
      "schema:text": "“There shouldn’t be aftereffects, but if you feel ‘phantom chain pain,’ come back.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:16",
      "@type": "gh:Block",
      "schema:text": "Millia bows: “...Thank you, Dr. Itako.” Gratitude fills her voice."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:17",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako laughs: “No need for thanks.” She pats Millia’s shoulder. “Live free—that’s thanks.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:18",
      "@type": "gh:Block",
      "schema:text": "Kaede returns, calm: “I’ll handle the admin afterward.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:19",
      "@type": "gh:Block",
      "schema:text": "Kaede: “We’ll enroll you in the Children \u0026 Families Agency’s protection program. I’ll prepare all documents.” ER-surety."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:20",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Visits… you decide. No compulsion.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:21",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako adds:"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:22",
      "@type": "gh:Block",
      "schema:text": "“And—we’re putting your mother in the program as well.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:23",
      "@type": "gh:Block",
      "schema:text": "Millia looks up, surprised."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:24",
      "@type": "gh:Block",
      "schema:text": "“Her operation is scheduled at another facility. You wouldn’t know your mother’s father’s ghost directly, right?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:25",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako smiles a little."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:26",
      "@type": "gh:Block",
      "schema:text": "“A no-good one who won’t face karma. Our excellent hackers will release it, quick.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:27",
      "@type": "gh:Block",
      "schema:text": "Leo turns to me."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:28",
      "@type": "gh:Block",
      "schema:text": "“Tamaki, thanks to you, Millia—and we—truly became ‘not separate.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:29",
      "@type": "gh:Block",
      "schema:text": "I smile: “That was your choice. We only lit the path.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:30",
      "@type": "gh:Block",
      "schema:text": "Millia says softly: “...I want to see my mother again. But not as ‘a daughter’—as ‘a person.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:31",
      "@type": "gh:Block",
      "schema:text": "Nei-chan smiles: “That’s good. Your mother will be glad.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:32",
      "@type": "gh:Block",
      "schema:text": "Hibiki returns the bands; the room brightens to normal."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:33",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, good work. These three sessions were all one ‘LOVE’ theme. Lachlan—‘loneliness and trust.’ Leo and Millia—‘credit vs. trust vs. love.’ And Millia—‘possession vs. love.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:34",
      "@type": "gh:Block",
      "schema:text": "I gaze out the window. The canal’s lattice of light sinks into dusk."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:35",
      "@type": "gh:Block",
      "schema:text": "“...Love is hard.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:36",
      "@type": "gh:Block",
      "schema:text": "Nei-chan returns to my shoulder."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:37",
      "@type": "gh:Block",
      "schema:text": "“But you know love. You love me. I love you.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:38",
      "@type": "gh:Block",
      "schema:text": "I smile: “Yes. That is ‘not being separate.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:39",
      "@type": "gh:Block",
      "schema:text": "Family peeks in the doorway—Leo’s family and siblings, worried."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:40",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “You can come in. Spirit vital is stable.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:41",
      "@type": "gh:Block",
      "schema:text": "Leo’s family enters. Leo stands by Millia’s bed and holds her hand."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:42",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako: “Good. Leave gene and meme.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:43",
      "@type": "gh:Block",
      "schema:text": "They startle briefly, then laugh together."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:44",
      "@type": "gh:Block",
      "schema:text": "Leo and Millia leave, hand in hand. For the first time, they truly see each other."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:45",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako steps to my side and speaks small:"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:46",
      "@type": "gh:Block",
      "schema:text": "“Tamaki, you too will face your ‘chain’ one day.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:47",
      "@type": "gh:Block",
      "schema:text": "I look at her, surprised."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:48",
      "@type": "gh:Block",
      "schema:text": "“...My chain?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:49",
      "@type": "gh:Block",
      "schema:text": "She smiles: “Yes. You are young. But there is adhesion in you as well. It will surface. Come again then.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:50",
      "@type": "gh:Block",
      "schema:text": "She leaves. I think a little."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:51",
      "@type": "gh:Block",
      "schema:text": "Nei-chan, worried: “Tama, you okay?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:52",
      "@type": "gh:Block",
      "schema:text": "I smile: “I’m okay. Now, the next session.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:53",
      "@type": "gh:Block",
      "schema:text": "The canal sinks into sunset."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:54",
      "@type": "gh:Block",
      "schema:text": "The next session means another ‘pain.’"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:55",
      "@type": "gh:Block",
      "schema:text": "But I am ready."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:56",
      "@type": "gh:Block",
      "schema:text": "Nei-chan. Kaede. Hibiki. Dr. Itako."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:57",
      "@type": "gh:Block",
      "schema:text": "And I have breathing that feels good."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:58",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:59",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Operation complete—Millia’s freedom and Tamaki’s foreboding]**"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:60",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:61",
      "@type": "gh:Block",
      "schema:text": "The next day."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:62",
      "@type": "gh:Block",
      "schema:text": "Millia wakes in recovery."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:63",
      "@type": "gh:Block",
      "schema:text": "Leo is at her side; his family watches, worried."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:64",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako enters."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:65",
      "@type": "gh:Block",
      "schema:text": "“Spirit vital is stable. You’re fine.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:66",
      "@type": "gh:Block",
      "schema:text": "Millia nods quietly."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:67",
      "@type": "gh:Block",
      "schema:text": "Kaede (comms): “Your mother will also enter the protection program. Operation scheduled at another facility. The ‘chain of ancestors’ across generations—we’ll release it.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:68",
      "@type": "gh:Block",
      "schema:text": "Millia nods: “...I’ll visit. Not now—someday.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:69",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Yes. You decide that ‘someday.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:70",
      "@type": "gh:Block",
      "schema:text": "I look out the window."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Freedom doesn’t contradict non-separation. You are free—and we are ‘not separate.’”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:72",
      "@type": "gh:Block",
      "schema:text": "The canal light pulses quietly."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:73",
      "@type": "gh:Block",
      "schema:text": "Afterglow lasts long."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:74",
      "@type": "gh:Block",
      "schema:text": "Leo and Millia leave holding hands."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:75",
      "@type": "gh:Block",
      "schema:text": "They look truly free—for the first time."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:76",
      "@type": "gh:Block",
      "schema:text": "Dr. Itako stands beside me."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:77",
      "@type": "gh:Block",
      "schema:text": "“Good work, Tamaki.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:78",
      "@type": "gh:Block",
      "schema:text": "I smile: “Thank you.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:79",
      "@type": "gh:Block",
      "schema:text": "She turns serious:"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:80",
      "@type": "gh:Block",
      "schema:text": "“But don’t forget. Your ‘chain’ will show one day.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:81",
      "@type": "gh:Block",
      "schema:text": "I look, surprised."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:82",
      "@type": "gh:Block",
      "schema:text": "“...My chain?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:83",
      "@type": "gh:Block",
      "schema:text": "She smiles: “Yes. You are young. There is adhesion in you, too. It will surface. Come again then.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:84",
      "@type": "gh:Block",
      "schema:text": "She leaves. I think a little."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:85",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, you okay?”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:86",
      "@type": "gh:Block",
      "schema:text": "I smile: “I’m okay. Now, the next session.”"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:87",
      "@type": "gh:Block",
      "schema:text": "Outside, the canal sinks into sunset."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:88",
      "@type": "gh:Block",
      "schema:text": "Light’s lattice ripples on the water."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:89",
      "@type": "gh:Block",
      "schema:text": "A new morning will come."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:90",
      "@type": "gh:Block",
      "schema:text": "We will face someone’s ‘pain’ again."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:91",
      "@type": "gh:Block",
      "schema:text": "That is fine."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:92",
      "@type": "gh:Block",
      "schema:text": "That is our work."
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep05/part3.en:94",
      "@type": "gh:Block",
      "schema:text": "**[Afterglow: Quiet residue—Leo and Millia holding hands; a foreboding of Tamaki’s own ‘chain’]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:43+09:00"
}