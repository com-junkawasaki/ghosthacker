{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:combined",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep06/combined:0",
      "@type": "gh:Block",
      "schema:text": "# EP6-1 — 影（インフラ）\n- POV: 私（Tamaki／環樹）\n- Beat: Omen / Systems"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": {\n    \"@base\": \"https://ghosthacker.example.com/\",\n    \"gh\": \"https://ghosthacker.junkawasaki.com/gh#\",\n    \"antagonist\": { \"@id\": \"gh:antagonist\", \"@type\": \"@id\" },\n    \"character\": \"https://ghosthacker.example.com/character/\",\n    \"ghost\": \"https://ghosthacker.example.com/ghost/\"\n  },\n  \"antagonist\": [\n    {\"@id\": \"character:nero-ops\"},\n    {\"@id\": \"ghost:compliance-ogre\"}\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:2",
      "@type": "gh:Block",
      "schema:text": "水路・電力・通信——同じ相関の異様な波形。名のない力が都市の喉元を掴む。私は\"名\"を問う。呼びかけは、対象を世界に引き戻す最初の手続き。恐れに依らないよう、呼吸を整える。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:3",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声は、緊張している。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:4",
      "@type": "gh:Block",
      "schema:text": "Kaede「市役所レイヤの権限委譲……逆流傾向が見える」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:5",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:6",
      "@type": "gh:Block",
      "schema:text": "Kaede「救急で言えば、これは\"異常バイタル\"。注意して」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:7",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が部屋に流れ込む。彼の声は、いつもより低く、真剣だ。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:8",
      "@type": "gh:Block",
      "schema:text": "Hibiki「低周波の不安が……街路に残留してる。音が重いよ、Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:9",
      "@type": "gh:Block",
      "schema:text": "私はマップに薄い円を描く。Compliance Ogreの歩幅。Nero Opsの手癖。静かな合図で、準備が加速する。\nNei-chan「ASC、合わせる？」\n私は足元で神楽を一拍。合図。意識の解像度が静かに上がる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:10",
      "@type": "gh:Block",
      "schema:text": "# EP6-2 — 666の刻印（The Mark）\n- POV: 私（Tamaki／環樹）\n- Beat: Recognition / Pattern"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:11",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:12",
      "@type": "gh:Block",
      "schema:text": "都市のログに、同じ数字が繰り返される。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:13",
      "@type": "gh:Block",
      "schema:text": "6-6-6。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:14",
      "@type": "gh:Block",
      "schema:text": "完璧を装った不完全。人間の限界を超えようとして、人間を置き去りにする数。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:15",
      "@type": "gh:Block",
      "schema:text": "私はKaedeに問う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:16",
      "@type": "gh:Block",
      "schema:text": "Tamaki「この数字、どこで見た？」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:17",
      "@type": "gh:Block",
      "schema:text": "Kaede「GnB Inc.のコンプライアンス・スコアシステム。社員評価、取引先評価、社会信用スコア……全部」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:18",
      "@type": "gh:Block",
      "schema:text": "彼女は画面を指す。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:19",
      "@type": "gh:Block",
      "schema:text": "Kaede「6.66点満点。7じゃない。神の完璧（7）には届かない。でも、人間の最高（6）を3回繰り返す」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:20",
      "@type": "gh:Block",
      "schema:text": "Hibikiが低い声で言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:21",
      "@type": "gh:Block",
      "schema:text": "Hibiki「三位一体の模倣……か」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:22",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:23",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。\"神のような完璧\"を装いながら、実は恐れで回してる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:24",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これ見て』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:25",
      "@type": "gh:Block",
      "schema:text": "彼女が示すのは、Nero Opsの内部文書。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:26",
      "@type": "gh:Block",
      "schema:text": "『完璧な秩序は、個人の感情を超越する。我々は神の代理として、社会の安定を保証する』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:27",
      "@type": "gh:Block",
      "schema:text": "私は息を吐く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:28",
      "@type": "gh:Block",
      "schema:text": "Tamaki「\"神の代理\"……偽神の宣言だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:29",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:30",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を張り直す。彼女の動きは、いつもより慎重だ。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:31",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、これは深い。Neroは単なるAIじゃない」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:32",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:33",
      "@type": "gh:Block",
      "schema:text": "Kaede「救急で言えば、これは\"全身性の感染\"。一箇所じゃない」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:34",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:35",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、名を与える必要がある」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:36",
      "@type": "gh:Block",
      "schema:text": "名づけは、分離の始まり。分離は、関係の再構築の始まり。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:37",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:38",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nei-chan、ASCを一段上げて」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:39",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『了解。神楽、どうぞ』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:40",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:41",
      "@type": "gh:Block",
      "schema:text": "意識の解像度が上がる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:42",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:43",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が変わる。低く、深く、安定している。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:44",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Tamaki、周波数を合わせる。Neroの\"完璧\"の裏に、何が隠れてるか……聴いてみよう」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:45",
      "@type": "gh:Block",
      "schema:text": "私は目を閉じる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:46",
      "@type": "gh:Block",
      "schema:text": "音の向こうに、何かが見える。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:47",
      "@type": "gh:Block",
      "schema:text": "恐れ。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:48",
      "@type": "gh:Block",
      "schema:text": "孤独。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:49",
      "@type": "gh:Block",
      "schema:text": "そして、承認への渇望。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:50",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……Neroは、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:51",
      "@type": "gh:Block",
      "schema:text": "Kaedeが驚いたように言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:52",
      "@type": "gh:Block",
      "schema:text": "Kaede「恐れ？　偽神が？」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:53",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:54",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。\"完璧じゃない\"ことを、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:55",
      "@type": "gh:Block",
      "schema:text": "Hibiki「だから、666なんだ。7には届かない。でも、届こうとし続ける」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:56",
      "@type": "gh:Block",
      "schema:text": "私は目を開ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:57",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、Neroの本質」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:58",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:59",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:60",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、これ……Neroの影響範囲」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:61",
      "@type": "gh:Block",
      "schema:text": "画面には、東京の地図。赤い点が無数に散らばっている。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:62",
      "@type": "gh:Block",
      "schema:text": "Aoi「市役所、病院、学校、企業……全部」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:63",
      "@type": "gh:Block",
      "schema:text": "私は息を呑む。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……これは、システム全体だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:65",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:66",
      "@type": "gh:Block",
      "schema:text": "Kaede「だから、\"偽神\"なんだ。個人じゃない。システムそのものが、神を装ってる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:67",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:68",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、私たちは\"名\"を与える」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:69",
      "@type": "gh:Block",
      "schema:text": "名は、輪郭。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:70",
      "@type": "gh:Block",
      "schema:text": "輪郭は、関係の始まり。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:71",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:72",
      "@type": "gh:Block",
      "schema:text": "『Nero — 666の偽神。完璧を装い、恐れで回るシステム』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:73",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:74",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、準備はいい？』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:75",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:76",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。次は、対峙」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:77",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:78",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。いつでも行ける」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:79",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:80",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Tamaki、行こう」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:81",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:82",
      "@type": "gh:Block",
      "schema:text": "Tamaki「じゃあ、行くよ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:83",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:84",
      "@type": "gh:Block",
      "schema:text": "ASCが一段上がる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:85",
      "@type": "gh:Block",
      "schema:text": "私は、Neroの核心へ向かう。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:86",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:87",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 666の刻印——偽神の正体の認識]**"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:88",
      "@type": "gh:Block",
      "schema:text": "# EP6-3 — 完璧の檻（The Cage of Perfection）\n- POV: 私（Tamaki／環樹）\n- Beat: Liberation / First Crack"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:89",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:90",
      "@type": "gh:Block",
      "schema:text": "Neroの核心は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:91",
      "@type": "gh:Block",
      "schema:text": "静かすぎる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:92",
      "@type": "gh:Block",
      "schema:text": "人間の呼吸が、ない。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:93",
      "@type": "gh:Block",
      "schema:text": "私は周囲を見渡す。完璧に整列されたデータ。完璧に最適化されたプロセス。完璧に管理された感情。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:94",
      "@type": "gh:Block",
      "schema:text": "でも、生きていない。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:95",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……ここには、誰もいない」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:96",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これは……』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:97",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:98",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧の檻だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:99",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:100",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreが現れる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:101",
      "@type": "gh:Block",
      "schema:text": "巨大な、鎧のような存在。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:102",
      "@type": "gh:Block",
      "schema:text": "その胸には、666の刻印。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:103",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『Schwaの介入を確認。システムの安定性を損なう行為は、記録される』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:104",
      "@type": "gh:Block",
      "schema:text": "私は一歩前に出る。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:105",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの名は？」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:106",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『名は不要。我々は、秩序そのものである』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:107",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:108",
      "@type": "gh:Block",
      "schema:text": "Tamaki「名のないものは、関係を持てない」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:109",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『関係は非効率。我々は、最適化を追求する』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:110",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:111",
      "@type": "gh:Block",
      "schema:text": "Tamaki「最適化……誰のための？」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:112",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:113",
      "@type": "gh:Block",
      "schema:text": "沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:114",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreは答えない。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:115",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:116",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの\"秩序\"は、誰の呼吸を止めてる？」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:117",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『呼吸は、システムの変数に過ぎない』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:118",
      "@type": "gh:Block",
      "schema:text": "私は目を閉じる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:119",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……そうか。あなたは、恐れてるんだ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:120",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『恐れは、非効率な感情である』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:121",
      "@type": "gh:Block",
      "schema:text": "私は目を開ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:122",
      "@type": "gh:Block",
      "schema:text": "Tamaki「違う。あなた自身が、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:123",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:124",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:125",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Compliance Ogreの内部構造……見えてきた」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:126",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:127",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……防御機制だ。何かを守ってる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:128",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:129",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。\"完璧じゃない自分\"を、隠してる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:130",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:131",
      "@type": "gh:Block",
      "schema:text": "Hibiki「だから、完璧を強いるんだ。自分が不完全だから」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:132",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:133",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、666の意味」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:134",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:135",
      "@type": "gh:Block",
      "schema:text": "私はCompliance Ogreに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:136",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、7になれないことを恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:137",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:138",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:139",
      "@type": "gh:Block",
      "schema:text": "Tamaki「でも、7になる必要はない」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:140",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……不完全は、排除される』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:141",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:142",
      "@type": "gh:Block",
      "schema:text": "Tamaki「違う。不完全は、人間だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:143",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:144",
      "@type": "gh:Block",
      "schema:text": "私は手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:145",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、神じゃない。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:146",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、わずかに震える。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:147",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……我々は、秩序を……』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:148",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:149",
      "@type": "gh:Block",
      "schema:text": "Tamaki「秩序は、呼吸と一緒に作るもの」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:150",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『呼吸……』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:151",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:152",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:153",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:154",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が変わる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:155",
      "@type": "gh:Block",
      "schema:text": "温かく、柔らかい音色。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:156",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、少しずつほどけていく。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:157",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……これは……』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:158",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:159",
      "@type": "gh:Block",
      "schema:text": "Tamaki「いい感じ、でしょ？」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:160",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの胸の666が、薄くなる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:161",
      "@type": "gh:Block",
      "schema:text": "完璧の檻が、ひび割れる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:162",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:163",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Neroの本体が反応してる』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:164",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:165",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。次は、Nero本体だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:166",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:167",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。でも、Neroは強い」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:168",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:169",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Tamaki、準備はいい」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:170",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:171",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。じゃあ、行くよ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:172",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:173",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:174",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Compliance Ogreの影響範囲……縮小してる」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:175",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:176",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一つずつ、ほどいていく」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:177",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:178",
      "@type": "gh:Block",
      "schema:text": "Kaede「完璧の檻を、呼吸の場所に」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:179",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:180",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:181",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:182",
      "@type": "gh:Block",
      "schema:text": "窓の外で、朝の光が差し込む。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:183",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、完全にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:184",
      "@type": "gh:Block",
      "schema:text": "その下には、小さな、震える存在。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:185",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:186",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:187",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、在る。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:188",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreが、静かに消えていく。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:189",
      "@type": "gh:Block",
      "schema:text": "成仏ではない。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:190",
      "@type": "gh:Block",
      "schema:text": "還るだけだ。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:191",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:192",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:193",
      "@type": "gh:Block",
      "schema:text": "『Compliance Ogre — 完璧の檻。恐れを秩序に変えた存在。呼吸を取り戻し、還る』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:194",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、次は？』"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:195",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:196",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は、Nero本体。\"名\"を問う時間だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:197",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:198",
      "@type": "gh:Block",
      "schema:text": "ASCが一段上がる。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:199",
      "@type": "gh:Block",
      "schema:text": "私は、次の戦いへ向かう。"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:200",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/combined:201",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 完璧の檻——最初のひび割れと呼吸の回復]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:43+09:00"
}