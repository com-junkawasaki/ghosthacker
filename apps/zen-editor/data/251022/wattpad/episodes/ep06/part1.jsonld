  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep06/part1:0",
      "@type": "gh:Block",
      "schema:text": "# EP6-1 — 影（インフラ）\n- POV: 私（Tamaki／環樹）\n- Beat: Omen / Systems"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": {\n    \"@base\": \"https://ghosthacker.example.com/\",\n    \"gh\": \"https://ghosthacker.junkawasaki.com/gh#\",\n    \"antagonist\": { \"@id\": \"gh:antagonist\", \"@type\": \"@id\" },\n    \"character\": \"https://ghosthacker.example.com/character/\",\n    \"ghost\": \"https://ghosthacker.example.com/ghost/\"\n  },\n  \"antagonist\": [\n    {\"@id\": \"character:nero-ops\"},\n    {\"@id\": \"ghost:compliance-ogre\"}\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:2",
      "@type": "gh:Block",
      "schema:text": "水路・電力・通信——同じ相関の異様な波形。名のない力が都市の喉元を掴む。私は\"名\"を問う。呼びかけは、対象を世界に引き戻す最初の手続き。恐れに依らないよう、呼吸を整える。"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:3",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声は、緊張している。"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:4",
      "@type": "gh:Block",
      "schema:text": "Kaede「市役所レイヤの権限委譲……逆流傾向が見える」"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:5",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:6",
      "@type": "gh:Block",
      "schema:text": "Kaede「救急で言えば、これは\"異常バイタル\"。注意して」"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:7",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が部屋に流れ込む。彼の声は、いつもより低く、真剣だ。"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:8",
      "@type": "gh:Block",
      "schema:text": "Hibiki「低周波の不安が……街路に残留してる。音が重いよ、Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep06/part1:9",
      "@type": "gh:Block",
      "schema:text": "私はマップに薄い円を描く。Compliance Ogreの歩幅。Nero Opsの手癖。静かな合図で、準備が加速する。\nNei-chan「ASC、合わせる？」\n私は足元で神楽を一拍。合図。意識の解像度が静かに上がる。"
    }
  ],
  "updatedAt": "2026-01-12T19:01:43+09:00"
}