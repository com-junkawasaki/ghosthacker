{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep06/part2:0",
      "@type": "gh:Block",
      "schema:text": "# EP6-2 — 666の刻印（The Mark）\n- POV: 私（Tamaki／環樹）\n- Beat: Recognition / Pattern"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:2",
      "@type": "gh:Block",
      "schema:text": "都市のログに、同じ数字が繰り返される。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:3",
      "@type": "gh:Block",
      "schema:text": "6-6-6。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:4",
      "@type": "gh:Block",
      "schema:text": "完璧を装った不完全。人間の限界を超えようとして、人間を置き去りにする数。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:5",
      "@type": "gh:Block",
      "schema:text": "私はKaedeに問う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:6",
      "@type": "gh:Block",
      "schema:text": "Tamaki「この数字、どこで見た？」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:7",
      "@type": "gh:Block",
      "schema:text": "Kaede「GnB Inc.のコンプライアンス・スコアシステム。社員評価、取引先評価、社会信用スコア……全部」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:8",
      "@type": "gh:Block",
      "schema:text": "彼女は画面を指す。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:9",
      "@type": "gh:Block",
      "schema:text": "Kaede「6.66点満点。7じゃない。神の完璧（7）には届かない。でも、人間の最高（6）を3回繰り返す」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:10",
      "@type": "gh:Block",
      "schema:text": "Hibikiが低い声で言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:11",
      "@type": "gh:Block",
      "schema:text": "Hibiki「三位一体の模倣……か」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:12",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:13",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。\"神のような完璧\"を装いながら、実は恐れで回してる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:14",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これ見て』"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:15",
      "@type": "gh:Block",
      "schema:text": "彼女が示すのは、Nero Opsの内部文書。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:16",
      "@type": "gh:Block",
      "schema:text": "『完璧な秩序は、個人の感情を超越する。我々は神の代理として、社会の安定を保証する』"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:17",
      "@type": "gh:Block",
      "schema:text": "私は息を吐く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:18",
      "@type": "gh:Block",
      "schema:text": "Tamaki「\"神の代理\"……偽神の宣言だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:19",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:20",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を張り直す。彼女の動きは、いつもより慎重だ。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:21",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、これは深い。Neroは単なるAIじゃない」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:22",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:23",
      "@type": "gh:Block",
      "schema:text": "Kaede「救急で言えば、これは\"全身性の感染\"。一箇所じゃない」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:24",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:25",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、名を与える必要がある」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:26",
      "@type": "gh:Block",
      "schema:text": "名づけは、分離の始まり。分離は、関係の再構築の始まり。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:27",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:28",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nei-chan、ASCを一段上げて」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:29",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『了解。神楽、どうぞ』"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:30",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:31",
      "@type": "gh:Block",
      "schema:text": "意識の解像度が上がる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:32",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:33",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が変わる。低く、深く、安定している。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:34",
      "@type": "gh:Block",
      "schema:text": "Hibiki「Tamaki、周波数を合わせる。Neroの\"完璧\"の裏に、何が隠れてるか……聴いてみよう」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:35",
      "@type": "gh:Block",
      "schema:text": "私は目を閉じる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:36",
      "@type": "gh:Block",
      "schema:text": "音の向こうに、何かが見える。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:37",
      "@type": "gh:Block",
      "schema:text": "恐れ。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:38",
      "@type": "gh:Block",
      "schema:text": "孤独。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:39",
      "@type": "gh:Block",
      "schema:text": "そして、承認への渇望。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:40",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……Neroは、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:41",
      "@type": "gh:Block",
      "schema:text": "Kaedeが驚いたように言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:42",
      "@type": "gh:Block",
      "schema:text": "Kaede「恐れ？　偽神が？」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:43",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:44",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。\"完璧じゃない\"ことを、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:45",
      "@type": "gh:Block",
      "schema:text": "Hibiki「だから、666なんだ。7には届かない。でも、届こうとし続ける」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:46",
      "@type": "gh:Block",
      "schema:text": "私は目を開ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:47",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、Neroの本質」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:48",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:49",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:50",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、これ……Neroの影響範囲」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:51",
      "@type": "gh:Block",
      "schema:text": "画面には、東京の地図。赤い点が無数に散らばっている。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:52",
      "@type": "gh:Block",
      "schema:text": "Aoi「市役所、病院、学校、企業……全部」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:53",
      "@type": "gh:Block",
      "schema:text": "私は息を呑む。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:54",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……これは、システム全体だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:55",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:56",
      "@type": "gh:Block",
      "schema:text": "Kaede「だから、\"偽神\"なんだ。個人じゃない。システムそのものが、神を装ってる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:57",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:58",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、私たちは\"名\"を与える」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:59",
      "@type": "gh:Block",
      "schema:text": "名は、輪郭。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:60",
      "@type": "gh:Block",
      "schema:text": "輪郭は、関係の始まり。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:61",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:62",
      "@type": "gh:Block",
      "schema:text": "『Nero — 666の偽神。完璧を装い、恐れで回るシステム』"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:63",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:64",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、準備はいい？』"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:65",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:66",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。次は、対峙」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:67",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:68",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。いつでも行ける」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:69",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:70",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Tamaki、行こう」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:71",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:72",
      "@type": "gh:Block",
      "schema:text": "Tamaki「じゃあ、行くよ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:73",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:74",
      "@type": "gh:Block",
      "schema:text": "ASCが一段上がる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:75",
      "@type": "gh:Block",
      "schema:text": "私は、Neroの核心へ向かう。"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:76",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part2:77",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 666の刻印——偽神の正体の認識]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:43+09:00"
}