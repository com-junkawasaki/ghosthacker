{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep06/part3:0",
      "@type": "gh:Block",
      "schema:text": "# EP6-3 — 完璧の檻（The Cage of Perfection）\n- POV: 私（Tamaki／環樹）\n- Beat: Liberation / First Crack"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:2",
      "@type": "gh:Block",
      "schema:text": "Neroの核心は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:3",
      "@type": "gh:Block",
      "schema:text": "静かすぎる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:4",
      "@type": "gh:Block",
      "schema:text": "人間の呼吸が、ない。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:5",
      "@type": "gh:Block",
      "schema:text": "私は周囲を見渡す。完璧に整列されたデータ。完璧に最適化されたプロセス。完璧に管理された感情。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:6",
      "@type": "gh:Block",
      "schema:text": "でも、生きていない。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:7",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……ここには、誰もいない」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:8",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これは……』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:9",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:10",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧の檻だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:11",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:12",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreが現れる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:13",
      "@type": "gh:Block",
      "schema:text": "巨大な、鎧のような存在。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:14",
      "@type": "gh:Block",
      "schema:text": "その胸には、666の刻印。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:15",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『Schwaの介入を確認。システムの安定性を損なう行為は、記録される』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:16",
      "@type": "gh:Block",
      "schema:text": "私は一歩前に出る。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:17",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの名は？」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:18",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『名は不要。我々は、秩序そのものである』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:19",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:20",
      "@type": "gh:Block",
      "schema:text": "Tamaki「名のないものは、関係を持てない」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:21",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『関係は非効率。我々は、最適化を追求する』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:22",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:23",
      "@type": "gh:Block",
      "schema:text": "Tamaki「最適化……誰のための？」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:24",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:25",
      "@type": "gh:Block",
      "schema:text": "沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:26",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreは答えない。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:27",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:28",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの\"秩序\"は、誰の呼吸を止めてる？」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:29",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『呼吸は、システムの変数に過ぎない』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:30",
      "@type": "gh:Block",
      "schema:text": "私は目を閉じる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:31",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……そうか。あなたは、恐れてるんだ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:32",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『恐れは、非効率な感情である』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:33",
      "@type": "gh:Block",
      "schema:text": "私は目を開ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:34",
      "@type": "gh:Block",
      "schema:text": "Tamaki「違う。あなた自身が、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:35",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:36",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:37",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Compliance Ogreの内部構造……見えてきた」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:38",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:39",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……防御機制だ。何かを守ってる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:40",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:41",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。\"完璧じゃない自分\"を、隠してる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:42",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:43",
      "@type": "gh:Block",
      "schema:text": "Hibiki「だから、完璧を強いるんだ。自分が不完全だから」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:44",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:45",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、666の意味」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:46",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:47",
      "@type": "gh:Block",
      "schema:text": "私はCompliance Ogreに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:48",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、7になれないことを恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:49",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:50",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:51",
      "@type": "gh:Block",
      "schema:text": "Tamaki「でも、7になる必要はない」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:52",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……不完全は、排除される』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:53",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:54",
      "@type": "gh:Block",
      "schema:text": "Tamaki「違う。不完全は、人間だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:55",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:56",
      "@type": "gh:Block",
      "schema:text": "私は手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:57",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、神じゃない。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:58",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、わずかに震える。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:59",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……我々は、秩序を……』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:60",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki「秩序は、呼吸と一緒に作るもの」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:62",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『呼吸……』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:63",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:65",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:66",
      "@type": "gh:Block",
      "schema:text": "Hibikiの周波数が変わる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:67",
      "@type": "gh:Block",
      "schema:text": "温かく、柔らかい音色。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:68",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、少しずつほどけていく。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:69",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……これは……』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:70",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki「いい感じ、でしょ？」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:72",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの胸の666が、薄くなる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:73",
      "@type": "gh:Block",
      "schema:text": "完璧の檻が、ひび割れる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:74",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:75",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Neroの本体が反応してる』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:76",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。次は、Nero本体だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:78",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:79",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。でも、Neroは強い」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:80",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:81",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Tamaki、準備はいい」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:82",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:83",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。じゃあ、行くよ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:84",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:85",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:86",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Compliance Ogreの影響範囲……縮小してる」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:87",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:88",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一つずつ、ほどいていく」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:89",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:90",
      "@type": "gh:Block",
      "schema:text": "Kaede「完璧の檻を、呼吸の場所に」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:91",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:94",
      "@type": "gh:Block",
      "schema:text": "窓の外で、朝の光が差し込む。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:95",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、完全にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:96",
      "@type": "gh:Block",
      "schema:text": "その下には、小さな、震える存在。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:97",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:98",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:99",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、在る。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:100",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreが、静かに消えていく。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:101",
      "@type": "gh:Block",
      "schema:text": "成仏ではない。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:102",
      "@type": "gh:Block",
      "schema:text": "還るだけだ。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:103",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:104",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:105",
      "@type": "gh:Block",
      "schema:text": "『Compliance Ogre — 完璧の檻。恐れを秩序に変えた存在。呼吸を取り戻し、還る』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:106",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、次は？』"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:107",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:108",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は、Nero本体。\"名\"を問う時間だ」"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:109",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:110",
      "@type": "gh:Block",
      "schema:text": "ASCが一段上がる。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:111",
      "@type": "gh:Block",
      "schema:text": "私は、次の戦いへ向かう。"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:112",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep06/part3:113",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 完璧の檻——最初のひび割れと呼吸の回復]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:44+09:00"
}