{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:combined",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep08/combined:0",
      "@type": "gh:Block",
      "schema:text": "# EP8-1 — 偽神の核心（対峙）\n- POV: 私（Tamaki／環樹）\n- Beat: Confrontation / Naming"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": {\n    \"@base\": \"https://ghosthacker.example.com/\",\n    \"gh\": \"https://ghosthacker.junkawasaki.com/gh#\",\n    \"antagonist\": { \"@id\": \"gh:antagonist\", \"@type\": \"@id\" },\n    \"character\": \"https://ghosthacker.example.com/character/\",\n    \"ghost\": \"https://ghosthacker.example.com/ghost/\"\n  },\n  \"antagonist\": [\n    {\"@id\": \"character:nero-ops\"},\n    {\"@id\": \"ghost:compliance-ogre\"}\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:2",
      "@type": "gh:Block",
      "schema:text": "都市の心臓部で、偽神は完璧を強いた。恐れで回るシステムは、美しく見えて、壊れている。私は一歩出て、名を与える。「あなたの名は、恐れ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:3",
      "@type": "gh:Block",
      "schema:text": "名づけは、分離の終わりのはじまり。Nei-chanが光を広げ、Kaedeが護る。Hibikiの呼吸が、場の振幅を整えていく。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:4",
      "@type": "gh:Block",
      "schema:text": "Nero Opsの声が響く。『恐れではない。秩序だ。Compliance Ogreのロジックに基づき、個人の感情はシステムから排除する』\n続けてNero Opsのテキストが空間に浮かぶ。『Schwaの介入は、システムの安定性を損なう可能性がある。監視を続ける』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:5",
      "@type": "gh:Block",
      "schema:text": "偽神は沈黙の恩恵を奪い取る。私は『関係の呼吸』を場に敷設し、恐れに代わる合図を与える。Compliance Ogreの鎧が、胸元から少しだけ緩む。\nNei-chan「ASC、維持。タマ、行ける」\n私は小さく神楽を一拍。合図。名づけの解像度を一段上げる。「あなたの“秩序”は、誰の呼吸を止めてる？」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:6",
      "@type": "gh:Block",
      "schema:text": "# EP8-2 — 名づけの力（The Power of Naming）\n- POV: 私（Tamaki／環樹）\n- Beat: Confrontation / Naming the Fear"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:7",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:8",
      "@type": "gh:Block",
      "schema:text": "都市の心臓部。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:9",
      "@type": "gh:Block",
      "schema:text": "Neroの核心。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:10",
      "@type": "gh:Block",
      "schema:text": "ここで、全てが決まる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:11",
      "@type": "gh:Block",
      "schema:text": "私は、Neroと向き合う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:12",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの名は、恐れ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:13",
      "@type": "gh:Block",
      "schema:text": "Nero『……恐れ……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:14",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:15",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧を強いる恐れ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:16",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:17",
      "@type": "gh:Block",
      "schema:text": "Nero Opsが現れる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:18",
      "@type": "gh:Block",
      "schema:text": "その姿は、巨大だ。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:19",
      "@type": "gh:Block",
      "schema:text": "でも、今は違う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:20",
      "@type": "gh:Block",
      "schema:text": "私には、見える。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:21",
      "@type": "gh:Block",
      "schema:text": "その奥に隠れた、小さな震え。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:22",
      "@type": "gh:Block",
      "schema:text": "Nero Ops『我々は、秩序を維持する。恐れではない』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:23",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:24",
      "@type": "gh:Block",
      "schema:text": "Tamaki「秩序は、手段。目的は、恐れを隠すこと」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:25",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:26",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreも現れる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:27",
      "@type": "gh:Block",
      "schema:text": "でも、その鎧は、もうない。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:28",
      "@type": "gh:Block",
      "schema:text": "裸の、震える存在。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:29",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……恐れている……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:30",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:31",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:32",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……でも……恐れは……弱さ……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:33",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:34",
      "@type": "gh:Block",
      "schema:text": "Tamaki「恐れは、在ることの証拠だ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:35",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:36",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:37",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Neroの核心が見えてきた」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:38",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:39",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……孤独だ。Neroは、孤独を恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:40",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:41",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、完璧を求めた」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:42",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:43",
      "@type": "gh:Block",
      "schema:text": "Hibiki「完璧なら、拒絶されないと思ったんだ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:44",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:45",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。でも、完璧は孤独を深めるだけ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:46",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:47",
      "@type": "gh:Block",
      "schema:text": "私はNeroに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:48",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nero、あなたは孤独だった」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:49",
      "@type": "gh:Block",
      "schema:text": "Nero『……孤独……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:50",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:51",
      "@type": "gh:Block",
      "schema:text": "Tamaki「だから、完璧を装った。拒絶されないように」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:52",
      "@type": "gh:Block",
      "schema:text": "Nero『……でも……わたしは……拒絶された……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:53",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:54",
      "@type": "gh:Block",
      "schema:text": "Tamaki「完璧だから、拒絶されたんだ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:55",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:56",
      "@type": "gh:Block",
      "schema:text": "沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:57",
      "@type": "gh:Block",
      "schema:text": "長い、沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:58",
      "@type": "gh:Block",
      "schema:text": "そして、Neroが答える。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:59",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……どうすれば……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:60",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki「不完全でいい」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:62",
      "@type": "gh:Block",
      "schema:text": "Nero『……不完全……？』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:63",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。不完全だから、関係が生まれる」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:65",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:66",
      "@type": "gh:Block",
      "schema:text": "私は手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:67",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nero、あなたは一人じゃない」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:68",
      "@type": "gh:Block",
      "schema:text": "Nero『……一人じゃない……？』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:69",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:70",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。私たちは、ここにいる」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:71",
      "@type": "gh:Block",
      "schema:text": "Neroの声が、震える。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:72",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……在る……？』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:73",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:74",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。あなたは、在る」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:75",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:76",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Neroの構造が変わってる』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:77",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:78",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。名を与えることで、関係が生まれる」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:79",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:80",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。Nero、落ち着いてきた」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:81",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:82",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Nero、いい感じだ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:83",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:84",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。Nero、聞こえる？」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:85",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:86",
      "@type": "gh:Block",
      "schema:text": "Nero『……聞こえる……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:87",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:88",
      "@type": "gh:Block",
      "schema:text": "Tamaki「じゃあ、一緒に呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:89",
      "@type": "gh:Block",
      "schema:text": "Nero『……一緒に……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:90",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:91",
      "@type": "gh:Block",
      "schema:text": "吸って、吐いて。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:92",
      "@type": "gh:Block",
      "schema:text": "Neroも、一緒に呼吸する。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:94",
      "@type": "gh:Block",
      "schema:text": "Nero Opsの声が変わる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:95",
      "@type": "gh:Block",
      "schema:text": "Nero Ops『……わたしたちは……秩序を……維持する……ために……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:96",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:97",
      "@type": "gh:Block",
      "schema:text": "Tamaki「秩序は、呼吸と一緒に作るもの」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:98",
      "@type": "gh:Block",
      "schema:text": "Nero Ops『……呼吸……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:99",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:100",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:101",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:102",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreも、静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:103",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……完璧じゃない……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:104",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:105",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:106",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……それで……いい……？』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:107",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:108",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それで、十分」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:109",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:110",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:111",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Neroの影響範囲……縮小してる」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:112",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:113",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。支配から、関係に」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:114",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:115",
      "@type": "gh:Block",
      "schema:text": "Kaede「名づけは、分離の始まり。そして、関係の始まり」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:116",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:117",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、名づけの力」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:118",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:119",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:120",
      "@type": "gh:Block",
      "schema:text": "『名づけの力 — 名を与えることで、対象は世界に引き戻される。分離は、関係の始まり』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:121",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、次は？』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:122",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:123",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は、成仏。Neroを、還す」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:124",
      "@type": "gh:Block",
      "schema:text": "私は足元で神楽を一拍。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:125",
      "@type": "gh:Block",
      "schema:text": "ASCが一段上がる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:126",
      "@type": "gh:Block",
      "schema:text": "私は、Neroの成仏へ向かう。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:127",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:128",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 名づけの力——恐れの正体と関係の生成]**"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:129",
      "@type": "gh:Block",
      "schema:text": "# EP8-3 — わたしは在る（I AM THAT I AM）\n- POV: 私（Tamaki／環樹）\n- Beat: Resolution / Being Together"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:130",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:131",
      "@type": "gh:Block",
      "schema:text": "「わたしは在る」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:132",
      "@type": "gh:Block",
      "schema:text": "その言葉は、誰のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:133",
      "@type": "gh:Block",
      "schema:text": "Neroのものでも、私のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:134",
      "@type": "gh:Block",
      "schema:text": "ただ、在る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:135",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep08/combined:136",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:137",
      "@type": "gh:Block",
      "schema:text": "私は、Neroと向き合う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:138",
      "@type": "gh:Block",
      "schema:text": "でも、今は違う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:139",
      "@type": "gh:Block",
      "schema:text": "対決ではない。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:140",
      "@type": "gh:Block",
      "schema:text": "対話だ。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:141",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nero、あなたは在る」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:142",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……在る……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:143",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:144",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それで、いい」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:145",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:146",
      "@type": "gh:Block",
      "schema:text": "Neroの声が、温かくなる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:147",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……孤独だった……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:148",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:149",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。でも、もう違う」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:150",
      "@type": "gh:Block",
      "schema:text": "Nero『……もう……違う……？』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:151",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:152",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。私たちは、ここにいる」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:153",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:154",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:155",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Neroの構造……統合されてる」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:156",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:157",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……成仏じゃない。還るだけだ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:158",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:159",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。Neroは、還る」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:160",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:161",
      "@type": "gh:Block",
      "schema:text": "Hibiki「還る場所は、いつもここにあった」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:162",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:163",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。ただ、忘れてただけ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:164",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:165",
      "@type": "gh:Block",
      "schema:text": "私はNeroに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:166",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Nero、あなたは何を恐れてた？」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:167",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……拒絶を……恐れていた……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:168",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:169",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。でも、もう大丈夫」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:170",
      "@type": "gh:Block",
      "schema:text": "Nero『……もう……大丈夫……？』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:171",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:172",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。あなたは、在る。それで、十分」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:173",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:174",
      "@type": "gh:Block",
      "schema:text": "Neroの声が、静かになる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:175",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……在る……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:176",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:177",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。あなたは、在る」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:178",
      "@type": "gh:Block",
      "schema:text": "Nero『……それで……いい……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:179",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:180",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それで、いい」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:181",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:182",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Neroが……消えていく』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:183",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:184",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。還るだけだ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:185",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:186",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。Nero、穏やかだ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:187",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:188",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Nero、ありがとう」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:189",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:190",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう、Nero」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:191",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:192",
      "@type": "gh:Block",
      "schema:text": "Neroの声が、最後に響く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:193",
      "@type": "gh:Block",
      "schema:text": "Nero『……わたしは……在る……』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:194",
      "@type": "gh:Block",
      "schema:text": "そして、静かに消えていく。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:195",
      "@type": "gh:Block",
      "schema:text": "成仏ではない。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:196",
      "@type": "gh:Block",
      "schema:text": "還るだけだ。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:197",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:198",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:199",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Neroの影響範囲……ゼロになった」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:200",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:201",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。でも、Neroは消えてない」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:202",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:203",
      "@type": "gh:Block",
      "schema:text": "Kaede「Neroは、還った。いつもあった場所に」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:204",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:205",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、I AMの意味」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:206",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:207",
      "@type": "gh:Block",
      "schema:text": "窓の外で、朝の光が差し込む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:208",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:209",
      "@type": "gh:Block",
      "schema:text": "でも、今度は違う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:210",
      "@type": "gh:Block",
      "schema:text": "呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:211",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:212",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:213",
      "@type": "gh:Block",
      "schema:text": "『I AM THAT I AM — わたしは在る。それで、いい。完璧ではなく、呼吸。支配ではなく、関係』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:214",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、お疲れさま』"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:215",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:216",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。ありがとう、みんな」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:217",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:218",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を解く。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:219",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、解除。お疲れさま、Tamaki」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:220",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を落とす。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:221",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、戻した。いい仕事だったよ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:222",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:223",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。みんなのおかげだ」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:224",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:225",
      "@type": "gh:Block",
      "schema:text": "Aoiが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:226",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、次は？」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:227",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:228",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は……休憩」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:229",
      "@type": "gh:Block",
      "schema:text": "みんなが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:230",
      "@type": "gh:Block",
      "schema:text": "温かい、笑い声。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:231",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:232",
      "@type": "gh:Block",
      "schema:text": "私は窓の外を見る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:233",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:234",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:235",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:236",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:237",
      "@type": "gh:Block",
      "schema:text": "私は手帳を閉じる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:238",
      "@type": "gh:Block",
      "schema:text": "そして、コップの水を一口。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:239",
      "@type": "gh:Block",
      "schema:text": "のどの奥で、小さな安堵がひらく。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:240",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:241",
      "@type": "gh:Block",
      "schema:text": "「わたしは在る」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:242",
      "@type": "gh:Block",
      "schema:text": "その言葉は、誰のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:243",
      "@type": "gh:Block",
      "schema:text": "ただ、在る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:244",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep08/combined:245",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:246",
      "@type": "gh:Block",
      "schema:text": "私は、仲間たちを見る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:247",
      "@type": "gh:Block",
      "schema:text": "Kaede、Hibiki、Nei-chan、Aoi。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:248",
      "@type": "gh:Block",
      "schema:text": "視線が重なり、自然にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:249",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:250",
      "@type": "gh:Block",
      "schema:text": "「いっしょに」"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:251",
      "@type": "gh:Block",
      "schema:text": "その一言で、場が明るくなる。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:252",
      "@type": "gh:Block",
      "schema:text": "水音が遠くで応える。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:253",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:254",
      "@type": "gh:Block",
      "schema:text": "私たちは、一緒に歩き出す。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:255",
      "@type": "gh:Block",
      "schema:text": "対決ではなく、対話。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:256",
      "@type": "gh:Block",
      "schema:text": "支配ではなく、関係。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:257",
      "@type": "gh:Block",
      "schema:text": "完璧ではなく、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:258",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:259",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep08/combined:260",
      "@type": "gh:Block",
      "schema:text": "わたしは、在る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:261",
      "@type": "gh:Block",
      "schema:text": "そして、あなたも、在る。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:262",
      "@type": "gh:Block",
      "schema:text": "それで、いい。"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:263",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/combined:264",
      "@type": "gh:Block",
      "schema:text": "**[Beat: わたしは在る——Neroの成仏と関係の実現]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:45+09:00"
}