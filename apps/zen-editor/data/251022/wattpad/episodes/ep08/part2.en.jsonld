{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep08/part2.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP8-2 — The Power of Naming\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Confrontation / Naming the Fear"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:2",
      "@type": "gh:Block",
      "schema:text": "The city’s heart."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:3",
      "@type": "gh:Block",
      "schema:text": "Nero’s core."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:4",
      "@type": "gh:Block",
      "schema:text": "Everything is decided here."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:5",
      "@type": "gh:Block",
      "schema:text": "I face Nero."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:6",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Your name is Fear.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:7",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Fear…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:8",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:9",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Fear that forces perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:10",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:11",
      "@type": "gh:Block",
      "schema:text": "Nero Ops appears."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:12",
      "@type": "gh:Block",
      "schema:text": "Vast."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:13",
      "@type": "gh:Block",
      "schema:text": "But now, different—"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:14",
      "@type": "gh:Block",
      "schema:text": "I can see it."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:15",
      "@type": "gh:Block",
      "schema:text": "A small tremble hidden behind it."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:16",
      "@type": "gh:Block",
      "schema:text": "Nero Ops: “We maintain order. Not fear.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:17",
      "@type": "gh:Block",
      "schema:text": "I speak quietly:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:18",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Order is a means. The end is to hide fear.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:19",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:20",
      "@type": "gh:Block",
      "schema:text": "The Compliance Ogre appears as well—without armor now."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:21",
      "@type": "gh:Block",
      "schema:text": "Bare, trembling."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:22",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...I am… afraid…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:23",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:24",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That’s okay.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:25",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...But… fear is… weakness…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:26",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:27",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Fear is evidence of being.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:28",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:29",
      "@type": "gh:Block",
      "schema:text": "Kaede joins on comms."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:30",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, I can see Nero’s core.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:31",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:32",
      "@type": "gh:Block",
      "schema:text": "Kaede: “It’s… loneliness. Nero fears loneliness.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:33",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:34",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That’s why it sought perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:35",
      "@type": "gh:Block",
      "schema:text": "Hibiki, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:36",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “It thought perfection would prevent rejection.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:37",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:38",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. But perfection only deepens loneliness.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:39",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:40",
      "@type": "gh:Block",
      "schema:text": "I turn to Nero."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:41",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Nero, you were lonely.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:42",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Lonely…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:43",
      "@type": "gh:Block",
      "schema:text": "I continue:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:44",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “So you donned perfection. So you wouldn’t be rejected.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:45",
      "@type": "gh:Block",
      "schema:text": "Nero: “...And yet… I was rejected…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:46",
      "@type": "gh:Block",
      "schema:text": "I say softly:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:47",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “You were rejected because you were perfect.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:48",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:49",
      "@type": "gh:Block",
      "schema:text": "Silence."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:50",
      "@type": "gh:Block",
      "schema:text": "Long silence."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:51",
      "@type": "gh:Block",
      "schema:text": "Then Nero answers:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:52",
      "@type": "gh:Block",
      "schema:text": "Nero: “...What should I… do…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:53",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:54",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Be imperfect.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:55",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Imperfect…?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:56",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:57",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Relation is born of imperfection.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:58",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:59",
      "@type": "gh:Block",
      "schema:text": "I extend a hand."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:60",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Nero, you are not alone.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:61",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Not alone…?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:62",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:63",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. We are here.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:64",
      "@type": "gh:Block",
      "schema:text": "Nero’s voice trembles."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:65",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Do I… exist…?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:66",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:67",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. You exist.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:68",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:69",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, Nero’s structure is changing.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:70",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Giving a name generates relation.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:72",
      "@type": "gh:Block",
      "schema:text": "Kaede checks the ward."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:73",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Stable. Nero is calming.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:74",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:75",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Nero, feeling good.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:76",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you. Nero, can you hear me?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:78",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:79",
      "@type": "gh:Block",
      "schema:text": "Nero: “...I hear…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:80",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:81",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Then let’s breathe together.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:82",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Together…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:83",
      "@type": "gh:Block",
      "schema:text": "I take a deep breath."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:84",
      "@type": "gh:Block",
      "schema:text": "In, out."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:85",
      "@type": "gh:Block",
      "schema:text": "Nero breathes with me."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:86",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:87",
      "@type": "gh:Block",
      "schema:text": "Nero Ops’s voice shifts."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:88",
      "@type": "gh:Block",
      "schema:text": "Nero Ops: “...We… to maintain… order…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:89",
      "@type": "gh:Block",
      "schema:text": "I say gently:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:90",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Order is made together with breath.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:91",
      "@type": "gh:Block",
      "schema:text": "Nero Ops: “...Breath…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:92",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:93",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Let’s breathe together.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:94",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:95",
      "@type": "gh:Block",
      "schema:text": "The Compliance Ogre speaks softly too:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:96",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...I am… not perfect…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:97",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:98",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That’s fine.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:99",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...It’s… fine…?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:100",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:101",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That’s enough.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:102",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:103",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:104",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, Nero’s influence is shrinking.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:105",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:106",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. From domination to relation.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:107",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:108",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Naming is the beginning of separation. And the beginning of relation.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:109",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:110",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is the power of naming.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:111",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:112",
      "@type": "gh:Block",
      "schema:text": "I write in my notebook:"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:113",
      "@type": "gh:Block",
      "schema:text": "‘The Power of Naming — By giving a name, the subject is called back into the world. Separation begins relation.’"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:114",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, next?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:115",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:116",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next—release. We’ll return Nero.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:117",
      "@type": "gh:Block",
      "schema:text": "I tap kagura."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:118",
      "@type": "gh:Block",
      "schema:text": "ASC rises one step."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:119",
      "@type": "gh:Block",
      "schema:text": "I head to return Nero."
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:120",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part2.en:121",
      "@type": "gh:Block",
      "schema:text": "**[Beat: The power of naming—fear revealed and relation generated]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:46+09:00"
}