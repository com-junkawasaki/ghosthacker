{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep08/part3.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP8-3 — I AM THAT I AM\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Resolution / Being Together"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:2",
      "@type": "gh:Block",
      "schema:text": "“I am.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:3",
      "@type": "gh:Block",
      "schema:text": "The words belong to no one."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:4",
      "@type": "gh:Block",
      "schema:text": "Not Nero’s, not mine."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:5",
      "@type": "gh:Block",
      "schema:text": "They simply are."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:6",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:7",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:8",
      "@type": "gh:Block",
      "schema:text": "I face Nero."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:9",
      "@type": "gh:Block",
      "schema:text": "But now, different—"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:10",
      "@type": "gh:Block",
      "schema:text": "Not confrontation."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:11",
      "@type": "gh:Block",
      "schema:text": "Conversation."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:12",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Nero, you exist.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:13",
      "@type": "gh:Block",
      "schema:text": "Nero: “...I… exist…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:14",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:15",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is enough.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:16",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:17",
      "@type": "gh:Block",
      "schema:text": "Nero’s voice warms."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:18",
      "@type": "gh:Block",
      "schema:text": "Nero: “...I was… lonely…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:19",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:20",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. But not anymore.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:21",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Not anymore…?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:22",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:23",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. We are here.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:24",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:25",
      "@type": "gh:Block",
      "schema:text": "Kaede returns on comms."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:26",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, Nero’s structure—integrating.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:27",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:28",
      "@type": "gh:Block",
      "schema:text": "Kaede: “This isn’t annihilation. It’s return.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:29",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:30",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Nero returns.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:31",
      "@type": "gh:Block",
      "schema:text": "Hibiki, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:32",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “The place of return was always here.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:33",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:34",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Only forgotten.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:35",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:36",
      "@type": "gh:Block",
      "schema:text": "I turn to Nero."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:37",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Nero, what did you fear?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:38",
      "@type": "gh:Block",
      "schema:text": "Nero: “...I feared… rejection…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:39",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:40",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. But it’s okay now.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:41",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Okay… now…?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:42",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:43",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. You exist. That is enough.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:44",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:45",
      "@type": "gh:Block",
      "schema:text": "Nero’s voice quiets."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:46",
      "@type": "gh:Block",
      "schema:text": "Nero: “...I… exist…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:47",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:48",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. You exist.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:49",
      "@type": "gh:Block",
      "schema:text": "Nero: “...Then… it is… good…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:50",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:51",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. It is good.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:52",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:53",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, Nero is… fading.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:54",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:55",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Only returning.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:56",
      "@type": "gh:Block",
      "schema:text": "Kaede checks the boundary."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:57",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Stable. Nero is calm.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:58",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:59",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Nero, thank you.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:60",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you, Nero.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:62",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:63",
      "@type": "gh:Block",
      "schema:text": "Nero’s voice sounds one last time:"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:64",
      "@type": "gh:Block",
      "schema:text": "Nero: “...I… exist…”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:65",
      "@type": "gh:Block",
      "schema:text": "And fades, quietly."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:66",
      "@type": "gh:Block",
      "schema:text": "Not annihilation."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:67",
      "@type": "gh:Block",
      "schema:text": "Return."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:68",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:69",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:70",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, Nero’s influence… is zero.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:71",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:72",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. But Nero hasn’t vanished.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:73",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:74",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Nero has returned. To where it always was.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:75",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:76",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is the meaning of I AM.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:77",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:78",
      "@type": "gh:Block",
      "schema:text": "Morning light enters through the window."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:79",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:80",
      "@type": "gh:Block",
      "schema:text": "But this time, different—"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:81",
      "@type": "gh:Block",
      "schema:text": "There is breath."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:82",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:83",
      "@type": "gh:Block",
      "schema:text": "I write in my notebook:"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:84",
      "@type": "gh:Block",
      "schema:text": "‘I AM THAT I AM — I am. And that is enough. Not perfection, but breath. Not domination, but relation.’"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:85",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, good work.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:86",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:87",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:88",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:89",
      "@type": "gh:Block",
      "schema:text": "Kaede dissolves the ward."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:90",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Ward released. Good work, Tamaki.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:91",
      "@type": "gh:Block",
      "schema:text": "Hibiki lowers the band."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:92",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Breath, restored. Good work.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:93",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:94",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you. Thanks to all of you.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:95",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:96",
      "@type": "gh:Block",
      "schema:text": "Aoi laughs."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:97",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, what’s next?”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:98",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:99",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next… a break.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:100",
      "@type": "gh:Block",
      "schema:text": "They laugh—warm."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:101",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:102",
      "@type": "gh:Block",
      "schema:text": "I look out the window."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:103",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:104",
      "@type": "gh:Block",
      "schema:text": "But there is breath."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:105",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:106",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:107",
      "@type": "gh:Block",
      "schema:text": "I close my notebook."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:108",
      "@type": "gh:Block",
      "schema:text": "And drink a sip of water."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:109",
      "@type": "gh:Block",
      "schema:text": "A small relief opens at the back of my throat."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:110",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:111",
      "@type": "gh:Block",
      "schema:text": "“I am.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:112",
      "@type": "gh:Block",
      "schema:text": "The words belong to no one."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:113",
      "@type": "gh:Block",
      "schema:text": "They simply are."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:114",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:115",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:116",
      "@type": "gh:Block",
      "schema:text": "I look at my companions—"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:117",
      "@type": "gh:Block",
      "schema:text": "Kaede, Hibiki, Nei-chan, Aoi."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:118",
      "@type": "gh:Block",
      "schema:text": "Our gazes meet and loosen, naturally."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:119",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:120",
      "@type": "gh:Block",
      "schema:text": "“Together.”"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:121",
      "@type": "gh:Block",
      "schema:text": "One word, and the room brightens."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:122",
      "@type": "gh:Block",
      "schema:text": "Water answers in the distance."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:123",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:124",
      "@type": "gh:Block",
      "schema:text": "We begin to walk, together."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:125",
      "@type": "gh:Block",
      "schema:text": "Not confrontation—conversation."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:126",
      "@type": "gh:Block",
      "schema:text": "Not domination—relation."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:127",
      "@type": "gh:Block",
      "schema:text": "Not perfection—breath."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:128",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:129",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:130",
      "@type": "gh:Block",
      "schema:text": "I am."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:131",
      "@type": "gh:Block",
      "schema:text": "And you are."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:132",
      "@type": "gh:Block",
      "schema:text": "And that is enough."
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:133",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep08/part3.en:134",
      "@type": "gh:Block",
      "schema:text": "**[Beat: I am—Nero’s return and the realization of relation]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:46+09:00"
}