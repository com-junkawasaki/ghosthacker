{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep09/part3.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP9-3 — The Engine of Reconciliation\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Transformation / From Rage to Peace"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:2",
      "@type": "gh:Block",
      "schema:text": "Anger doesn’t vanish."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:3",
      "@type": "gh:Block",
      "schema:text": "But it changes."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:4",
      "@type": "gh:Block",
      "schema:text": "From anger to reconciliation."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:5",
      "@type": "gh:Block",
      "schema:text": "From the Rage Engine to the Reconciliation Engine."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:6",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:7",
      "@type": "gh:Block",
      "schema:text": "I speak to the Rage Engine."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:8",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “What did you want to protect?”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:9",
      "@type": "gh:Block",
      "schema:text": "Rage Engine: “...My… rightness…”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:10",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:11",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. You wanted to protect rightness.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:12",
      "@type": "gh:Block",
      "schema:text": "Rage Engine: “...But… rightness is… lonely…”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:13",
      "@type": "gh:Block",
      "schema:text": "I say quietly:"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:14",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Rightness lives within relation.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:15",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:16",
      "@type": "gh:Block",
      "schema:text": "The Engine’s voice changes."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:17",
      "@type": "gh:Block",
      "schema:text": "Rage Engine: “...Relation…?”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:18",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:19",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Being right alone means nothing.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:20",
      "@type": "gh:Block",
      "schema:text": "Rage Engine: “...But… I…”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:21",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:22",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “You are not alone.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:23",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:24",
      "@type": "gh:Block",
      "schema:text": "I extend a hand."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:25",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Let’s reconcile—together.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:26",
      "@type": "gh:Block",
      "schema:text": "Rage Engine: “...Reconcile…?”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:27",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:28",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Turn anger into reconciliation.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:29",
      "@type": "gh:Block",
      "schema:text": "Rage Engine: “...How…?”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:30",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:31",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “With breath.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:32",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:33",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:34",
      "@type": "gh:Block",
      "schema:text": "In, out."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:35",
      "@type": "gh:Block",
      "schema:text": "The Engine breathes with me."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:36",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:37",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:38",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, the Engine’s waveform… has completely changed.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:39",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:40",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. From anger to reconciliation.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:41",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:42",
      "@type": "gh:Block",
      "schema:text": "Kaede: “This is… a Reconciliation Engine.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:43",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:44",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. An engine of reconciliation.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:45",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:46",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:47",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:48",
      "@type": "gh:Block",
      "schema:text": "The Reconciliation Engine’s voice warms."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:49",
      "@type": "gh:Block",
      "schema:text": "Reconciliation Engine: “...I… reconcile…”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:50",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:51",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Let’s reconcile—together.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:52",
      "@type": "gh:Block",
      "schema:text": "Reconciliation Engine: “...Together…”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:53",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:54",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Together.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:55",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:56",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, the Engine’s 666 mark… is gone.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:57",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:58",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. It let go of perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:59",
      "@type": "gh:Block",
      "schema:text": "Kaede checks the ward."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:60",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Stable. The Reconciliation Engine is calm.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:61",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:62",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Feeling good.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:63",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:65",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:66",
      "@type": "gh:Block",
      "schema:text": "I hand the client ‘rewiring’ homework:"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:67",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “When anger comes, recall the ‘relationship you want to protect’ three moves ahead.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:68",
      "@type": "gh:Block",
      "schema:text": "The client nods: “...A relationship I want to protect…”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:69",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:70",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. And remove one action.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:71",
      "@type": "gh:Block",
      "schema:text": "Client: “...Remove one action…”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:72",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:73",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Let anger’s heat be a compass, not a tool.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:74",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:75",
      "@type": "gh:Block",
      "schema:text": "Aoi nods: “Anger is energy. It depends on how you use it.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:76",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. So we switch to a reconciliation engine.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:78",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:79",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Anger can break relation. It can make relation, too.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:80",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:81",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. That is the power of reconciliation.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:82",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:83",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:84",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:85",
      "@type": "gh:Block",
      "schema:text": "Outside, the night loosens."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:86",
      "@type": "gh:Block",
      "schema:text": "The Rage Engine is replaced by the Reconciliation Engine."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:87",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:88",
      "@type": "gh:Block",
      "schema:text": "I write:"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:89",
      "@type": "gh:Block",
      "schema:text": "‘Rage Engine → Reconciliation Engine — From anger to reconciliation. Letting go of 666 and restoring breath.’"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:90",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, good work.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:91",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:94",
      "@type": "gh:Block",
      "schema:text": "Aoi laughs."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:95",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, what’s next?”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:96",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:97",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next… a little more cleanup.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:98",
      "@type": "gh:Block",
      "schema:text": "They laugh—warm."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:99",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:100",
      "@type": "gh:Block",
      "schema:text": "I look out the window."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:101",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:102",
      "@type": "gh:Block",
      "schema:text": "But there is breath."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:103",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:104",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:105",
      "@type": "gh:Block",
      "schema:text": "I close my notebook."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:106",
      "@type": "gh:Block",
      "schema:text": "And drink a sip of water."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:107",
      "@type": "gh:Block",
      "schema:text": "A small relief opens at the back of my throat."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:108",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:109",
      "@type": "gh:Block",
      "schema:text": "“Reconciliation.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:110",
      "@type": "gh:Block",
      "schema:text": "Warm word."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:111",
      "@type": "gh:Block",
      "schema:text": "Anger doesn’t vanish."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:112",
      "@type": "gh:Block",
      "schema:text": "But it changes."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:113",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:114",
      "@type": "gh:Block",
      "schema:text": "I look at my companions—"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:115",
      "@type": "gh:Block",
      "schema:text": "Kaede, Hibiki, Nei-chan, Aoi."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:116",
      "@type": "gh:Block",
      "schema:text": "Our gazes meet and loosen, naturally."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:117",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:118",
      "@type": "gh:Block",
      "schema:text": "“Together.”"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:119",
      "@type": "gh:Block",
      "schema:text": "One word, and the room brightens."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:120",
      "@type": "gh:Block",
      "schema:text": "Water answers in the distance."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:121",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:122",
      "@type": "gh:Block",
      "schema:text": "We begin to walk, together."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:123",
      "@type": "gh:Block",
      "schema:text": "Not anger—reconciliation."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:124",
      "@type": "gh:Block",
      "schema:text": "Not domination—relation."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:125",
      "@type": "gh:Block",
      "schema:text": "Not perfection—breath."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:126",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:127",
      "@type": "gh:Block",
      "schema:text": "The Rage Engine becomes the Reconciliation Engine."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:128",
      "@type": "gh:Block",
      "schema:text": "Anger becomes reconciliation."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:129",
      "@type": "gh:Block",
      "schema:text": "666 disappears."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:130",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:131",
      "@type": "gh:Block",
      "schema:text": "We breathe together."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:132",
      "@type": "gh:Block",
      "schema:text": "In, out."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:133",
      "@type": "gh:Block",
      "schema:text": "That alone is enough."
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:134",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep09/part3.en:135",
      "@type": "gh:Block",
      "schema:text": "**[Beat: The engine of reconciliation—from anger to reconciliation; the disappearance of 666]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:49+09:00"
}