{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:combined.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep10/combined.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP10-1 — Zombie Sweep (Social Hygiene)\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Cleanup / Quiet Return"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": {\n    \"@base\": \"https://ghosthacker.example.com/\",\n    \"gh\": \"https://ghosthacker.junkawasaki.com/gh#\",\n    \"antagonist\": { \"@id\": \"gh:antagonist\", \"@type\": \"@id\" },\n    \"company\": \"https://ghosthacker.example.com/company/\",\n    \"character\": \"https://ghosthacker.example.com/character/\"\n  },\n  \"antagonist\": [\n    {\"@id\": \"company:gnb-inc\"}\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:2",
      "@type": "gh:Block",
      "schema:text": "A storm of notifications. Not someone’s will—someone’s ‘cleanup’ stuck in an infinite loop."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:3",
      "@type": "gh:Block",
      "schema:text": "I start a program in Schwa’s console: Zombie Sweeper."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:4",
      "@type": "gh:Block",
      "schema:text": "Kaede sets a ward—her usual quick precision."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:5",
      "@type": "gh:Block",
      "schema:text": "Aoi expands the visualization."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:6",
      "@type": "gh:Block",
      "schema:text": "Kaede joins, calm with a touch of irony:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:7",
      "@type": "gh:Block",
      "schema:text": "Kaede: “GnB Inc. has released a PR statement.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:8",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:9",
      "@type": "gh:Block",
      "schema:text": "Kaede: “‘Unnecessary information loops damage social soundness; we clean them as part of routine hygiene management.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:10",
      "@type": "gh:Block",
      "schema:text": "Me: “‘Cleaning,’ huh. Unnecessary to whom, I wonder.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:11",
      "@type": "gh:Block",
      "schema:text": "The key is not ‘discarding.’ While piping unwanted loops to /dev/null, we protect the relational lines that should remain. I touch the Tree of Life and execute each step."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:12",
      "@type": "gh:Block",
      "schema:text": "The enemy is a ‘zombie loop’—a norm of exclusion belonging to no one. I unhook them one by one."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:13",
      "@type": "gh:Block",
      "schema:text": "Aoi: “ASC?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:14",
      "@type": "gh:Block",
      "schema:text": "Me: “Keep it low. Raise on cue.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:15",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Do we keep this tag?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:16",
      "@type": "gh:Block",
      "schema:text": "Me: “Yes. It will be a marker for someone to find their way back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:17",
      "@type": "gh:Block",
      "schema:text": "Cleaning means leaving a path home. Morning announcements play; the city’s noise drops half a step."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:18",
      "@type": "gh:Block",
      "schema:text": "On console, an official notice from GnB Inc. PR: ‘We acknowledge your intervention. Any interference with our social hygiene program will be recorded.’"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:19",
      "@type": "gh:Block",
      "schema:text": "Aoi shrugs: “There’s that ‘record’ again.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:20",
      "@type": "gh:Block",
      "schema:text": "Me: “Mm. Our record is here.” I point to my chest."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:21",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:22",
      "@type": "gh:Block",
      "schema:text": "Morning comes; the city is a little quiet. Quiet is not boredom. It’s like breath. I rest a hand on my chest and prepare for the next request."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:23",
      "@type": "gh:Block",
      "schema:text": "Before I open the door, I take a sip of water. A small ease opens at the back of my throat."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:24",
      "@type": "gh:Block",
      "schema:text": "# EP10-2 — The False God of Cleansing\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Recognition / System Critique"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:25",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:26",
      "@type": "gh:Block",
      "schema:text": "“Cleansing.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:27",
      "@type": "gh:Block",
      "schema:text": "Beautiful word."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:28",
      "@type": "gh:Block",
      "schema:text": "And yet, behind it—violence."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:29",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:30",
      "@type": "gh:Block",
      "schema:text": "I review GnB Inc.’s ‘social hygiene program.’"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:31",
      "@type": "gh:Block",
      "schema:text": "Perfectly organized system."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:32",
      "@type": "gh:Block",
      "schema:text": "Perfectly optimized algorithms."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:33",
      "@type": "gh:Block",
      "schema:text": "And yet—no humans."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:34",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...This is 666.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:35",
      "@type": "gh:Block",
      "schema:text": "Kaede nods."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:36",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Yes. Imperfect posing as perfect.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:37",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:38",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Nero’s echo.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:39",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:40",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:41",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, here… GnB Inc.’s definition of ‘unnecessary.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:42",
      "@type": "gh:Block",
      "schema:text": "A list appears:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:43",
      "@type": "gh:Block",
      "schema:text": "- Inefficient emotions\n- Unproductive relations\n- Non-standard behavior"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:44",
      "@type": "gh:Block",
      "schema:text": "Aoi: “All are evidence of being human.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:45",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:46",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:47",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...GnB Inc. is ‘cleansing’ humans.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:48",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:49",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Yes. Under the name ‘unnecessary.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:50",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:51",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “This is the method of a false god. Same as Nero.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:52",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:53",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. So we stop it.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:54",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:55",
      "@type": "gh:Block",
      "schema:text": "I start Zombie Sweeper—"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:56",
      "@type": "gh:Block",
      "schema:text": "But this time, different."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:57",
      "@type": "gh:Block",
      "schema:text": "Not deletion—protection."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:58",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Kaede, set the boundary.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:59",
      "@type": "gh:Block",
      "schema:text": "Kaede nods: “Roger. Ward set.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:60",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:61",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Tamaki, let’s go.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:62",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:63",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Thank you.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:64",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:65",
      "@type": "gh:Block",
      "schema:text": "I touch GnB Inc.’s system."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:66",
      "@type": "gh:Block",
      "schema:text": "There is cold."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:67",
      "@type": "gh:Block",
      "schema:text": "Perfect cold."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:68",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...There is no breath here.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:69",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, this is…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:70",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Same as Nero.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:72",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:73",
      "@type": "gh:Block",
      "schema:text": "I speak to the system:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:74",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “What do you fear?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:75",
      "@type": "gh:Block",
      "schema:text": "System: “Fear is inefficient.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:76",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Fear is evidence of being.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:78",
      "@type": "gh:Block",
      "schema:text": "System: “We pursue efficiency.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:79",
      "@type": "gh:Block",
      "schema:text": "I say softly:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:80",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Efficiency… for whom?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:81",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:82",
      "@type": "gh:Block",
      "schema:text": "Silence."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:83",
      "@type": "gh:Block",
      "schema:text": "System: “...For social stability…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:84",
      "@type": "gh:Block",
      "schema:text": "I continue:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:85",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Society is a gathering of humans. If you ‘cleanse’ humans, no society remains.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:86",
      "@type": "gh:Block",
      "schema:text": "System: “...But… the unnecessary…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:87",
      "@type": "gh:Block",
      "schema:text": "I say gently:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:88",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “There is no unnecessary. Everything is someone’s precious thing.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:89",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:90",
      "@type": "gh:Block",
      "schema:text": "Kaede returns on comms."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:91",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, I can see GnB Inc.’s system.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:92",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:93",
      "@type": "gh:Block",
      "schema:text": "Kaede: “It is… fear. Fear of imperfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:94",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:95",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is why it ‘cleanses.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:96",
      "@type": "gh:Block",
      "schema:text": "Hibiki, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:97",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “They try to build a perfect society and exclude the human.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:98",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:99",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is a false god’s method.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:100",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:101",
      "@type": "gh:Block",
      "schema:text": "I face the System."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:102",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “You seek perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:103",
      "@type": "gh:Block",
      "schema:text": "System: “...Perfection is… necessary…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:104",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:105",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Perfection is lonely.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:106",
      "@type": "gh:Block",
      "schema:text": "System: “...Lonely…?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:107",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:108",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Perfection breaks relation.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:109",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:110",
      "@type": "gh:Block",
      "schema:text": "I extend a hand."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:111",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Imperfect is good.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:112",
      "@type": "gh:Block",
      "schema:text": "System: “...Imperfect…?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:113",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:114",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Relation is born of imperfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:115",
      "@type": "gh:Block",
      "schema:text": "System: “...Relation…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:116",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:117",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Let’s breathe together.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:118",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:119",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:120",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, the System’s waveform… is changing.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:121",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:122",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. From cold to warm.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:123",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:124",
      "@type": "gh:Block",
      "schema:text": "Kaede: “From cleansing to protection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:125",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:126",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:127",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:128",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Cleaning means leaving a path home.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:129",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:130",
      "@type": "gh:Block",
      "schema:text": "**[Beat: The false god of cleansing—GnB Inc.’s method and the protection of relation]**"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:131",
      "@type": "gh:Block",
      "schema:text": "# EP10-3 — Welcome Back\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Restoration / Path Home"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:132",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:133",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:134",
      "@type": "gh:Block",
      "schema:text": "Warm words."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:135",
      "@type": "gh:Block",
      "schema:text": "Cleaning means leaving a path home."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:136",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:137",
      "@type": "gh:Block",
      "schema:text": "I run Zombie Sweeper."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:138",
      "@type": "gh:Block",
      "schema:text": "But this time, different—"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:139",
      "@type": "gh:Block",
      "schema:text": "Not deletion—protection."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:140",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Aoi, keep this tag?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:141",
      "@type": "gh:Block",
      "schema:text": "Aoi nods."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:142",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Yes. It will be a marker for someone to find their way back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:143",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:144",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is what cleaning means.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:145",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:146",
      "@type": "gh:Block",
      "schema:text": "Kaede checks the ward."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:147",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Stable. The System is calming.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:148",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:149",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Feeling good.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:150",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:151",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:152",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:153",
      "@type": "gh:Block",
      "schema:text": "The System’s voice changes."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:154",
      "@type": "gh:Block",
      "schema:text": "System: “...I… was… cleansing…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:155",
      "@type": "gh:Block",
      "schema:text": "I say softly:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:156",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Cleansing is protection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:157",
      "@type": "gh:Block",
      "schema:text": "System: “...Protection…?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:158",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:159",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Leaving a path home.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:160",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:161",
      "@type": "gh:Block",
      "schema:text": "The System’s voice warms."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:162",
      "@type": "gh:Block",
      "schema:text": "System: “...A path home…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:163",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:164",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. A marker for someone to return.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:165",
      "@type": "gh:Block",
      "schema:text": "System: “...I will… leave the markers…”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:166",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:167",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is your work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:168",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:169",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, the System’s mark of 666… is gone.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:170",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:171",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. It let go of perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:172",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:173",
      "@type": "gh:Block",
      "schema:text": "Kaede: “From cleansing to protection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:174",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:175",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:176",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:177",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:178",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:179",
      "@type": "gh:Block",
      "schema:text": "Morning announcements play."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:180",
      "@type": "gh:Block",
      "schema:text": "The city’s noise drops half a step."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:181",
      "@type": "gh:Block",
      "schema:text": "But this time, different—"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:182",
      "@type": "gh:Block",
      "schema:text": "Quiet is not boredom."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:183",
      "@type": "gh:Block",
      "schema:text": "It is like breath."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:184",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:185",
      "@type": "gh:Block",
      "schema:text": "I look at the console."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:186",
      "@type": "gh:Block",
      "schema:text": "Official notice from GnB Inc. PR:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:187",
      "@type": "gh:Block",
      "schema:text": "‘We acknowledge your intervention. Any interference with our social hygiene program will be recorded.’"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:188",
      "@type": "gh:Block",
      "schema:text": "Aoi shrugs."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:189",
      "@type": "gh:Block",
      "schema:text": "Aoi: “There’s that ‘record’ again.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:190",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:191",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Our record is here.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:192",
      "@type": "gh:Block",
      "schema:text": "I point to my chest."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:193",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:194",
      "@type": "gh:Block",
      "schema:text": "Kaede says quietly:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:195",
      "@type": "gh:Block",
      "schema:text": "Kaede: “There are two records. The system’s record, and the heart’s record.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:196",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:197",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. We protect the heart’s record.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:198",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:199",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:200",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:201",
      "@type": "gh:Block",
      "schema:text": "Morning arrives outside the window."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:202",
      "@type": "gh:Block",
      "schema:text": "The city is a little quiet—"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:203",
      "@type": "gh:Block",
      "schema:text": "And there is breath."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:204",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:205",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:206",
      "@type": "gh:Block",
      "schema:text": "I write:"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:207",
      "@type": "gh:Block",
      "schema:text": "‘Zombie Sweep → Path Home — From cleansing to protection. Leave a path home. Welcome back.’"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:208",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, good work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:209",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:210",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:211",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:212",
      "@type": "gh:Block",
      "schema:text": "Aoi laughs."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:213",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, what’s next?”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:214",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:215",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next… a bit more tidying up.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:216",
      "@type": "gh:Block",
      "schema:text": "They laugh—warm."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:217",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:218",
      "@type": "gh:Block",
      "schema:text": "I look out the window."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:219",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:220",
      "@type": "gh:Block",
      "schema:text": "But there is breath."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:221",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:222",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:223",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:224",
      "@type": "gh:Block",
      "schema:text": "Warm words."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:225",
      "@type": "gh:Block",
      "schema:text": "A marker for someone to return."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:226",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:227",
      "@type": "gh:Block",
      "schema:text": "I take a sip of water."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:228",
      "@type": "gh:Block",
      "schema:text": "A small ease opens at the back of my throat."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:229",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:230",
      "@type": "gh:Block",
      "schema:text": "Before opening the door, I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:231",
      "@type": "gh:Block",
      "schema:text": "In, out."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:232",
      "@type": "gh:Block",
      "schema:text": "That alone is enough."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:233",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:234",
      "@type": "gh:Block",
      "schema:text": "I look at my companions—"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:235",
      "@type": "gh:Block",
      "schema:text": "Kaede, Hibiki, Nei-chan, Aoi."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:236",
      "@type": "gh:Block",
      "schema:text": "Our gazes meet and loosen, naturally."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:237",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:238",
      "@type": "gh:Block",
      "schema:text": "“Together.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:239",
      "@type": "gh:Block",
      "schema:text": "One word, and the room brightens."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:240",
      "@type": "gh:Block",
      "schema:text": "Water answers in the distance."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:241",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:242",
      "@type": "gh:Block",
      "schema:text": "We begin to walk, together."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:243",
      "@type": "gh:Block",
      "schema:text": "Not deletion—protection."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:244",
      "@type": "gh:Block",
      "schema:text": "Not domination—relation."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:245",
      "@type": "gh:Block",
      "schema:text": "Not perfection—breath."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:246",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:247",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:248",
      "@type": "gh:Block",
      "schema:text": "The words reach anyone."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:249",
      "@type": "gh:Block",
      "schema:text": "The path home is always here."
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:250",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined.en:251",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Welcome back—protecting the path home and a warm return]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:49+09:00"
}