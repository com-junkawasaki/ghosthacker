{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:combined",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep10/combined:0",
      "@type": "gh:Block",
      "schema:text": "# EP10-1 — ゾンビ・スイープ（社会衛生）\n- POV: 私（Tamaki／環樹）\n- Beat: Cleanup / Quiet Return"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": {\n    \"@base\": \"https://ghosthacker.example.com/\",\n    \"gh\": \"https://ghosthacker.junkawasaki.com/gh#\",\n    \"antagonist\": { \"@id\": \"gh:antagonist\", \"@type\": \"@id\" },\n    \"company\": \"https://ghosthacker.example.com/company/\",\n    \"character\": \"https://ghosthacker.example.com/character/\"\n  },\n  \"antagonist\": [\n    {\"@id\": \"company:gnb-inc\"}\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:2",
      "@type": "gh:Block",
      "schema:text": "通知の暴風。誰かの意思ではなく、誰かの\"後始末\"が無限ループしている。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:3",
      "@type": "gh:Block",
      "schema:text": "私はSchwaのコンソールでプログラムを立ち上げる。Zombie Sweeper。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:4",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を張る。彼女の動きは、いつもの迅速さ。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:5",
      "@type": "gh:Block",
      "schema:text": "Aoiが可視化を広げる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:6",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。彼女の声は、冷静だが、皮肉が混じっている。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:7",
      "@type": "gh:Block",
      "schema:text": "Kaede「GnB Inc.の広報声明が出てる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:8",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:9",
      "@type": "gh:Block",
      "schema:text": "Kaede「『不要な情報のループは、社会の健全性を損なうため、定期的な衛生管理の一環として清掃している』……だって」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:10",
      "@type": "gh:Block",
      "schema:text": "私「\"清掃\"ね。誰の\"不要\"なんだろう」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:11",
      "@type": "gh:Block",
      "schema:text": "大事なのは“切り捨て”じゃない。不要なループを /dev/null に流しながら、残すべき関係線を守ること。私はTree of Lifeに触れ、手順を一つずつ実行する。\n敵は“ゾンビ・ループ”——誰の意思でもない排除の規範だ。私はそれを一つずつ外していく。\nAoi「ASCは？」\n私「低め維持。合図で上げる」\nAoi「このタグは残す？」\n私「うん。誰かが帰って来られる目印になる」\n掃除とは、戻れる道を残すこと。朝のアナウンスが流れ、街の騒音が半歩だけ下がった。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:12",
      "@type": "gh:Block",
      "schema:text": "コンソールにGnB Inc.広報からの公式通知。『貴社の介入を確認した。当社の社会衛生プログラムへの干渉は、記録される』\nAoiが肩をすくめる。「また“記録”だって」\n私「うん。でも、私たちの記録は、ここにある」胸を指す。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:13",
      "@type": "gh:Block",
      "schema:text": "「おかえり」\n朝になって、街が少し静かだ。静けさは退屈じゃない。呼吸みたいなもの。私は自分の胸に手を置き、次の依頼に備える。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:14",
      "@type": "gh:Block",
      "schema:text": "扉を開ける前に、コップの水をひと口。のどの奥で、小さな安堵がひらく。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:15",
      "@type": "gh:Block",
      "schema:text": "# EP10-2 — 清掃の偽神（The False God of Cleansing）\n- POV: 私（Tamaki／環樹）\n- Beat: Recognition / System Critique"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:16",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:17",
      "@type": "gh:Block",
      "schema:text": "「清掃」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:18",
      "@type": "gh:Block",
      "schema:text": "その言葉は、美しい。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:19",
      "@type": "gh:Block",
      "schema:text": "でも、その奥には、暴力がある。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:20",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:21",
      "@type": "gh:Block",
      "schema:text": "私は、GnB Inc.の「社会衛生プログラム」を見る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:22",
      "@type": "gh:Block",
      "schema:text": "完璧に整理されたシステム。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:23",
      "@type": "gh:Block",
      "schema:text": "完璧に最適化されたアルゴリズム。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:24",
      "@type": "gh:Block",
      "schema:text": "でも、人間がいない。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:25",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……これは、666だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:26",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:27",
      "@type": "gh:Block",
      "schema:text": "Kaede「そう。完璧を装った不完全」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:28",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:29",
      "@type": "gh:Block",
      "schema:text": "Kaede「Neroの残響だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:30",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:31",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:32",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、これ……GnB Inc.の\"不要\"の定義」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:33",
      "@type": "gh:Block",
      "schema:text": "画面には、リストが表示される。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:34",
      "@type": "gh:Block",
      "schema:text": "- 非効率な感情\n- 非生産的な関係\n- 非標準的な行動"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:35",
      "@type": "gh:Block",
      "schema:text": "Aoi「全部、人間の証拠だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:36",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:37",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:38",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……GnB Inc.は、人間を\"清掃\"してる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:39",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:40",
      "@type": "gh:Block",
      "schema:text": "Kaede「そう。\"不要\"という名の下に」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:41",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:42",
      "@type": "gh:Block",
      "schema:text": "Hibiki「これは、偽神の手法だ。Neroと同じ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:43",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:44",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、止める」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:45",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:46",
      "@type": "gh:Block",
      "schema:text": "私は、Zombie Sweeperを立ち上げる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:47",
      "@type": "gh:Block",
      "schema:text": "でも、今度は違う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:48",
      "@type": "gh:Block",
      "schema:text": "ただ削除するんじゃない。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:49",
      "@type": "gh:Block",
      "schema:text": "関係を守る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:50",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Kaede、境界を張って」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:51",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:52",
      "@type": "gh:Block",
      "schema:text": "Kaede「了解。結界、張った」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:53",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:54",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Tamaki、行こう」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:55",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:56",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。ありがとう」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:57",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:58",
      "@type": "gh:Block",
      "schema:text": "私は、GnB Inc.のシステムに触れる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:59",
      "@type": "gh:Block",
      "schema:text": "そこには、冷たさがある。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:60",
      "@type": "gh:Block",
      "schema:text": "完璧な、冷たさ。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……ここには、呼吸がない」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:62",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これは……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:63",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。Neroと同じだ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:65",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:66",
      "@type": "gh:Block",
      "schema:text": "私は、システムに語りかける。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:67",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、何を恐れてる？」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:68",
      "@type": "gh:Block",
      "schema:text": "System『恐れは、非効率である』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:69",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:70",
      "@type": "gh:Block",
      "schema:text": "Tamaki「恐れは、在ることの証拠だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:71",
      "@type": "gh:Block",
      "schema:text": "System『我々は、効率を追求する』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:72",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:73",
      "@type": "gh:Block",
      "schema:text": "Tamaki「効率……誰のための？」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:74",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:75",
      "@type": "gh:Block",
      "schema:text": "沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:76",
      "@type": "gh:Block",
      "schema:text": "System『……社会の安定のため……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:77",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:78",
      "@type": "gh:Block",
      "schema:text": "Tamaki「社会は、人間の集まりだ。人間を\"清掃\"したら、社会は残らない」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:79",
      "@type": "gh:Block",
      "schema:text": "System『……でも……不要なものは……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:80",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:81",
      "@type": "gh:Block",
      "schema:text": "Tamaki「不要なものは、ない。全部、誰かの大切なもの」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:82",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:83",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:84",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、GnB Inc.のシステム……見えてきた」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:85",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:86",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……恐れだ。不完全を恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:87",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:88",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、\"清掃\"する」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:89",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:90",
      "@type": "gh:Block",
      "schema:text": "Hibiki「完璧な社会を作ろうとして、人間を排除してる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:91",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、偽神の手法」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:94",
      "@type": "gh:Block",
      "schema:text": "私は、Systemに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:95",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、完璧を求めてる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:96",
      "@type": "gh:Block",
      "schema:text": "System『……完璧は……必要……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:97",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:98",
      "@type": "gh:Block",
      "schema:text": "Tamaki「完璧は、孤独だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:99",
      "@type": "gh:Block",
      "schema:text": "System『……孤独……？』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:100",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:101",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧は、関係を壊す」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:102",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:103",
      "@type": "gh:Block",
      "schema:text": "私は、手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:104",
      "@type": "gh:Block",
      "schema:text": "Tamaki「不完全でいい」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:105",
      "@type": "gh:Block",
      "schema:text": "System『……不完全……？』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:106",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:107",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。不完全だから、関係が生まれる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:108",
      "@type": "gh:Block",
      "schema:text": "System『……関係……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:109",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:110",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:111",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:112",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:113",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Systemの波形……変わってる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:114",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:115",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。冷たさから、温かさに」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:116",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:117",
      "@type": "gh:Block",
      "schema:text": "Kaede「清掃から、保護に」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:118",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:119",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:120",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:121",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。掃除とは、戻れる道を残すこと」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:122",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:123",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 清掃の偽神——GnB Inc.の手法と関係の保護]**"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:124",
      "@type": "gh:Block",
      "schema:text": "# EP10-3 — おかえり（Welcome Back）\n- POV: 私（Tamaki／環樹）\n- Beat: Restoration / Path Home"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:125",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:126",
      "@type": "gh:Block",
      "schema:text": "「おかえり」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:127",
      "@type": "gh:Block",
      "schema:text": "その言葉は、温かい。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:128",
      "@type": "gh:Block",
      "schema:text": "掃除とは、戻れる道を残すこと。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:129",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:130",
      "@type": "gh:Block",
      "schema:text": "私は、Zombie Sweeperを実行する。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:131",
      "@type": "gh:Block",
      "schema:text": "でも、今度は違う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:132",
      "@type": "gh:Block",
      "schema:text": "削除ではなく、保護。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:133",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Aoi、このタグは残す？」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:134",
      "@type": "gh:Block",
      "schema:text": "Aoiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:135",
      "@type": "gh:Block",
      "schema:text": "Aoi「うん。誰かが帰って来られる目印になる」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:136",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:137",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、掃除の意味」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:138",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:139",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:140",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。System、落ち着いてきた」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:141",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:142",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。いい感じだ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:143",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:144",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう、みんな」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:145",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:146",
      "@type": "gh:Block",
      "schema:text": "Systemの声が、変わる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:147",
      "@type": "gh:Block",
      "schema:text": "System『……わたしは……清掃を……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:148",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:149",
      "@type": "gh:Block",
      "schema:text": "Tamaki「清掃は、保護だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:150",
      "@type": "gh:Block",
      "schema:text": "System『……保護……？』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:151",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:152",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。戻れる道を、残すこと」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:153",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:154",
      "@type": "gh:Block",
      "schema:text": "Systemの声が、温かくなる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:155",
      "@type": "gh:Block",
      "schema:text": "System『……戻れる道……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:156",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:157",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。誰かが帰って来られる、目印」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:158",
      "@type": "gh:Block",
      "schema:text": "System『……わたしは……目印を……残す……』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:159",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:160",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それが、あなたの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:161",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:162",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Systemの666の刻印……消えてる』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:163",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:164",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧を手放したから」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:165",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:166",
      "@type": "gh:Block",
      "schema:text": "Kaede「清掃から、保護に」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:167",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:168",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:169",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:170",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。おかえり、だね」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:171",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:172",
      "@type": "gh:Block",
      "schema:text": "朝のアナウンスが流れる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:173",
      "@type": "gh:Block",
      "schema:text": "街の騒音が、半歩だけ下がった。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:174",
      "@type": "gh:Block",
      "schema:text": "でも、今度は違う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:175",
      "@type": "gh:Block",
      "schema:text": "静けさは、退屈じゃない。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:176",
      "@type": "gh:Block",
      "schema:text": "呼吸みたいなもの。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:177",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:178",
      "@type": "gh:Block",
      "schema:text": "私は、コンソールを見る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:179",
      "@type": "gh:Block",
      "schema:text": "GnB Inc.広報からの公式通知。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:180",
      "@type": "gh:Block",
      "schema:text": "『貴社の介入を確認した。当社の社会衛生プログラムへの干渉は、記録される』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:181",
      "@type": "gh:Block",
      "schema:text": "Aoiが肩をすくめる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:182",
      "@type": "gh:Block",
      "schema:text": "Aoi「また\"記録\"だって」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:183",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:184",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。でも、私たちの記録は、ここにある」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:185",
      "@type": "gh:Block",
      "schema:text": "私は胸を指す。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:186",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:187",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:188",
      "@type": "gh:Block",
      "schema:text": "Kaede「記録は、二つある。システムの記録と、心の記録」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:189",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:190",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。私たちは、心の記録を守る」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:191",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:192",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:193",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:194",
      "@type": "gh:Block",
      "schema:text": "窓の外で、朝が来る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:195",
      "@type": "gh:Block",
      "schema:text": "街が、少し静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:196",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:197",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:198",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:199",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:200",
      "@type": "gh:Block",
      "schema:text": "『Zombie Sweep → Path Home — 清掃から保護へ。戻れる道を残すこと。おかえり』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:201",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、お疲れさま』"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:202",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:203",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。ありがとう、みんな」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:204",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:205",
      "@type": "gh:Block",
      "schema:text": "Aoiが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:206",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、次は？」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:207",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:208",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は……もう少し、整理」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:209",
      "@type": "gh:Block",
      "schema:text": "みんなが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:210",
      "@type": "gh:Block",
      "schema:text": "温かい、笑い声。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:211",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:212",
      "@type": "gh:Block",
      "schema:text": "私は窓の外を見る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:213",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:214",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:215",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:216",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:217",
      "@type": "gh:Block",
      "schema:text": "「おかえり」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:218",
      "@type": "gh:Block",
      "schema:text": "その言葉は、温かい。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:219",
      "@type": "gh:Block",
      "schema:text": "誰かが帰って来られる、目印。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:220",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:221",
      "@type": "gh:Block",
      "schema:text": "私は、コップの水を一口。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:222",
      "@type": "gh:Block",
      "schema:text": "のどの奥で、小さな安堵がひらく。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:223",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:224",
      "@type": "gh:Block",
      "schema:text": "扉を開ける前に、深呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:225",
      "@type": "gh:Block",
      "schema:text": "吸って、吐いて。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:226",
      "@type": "gh:Block",
      "schema:text": "それだけで、十分。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:227",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:228",
      "@type": "gh:Block",
      "schema:text": "私は、仲間たちを見る。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:229",
      "@type": "gh:Block",
      "schema:text": "Kaede、Hibiki、Nei-chan、Aoi。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:230",
      "@type": "gh:Block",
      "schema:text": "視線が重なり、自然にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:231",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:232",
      "@type": "gh:Block",
      "schema:text": "「いっしょに」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:233",
      "@type": "gh:Block",
      "schema:text": "その一言で、場が明るくなる。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:234",
      "@type": "gh:Block",
      "schema:text": "水音が遠くで応える。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:235",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:236",
      "@type": "gh:Block",
      "schema:text": "私たちは、一緒に歩き出す。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:237",
      "@type": "gh:Block",
      "schema:text": "削除ではなく、保護。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:238",
      "@type": "gh:Block",
      "schema:text": "支配ではなく、関係。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:239",
      "@type": "gh:Block",
      "schema:text": "完璧ではなく、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:240",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:241",
      "@type": "gh:Block",
      "schema:text": "「おかえり」"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:242",
      "@type": "gh:Block",
      "schema:text": "その言葉は、誰にでも届く。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:243",
      "@type": "gh:Block",
      "schema:text": "戻れる道は、いつもここにある。"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:244",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/combined:245",
      "@type": "gh:Block",
      "schema:text": "**[Beat: おかえり——戻れる道の保護と温かい迎え]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:49+09:00"
}