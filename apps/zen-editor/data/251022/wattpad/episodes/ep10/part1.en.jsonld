{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part1.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep10/part1.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP10-1 — Zombie Sweep (Social Hygiene)\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Cleanup / Quiet Return"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": {\n    \"@base\": \"https://ghosthacker.example.com/\",\n    \"gh\": \"https://ghosthacker.junkawasaki.com/gh#\",\n    \"antagonist\": { \"@id\": \"gh:antagonist\", \"@type\": \"@id\" },\n    \"company\": \"https://ghosthacker.example.com/company/\",\n    \"character\": \"https://ghosthacker.example.com/character/\"\n  },\n  \"antagonist\": [\n    {\"@id\": \"company:gnb-inc\"}\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:2",
      "@type": "gh:Block",
      "schema:text": "A storm of notifications. Not someone’s will—someone’s ‘cleanup’ stuck in an infinite loop."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:3",
      "@type": "gh:Block",
      "schema:text": "I start a program in Schwa’s console: Zombie Sweeper."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:4",
      "@type": "gh:Block",
      "schema:text": "Kaede sets a ward—her usual quick precision."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:5",
      "@type": "gh:Block",
      "schema:text": "Aoi expands the visualization."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:6",
      "@type": "gh:Block",
      "schema:text": "Kaede joins, calm with a touch of irony:"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:7",
      "@type": "gh:Block",
      "schema:text": "Kaede: “GnB Inc. has released a PR statement.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:8",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:9",
      "@type": "gh:Block",
      "schema:text": "Kaede: “‘Unnecessary information loops damage social soundness; we clean them as part of routine hygiene management.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:10",
      "@type": "gh:Block",
      "schema:text": "Me: “‘Cleaning,’ huh. Unnecessary to whom, I wonder.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:11",
      "@type": "gh:Block",
      "schema:text": "The key is not ‘discarding.’ While piping unwanted loops to /dev/null, we protect the relational lines that should remain. I touch the Tree of Life and execute each step."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:12",
      "@type": "gh:Block",
      "schema:text": "The enemy is a ‘zombie loop’—a norm of exclusion belonging to no one. I unhook them one by one."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:13",
      "@type": "gh:Block",
      "schema:text": "Aoi: “ASC?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:14",
      "@type": "gh:Block",
      "schema:text": "Me: “Keep it low. Raise on cue.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:15",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Do we keep this tag?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:16",
      "@type": "gh:Block",
      "schema:text": "Me: “Yes. It will be a marker for someone to find their way back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:17",
      "@type": "gh:Block",
      "schema:text": "Cleaning means leaving a path home. Morning announcements play; the city’s noise drops half a step."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:18",
      "@type": "gh:Block",
      "schema:text": "On console, an official notice from GnB Inc. PR: ‘We acknowledge your intervention. Any interference with our social hygiene program will be recorded.’"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:19",
      "@type": "gh:Block",
      "schema:text": "Aoi shrugs: “There’s that ‘record’ again.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:20",
      "@type": "gh:Block",
      "schema:text": "Me: “Mm. Our record is here.” I point to my chest."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:21",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:22",
      "@type": "gh:Block",
      "schema:text": "Morning comes; the city is a little quiet. Quiet is not boredom. It’s like breath. I rest a hand on my chest and prepare for the next request."
    },
    {
      "@id": "block:251022:episodes/ep10/part1.en:23",
      "@type": "gh:Block",
      "schema:text": "Before I open the door, I take a sip of water. A small ease opens at the back of my throat."
    }
  ],
  "updatedAt": "2026-01-12T19:01:49+09:00"
}