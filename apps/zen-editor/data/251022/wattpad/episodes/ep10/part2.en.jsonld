{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep10/part2.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP10-2 — The False God of Cleansing\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Recognition / System Critique"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:2",
      "@type": "gh:Block",
      "schema:text": "“Cleansing.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:3",
      "@type": "gh:Block",
      "schema:text": "Beautiful word."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:4",
      "@type": "gh:Block",
      "schema:text": "And yet, behind it—violence."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:5",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:6",
      "@type": "gh:Block",
      "schema:text": "I review GnB Inc.’s ‘social hygiene program.’"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:7",
      "@type": "gh:Block",
      "schema:text": "Perfectly organized system."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:8",
      "@type": "gh:Block",
      "schema:text": "Perfectly optimized algorithms."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:9",
      "@type": "gh:Block",
      "schema:text": "And yet—no humans."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:10",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...This is 666.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:11",
      "@type": "gh:Block",
      "schema:text": "Kaede nods."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:12",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Yes. Imperfect posing as perfect.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:13",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:14",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Nero’s echo.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:15",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:16",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:17",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, here… GnB Inc.’s definition of ‘unnecessary.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:18",
      "@type": "gh:Block",
      "schema:text": "A list appears:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:19",
      "@type": "gh:Block",
      "schema:text": "- Inefficient emotions\n- Unproductive relations\n- Non-standard behavior"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:20",
      "@type": "gh:Block",
      "schema:text": "Aoi: “All are evidence of being human.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:21",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:22",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:23",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...GnB Inc. is ‘cleansing’ humans.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:24",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:25",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Yes. Under the name ‘unnecessary.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:26",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:27",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “This is the method of a false god. Same as Nero.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:28",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:29",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. So we stop it.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:30",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:31",
      "@type": "gh:Block",
      "schema:text": "I start Zombie Sweeper—"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:32",
      "@type": "gh:Block",
      "schema:text": "But this time, different."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:33",
      "@type": "gh:Block",
      "schema:text": "Not deletion—protection."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:34",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Kaede, set the boundary.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:35",
      "@type": "gh:Block",
      "schema:text": "Kaede nods: “Roger. Ward set.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:36",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:37",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Tamaki, let’s go.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:38",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:39",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Thank you.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:40",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:41",
      "@type": "gh:Block",
      "schema:text": "I touch GnB Inc.’s system."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:42",
      "@type": "gh:Block",
      "schema:text": "There is cold."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:43",
      "@type": "gh:Block",
      "schema:text": "Perfect cold."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:44",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...There is no breath here.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:45",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, this is…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:46",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:47",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Same as Nero.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:48",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:49",
      "@type": "gh:Block",
      "schema:text": "I speak to the system:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:50",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “What do you fear?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:51",
      "@type": "gh:Block",
      "schema:text": "System: “Fear is inefficient.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:52",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:53",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Fear is evidence of being.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:54",
      "@type": "gh:Block",
      "schema:text": "System: “We pursue efficiency.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:55",
      "@type": "gh:Block",
      "schema:text": "I say softly:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:56",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Efficiency… for whom?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:57",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:58",
      "@type": "gh:Block",
      "schema:text": "Silence."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:59",
      "@type": "gh:Block",
      "schema:text": "System: “...For social stability…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:60",
      "@type": "gh:Block",
      "schema:text": "I continue:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Society is a gathering of humans. If you ‘cleanse’ humans, no society remains.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:62",
      "@type": "gh:Block",
      "schema:text": "System: “...But… the unnecessary…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:63",
      "@type": "gh:Block",
      "schema:text": "I say gently:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “There is no unnecessary. Everything is someone’s precious thing.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:65",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:66",
      "@type": "gh:Block",
      "schema:text": "Kaede returns on comms."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:67",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, I can see GnB Inc.’s system.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:68",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:69",
      "@type": "gh:Block",
      "schema:text": "Kaede: “It is… fear. Fear of imperfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:70",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is why it ‘cleanses.’”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:72",
      "@type": "gh:Block",
      "schema:text": "Hibiki, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:73",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “They try to build a perfect society and exclude the human.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:74",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:75",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is a false god’s method.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:76",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:77",
      "@type": "gh:Block",
      "schema:text": "I face the System."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:78",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “You seek perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:79",
      "@type": "gh:Block",
      "schema:text": "System: “...Perfection is… necessary…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:80",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:81",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Perfection is lonely.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:82",
      "@type": "gh:Block",
      "schema:text": "System: “...Lonely…?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:83",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:84",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Perfection breaks relation.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:85",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:86",
      "@type": "gh:Block",
      "schema:text": "I extend a hand."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:87",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Imperfect is good.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:88",
      "@type": "gh:Block",
      "schema:text": "System: “...Imperfect…?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:89",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:90",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Relation is born of imperfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:91",
      "@type": "gh:Block",
      "schema:text": "System: “...Relation…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:92",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:93",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Let’s breathe together.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:94",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:95",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:96",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, the System’s waveform… is changing.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:97",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:98",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. From cold to warm.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:99",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:100",
      "@type": "gh:Block",
      "schema:text": "Kaede: “From cleansing to protection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:101",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:102",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:103",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:104",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Cleaning means leaving a path home.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:105",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2.en:106",
      "@type": "gh:Block",
      "schema:text": "**[Beat: The false god of cleansing—GnB Inc.’s method and the protection of relation]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:49+09:00"
}