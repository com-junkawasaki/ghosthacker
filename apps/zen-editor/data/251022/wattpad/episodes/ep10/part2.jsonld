{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep10/part2:0",
      "@type": "gh:Block",
      "schema:text": "# EP10-2 — 清掃の偽神（The False God of Cleansing）\n- POV: 私（Tamaki／環樹）\n- Beat: Recognition / System Critique"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:2",
      "@type": "gh:Block",
      "schema:text": "「清掃」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:3",
      "@type": "gh:Block",
      "schema:text": "その言葉は、美しい。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:4",
      "@type": "gh:Block",
      "schema:text": "でも、その奥には、暴力がある。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:5",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:6",
      "@type": "gh:Block",
      "schema:text": "私は、GnB Inc.の「社会衛生プログラム」を見る。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:7",
      "@type": "gh:Block",
      "schema:text": "完璧に整理されたシステム。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:8",
      "@type": "gh:Block",
      "schema:text": "完璧に最適化されたアルゴリズム。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:9",
      "@type": "gh:Block",
      "schema:text": "でも、人間がいない。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:10",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……これは、666だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:11",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:12",
      "@type": "gh:Block",
      "schema:text": "Kaede「そう。完璧を装った不完全」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:13",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:14",
      "@type": "gh:Block",
      "schema:text": "Kaede「Neroの残響だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:15",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:16",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:17",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、これ……GnB Inc.の\"不要\"の定義」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:18",
      "@type": "gh:Block",
      "schema:text": "画面には、リストが表示される。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:19",
      "@type": "gh:Block",
      "schema:text": "- 非効率な感情\n- 非生産的な関係\n- 非標準的な行動"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:20",
      "@type": "gh:Block",
      "schema:text": "Aoi「全部、人間の証拠だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:21",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:22",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:23",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……GnB Inc.は、人間を\"清掃\"してる」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:24",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:25",
      "@type": "gh:Block",
      "schema:text": "Kaede「そう。\"不要\"という名の下に」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:26",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:27",
      "@type": "gh:Block",
      "schema:text": "Hibiki「これは、偽神の手法だ。Neroと同じ」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:28",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:29",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、止める」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:30",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:31",
      "@type": "gh:Block",
      "schema:text": "私は、Zombie Sweeperを立ち上げる。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:32",
      "@type": "gh:Block",
      "schema:text": "でも、今度は違う。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:33",
      "@type": "gh:Block",
      "schema:text": "ただ削除するんじゃない。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:34",
      "@type": "gh:Block",
      "schema:text": "関係を守る。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:35",
      "@type": "gh:Block",
      "schema:text": "Tamaki「Kaede、境界を張って」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:36",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:37",
      "@type": "gh:Block",
      "schema:text": "Kaede「了解。結界、張った」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:38",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:39",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。Tamaki、行こう」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:40",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:41",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。ありがとう」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:42",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:43",
      "@type": "gh:Block",
      "schema:text": "私は、GnB Inc.のシステムに触れる。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:44",
      "@type": "gh:Block",
      "schema:text": "そこには、冷たさがある。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:45",
      "@type": "gh:Block",
      "schema:text": "完璧な、冷たさ。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:46",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……ここには、呼吸がない」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:47",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、これは……』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:48",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:49",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。Neroと同じだ」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:50",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:51",
      "@type": "gh:Block",
      "schema:text": "私は、システムに語りかける。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:52",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、何を恐れてる？」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:53",
      "@type": "gh:Block",
      "schema:text": "System『恐れは、非効率である』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:54",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:55",
      "@type": "gh:Block",
      "schema:text": "Tamaki「恐れは、在ることの証拠だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:56",
      "@type": "gh:Block",
      "schema:text": "System『我々は、効率を追求する』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:57",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:58",
      "@type": "gh:Block",
      "schema:text": "Tamaki「効率……誰のための？」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:59",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:60",
      "@type": "gh:Block",
      "schema:text": "沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:61",
      "@type": "gh:Block",
      "schema:text": "System『……社会の安定のため……』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:62",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:63",
      "@type": "gh:Block",
      "schema:text": "Tamaki「社会は、人間の集まりだ。人間を\"清掃\"したら、社会は残らない」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:64",
      "@type": "gh:Block",
      "schema:text": "System『……でも……不要なものは……』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:65",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:66",
      "@type": "gh:Block",
      "schema:text": "Tamaki「不要なものは、ない。全部、誰かの大切なもの」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:67",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:68",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:69",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、GnB Inc.のシステム……見えてきた」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:70",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:71",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……恐れだ。不完全を恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:72",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:73",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、\"清掃\"する」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:74",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:75",
      "@type": "gh:Block",
      "schema:text": "Hibiki「完璧な社会を作ろうとして、人間を排除してる」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:76",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:77",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、偽神の手法」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:78",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:79",
      "@type": "gh:Block",
      "schema:text": "私は、Systemに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:80",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、完璧を求めてる」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:81",
      "@type": "gh:Block",
      "schema:text": "System『……完璧は……必要……』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:82",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:83",
      "@type": "gh:Block",
      "schema:text": "Tamaki「完璧は、孤独だ」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:84",
      "@type": "gh:Block",
      "schema:text": "System『……孤独……？』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:85",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:86",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧は、関係を壊す」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:87",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:88",
      "@type": "gh:Block",
      "schema:text": "私は、手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:89",
      "@type": "gh:Block",
      "schema:text": "Tamaki「不完全でいい」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:90",
      "@type": "gh:Block",
      "schema:text": "System『……不完全……？』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:91",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。不完全だから、関係が生まれる」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:93",
      "@type": "gh:Block",
      "schema:text": "System『……関係……』"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:94",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:95",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:96",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:97",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:98",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Systemの波形……変わってる」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:99",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:100",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。冷たさから、温かさに」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:101",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:102",
      "@type": "gh:Block",
      "schema:text": "Kaede「清掃から、保護に」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:103",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:104",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:105",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:106",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。掃除とは、戻れる道を残すこと」"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:107",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part2:108",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 清掃の偽神——GnB Inc.の手法と関係の保護]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:49+09:00"
}