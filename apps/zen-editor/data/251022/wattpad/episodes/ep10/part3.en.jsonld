{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep10/part3.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP10-3 — Welcome Back\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Restoration / Path Home"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:2",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:3",
      "@type": "gh:Block",
      "schema:text": "Warm words."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:4",
      "@type": "gh:Block",
      "schema:text": "Cleaning means leaving a path home."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:5",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:6",
      "@type": "gh:Block",
      "schema:text": "I run Zombie Sweeper."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:7",
      "@type": "gh:Block",
      "schema:text": "But this time, different—"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:8",
      "@type": "gh:Block",
      "schema:text": "Not deletion—protection."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:9",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Aoi, keep this tag?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:10",
      "@type": "gh:Block",
      "schema:text": "Aoi nods."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:11",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Yes. It will be a marker for someone to find their way back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:12",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:13",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is what cleaning means.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:14",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:15",
      "@type": "gh:Block",
      "schema:text": "Kaede checks the ward."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:16",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Stable. The System is calming.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:17",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:18",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Feeling good.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:19",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:20",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:21",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:22",
      "@type": "gh:Block",
      "schema:text": "The System’s voice changes."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:23",
      "@type": "gh:Block",
      "schema:text": "System: “...I… was… cleansing…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:24",
      "@type": "gh:Block",
      "schema:text": "I say softly:"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:25",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Cleansing is protection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:26",
      "@type": "gh:Block",
      "schema:text": "System: “...Protection…?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:27",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:28",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Leaving a path home.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:29",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:30",
      "@type": "gh:Block",
      "schema:text": "The System’s voice warms."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:31",
      "@type": "gh:Block",
      "schema:text": "System: “...A path home…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:32",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:33",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. A marker for someone to return.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:34",
      "@type": "gh:Block",
      "schema:text": "System: “...I will… leave the markers…”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:35",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:36",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is your work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:37",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:38",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, the System’s mark of 666… is gone.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:39",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:40",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. It let go of perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:41",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:42",
      "@type": "gh:Block",
      "schema:text": "Kaede: “From cleansing to protection.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:43",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:44",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:45",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:46",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:47",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:48",
      "@type": "gh:Block",
      "schema:text": "Morning announcements play."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:49",
      "@type": "gh:Block",
      "schema:text": "The city’s noise drops half a step."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:50",
      "@type": "gh:Block",
      "schema:text": "But this time, different—"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:51",
      "@type": "gh:Block",
      "schema:text": "Quiet is not boredom."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:52",
      "@type": "gh:Block",
      "schema:text": "It is like breath."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:53",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:54",
      "@type": "gh:Block",
      "schema:text": "I look at the console."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:55",
      "@type": "gh:Block",
      "schema:text": "Official notice from GnB Inc. PR:"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:56",
      "@type": "gh:Block",
      "schema:text": "‘We acknowledge your intervention. Any interference with our social hygiene program will be recorded.’"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:57",
      "@type": "gh:Block",
      "schema:text": "Aoi shrugs."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:58",
      "@type": "gh:Block",
      "schema:text": "Aoi: “There’s that ‘record’ again.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:59",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:60",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Our record is here.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:61",
      "@type": "gh:Block",
      "schema:text": "I point to my chest."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:62",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:63",
      "@type": "gh:Block",
      "schema:text": "Kaede says quietly:"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:64",
      "@type": "gh:Block",
      "schema:text": "Kaede: “There are two records. The system’s record, and the heart’s record.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:65",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:66",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. We protect the heart’s record.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:67",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:68",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:69",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:70",
      "@type": "gh:Block",
      "schema:text": "Morning arrives outside the window."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:71",
      "@type": "gh:Block",
      "schema:text": "The city is a little quiet—"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:72",
      "@type": "gh:Block",
      "schema:text": "And there is breath."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:73",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:74",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:75",
      "@type": "gh:Block",
      "schema:text": "I write:"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:76",
      "@type": "gh:Block",
      "schema:text": "‘Zombie Sweep → Path Home — From cleansing to protection. Leave a path home. Welcome back.’"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:77",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, good work.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:78",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:79",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Mm. Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:80",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:81",
      "@type": "gh:Block",
      "schema:text": "Aoi laughs."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:82",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, what’s next?”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:83",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:84",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next… a bit more tidying up.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:85",
      "@type": "gh:Block",
      "schema:text": "They laugh—warm."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:86",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:87",
      "@type": "gh:Block",
      "schema:text": "I look out the window."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:88",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:89",
      "@type": "gh:Block",
      "schema:text": "But there is breath."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:90",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:91",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:92",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:93",
      "@type": "gh:Block",
      "schema:text": "Warm words."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:94",
      "@type": "gh:Block",
      "schema:text": "A marker for someone to return."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:95",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:96",
      "@type": "gh:Block",
      "schema:text": "I take a sip of water."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:97",
      "@type": "gh:Block",
      "schema:text": "A small ease opens at the back of my throat."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:98",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:99",
      "@type": "gh:Block",
      "schema:text": "Before opening the door, I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:100",
      "@type": "gh:Block",
      "schema:text": "In, out."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:101",
      "@type": "gh:Block",
      "schema:text": "That alone is enough."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:102",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:103",
      "@type": "gh:Block",
      "schema:text": "I look at my companions—"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:104",
      "@type": "gh:Block",
      "schema:text": "Kaede, Hibiki, Nei-chan, Aoi."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:105",
      "@type": "gh:Block",
      "schema:text": "Our gazes meet and loosen, naturally."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:106",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:107",
      "@type": "gh:Block",
      "schema:text": "“Together.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:108",
      "@type": "gh:Block",
      "schema:text": "One word, and the room brightens."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:109",
      "@type": "gh:Block",
      "schema:text": "Water answers in the distance."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:110",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:111",
      "@type": "gh:Block",
      "schema:text": "We begin to walk, together."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:112",
      "@type": "gh:Block",
      "schema:text": "Not deletion—protection."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:113",
      "@type": "gh:Block",
      "schema:text": "Not domination—relation."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:114",
      "@type": "gh:Block",
      "schema:text": "Not perfection—breath."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:115",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:116",
      "@type": "gh:Block",
      "schema:text": "“Welcome back.”"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:117",
      "@type": "gh:Block",
      "schema:text": "The words reach anyone."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:118",
      "@type": "gh:Block",
      "schema:text": "The path home is always here."
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:119",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep10/part3.en:120",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Welcome back—protecting the path home and a warm return]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:50+09:00"
}