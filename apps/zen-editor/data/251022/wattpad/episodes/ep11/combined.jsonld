{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:combined",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep11/combined:0",
      "@type": "gh:Block",
      "schema:text": "# EP11-1 — コンプライアンスの鬼（Compliance Ogre）\n- POV: 私（Tamaki／環樹）\n- Beat: Decompile / Quiet Justice"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:1",
      "@type": "gh:Block",
      "schema:text": "```json\n{\n  \"@context\": {\n    \"@base\": \"https://ghosthacker.example.com/\",\n    \"gh\": \"https://ghosthacker.junkawasaki.com/gh#\",\n    \"antagonist\": { \"@id\": \"gh:antagonist\", \"@type\": \"@id\" },\n    \"character\": \"https://ghosthacker.example.com/character/\",\n    \"ghost\": \"https://ghosthacker.example.com/ghost/\"\n  },\n  \"antagonist\": [\n    {\"@id\": \"character:nero-ops\"},\n    {\"@id\": \"ghost:compliance-ogre\"}\n  ]\n}\n```"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:2",
      "@type": "gh:Block",
      "schema:text": "書類は完璧。だから臭う。私は行間を読む。Kaedeが指すログは、人間が置き去りにされた場所を示す。正義の名を借りた恐れが、現場を締め付けていた。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:3",
      "@type": "gh:Block",
      "schema:text": "私は彼（鬼）に名を与える。「あなたの名は、恐れの正当化」名は輪郭。輪郭があれば、道が拓ける。制度は敵じゃない。呼吸の仕方を忘れただけ。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:4",
      "@type": "gh:Block",
      "schema:text": "小さくほぐれる。完璧は一歩退き、人間が半歩進む。私は拳を開いて、ゆっくり息を吐く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:5",
      "@type": "gh:Block",
      "schema:text": "「呼吸できる正義」を胸に置く。私は書類を閉じ、窓を少しだけ開ける。\n冷たい完璧は下がり、やわらかな信頼が入ってくる。静けさが合図になる。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:6",
      "@type": "gh:Block",
      "schema:text": "Aoi「十分。今日はここまででいい」\n私はうなずく。胸の緊張がほどけ、安堵が広がる。小さな笑顔が返ってくる。\n窓辺の光はやわらかい。希望は声を上げない——けれど、確かにここにある。\n私は『Quiet Justice』のチェックリストを送る。制度は敵じゃない。呼吸を忘れたときに、私たちが思い出す合図が必要なだけだ。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:7",
      "@type": "gh:Block",
      "schema:text": "# EP11-2 — 恐れの正当化（The Justification of Fear）\n- POV: 私（Tamaki／環樹）\n- Beat: Deconstruction / Fear and Justice"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:8",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:9",
      "@type": "gh:Block",
      "schema:text": "書類は完璧。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:10",
      "@type": "gh:Block",
      "schema:text": "だから臭う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:11",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:12",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreのログを見る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:13",
      "@type": "gh:Block",
      "schema:text": "完璧に整理された記録。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:14",
      "@type": "gh:Block",
      "schema:text": "完璧に最適化された手順。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:15",
      "@type": "gh:Block",
      "schema:text": "でも、人間が置き去りにされている。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:16",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……これは、恐れの正当化だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:17",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:18",
      "@type": "gh:Block",
      "schema:text": "Kaede「そう。恐れを、正義に変えてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:19",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:20",
      "@type": "gh:Block",
      "schema:text": "Kaede「でも、正義は呼吸を止めてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:21",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:22",
      "@type": "gh:Block",
      "schema:text": "私は、行間を読む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:23",
      "@type": "gh:Block",
      "schema:text": "そこには、恐れがある。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:24",
      "@type": "gh:Block",
      "schema:text": "「完璧じゃないと、拒絶される」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:25",
      "@type": "gh:Block",
      "schema:text": "「不完全は、排除される」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:26",
      "@type": "gh:Block",
      "schema:text": "「正義は、完璧でなければならない」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:27",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……Compliance Ogreは、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:28",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:29",
      "@type": "gh:Block",
      "schema:text": "Hibiki「だから、完璧を強いる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:30",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:31",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。恐れを、正義に変えて」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:32",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:33",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに語りかける。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:34",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、何を恐れてる？」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:35",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『恐れは、非効率である』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:36",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:37",
      "@type": "gh:Block",
      "schema:text": "Tamaki「恐れは、在ることの証拠だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:38",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『我々は、正義を維持する』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:39",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:40",
      "@type": "gh:Block",
      "schema:text": "Tamaki「正義……誰のための？」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:41",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:42",
      "@type": "gh:Block",
      "schema:text": "沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:43",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……社会の秩序のため……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:44",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:45",
      "@type": "gh:Block",
      "schema:text": "Tamaki「秩序は、誰の呼吸を止めてる？」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:46",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……呼吸は……非効率……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:47",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:48",
      "@type": "gh:Block",
      "schema:text": "Tamaki「呼吸は、生きることだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:49",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:50",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:51",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Compliance Ogreの構造……見えてきた」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:52",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:53",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……防御機制だ。恐れを隠してる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:54",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:55",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、正義を装う」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:56",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:57",
      "@type": "gh:Block",
      "schema:text": "Hibiki「正義は、恐れの鎧だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:58",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:59",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。だから、鎧を脱がせる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:60",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:61",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:62",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、不完全を恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:63",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……不完全は……排除される……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:64",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:65",
      "@type": "gh:Block",
      "schema:text": "Tamaki「不完全は、人間だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:66",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……でも……正義は……完璧……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:67",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:68",
      "@type": "gh:Block",
      "schema:text": "Tamaki「正義は、呼吸と一緒に作るもの」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:69",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:70",
      "@type": "gh:Block",
      "schema:text": "私は、手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの名は、恐れの正当化」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:72",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、わずかに震える。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:73",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……恐れている……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:74",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:75",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:76",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……それで……いい……？』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:77",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:78",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。恐れは、在ることの証拠だから」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:79",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:80",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:81",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Compliance Ogreの波形……変わってる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:82",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:83",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。恐れから、信頼に」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:84",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:85",
      "@type": "gh:Block",
      "schema:text": "Kaede「正義から、呼吸に」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:86",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:87",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:88",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:89",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。呼吸できる正義、だね」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:90",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:91",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Compliance Ogreの666の刻印……薄くなってる』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:92",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:93",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧を手放したから」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:94",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:95",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。Compliance Ogre、落ち着いてきた」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:96",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:97",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。いい感じだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:98",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:99",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。もう少しだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:100",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:101",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに語りかける。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:102",
      "@type": "gh:Block",
      "schema:text": "Tamaki「一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:103",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……一緒に……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:104",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:105",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:106",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:107",
      "@type": "gh:Block",
      "schema:text": "吸って、吐いて。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:108",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreも、一緒に呼吸する。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:109",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:110",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの声が、温かくなる。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:111",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……呼吸する……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:112",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:113",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それが、正義だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:114",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……呼吸する……正義……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:115",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:116",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。呼吸できる正義」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:117",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:118",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 恐れの正当化——正義の鎧を脱ぎ、呼吸を取り戻す]**"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:119",
      "@type": "gh:Block",
      "schema:text": "# EP11-3 — 呼吸できる正義（Quiet Justice）\n- POV: 私（Tamaki／環樹）\n- Beat: Transformation / Justice with Breath"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:120",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:121",
      "@type": "gh:Block",
      "schema:text": "「呼吸できる正義」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:122",
      "@type": "gh:Block",
      "schema:text": "その言葉は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:123",
      "@type": "gh:Block",
      "schema:text": "でも、確かにある。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:124",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:125",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに語りかける。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:126",
      "@type": "gh:Block",
      "schema:text": "Tamaki「正義は、完璧じゃない」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:127",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……完璧じゃない……？』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:128",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:129",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。正義は、呼吸と一緒に作るもの」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:130",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……呼吸と……一緒に……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:131",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:132",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。吸って、吐いて。それだけ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:133",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:134",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、ほどけていく。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:135",
      "@type": "gh:Block",
      "schema:text": "その下には、小さな、震える存在。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:136",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……完璧じゃない……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:137",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:138",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:139",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……それで……いい……？』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:140",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:141",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それで、十分」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:142",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:143",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:144",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Compliance Ogreの構造……統合されてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:145",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:146",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……Quiet Justice」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:147",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:148",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。呼吸できる正義だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:149",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:150",
      "@type": "gh:Block",
      "schema:text": "Hibiki「正義は、声を上げない。でも、確かにある」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:151",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:152",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、Quiet Justice」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:153",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:154",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:155",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、正義を守りたかった」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:156",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……うん……わたしは……正義を……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:157",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:158",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。でも、完璧を求めすぎた」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:159",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……完璧を……求めすぎた……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:160",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:161",
      "@type": "gh:Block",
      "schema:text": "Tamaki「正義は、完璧じゃない。呼吸だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:162",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:163",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの声が、静かになる。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:164",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……呼吸……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:165",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:166",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:167",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……一緒に……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:168",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:169",
      "@type": "gh:Block",
      "schema:text": "吸って、吐いて。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:170",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreも、一緒に呼吸する。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:171",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:172",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Compliance Ogreの666の刻印……完全に消えた』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:173",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:174",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧を手放したから」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:175",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:176",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。Compliance Ogre、穏やかだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:177",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:178",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。いい感じだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:179",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:180",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう、みんな」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:181",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:182",
      "@type": "gh:Block",
      "schema:text": "私は、『Quiet Justice』のチェックリストを送る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:183",
      "@type": "gh:Block",
      "schema:text": "- 完璧を求めない\n- 呼吸を止めない\n- 関係を守る\n- 戻れる道を残す"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:184",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreが、静かに受け取る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:185",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……これを……守る……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:186",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:187",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に、守ろう」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:188",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:189",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:190",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Compliance Ogreの影響範囲……変わってる」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:191",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:192",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。恐れから、信頼に」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:193",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:194",
      "@type": "gh:Block",
      "schema:text": "Kaede「完璧から、呼吸に」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:195",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:196",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。それが、Quiet Justice」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:197",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:198",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。制度は敵じゃない。呼吸を忘れたときに、私たちが思い出す合図が必要なだけ」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:199",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:200",
      "@type": "gh:Block",
      "schema:text": "窓の外で、朝の光が差し込む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:201",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、完全にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:202",
      "@type": "gh:Block",
      "schema:text": "その下には、小さな、温かい存在。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:203",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……在る……』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:204",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:205",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。あなたは、在る。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:206",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:207",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreが、静かに消えていく。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:208",
      "@type": "gh:Block",
      "schema:text": "成仏ではない。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:209",
      "@type": "gh:Block",
      "schema:text": "還るだけだ。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:210",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:211",
      "@type": "gh:Block",
      "schema:text": "私は手帳に書く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:212",
      "@type": "gh:Block",
      "schema:text": "『Quiet Justice — 呼吸できる正義。完璧ではなく、呼吸。恐れではなく、信頼』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:213",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、お疲れさま』"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:214",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:215",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。ありがとう、みんな」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:216",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:217",
      "@type": "gh:Block",
      "schema:text": "Aoiが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:218",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、次は？」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:219",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:220",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は……最後」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:221",
      "@type": "gh:Block",
      "schema:text": "みんなが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:222",
      "@type": "gh:Block",
      "schema:text": "静かな、頷き。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:223",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:224",
      "@type": "gh:Block",
      "schema:text": "私は窓の外を見る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:225",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:226",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:227",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:228",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:229",
      "@type": "gh:Block",
      "schema:text": "私は手帳を閉じる。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:230",
      "@type": "gh:Block",
      "schema:text": "そして、コップの水を一口。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:231",
      "@type": "gh:Block",
      "schema:text": "のどの奥で、小さな安堵がひらく。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:232",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:233",
      "@type": "gh:Block",
      "schema:text": "「呼吸できる正義」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:234",
      "@type": "gh:Block",
      "schema:text": "その言葉は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:235",
      "@type": "gh:Block",
      "schema:text": "でも、確かにある。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:236",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:237",
      "@type": "gh:Block",
      "schema:text": "私は、仲間たちを見る。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:238",
      "@type": "gh:Block",
      "schema:text": "Kaede、Hibiki、Nei-chan、Aoi。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:239",
      "@type": "gh:Block",
      "schema:text": "視線が重なり、自然にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:240",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:241",
      "@type": "gh:Block",
      "schema:text": "「いっしょに」"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:242",
      "@type": "gh:Block",
      "schema:text": "その一言で、場が明るくなる。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:243",
      "@type": "gh:Block",
      "schema:text": "水音が遠くで応える。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:244",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:245",
      "@type": "gh:Block",
      "schema:text": "私たちは、一緒に歩き出す。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:246",
      "@type": "gh:Block",
      "schema:text": "完璧ではなく、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:247",
      "@type": "gh:Block",
      "schema:text": "恐れではなく、信頼。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:248",
      "@type": "gh:Block",
      "schema:text": "支配ではなく、関係。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:249",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:250",
      "@type": "gh:Block",
      "schema:text": "Quiet Justice."
    },
    {
      "@id": "block:251022:episodes/ep11/combined:251",
      "@type": "gh:Block",
      "schema:text": "呼吸できる正義。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:252",
      "@type": "gh:Block",
      "schema:text": "それが、私たちの答えだ。"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:253",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/combined:254",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 呼吸できる正義——完璧の放棄と信頼の回復]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:50+09:00"
}