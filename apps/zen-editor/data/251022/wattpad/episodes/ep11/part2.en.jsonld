{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part2.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep11/part2.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP11-2 — The Justification of Fear\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Deconstruction / Fear and Justice"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:2",
      "@type": "gh:Block",
      "schema:text": "The paperwork is perfect."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:3",
      "@type": "gh:Block",
      "schema:text": "That’s why it reeks."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:4",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:5",
      "@type": "gh:Block",
      "schema:text": "I read the Compliance Ogre’s logs."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:6",
      "@type": "gh:Block",
      "schema:text": "Perfectly organized records."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:7",
      "@type": "gh:Block",
      "schema:text": "Perfectly optimized procedures."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:8",
      "@type": "gh:Block",
      "schema:text": "And yet—humans are left behind."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:9",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...This is the justification of fear.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:10",
      "@type": "gh:Block",
      "schema:text": "Kaede nods."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:11",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Yes. It turns fear into justice.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:12",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:13",
      "@type": "gh:Block",
      "schema:text": "Kaede: “But that justice stops breath.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:14",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:15",
      "@type": "gh:Block",
      "schema:text": "I read between the lines."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:16",
      "@type": "gh:Block",
      "schema:text": "There is fear."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:17",
      "@type": "gh:Block",
      "schema:text": "‘If I’m not perfect, I’ll be rejected.’"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:18",
      "@type": "gh:Block",
      "schema:text": "‘The imperfect is eliminated.’"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:19",
      "@type": "gh:Block",
      "schema:text": "‘Justice must be perfect.’"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:20",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “...The Compliance Ogre is afraid.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:21",
      "@type": "gh:Block",
      "schema:text": "Hibiki, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:22",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “So it forces perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:23",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:24",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. It turns fear into justice.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:25",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:26",
      "@type": "gh:Block",
      "schema:text": "I speak to the Compliance Ogre."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:27",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “What do you fear?”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:28",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “Fear is inefficient.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:29",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:30",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Fear is evidence of being.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:31",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “We maintain justice.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:32",
      "@type": "gh:Block",
      "schema:text": "I say softly:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:33",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Justice… for whom?”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:34",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:35",
      "@type": "gh:Block",
      "schema:text": "Silence."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:36",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...For the order of society…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:37",
      "@type": "gh:Block",
      "schema:text": "I continue:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:38",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Whose breathing does the order stop?”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:39",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...Breath is… inefficient…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:40",
      "@type": "gh:Block",
      "schema:text": "I say quietly:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:41",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Breath is life.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:42",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:43",
      "@type": "gh:Block",
      "schema:text": "Kaede returns on comms."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:44",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, I can see the Ogre’s structure.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:45",
      "@type": "gh:Block",
      "schema:text": "She leaves a beat."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:46",
      "@type": "gh:Block",
      "schema:text": "Kaede: “It’s a defense mechanism—hiding fear.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:47",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:48",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. So it wears justice.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:49",
      "@type": "gh:Block",
      "schema:text": "Hibiki, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:50",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Justice is fear’s armor.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:51",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:52",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. So we help remove the armor.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:53",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:54",
      "@type": "gh:Block",
      "schema:text": "I face the Ogre."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:55",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “You fear imperfection.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:56",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...The imperfect is… eliminated…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:57",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:58",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “The imperfect is human.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:59",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...But… justice is… perfect…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:60",
      "@type": "gh:Block",
      "schema:text": "I say quietly:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Justice is made together with breath.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:62",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:63",
      "@type": "gh:Block",
      "schema:text": "I extend a hand."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Your name is the justification of fear.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:65",
      "@type": "gh:Block",
      "schema:text": "The Ogre’s armor trembles."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:66",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...I am… afraid…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:67",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:68",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That’s okay.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:69",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...It’s… okay…?”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:70",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Fear is evidence of being.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:72",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:73",
      "@type": "gh:Block",
      "schema:text": "Aoi displays metrics."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:74",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, the Ogre’s waveform… is changing.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:75",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:76",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. From fear to trust.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:77",
      "@type": "gh:Block",
      "schema:text": "Kaede, quiet:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:78",
      "@type": "gh:Block",
      "schema:text": "Kaede: “From justice to breath.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:79",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:80",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. That is our work.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:81",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:82",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Justice that can breathe.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:83",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:84",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, the Ogre’s mark of 666… is fading.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:85",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:86",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. It let go of perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:87",
      "@type": "gh:Block",
      "schema:text": "Kaede checks the ward."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:88",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Stable. The Ogre is calming.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:89",
      "@type": "gh:Block",
      "schema:text": "Hibiki tunes the band."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:90",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Matching breath. Feeling good.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:91",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you. Almost there.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:94",
      "@type": "gh:Block",
      "schema:text": "I speak to the Compliance Ogre:"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:95",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Let’s breathe—together.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:96",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...Together…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:97",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:98",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Together.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:99",
      "@type": "gh:Block",
      "schema:text": "I breathe."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:100",
      "@type": "gh:Block",
      "schema:text": "In, out."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:101",
      "@type": "gh:Block",
      "schema:text": "The Ogre breathes with me."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:102",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:103",
      "@type": "gh:Block",
      "schema:text": "The Ogre’s voice warms."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:104",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...I… breathe…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:105",
      "@type": "gh:Block",
      "schema:text": "I nod."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:106",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is justice.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:107",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre: “...Justice… that breathes…”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:108",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:109",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Justice that can breathe.”"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:110",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2.en:111",
      "@type": "gh:Block",
      "schema:text": "**[Beat: The justification of fear—removing justice’s armor and restoring breath]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:50+09:00"
}