  "@id": "manuscript:251022:part2",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep11/part2:0",
      "@type": "gh:Block",
      "schema:text": "# EP11-2 — 恐れの正当化（The Justification of Fear）\n- POV: 私（Tamaki／環樹）\n- Beat: Deconstruction / Fear and Justice"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:2",
      "@type": "gh:Block",
      "schema:text": "書類は完璧。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:3",
      "@type": "gh:Block",
      "schema:text": "だから臭う。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:4",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:5",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreのログを見る。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:6",
      "@type": "gh:Block",
      "schema:text": "完璧に整理された記録。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:7",
      "@type": "gh:Block",
      "schema:text": "完璧に最適化された手順。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:8",
      "@type": "gh:Block",
      "schema:text": "でも、人間が置き去りにされている。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:9",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……これは、恐れの正当化だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:10",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:11",
      "@type": "gh:Block",
      "schema:text": "Kaede「そう。恐れを、正義に変えてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:12",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:13",
      "@type": "gh:Block",
      "schema:text": "Kaede「でも、正義は呼吸を止めてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:14",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:15",
      "@type": "gh:Block",
      "schema:text": "私は、行間を読む。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:16",
      "@type": "gh:Block",
      "schema:text": "そこには、恐れがある。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:17",
      "@type": "gh:Block",
      "schema:text": "「完璧じゃないと、拒絶される」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:18",
      "@type": "gh:Block",
      "schema:text": "「不完全は、排除される」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:19",
      "@type": "gh:Block",
      "schema:text": "「正義は、完璧でなければならない」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:20",
      "@type": "gh:Block",
      "schema:text": "Tamaki「……Compliance Ogreは、恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:21",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:22",
      "@type": "gh:Block",
      "schema:text": "Hibiki「だから、完璧を強いる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:23",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:24",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。恐れを、正義に変えて」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:25",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:26",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに語りかける。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:27",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、何を恐れてる？」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:28",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『恐れは、非効率である』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:29",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:30",
      "@type": "gh:Block",
      "schema:text": "Tamaki「恐れは、在ることの証拠だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:31",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『我々は、正義を維持する』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:32",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:33",
      "@type": "gh:Block",
      "schema:text": "Tamaki「正義……誰のための？」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:34",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:35",
      "@type": "gh:Block",
      "schema:text": "沈黙。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:36",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……社会の秩序のため……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:37",
      "@type": "gh:Block",
      "schema:text": "私は続ける。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:38",
      "@type": "gh:Block",
      "schema:text": "Tamaki「秩序は、誰の呼吸を止めてる？」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:39",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……呼吸は……非効率……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:40",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:41",
      "@type": "gh:Block",
      "schema:text": "Tamaki「呼吸は、生きることだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:42",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:43",
      "@type": "gh:Block",
      "schema:text": "Kaedeの声が通信に入る。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:44",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、Compliance Ogreの構造……見えてきた」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:45",
      "@type": "gh:Block",
      "schema:text": "彼女は少し間を置く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:46",
      "@type": "gh:Block",
      "schema:text": "Kaede「これは……防御機制だ。恐れを隠してる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:47",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:48",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。だから、正義を装う」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:49",
      "@type": "gh:Block",
      "schema:text": "Hibikiが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:50",
      "@type": "gh:Block",
      "schema:text": "Hibiki「正義は、恐れの鎧だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:51",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:52",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。だから、鎧を脱がせる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:53",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:54",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに向き直る。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:55",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたは、不完全を恐れてる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:56",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……不完全は……排除される……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:57",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:58",
      "@type": "gh:Block",
      "schema:text": "Tamaki「不完全は、人間だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:59",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……でも……正義は……完璧……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:60",
      "@type": "gh:Block",
      "schema:text": "私は静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:61",
      "@type": "gh:Block",
      "schema:text": "Tamaki「正義は、呼吸と一緒に作るもの」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:62",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:63",
      "@type": "gh:Block",
      "schema:text": "私は、手を伸ばす。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:64",
      "@type": "gh:Block",
      "schema:text": "Tamaki「あなたの名は、恐れの正当化」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:65",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの鎧が、わずかに震える。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:66",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……恐れている……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:67",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:68",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それでいい」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:69",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……それで……いい……？』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:70",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。恐れは、在ることの証拠だから」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:72",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:73",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを表示する。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:74",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、Compliance Ogreの波形……変わってる」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:75",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:76",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。恐れから、信頼に」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:77",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:78",
      "@type": "gh:Block",
      "schema:text": "Kaede「正義から、呼吸に」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:79",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:80",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。それが、私たちの仕事」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:81",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:82",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。呼吸できる正義、だね」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:83",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:84",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、Compliance Ogreの666の刻印……薄くなってる』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:85",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:86",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。完璧を手放したから」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:87",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を確認する。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:88",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、安定してる。Compliance Ogre、落ち着いてきた」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:89",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を整える。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:90",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、合わせてる。いい感じだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:91",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう。もう少しだ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:94",
      "@type": "gh:Block",
      "schema:text": "私は、Compliance Ogreに語りかける。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:95",
      "@type": "gh:Block",
      "schema:text": "Tamaki「一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:96",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……一緒に……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:97",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:98",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。一緒に」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:99",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:100",
      "@type": "gh:Block",
      "schema:text": "吸って、吐いて。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:101",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreも、一緒に呼吸する。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:102",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:103",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogreの声が、温かくなる。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:104",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……わたしは……呼吸する……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:105",
      "@type": "gh:Block",
      "schema:text": "私は頷く。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:106",
      "@type": "gh:Block",
      "schema:text": "Tamaki「うん。それが、正義だ」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:107",
      "@type": "gh:Block",
      "schema:text": "Compliance Ogre『……呼吸する……正義……』"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:108",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:109",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。呼吸できる正義」"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:110",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep11/part2:111",
      "@type": "gh:Block",
      "schema:text": "**[Beat: 恐れの正当化——正義の鎧を脱ぎ、呼吸を取り戻す]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:50+09:00"
}