  "gh:content": {
    "en": "‘I AM THAT I AM — I am. Nero returned. The learning remains. Not perfection—breath. Not domination—relation.’",
    "ja": "『I AM THAT I AM — わたしは在る。Neroは還った。でも、その学びは残る。完璧ではなく、呼吸。支配ではなく、関係』"
  },
  "gh:index": 108
}