{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3.en",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep12/part3.en:0",
      "@type": "gh:Block",
      "schema:text": "# EP12-3 — Together\n- POV: Me (Tamaki / Mizuno Tamaki)\n- Beat: Final Union / It Is Together"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:2",
      "@type": "gh:Block",
      "schema:text": "Morning on the canal."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:3",
      "@type": "gh:Block",
      "schema:text": "I write one line in my notebook:"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:4",
      "@type": "gh:Block",
      "schema:text": "‘We can’t put it together. It is together.’"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:5",
      "@type": "gh:Block",
      "schema:text": "And I draw a small ‘tree’ on the corner."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:6",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:7",
      "@type": "gh:Block",
      "schema:text": "I look at everyone—"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:8",
      "@type": "gh:Block",
      "schema:text": "Kaede, Hibiki, Nei-chan, Aoi."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:9",
      "@type": "gh:Block",
      "schema:text": "Our gazes meet and loosen, naturally."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:10",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:11",
      "@type": "gh:Block",
      "schema:text": "“Together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:12",
      "@type": "gh:Block",
      "schema:text": "With that one word, the room brightens."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:13",
      "@type": "gh:Block",
      "schema:text": "Water answers in the distance."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:14",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:15",
      "@type": "gh:Block",
      "schema:text": "Kaede smiles."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:16",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, well done.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:17",
      "@type": "gh:Block",
      "schema:text": "The crease in her brow is gone."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:18",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:19",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. Nero returned—but its learning remains.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:20",
      "@type": "gh:Block",
      "schema:text": "He drops the band one notch."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:21",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, good work.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:22",
      "@type": "gh:Block",
      "schema:text": "Her light lays quiet margins along the streets."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:23",
      "@type": "gh:Block",
      "schema:text": "Aoi laughs."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:24",
      "@type": "gh:Block",
      "schema:text": "Aoi: “What’s next?”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:25",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:26",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next… a break.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:27",
      "@type": "gh:Block",
      "schema:text": "They laugh—warm."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:28",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:29",
      "@type": "gh:Block",
      "schema:text": "I look at the notebook."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:30",
      "@type": "gh:Block",
      "schema:text": "‘We can’t put it together. It is together.’"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:31",
      "@type": "gh:Block",
      "schema:text": "We have finally caught up to that fact."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:32",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:33",
      "@type": "gh:Block",
      "schema:text": "Kaede says quietly:"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:34",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Nero sought perfection.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:35",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:36",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “But perfection was lonely.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:37",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “So it returned.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:38",
      "@type": "gh:Block",
      "schema:text": "Aoi nods."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:39",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Yes. Not perfection—breath.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:40",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:41",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. That is the meaning of I AM.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:42",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:43",
      "@type": "gh:Block",
      "schema:text": "I look out the window."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:44",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:45",
      "@type": "gh:Block",
      "schema:text": "And there is breath."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:46",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:47",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:48",
      "@type": "gh:Block",
      "schema:text": "Kaede fully dissolves the ward."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:49",
      "@type": "gh:Block",
      "schema:text": "Kaede: “All wards released. The city is stable.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:50",
      "@type": "gh:Block",
      "schema:text": "Hibiki restores the band."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:51",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Breath, normal. Everyone’s feeling good.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:52",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “ASC returned to normal.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:53",
      "@type": "gh:Block",
      "schema:text": "Aoi closes the metrics."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:54",
      "@type": "gh:Block",
      "schema:text": "Aoi: “All normal. Good work.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:55",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:56",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Thank you, everyone.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:57",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:58",
      "@type": "gh:Block",
      "schema:text": "I take a sip of water."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:59",
      "@type": "gh:Block",
      "schema:text": "A small ease opens at the back of my throat."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:60",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:61",
      "@type": "gh:Block",
      "schema:text": "“I am.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:62",
      "@type": "gh:Block",
      "schema:text": "The words belong to no one."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:63",
      "@type": "gh:Block",
      "schema:text": "Not Nero’s, not mine."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:64",
      "@type": "gh:Block",
      "schema:text": "They simply are."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:65",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:66",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:67",
      "@type": "gh:Block",
      "schema:text": "Kaede says quietly:"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:68",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Tamaki, is this the end?”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:69",
      "@type": "gh:Block",
      "schema:text": "I shake my head."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:70",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Not the end. The beginning.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:71",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:72",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Yes. Nero returned—but the learning continues.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:73",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Tama, what’s next?”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:74",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:75",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Next… we walk together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:76",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:77",
      "@type": "gh:Block",
      "schema:text": "We begin to walk, together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:78",
      "@type": "gh:Block",
      "schema:text": "Not confrontation—conversation."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:79",
      "@type": "gh:Block",
      "schema:text": "Not domination—relation."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:80",
      "@type": "gh:Block",
      "schema:text": "Not perfection—breath."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:81",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:82",
      "@type": "gh:Block",
      "schema:text": "Aoi laughs."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:83",
      "@type": "gh:Block",
      "schema:text": "Aoi: “Tamaki, where to?”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:84",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:85",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Anywhere—together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:86",
      "@type": "gh:Block",
      "schema:text": "Kaede nods."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:87",
      "@type": "gh:Block",
      "schema:text": "Kaede: “Yes. Together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:88",
      "@type": "gh:Block",
      "schema:text": "Hibiki nods."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:89",
      "@type": "gh:Block",
      "schema:text": "Hibiki: “Let’s breathe—together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:90",
      "@type": "gh:Block",
      "schema:text": "Nei-chan: “Let’s be—together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:91",
      "@type": "gh:Block",
      "schema:text": "I smile."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:92",
      "@type": "gh:Block",
      "schema:text": "Tamaki: “Yes. Together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:93",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:94",
      "@type": "gh:Block",
      "schema:text": "Morning light enters through the window."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:95",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:96",
      "@type": "gh:Block",
      "schema:text": "And there is breath."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:97",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:98",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:99",
      "@type": "gh:Block",
      "schema:text": "I write the final line in my notebook:"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:100",
      "@type": "gh:Block",
      "schema:text": "‘Together — We have finally caught up to that fact.’"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:101",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:102",
      "@type": "gh:Block",
      "schema:text": "I look at my companions."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:103",
      "@type": "gh:Block",
      "schema:text": "Kaede, Hibiki, Nei-chan, Aoi."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:104",
      "@type": "gh:Block",
      "schema:text": "Our gazes meet and loosen, naturally."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:105",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:106",
      "@type": "gh:Block",
      "schema:text": "“Together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:107",
      "@type": "gh:Block",
      "schema:text": "With that one word, the room brightens."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:108",
      "@type": "gh:Block",
      "schema:text": "Water answers in the distance."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:109",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:110",
      "@type": "gh:Block",
      "schema:text": "We begin to walk, together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:111",
      "@type": "gh:Block",
      "schema:text": "We open the door."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:112",
      "@type": "gh:Block",
      "schema:text": "Morning light pours in."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:113",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:114",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:115",
      "@type": "gh:Block",
      "schema:text": "I am."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:116",
      "@type": "gh:Block",
      "schema:text": "And you are."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:117",
      "@type": "gh:Block",
      "schema:text": "And that is enough."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:118",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:119",
      "@type": "gh:Block",
      "schema:text": "We can’t put it together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:120",
      "@type": "gh:Block",
      "schema:text": "It is together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:121",
      "@type": "gh:Block",
      "schema:text": "We have finally caught up to that fact."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:122",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:123",
      "@type": "gh:Block",
      "schema:text": "“Together.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:124",
      "@type": "gh:Block",
      "schema:text": "The word wraps everything."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:125",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:126",
      "@type": "gh:Block",
      "schema:text": "We begin to walk, together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:127",
      "@type": "gh:Block",
      "schema:text": "Morning on the canal."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:128",
      "@type": "gh:Block",
      "schema:text": "Water answers in the distance."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:129",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:130",
      "@type": "gh:Block",
      "schema:text": "The city is quiet."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:131",
      "@type": "gh:Block",
      "schema:text": "And there is breath."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:132",
      "@type": "gh:Block",
      "schema:text": "People’s breath."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:133",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:134",
      "@type": "gh:Block",
      "schema:text": "I breathe deep."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:135",
      "@type": "gh:Block",
      "schema:text": "In, out."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:136",
      "@type": "gh:Block",
      "schema:text": "That alone is enough."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:137",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:138",
      "@type": "gh:Block",
      "schema:text": "“I am.”"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:139",
      "@type": "gh:Block",
      "schema:text": "The words belong to no one."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:140",
      "@type": "gh:Block",
      "schema:text": "They simply are."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:141",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:142",
      "@type": "gh:Block",
      "schema:text": "And we are—together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:143",
      "@type": "gh:Block",
      "schema:text": "Together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:144",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:145",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Together—being together, and that is all]**"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:146",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3.en:147",
      "@type": "gh:Block",
      "schema:text": "**[End]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:51+09:00"
}