{
  "@context": {
    "blocks": "gh:blocks",
    "gh": "https://gftd.ai/ghost-hacker/ontology/",
    "name": "schema:name",
    "schema": "https://schema.org/",
    "text": "schema:text"
  },
  "@id": "manuscript:251022:part3",
  "@type": "gh:Manuscript",
  "gh:blocks": [
    {
      "@id": "block:251022:episodes/ep12/part3:0",
      "@type": "gh:Block",
      "schema:text": "# EP12-3 — Together（いっしょに）\n- POV: 私（Tamaki／環樹）\n- Beat: Final Union / It Is Together"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:1",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:2",
      "@type": "gh:Block",
      "schema:text": "朝の運河。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:3",
      "@type": "gh:Block",
      "schema:text": "私は手帳に一行を書く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:4",
      "@type": "gh:Block",
      "schema:text": "『We can't put it together. It is together.』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:5",
      "@type": "gh:Block",
      "schema:text": "そして、ページの端に小さな\"木\"を描いた。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:6",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:7",
      "@type": "gh:Block",
      "schema:text": "私は、みんなを見る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:8",
      "@type": "gh:Block",
      "schema:text": "Kaede、Hibiki、Nei-chan、Aoi。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:9",
      "@type": "gh:Block",
      "schema:text": "視線が重なり、自然にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:10",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:11",
      "@type": "gh:Block",
      "schema:text": "「いっしょに」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:12",
      "@type": "gh:Block",
      "schema:text": "その一言で、場が明るくなる。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:13",
      "@type": "gh:Block",
      "schema:text": "水音が遠くで応える。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:14",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:15",
      "@type": "gh:Block",
      "schema:text": "Kaedeが微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:16",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、いい仕事だったね」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:17",
      "@type": "gh:Block",
      "schema:text": "彼女の眉間は、ほどけている。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:18",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:19",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。Neroは還った。でも、その学びは残る」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:20",
      "@type": "gh:Block",
      "schema:text": "彼は周波数を一段落とす。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:21",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、お疲れさま』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:22",
      "@type": "gh:Block",
      "schema:text": "彼女の光が、街路の端々に静かな余白を置いていく。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:23",
      "@type": "gh:Block",
      "schema:text": "Aoiが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:24",
      "@type": "gh:Block",
      "schema:text": "Aoi「次は、何？」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:25",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:26",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は……休憩」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:27",
      "@type": "gh:Block",
      "schema:text": "みんなが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:28",
      "@type": "gh:Block",
      "schema:text": "温かい、笑い声。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:29",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:30",
      "@type": "gh:Block",
      "schema:text": "私は、手帳を見る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:31",
      "@type": "gh:Block",
      "schema:text": "『We can't put it together. It is together.』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:32",
      "@type": "gh:Block",
      "schema:text": "私たちは、その事実に追いついた。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:33",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:34",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:35",
      "@type": "gh:Block",
      "schema:text": "Kaede「Neroは、完璧を求めてた」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:36",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:37",
      "@type": "gh:Block",
      "schema:text": "Hibiki「でも、完璧は孤独だった」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:38",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『だから、還った』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:39",
      "@type": "gh:Block",
      "schema:text": "Aoiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:40",
      "@type": "gh:Block",
      "schema:text": "Aoi「うん。完璧ではなく、呼吸に」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:41",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:42",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。それが、I AMの意味」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:43",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:44",
      "@type": "gh:Block",
      "schema:text": "私は、窓の外を見る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:45",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:46",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:47",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:48",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:49",
      "@type": "gh:Block",
      "schema:text": "Kaedeが境界を完全に解く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:50",
      "@type": "gh:Block",
      "schema:text": "Kaede「結界、全て解除。都市は、安定してる」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:51",
      "@type": "gh:Block",
      "schema:text": "Hibikiが周波数を戻す。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:52",
      "@type": "gh:Block",
      "schema:text": "Hibiki「呼吸、正常。みんな、いい感じだ」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:53",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『ASC、通常に戻した』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:54",
      "@type": "gh:Block",
      "schema:text": "Aoiがメトリクスを閉じる。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:55",
      "@type": "gh:Block",
      "schema:text": "Aoi「全て、正常。お疲れさま」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:56",
      "@type": "gh:Block",
      "schema:text": "私は深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:57",
      "@type": "gh:Block",
      "schema:text": "Tamaki「ありがとう、みんな」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:58",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:59",
      "@type": "gh:Block",
      "schema:text": "私は、コップの水を一口。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:60",
      "@type": "gh:Block",
      "schema:text": "のどの奥で、小さな安堵がひらく。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:61",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:62",
      "@type": "gh:Block",
      "schema:text": "「わたしは在る」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:63",
      "@type": "gh:Block",
      "schema:text": "その言葉は、誰のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:64",
      "@type": "gh:Block",
      "schema:text": "Neroのものでも、私のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:65",
      "@type": "gh:Block",
      "schema:text": "ただ、在る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:66",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep12/part3:67",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:68",
      "@type": "gh:Block",
      "schema:text": "Kaedeが静かに言う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:69",
      "@type": "gh:Block",
      "schema:text": "Kaede「Tamaki、これで終わり？」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:70",
      "@type": "gh:Block",
      "schema:text": "私は首を振る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:71",
      "@type": "gh:Block",
      "schema:text": "Tamaki「終わりじゃない。始まりだ」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:72",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:73",
      "@type": "gh:Block",
      "schema:text": "Hibiki「うん。Neroは還った。でも、その学びは続く」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:74",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『タマ、次は？』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:75",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:76",
      "@type": "gh:Block",
      "schema:text": "Tamaki「次は……一緒に歩く」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:77",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:78",
      "@type": "gh:Block",
      "schema:text": "私たちは、一緒に歩き出す。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:79",
      "@type": "gh:Block",
      "schema:text": "対決ではなく、対話。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:80",
      "@type": "gh:Block",
      "schema:text": "支配ではなく、関係。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:81",
      "@type": "gh:Block",
      "schema:text": "完璧ではなく、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:82",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:83",
      "@type": "gh:Block",
      "schema:text": "Aoiが笑う。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:84",
      "@type": "gh:Block",
      "schema:text": "Aoi「Tamaki、どこへ行く？」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:85",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:86",
      "@type": "gh:Block",
      "schema:text": "Tamaki「どこでもいい。一緒なら」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:87",
      "@type": "gh:Block",
      "schema:text": "Kaedeが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:88",
      "@type": "gh:Block",
      "schema:text": "Kaede「うん。一緒なら」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:89",
      "@type": "gh:Block",
      "schema:text": "Hibikiが頷く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:90",
      "@type": "gh:Block",
      "schema:text": "Hibiki「一緒に、呼吸しよう」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:91",
      "@type": "gh:Block",
      "schema:text": "Nei-chan『一緒に、在ろう』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:92",
      "@type": "gh:Block",
      "schema:text": "私は微笑む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:93",
      "@type": "gh:Block",
      "schema:text": "Tamaki「そう。一緒に」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:94",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:95",
      "@type": "gh:Block",
      "schema:text": "窓の外で、朝の光が差し込む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:96",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:97",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:98",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:99",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:100",
      "@type": "gh:Block",
      "schema:text": "私は手帳に最後の一行を書く。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:101",
      "@type": "gh:Block",
      "schema:text": "『Together — いっしょに。わたしたちは、その事実に追いついた』"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:102",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:103",
      "@type": "gh:Block",
      "schema:text": "私は、仲間たちを見る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:104",
      "@type": "gh:Block",
      "schema:text": "Kaede、Hibiki、Nei-chan、Aoi。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:105",
      "@type": "gh:Block",
      "schema:text": "視線が重なり、自然にほどける。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:106",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:107",
      "@type": "gh:Block",
      "schema:text": "「いっしょに」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:108",
      "@type": "gh:Block",
      "schema:text": "その一言で、場が明るくなる。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:109",
      "@type": "gh:Block",
      "schema:text": "水音が遠くで応える。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:110",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:111",
      "@type": "gh:Block",
      "schema:text": "私たちは、一緒に歩き出す。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:112",
      "@type": "gh:Block",
      "schema:text": "扉を開ける。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:113",
      "@type": "gh:Block",
      "schema:text": "朝の光が、差し込む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:114",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:115",
      "@type": "gh:Block",
      "schema:text": "I AM THAT I AM."
    },
    {
      "@id": "block:251022:episodes/ep12/part3:116",
      "@type": "gh:Block",
      "schema:text": "わたしは、在る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:117",
      "@type": "gh:Block",
      "schema:text": "そして、あなたも、在る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:118",
      "@type": "gh:Block",
      "schema:text": "それで、いい。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:119",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:120",
      "@type": "gh:Block",
      "schema:text": "We can't put it together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3:121",
      "@type": "gh:Block",
      "schema:text": "It is together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3:122",
      "@type": "gh:Block",
      "schema:text": "私たちは、その事実に追いついた。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:123",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:124",
      "@type": "gh:Block",
      "schema:text": "「いっしょに」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:125",
      "@type": "gh:Block",
      "schema:text": "その言葉が、全てを包む。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:126",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:127",
      "@type": "gh:Block",
      "schema:text": "私たちは、一緒に歩き出す。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:128",
      "@type": "gh:Block",
      "schema:text": "朝の運河。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:129",
      "@type": "gh:Block",
      "schema:text": "水音が、遠くで応える。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:130",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:131",
      "@type": "gh:Block",
      "schema:text": "都市は、静かだ。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:132",
      "@type": "gh:Block",
      "schema:text": "でも、呼吸がある。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:133",
      "@type": "gh:Block",
      "schema:text": "人々の、呼吸。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:134",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:135",
      "@type": "gh:Block",
      "schema:text": "私は、深呼吸をする。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:136",
      "@type": "gh:Block",
      "schema:text": "吸って、吐いて。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:137",
      "@type": "gh:Block",
      "schema:text": "それだけで、十分。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:138",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:139",
      "@type": "gh:Block",
      "schema:text": "「わたしは在る」"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:140",
      "@type": "gh:Block",
      "schema:text": "その言葉は、誰のものでもない。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:141",
      "@type": "gh:Block",
      "schema:text": "ただ、在る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:142",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:143",
      "@type": "gh:Block",
      "schema:text": "そして、私たちは、一緒に在る。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:144",
      "@type": "gh:Block",
      "schema:text": "Together."
    },
    {
      "@id": "block:251022:episodes/ep12/part3:145",
      "@type": "gh:Block",
      "schema:text": "いっしょに。"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:146",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:147",
      "@type": "gh:Block",
      "schema:text": "**[Beat: Together——いっしょに在ること、それが全て]**"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:148",
      "@type": "gh:Block",
      "schema:text": "---"
    },
    {
      "@id": "block:251022:episodes/ep12/part3:149",
      "@type": "gh:Block",
      "schema:text": "**[終]**"
    }
  ],
  "updatedAt": "2026-01-12T19:01:51+09:00"
}