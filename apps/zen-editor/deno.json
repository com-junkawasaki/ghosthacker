{
  "tasks": {
    "dev": "concurrently \"vite dev\" \"cd backend && go run cmd/server/main.go\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "tauri": "tauri",
    "test:unit": "vitest",
    "test:e2e": "deno task bddgen && playwright test",
    "bddgen": "bddgen"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "types": ["@webgpu/types"]
  }
}

