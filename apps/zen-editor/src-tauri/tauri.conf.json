{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Hacker Zen Editor",
  "version": "0.0.1",
  "identifier": "ai.gftd.ghosthacker.zeneditor",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost Hacker Zen Editor",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/backend-server-*"
    ]
  }
}
