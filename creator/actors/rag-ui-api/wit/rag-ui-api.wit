package wasmcloud:rag-ui-api@0.1.0;

world rag-ui-api {
    // HTTP Server - export incoming handler
    export wasi:http/incoming-handler@0.2.0;
    
    // HTTP Client - for calling OpenAI API and other external services
    import wasi:http/outgoing-handler@0.2.0;
    
    // Postgres - for IR data storage and retrieval
    import wasmcloud:postgres/query@0.1.0-draft;
}

