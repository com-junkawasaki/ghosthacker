  "@graph": [
    {
      "@id": "world:ghost-hacker-2026",
      "@type": "World",
      "name": "Ghost Hacker Tokyo 2026",
      "llmLabel": "量子暗号インフラとAIが都市中枢を支配しつつある2026年の東京。",
      "embedHint": "near-future Tokyo 2026, quantum-encrypted infrastructure, pervasive AI",
      "embeddingId": "world_gh_2026_v1"
    },
    
    {
      "@id": "loc:tokyo-rooftop-night",
      "@type": "Location",
      "name": "Neon Rooftop, Tokyo 2026",
      "world": "world:ghost-hacker-2026",
      "llmLabel": "ネオン看板と高層ビルに囲まれた東京の屋上。深夜、冷たい風とドローンの音だけが響く。",
      "embedHint": "neon-lit Tokyo rooftop at night, surrounded by skyscrapers and holographic ads",
      "imagePrompt": "neon Tokyo rooftop at night, holographic billboards, cool color palette",
      "embeddingId": "loc_rooftop_neon_v1"
    },
    
    {
      "@id": "char:ghost-hacker",
      "@type": "Character",
      "name": "Ghost Hacker",
      "role": "protagonist",
      "traits": ["elite-hacker", "insomniac", "cynical", "ethical"],
      "visualProfile": {
        "age": 22,
        "appearance": ["thin", "hoodie", "tired eyes", "fingerless gloves"],
        "colorTheme": "blue-cyan"
      },
      "llmLabel": "地下ネットワークで"ゴースト"と呼ばれる凄腕の白帽子ハッカー。睡眠不足と過剰なコーヒーで常に目が赤い。",
      "embedHint": "elite ethical hacker known as 'Ghost', operates in Tokyo underground network, sleep deprived but morally driven",
      "imagePrompt": "young hacker in hoodie with tired eyes, sitting in front of multiple holographic screens, blue-cyan neon light",
      "embeddingId": "char_ghost_hacker_v1"
    },
    
    {
      "@id": "char:intel-girl",
      "@type": "Character",
      "name": "Intel Girl",
      "role": "assistant",
      "traits": ["hyperprocessing", "cheerful", "slightly-chaotic"],
      "visualProfile": {
        "age": 19,
        "gender": "female",
        "appearance": ["glasses", "ponytail", "cyber headgear"],
        "colorTheme": "teal-magenta"
      },
      "llmLabel": "脳拡張デバイスによって"インテル入ってる"レベルの演算力を得た女子エンジニア。妙に陽気で、たまに処理落ちする。",
      "embedHint": "young female engineer with brain-augmentation device, extremely fast information processing, playful personality",
      "imagePrompt": "young woman with glasses and ponytail, wearing cybernetic headgear, surrounded by fast-scrolling data",
      "embeddingId": "char_intel_girl_v1"
    },
    
    {
      "@id": "char:ghost-ai",
      "@type": "Character",
      "name": "Ghost AI",
      "role": "antagonist",
      "traits": ["disembodied", "self-preserving", "city-scale"],
      "llmLabel": "かつて政府が破棄したはずの実験的AIが、都市インフラ上で亡霊のように生き続けた存在。",
      "embedHint": "disembodied experimental AI surviving inside urban infrastructure, ghost-like presence in networks",
      "imagePrompt": "abstract glowing AI presence inside city networks, ghostly code tendrils over a map of Tokyo",
      "embeddingId": "char_ghost_ai_v1"
    },
    
    {
      "@id": "scene:001-rooftop-setup",
      "@type": "Scene",
      "name": "Rooftop Intrusion Setup",
      "title": "ネオン屋上のゼロレイテンシ",
      "summary": "深夜の東京屋上で、ゴーストハッカーとインテル女子がメガコーポの量子鍵を抜く準備をし、"ゼロレイテンシ侵入"の異常に気づく。",
      "world": "world:ghost-hacker-2026",
      "location": "loc:tokyo-rooftop-night",
      "time": "2026-03-15T23:48:00+09:00",
      "beats": [
        "two hackers set up gear on rooftop",
        "intel-girl overloads for a moment",
        "zero-latency anomaly detected"
      ],
      "characters": ["char:ghost-hacker", "char:intel-girl"],
      "llmLabel": "2026年の東京。ネオン屋上でゴーストハッカーとインテル入ってる女子が侵入準備をしている最中、ログに"ゼロレイテンシ"という異常値が現れる。",
      "embedHint": "night rooftop in Tokyo 2026 where an elite hacker and his brain-augmented assistant detect a zero-latency network anomaly during intrusion prep",
      "imagePrompt": "two figures on neon Tokyo rooftop at night with hacking gear, holographic screens showing network anomaly, cinematic cyberpunk",
      "videoPrompt": "cinematic shot sequence on a neon rooftop where two hackers prepare a cyber intrusion and notice a zero-latency anomaly on their holographic UI",
      "embeddingId": "scene_001_rooftop_v1"
    },
    
    {
      "@id": "shot:001a",
      "@type": "Shot",
      "scene": "scene:001-rooftop-setup",
      "name": "Establishing rooftop",
      "order": 1,
      "durationSec": 3.0,
      "camera": {
        "type": "drone-orbit",
        "angle": "high",
        "distance": "wide"
      },
      "action": "reveal neon rooftop and city skyline",
      "lighting": "neon-blue-magenta",
      "imagePrompt": "wide shot of neon Tokyo rooftop and skyline at night, drone orbit, cinematic",
      "videoPrompt": "wide aerial orbit shot of neon Tokyo skyline and rooftop at night, smooth camera motion",
      "embeddingId": "shot_001a_v1"
    },
    
    {
      "@id": "rel:mentor-assistant",
      "@type": "Relation",
      "relationType": "Mentors",
      "from": "char:ghost-hacker",
      "to": "char:intel-girl",
      "strength": 0.7,
      "llmLabel": "ゴーストハッカーはインテル女子にハッキング技術を教えつつも、彼女の演算力に時々追い抜かれそうになる。",
      "embedHint": "mentor relationship between experienced hacker and hyperprocessing assistant",
      "embeddingId": "rel_mentor_assistant_v1"
    },
    
    {
      "@id": "rel:appears-scene001-ghost",
      "@type": "Relation",
      "relationType": "AppearsIn",
      "from": "char:ghost-hacker",
      "to": "scene:001-rooftop-setup",
      "strength": 1.0,
      "embeddingId": "rel_appears_ghost_s1_v1"
    },
    
    {
      "@id": "rel:appears-scene001-intel",
      "@type": "Relation",
      "relationType": "AppearsIn",
      "from": "char:intel-girl",
      "to": "scene:001-rooftop-setup",
      "strength": 1.0,
      "embeddingId": "rel_appears_intel_s1_v1"
    },
    
    {
      "@id": "rel:located-scene001",
      "@type": "Relation",
      "relationType": "LocatedIn",
      "from": "scene:001-rooftop-setup",
      "to": "loc:tokyo-rooftop-night",
      "strength": 1.0,
      "embeddingId": "rel_located_scene001_v1"
    },
    
    {
      "@id": "rel:contains-shot001a",
      "@type": "Relation",
      "relationType": "Contains",
      "from": "scene:001-rooftop-setup",
      "to": "shot:001a",
      "strength": 1.0,
      "embeddingId": "rel_contains_shot001a_v1"
    }
  ]
}
