{
  "@context": {
    "@base": "https://ghosthacker.gftd.co.jp/",
    "@vocab": "https://ghosthacker.gftd.co.jp/ontology#",
    "gh": "https://ghosthacker.gftd.co.jp/ontology#",
    "schema": "http://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",
    "dodaf": "http://www.dod.mil/dodaf/dm2#",
    
    "name": "schema:name",
    "description": "schema:description",
    "createdAt": { "@id": "prov:generatedAtTime", "@type": "xsd:dateTime" },
    "updatedAt": { "@id": "prov:wasModifiedAt", "@type": "xsd:dateTime" },
    
    "Capability": "dodaf:Capability",
    "hasActivity": { "@id": "dodaf:hasActivity", "@type": "@id" },
    "requiresResource": { "@id": "dodaf:requiresResource", "@type": "@id" },
    "performedBy": { "@id": "dodaf:performedBy", "@type": "@id" },
    "capabilityType": { "@id": "dodaf:capabilityType", "@type": "xsd:string" },
    "businessFunction": { "@id": "dodaf:businessFunction", "@type": "xsd:string" },
    "resourceObject": { "@id": "dodaf:resourceObject", "@type": "xsd:string" },
    "verb": { "@id": "dodaf:verb", "@type": "xsd:string" }
  },
  "@graph": [
    {
      "@id": "capability:story-management",
      "@type": "Capability",
      "name": "Story Management Capability",
      "description": "プロジェクト、ナラティブ、キャラクター、バックストーリー、エピソード、スタイル、プラットフォームの管理機能を提供する",
      "capabilityType": "Business",
      "businessFunction": "Story Content Management",
      "resourceObject": "Project, Narrative, Character, Backstory, Episode, Style, Platform",
      "verb": "Manage",
      "hasActivity": [
        { "@id": "activity:create-project" },
        { "@id": "activity:update-project" },
        { "@id": "activity:get-project" },
        { "@id": "activity:save-narrative" },
        { "@id": "activity:get-narrative" },
        { "@id": "activity:save-characters" },
        { "@id": "activity:get-characters" },
        { "@id": "activity:save-backstories" },
        { "@id": "activity:get-backstories" },
        { "@id": "activity:save-episodes" },
        { "@id": "activity:get-episodes" },
        { "@id": "activity:save-styles" },
        { "@id": "activity:get-styles" },
        { "@id": "activity:save-platforms" },
        { "@id": "activity:get-platforms" }
      ],
      "requiresResource": [
        { "@id": "resource:supabase-database" }
      ],
      "performedBy": { "@id": "service:graphql-story-service" },
      "createdAt": "2025-01-27T00:00:00Z",
      "updatedAt": "2025-01-27T00:00:00Z"
    },
    {
      "@id": "capability:canvas-management",
      "@type": "Capability",
      "name": "Canvas Management Capability",
      "description": "キャンバス設定とストーリーグラフの管理機能を提供する",
      "capabilityType": "Business",
      "businessFunction": "Canvas Configuration Management",
      "resourceObject": "Canvas, StoryGraph",
      "verb": "Manage",
      "hasActivity": [
        { "@id": "activity:get-canvas" },
        { "@id": "activity:save-canvas" },
        { "@id": "activity:get-story-graph" },
        { "@id": "activity:seed-canvas" }
      ],
      "requiresResource": [
        { "@id": "resource:supabase-database" },
        { "@id": "resource:neo4j-graph" }
      ],
      "performedBy": { "@id": "service:graphql-canvas-service" },
      "createdAt": "2025-01-27T00:00:00Z",
      "updatedAt": "2025-01-27T00:00:00Z"
    },
    {
      "@id": "capability:pipeline-execution",
      "@type": "Capability",
      "name": "Pipeline Execution Capability",
      "description": "パイプライン実行とトポロジー管理機能を提供する",
      "capabilityType": "Technical",
      "businessFunction": "Pipeline Orchestration",
      "resourceObject": "Pipeline, PipelineNode, PipelineExecution",
      "verb": "Execute",
      "hasActivity": [
        { "@id": "activity:run-pipeline" },
        { "@id": "activity:get-pipeline-topology" }
      ],
      "requiresResource": [
        { "@id": "resource:supabase-database" },
        { "@id": "resource:pipeline-storage" }
      ],
      "performedBy": { "@id": "service:graphql-pipeline-service" },
      "createdAt": "2025-01-27T00:00:00Z",
      "updatedAt": "2025-01-27T00:00:00Z"
    },
    {
      "@id": "resource:supabase-database",
      "@type": "dodaf:Resource",
      "name": "Supabase PostgreSQL Database",
      "description": "Supabase PostgreSQL データベースリソース",
      "resourceType": "Database"
    },
    {
      "@id": "resource:neo4j-graph",
      "@type": "dodaf:Resource",
      "name": "Neo4j Graph Database",
      "description": "Neo4j グラフデータベースリソース（ストーリーグラフ用）",
      "resourceType": "GraphDatabase"
    },
    {
      "@id": "resource:pipeline-storage",
      "@type": "dodaf:Resource",
      "name": "Pipeline Storage",
      "description": "パイプライン設定と実行履歴のストレージ",
      "resourceType": "Storage"
    },
    {
      "@id": "service:graphql-story-service",
      "@type": "dodaf:Service",
      "name": "GraphQL Story Management Service",
      "description": "Story Management を提供する GraphQL サービス",
      "serviceType": "GraphQL",
      "endpoint": "https://graphql.story.gftd.ai/graphql"
    },
    {
      "@id": "service:graphql-canvas-service",
      "@type": "dodaf:Service",
      "name": "GraphQL Canvas Management Service",
      "description": "Canvas Management を提供する GraphQL サービス",
      "serviceType": "GraphQL",
      "endpoint": "https://graphql.canvas.gftd.ai/graphql"
    },
    {
      "@id": "service:graphql-pipeline-service",
      "@type": "dodaf:Service",
      "name": "GraphQL Pipeline Execution Service",
      "description": "Pipeline Execution を提供する GraphQL サービス",
      "serviceType": "GraphQL",
      "endpoint": "https://graphql.pipeline.gftd.ai/graphql"
    }
  ]
}

