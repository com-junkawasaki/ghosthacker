FROM rust:latest

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Cargo files
COPY Cargo.toml ./
COPY Cargo.lock* ./

# Copy source code
COPY src ./src
COPY diesel.toml ./

# Build dependencies first (for better caching)
RUN cargo build || true

EXPOSE 8080

# For development, run directly (hot reload can be handled by host with file watching)
CMD ["cargo", "run"]

