@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gh: <https://ghosthacker.gftd.co.jp/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Canvas Shape
gh:CanvasShape
    a sh:NodeShape ;
    sh:targetClass gh:Canvas ;
    sh:property [
        sh:path gh:has_node ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path gh:has_edge ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
    ] .

# CanvasNode Shape
gh:CanvasNodeShape
    a sh:NodeShape ;
    sh:targetClass gh:CanvasNode ;
    sh:property [
        sh:path gh:node_type ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:node_label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:position_x ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:position_y ;
        sh:datatype xsd:decimal ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:config ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:data ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

# PipelineNode Shape
gh:PipelineNodeShape
    a sh:NodeShape ;
    sh:targetClass gh:PipelineNode ;
    sh:node gh:CanvasNodeShape ;
    sh:property [
        sh:path gh:route ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:depends_on ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
    ] .

# CharacterNode Shape
gh:CharacterNodeShape
    a sh:NodeShape ;
    sh:targetClass gh:CharacterNode ;
    sh:node gh:CanvasNodeShape ;
    sh:property [
        sh:path gh:has_character ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:context ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

# EpisodeNode Shape
gh:EpisodeNodeShape
    a sh:NodeShape ;
    sh:targetClass gh:EpisodeNode ;
    sh:node gh:CanvasNodeShape ;
    sh:property [
        sh:path gh:has_episode ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:content ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

# CanvasEdge Shape
gh:CanvasEdgeShape
    a sh:NodeShape ;
    sh:targetClass gh:CanvasEdge ;
    sh:property [
        sh:path gh:source ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:target ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:edge_type ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:edge_label ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

