FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# プロジェクト全体をコピー
COPY . .

# content-creatorディレクトリに移動して依存関係をインストール
WORKDIR /app/performers/actors/content-creator

ENV CI=true
RUN pnpm install --no-frozen-lockfile

EXPOSE 3000

# Entrypoint script to ensure node_modules exists after volume mount
RUN echo '#!/bin/sh' > /usr/local/bin/entrypoint.sh && \
    echo 'cd /app/performers/actors/content-creator' >> /usr/local/bin/entrypoint.sh && \
    echo 'if [ ! -f "node_modules/.bin/next" ]; then' >> /usr/local/bin/entrypoint.sh && \
    echo '  echo "Installing dependencies..."' >> /usr/local/bin/entrypoint.sh && \
    echo '  pnpm install --no-frozen-lockfile' >> /usr/local/bin/entrypoint.sh && \
    echo 'fi' >> /usr/local/bin/entrypoint.sh && \
    echo 'exec sh node_modules/.bin/next dev' >> /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

CMD ["/usr/local/bin/entrypoint.sh"]

