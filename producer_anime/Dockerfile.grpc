FROM alpine:latest

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

# ローカルでビルドしたバイナリをコピー（開発用）
# 注意: 本番環境では、マルチステージビルドを使用してビルドすることを推奨
COPY performers/services/grpc/target/release/producerv2-grpc /app/producerv2-grpc

# マイグレーションファイルをコピー
COPY performers/services/graphql/migrations ./migrations

EXPOSE 50051

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD nc -z localhost 50051 || exit 1

CMD ["/app/producerv2-grpc"]
