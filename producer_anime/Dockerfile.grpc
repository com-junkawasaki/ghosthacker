FROM rustlang/rust:nightly-alpine AS builder

WORKDIR /app

# ビルドに必要な依存関係をインストール
RUN apk add --no-cache musl-dev openssl-dev protobuf-dev

    # gRPC-Webサービス（依存関係）をコピー
    COPY performers/services/grpc-web/ ./performers/services/grpc-web/

# gRPCサービスをコピー
COPY performers/services/grpc/ ./performers/services/grpc/

WORKDIR /app/performers/services/grpc

# ビルド
RUN cargo build --release

# ランタイムイメージ
FROM alpine:latest

RUN apk add --no-cache ca-certificates curl netcat-openbsd

WORKDIR /app

# ビルドしたバイナリをコピー
COPY --from=builder /app/performers/services/grpc/target/release/producerv2-grpc /app/producerv2-grpc

# マイグレーションファイルをコピー
COPY performers/services/grpc-web/migrations ./migrations

EXPOSE 50051

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD nc -z localhost 50051 || exit 1

CMD ["/app/producerv2-grpc"]
