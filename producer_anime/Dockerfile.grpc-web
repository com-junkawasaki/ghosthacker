FROM rustlang/rust:nightly-alpine AS builder

WORKDIR /app

# ビルドに必要な依存関係をインストール
RUN apk add --no-cache musl-dev openssl-dev

# rustupの自動更新を無効化（Dockerビルド時のエラーを防ぐ）
ENV RUSTUP_UPDATE_ROOT=""
ENV RUSTUP_DIST_SERVER=""

# gRPC-Webサービスディレクトリをコピー
COPY performers/services/grpc-web/ ./performers/services/grpc-web/

WORKDIR /app/performers/services/grpc-web

# rust-toolchain.tomlと.cargo/config.tomlを削除してrustupの自動更新を防ぐ（Dockerビルド時のエラー回避）
RUN rm -f rust-toolchain.toml .cargo/config.toml || true

# ビルド
RUN cargo build --release

# ランタイムイメージ
FROM alpine:latest

RUN apk add --no-cache ca-certificates curl

WORKDIR /app

# ビルドしたバイナリをコピー
COPY --from=builder /app/performers/services/grpc-web/target/release/producerv2-grpc-web /app/producerv2-grpc-web

# マイグレーションファイルをコピー
COPY performers/services/grpc-web/migrations ./migrations

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["/app/producerv2-grpc-web"]

