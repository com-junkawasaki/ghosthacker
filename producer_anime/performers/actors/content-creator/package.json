{
  "name": "@gftdcojp/content-creator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm codegen:grpc || true",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.yaml && pnpm codegen:grpc",
    "codegen:watch": "graphql-codegen --config codegen.yaml --watch",
    "codegen:grpc": "node scripts/generate-grpc-protobuf-ts.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.10",
    "@hookform/resolvers": "^3.9.0",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@tiptap/core": "^3.11.1",
    "@tiptap/extension-character-count": "^2.1.13",
    "@tiptap/extension-placeholder": "^2.1.13",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "jose": "^5.9.6",
    "nanoid": "^5.0.7",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "reactflow": "11.11.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typed-document-node": "^4.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.0",
    "@protobuf-ts/plugin": "^2.11.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "grpc-web": "^1.5.0",
    "msw": "^2.0.0",
    "postcss": "^8.4.35",
    "protoc-gen-ts": "^0.8.7",
    "tailwindcss": "^3.4.1",
    "ts-proto": "^2.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.0.0"
  }
}
