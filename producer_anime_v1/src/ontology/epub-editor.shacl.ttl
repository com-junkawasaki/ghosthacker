@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gh: <https://ghosthacker.gftd.co.jp/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# EpubEditorSettings Shape
gh:EpubEditorSettingsShape
    a sh:NodeShape ;
    sh:targetClass gh:EpubEditorSettings ;
    sh:property [
        sh:path gh:fontFamily ;
        sh:datatype xsd:string ;
        sh:in ("serif" "sans-serif" "monospace") ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:fontSize ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+(px|em|rem)$" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:lineHeight ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1.0 ;
        sh:maxInclusive 3.0 ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:letterSpacing ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9.]+(em|px)$" ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:pageWidth ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+(px|em|rem)$" ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:pageHeight ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+(px|em|rem)$" ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:textColor ;
        sh:datatype xsd:string ;
        sh:pattern "^#[0-9A-Fa-f]{6}$" ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:backgroundColor ;
        sh:datatype xsd:string ;
        sh:pattern "^#[0-9A-Fa-f]{6}$" ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

# EpubDocument Shape
gh:EpubDocumentShape
    a sh:NodeShape ;
    sh:targetClass gh:EpubDocument ;
    sh:property [
        sh:path gh:hasChapter ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path schema:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# EpubChapter Shape
gh:EpubChapterShape
    a sh:NodeShape ;
    sh:targetClass gh:EpubChapter ;
    sh:property [
        sh:path schema:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:hasParagraph ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path gh:hasImage ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path gh:hasDialogue ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
    ] .

# EpubParagraph Shape
gh:EpubParagraphShape
    a sh:NodeShape ;
    sh:targetClass gh:EpubParagraph ;
    sh:property [
        sh:path gh:content ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# EpubImage Shape
gh:EpubImageShape
    a sh:NodeShape ;
    sh:targetClass gh:EpubImage ;
    sh:property [
        sh:path gh:imageUrl ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path schema:title ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

# EpubDialogue Shape
gh:EpubDialogueShape
    a sh:NodeShape ;
    sh:targetClass gh:EpubDialogue ;
    sh:property [
        sh:path gh:speaker ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path gh:dialogueText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

