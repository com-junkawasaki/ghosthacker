{
  "@context": {
    "@base": "https://ghosthacker.gftd.co.jp/",
    "@vocab": "https://ghosthacker.gftd.co.jp/ontology#",
    "gh": "https://ghosthacker.gftd.co.jp/ontology#",
    "schema": "http://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "prov": "http://www.w3.org/ns/prov#",

    "name": "schema:name",
    "title": "schema:title",
    "description": "schema:description",

    "has_node": { "@id": "gh:has_node", "@type": "@id" },
    "depends_on": { "@id": "gh:depends_on", "@type": "@id" },
    "executes_after": { "@id": "gh:executes_after", "@type": "@id" },
    "has_output": { "@id": "gh:has_output", "@type": "@id" },
    "requires_resource": { "@id": "gh:requires_resource", "@type": "@id" },

    "node_type": { "@id": "gh:node_type", "@type": "xsd:string" },
    "node_label": { "@id": "gh:node_label", "@type": "xsd:string" },
    "execution_order": { "@id": "gh:execution_order", "@type": "xsd:integer" },
    "cpu_requirement": { "@id": "gh:cpu_requirement", "@type": "xsd:decimal" },
    "memory_requirement": { "@id": "gh:memory_requirement", "@type": "xsd:string" },
    "timeout_duration": { "@id": "gh:timeout_duration", "@type": "xsd:string" },

    "output_format": { "@id": "gh:output_format", "@type": "xsd:string" },
    "output_platform": { "@id": "gh:output_platform", "@type": "xsd:string" },
    "output_quality": { "@id": "gh:output_quality", "@type": "xsd:string" },

    "route": { "@id": "gh:route", "@type": "xsd:string" },
    "config": { "@id": "gh:config", "@type": "@json" },
    "outputs": { "@id": "gh:outputs", "@type": "@json" },

    "prov:generatedAtTime": { "@type": "xsd:dateTime" },
    "prov:wasAssociatedWith": { "@type": "@id" },
    "prov:used": { "@type": "@id" }
  },
  "@graph": [
    {
      "@id": "pipeline:ghost-hacker-producer",
      "@type": "gh:Pipeline",
      "name": "Ghost Hacker Producer Pipeline",
      "description": "Merkle DAG pipeline for Ghost Hacker content production",
      "has_node": [
        { "@id": "node:lore-protagonist" },
        { "@id": "node:lore-backstory" },
        { "@id": "node:lore-world" },
        { "@id": "node:narrative-structure" },
        { "@id": "node:story-graph-ep1" },
        { "@id": "node:prompt-story" },
        { "@id": "node:writer-content" },
        { "@id": "node:image-gen" },
        { "@id": "node:webtoon-panel-gen" },
        { "@id": "node:webtoon-layout" },
        { "@id": "node:webtoon-export" },
        { "@id": "node:tts-narration" },
        { "@id": "node:video-gen" },
        { "@id": "node:render-video" },
        { "@id": "node:export-wattpad" },
        { "@id": "node:publish-youtube" }
      ]
    },

    {
      "@id": "node:lore-protagonist",
      "@type": "gh:PipelineNode",
      "node_type": "Protagonist",
      "node_label": "Protagonist",
      "route": "/canvas/lore/protagonist",
      "config": {
        "name": "Akito",
        "role": "Hacker",
        "traits": "Stoic, Empathic"
      },
      "outputs": ["name", "role", "traits"],
      "execution_order": 1
    },

    {
      "@id": "node:lore-backstory",
      "@type": "gh:PipelineNode",
      "node_type": "Backstory",
      "node_label": "Backstory",
      "route": "/canvas/lore/backstory",
      "config": {
        "origin": "Tokyo underground",
        "motivation": "Find lost sister",
        "conflict": "Corporate AI"
      },
      "outputs": ["origin", "motivation", "conflict"],
      "execution_order": 2
    },

    {
      "@id": "node:lore-world",
      "@type": "gh:PipelineNode",
      "node_type": "World",
      "node_label": "World",
      "route": "/canvas/lore/world",
      "config": {
        "setting": "Near-future Tokyo",
        "era": "2042",
        "rules": "Ghost-net protocols"
      },
      "outputs": ["setting", "era", "rules"],
      "execution_order": 3
    },

    {
      "@id": "node:narrative-structure",
      "@type": "gh:PipelineNode",
      "node_type": "Narrative",
      "node_label": "Narrative Structure",
      "route": "/canvas/story",
      "config": {
        "synopsis": "A ghost hacker helps clients integrate their digital ghosts, blending episodic healing with a larger mystery surrounding the Tree of Life.",
        "structure": "Hybrid: Linear Episodic + Archipelago Arc",
        "beats": [
          { "id": "beat-01", "label": "Session Start", "purpose": "setup", "targetLength": 200 },
          { "id": "beat-02", "label": "Ghost Encounter", "purpose": "conflict", "targetLength": 800 },
          { "id": "beat-03", "label": "Integration & Catharsis", "purpose": "climax", "targetLength": 400 }
        ]
      },
      "outputs": ["synopsis", "structure", "beats"],
      "execution_order": 4
    },

    {
      "@id": "node:story-graph-ep1",
      "@type": "gh:PipelineNode",
      "node_type": "StoryGraph",
      "node_label": "Episode 1 Story Graph",
      "route": "/canvas/story",
      "config": {
        "episodeId": "gh:Episode:Ghost-Hacker-Episode-01"
      },
      "outputs": ["graphData"],
      "execution_order": 5
    },

    {
      "@id": "node:prompt-story",
      "@type": "gh:PipelineNode",
      "node_type": "Prompt",
      "node_label": "Story Prompt",
      "depends_on": [
        { "@id": "node:story-graph-ep1" },
        { "@id": "node:lore-protagonist" },
        { "@id": "node:lore-backstory" },
        { "@id": "node:lore-world" },
        { "@id": "node:narrative-structure" }
      ],
      "route": "/canvas/prompt-story",
      "config": {
        "promptType": "story",
        "style": "atmospheric",
        "genre": "ghost-horror"
      },
      "outputs": ["prompt"],
      "execution_order": 6
    },

    {
      "@id": "node:writer-content",
      "@type": "gh:PipelineNode",
      "node_type": "Writer",
      "node_label": "Content Writer",
      "depends_on": [{ "@id": "node:prompt-story" }],
      "route": "/canvas/writer-content",
      "config": {
        "model": "gpt-4o-mini",
        "maxTokens": 2000,
        "temperature": 0.7
      },
      "outputs": ["script", "metadata"],
      "execution_order": 7
    },

    {
      "@id": "node:image-gen",
      "@type": "gh:PipelineNode",
      "node_type": "ImageGen",
      "node_label": "Scene Images",
      "depends_on": [
        { "@id": "node:writer-content" },
        { "@id": "node:lore-world" }
      ],
      "route": "/canvas/image-gen",
      "config": {
        "model": "flux-1.1-pro",
        "style": "atmospheric-horror",
        "count": 5
      },
      "outputs": ["images", "prompts"],
      "execution_order": 8
    },

    {
      "@id": "node:webtoon-panel-gen",
      "@type": "gh:PipelineNode",
      "node_type": "WebtoonPanelGen",
      "node_label": "Panel Generator",
      "depends_on": [{ "@id": "node:image-gen" }],
      "route": "/canvas/webtoon-panel-gen",
      "config": {
        "panelCount": 8,
        "style": "vertical-scroll",
        "aspectRatio": "9:16"
      },
      "outputs": ["panels", "panelData"],
      "execution_order": 9
    },

    {
      "@id": "node:webtoon-layout",
      "@type": "gh:PipelineNode",
      "node_type": "WebtoonLayout",
      "node_label": "Layout Designer",
      "depends_on": [{ "@id": "node:webtoon-panel-gen" }],
      "route": "/canvas/webtoon-layout",
      "config": {
        "layoutStyle": "korean-style",
        "textPosition": "overlay",
        "readingDirection": "vertical"
      },
      "outputs": ["layout", "layoutData"],
      "execution_order": 10
    },

    {
      "@id": "node:webtoon-export",
      "@type": "gh:PipelineNode",
      "node_type": "WebtoonExport",
      "node_label": "Webtoon Export",
      "depends_on": [{ "@id": "node:webtoon-layout" }],
      "route": "/canvas/webtoon-export",
      "config": {
        "format": "webp-sequence",
        "platform": "webtoon",
        "quality": "high"
      },
      "outputs": ["episode", "assets", "download_url"],
      "execution_order": 11
    },

    {
      "@id": "node:tts-narration",
      "@type": "gh:PipelineNode",
      "node_type": "TTS",
      "node_label": "Narration TTS",
      "depends_on": [{ "@id": "node:writer-content" }],
      "route": "/canvas/tts-narration",
      "config": {
        "voice": "alloy",
        "speed": 1.0,
        "format": "mp3"
      },
      "outputs": ["audio", "timestamps"],
      "execution_order": 12
    },

    {
      "@id": "node:video-gen",
      "@type": "gh:PipelineNode",
      "node_type": "VideoGen",
      "node_label": "Video Generation",
      "depends_on": [
        { "@id": "node:image-gen" },
        { "@id": "node:tts-narration" },
        { "@id": "node:writer-content" }
      ],
      "route": "/canvas/video-gen",
      "config": {
        "preferredRenderer": "sora",
        "resolution": "1080p",
        "duration": 300
      },
      "outputs": ["video", "script"],
      "execution_order": 13
    },

    {
      "@id": "node:render-video",
      "@type": "gh:PipelineNode",
      "node_type": "Render",
      "node_label": "Video Render",
      "depends_on": [{ "@id": "node:video-gen" }],
      "route": "/canvas/render-video",
      "config": {
        "renderer": "ffmpeg",
        "format": "mp4",
        "quality": "high"
      },
      "outputs": ["rendered_video", "thumbnails"],
      "execution_order": 14
    },

    {
      "@id": "node:export-wattpad",
      "@type": "gh:PipelineNode",
      "node_type": "ExportWattpad",
      "node_label": "Wattpad Package",
      "depends_on": [
        { "@id": "node:writer-content" },
        { "@id": "node:image-gen" }
      ],
      "route": "/canvas/export-wattpad",
      "config": {
        "format": "markdown",
        "includeImages": true,
        "includeMetadata": true
      },
      "outputs": ["wattpad_package", "download_url"],
      "execution_order": 15
    },

    {
      "@id": "node:publish-youtube",
      "@type": "gh:PipelineNode",
      "node_type": "PublishYouTube",
      "node_label": "YouTube Upload",
      "depends_on": [{ "@id": "node:render-video" }],
      "route": "/canvas/publish-youtube",
      "config": {
        "privacy": "unlisted",
        "title": "Ghost Hacker - Episode 1",
        "description": "Atmospheric ghost story adaptation",
        "tags": ["ghost", "horror", "supernatural"]
      },
      "outputs": ["youtube_id", "upload_url"],
      "execution_order": 16
    },

    {
      "@id": "resource:source-doc",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 0.1,
      "memory_requirement": "128MB",
      "timeout_duration": "5m"
    },

    {
      "@id": "resource:prompt",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 0.1,
      "memory_requirement": "256MB",
      "timeout_duration": "2m"
    },

    {
      "@id": "resource:writer",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 1,
      "memory_requirement": "1GB",
      "timeout_duration": "10m"
    },

    {
      "@id": "resource:image-gen",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 2,
      "memory_requirement": "2GB",
      "timeout_duration": "15m"
    },

    {
      "@id": "resource:webtoon-panel-gen",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 2,
      "memory_requirement": "2GB",
      "timeout_duration": "12m"
    },

    {
      "@id": "resource:webtoon-layout",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 1,
      "memory_requirement": "1GB",
      "timeout_duration": "8m"
    },

    {
      "@id": "resource:webtoon-export",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 1,
      "memory_requirement": "512MB",
      "timeout_duration": "5m"
    },

    {
      "@id": "resource:tts",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 1,
      "memory_requirement": "512MB",
      "timeout_duration": "8m"
    },

    {
      "@id": "resource:video-gen",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 4,
      "memory_requirement": "8GB",
      "timeout_duration": "30m"
    },

    {
      "@id": "resource:render",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 2,
      "memory_requirement": "4GB",
      "timeout_duration": "20m"
    },

    {
      "@id": "resource:export-wattpad",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 0.5,
      "memory_requirement": "256MB",
      "timeout_duration": "5m"
    },

    {
      "@id": "resource:publish-youtube",
      "@type": "gh:ResourceRequirement",
      "cpu_requirement": 0.5,
      "memory_requirement": "256MB",
      "timeout_duration": "10m"
    },

    {
      "@id": "output:webtoon",
      "@type": "gh:OutputSpecification",
      "output_format": "webp-sequence",
      "output_platform": "webtoon",
      "config": {
        "aspectRatio": "9:16",
        "episodeLength": "40-60 panels"
      }
    },

    {
      "@id": "output:wattpad",
      "@type": "gh:OutputSpecification",
      "output_format": "zip",
      "output_platform": "wattpad",
      "config": {
        "contents": ["story.md", "images/", "manifest.json"],
        "maxSize": "100MB"
      }
    },

    {
      "@id": "output:youtube",
      "@type": "gh:OutputSpecification",
      "output_format": "mp4",
      "output_platform": "youtube",
      "config": {
        "resolution": "1080p",
        "duration": "5m",
        "thumbnail": "required"
      }
    }
  ]
}
