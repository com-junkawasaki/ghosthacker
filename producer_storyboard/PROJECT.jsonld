      "@type": "FixAction",
      "name": "svelte-clerk-upgrade-and-auth-refactor",
      "description": "Upgrade svelte-clerk to v0.20.1 and refactor authentication to use withClerkHandler and buildClerkProps",
      "startTime": "2025-12-10T22:00:00Z",
      "endTime": "2025-12-11T00:00:00Z",
      "status": "Completed",
      "result": {
        "upgrades": {
          "svelte-clerk": "0.1.13 → 0.20.1"
        },
        "fixes": [
          "Fixed TypeError: locals.auth is not a function",
          "Fixed ERR_TOO_MANY_REDIRECTS loop",
          "Fixed SvelteKit 2.x cookie handling compatibility",
          "Removed custom verifyClerkSession in favor of locals.auth()",
          "Fixed buildClerkProps usage with initialState prop"
        ],
        "refactoring": {
          "hooks.server.ts": "Simplified to withClerkHandler()",
          "+layout.server.ts": "Use locals.auth() + buildClerkProps(auth)",
          "+layout.svelte": "Pass initialState to ClerkProvider",
          "sign-in/+page.server.ts": "Use locals.auth() + clerkClient",
          "[orgId]/+layout.server.ts": "Use locals.auth() + clerkClient"
        },
        "deprecation": {
          "function": "verifyClerkSession",
          "replacedBy": "locals.auth()"
        }
      }
    }
