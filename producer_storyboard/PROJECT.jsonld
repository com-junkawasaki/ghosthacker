        "Base64 data URL handling",
        "PostgreSQL BYTEA storage",
        "Image format detection from MIME types",
        "Comprehensive error handling"
      ]
    },
    {
      "@type": "Service",
      "name": "image-display",
      "description": "Secure serving of generated images from database via API",
      "status": "Operational"
    },
    {
      "@type": "Service",
      "name": "image-upload",
      "description": "Drag-and-drop image upload with BYTEA storage in PostgreSQL",
      "status": "Operational"
    },
    {
      "@type": "Service",
      "name": "request-timeout-management",
      "description": "Adaptive timeout handling for GraphQL requests (120s for image generation, 30s for others)",
      "status": "Operational"
    },
    {
      "@type": "Service",
      "name": "loading-state-ui",
      "description": "Visual feedback system for image generation progress with scene-specific overlays",
      "status": "Operational"
    },
    {
      "@type": "Service",
      "name": "multi-language-dialogue",
      "description": "Dialogue management with support for multiple languages (Japanese, English, Hindi) and auto-translation",
      "status": "Operational"
    },
    {
      "@type": "Service",
      "name": "voice-synthesis",
      "description": "Hume AI integration for generating character voices",
      "status": "Operational"
    },
    {
      "@type": "Service",
      "name": "storyboard-management",
      "description": "Multi-storyboard creation and management within projects with selection UI",
      "status": "Operational"
    }
  ],
  "configuration": {
    "frontend": {
      "framework": "SvelteKit",
      "styling": "Tailwind CSS",
      "state": "Houdini GraphQL + Svelte 5 Runes",
      "features": {
        "dragDrop": "HTML5 Drag and Drop API",
        "loadingStates": "Scene-specific loading overlays with spinner animations",
        "timeoutHandling": "Adaptive timeouts based on request type",
        "storyboardManagement": "Multi-storyboard creation and selection within projects"
      }
    },
    "backend": {
      "framework": "Rust (Poem + Async-GraphQL)",
      "database": "PostgreSQL (SQLx)",
      "ai": {
        "imageGeneration": "OpenRouter API (Flux 2 Pro)",
        "textGeneration": "OpenRouter API (GPT-4)",
        "voiceSynthesis": "Hume AI (TTS)"
      },
      "imageStorage": "PostgreSQL BYTEA",
      "mutations": {
        "createStoryboard": "Create new storyboard with project association and default settings"
      }
    },
    "infrastructure": {
      "containerization": "Docker Compose",
      "deployment": {
        "production": "Vercel",
        "adapter": "@sveltejs/adapter-vercel",
        "runtime": "nodejs20.x"
      },
      "ports": {
        "frontend": 5173,
        "backend": 8080,
        "database": 5432
      }
    }
  }
