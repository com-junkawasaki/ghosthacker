  "id": "https://gftd.ai/project/storyboard-editor",
  "type": "cpm:Project",
  "name": "Sora Storyboard Video Generator",
  "description": "Soraのストーリーボード機能を参考に、シーン単位で動画を生成・結合する動画生成サービス。Frontend: SvelteKit 2.x + Houdini 2.x, Backend: Rust (Tonic/gRPC) + PostgreSQL 16, AI: OpenAI API (動画生成)。ストーリーボード→動画生成のワークフローを実現。",
  "version": "0.1.0",
  "createdAt": "2025-01-30T00:00:00Z",
  "updatedAt": "2025-01-30T00:00:00Z",
  "status": "in_progress",
  "priority": "high",
  
  "goal": {
    "id": "https://gftd.ai/goal/storyboard-editor-wellbecoming",
    "type": "cpm:Goal",
    "name": "Enable users to create videos from storyboards with AI assistance",
    "description": "Users achieve well-becoming through intuitive video creation experience with AI-powered video generation from storyboards"
  },
  
  "hasCapability": [
    {"@id": "https://gftd.ai/capability/project-management"},
    {"@id": "https://gftd.ai/capability/storyboard-editing"},
    {"@id": "https://gftd.ai/capability/scene-management"},
    {"@id": "https://gftd.ai/capability/ai-video-generation"},
    {"@id": "https://gftd.ai/capability/video-composition"},
    {"@id": "https://gftd.ai/capability/timeline-editing"},
    {"@id": "https://gftd.ai/capability/video-preview"},
    {"@id": "https://gftd.ai/capability/grpc-backend"}
  ],
  
  "hasActivity": [
    {"@id": "https://gftd.ai/activity/create-storyboard-project"},
    {"@id": "https://gftd.ai/activity/list-storyboard-projects"},
    {"@id": "https://gftd.ai/activity/create-storyboard"},
    {"@id": "https://gftd.ai/activity/edit-storyboard"},
    {"@id": "https://gftd.ai/activity/manage-scenes"},
    {"@id": "https://gftd.ai/activity/generate-video"},
    {"@id": "https://gftd.ai/activity/edit-timeline"},
    {"@id": "https://gftd.ai/activity/preview-video"}
  ],
  
  "hasPerformer": [
    {
      "@id": "https://gftd.ai/performer/actor/storyboard-editor",
      "type": "cpm:Actor",
      "name": "Storyboard Editor Actor",
      "description": "Frontend actor providing storyboard editing UI"
    },
    {
      "@id": "https://gftd.ai/performer/service/grpc",
      "type": "cpm:Service",
      "name": "gRPC Service",
      "description": "Rust gRPC service (Tonic) providing storyboard data management and OpenAI video generation integration with gRPC-Web support (tonic-web) for browser compatibility"
    }
  ],
  
  "hasResource": [
    {"@id": "https://gftd.ai/resource/storyboard-project"},
    {"@id": "https://gftd.ai/resource/storyboard"},
    {"@id": "https://gftd.ai/resource/scene"},
    {"@id": "https://gftd.ai/resource/generated-video"},
    {"@id": "https://gftd.ai/resource/video-bytea-storage"}
  ],
  
  "dependsOn": [
    {"@id": "https://gftd.ai/dependency/postgresql"},
    {"@id": "https://gftd.ai/dependency/openai-api"}
  ]
}
