    {"@id": "https://gftd.ai/activity/preview-video"},
    {"@id": "https://gftd.ai/activity/save-operation-history"}
  ],
  
  "hasPerformer": [
    {
      "@id": "https://gftd.ai/performer/actor/storyboard-editor",
      "type": "cpm:Actor",
      "name": "Storyboard Editor Actor",
      "description": "Frontend actor providing storyboard editing UI"
    },
    {
      "@id": "https://gftd.ai/performer/service/graphql",
      "type": "cpm:Service",
      "name": "GraphQL Service",
      "description": "Rust GraphQL service (async-graphql/Poem) providing storyboard data management and OpenAI video generation integration with GraphQL API for browser compatibility"
    }
  ],
  
  "hasResource": [
    {"@id": "https://gftd.ai/resource/storyboard-project"},
    {"@id": "https://gftd.ai/resource/storyboard"},
    {"@id": "https://gftd.ai/resource/scene"},
    {"@id": "https://gftd.ai/resource/generated-video"},
