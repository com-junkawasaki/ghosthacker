        "accessibility": "ARIA attributes, keyboard navigation, focus management"
      }
    },
    "backend": {
      "framework": "Rust (Poem + Async-GraphQL)",
      "database": "PostgreSQL (SQLx)",
        "ai": {
          "imageGeneration": "OpenRouter API (Flux 2 Pro)",
          "textGeneration": "OpenRouter API (GPT-4)",
          "voiceSynthesis": "Hume AI (TTS)",
          "musicGeneration": "Suno AI API"
        },
      "imageStorage": "PostgreSQL BYTEA",
      "mutations": {
        "createStoryboard": "Create new storyboard with project association and default settings"
      },
      "schema": {
        "character": {
          "fields": ["personality", "background", "defaultHumeVoiceId", "profileImageId"],
          "complexFields": {
            "assets": "ComplexObject resolver for character assets"
          }
        },
        "composer": {
          "types": ["Composer", "AudioTrack", "AudioClip", "SunoMusic"],
          "queries": ["composers", "composer", "audioTracks", "audioClips", "sunoMusic"],
          "mutations": [
            "createComposer",
            "createAudioTrack",
            "createAudioClip",
            "updateAudioClip",
            "deleteAudioClip",
            "generateSunoMusic",
            "reorderAudioClips"
          ]
        }
      }
    },
    "infrastructure": {
      "containerization": "Docker Compose",
      "deployment": {
        "production": "Vercel",
        "adapter": "@sveltejs/adapter-vercel",
        "runtime": "nodejs20.x",
        "url": "https://ai-gftd-producer.vercel.app",
        "region": "iad1"
      },
      "ports": {
        "frontend": 5173,
        "backend": 8080,
        "database": 5432
      },
      "environment": {
        "vercelEnvPull": "Configured",
        "databaseUrl": "From Vercel environment variables"
      }
    },
    "authentication": {
      "provider": "Clerk",
      "frontend": {
        "sdk": "svelte-clerk@0.20.1",
        "components": [
          "ClerkProvider",
          "UserAccountMenu",
          "OrganizationSwitcher"
        ],
        "helpers": [
          "useClerkContext"
        ]
      },
      "backend": {
        "sdk": "svelte-clerk/server",
        "functions": [
          "withClerkHandler",
          "buildClerkProps",
          "clerkClient"
        ],
        "pattern": {
          "hooks.server.ts": "withClerkHandler()",
          "+layout.server.ts": "locals.auth() + buildClerkProps(auth)",
          "+layout.svelte": "ClerkProvider with initialState prop"
        }
      },
      "routing": {
        "pattern": "/[lang]/orgs/[orgId]/project/[viewNames]",
        "organizationScoped": true
      }
    },
    "composer": {
      "environmentVariables": [
        "SUNO_API_KEY",
        "SUNO_API_URL"
      ],
      "defaults": {
        "sunoApiUrl": "https://api.sunoapi.org"
      }
    }
