  "configuration": {
    "frontend": {
      "framework": "SvelteKit",
      "styling": "Tailwind CSS",
      "state": "Houdini GraphQL + Svelte 5 Runes",
      "features": {
        "dragDrop": "HTML5 Drag and Drop API",
        "loadingStates": "Scene-specific loading overlays with spinner animations",
        "timeoutHandling": "Adaptive timeouts based on request type",
        "storyboardManagement": "Multi-storyboard creation and selection within projects with URL-based routing",
        "characterManagement": "Character management with double confirmation for destructive actions"
      }
    },
    "backend": {
      "framework": "Rust (Poem + Async-GraphQL)",
      "database": "PostgreSQL (SQLx)",
      "ai": {
        "imageGeneration": "OpenRouter API (Flux 2 Pro)",
        "textGeneration": "OpenRouter API (GPT-4)",
        "voiceSynthesis": "Hume AI (TTS)"
      },
      "imageStorage": "PostgreSQL BYTEA",
      "mutations": {
        "createStoryboard": "Create new storyboard with project association and default settings"
      },
      "schema": {
        "character": {
          "fields": ["personality", "background", "defaultHumeVoiceId", "profileImageId"],
          "complexFields": {
            "assets": "ComplexObject resolver for character assets"
          }
        }
      }
    },
    "infrastructure": {
      "containerization": "Docker Compose",
      "deployment": {
        "production": "Vercel",
        "adapter": "@sveltejs/adapter-vercel",
        "runtime": "nodejs20.x",
        "url": "https://ai-gftd-producer.vercel.app",
        "region": "iad1"
      },
      "ports": {
        "frontend": 5173,
        "backend": 8080,
        "database": 5432
      },
      "environment": {
        "vercelEnvPull": "Configured",
        "databaseUrl": "From Vercel environment variables"
      }
    },
    "authentication": {
      "provider": "Clerk",
      "frontend": {
        "sdk": "svelte-clerk",
        "components": [
          "ClerkProvider",
          "UserAccountMenu",
          "OrganizationSwitcher"
        ]
      },
      "backend": {
        "sdk": "@clerk/backend",
        "functions": [
          "verifyClerkSession",
          "getUserOrganizations",
          "verifyOrgAccess"
        ]
      },
      "routing": {
        "pattern": "/[lang]/orgs/[orgId]/project/[viewNames]",
        "organizationScoped": true
      }
