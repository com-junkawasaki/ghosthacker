    {"@id": "https://gftd.ai/resource/image-bytea-storage"},
    {"@id": "https://gftd.ai/resource/operation-history"}
  ],
  
  "dependsOn": [
    {"@id": "https://gftd.ai/dependency/postgresql"},
    {"@id": "https://gftd.ai/dependency/openai-api"},
    {"@id": "https://gftd.ai/dependency/openai-dalle"},
    {"@id": "https://gftd.ai/dependency/openai-gpt4"}
  ],
  
  "configuration": [
    {
      "id": "https://gftd.ai/config/ui-implementation",
      "type": "cpm:Configuration",
      "name": "UI Implementation Status",
      "description": "Sora-style storyboard UI with scene management features",
      "status": "completed",
      "details": {
        "sceneManagement": {
          "addScene": "Implemented with multiple insertion points (between panels, end, toolbar)",
          "deleteScene": "Implemented with confirmation dialog",
          "moveScene": "Implemented with HTML5 Drag and Drop",
          "keyboardShortcuts": "Delete/Backspace, +/=, Arrow keys",
          "visualFeedback": "Drag states, drop zones, animations"
        },
        "layout": {
          "horizontalScroll": "Implemented with flex layout",
          "scenePanelWidth": "400px fixed width",
          "insertButtonWidth": "60px"
        }
      }
    },
    {
      "id": "https://gftd.ai/config/graphql-postgresql-integration",
      "type": "cpm:Configuration",
      "name": "GraphQL PostgreSQL Integration Plan",
      "description": "Plan for implementing scene CRUD operations, OpenAI integration, and operation history",
      "status": "planned",
      "details": {
        "databaseSchema": {
          "operationHistory": "Table for storing all operation history",
          "generatedImages": "Table for storing generated images as BYTEA"
        },
        "graphqlMutations": [
          "createScene",
          "updateScene",
          "deleteScene",
          "reorderScenes",
          "generateSceneImage"
        ],
        "openaiIntegration": {
          "dalle3": "Image generation",
          "gpt4": "Scene text description generation",
          "imageStorage": "Download and store as BYTEA in PostgreSQL"
        },
        "historyTracking": {
          "allOperations": "CREATE, UPDATE, DELETE, REORDER, GENERATE_IMAGE",
          "storageFormat": "JSONB for operation data"
        }
      }
    }
  ],
  
  "issue": [
    {
      "id": "https://gftd.ai/issue/graphql-createproject-implementation",
      "type": "cpm:Issue",
      "name": "CreateProject Mutation Implementation",
      "description": "Implemented createProject mutation in GraphQL backend",
      "status": "resolved",
