{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://gftd.ai/ontology/storyboard-editor#",
    "id": "@id",
    "type": "@type",
    "cpm": "https://example.org/cpm#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    
    "activity": {"@id": "cpm:Activity", "@container": "@set"},
    "performedBy": {"@id": "cpm:performedBy", "@type": "@id", "@container": "@set"},
    "consumes": {"@id": "cpm:consumes", "@type": "@id", "@container": "@set"},
    "produces": {"@id": "cpm:produces", "@type": "@id", "@container": "@set"},
    "dependsOn": {"@id": "cpm:dependsOn", "@type": "@id", "@container": "@set"}
  },
  
  "@graph": [
    {
      "id": "https://gftd.ai/activity/create-storyboard-project",
      "type": "cpm:Activity",
      "name": "Create Storyboard Project",
      "description": "Create a new storyboard project with title and description",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/storyboard-editor"},
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/project-title"},
        {"@id": "https://gftd.ai/resource/project-description"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/storyboard-project"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/list-storyboard-projects",
      "type": "cpm:Activity",
      "name": "List Storyboard Projects",
      "description": "Browse and list all storyboard projects",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/storyboard-editor"},
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [],
      "produces": [
        {"@id": "https://gftd.ai/resource/storyboard-project-list"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/create-storyboard",
      "type": "cpm:Activity",
      "name": "Create Storyboard",
      "description": "Create a new storyboard with aspect ratio, resolution, duration, and variation settings",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/storyboard-editor"},
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/storyboard-project"},
        {"@id": "https://gftd.ai/resource/storyboard-settings"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/storyboard"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/edit-storyboard",
      "type": "cpm:Activity",
      "name": "Edit Storyboard",
      "description": "Edit storyboard settings and metadata",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/storyboard-editor"},
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/storyboard"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/storyboard"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/manage-scenes",
      "type": "cpm:Activity",
      "name": "Manage Scenes",
      "description": "Create, update, delete, and arrange scenes on timeline with media (video/image/text), timing, and transitions",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/storyboard-editor"},
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/storyboard"},
        {"@id": "https://gftd.ai/resource/scene-media"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/scene"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/generate-video",
      "type": "cpm:Activity",
      "name": "Generate Video",
      "description": "Generate video from storyboard using OpenAI API. Scene-level videos are generated and combined with transitions using FFmpeg. Videos are stored as bytea in PostgreSQL.",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/storyboard"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/generated-video"},
        {"@id": "https://gftd.ai/resource/video-bytea-storage"}
      ],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/manage-scenes"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/edit-timeline",
      "type": "cpm:Activity",
      "name": "Edit Timeline",
      "description": "Edit timeline with scene arrangement, timing, and transitions",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/storyboard-editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/storyboard"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/storyboard"}
      ],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/manage-scenes"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/preview-video",
      "type": "cpm:Activity",
      "name": "Preview Video",
      "description": "Preview generated videos before final export",
      "createdAt": "2025-01-30T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/storyboard-editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/generated-video"}
      ],
      "produces": [],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/generate-video"}
      ]
    }
  ]
}
