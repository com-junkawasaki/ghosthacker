{
  "name": "@gftdcojp/storyboard-editor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev --host 0.0.0.0",
    "prebuild": "houdini generate && cp -f .houdini/artifacts/*.js .houdini/artifacts/*.d.ts '$houdini/artifacts/' 2>/dev/null || true",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js tests/bdd/features --config tests/bdd/cucumber.config.cjs",
    "test:bdd:e2e": "cucumber-js tests/bdd/e2e/features --config tests/bdd/e2e/cucumber.config.cjs",
    "test:e2e": "playwright test",
    "test:tdd": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "graphql:generate": "houdini generate",
    "graphql:typegen": "houdini generate",
    "graphql:fetch-schema": "node scripts/fetch-schema.js"
  },
  "dependencies": {
    "@clerk/backend": "^2.26.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "etro": "^0.12.1",
    "graphql": "^16.9.0",
    "graphql-request": "^6.1.0",
    "houdini": "next",
    "houdini-svelte": "next",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-clerk": "^0.1.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.3.1",
    "@cucumber/gherkin": "^28.0.0",
    "@cucumber/messages": "^24.0.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-vercel": "^6.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "@types/chai": "^5.2.3",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "chai": "^6.2.1",
    "cucumber-html-reporter": "^7.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "playwright": "^1.57.0",
    "postcss": "^8.4.47",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.0",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
