{
  "name": "@gftdcojp/storyboard-editor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev --host 0.0.0.0",
    "prebuild": "tsx scripts/validate-env.ts && svelte-kit sync",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js tests/bdd/features --config tests/bdd/cucumber.config.cjs",
    "test:bdd:e2e": "cucumber-js tests/bdd/e2e/features --config tests/bdd/e2e/cucumber.config.cjs",
    "test:bdd:coverage": "nyc --reporter=text --reporter=html cucumber-js tests/bdd/e2e/features --config tests/bdd/e2e/cucumber.config.cjs",
    "test:bdd:coverage:report": "tsx scripts/bdd-coverage.ts",
    "test:bdd:e2e:coverage": "pnpm test:bdd:e2e && pnpm test:bdd:coverage:report",
    "test:e2e": "playwright test",
    "test:tdd": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "validate:env": "tsx scripts/validate-env.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@clerk/backend": "^2.26.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tiptap/core": "^3.13.0",
    "@tiptap/extension-blockquote": "^3.13.0",
    "@tiptap/extension-bold": "^3.13.0",
    "@tiptap/extension-bullet-list": "^3.13.0",
    "@tiptap/extension-code": "^3.13.0",
    "@tiptap/extension-code-block-lowlight": "^3.13.0",
    "@tiptap/extension-color": "^3.13.0",
    "@tiptap/extension-document": "^3.13.0",
    "@tiptap/extension-font-family": "^3.13.0",
    "@tiptap/extension-font-size": "3.0.0-next.3",
    "@tiptap/extension-hard-break": "^3.13.0",
    "@tiptap/extension-heading": "^3.13.0",
    "@tiptap/extension-highlight": "^3.13.0",
    "@tiptap/extension-history": "^3.13.0",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-italic": "^3.13.0",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/extension-list-item": "^3.13.0",
    "@tiptap/extension-ordered-list": "^3.13.0",
    "@tiptap/extension-paragraph": "^3.13.0",
    "@tiptap/extension-strike": "^3.13.0",
    "@tiptap/extension-subscript": "^3.13.0",
    "@tiptap/extension-superscript": "^3.13.0",
    "@tiptap/extension-table": "^3.13.0",
    "@tiptap/extension-table-cell": "^3.13.0",
    "@tiptap/extension-table-header": "^3.13.0",
    "@tiptap/extension-table-row": "^3.13.0",
    "@tiptap/extension-text": "^3.13.0",
    "@tiptap/extension-text-style": "^3.13.0",
    "@tiptap/extension-underline": "^3.13.0",
    "@tiptap/html": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@xyflow/svelte": "^1.5.0",
    "etro": "^0.12.1",
    "katex": "^0.16.27",
    "konva": "^10.0.12",
    "lowlight": "^3.3.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-clerk": "^0.20.1",
    "svelte-konva": "^1.0.1",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.10.2",
    "@clerk/testing": "^1.13.23",
    "@cucumber/cucumber": "^10.3.1",
    "@cucumber/gherkin": "^28.0.0",
    "@cucumber/messages": "^24.0.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-vercel": "^6.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "@types/chai": "^5.2.3",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "chai": "^6.2.1",
    "cucumber-html-reporter": "^7.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "nyc": "^17.1.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.47",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.0",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
