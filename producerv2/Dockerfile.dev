FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# content-creatorのpackage.jsonをコピー
COPY performers/actors/content-creator/package.json performers/actors/content-creator/pnpm-lock.yaml* ./performers/actors/content-creator/

WORKDIR /app/performers/actors/content-creator

RUN pnpm install

WORKDIR /app

COPY . .

EXPOSE 3000

WORKDIR /app/performers/actors/content-creator

CMD ["pnpm", "dev"]

