  "id": "https://gftd.ai/project/epub-editor",
  "type": "cpm:Project",
  "name": "EPUB Editor Tool",
  "description": "Tiptap editor based EPUB editing tool with AI Generator integration, multi-agent content generation, AI node classification and reclassification, emotion analysis (Hume AI) with sidebar visualization and benchmark comparison, and JSON-LD semantic nodes. Frontend: Next.js 14 App Router + Tiptap + JSON-LD nodes, Backend: GraphQL (Poem/Rust) + PostgreSQL",
  "version": "2.4.0",
  "createdAt": "2025-01-27T00:00:00Z",
  "updatedAt": "2025-01-27T18:00:00Z",
  "status": "in_progress",
  "priority": "high",
  
  "goal": {
    "id": "https://gftd.ai/goal/epub-editor-wellbecoming",
    "type": "cpm:Goal",
    "name": "Enable users to create and edit EPUB books with AI assistance",
    "description": "Users achieve well-becoming through intuitive EPUB editing experience with AI-powered writing assistance"
  },
  
  "hasCapability": [
    {"@id": "https://gftd.ai/capability/epub-editing"},
