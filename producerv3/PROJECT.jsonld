  "id": "https://gftd.ai/project/epub-editor",
  "type": "cpm:Project",
  "name": "EPUB Editor Tool",
  "description": "Tiptap editor based EPUB editing tool with AI Generator integration. Frontend: Astro + Tiptap, Backend: GraphQL (Poem/Rust) + Neo4j",
  "version": "1.0.0",
  "createdAt": "2025-01-27T00:00:00Z",
  "updatedAt": "2025-01-27T00:00:00Z",
  "status": "in_progress",
  "priority": "high",
  
  "goal": {
    "id": "https://gftd.ai/goal/epub-editor-wellbecoming",
    "type": "cpm:Goal",
    "name": "Enable users to create and edit EPUB books with AI assistance",
    "description": "Users achieve well-becoming through intuitive EPUB editing experience with AI-powered writing assistance"
  },
  
  "hasCapability": [
    {"@id": "https://gftd.ai/capability/epub-editing"},
    {"@id": "https://gftd.ai/capability/ai-generation"},
    {"@id": "https://gftd.ai/capability/epub-export"}
  ],
  
  "hasActivity": [
    {"@id": "https://gftd.ai/activity/edit-epub-content"},
    {"@id": "https://gftd.ai/activity/manage-chapters"},
    {"@id": "https://gftd.ai/activity/manage-metadata"},
    {"@id": "https://gftd.ai/activity/manage-media"},
    {"@id": "https://gftd.ai/activity/generate-text"},
    {"@id": "https://gftd.ai/activity/export-epub"}
  ],
  
  "hasPerformer": [
    {
      "@id": "https://gftd.ai/performer/actor/editor",
      "type": "cpm:Actor",
      "name": "Editor Actor",
      "description": "Frontend actor providing EPUB editing UI"
    },
    {
      "@id": "https://gftd.ai/performer/service/graphql",
      "type": "cpm:Service",
      "name": "GraphQL Service",
      "description": "GraphQL API service built with Poem/Rust"
    },
    {
      "@id": "https://gftd.ai/performer/system/neo4j",
      "type": "cpm:System",
      "name": "Neo4j Database",
      "description": "Graph database storing EPUB structure and content"
    }
  ],
  
  "hasResource": [
    {
      "@id": "https://gftd.ai/resource/epub-document",
      "type": "cpm:Resource",
      "name": "EPUB Document",
      "description": "EPUB book structure and content"
    },
    {
      "@id": "https://gftd.ai/resource/chapter",
      "type": "cpm:Resource",
      "name": "Chapter",
      "description": "Chapter within EPUB book"
    },
    {
      "@id": "https://gftd.ai/resource/media",
      "type": "cpm:Resource",
      "name": "Media Asset",
      "description": "Images and media files in EPUB"
    }
  ],
  
  "dependsOn": [
    {
      "@id": "https://gftd.ai/dependency/tiptap",
      "name": "Tiptap Editor",
      "description": "Rich text editor framework"
    },
    {
      "@id": "https://gftd.ai/dependency/neo4j",
      "name": "Neo4j Database",
      "description": "Graph database for EPUB structure"
    },
    {
      "@id": "https://gftd.ai/dependency/poem",
      "name": "Poem Framework",
      "description": "Rust web framework"
    }
  ]
}

