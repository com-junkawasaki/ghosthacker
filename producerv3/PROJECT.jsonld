  "hasPerformer": [
    {
      "@id": "https://gftd.ai/performer/actor/editor",
      "type": "cpm:Actor",
      "name": "Editor Actor",
      "description": "Frontend actor providing EPUB editing UI built with Next.js 14 App Router, Tailwind CSS, and Tiptap editor, running on port 25320"
    },
    {
      "@id": "https://gftd.ai/performer/service/graphql",
      "type": "cpm:Service",
      "name": "GraphQL Service",
      "description": "GraphQL API service built with Poem v3/Rust, async-graphql v7, with CORS support, running on port 25325 (host) -> 8080 (container)"
    },
    {
      "@id": "https://gftd.ai/performer/system/postgresql",
      "type": "cpm:System",
      "name": "PostgreSQL Database",
      "description": "Relational database storing EPUB structure and content, running on port 5432"
    }
  ],
  
  "hasResource": [
    {
      "@id": "https://gftd.ai/resource/epub-document",
      "type": "cpm:Resource",
      "name": "EPUB Document",
      "description": "EPUB book structure and content"
    },
    {
      "@id": "https://gftd.ai/resource/chapter",
      "type": "cpm:Resource",
      "name": "Chapter",
      "description": "Chapter within EPUB book"
    },
    {
      "@id": "https://gftd.ai/resource/media",
      "type": "cpm:Resource",
      "name": "Media Asset",
      "description": "Images and media files in EPUB"
    },
    {
      "@id": "https://gftd.ai/resource/project-list",
      "type": "cpm:Resource",
      "name": "Project List",
      "description": "List of all EPUB projects with metadata"
    },
    {
      "@id": "https://gftd.ai/resource/jsonld-nodes",
      "type": "cpm:Resource",
      "name": "JSON-LD Nodes",
      "description": "Semantic story elements (Character, Ghost, Location, Organization, Technology, Episode, Scene, Arc, Motif, Season, Timeline, POV, Beat, Event, SourceRef, Occupation, Setting). Block Container Nodes (character, scene, location, organization, pov) can contain paragraph content. Inline Atom Nodes (ghost, technology, episode, arc, motif, season, timeline, beat, event, etc.) are reference tags embedded in text."
    },
    {
      "@id": "https://gftd.ai/resource/mask-types",
      "type": "cpm:Resource",
      "name": "Mask Types",
      "description": "Content masking types (emotion, theme, context, notes, relationship, virtue, anchoredTo, emitsRepelsAvoids, phase, role). Mask controls are now integrated into FloatingToolbar context menu, accessible when text is selected. Supports toggle individual masks and toggle all masks functionality."
    },
    {
      "@id": "https://gftd.ai/resource/editor-toolbar",
      "type": "cpm:Resource",
      "name": "Editor Toolbar",
      "description": "Main editor toolbar organized by workflow phases: Phase 1 (Creation) - JSON-LD node insertion buttons and image generation; Phase 2 (Editing) - Format controls (Bold, Italic, H1, H2), AI generation, and node classification; Phase 4 (Export) - Export/import buttons and save status. Toolbar sections are visually separated with labels and border dividers."
    },
    {
      "@id": "https://gftd.ai/resource/floating-toolbar",
      "type": "cpm:Resource",
      "name": "Floating Toolbar",
      "description": "Floating toolbar that appears when text is selected in the editor. Provides context menu for mask operations (all 10 mask types with Toggle All functionality) and JSON-LD node insertion. Integrated mask controls moved from separate MaskControls component. Displays above selected text with visual feedback for active masks."
    },
    {
      "@id": "https://gftd.ai/resource/emotion-profile",
      "type": "cpm:Resource",
      "name": "Emotion Profile",
      "description": "Emotion analysis results (emotion vector with scores) attached to all node types (paragraph, character, scene, beat, etc.), analyzed via Hume AI API. Visualized in right sidebar aligned with each editor line, with background colors and border colors based on dominant emotions."
    },
    {
      "@id": "https://gftd.ai/resource/emotion-benchmark",
      "type": "cpm:Resource",
      "name": "Emotion Benchmark",
      "description": "Emotional benchmark data (JSON-LD format) defining target emotion scores for reference works (e.g., 君の名は。, ARIA, 聲の形, Arrival, Shawshank). Used for comparing actual emotion scores with benchmarks and calculating alignment scores (0-100%)."
    },
    {
      "@id": "https://gftd.ai/resource/emotion-sidebar",
      "type": "cpm:Resource",
      "name": "Emotion Sidebar",
      "description": "Right-side sidebar displaying emotion analysis data aligned with each editor line. Shows dominant emotions, scores, benchmark comparisons, and alignment scores for each analyzed node. Includes benchmark selector dropdown in header. Positioned absolutely to match editor line positions."
    },
    {
      "@id": "https://gftd.ai/resource/export-file",
      "type": "cpm:Resource",
      "name": "Export File",
      "description": "EPUB content export file in Tiptap JSON format, containing EPUB structure, chapters, JSON-LD nodes, mask information, and emotion analysis data"
    },
    {
      "@id": "https://gftd.ai/resource/graph-nodes-links-incidences",
      "type": "cpm:Resource",
      "name": "Graph Nodes, Links, and Incidences",
      "description": "Incidence graph model for JSON-LD nodes. GraphLinks represent relationships between nodes (worksFor, knows, parent, spouse, etc.). GraphIncidences connect nodes to links with roles (source, target, participant). Uses existing JSON-LD node tables as nodes."
    },
    {
      "@id": "https://gftd.ai/resource/markdown-episode-files",
      "type": "cpm:Resource",
      "name": "Markdown Episode Files",
      "description": "Markdown files for Wattpad episodes (part*.md and part*.en.md) organized by episode directories (ep01-ep12)"
    },
    {
      "@id": "https://gftd.ai/resource/combined-markdown-files",
      "type": "cpm:Resource",
      "name": "Combined Markdown Files",
      "description": "Combined Markdown files generated from episode parts (combined.md, combined.en.md per episode, and all_episodes.md, all_episodes.en.md for all episodes)"
    },
    {
      "@id": "https://gftd.ai/resource/generated-image",
      "type": "cpm:Resource",
      "name": "Generated Image",
      "description": "AI-generated images created from editor context (selected nodes, masked nodes, mask information). Images are generated using OpenAI DALL-E (with b64_json response format) or Higgsfield API and inserted into editor as Base64 data URIs. OpenAI DALL-E API returns Base64-encoded image data directly to avoid CORS issues with Azure Blob Storage URLs."
    },
    {
      "@id": "https://gftd.ai/resource/editor-context",
      "type": "cpm:Resource",
      "name": "Editor Context",
      "description": "Editor context information extracted from TipTap editor including selected nodes, masked nodes, mask information, and selected text. Used for generating image prompts automatically."
    },
    {
      "@id": "https://gftd.ai/resource/ai-generated-content",
      "type": "cpm:Resource",
      "name": "AI Generated Content",
      "description": "AI-generated narrative content created using OpenAI API with multi-agent model. Each character and narrator generates content based on their own context (character attributes, scene presence, POV perspective). Generated content includes emotion analysis results from Hume AI."
    },
    {
      "@id": "https://gftd.ai/resource/multi-agent-context",
      "type": "cpm:Resource",
      "name": "Multi-Agent Context",
      "description": "Context information for multi-agent content generation. Includes character context (attributes, relationships, dialogue, scene presence), scene context (characters present, location, emotion state), and narrator context (POV, perspective type). Only characters present in a scene have access to that scene's context."
    },
    {
      "@id": "https://gftd.ai/resource/emotion-arc",
      "type": "cpm:Resource",
      "name": "Emotion Arc",
      "description": "Emotional arc (EmotionalPlan) defining the emotional flow of a scene. Includes emotion beats with target emotions, actual emotion analysis results, deviation calculations, and alignment scores. Used to guide content generation and adjust generated text to match desired emotional progression."
    },
    {
      "@id": "https://gftd.ai/resource/node-classification-result",
      "type": "cpm:Resource",
      "name": "Node Classification Result",
      "description": "AI classification results for nodes including suggested node type (character, location, scene, technology, organization, etc.), confidence score, reasoning, suggested attributes, and suggested mask type. Used to reclassify existing nodes or classify new text selections."
    }
  ],
  
  "dependsOn": [
    {
      "@id": "https://gftd.ai/dependency/nextjs",
      "name": "Next.js",
      "description": "React framework with App Router, version 14.2"
    },
    {
      "@id": "https://gftd.ai/dependency/tiptap",
      "name": "Tiptap Editor",
      "description": "Rich text editor framework, version 2.27"
    },
    {
      "@id": "https://gftd.ai/dependency/tailwindcss",
      "name": "Tailwind CSS",
      "description": "Utility-first CSS framework, version 3.4"
    },
    {
      "@id": "https://gftd.ai/dependency/postgresql",
      "name": "PostgreSQL Database",
      "description": "Relational database for EPUB structure, version 16"
    },
    {
      "@id": "https://gftd.ai/dependency/sqlx",
      "name": "sqlx",
      "description": "Rust SQL toolkit, version 0.8"
    },
    {
      "@id": "https://gftd.ai/dependency/poem",
      "name": "Poem Framework",
      "description": "Rust web framework, version 3"
    },
    {
      "@id": "https://gftd.ai/dependency/async-graphql",
      "name": "async-graphql",
      "description": "Rust GraphQL library, version 7"
    },
    {
      "@id": "https://gftd.ai/dependency/reqwest",
      "name": "reqwest",
      "description": "Rust HTTP client library, version 0.12, used for Hume AI API calls"
    },
    {
      "@id": "https://gftd.ai/dependency/regex",
      "name": "regex",
      "description": "Rust regular expression library, version 1, used for text segmentation in emotion analysis"
    },
    {
      "@id": "https://gftd.ai/dependency/hume-ai",
      "name": "Hume AI",
      "description": "Hume AI Language API for emotion analysis (optional, falls back to deterministic analysis if not configured)"
    },
    {
      "@id": "https://gftd.ai/dependency/walkdir",
      "name": "walkdir",
      "description": "Rust library for recursively walking directories, version 2, used in JSON-LD import CLI tool"
    },
    {
      "@id": "https://gftd.ai/dependency/python",
      "name": "Python",
      "description": "Python 3 interpreter for running Markdown concatenation scripts"
    },
    {
      "@id": "https://gftd.ai/dependency/openai-api",
      "name": "OpenAI API",
      "description": "OpenAI API for content generation (GPT-4) and image generation (DALL-E 2 and DALL-E 3 models). Used for multi-agent content generation where each character and narrator generates text based on their context, and for generating images from text prompts."
    },
    {
      "@id": "https://gftd.ai/dependency/higgsfield-api",
      "name": "Higgsfield API",
      "description": "Higgsfield AI API for image generation. Alternative to OpenAI DALL-E for generating images from text prompts."
    }
  ],
  
  "configuration": [
    {
      "@id": "https://gftd.ai/config/ports",
      "name": "Service Ports",
