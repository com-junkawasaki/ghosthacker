      "frontend": 25320,
      "graphql": 25325,
      "postgres": 5432
    },
    {
      "@id": "https://gftd.ai/config/network",
      "name": "Docker Network",
      "description": "Docker network configuration",
      "network_name": "epub-editor-network-v2",
      "driver": "bridge"
    },
    {
      "@id": "https://gftd.ai/config/rust",
