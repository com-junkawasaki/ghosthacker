{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://gftd.ai/ontology/epub-editor#",
    "id": "@id",
    "type": "@type",
    "cpm": "https://example.org/cpm#",
    "prov": "http://www.w3.org/ns/prov#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sh": "http://www.w3.org/ns/shacl#",
    
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "dct:modified", "@type": "xsd:dateTime"},
    "version": "dct:hasVersion",
    
    "hasCapability": {"@id": "cpm:hasCapability", "@type": "@id", "@container": "@set"},
    "hasActivity": {"@id": "cpm:hasActivity", "@type": "@id", "@container": "@set"},
    "hasPerformer": {"@id": "cpm:hasPerformer", "@type": "@id", "@container": "@set"},
    "hasResource": {"@id": "cpm:hasResource", "@type": "@id", "@container": "@set"},
    "dependsOn": {"@id": "cpm:dependsOn", "@type": "@id", "@container": "@set"},
    "produces": {"@id": "cpm:produces", "@type": "@id", "@container": "@set"},
    "consumes": {"@id": "cpm:consumes", "@type": "@id", "@container": "@set"},
    
    "goal": {"@id": "cpm:goal", "@type": "@id"},
    "status": "cpm:status",
    "priority": "cpm:priority",
    "configuration": {"@id": "cpm:configuration", "@container": "@set"},
    "issue": {"@id": "cpm:issue", "@container": "@set"}
  },
  
  "id": "https://gftd.ai/project/epub-editor",
  "type": "cpm:Project",
  "name": "EPUB Editor Tool",
  "description": "Tiptap editor based EPUB editing tool with AI Generator integration. Frontend: Astro + Tiptap, Backend: GraphQL (Poem/Rust) + Neo4j",
  "version": "1.0.1",
  "createdAt": "2025-01-27T00:00:00Z",
  "updatedAt": "2025-11-17T04:50:00Z",
  "status": "in_progress",
  "priority": "high",
  
  "goal": {
    "id": "https://gftd.ai/goal/epub-editor-wellbecoming",
    "type": "cpm:Goal",
    "name": "Enable users to create and edit EPUB books with AI assistance",
    "description": "Users achieve well-becoming through intuitive EPUB editing experience with AI-powered writing assistance"
  },
  
  "hasCapability": [
    {"@id": "https://gftd.ai/capability/epub-editing"},
    {"@id": "https://gftd.ai/capability/ai-generation"},
    {"@id": "https://gftd.ai/capability/epub-export"}
  ],
  
  "hasActivity": [
    {"@id": "https://gftd.ai/activity/edit-epub-content"},
    {"@id": "https://gftd.ai/activity/manage-chapters"},
    {"@id": "https://gftd.ai/activity/manage-metadata"},
    {"@id": "https://gftd.ai/activity/manage-media"},
    {"@id": "https://gftd.ai/activity/generate-text"},
    {"@id": "https://gftd.ai/activity/export-epub"}
  ],
  
  "hasPerformer": [
    {
      "@id": "https://gftd.ai/performer/actor/editor",
      "type": "cpm:Actor",
      "name": "Editor Actor",
      "description": "Frontend actor providing EPUB editing UI, running on port 25320"
    },
    {
      "@id": "https://gftd.ai/performer/service/graphql",
      "type": "cpm:Service",
      "name": "GraphQL Service",
      "description": "GraphQL API service built with Poem v3/Rust, async-graphql v7, running on port 25325 (host) -> 8080 (container)"
    },
    {
      "@id": "https://gftd.ai/performer/system/neo4j",
      "type": "cpm:System",
      "name": "Neo4j Database",
      "description": "Graph database storing EPUB structure and content, running on ports 7474 (HTTP) and 7687 (Bolt)"
    }
  ],
  
  "hasResource": [
    {
      "@id": "https://gftd.ai/resource/epub-document",
      "type": "cpm:Resource",
      "name": "EPUB Document",
      "description": "EPUB book structure and content"
    },
    {
      "@id": "https://gftd.ai/resource/chapter",
      "type": "cpm:Resource",
      "name": "Chapter",
      "description": "Chapter within EPUB book"
    },
    {
      "@id": "https://gftd.ai/resource/media",
      "type": "cpm:Resource",
      "name": "Media Asset",
      "description": "Images and media files in EPUB"
    }
  ],
  
  "dependsOn": [
    {
      "@id": "https://gftd.ai/dependency/tiptap",
      "name": "Tiptap Editor",
      "description": "Rich text editor framework"
    },
    {
      "@id": "https://gftd.ai/dependency/neo4j",
      "name": "Neo4j Database",
      "description": "Graph database for EPUB structure, version 5.15"
    },
    {
      "@id": "https://gftd.ai/dependency/poem",
      "name": "Poem Framework",
      "description": "Rust web framework, version 3"
    },
    {
      "@id": "https://gftd.ai/dependency/async-graphql",
      "name": "async-graphql",
      "description": "Rust GraphQL library, version 7"
    }
  ],
  
  "configuration": [
    {
      "@id": "https://gftd.ai/config/ports",
      "name": "Service Ports",
      "description": "Port configuration for services",
      "frontend": 25320,
      "graphql": 25325,
      "neo4j_http": 7474,
      "neo4j_bolt": 7687
    },
    {
      "@id": "https://gftd.ai/config/network",
      "name": "Docker Network",
      "description": "Docker network configuration",
      "network_name": "epub-editor-network-v2",
      "driver": "bridge"
    },
    {
      "@id": "https://gftd.ai/config/rust",
      "name": "Rust Configuration",
      "description": "Rust toolchain and dependencies",
      "edition": "2021",
      "async_graphql_version": "7",
      "poem_version": "3",
      "neo4rs_version": "0.7"
    }
  ],
  
  "issue": [
    {
      "@id": "https://gftd.ai/issue/graphql-codegen-schema-loading",
      "name": "GraphQL Codegen Schema Loading",
      "description": "Codegen fails to load schema from localhost:25325 when running inside container. Use http://graphql:8080/graphql for container-based codegen.",
      "status": "resolved",
      "resolution": "Updated codegen.yaml to support both localhost (host) and graphql:8080 (container) endpoints"
    },
    {
      "@id": "https://gftd.ai/issue/simpleobject-outputtype",
      "name": "SimpleObject OutputType Implementation",
      "description": "Fixed SimpleObject derive macro issues by reordering struct definitions and adding Clone trait",
      "status": "resolved"
    },
    {
      "@id": "https://gftd.ai/issue/async-graphql-error-conversion",
      "name": "async_graphql::Error Conversion",
      "description": "Fixed error conversion from async_graphql::Error to anyhow::Error using format! macro with Debug trait",
      "status": "resolved"
    },
    {
      "@id": "https://gftd.ai/issue/disk-space",
      "name": "Disk Space Management",
      "description": "Cleaned up Docker volumes and Rust target directories to free up ~14GB of disk space",
      "status": "resolved"
    }
  ]
}
