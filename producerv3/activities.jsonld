{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://gftd.ai/ontology/epub-editor#",
    "id": "@id",
    "type": "@type",
    "cpm": "https://example.org/cpm#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct": "http://purl.org/dc/terms/",
    
    "name": "dct:title",
    "description": "dct:description",
    "createdAt": {"@id": "dct:created", "@type": "xsd:dateTime"},
    
    "activity": {"@id": "cpm:Activity", "@container": "@set"},
    "performedBy": {"@id": "cpm:performedBy", "@type": "@id", "@container": "@set"},
    "consumes": {"@id": "cpm:consumes", "@type": "@id", "@container": "@set"},
    "produces": {"@id": "cpm:produces", "@type": "@id", "@container": "@set"},
    "dependsOn": {"@id": "cpm:dependsOn", "@type": "@id", "@container": "@set"}
  },
  
  "@graph": [
    {
      "id": "https://gftd.ai/activity/edit-epub-content",
      "type": "cpm:Activity",
      "name": "Edit EPUB Content",
      "description": "Edit text content of EPUB chapters using Tiptap editor",
      "createdAt": "2025-01-27T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/chapter"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/epub-document"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/manage-chapters",
      "type": "cpm:Activity",
      "name": "Manage Chapters",
      "description": "Create, update, delete, and reorder chapters in EPUB book",
      "createdAt": "2025-01-27T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/epub-document"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/chapter"}
      ],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/edit-epub-content"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/manage-metadata",
      "type": "cpm:Activity",
      "name": "Manage Metadata",
      "description": "Edit EPUB metadata including title, author, ISBN, language, etc.",
      "createdAt": "2025-01-27T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/epub-document"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/epub-document"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/manage-media",
      "type": "cpm:Activity",
      "name": "Manage Media",
      "description": "Upload, insert, and manage images and media assets in EPUB book",
      "createdAt": "2025-01-27T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/media"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/chapter"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/generate-text",
      "type": "cpm:Activity",
      "name": "Generate Text with AI",
      "description": "Use AI to generate, summarize, proofread, or translate text content",
      "createdAt": "2025-01-27T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"},
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/chapter"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/chapter"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/export-epub",
      "type": "cpm:Activity",
      "name": "Export EPUB",
      "description": "Export EPUB book structure and content to EPUB 3.0 file format (ZIP archive)",
      "createdAt": "2025-01-27T00:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/epub-document"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/epub-file"}
      ],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/manage-chapters"},
        {"@id": "https://gftd.ai/activity/manage-metadata"},
        {"@id": "https://gftd.ai/activity/manage-media"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/list-projects",
      "type": "cpm:Activity",
      "name": "List Projects",
      "description": "Browse and list all EPUB projects with metadata (title, language, creation date, update date)",
      "createdAt": "2025-11-17T08:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [],
      "produces": [
        {"@id": "https://gftd.ai/resource/project-list"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/export-epub-content",
      "type": "cpm:Activity",
      "name": "Export EPUB Content",
      "description": "Export EPUB entire content (all chapters) as Tiptap JSON format file. Includes EPUB metadata, chapters with Tiptap JSON content, JSON-LD nodes, mask information, and emotion analysis data. File is downloaded as JSON with EPUB title and timestamp.",
      "createdAt": "2025-01-27T17:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/epub-document"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/export-file"}
      ],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/edit-epub-content"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/import-epub-content",
      "type": "cpm:Activity",
      "name": "Import EPUB Content",
      "description": "Import EPUB content from Tiptap JSON format file. Validates file structure, restores EPUB metadata and chapters, converts Tiptap JSON to HTML, and updates database. Supports both creating new chapters and updating existing chapters.",
      "createdAt": "2025-01-27T17:00:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/export-file"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/epub-document"}
      ],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/manage-chapters"},
        {"@id": "https://gftd.ai/activity/manage-metadata"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/import-jsonld-nodes",
      "type": "cpm:Activity",
      "name": "Import JSON-LD Nodes",
      "description": "Bulk import JSON-LD semantic story data from JSON-LD files into PostgreSQL database. Supports importing Character, Ghost, Location, Organization, Company, Technology, Episode, Scene, Arc, Motif, Season, Timeline, Event, SourceRef, Occupation, and Setting nodes. Handles @graph arrays by importing each element individually. Uses upsert operations to overwrite existing data.",
      "createdAt": "2025-11-17T08:40:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/service/graphql"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/jsonld-nodes"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/jsonld-nodes"}
      ],
      "dependsOn": [
        {"@id": "https://gftd.ai/activity/manage-jsonld-nodes"}
      ]
    },
    {
      "id": "https://gftd.ai/activity/concatenate-markdown-files",
      "type": "cpm:Activity",
      "name": "Concatenate Markdown Files",
      "description": "Concatenate Markdown episode files (part*.md and part*.en.md) into combined files per episode and all-episodes combined files. Processes ep01-ep12 directories, combines parts in order, and generates combined.md, combined.en.md per episode, plus all_episodes.md and all_episodes.en.md.",
      "createdAt": "2025-11-17T08:40:00Z",
      "performedBy": [
        {"@id": "https://gftd.ai/performer/actor/editor"}
      ],
      "consumes": [
        {"@id": "https://gftd.ai/resource/markdown-episode-files"}
      ],
      "produces": [
        {"@id": "https://gftd.ai/resource/combined-markdown-files"}
      ],
      "dependsOn": []
    }
  ]
}

