    "@tiptap/html": "^3.10.7",
    "@tiptap/pm": "^2.1.13",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "@xyflow/react": "^12.9.3",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-resizable-panels": "^3.0.6",
    "ts-pattern": "^5.9.0",
    "zustand": "^5.0.8"
