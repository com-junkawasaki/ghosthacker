{
  "name": "@gftdcojp/epub-editor-frontend",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm type-check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "astro check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.yaml",
    "codegen:watch": "graphql-codegen --config codegen.yaml --watch",
    "codegen:docker": "graphql-codegen --config codegen.yaml"
  },
  "dependencies": {
    "@apollo/client": "^3.11.0",
    "@astrojs/react": "^4.0.0",
    "@tiptap/extension-image": "^2.1.13",
    "@tiptap/extension-link": "^2.1.13",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "astro": "^5.15.8",
    "graphql": "^16.9.0",
    "graphql-tag": "^2.12.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@astrojs/node": "^9.5.0",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typed-document-node": "^4.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "eslint-config-astro": "^1.0.0",
    "jsdom": "^24.1.3",
    "vitest": "^2.1.9"
  }
}