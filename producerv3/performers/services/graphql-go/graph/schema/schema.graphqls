"""
@context https://gftd.ai/ontology/epub-editor#
@type cpm:Service
@id https://gftd.ai/performer/service/graphql-go

GraphQL API service for EPUB Editor Tool (Go implementation)
Provides Query, Mutation, and Subscription operations for EPUB editing
"""

type Query {
  """Get EPUB by ID"""
  epub(id: ID!): Epub
  
  """List all EPUBs"""
  epubList: [Epub!]!
  
  """Get chapter by ID"""
  chapter(id: ID!): Chapter
  
  """Get chapters for EPUB"""
  chapters(epubId: ID!): [Chapter!]!
  
  """Get media by ID"""
  media(id: ID!): Media
  
  """Get metadata for EPUB"""
  metadata(epubId: ID!): [MetadataItem!]!
}

type Mutation {
  """Create new EPUB"""
  createEpub(input: CreateEpubInput!): Epub!
  
  """Update EPUB"""
  updateEpub(input: UpdateEpubInput!): Epub!
  
  """Delete EPUB"""
  deleteEpub(id: ID!): Boolean!
  
  """Create chapter"""
  createChapter(input: CreateChapterInput!): Chapter!
  
  """Update chapter"""
  updateChapter(input: UpdateChapterInput!): Chapter!
  
  """Delete chapter"""
  deleteChapter(id: ID!): Boolean!
  
  """Create media"""
  createMedia(input: CreateMediaInput!): Media!
  
  """Update metadata"""
  updateMetadata(input: UpdateMetadataInput!): MetadataItem!
  
  """Generate text using AI"""
  generateText(input: GenerateTextInput!): GeneratedText!
  
  """Summarize chapter content"""
  summarize(input: SummarizeInput!): GeneratedText!
  
  """Proofread chapter content"""
  proofread(input: ProofreadInput!): GeneratedText!
  
  """Translate chapter content"""
  translate(input: TranslateInput!): GeneratedText!
}

type Subscription {
  # Placeholder for future subscription implementation
  _empty: String
}

