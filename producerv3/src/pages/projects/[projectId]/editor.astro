---
/**
 * @context https://gftd.ai/ontology/epub-editor#
 * @type cpm:Activity
 * @id https://gftd.ai/activity/edit-epub-content
 * 
 * EPUB Editor page with Tiptap editor
 */
import { TiptapEditor } from '../../../components/editor/TiptapEditor';
import { ChapterTree } from '../../../components/editor/ChapterTree';
import { MetadataForm } from '../../../components/editor/MetadataForm';
import { MediaLibrary } from '../../../components/editor/MediaLibrary';
import { ApolloProvider } from '../../../components/editor/ApolloProvider';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>EPUB Editor - {Astro.params.projectId}</title>
  </head>
  <body>
    <ApolloProvider client:load>
      <div class="editor-layout">
        <aside class="sidebar">
          <ChapterTree client:load epubId={Astro.params.projectId} />
          <MetadataForm client:load epubId={Astro.params.projectId} />
          <MediaLibrary client:load chapterId="" />
        </aside>
        <main class="editor-main">
          <TiptapEditor client:load projectId={Astro.params.projectId} />
        </main>
      </div>
    </ApolloProvider>
  </body>
</html>

<style>
  .editor-layout {
    display: flex;
    height: 100vh;
  }
  .sidebar {
    width: 300px;
    border-right: 1px solid #ccc;
    padding: 1rem;
    overflow-y: auto;
  }
  .editor-main {
    flex: 1;
    padding: 1rem;
    overflow-y: auto;
  }
</style>

