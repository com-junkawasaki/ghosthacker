  "id": "https://gftd.ai/project/manga-editor",
  "type": "cpm:Project",
  "name": "Manga Editor Tool",
  "description": "AI Agentを使ったマンガ制作ウェブアプリ。単一Canvas（Konva.js）でページ全体を管理し、fal.ai/DeepInfraによるモデル選択機能を実装。Frontend: Next.js 14 App Router + React 18 + react-konva + Tailwind CSS, Backend: GraphQL (Poem 3/Rust) + PostgreSQL 16",
  "version": "0.1.0",
  "createdAt": "2025-01-29T00:00:00Z",
  "updatedAt": "2025-01-29T12:00:00Z",
  "status": "in_progress",
  "priority": "high",
  
  "goal": {
    "id": "https://gftd.ai/goal/manga-editor-wellbecoming",
    "type": "cpm:Goal",
    "name": "Enable users to create manga with AI assistance",
    "description": "Users achieve well-becoming through intuitive manga creation experience with AI-powered image generation and story generation"
  },
  
