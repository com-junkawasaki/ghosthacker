{:id "ghosthacker", :title "Ghost Hacker", :subtitle "サイバー安全マンガ", :sourcePath "com-junkawasaki/ghosthacker/260123-jump/resources/episodes", :pages [{:pageNumber 0, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 日常 - 配信者の光", :panels [{:id nil, :panelNumber 1, :visual "都立工科高校の外観。夕暮れ、部活帰りの生徒たち。", :imageUrl nil, :dialogue [{:text "都立工科高等学校。技術系の専門教育で知られる進学校。", :speaker "Narration"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "Ryoの部屋。ゲーミングチェアに座り、配信中。画面には視聴者からのコメントが流れる。", :imageUrl nil, :dialogue [{:text "はい！Ryo_kuroです！今日もFPSやっていくよ〜！", :speaker "RyoKuroda"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "配信画面のアップ。視聴者5万人、コメント「神プレイ！」「また勝つでしょ」「応援してるよ」。", :imageUrl nil, :dialogue [{:text "登録者5万人。彼の居場所。", :speaker "Narration"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "Ryoの笑顔。画面に照らされる横顔。楽しそうに配信を続けている。", :imageUrl nil, :dialogue [{:text "みんな、いつもありがとな！", :speaker "RyoKuroda"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 1, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 日常の崩壊 - ドクシングの始まり", :panels [{:id nil, :panelNumber 1, :visual "匿名掲示板のスクリーンショット。「Ryo_kuroの本名と住所特定したわｗ」「こいつの配信、背景から場所分かるじゃん」", :imageUrl nil, :dialogue [{:text "異変は、静かに始まった。", :speaker "Narration"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "Ryoのスマホを握る手が震える。SNSの通知が止まらない。誹謗中傷のリプライが溢れる。", :imageUrl nil, :dialogue [{:text "…なんだ、これ…", :speaker "RyoKuroda"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "SNSタイムライン。「チーター乙」「八百長野郎」「住所晒されてやんの」「消えろ」の文字が並ぶ。", :imageUrl nil, :dialogue [], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "Ryoの目。画面を見つめる瞳に、恐怖が滲む。涙がこぼれそう。", :imageUrl nil, :dialogue [{:text "…嘘だろ…俺、何も悪いことしてないのに…", :speaker "RyoKuroda"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 2, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — エスカレーション - 現実への侵食", :panels [{:id nil, :panelNumber 1, :visual "Ryoの家の前。ピザの配達員が何人も来ている。困惑するRyoの母。", :imageUrl nil, :dialogue [{:text "注文してないって言ってるでしょ！", :speaker "RyoMother"} {:text "でも、この住所で30枚注文が…", :speaker "DeliveryMan"}], :rect [0 0 1 0.3728]} {:id nil, :panelNumber 2, :visual "Ryoが2階の窓から様子を見ている。顔は蒼白。", :imageUrl nil, :dialogue [{:text "（俺のせいだ…）", :speaker "RyoKuroda"}], :rect [0.506 0.3848 0.494 0.2304]} {:id nil, :panelNumber 3, :visual "Ryoのスマホ。無言電話の着信履歴が何件も。非通知、未登録番号が並ぶ。", :imageUrl nil, :dialogue [{:text "電話も、止まらなかった。", :speaker "Narration"}], :rect [0 0.3848 0.494 0.2304]} {:id nil, :panelNumber 4, :visual "学校の廊下。Ryoがうつむいて歩いている。周りの生徒がヒソヒソ話をしている。", :imageUrl nil, :dialogue [{:text "（あれ、住所晒されたやつ…）", :speaker "Student1"} {:text "（マジ？やば…）", :speaker "Student2"}], :rect [0 0.6272 1 0.3728]}]} {:pageNumber 3, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 絶望 - 登校できなくなる", :panels [{:id nil, :panelNumber 1, :visual "教室の入り口。Ryoが入ろうとして、止まる。視線が怖い。", :imageUrl nil, :dialogue [{:text "（…無理だ）", :speaker "RyoKuroda"}], :rect [0.506 0 0.494 0.2698]} {:id nil, :panelNumber 2, :visual "Ryoの手が握りしめられている。爪が食い込んでいる。", :imageUrl nil, :dialogue [], :rect [0 0 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "Ryoの部屋。カーテンが閉め切られ、ベッドで丸くなっている。スマホは裏向きにされている。", :imageUrl nil, :dialogue [{:text "3日目。彼は学校に行けなくなった。", :speaker "Narration"}], :rect [0 0.2818 1 0.4365]} {:id nil, :panelNumber 4, :visual "Shotaがドアを開けて覗き込む。心配そうな顔。", :imageUrl nil, :dialogue [{:text "涼…お前、生きてるか？", :speaker "ShotaHayashi"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 4, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 出会い - 赤羽千世", :panels [{:id nil, :panelNumber 1, :visual "夜の神社境内。提灯の灯りがぼんやりと照らす。Shotaが誰かと話している。", :imageUrl nil, :dialogue [{:text "頼むよ、千世。お前しかいねぇんだ。", :speaker "ShotaHayashi"}], :rect [0 0 1 0.3728]} {:id nil, :panelNumber 2, :visual "Chiseが境内のベンチに座っている。ストリート系の服、赤いハイライトの入った黒髪。琥珀色の鋭い目。", :imageUrl nil, :dialogue [{:text "…めんどくせぇ。", :speaker "Chise"}], :rect [0.506 0.3848 0.494 0.2304]} {:id nil, :panelNumber 3, :visual "Chiseの目。鋭く、でもどこか守護の意志を感じさせる。", :imageUrl nil, :dialogue [{:text "…でも、弱い者いじめは、もっとめんどくせぇ。", :speaker "Chise"}], :rect [0 0.3848 0.494 0.2304]} {:id nil, :panelNumber 4, :visual "Chiseが立ち上がる。神社の鳥居を背に、シルエット。", :imageUrl nil, :dialogue [{:text "…会わせろ。その後輩に。", :speaker "Chise"}], :rect [0 0.6272 1 0.3728]}]} {:pageNumber 5, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 出会い - 「消すな。残せ。」", :panels [{:id nil, :panelNumber 1, :visual "ファミレスの一角。Ryoがうつむいている。Chiseが向かいに座っている。Shotaは横で見守る。", :imageUrl nil, :dialogue [{:text "話、聞いた。酷いな。", :speaker "Chise"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "Ryoのスマホを見るChise。画面には誹謗中傷の数々。", :imageUrl nil, :dialogue [{:text "全部消したいんです…でも消しても消しても…", :speaker "RyoKuroda"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "Chiseがスマホをテーブルに置く。Ryoの目を真っ直ぐ見る。", :imageUrl nil, :dialogue [{:text "消すな。", :speaker "Chise"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "Chiseが前のめりになってRyoに語りかける。Ryoは驚いている。", :imageUrl nil, :dialogue [{:text "残せ。それが一番強い武器になる。", :speaker "Chise"} {:text "証拠がなきゃ、戦えない。消したら、あいつらの勝ちだ。", :speaker "Chise"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 6, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 対策1 - 証拠の保全", :panels [{:id nil, :panelNumber 1, :visual "Chiseのノートパソコン画面。スクリーンショットを撮るツールが起動している。", :imageUrl nil, :dialogue [{:text "まず、スクショ。URL、日時、投稿者のID、全部残せ。", :speaker "Chise"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "YuiがChiseの横に座っている。缶コーヒーを持ちながら画面を見る。", :imageUrl nil, :dialogue [{:text "…魚拓サービスも使って。消される前に。", :speaker "YuiTanaka"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "画面に表示される手順リスト。「1. スクリーンショット撮影 2. URL保存 3. 日時記録 4. 魚拓サービスで保存」", :imageUrl nil, :dialogue [{:text "証拠保全の手順。これが、戦うための第一歩。", :speaker "Narration"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "Ryoが真剣な顔でスマホを操作している。証拠を保存している。", :imageUrl nil, :dialogue [{:text "…分かりました。全部、残します。", :speaker "RyoKuroda"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 7, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 対策2 - プラットフォーム報告", :panels [{:id nil, :panelNumber 1, :visual "SNSの「通報」ボタンを押す画面。「誹謗中傷・嫌がらせ」のカテゴリを選択。", :imageUrl nil, :dialogue [{:text "次。プラットフォームに通報。でも、通報する前に必ず証拠を残してから。", :speaker "Chise"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "Chiseがホワイトボードに流れを書いている。「証拠保全 → 通報 → 相談 → 開示請求」", :imageUrl nil, :dialogue [{:text "順番が大事。証拠なしに通報しても、消されたら終わり。", :speaker "Chise"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "ShotaとRyoが真剣に聞いている。Shotaがメモを取っている。", :imageUrl nil, :dialogue [{:text "なるほど…全部繋がってんだな。", :speaker "ShotaHayashi"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "Yuiが削除依頼のテンプレートを見せている。", :imageUrl nil, :dialogue [{:text "…削除依頼のテンプレ、作っておいた。", :speaker "YuiTanaka"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 8, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 対策3 - 相談窓口", :panels [{:id nil, :panelNumber 1, :visual "警察庁サイバー犯罪相談窓口のウェブサイト。「#9110」の電話番号。", :imageUrl nil, :dialogue [{:text "三つ目。相談窓口。一人で抱え込むな。", :speaker "Chise"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "Chiseが電話番号のリストを渡す。Ryoの手が震えながら受け取る。", :imageUrl nil, :dialogue [{:text "…でも、親にバレたら…", :speaker "RyoKuroda"} {:text "親に言わないで解決できる範囲は超えてる。大人を巻き込め。", :speaker "Chise"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "Chiseの真剣な表情。", :imageUrl nil, :dialogue [{:text "被害者は悪くない。声を上げることは、恥ずかしいことじゃない。", :speaker "Chise"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "Ryoの目に、涙と決意が滲む。", :imageUrl nil, :dialogue [{:text "…はい。親に、話します。", :speaker "RyoKuroda"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 9, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 対策4 - 発信者情報開示請求", :panels [{:id nil, :panelNumber 1, :visual "「発信者情報開示請求」の書類。弁護士の名刺。", :imageUrl nil, :dialogue [{:text "最後の武器。発信者情報開示請求。", :speaker "Chise"}], :rect [0.506 0 0.494 0.2698]} {:id nil, :panelNumber 2, :visual "Chiseがフローチャートの最終段階を指す。「匿名 → IP開示 → 契約者特定 → 法的措置」", :imageUrl nil, :dialogue [{:text "匿名でも逃げられない。ログは嘘つかない。", :speaker "Chise"}], :rect [0 0 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "RyoとShotaが顔を見合わせる。希望が見えてきた。", :imageUrl nil, :dialogue [{:text "マジか…特定できんのか…", :speaker "ShotaHayashi"} {:text "…戦える、のか…", :speaker "RyoKuroda"}], :rect [0 0.2818 1 0.2698]} {:id nil, :panelNumber 4, :visual "Chiseが腕を組んで立っている。背後にはホワイトボードの全体図。戦略が見える。", :imageUrl nil, :dialogue [{:text "ここからが本番だ。証拠は揃った。次は、追跡。", :speaker "Chise"}], :rect [0 0.5635 1 0.4365]}]} {:pageNumber 10, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 追跡 - デジタルフォレンジック", :panels [{:id nil, :panelNumber 1, :visual "画面に表示されるログデータ。IPアドレス、タイムスタンプ、アクセス元が並ぶ。", :imageUrl nil, :dialogue [{:text "追跡が始まった。", :speaker "Narration"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "Yuiが複数のモニターの前で作業。Chiseが後ろから見ている。", :imageUrl nil, :dialogue [{:text "…パターンが見えてきた。同一人物が複数アカウントで投稿してる。", :speaker "YuiTanaka"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "Chiseの目が光る。何かを掴んだ表情。", :imageUrl nil, :dialogue [{:text "…こいつ、ミスってる。", :speaker "Chise"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "画面上のデータがハイライトされる。アカウント名の類似性、投稿時間のパターン。", :imageUrl nil, :dialogue [{:text "サブ垢の名前、本垢と似てる。そして投稿時間…学校終わりと深夜。高校生だ。", :speaker "Chise"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 11, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 追跡 - グレーな情報", :panels [{:id nil, :panelNumber 1, :visual "夜の街。ネオンが光る裏通り。Chiseが一人で歩いている。", :imageUrl nil, :dialogue [{:text "正攻法だけでは、辿り着けない場所がある。", :speaker "Narration"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "カフェの奥の席。Daichiが座っている。スーツを着崩した格好。", :imageUrl nil, :dialogue [{:text "珍しいな、千世。俺に会いに来るなんて。", :speaker "DaichiMori"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "ChiseとDaichiが向かい合う。緊張感のある空気。", :imageUrl nil, :dialogue [{:text "…情報が欲しい。ある配信者を攻撃してるグループの。", :speaker "Chise"} {:text "ふーん。また誰かの味方してんだ。", :speaker "DaichiMori"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "Daichiが何かを書いたメモを滑らせる。Chiseの手が受け取る。", :imageUrl nil, :dialogue [{:text "…知ってることは、これだけ。借りは作らないからな。", :speaker "DaichiMori"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 12, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 追跡 - 真相に迫る", :panels [{:id nil, :panelNumber 1, :visual "メモの内容。ハンドルネームと、「元配信者」の文字。", :imageUrl nil, :dialogue [{:text "…元配信者。しかも、同じジャンル。", :speaker "Chise"}], :rect [0.506 0 0.494 0.2698]} {:id nil, :panelNumber 2, :visual "Chiseが神社の境内で考え込んでいる。夜の静けさ。", :imageUrl nil, :dialogue [{:text "（嫉妬か。Ryoが人気出て、自分は伸びなくて…）", :speaker "Chise"}], :rect [0 0 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "Yuiの画面に、特定されたアカウントの情報が表示される。Chise、Shota、Ryoが見ている。", :imageUrl nil, :dialogue [{:text "…一致した。この元配信者、Ryoの動画にネガコメ残してた履歴がある。", :speaker "YuiTanaka"}], :rect [0 0.2818 1 0.4365]} {:id nil, :panelNumber 4, :visual "Ryoの表情。驚きと、悲しみ。", :imageUrl nil, :dialogue [{:text "…あいつ、前は一緒にコラボしてたのに…", :speaker "RyoKuroda"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 13, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 追跡 - 動機", :panels [{:id nil, :panelNumber 1, :visual "SNSの過去の投稿。元配信者の登録者数が伸び悩んでいるグラフ。Ryoのチャンネルは急成長。", :imageUrl nil, :dialogue [{:text "嫉妬は、静かに毒になる。", :speaker "Narration"}], :rect [0.506 0 0.494 0.2698]} {:id nil, :panelNumber 2, :visual "Chiseが証拠をまとめている。ファイルに整理されたスクリーンショットとログ。", :imageUrl nil, :dialogue [{:text "これで十分。あとは弁護士に渡す。", :speaker "Chise"}], :rect [0 0 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "Chiseの手が開示請求書類に署名するRyoの手をサポートしている。", :imageUrl nil, :dialogue [{:text "ここにサイン。お前の名前で、正式に戦う。", :speaker "Chise"}], :rect [0 0.2818 1 0.2698]} {:id nil, :panelNumber 4, :visual "全員がRyoを見守っている。Ryoがペンを握り、書類にサインする。", :imageUrl nil, :dialogue [{:text "…俺、戦います。", :speaker "RyoKuroda"}], :rect [0 0.5635 1 0.4365]}]} {:pageNumber 14, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 対決 - 開示請求の結果", :panels [{:id nil, :panelNumber 1, :visual "弁護士事務所からの封筒。「発信者情報開示請求 承認」の文字。", :imageUrl nil, :dialogue [{:text "数週間後。開示請求が通った。", :speaker "Narration"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "弁護士事務所。Ryoと両親が弁護士から説明を受けている。Chiseは後ろで見守る。", :imageUrl nil, :dialogue [{:text "発信者が特定されました。同県内の高校生です。", :speaker "Lawyer"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "Ryoの表情。複雑な感情。安堵、悲しみ、怒り。", :imageUrl nil, :dialogue [{:text "…やっぱり、あいつだったのか…", :speaker "RyoKuroda"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "Chiseが静かにRyoの肩に手を置く。", :imageUrl nil, :dialogue [{:text "終わりじゃない。始まりだ。正しく、終わらせる。", :speaker "Chise"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 15, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 対決 - 決着", :panels [{:id nil, :panelNumber 1, :visual "別の場所。加害者の高校生が親と弁護士と共にいる。謝罪の場面。", :imageUrl nil, :dialogue [{:text "法的措置の末、示談が成立した。", :speaker "Narration"}], :rect [0 0 1 0.3728]} {:id nil, :panelNumber 2, :visual "加害者が頭を下げている。隣で加害者の親も頭を下げる。", :imageUrl nil, :dialogue [{:text "…本当に、申し訳ありませんでした…", :speaker "Perpetrator"}], :rect [0.506 0.3848 0.494 0.2304]} {:id nil, :panelNumber 3, :visual "Ryoの表情。許すでも許さないでもない、区切りをつける顔。", :imageUrl nil, :dialogue [{:text "…二度と、やらないでください。", :speaker "RyoKuroda"}], :rect [0 0.3848 0.494 0.2304]} {:id nil, :panelNumber 4, :visual "会議室を出るRyo。外には夕陽が差し込んでいる。一つの区切り。", :imageUrl nil, :dialogue [{:text "一つの戦いが、終わった。", :speaker "Narration"}], :rect [0 0.6272 1 0.3728]}]} {:pageNumber 16, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 再起 - 配信復帰", :panels [{:id nil, :panelNumber 1, :visual "Ryoの部屋。再び配信機材の前に座っている。少し緊張した面持ち。", :imageUrl nil, :dialogue [{:text "…よし。", :speaker "RyoKuroda"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "配信開始ボタンを押す指。画面に「LIVE」の文字が点灯。", :imageUrl nil, :dialogue [{:text "彼は、戻ってきた。", :speaker "Narration"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "配信チャット。「おかえり！」「待ってたよ！」「応援してる！」のコメントが溢れる。", :imageUrl nil, :dialogue [], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "Ryoの笑顔。涙がにじんでいるが、本物の笑顔。", :imageUrl nil, :dialogue [{:text "みんな…ただいま。俺、戻ってきたよ。", :speaker "RyoKuroda"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 17, :title "Arc 0-2: 「恥じゃない。残すのが一番強い」 — 再起 - 「恥じゃない」", :panels [{:id nil, :panelNumber 1, :visual "夜の神社。Chiseが境内のベンチに座っている。スマホでRyoの配信を見ている。", :imageUrl nil, :dialogue [{:text "（…よかったな、坊主）", :speaker "Chise"}], :rect [0 0 1 0.3728]} {:id nil, :panelNumber 2, :visual "Shotaがやってきて、缶コーヒーを渡す。", :imageUrl nil, :dialogue [{:text "ありがとな、千世。涼、元気になった。", :speaker "ShotaHayashi"} {:text "…俺は何もしてねぇよ。あいつが戦ったんだ。", :speaker "Chise"}], :rect [0.506 0.3848 0.494 0.2304]} {:id nil, :panelNumber 3, :visual "Chiseの横顔。少しだけ柔らかい表情。神社の灯りに照らされる。", :imageUrl nil, :dialogue [{:text "恥じゃない。声を上げることは、一番強い。", :speaker "Chise"}], :rect [0 0.3848 0.494 0.2304]} {:id nil, :panelNumber 4, :visual "Chiseが立ち上がり、神社の鳥居をくぐって夜の街へ歩き出す。次の戦いへ。", :imageUrl nil, :dialogue [{:text "赤羽千世。HN: aka_chise1。彼女の戦いは、続く。", :speaker "Narration"} {:text "さて、次は誰を守るか。", :speaker "Chise"}], :rect [0 0.6272 1 0.3728]}]} {:pageNumber 18, :title "Arc 0-3: 「やめたい…でも、怖い」 — 特待生の孤独", :panels [{:id nil, :panelNumber 1, :visual "星蘭学院の壮麗なキャンパス。緑豊かな庭園と近代的な校舎。制服姿の生徒たちが歩いている。", :imageUrl nil, :dialogue [{:text "都内屈指の名門校、星蘭学院。", :speaker "Narration"}], :rect [0 0 1 0.6106]} {:id nil, :panelNumber 2, :visual "青山ソラ（17歳）が図書館へ歩く。周囲の生徒が高級ブランドのバッグを持っている中、彼女のカバンは質素。", :imageUrl nil, :dialogue [{:text "学業特待生、青山ソラ。成績はトップクラス。", :speaker "Narration"}], :rect [0.506 0.6226 0.494 0.3774]} {:id nil, :panelNumber 3, :visual "ソラの表情。周囲との「違い」を意識しながら、それを隠そうとする強がり。", :imageUrl nil, :dialogue [{:text "（…大丈夫。ここにいる資格はある）", :speaker "Sora"}], :rect [0 0.6226 0.494 0.3774]}]} {:pageNumber 19, :title "Arc 0-3: 「やめたい…でも、怖い」 — 家庭の事情", :panels [{:id nil, :panelNumber 1, :visual "ソラの自宅マンション。清潔だが小さく、質素な家具。ソラが勉強机に向かっている。", :imageUrl nil, :dialogue [{:text "母子家庭。母は製薬会社の研究員。", :speaker "Narration"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "机の上に「塾費用のお知らせ」と書かれた紙。金額が赤く囲まれている。", :imageUrl nil, :dialogue [{:text "（また…値上がりしてる…）", :speaker "Sora"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "ソラがスマートフォンを手に取り、何かを検索し始める。", :imageUrl nil, :dialogue [{:text "お母さんに…これ以上負担かけたくない。", :speaker "Sora"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "スマートフォン画面。「高校生OK！簡単な情報収集で高時給」というSNS広告。", :imageUrl nil, :dialogue [{:text "『簡単な仕事で、高収入。』", :speaker "Narration"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 20, :title "Arc 0-3: 「やめたい…でも、怖い」 — 最初の一歩", :panels [{:id nil, :panelNumber 1, :visual "DMのやり取り画面。「簡単なアンケートに答えるだけ。報酬は3000円。」", :imageUrl nil, :dialogue [{:text "アンケートに答えるだけ。30分で3000円♪", :speaker "Unknown"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "ソラの迷う表情。指がスマホ画面の上で止まっている。", :imageUrl nil, :dialogue [{:text "（…怪しい？でも、アンケートだけなら…）", :speaker "Sora"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "「送金完了」の通知画面。口座に3000円が振り込まれている。", :imageUrl nil, :dialogue [{:text "（…本当に入った。これなら…）", :speaker "Sora"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "少し明るい表情のソラ。希望が見えた瞬間。", :imageUrl nil, :dialogue [{:text "自分でも…できる。", :speaker "Sora"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 21, :title "Arc 0-3: 「やめたい…でも、怖い」 — エスカレーション", :panels [{:id nil, :panelNumber 1, :visual "DMの履歴。報酬が5000円→1万円→3万円と上がっていく。", :imageUrl nil, :dialogue [{:text "次は商品レビューで1万円。もっと稼げる仕事もあるよ。", :speaker "Unknown"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "教室でスマホを気にするソラ。授業に集中できていない。", :imageUrl nil, :dialogue [{:text "（次の仕事、内容がよく分からない…でも報酬が…）", :speaker "Sora"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "新しいメッセージ。「お母さんの会社の資料、ちょっと見せてもらえない？」", :imageUrl nil, :dialogue [{:text "今度は特別な仕事。5万円。お母さんの仕事の資料、少しだけ見せて。", :speaker "Unknown"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "ソラの顔に恐怖が浮かぶ。何かがおかしいと気づき始める。", :imageUrl nil, :dialogue [{:text "（これは…ダメだ。やめよう）", :speaker "Sora"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 22, :title "Arc 0-3: 「やめたい…でも、怖い」 — 脅迫", :panels [{:id nil, :panelNumber 1, :visual "ソラが送った断りのメッセージ。「すみません。この仕事はできません。」", :imageUrl nil, :dialogue [{:text "すみません。これ以上は…できません。", :speaker "Sora"}], :rect [0.506 0 0.494 0.2698]} {:id nil, :panelNumber 2, :visual "相手からの返信。「今までの記録、全部あるんだよ」「学校に送ろうか？親に見せようか？」", :imageUrl nil, :dialogue [{:text "今までの記録、全部残ってるよ。学校にバラす？親にも送ろうか？", :speaker "Unknown"}], :rect [0 0 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "夜の駅前。ソラの震える手。顔は青ざめ、恐怖で固まっている。", :imageUrl nil, :dialogue [{:text "やめたい…でも、怖い…", :speaker "Sora"}], :rect [0 0.2818 1 0.2698]} {:id nil, :panelNumber 4, :visual "夜の街を一人で歩くソラ。周囲のネオンが冷たく光る。", :imageUrl nil, :dialogue [{:text "（どうしよう…誰にも言えない…）", :speaker "Sora"}], :rect [0 0.5635 1 0.4365]}]} {:pageNumber 23, :title "Arc 0-3: 「やめたい…でも、怖い」 — 異変に気づく者", :panels [{:id nil, :panelNumber 1, :visual "星蘭学院の生徒会室。優雅な内装。生徒会長の白川理香が窓辺に立っている。", :imageUrl nil, :dialogue [{:text "生徒会長・白川理香。法律事務所のパートナーを親に持つ。", :speaker "Narration"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "理香がKanameに話しかける。Kanameは白いスーツ姿で資料を見ている。", :imageUrl nil, :dialogue [{:text "水城くん、ちょっと相談があるの。", :speaker "Rika"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "Kanameの冷静な表情。しかし目には鋭い関心が浮かぶ。", :imageUrl nil, :dialogue [{:text "青山さん？特待生の？", :speaker "Kaname"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "心配そうな理香。ソラの状況を説明している。", :imageUrl nil, :dialogue [{:text "最近様子がおかしいの。授業中もぼんやりして、顔色も悪い。何かあったんじゃないかって…", :speaker "Rika"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 24, :title "Arc 0-3: 「やめたい…でも、怖い」 — Kanameの調査", :panels [{:id nil, :panelNumber 1, :visual "Kanameの書斎。高級感のあるデスクで複数のモニターを見ている。", :imageUrl nil, :dialogue [{:text "（特待生が、急に金を持ち始めた…？）", :speaker "Kaname"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "モニター画面。「闇バイト」「情報売買」「高校生ターゲット」などの検索結果。", :imageUrl nil, :dialogue [{:text "（最近増えている手口か…）", :speaker "Kaname"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "掲示板『News Hacker』。闇バイト被害のスレッドで情報を集めている。", :imageUrl nil, :dialogue [{:text "掲示板で被害パターンを分析。", :speaker "Narration"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "Kanameの目。確信を得た表情。", :imageUrl nil, :dialogue [{:text "星蘭の特待生を狙っている。…うちの学校が関わっているのか？", :speaker "Kaname"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 25, :title "Arc 0-3: 「やめたい…でも、怖い」 — 接触", :panels [{:id nil, :panelNumber 1, :visual "星蘭学院の図書館。Kanameがソラの席に近づく。", :imageUrl nil, :dialogue [{:text "青山さん、少し話せる？", :speaker "Kaname"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "警戒するソラ。目が泳いでいる。", :imageUrl nil, :dialogue [{:text "何の用ですか、水城先輩。私、何もないですけど…", :speaker "Sora"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "Kanameの表情。いつもの冷たさが少し和らいでいる。", :imageUrl nil, :dialogue [{:text "…逃げ道は、必ずある。一人で抱え込まなくていい。", :speaker "Kaname"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "ソラの目に涙がにじむ。壁が少し崩れ始める。", :imageUrl nil, :dialogue [{:text "…どうして、分かるんですか…", :speaker "Sora"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 26, :title "Arc 0-3: 「やめたい…でも、怖い」 — 告白", :panels [{:id nil, :panelNumber 1, :visual "人目のない部屋。ソラが座り、Kanameが向かいに座っている。", :imageUrl nil, :dialogue [{:text "…最初は、ただのアンケートだったんです。", :speaker "Sora"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "話し続けるソラ。声が震えている。", :imageUrl nil, :dialogue [{:text "でも、どんどん要求がエスカレートして…母の会社の資料を撮れって…", :speaker "Sora"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "ソラが崩れ始める。堰を切ったように言葉が溢れる。", :imageUrl nil, :dialogue [{:text "断ったら、今までの記録をバラすって…親にも学校にも…どうしよう…もう終わりだ…", :speaker "Sora"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "Kanameの目。決意の色が浮かぶ。", :imageUrl nil, :dialogue [{:text "終わらない。今から対処する。", :speaker "Kaname"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 27, :title "Arc 0-3: 「やめたい…でも、怖い」 — 協力者", :panels [{:id nil, :panelNumber 1, :visual "掲示板『News Hacker』。Kanameがスレッドに投稿している。HN「3pa11er3apiv0t」。", :imageUrl nil, :dialogue [{:text "（3pa11er3apiv0t）星蘭の特待生が狙われている。協力を求む。", :speaker "Kaname"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "自室でモニターを見るRen。気怠げだが、目は鋭い。", :imageUrl nil, :dialogue [{:text "…あのペンギンが助けを求めるとは。珍しい。", :speaker "Ren"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "Neiが画面を覗き込む。興味深そうな表情。", :imageUrl nil, :dialogue [{:text "闇バイト被害？…私たちの出番かも。", :speaker "Nei"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "RenとNeiが顔を見合わせる。阿吽の呼吸。", :imageUrl nil, :dialogue [{:text "…だるい。でも、放っておけない。", :speaker "Ren"} {:text "同感。", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 28, :title "Arc 0-3: 「やめたい…でも、怖い」 — 対面", :panels [{:id nil, :panelNumber 1, :visual "中立の場所（カフェの個室）。Kanameと、Ren・Neiが向かい合う。緊張感のある空気。", :imageUrl nil, :dialogue [{:text "Ghost Hacker…直接会うのは初めてだな。", :speaker "Kaname"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "Renの気怠げな表情。しかし目は相手を測っている。", :imageUrl nil, :dialogue [{:text "…スーツ。似合ってんな。", :speaker "Ren"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "Kanameの冷たい目。しかし敵意ではない。", :imageUrl nil, :dialogue [{:text "条件は一つ。被害者を守ることが最優先。", :speaker "Kaname"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "Renが小さく頷く。Neiが微笑む。", :imageUrl nil, :dialogue [{:text "…異論ない。", :speaker "Ren"} {:text "それなら、協力できる。", :speaker "Nei"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 29, :title "Arc 0-3: 「やめたい…でも、怖い」 — 対処開始", :panels [{:id nil, :panelNumber 1, :visual "ソラの前にKanameとNeiが座っている。ソラの表情はまだ怯えている。", :imageUrl nil, :dialogue [{:text "まず、口座を凍結する。これで向こうは何もできなくなる。", :speaker "Kaname"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "銀行アプリの画面。「口座凍結手続き完了」のメッセージ。", :imageUrl nil, :dialogue [{:text "凍結完了。もう動かせない。", :speaker "Nei"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "携帯キャリアの画面。「SIM停止・番号変更申請」。", :imageUrl nil, :dialogue [{:text "次、SIM停止。番号も変える。", :speaker "Kaname"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "ソラの表情に少し安堵が浮かぶ。", :imageUrl nil, :dialogue [{:text "これで…連絡は来なくなる？", :speaker "Sora"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 30, :title "Arc 0-3: 「やめたい…でも、怖い」 — 証拠保全", :panels [{:id nil, :panelNumber 1, :visual "Renがノートパソコンを操作している。", :imageUrl nil, :dialogue [{:text "脅迫メッセージ、全部スクショ撮った？", :speaker "Ren"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "脅迫メッセージのスクリーンショット。日時とアカウント名がはっきり映っている。", :imageUrl nil, :dialogue [{:text "証拠は全て保存。これがあれば警察も動ける。", :speaker "Nei"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "Kanameがスマートフォンで通話している。", :imageUrl nil, :dialogue [{:text "叔父さん、相談があるんですけど…星蘭の生徒が闘バイトに巻き込まれていて…", :speaker "Kaname"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "支援機関のリスト。警察相談ダイヤル #9110、消費者ホットライン 188 などが並ぶ。", :imageUrl nil, :dialogue [{:text "支援に繋げる。ここからは大人の出番だ。", :speaker "Kaname"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 31, :title "Arc 0-3: 「やめたい…でも、怖い」 — 黒幕の特定", :panels [{:id nil, :panelNumber 1, :visual "自室でキーボードを叩くRen。複数のウィンドウが開いている。", :imageUrl nil, :dialogue [{:text "（通信パターン追跡…この送金先は…）", :speaker "Ren"}], :rect [0.506 0 0.494 0.494]} {:id nil, :panelNumber 2, :visual "モニター画面に浮かび上がる情報。「野村隆」「星蘭学院 2018年卒」。", :imageUrl nil, :dialogue [{:text "見つけた。野村隆。星蘭の卒業生だ。", :speaker "Ren"}], :rect [0 0 0.494 0.494]} {:id nil, :panelNumber 3, :visual "報告を受けるKanameの表情。苛立ちが一瞬だけ顔に出る。", :imageUrl nil, :dialogue [{:text "卒業生が…後輩を食い物にしていたのか。", :speaker "Kaname"}], :rect [0.506 0.506 0.494 0.494]} {:id nil, :panelNumber 4, :visual "決意を固めるKaname。", :imageUrl nil, :dialogue [{:text "雑な犯罪は嫌いだ。…叔父に報告する。法的に追い詰める。", :speaker "Kaname"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 32, :title "Arc 0-3: 「やめたい…でも、怖い」 — 母への告白", :panels [{:id nil, :panelNumber 1, :visual "ソラの自宅。リビングでソラが母と向かい合っている。Neiが隣にいる。", :imageUrl nil, :dialogue [{:text "お母さん…話があるの。", :speaker "Sora"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "涙を流しながら話すソラ。", :imageUrl nil, :dialogue [{:text "私…バカなことをして…ごめんなさい…", :speaker "Sora"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "母がソラを抱きしめる。ソラの肩が震えている。", :imageUrl nil, :dialogue [{:text "…言ってくれてありがとう。一人で抱え込んでたのね…", :speaker "Mother"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "少し離れた場所で見守るNei。穏やかな表情。", :imageUrl nil, :dialogue [{:text "（言えた。…大丈夫）", :speaker "Nei"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 33, :title "Arc 0-3: 「やめたい…でも、怖い」 — 解決", :panels [{:id nil, :panelNumber 1, :visual "警察署の外観。ソラと母が中へ入っていく後ろ姿。", :imageUrl nil, :dialogue [{:text "被害届を提出。支援機関とも連携。", :speaker "Narration"}], :rect [0 0 1 0.4365]} {:id nil, :panelNumber 2, :visual "ニュース記事の見出し。「高校生を狙った闘バイト斡旋 逮捕」。", :imageUrl nil, :dialogue [{:text "野村隆、詐欺および脅迫の容疑で逮捕。", :speaker "Narration"}], :rect [0.506 0.4485 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "掲示板『News Hacker』。「3pa11er3apiv0t」の投稿。「解決。被害者は保護された。」", :imageUrl nil, :dialogue [{:text "（3pa11er3apiv0t）解決。被害者は保護された。", :speaker "NewsHacker"}], :rect [0 0.4485 0.494 0.2698]} {:id nil, :panelNumber 4, :visual "別のユーザーからの返信。「GJ」「ながふくろうとながねこも参戦してたな」。", :imageUrl nil, :dialogue [{:text "GJ。Ghost Hackerも動いてたみたいだな。", :speaker "NewsHacker"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 34, :title "Arc 0-3: 「やめたい…でも、怖い」 — 再生", :panels [{:id nil, :panelNumber 1, :visual "星蘭学院のキャンパス。朝日の中を歩くソラ。", :imageUrl nil, :dialogue [{:text "数週間後。", :speaker "Narration"}], :rect [0 0 1 0.3728]} {:id nil, :panelNumber 2, :visual "ソラがKanameに会釈する。Kanameが軽く頷く。", :imageUrl nil, :dialogue [{:text "水城先輩…あの時は、ありがとうございました。", :speaker "Sora"} {:text "…助けてって言えた。それが一番大事なことだ。", :speaker "Kaname"}], :rect [0.506 0.3848 0.494 0.2304]} {:id nil, :panelNumber 3, :visual "ソラの表情。まだ完全ではないが、希望を取り戻した目。", :imageUrl nil, :dialogue [{:text "まだ怖いことも、恥ずかしいこともある。でも…一人じゃないって、分かったから。", :speaker "Sora"}], :rect [0 0.3848 0.494 0.2304]} {:id nil, :panelNumber 4, :visual "校舎へ向かうソラの後ろ姿。背中に貼り付いていた影が薄れていく。", :imageUrl nil, :dialogue [{:text "（戻れる。ここから、やり直せる）", :speaker "Sora"}], :rect [0 0.6272 1 0.3728]}]} {:pageNumber 35, :title "Arc 0-3: 「やめたい…でも、怖い」 — 次なる道へ", :panels [{:id nil, :panelNumber 1, :visual "生徒会室の窓辺に立つKaname。夕日が差し込んでいる。", :imageUrl nil, :dialogue [{:text "（感情で動くことは、弱さじゃない…か）", :speaker "Kaname"}], :rect [0.506 0 0.494 0.2698]} {:id nil, :panelNumber 2, :visual "Kanameの目。いつもの冷たさに、何か新しいものが混じっている。", :imageUrl nil, :dialogue [{:text "（Ren…お前の直感は認める。今回は）", :speaker "Kaname"}], :rect [0 0 0.494 0.2698]} {:id nil, :panelNumber 3, :visual "学校を出て歩き出すKaname。どこかへ向かっている。", :imageUrl nil, :dialogue [{:text "一人で抱え込まなくていい。逃げ道は、必ずある。", :speaker "Narration"}], :rect [0 0.2818 1 0.4365]} {:id nil, :panelNumber 4, :visual "黒背景に白文字。「Arc 0-3 - End」「To be continued...」", :imageUrl nil, :dialogue [], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 36, :title "家族で守る - スマホ安全設定ガイド — 親の不安 - 美咲の相談", :panels [{:id "panel:pss-p1n1-misaki-worried", :panelNumber 1, :visual "リビングルームで携帯を見つめる美咲。心配そうな表情。窓から午後の光。", :imageUrl nil, :dialogue [{:text "Yutoのこと…やっぱり心配で…", :speaker "Misaki"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p1n2-news-on-tv", :panelNumber 2, :visual "テレビ画面。「SNSトラブルで中学生が被害」のニュースが映っている。", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p1n3-misaki-thinking", :panelNumber 3, :visual "美咲の顔のアップ。不安と焦りの表情。", :imageUrl nil, :dialogue [{:text "（スマホの設定…何をすればいいのかわからない…）", :speaker "Misaki"}], :rect [0.3894 0.506 0.6106 0.494]} {:id "panel:pss-p1n4-smartphone", :panelNumber 4, :visual "美咲のスマートフォン。連絡先リストに「Nei」の名前が表示されている。", :imageUrl nil, :dialogue [], :rect [0 0.506 0.3774 0.494]}]} {:pageNumber 37, :title "家族で守る - スマホ安全設定ガイド — 親の不安 - Neiへの連絡", :panels [{:id "panel:pss-p2n1-video-call", :panelNumber 1, :visual "ビデオ通話画面。左に美咲、右にNeiが映っている。", :imageUrl nil, :dialogue [{:text "Neiさん、相談があるんですけど…", :speaker "Misaki"}], :rect [0.506 0 0.494 0.494]} {:id "panel:pss-p2n2-nei-listening", :panelNumber 2, :visual "Neiが画面越しに優しく微笑んでいる。背景は整理されたデスク。", :imageUrl nil, :dialogue [{:text "はい、なんでしょう？", :speaker "Nei"}], :rect [0 0 0.494 0.494]} {:id "panel:pss-p2n3-misaki-explaining", :panelNumber 3, :visual "美咲が困った表情で説明している。", :imageUrl nil, :dialogue [{:text "Yutoの事件のあと…子供のスマホをどう設定すればいいか、わからなくて…", :speaker "Misaki"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p2n4-nei-understanding", :panelNumber 4, :visual "Neiが笑顔で応える。背景にはパソコンのディスプレイ。", :imageUrl nil, :dialogue [{:text "わかりました。一緒に確認していきましょう！", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 38, :title "家族で守る - スマホ安全設定ガイド — 親の不安 - Yutoも参加", :panels [{:id "panel:pss-p3n1-yuto-enters", :panelNumber 1, :visual "Yutoがリビングに入ってくる。美咲が振り返る。", :imageUrl nil, :dialogue [{:text "…僕も聞きたい", :speaker "Yuto"}], :rect [0.506 0 0.494 0.2698]} {:id "panel:pss-p3n2-misaki-surprised", :panelNumber 2, :visual "美咲の驚いた表情。", :imageUrl nil, :dialogue [{:text "Yuto…", :speaker "Misaki"}], :rect [0 0 0.494 0.2698]} {:id "panel:pss-p3n3-ren-joins", :panelNumber 3, :visual "画面にRenも加わる。Neiの隣に座っている。", :imageUrl nil, :dialogue [{:text "俺も手伝うよ。技術的なところは任せて", :speaker "Ren"}], :rect [0 0.2818 1 0.2698]} {:id "panel:pss-p3n4-group-ready", :panelNumber 4, :visual "4人が画面越しに揃った様子。協力的な雰囲気。", :imageUrl nil, :dialogue [{:text "じゃあ、みんなで一緒に学んでいきましょう！", :speaker "Nei"}], :rect [0 0.5635 1 0.4365]}]} {:pageNumber 39, :title "家族で守る - スマホ安全設定ガイド — 親の不安 - 決意", :panels [{:id "panel:pss-p4n1-yuto-apology", :panelNumber 1, :visual "Yutoが俯いている。反省の表情。", :imageUrl nil, :dialogue [{:text "あの時…僕がちゃんとわかってれば…", :speaker "Yuto"}], :rect [0.506 0 0.494 0.494]} {:id "panel:pss-p4n2-misaki-comfort", :panelNumber 2, :visual "美咲がYutoの肩に手を置いて励ます。", :imageUrl nil, :dialogue [{:text "これからは一緒に学ぼう、ね？", :speaker "Misaki"}], :rect [0 0 0.494 0.494]} {:id "panel:pss-p4n3-nei-intro", :panelNumber 3, :visual "Neiが画面に資料を映す準備をしている。", :imageUrl nil, :dialogue [{:text "では始めましょう。まずは『設定の3本柱』から！", :speaker "Nei"}], :rect [0.3894 0.506 0.6106 0.494]} {:id "panel:pss-p4n4-chapter-title", :panelNumber 4, :visual "章タイトル：「第1章：設定の3本柱」の文字が表示される。", :imageUrl nil, :dialogue [], :rect [0 0.506 0.3774 0.494]}]} {:pageNumber 40, :title "家族で守る - スマホ安全設定ガイド — 設定の3本柱 - 全体像", :panels [{:id "panel:pss-p5n1-nei-explains", :panelNumber 1, :visual "Neiが画面共有でプレゼンテーションを見せている。", :imageUrl nil, :dialogue [{:text "スマホの安全設定には、大きく3つの柱があります", :speaker "Nei"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p5n2-pillar-diagram", :panelNumber 2, :visual "3本の柱の図解。①コンテンツ制限 ②時間管理 ③課金制御", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p5n3-pillar1", :panelNumber 3, :visual "コンテンツ制限のアイコン（フィルターマーク）が強調表示。", :imageUrl nil, :dialogue [{:text "①コンテンツ制限：何を見せるか、見せないか", :speaker "Nei"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p5n4-pillar2-3", :panelNumber 4, :visual "時計のアイコンと財布のアイコンが表示されている図解。", :imageUrl nil, :dialogue [{:text "②時間管理：いつ、どれくらい使うか\n③課金制御：お金の使い方を管理", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 41, :title "家族で守る - スマホ安全設定ガイド — 設定の3本柱 - 理解", :panels [{:id "panel:pss-p6n1-misaki-understanding", :panelNumber 1, :visual "美咲が納得した表情でメモを取っている。", :imageUrl nil, :dialogue [{:text "なるほど…3つに分けて考えればいいんですね", :speaker "Misaki"}], :rect [0.506 0 0.494 0.494]} {:id "panel:pss-p6n2-ren-adds", :panelNumber 2, :visual "Renが画面越しにアドバイスしている。", :imageUrl nil, :dialogue [{:text "全部一度にやろうとすると大変だから、一つずつ確実に", :speaker "Ren"}], :rect [0 0 0.494 0.494]} {:id "panel:pss-p6n3-yuto-question", :panelNumber 3, :visual "Yutoが興味深そうに画面を見ている。", :imageUrl nil, :dialogue [{:text "まずはどこから始めればいい？", :speaker "Yuto"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p6n4-nei-youtube", :panelNumber 4, :visual "NeiがYouTubeのロゴを表示した画面を見せている。", :imageUrl nil, :dialogue [{:text "まずは一番使うであろうYouTubeから！", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 42, :title "家族で守る - スマホ安全設定ガイド — YouTube設定 - 制限付きモード", :panels [{:id "panel:pss-p7n1-youtube-intro", :panelNumber 1, :visual "NeiがYouTubeアプリの画面を見せている。", :imageUrl nil, :dialogue [{:text "まずは『制限付きモード』を設定しましょう", :speaker "Nei"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p7n2-step1-2", :panelNumber 2, :visual "YouTubeアプリのスクリーンショット。①右上のプロフィールアイコン ②「設定」をタップ", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p7n3-step3-4", :panelNumber 3, :visual "YouTube設定画面。③「全般」をタップ ④「制限付きモード」のトグルが表示", :imageUrl nil, :dialogue [], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p7n4-step5", :panelNumber 4, :visual "「制限付きモード」がオンになった状態の画面。チェックマーク付き。", :imageUrl nil, :dialogue [{:text "これで成人向けコンテンツの多くがフィルタリングされる", :speaker "Ren"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 43, :title "家族で守る - スマホ安全設定ガイド — YouTube設定 - YouTube Kids", :panels [{:id "panel:pss-p8n1-kids-intro", :panelNumber 1, :visual "NeiがYouTube Kidsのアイコンを見せている。", :imageUrl nil, :dialogue [{:text "13歳未満のお子さんには『YouTube Kids』がおすすめ", :speaker "Nei"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p8n2-kids-features", :panelNumber 2, :visual "YouTube Kidsの特徴図解：年齢別コンテンツ、タイマー機能、検索制限", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p8n3-misaki-question", :panelNumber 3, :visual "美咲が質問している表情。", :imageUrl nil, :dialogue [{:text "普通のYouTubeとは別のアプリなんですか？", :speaker "Misaki"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p8n4-ren-explains", :panelNumber 4, :visual "Renが説明している。", :imageUrl nil, :dialogue [{:text "そう。子供向けに特化していて、より安全なコンテンツだけが表示される", :speaker "Ren"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 44, :title "家族で守る - スマホ安全設定ガイド — YouTube設定 - YouTube Kidsセットアップ", :panels [{:id "panel:pss-p9n1-setup-steps", :panelNumber 1, :visual "App Store/Google Playの画面。YouTube Kidsのダウンロード画面。", :imageUrl nil, :dialogue [], :rect [0.506 0 0.494 0.494]} {:id "panel:pss-p9n2-profile-setup", :panelNumber 2, :visual "YouTube Kidsの初期設定画面。子供のプロフィール作成ステップ。", :imageUrl nil, :dialogue [], :rect [0 0 0.494 0.494]} {:id "panel:pss-p9n3-age-selection", :panelNumber 3, :visual "年齢選択画面。「未就学児」「小学1-2年」「小学3-6年」の選択肢。", :imageUrl nil, :dialogue [], :rect [0.6226 0.506 0.3774 0.494]} {:id "panel:pss-p9n4-yuto-comment", :panelNumber 4, :visual "Yutoが前向きな表情で言っている。", :imageUrl nil, :dialogue [{:text "弟がいる友達にも教えてあげよう", :speaker "Yuto"}], :rect [0 0.506 0.6106 0.494]}]} {:pageNumber 45, :title "家族で守る - スマホ安全設定ガイド — YouTube設定 - ファミリーリンク連携", :panels [{:id "panel:pss-p10n1-family-link-intro", :panelNumber 1, :visual "Renがファミリーリンクのアイコンを見せている。", :imageUrl nil, :dialogue [{:text "YouTubeはGoogleファミリーリンクと連携できる", :speaker "Ren"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p10n2-benefits", :panelNumber 2, :visual "ファミリーリンク連携のメリット図解：視聴履歴確認、時間制限、チャンネルブロック", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p10n3-nei-note", :panelNumber 3, :visual "NeiがiPhoneのアイコンを見せている。", :imageUrl nil, :dialogue [{:text "次はiOSの設定について説明しますね！", :speaker "Nei"}], :rec