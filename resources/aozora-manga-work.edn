speaker "Ren"}], :rect [0 0.506 0.6106 0.494]}]} {:pageNumber 61, :title "家族で守る - スマホ安全設定ガイド — SNS設定 - 共通ポイント", :panels [{:id "panel:pss-p26n1-common-points", :panelNumber 1, :visual "Neiがチェックリストを表示している。", :imageUrl nil, :dialogue [{:text "どのSNSでも共通する設定ポイントをまとめますね", :speaker "Nei"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p26n2-checklist", :panelNumber 2, :visual "チェックリスト：□非公開アカウント □メッセージ制限 □位置情報オフ □ペアレンタルコントロール", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p26n3-misaki-noting", :panelNumber 3, :visual "美咲がメモを取っている。", :imageUrl nil, :dialogue [{:text "メモしておきます…あとで確認しながら設定しますね", :speaker "Misaki"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p26n4-transition", :panelNumber 4, :visual "Neiがクレジットカードのアイコンを見せている。", :imageUrl nil, :dialogue [{:text "次は課金・購入の管理について！", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 62, :title "家族で守る - スマホ安全設定ガイド — 課金管理 - 概要", :panels [{:id "panel:pss-p27n1-purchase-intro", :panelNumber 1, :visual "Renが課金被害の統計を見せている。", :imageUrl nil, :dialogue [{:text "ゲームの課金トラブルは本当に多い。数十万円の請求が来るケースも", :speaker "Ren"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p27n2-news-example", :panelNumber 2, :visual "ニュース記事のイメージ：「子供がゲームで100万円課金」の見出し", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p27n3-misaki-worried", :panelNumber 3, :visual "美咲が心配そうな表情。", :imageUrl nil, :dialogue [{:text "そんなことが…怖いですね", :speaker "Misaki"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p27n4-nei-reassure", :panelNumber 4, :visual "Neiが安心させるように話している。", :imageUrl nil, :dialogue [{:text "でも設定すれば防げます。一緒に見ていきましょう", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 63, :title "家族で守る - スマホ安全設定ガイド — 課金管理 - iOS設定", :panels [{:id "panel:pss-p28n1-ios-purchase", :panelNumber 1, :visual "NeiがiOS設定画面を見せている。", :imageUrl nil, :dialogue [{:text "iOSでは『Ask to Buy』と『App内課金の無効化』が有効です", :speaker "Nei"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p28n2-ask-to-buy", :panelNumber 2, :visual "Ask to Buyの仕組み図解：子供がリクエスト→親に通知→承認/拒否", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p28n3-disable-iap", :panelNumber 3, :visual "App内課金設定。「App内課金：許可しない」が選択されている画面。", :imageUrl nil, :dialogue [], :rect [0.6226 0.506 0.3774 0.494]} {:id "panel:pss-p28n4-password-always", :panelNumber 4, :visual "Renがアドバイスしている。", :imageUrl nil, :dialogue [{:text "購入時のパスワード要求は『常に』に設定しておくこと", :speaker "Ren"}], :rect [0 0.506 0.6106 0.494]}]} {:pageNumber 64, :title "家族で守る - スマホ安全設定ガイド — 課金管理 - Android設定", :panels [{:id "panel:pss-p29n1-android-purchase", :panelNumber 1, :visual "RenがAndroid設定を見せている。", :imageUrl nil, :dialogue [{:text "AndroidはGoogle Playの認証設定とファミリーリンクを併用", :speaker "Ren"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p29n2-auth-setting", :panelNumber 2, :visual "Google Play認証設定。「すべての購入で認証が必要」が選択されている。", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p29n3-budget", :panelNumber 3, :visual "予算設定画面。月額の予算が設定されている例。", :imageUrl nil, :dialogue [], :rect [0.6226 0.506 0.3774 0.494]} {:id "panel:pss-p29n4-yuto-idea", :panelNumber 4, :visual "Yutoがアイデアを出している。", :imageUrl nil, :dialogue [{:text "プリペイドカード方式なら、上限が明確でいいかも", :speaker "Yuto"}], :rect [0 0.506 0.6106 0.494]}]} {:pageNumber 65, :title "家族で守る - スマホ安全設定ガイド — 課金管理 - ベストプラクティス", :panels [{:id "panel:pss-p30n1-tips-intro", :panelNumber 1, :visual "Neiがまとめスライドを見せている。", :imageUrl nil, :dialogue [{:text "課金管理のコツをまとめますね", :speaker "Nei"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p30n2-tips-list", :panelNumber 2, :visual "Tips一覧：①クレジットカード情報は保存しない ②プリペイドカード方式 ③定期的に履歴確認 ④ゲーム内設定も確認", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p30n3-misaki-understanding", :panelNumber 3, :visual "美咲が納得した表情。", :imageUrl nil, :dialogue [{:text "「今月はここまで」って境界を作るのが大切なんですね", :speaker "Misaki"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p30n4-transition", :panelNumber 4, :visual "Neiが真剣な表情になる。", :imageUrl nil, :dialogue [{:text "最後に…一番大切なことをお伝えします", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 66, :title "家族で守る - スマホ安全設定ガイド — 対話の重要性 - 設定だけでは守れない", :panels [{:id "panel:pss-p31n1-nei-message", :panelNumber 1, :visual "Neiが優しく、でも真剣に話している。", :imageUrl nil, :dialogue [{:text "設定は『鍵』のようなもの。家に鍵をかけるのは大切だけど…", :speaker "Nei"}], :rect [0.3894 0 0.6106 0.494]} {:id "panel:pss-p31n2-key-metaphor", :panelNumber 2, :visual "鍵と家の比喩イラスト。鍵だけでは家族を守れないことを示す。", :imageUrl nil, :dialogue [], :rect [0 0 0.3774 0.494]} {:id "panel:pss-p31n3-ren-message", :panelNumber 3, :visual "Renが真剣に話している。", :imageUrl nil, :dialogue [{:text "大事なのは、なぜその設定が必要か、一緒に考えること。監視じゃなくて、信頼の上に立った約束", :speaker "Ren"}], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p31n4-nei-growth", :panelNumber 4, :visual "Neiが温かい笑顔で締めくくる。", :imageUrl nil, :dialogue [{:text "子供は成長する。設定も、関係も、アップデートが必要。定期的に話し合ってね", :speaker "Nei"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 67, :title "家族で守る - スマホ安全設定ガイド — 対話の重要性 - 新たな始まり", :panels [{:id "panel:pss-p32n1-misaki-realization", :panelNumber 1, :visual "美咲が気づきを得た表情。目に涙が浮かんでいる。", :imageUrl nil, :dialogue [{:text "設定のことばかり考えてたけど…一番大切なのは、Yutoと話すことなんですね", :speaker "Misaki"}], :rect [0.506 0 0.494 0.494]} {:id "panel:pss-p32n2-yuto-response", :panelNumber 2, :visual "Yutoが真剣な表情で母親を見ている。", :imageUrl nil, :dialogue [{:text "…僕も、もっと早く相談すればよかった。これからは、ちゃんと話すよ", :speaker "Yuto"}], :rect [0 0 0.494 0.494]} {:id "panel:pss-p32n3-mother-son", :panelNumber 3, :visual "美咲とYutoが向き合い、微笑み合っている。窓から夕日が差し込む。", :imageUrl nil, :dialogue [], :rect [0.506 0.506 0.494 0.494]} {:id "panel:pss-p32n4-nei-ren-farewell", :panelNumber 4, :visual "NeiとRenが笑顔で手を振っている。画面越しに見守る二人。「第1章 完」の文字。", :imageUrl nil, :dialogue [{:text "困ったことがあったら、いつでも相談してくださいね！", :speaker "Nei"} {:text "俺たちはいつでもここにいるから", :speaker "Ren"}], :rect [0 0.506 0.494 0.494]}]} {:pageNumber 68, :title "Arc 0-1: 「パスワードは覚えるな」 — プレタイトル - 恐怖の夜", :panels [{:id "panel:p0n1-dark-room", :panelNumber 1, :visual "夜。Yutoの部屋全景。暗い部屋でYutoが毛布を被って丸まっている。窓からわずかな街灯の光。重苦しい雰囲気。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/0/p0n1-dark-room_v2.png", :dialogue [], :rect [0 0 1 0.4365], :tilt 20} {:id "panel:p0n2-fearful-yuto", :panelNumber 2, :visual "ベッドで膝を抱えるYuto。恐怖の表情でスマホを見つめる。眠れない夜が続き、目の下にクマ。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/0/p0n2-fearful-yuto_v2.png", :dialogue [], :rect [0.3894 0.4485 0.6106 0.2698]} {:id "panel:p0n3-angry-notifications", :panelNumber 3, :visual "スマホ画面のアップ。大量の通知バッジ。SNSのDM通知「許さない」「なんで俺まで」「最低」の文字が見える。赤い通知アイコンが不吉に光る。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/0/p0n3-angry-notifications_v2.png", :dialogue [], :rect [0 0.4485 0.3774 0.2698]} {:id "panel:p0n4-terror-eyes", :panelNumber 4, :visual "Yutoの目だけのアップ。通知音に怯え、瞳孔が開いている。額に冷や汗。恐怖に支配された目。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/0/p0n4-terror-eyes_v2.png", :dialogue [{:text "（また…通知…）", :speaker "Yuto"}], :rect [0 0.7302 1 0.2698]}]} {:pageNumber 69, :title "Arc 0-1: 「パスワードは覚えるな」 — タイトルスプレッド（左）", :panels [{:id "panel:8O_Ec3v5MRHx", :panelNumber 1, :visual "東京の街並み、上空。RenとNeiがジャンプしている動的なシーン。タイトル「Ghost Hacker」が大きく入る。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/1/8O_Ec3v5MRHx_v1.png", :dialogue [], :rect [0 0 1 1], :tilt 20}]} {:pageNumber 70, :title "Arc 0-1: 「パスワードは覚えるな」 — タイトルスプレッド（右）", :panels [{:id "panel:oFLWR9TcfBWC", :panelNumber 1, :visual "見開き続き。東京タワーやビル群を背景に、二人が着地するシーン。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/2/oFLWR9TcfBWC_v1.png", :dialogue [], :rect [0 0 1 1], :tilt 20}]} {:pageNumber 71, :title "Arc 0-1: 「パスワードは覚えるな」 — 登校 - 学校への導入", :panels [{:id "panel:bunxCXCEnG8a", :panelNumber 1, :visual "中学校の正門。登校する生徒たち。朝の光が差し込み、温かみのある雰囲気。校名のプレートが見える。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/3/bunxCXCEnG8a_v1.png", :dialogue [], :rect [0 0 1 0.2247]} {:id "panel:TsFzNph3jkdB", :panelNumber 2, :visual "校舎の全景。玄関に向かう生徒たち。その中にYutoの姿。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/3/TsFzNph3jkdB_v1.png", :dialogue [], :rect [0 0.2367 1 0.2247]} {:id "panel:5uBCJi-u3L45", :panelNumber 3, :visual "休憩時間の教室全景。生徒たちが机を囲んで和やかに話している。MeiとSakiが隣同士で仲良さそう。窓から柔らかい光。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/3/5uBCJi-u3L45_v1.png", :dialogue [], :rect [0 0.4735 1 0.2247]} {:id "panel:VjC4xWjN3zXh", :panelNumber 4, :visual "MeiとSakiが並んで座っている。Meiが伸びをし、Sakiが笑顔で返す。親友の雰囲気。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/3/VjC4xWjN3zXh_v1.png", :dialogue [{:text "今日さ、体育ないの神〜", :speaker "Mei"} {:text "わかる〜！Meiとお喋りできる時間増えるじゃん", :speaker "Saki"} {:text "俺は体育あった方がいいけどな〜、座りっぱなしダルいし", :speaker "Akira"}], :rect [0.506 0.7102 0.494 0.1389]} {:id "panel:N9XqqSr8KpAa", :panelNumber 5, :visual "Akiraが得意げにスニーカーを見せびらかす。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/3/N9XqqSr8KpAa_v5.png", :dialogue [{:text "見てこれ！限定モデル、やっとゲットしたわ", :speaker "Akira"}], :rect [0 0.7102 0.494 0.1389]} {:id nil, :panelNumber 5, :visual "スニーカーのアップ。ブランドロゴが光る限定モデル。", :imageUrl nil, :dialogue [{:text "うわ、マジ？それ即完売だったやつじゃん！", :speaker "Ken"} {:text "発売30秒で勝負ついたわ。指の速さがモノを言う", :speaker "Akira"} {:text "えー、いくらしたの？", :speaker "Mei"} {:text "定価で2万5千。転売だと5万超えてたからな", :speaker "Akira"}], :rect [0.6226 0.8611 0.3774 0.1389]} {:id "panel:qNP1CbxYU9iR", :panelNumber 6, :visual "Yutoの羨望の眼差し。輪から少し離れた位置で見ている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/3/qNP1CbxYU9iR_v1.png", :dialogue [{:text "Yutoも欲しいんだろ？顔に書いてあるぞ", :speaker "Akira"} {:text "えっ、いや、まぁ…カッコいいなって", :speaker "Yuto"} {:text "（2万5千か…お年玉貯めれば…）", :speaker "Yuto"}], :rect [0 0.8611 0.6106 0.1389]}]} {:pageNumber 72, :title "Arc 0-1: 「パスワードは覚えるな」 — 教室続き - Ren/Nei", :panels [{:id "panel:6aRQ5MXxPcNL", :panelNumber 1, :visual "教室の隅。賑やかなグループとは離れた静かな空間。Renは机に突っ伏し、Neiは窓際。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/4/6aRQ5MXxPcNL_v1.png", :dialogue [], :rect [0 0 1 0.4365]} {:id "panel:giBULx0BO_4Y", :panelNumber 2, :visual "机に突っ伏したRen。目だけ開いている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/4/giBULx0BO_4Y_v1.png", :dialogue [], :rect [0.506 0.4485 0.494 0.2698]} {:id "panel:FV5tRdjlME-e", :panelNumber 3, :visual "窓際で本を読むNei。穏やかな光に包まれている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/4/FV5tRdjlME-e_v1.png", :dialogue [], :rect [0 0.4485 0.494 0.2698]} {:id "panel:tvYfmqSDRydk", :panelNumber 4, :visual "Renが大きく欠伸をする。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/4/tvYfmqSDRydk_v1.png", :dialogue [{:text "（あー、だりぃ…）", :speaker "Ren"}], :rect [0.3894 0.7302 0.6106 0.2698]} {:id "panel:H2onTZckx-ZE", :panelNumber 5, :visual "窓の外。青い空と雲。平和な日常の象徴。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/4/H2onTZckx-ZE_v1.png", :dialogue [], :rect [0 0.7302 0.3774 0.2698]}]} {:pageNumber 73, :title "Arc 0-1: 「パスワードは覚えるな」 — 夜ベッド - 偽サイト発見", :panels [{:id "panel:VogWvAuFVTrx", :panelNumber 1, :visual "夜。暗いYutoの部屋全景。ベッドに寝転がるYuto、スマホの光だけが部屋を照らす。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/5/VogWvAuFVTrx_v1.png", :dialogue [], :rect [0 0 1 0.3378]} {:id "panel:0NyoX8f9OYco", :panelNumber 2, :visual "スマホをスクロールする指。画面の光が顔に反射。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/5/0NyoX8f9OYco_v1.png", :dialogue [], :rect [0.3894 0.3498 0.6106 0.2087]} {:id "panel:poSZyZbgedbz", :panelNumber 3, :visual "SNSタイムラインをスクロール中。広告バナーが現れる。「緊急入荷！」の文字。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/5/poSZyZbgedbz_v1.png", :dialogue [], :rect [0 0.3498 0.3774 0.2087]} {:id "panel:gJO7ciMtLLdC", :panelNumber 4, :visual "Yutoの目が見開く。驚きの表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/5/gJO7ciMtLLdC_v1.png", :dialogue [{:text "えっ、安っ！？", :speaker "Yuto"}], :rect [0.3894 0.5705 0.6106 0.2087]} {:id "panel:hzMkPY9ceA6-", :panelNumber 5, :visual "「アクター通販」偽サイトの商品ページ。Akiraが見せたのと同じスニーカー。80%OFF。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/5/hzMkPY9ceA6-_v1.png", :dialogue [], :rect [0 0.5705 0.3774 0.2087]} {:id "panel:00rLDpJa0WiX", :panelNumber 6, :visual "画面を見つめるYuto。欲望と焦りが入り混じった表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/5/00rLDpJa0WiX_v1.png", :dialogue [{:text "時間限定…？マジか…", :speaker "Yuto"} {:text "（今買わないと、なくなる…！）", :speaker "Yuto"}], :rect [0 0.7913 1 0.2087]}]} {:pageNumber 74, :title "Arc 0-1: 「パスワードは覚えるな」 — 葛藤", :panels [{:id "panel:_mD1Dek22ABr", :panelNumber 1, :visual "Yutoの葛藤する表情。唇を噛んでいる。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/6/_mD1Dek22ABr_v1.png", :dialogue [{:text "怪しいけど…", :speaker "Yuto"}], :rect [0.3894 0 0.6106 0.3253]} {:id "panel:mCsug9HFeM5r", :panelNumber 2, :visual "サイトのロゴ。大手っぽいデザイン。「安心のカスタマーサポート」の文字。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/6/mCsug9HFeM5r_v1.png", :dialogue [{:text "でも大手っぽいし…", :speaker "Yuto"}], :rect [0 0 0.3774 0.3253]} {:id "panel:PUQxHR-aQMYt", :panelNumber 3, :visual "5つ星レビューがずらりと並ぶ。「最高！」「すぐ届いた！」「本物でした！」（全て偽）", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/6/PUQxHR-aQMYt_v1.png", :dialogue [], :rect [0.6226 0.3373 0.3774 0.3253], :tilt 20} {:id "panel:mwPj4LlGLNLh", :panelNumber 4, :visual "自分を説得するような表情。目がレビューを追っている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/6/mwPj4LlGLNLh_v1.png", :dialogue [{:text "レビューもいいし…大丈夫だよな…", :speaker "Yuto"}], :rect [0 0.3373 0.6106 0.3253], :tilt 20} {:id "panel:gMwKLYtgOxWH", :panelNumber 5, :visual "指が画面に触れようとする瞬間。決断の直前。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/6/gMwKLYtgOxWH_v1.png", :dialogue [{:text "（…買おう）", :speaker "Yuto"}], :rect [0 0.6747 1 0.3253]}]} {:pageNumber 75, :title "Arc 0-1: 「パスワードは覚えるな」 — カード入力・決済", :panels [{:id "panel:VvmuSXI067Ty", :panelNumber 1, :visual "Yutoがベッドから起き上がり、リビングへ向かう。薄暗い廊下。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/7/VvmuSXI067Ty_v1.png", :dialogue [], :rect [0.506 0 0.494 0.241]} {:id "panel:rhfOaxIBg52a", :panelNumber 2, :visual "親のバッグ。財布が見える。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/7/rhfOaxIBg52a_v1.png", :dialogue [], :rect [0 0 0.494 0.241]} {:id "panel:Bm_1GGAJEERE", :panelNumber 3, :visual "財布からカードを抜き取る手。罪悪感で震えている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/7/Bm_1GGAJEERE_v1.png", :dialogue [{:text "ママのカード…ちょっとだけ…", :speaker "Yuto"}], :rect [0.506 0.253 0.494 0.241], :tilt 10} {:id "panel:Gf0ERC-yxaDQ", :panelNumber 4, :visual "部屋に戻り、カードを手にスマホを見るYuto。真剣な表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/7/Gf0ERC-yxaDQ_v1.png", :dialogue [], :rect [0 0.253 0.494 0.241], :tilt 10} {:id "panel:xc8qGx_iyvgl", :panelNumber 5, :visual "クレジットカード情報入力画面。番号を一桁ずつ入力中。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/7/xc8qGx_iyvgl_v1.png", :dialogue [], :rect [0.506 0.506 0.494 0.241]} {:id "panel:fbZGDuz-L2Oz", :panelNumber 6, :visual "セキュリティコード入力。最後の3桁。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/7/fbZGDuz-L2Oz_v1.png", :dialogue [], :rect [0 0.506 0.494 0.241]} {:id "panel:YXbO2cemJo36", :panelNumber 7, :visual "「購入」ボタン。指が触れる瞬間。ドラマチックな一瞬。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/7/YXbO2cemJo36_v1.png", :dialogue [{:text "（…ポチッ）", :speaker "Yuto"}], :rect [0 0.759 1 0.241]}]} {:pageNumber 76, :title "Arc 0-1: 「パスワードは覚えるな」 — 購入完了", :panels [{:id "panel:6GT_vj_bEDHg", :panelNumber 1, :visual "「購入完了！」のポップアップ。紙吹雪のアニメーション表現。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/8/6GT_vj_bEDHg_v1.png", :dialogue [], :rect [0.506 0 0.494 0.2698]} {:id "panel:ZqMHPdX5dL2A", :panelNumber 2, :visual "「明日発送予定」「お届け予定：翌日」の確認画面。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/8/ZqMHPdX5dL2A_v1.png", :dialogue [], :rect [0 0 0.494 0.2698]} {:id "panel:pB2Mm_da2yAO", :panelNumber 3, :visual "安堵の息をつくYuto。緊張が解ける。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/8/pB2Mm_da2yAO_v1.png", :dialogue [{:text "やった！明日届く！", :speaker "Yuto"}], :rect [0.506 0.2818 0.494 0.2698]} {:id "panel:dXHLR_uHF8RO", :panelNumber 4, :visual "ベッドに仰向けに倒れ込む。スマホを胸に抱えて、満足げな笑顔。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/8/dXHLR_uHF8RO_v1.png", :dialogue [{:text "Akiraに自慢してやる…！", :speaker "Yuto"}], :rect [0 0.2818 0.494 0.2698]} {:id "panel:9I2g5kLSTQqx", :panelNumber 5, :visual "夜の部屋。幸せそうに眠りにつくYuto。不穏な静けさ。窓の外は暗い。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/8/9I2g5kLSTQqx_v1.png", :dialogue [], :rect [0 0.5635 1 0.4365], :tilt 10}]} {:pageNumber 77, :title "Arc 0-1: 「パスワードは覚えるな」 — 翌日学校", :panels [{:id "panel:8kVf1H5H2on6", :panelNumber 1, :visual "翌日。授業中の教室全景。黒板に先生、生徒たちは真剣に聞いている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/9/8kVf1H5H2on6_v1.png", :dialogue [], :rect [0 0 1 0.4365]} {:id "panel:EaVFjwjnHxof", :panelNumber 2, :visual "席に座るYuto。落ち着かない様子。机の下で足が動いている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/9/EaVFjwjnHxof_v1.png", :dialogue [], :rect [0.506 0.4485 0.494 0.2698]} {:id "panel:ZCytwLcADRV9", :panelNumber 3, :visual "チラリと壁の時計を見るYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/9/ZCytwLcADRV9_v1.png", :dialogue [], :rect [0 0.4485 0.494 0.2698]} {:id "panel:voiWQhGpyR-K", :panelNumber 4, :visual "壁の時計。針がゆっくり進む。2時45分。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/9/voiWQhGpyR-K_v1.png", :dialogue [], :rect [0.6226 0.7302 0.3774 0.2698]} {:id "panel:t0B_3ih3kdTp", :panelNumber 5, :visual "早く帰りたいYuto。期待と焦りが入り混じった表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/9/t0B_3ih3kdTp_v1.png", :dialogue [{:text "（早く帰って届いてるか確認したい…）", :speaker "Yuto"}], :rect [0 0.7302 0.6106 0.2698]}]} {:pageNumber 78, :title "Arc 0-1: 「パスワードは覚えるな」 — 3日後 - 届かない", :panels [{:id "panel:7Hcd6Zdc_r8Q", :panelNumber 1, :visual "インタータイトル「3日後」。曇り空。Yutoの家の外観。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/10/7Hcd6Zdc_r8Q_v1.png", :dialogue [], :rect [0 0 1 0.3378], :tilt 20} {:id "panel:o6BEpt-Mj-Je", :panelNumber 2, :visual "郵便受けを確認するYuto。期待の表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/10/o6BEpt-Mj-Je_v1.png", :dialogue [], :rect [0.3894 0.3498 0.6106 0.2087]} {:id "panel:unhHlrzGJzt4", :panelNumber 3, :visual "空の郵便受け。何も入っていない。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/10/unhHlrzGJzt4_v1.png", :dialogue [], :rect [0 0.3498 0.3774 0.2087]} {:id "panel:GnVaJ34K21P1", :panelNumber 4, :visual "落胆するYutoの表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/10/GnVaJ34K21P1_v1.png", :dialogue [], :rect [0.506 0.5705 0.494 0.2087]} {:id "panel:5rTNblV1YMF2", :panelNumber 5, :visual "部屋でスマホを見るYuto。配送状況を確認。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/10/5rTNblV1YMF2_v1.png", :dialogue [], :rect [0 0.5705 0.494 0.2087]} {:id "panel:0-C9bjs6uBJA", :panelNumber 6, :visual "配送状況画面。「配送準備中」のまま変わらない。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/10/0-C9bjs6uBJA_v1.png", :dialogue [{:text "なんで届かないんだ…？", :speaker "Yuto"}], :rect [0 0.7913 1 0.2087]}]} {:pageNumber 79, :title "Arc 0-1: 「パスワードは覚えるな」 — 親切な出品者", :panels [{:id "panel:aHnd5ev-MRsm", :panelNumber 1, :visual "スマホでメッセージを打つYuto。心配そうな表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/aHnd5ev-MRsm_v1.png", :dialogue [], :rect [0.3894 0 0.6106 0.241]} {:id "panel:Vw0vVnshyor8", :panelNumber 2, :visual "メッセージ画面。Yutoが丁寧に問い合わせを送信。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/Vw0vVnshyor8_v1.png", :dialogue [{:text "すみません、まだ届かないんですが…", :speaker "Yuto"}], :rect [0 0 0.3774 0.241]} {:id "panel:hfeK7PPVA28z", :panelNumber 3, :visual "即座に返信。やけに丁寧で親しみやすい文面。顔文字付き。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/hfeK7PPVA28z_v1.png", :dialogue [{:text "お問い合わせありがとうございます！確認させてください(^^)", :speaker "出品者"}], :rect [0.506 0.253 0.494 0.241]} {:id "panel:KdsQf7l19Aou", :panelNumber 4, :visual "続けて返信。「配送元に確認したら住所確認が必要みたいです」申し訳なさそうな絵文字。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/KdsQf7l19Aou_v1.png", :dialogue [{:text "配送元に確認したところ、住所確認が必要みたいです💦 お手数おかけしてすみません！", :speaker "出品者"}], :rect [0 0.253 0.494 0.241]} {:id "panel:GJAePeQuNhYv", :panelNumber 5, :visual "安心した表情のYuto。丁寧な対応に警戒心が緩む。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/GJAePeQuNhYv_v1.png", :dialogue [{:text "ちゃんと対応してくれる人でよかった…", :speaker "Yuto（内心）"}], :rect [0.3894 0.506 0.6106 0.241]} {:id "panel:G3UC6og9WW0e", :panelNumber 6, :visual "核心のメッセージ。「SMSで確認番号が届くので教えて」配送会社への確認という口実。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/G3UC6og9WW0e_v1.png", :dialogue [{:text "今からSMSで確認番号が届くので、その番号を教えてもらえますか？配送会社への本人確認に使います！", :speaker "出品者"}], :rect [0 0.506 0.3774 0.241]} {:id "panel:LOlh8jYxLWxE", :panelNumber 7, :visual "YutoのスマホにSMS通知が届く。ブルッと振動。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/LOlh8jYxLWxE_v1.png", :dialogue [], :rect [0.3894 0.759 0.6106 0.241]} {:id "panel:fnL7srMXc3cI", :panelNumber 8, :visual "SMS画面。「【SNS名】認証コード: 847293 ※このコードは絶対に他人に教えないでください」警告文がはっきり見える。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/11/fnL7srMXc3cI_v1.png", :dialogue [], :rect [0 0.759 0.3774 0.241]}]} {:pageNumber 80, :title "Arc 0-1: 「パスワードは覚えるな」 — 番号を教える", :panels [{:id "panel:n8lIihAxjh0f", :panelNumber 1, :visual "SMSの認証コードを見るYuto。信じきった表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/12/n8lIihAxjh0f_v1.png", :dialogue [{:text "配送会社の確認なら…教えても大丈夫だよな", :speaker "Yuto（内心）"}], :rect [0.3894 0 0.6106 0.241]} {:id "panel:dxFHfBsaPPvC", :panelNumber 2, :visual "SMS画面の警告文「※このコードは絶対に他人に教えないでください」しかしYutoの指がスワイプして通り過ぎる。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/12/dxFHfBsaPPvC_v1.png", :dialogue [], :rect [0 0 0.3774 0.241]} {:id "panel:PZbaVhaeq7HP", :panelNumber 3, :visual "メッセージ画面。認証コード「847293」を送信。運命の瞬間。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/12/PZbaVhaeq7HP_v1.png", :dialogue [{:text "847293 です！", :speaker "Yuto"}], :rect [0.506 0.253 0.494 0.241]} {:id "panel:8ygFNWmeJaho", :panelNumber 4, :visual "即座に返信。「ありがとうございます！確認できました」キラキラ絵文字。詐欺師は目的を達成。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/12/8ygFNWmeJaho_v1.png", :dialogue [{:text "ありがとうございます！確認できました✨ これで発送手続き進められます！", :speaker "出品者"}], :rect [0 0.253 0.494 0.241]} {:id "panel:XW5_CP1qMEv0", :panelNumber 5, :visual "安堵してスマホを置くYuto。自分が何をしたか気づいていない。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/12/XW5_CP1qMEv0_v1.png", :dialogue [{:text "よかった…これで届くはず", :speaker "Yuto"}], :rect [0.3894 0.506 0.6106 0.241]} {:id "panel:R641xuqebmXw", :panelNumber 6, :visual "時間経過。新しい通知「パスワードが変更されました」SNSからの通知。乗っ取りの始まり。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/12/R641xuqebmXw_v1.png", :dialogue [], :rect [0 0.506 0.3774 0.241]} {:id "panel:rW0M2p0-cLQb", :panelNumber 7, :visual "困惑から不安に変わるYutoの表情。何かがおかしいと気づき始める。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/12/rW0M2p0-cLQb_v1.png", :dialogue [{:text "え…？パスワード変更…？俺、何もしてないのに…", :speaker "Yuto"}], :rect [0 0.759 1 0.241], :tilt 20}]} {:pageNumber 81, :title "Arc 0-1: 「パスワードは覚えるな」 — カードが止まる", :panels [{:id "panel:5pETRbZ7RNFl", :panelNumber 1, :visual "リビング。母親が電話中。険しい表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/5pETRbZ7RNFl_v1.png", :dialogue [], :rect [0 0 1 0.3378], :tilt 20} {:id "panel:J1Ml1HnTtlC2", :panelNumber 2, :visual "電話を切る母親。怒りを抑えた表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/J1Ml1HnTtlC2_v1.png", :dialogue [], :rect [0.506 0.3498 0.494 0.2087]} {:id "panel:f_DrovkUR8EP", :panelNumber 3, :visual "部屋に入ってくるYuto。母親の様子がおかしいことに気づく。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/f_DrovkUR8EP_v1.png", :dialogue [], :rect [0 0.3498 0.494 0.2087]} {:id "panel:ZKkkG8B5RO0i", :panelNumber 4, :visual "母親がYutoを見る。厳しい目。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/ZKkkG8B5RO0i_v1.png", :dialogue [{:text "Yuto。", :speaker "YutoMother"}], :rect [0.506 0.5705 0.494 0.2087]} {:id "panel:1XC91KYk-h4j", :panelNumber 5, :visual "母親が問い詰める。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/1XC91KYk-h4j_v1.png", :dialogue [{:text "カードが止められたって。身に覚えある…？", :speaker "YutoMother"}], :rect [0 0.5705 0.494 0.2087]} {:id "panel:c1NW9w-ED_u4", :panelNumber 6, :visual "青ざめるYuto。血の気が引いていく。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/c1NW9w-ED_u4_v1.png", :dialogue [{:text "え…？", :speaker "Yuto"}], :rect [0 0.7913 1 0.2087]}]} {:pageNumber 82, :title "Arc 0-1: 「パスワードは覚えるな」 — 不正請求発覚", :panels [{:id "panel:VVI-_-rJ77MH", :panelNumber 1, :visual "母親がカード明細を広げる。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/VVI-_-rJ77MH_v1.png", :dialogue [], :rect [0.3894 0 0.6106 0.3253]} {:id "panel:zCkKcizVOdLy", :panelNumber 2, :visual "カード明細のアップ。大量の請求が並ぶ。「Amazonギフトカード」「iTunesギフトカード」…", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/zCkKcizVOdLy_v1.png", :dialogue [], :rect [0 0 0.3774 0.3253]} {:id "panel:-P3DxROvzFYP", :panelNumber 3, :visual "合計金額。¥523,000。赤い数字。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/18/yTE-IgefJ8FG_v1.png", :dialogue [], :rect [0.6226 0.3373 0.3774 0.3253]} {:id "panel:0hmxsZf1RCRw", :panelNumber 4, :visual "明細を見るYuto。目が見開く。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/0hmxsZf1RCRw_v1.png", :dialogue [], :rect [0 0.3373 0.6106 0.3253]} {:id "panel:6qrehMtL2koX", :panelNumber 5, :visual "母親が説明を求める。指で明細を指している。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/18/XwKeBPFzaOy7_v1.png", :dialogue [{:text "これ、全部ギフトカード購入になってる。知らない店ばっかり。", :speaker "YutoMother"}], :rect [0.506 0.6747 0.494 0.3253], :tilt 20} {:id "panel:VDz7Y-SZGjsD", :panelNumber 6, :visual "パニック状態のYuto。必死に否定。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/18/T_hrhxR8CpNw_v1.png", :dialogue [{:text "俺、そんなの買ってない…！", :speaker "Yuto"}], :rect [0 0.6747 0.494 0.3253], :tilt 20}]} {:pageNumber 83, :title "Arc 0-1: 「パスワードは覚えるな」 — サイト消失", :panels [{:id "panel:FZXzPsEGmR1J", :panelNumber 1, :visual "自分の部屋に逃げ込むYuto。スマホを取り出す。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/FZXzPsEGmR1J_v1.png", :dialogue [], :rect [0.506 0 0.494 0.3253]} {:id "panel:EKnVq7X9ndTR", :panelNumber 2, :visual "焦ってスマホを操作するYuto。履歴から「アクター通販」を探す。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/EKnVq7X9ndTR_v1.png", :dialogue [], :rect [0 0 0.494 0.3253]} {:id "panel:yTE-IgefJ8FG", :panelNumber 3, :visual "ブラウザ読み込み中…", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/18/yTE-IgefJ8FG_v1.png", :dialogue [], :rect [0.506 0.3373 0.494 0.3253]} {:id "panel:-g8Jn2ZDUeO3", :panelNumber 4, :visual "エラー画面。「404 Not Found」「このページは存在しません」", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/18/-g8Jn2ZDUeO3_v1.png", :dialogue [], :rect [0 0.3373 0.494 0.3253]} {:id "panel:XwKeBPFzaOy7", :panelNumber 5, :visual "目が見開き、恐怖に震えるYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/18/XwKeBPFzaOy7_v1.png", :dialogue [{:text "サイトが…消えてる…？", :speaker "Yuto"}], :rect [0.506 0.6747 0.494 0.3253]} {:id "panel:T_hrhxR8CpNw", :panelNumber 6, :visual "全てを理解してしまったYuto。不安の頂点。暗い部屋に一人。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/18/T_hrhxR8CpNw_v1.png", :dialogue [{:text "もしかして…騙された…？", :speaker "Yuto"}], :rect [0 0.6747 0.494 0.3253]}]} {:pageNumber 84, :title "Arc 0-1: 「パスワードは覚えるな」 — 学校 - 詰め寄られる", :panels [{:id "panel:IRgUorxud4sZ", :panelNumber 1, :visual "翌日。教室入口に立つYuto。重い足取り。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/IRgUorxud4sZ_v1.png", :dialogue [], :rect [0 0 1 0.247]} {:id "panel:zFlLtPVKNHHT", :panelNumber 2, :visual "教室内。クラスメイトたちの視線がYutoに集まる。ざわめきが止まる。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/zFlLtPVKNHHT_v1.png", :dialogue [], :rect [0.506 0.259 0.494 0.1527]} {:id "panel:zkUedNfYEtWx", :panelNumber 3, :visual "何かがおかしいと気づくYuto。不安な表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/zkUedNfYEtWx_v1.png", :dialogue [], :rect [0 0.259 0.494 0.1527]} {:id "panel:2cU9Eyljiugw", :panelNumber 4, :visual "友人Aが立ち上がり、Yutoに近づく。怒りの表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/2cU9Eyljiugw_v1.png", :dialogue [], :rect [0.506 0.4237 0.494 0.1527]} {:id "panel:yLgDH2es9Am3", :panelNumber 5, :visual "詰め寄る友人A。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/yLgDH2es9Am3_v1.png", :dialogue [{:text "おい、昨日のメッセージなんだよ？", :speaker "Ken"}], :rect [0 0.4237 0.494 0.1527]} {:id "panel:dQsgdtLHbiYn", :panelNumber 6, :visual "困惑するYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/dQsgdtLHbiYn_v1.png", :dialogue [{:text "メッセージ…？", :speaker "Yuto"}], :rect [0 0.5883 1 0.1527]} {:id "panel:ZNkHlL7TRdDr", :panelNumber 7, :visual "周囲のクラスメイトも敵意の目でYutoを見ている。包囲される感覚。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/13/ZNkHlL7TRdDr_v1.png", :dialogue [], :rect [0 0.753 1 0.247], :tilt 10}]} {:pageNumber 85, :title "Arc 0-1: 「パスワードは覚えるな」 — 乗っ取り発覚", :panels [{:id "panel:jI9xbUe-TD6m", :panelNumber 1, :visual "友人Aがスマホをつきつける。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/jI9xbUe-TD6m_v1.png", :dialogue [{:text "お前のアカウントから、こんなの送られてきたんだけど！", :speaker "Ken"}], :rect [0.3894 0 0.6106 0.1695]} {:id "panel:uqjX1jz3WtBn", :panelNumber 2, :visual "スマホ画面。Yutoのアカウントから送られたDM。「これ見て！最高！」と怪しいリンク。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/uqjX1jz3WtBn_v1.png", :dialogue [], :rect [0 0 0.3774 0.1695]} {:id "panel:U0A59J0HZnbN", :panelNumber 3, :visual "別のDM。「お前、実はウザいって思ってたwww」という侮辱メッセージ。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/U0A59J0HZnbN_v1.png", :dialogue [], :rect [0.6226 0.1815 0.3774 0.1695]} {:id "panel:_c4bsaSercoX", :panelNumber 4, :visual "愕然とするYuto。目が見開く。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/_c4bsaSercoX_v1.png", :dialogue [], :rect [0 0.1815 0.6106 0.1695]} {:id "panel:FIfFDiegDdmc", :panelNumber 5, :visual "必死に否定するYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/FIfFDiegDdmc_v1.png", :dialogue [{:text "俺、そんなの送ってない…！", :speaker "Yuto"}], :rect [0.506 0.3629 0.494 0.1695]} {:id "panel:zbhYfmWGeLGj", :panelNumber 6, :visual "別の友人Bも被害に。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/zbhYfmWGeLGj_v1.png", :dialogue [{:text "俺もリンク踏んだら、変なサイトに飛ばされた…", :speaker "Shota"}], :rect [0 0.3629 0.494 0.1695]} {:id "panel:f7hvztp5XnBu", :panelNumber 7, :visual "Sakiも心配そうに告白。彼女もリンクを踏んでしまった（後でこれが彼女のアカウント乗っ取りにつながる）。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/f7hvztp5XnBu_v1.png", :dialogue [{:text "私も踏んじゃった…なんか変なの出てきて…", :speaker "Saki"}], :rect [0.506 0.5444 0.494 0.1695]} {:id "panel:nM_6lPxtpiIV", :panelNumber 8, :visual "さらに別の友人C。被害の連鎖。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/nM_6lPxtpiIV_v1.png", :dialogue [{:text "俺のアカウントもなんかおかしくなった…", :speaker "Tsubasa"}], :rect [0 0.5444 0.494 0.1695]} {:id "panel:Dfw1HGQjiS_6", :panelNumber 9, :visual "四方から責められるYuto。孤立していく。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/14/Dfw1HGQjiS_6_v1.png", :dialogue [], :rect [0 0.7258 1 0.2742], :tilt 10}]} {:pageNumber 86, :title "Arc 0-1: 「パスワードは覚えるな」 — 悪口公開 - 友情崩壊", :panels [{:id "panel:4-vkALuzaJpb", :panelNumber 1, :visual "Meiがスマホを見て、ショックを受けている。信じられないという表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/4-vkALuzaJpb_v1.png", :dialogue [], :rect [0.3894 0 0.6106 0.142]} {:id "panel:bSR3UAsX-V77", :panelNumber 2, :visual "Sakiの鍵垢だったはずの投稿が公開されている。「Meiってマジうざい、いつも自慢ばっか」「Akiraってスニーカーで調子乗りすぎw」「親友のフリ疲れた」。@saki_privateというアカウント名。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/bSR3UAsX-V77_v1.png", :dialogue [], :rect [0 0 0.3774 0.142]} {:id "panel:9bSnv874Z_Ha", :panelNumber 3, :visual "涙が滲むMei。親友だと思っていたSakiに裏切られた衝撃。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/9bSnv874Z_Ha_v1.png", :dialogue [{:text "Saki…親友だと思ってたのに…", :speaker "Mei"}], :rect [0.506 0.154 0.494 0.142]} {:id "panel:Vs-A5JUUhuGR", :panelNumber 4, :visual "パニック状態のSaki。必死に弁明しようとする。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/Vs-A5JUUhuGR_v1.png", :dialogue [{:text "ちがっ…！あれは愚痴で…本気じゃなくて…！", :speaker "Saki"}], :rect [0 0.154 0.494 0.142]} {:id "panel:0H6cOmJiSp9K", :panelNumber 5, :visual "Akiraの傷ついた表情。Sakiに「スニーカーで調子乗りすぎ」と言われていたことを知り、いつもの自信が崩れる。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/0H6cOmJiSp9K_v1.png", :dialogue [], :rect [0.506 0.3081 0.494 0.142]} {:id "panel:vESVmFT24T7g", :panelNumber 6, :visual "Ken（田中健）がYutoを指差して罵倒。Yutoの乗っ取られたアカウントが発端だと責める。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/vESVmFT24T7g_v1.png", :dialogue [{:text "全部お前（Yuto）のせいだろ！お前が変なリンク送ってきたから！", :speaker "Ken"}], :rect [0 0.3081 0.494 0.142]} {:id "panel:XWLnVQ3DLlpI", :panelNumber 7, :visual "言葉を失うYuto。自分が起点になった連鎖に反論できない。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/XWLnVQ3DLlpI_v1.png", :dialogue [], :rect [0.506 0.4621 0.494 0.142]} {:id "panel:xOyBP9vpYSm_", :panelNumber 8, :visual "さっきまで仲良しだったMeiとSaki。今は顔を背け合う。壊れた友情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/xOyBP9vpYSm__v1.png", :dialogue [], :rect [0 0.4621 0.494 0.142]} {:id "panel:IoHhzoodP8QN", :panelNumber 9, :visual "孤立するYuto。クラスが分断され、ギスギスした空気。全ての起点となった自分を責める。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/15/IoHhzoodP8QN_v1.png", :dialogue [{:text "（俺のせいで…みんなが…）", :speaker "Yuto"}], :rect [0 0.6161 1 0.2298], :tilt 20} {:id nil, :panelNumber 7, :visual "息ができなくなるYuto。胸を押さえる。", :imageUrl nil, :dialogue [{:text "（息ができない…）", :speaker "Yuto"}], :rect [0 0.858 1 0.142]}]} {:pageNumber 87, :title "Arc 0-1: 「パスワードは覚えるな」 — 完全ロックアウト", :panels [{:id "panel:1azm0XiVJWPc", :panelNumber 1, :visual "必死にスマホを操作するYuto。ログインを試みる。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/19/1azm0XiVJWPc_v1.png", :dialogue [], :rect [0.3894 0 0.6106 0.2087]} {:id "panel:XITk7yH979I5", :panelNumber 2, :visual "ログイン画面。パスワード入力。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/19/XITk7yH979I5_v1.png", :dialogue [], :rect [0 0 0.3774 0.2087]} {:id "panel:mcbsvmrPo1iY", :panelNumber 3, :visual "エラー表示。「パスワードが正しくありません」", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/19/mcbsvmrPo1iY_v1.png", :dialogue [], :rect [0.506 0.2207 0.494 0.2087]} {:id "panel:ZLdl0Fs_5fEw", :panelNumber 4, :visual "パスワードリセット画面。「このメールアドレスは登録されていません」", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/19/ZLdl0Fs_5fEw_v1.png", :dialogue [], :rect [0 0.2207 0.494 0.2087]} {:id "panel:3hEMtPGR1gWH", :panelNumber 5, :visual "絶望するYuto。全てを失った表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/19/3hEMtPGR1gWH_v1.png", :dialogue [{:text "入れない…もう何もできない…", :speaker "Yuto"}], :rect [0 0.4415 1 0.2087]} {:id "panel:mwpakEOJcf91", :panelNumber 6, :visual "教室の隅で一人座るYuto。周囲は彼を避けて通る。完全な孤立。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/19/mwpakEOJcf91_v1.png", :dialogue [], :rect [0 0.6622 1 0.3378], :tilt 20}]} {:pageNumber 88, :title "Arc 0-1: 「パスワードは覚えるな」 — Neiの声かけ", :panels [{:id "panel:uNn2WhN9O-lB", :panelNumber 1, :visual "放課後の教室。窓からの夕日。机に突っ伏すYuto。一人きり。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/20/uNn2WhN9O-lB_v1.png", :dialogue [], :rect [0 0 1 0.3378]} {:id "panel:RSJ2UDGjXfrP", :panelNumber 2, :visual "机に顔を埋めるYuto。肩が小さく震えている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/20/RSJ2UDGjXfrP_v1.png", :dialogue [{:text "（全部俺のせいだ…）", :speaker "Yuto"}], :rect [0.506 0.3498 0.494 0.2087]} {:id "panel:efCg2VTeYo5L", :panelNumber 3, :visual "教室の入口に立つNei。静かにYutoを見ている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/20/efCg2VTeYo5L_v1.png", :dialogue [], :rect [0 0.3498 0.494 0.2087]} {:id "panel:9QaElDi7YYIV", :panelNumber 4, :visual "Neiが静かに歩み寄る。足音が響く。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/20/9QaElDi7YYIV_v1.png", :dialogue [], :rect [0.506 0.5705 0.494 0.2087]} {:id "panel:BhND66FF2iAO", :panelNumber 5, :visual "Yutoの隣に立つNei。優しく声をかける。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/20/BhND66FF2iAO_v1.png", :dialogue [{:text "大丈夫？", :speaker "Nei"}], :rect [0 0.5705 0.494 0.2087]} {:id "panel:ZJ_chAkKYtbZ", :panelNumber 6, :visual "顔を上げるYuto。涙が滲んだ目。言葉がこぼれ出る。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/20/ZJ_chAkKYtbZ_v1.png", :dialogue [{:text "…俺、やってない…でも、クリックしちゃって…", :speaker "Yuto"}], :rect [0 0.7913 1 0.2087]}]} {:pageNumber 89, :title "Arc 0-1: 「パスワードは覚えるな」 — Ren/Nei動き出す", :panels [{:id "panel:b4q3CiJf8ORp", :panelNumber 1, :visual "Neiが静かにYutoの話を聞いている。事情を理解した表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/21/b4q3CiJf8ORp_v1.png", :dialogue [], :rect [0.506 0 0.494 0.3253]} {:id "panel:NtedpzrQUIcv", :panelNumber 2, :visual "Neiが頷き、振り返る。教室の隅にいるRenの方を見る。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/21/NtedpzrQUIcv_v1.png", :dialogue [], :rect [0 0 0.494 0.3253]} {:id "panel:MXhpf2c2j5dy", :panelNumber 3, :visual "窓際で机に突っ伏しているRen。半目で二人を見ている。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/21/MXhpf2c2j5dy_v1.png", :dialogue [], :rect [0.506 0.3373 0.494 0.3253]} {:id "panel:IF7uYv3U4KEL", :panelNumber 4, :visual "Neiが静かに問いかける。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/21/IF7uYv3U4KEL_v1.png", :dialogue [{:text "ghost。どうする？", :speaker "Nei"}], :rect [0 0.3373 0.494 0.3253]} {:id "panel:L-PAW0765Nh3", :panelNumber 5, :visual "Renがゆっくり体を起こす。伸びをする。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/21/L-PAW0765Nh3_v1.png", :dialogue [], :rect [0.506 0.6747 0.494 0.3253], :tilt 10} {:id "panel:nNFRIb3aSZF8", :panelNumber 6, :visual "面倒くさそうだが、やる気の表情のRen。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/21/nNFRIb3aSZF8_v1.png", :dialogue [{:text "あー。だるいけど…やるか。", :speaker "Ren"}], :rect [0 0.6747 0.494 0.3253], :tilt 10}]} {:pageNumber 90, :title "Arc 0-1: 「パスワードは覚えるな」 — 対策① 漏えいチェック（説明）", :panels [{:id "panel:pBvz4HwvBB23", :panelNumber 1, :visual "3人が机を囲んでいる。Neiがスマホを操作。Renは傍観。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/22/pBvz4HwvBB23_v1.png", :dialogue [], :rect [0 0 1 0.4365]} {:id "panel:b9Cdz4YCIaxp", :panelNumber 2, :visual "ぷにNEIのアドバイスカード。「#1 漏えいチェック」", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/22/b9Cdz4YCIaxp_v2.png", :dialogue [{:text "【NEIちゃんのアドバイス #1】", :speaker "NeiPuni"}], :rect [0.6226 0.4485 0.3774 0.2698]} {:id "panel:znrMGVq4zKBr", :panelNumber 3, :visual "Neiが説明する。指を立てて。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/22/znrMGVq4zKBr_v1.png", :dialogue [{:text "まず「見える化」。どこから漏れたか確認する。", :speaker "Nei"}], :rect [0 0.4485 0.6106 0.2698]} {:id "panel:AyqIoEvBdIue", :panelNumber 4, :visual "漏えいチェックサイト（Have I Been Pwned風）の入力画面。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/22/AyqIoEvBdIue_v1.png", :dialogue [], :rect [0.6226 0.7302 0.3774 0.2698]} {:id "panel:jpxJeOfARjZh", :panelNumber 5, :visual "不安げに画面を見るYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/22/jpxJeOfARjZh_v1.png", :dialogue [], :rect [0 0.7302 0.6106 0.2698]}]} {:pageNumber 91, :title "Arc 0-1: 「パスワードは覚えるな」 — 対策① 漏えいチェック（実行）", :panels [{:id "panel:Ophs-TIfjvna", :panelNumber 1, :visual "結果画面。赤い警告。「5件の漏えいが見つかりました」", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/23/Ophs-TIfjvna_v1.png", :dialogue [], :rect [0.506 0 0.494 0.3253]} {:id "panel:bpyvsWK6e_mf", :panelNumber 2, :visual "漏えいしたサービスのリスト。SNS、ゲームサイト、通販サイトなど。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/23/bpyvsWK6e_mf_v1.png", :dialogue [{:text "ここに足あとがある。複数のサイトに漏えいしてる。", :speaker "Nei"}], :rect [0 0 0.494 0.3253]} {:id "panel:rl4hWDLPHU36", :panelNumber 3, :visual "ショックを受けるYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/23/rl4hWDLPHU36_v1.png", :dialogue [{:text "こんなに…", :speaker "Yuto"}], :rect [0.506 0.3373 0.494 0.3253]} {:id "panel:jdYAwZqbOzun", :panelNumber 4, :visual "Neiが冷静に続ける。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/23/jdYAwZqbOzun_v1.png", :dialogue [{:text "同じパスワード、使い回してた？", :speaker "Nei"}], :rect [0 0.3373 0.494 0.3253]} {:id "panel:kOrqnz_I23Of", :panelNumber 5, :visual "図星のYuto。頷く。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/23/kOrqnz_I23Of_v1.png", :dialogue [{:text "…うん…", :speaker "Yuto"}], :rect [0 0.6747 1 0.3253], :tilt 10}]} {:pageNumber 92, :title "Arc 0-1: 「パスワードは覚えるな」 — 対策② 不正請求の申請（説明）", :panels [{:id "panel:i8ZWG31W-FEG", :panelNumber 1, :visual "ぷにNEIのアドバイスカード。「#2 不正請求の申請」", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/24/i8ZWG31W-FEG_v1.png", :dialogue [{:text "【NEIちゃんのアドバイス #2】", :speaker "NeiPuni"}], :rect [0.6226 0 0.3774 0.3253]} {:id "panel:_cfZl0YpNeVG", :panelNumber 2, :visual "Neiが希望を持たせる表情で語る。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/24/_cfZl0YpNeVG_v1.png", :dialogue [{:text "カードは止めた。でも、まだやることがある。", :speaker "Nei"}], :rect [0 0 0.6106 0.3253]} {:id "panel:Gx9v1YZgz22_", :panelNumber 3, :visual "Neiが両手を開いて説明。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/24/Gx9v1YZgz22__v1.png", :dialogue [{:text "不正に使われたお金、申告すれば返ってくるかも。", :speaker "Nei"}], :rect [0.506 0.3373 0.494 0.3253]} {:id "panel:Wk3PVVF0rBLs", :panelNumber 4, :visual "Yutoが驚きと希望の表情。目が見開く。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/24/Wk3PVVF0rBLs_v1.png", :dialogue [{:text "え…本当に？", :speaker "Yuto"}], :rect [0 0.3373 0.494 0.3253]} {:id "panel:cXiZ7klkxRPo", :panelNumber 5, :visual "Neiが人差し指を立てて自信ある表情。「チャージバック」を説明。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/24/cXiZ7klkxRPo_v1.png", :dialogue [{:text "「チャージバック」。カード会社に不正利用を申告するの。", :speaker "Nei"}], :rect [0 0.6747 1 0.3253]}]} {:pageNumber 93, :title "Arc 0-1: 「パスワードは覚えるな」 — 対策② 不正請求の申請（実行）", :panels [{:id "panel:pmndW4naUs_z", :panelNumber 1, :visual "Yutoが母親に電話をかける。決意の表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/25/pmndW4naUs_z_v2.png", :dialogue [], :rect [0.506 0 0.494 0.3253]} {:id "panel:M-nak5VogsW1", :panelNumber 2, :visual "電話口で真剣に説明するYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/25/M-nak5VogsW1_v1.png", :dialogue [{:text "ママ、不正利用の申告もしてほしい。チャージバックっていうの。", :speaker "Yuto"}], :rect [0 0 0.494 0.3253]} {:id "panel:Cswf5GNtvh6W", :panelNumber 3, :visual "電話画面。「ママ」と表示。通話中。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/25/Cswf5GNtvh6W_v2.png", :dialogue [{:text "…わかった。カード会社にすぐ連絡する。", :speaker "YutoMother"}], :rect [0.6226 0.3373 0.3774 0.3253]} {:id "panel:-BIiGL94P9Kv", :panelNumber 4, :visual "希望と不安が入り混じった表情のYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/25/-BIiGL94P9Kv_v1.png", :dialogue [{:text "お金…戻ってくるかな…", :speaker "Yuto"}], :rect [0 0.3373 0.6106 0.3253]} {:id "panel:stRgBTZc6rXo", :panelNumber 5, :visual "Neiが安心させる笑顔。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/25/stRgBTZc6rXo_v1.png", :dialogue [{:text "大丈夫。不正利用なら、ほとんど返ってくる。", :speaker "Nei"}], :rect [0.506 0.6747 0.494 0.3253], :tilt 10} {:id "panel:EPZbE579CMIX", :panelNumber 6, :visual "Neiが頷く。次のステップへ。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/25/EPZbE579CMIX_v1.png", :dialogue [{:text "よし。次。", :speaker "Nei"}], :rect [0 0.6747 0.494 0.3253], :tilt 10}]} {:pageNumber 94, :title "Arc 0-1: 「パスワードは覚えるな」 — 対策③ パスワード管理（説明）", :panels [{:id "panel:lsb5GScNC6YB", :panelNumber 1, :visual "ぷにNEIのアドバイスカード。「#3 パスワード管理」", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/26/lsb5GScNC6YB_v1.png", :dialogue [{:text "【NEIちゃんのアドバイス #3】", :speaker "NeiPuni"}], :rect [0.6226 0 0.3774 0.3253]} {:id "panel:_Nqi8yasP687", :panelNumber 2, :visual "Neiが核心を伝える。強調するような表情。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/26/_Nqi8yasP687_v1.png", :dialogue [{:text "パスワードは覚えるな。", :speaker "Nei"}], :rect [0 0 0.6106 0.3253]} {:id "panel:DvOUf3qBH2sW", :panelNumber 3, :visual "Neiがさらに続ける。エピソードタイトルのキービジュアル。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/26/DvOUf3qBH2sW_v1.png", :dialogue [{:text "作って、預けるんだ。", :speaker "Nei"}], :rect [0.506 0.3373 0.494 0.3253]} {:id "panel:i3DZL6TXqTFF", :panelNumber 4, :visual "困惑するYuto。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/26/i3DZL6TXqTFF_v1.png", :dialogue [{:text "覚えないって…どうやって…？", :speaker "Yuto"}], :rect [0 0.3373 0.494 0.3253]} {:id "panel:uV96urvniGNA", :panelNumber 5, :visual "Neiがスマホを取り出す。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/26/uV96urvniGNA_v1.png", :dialogue [], :rect [0.3894 0.6747 0.6106 0.3253]} {:id "panel:nesHcqjzp-2z", :panelNumber 6, :visual "パスワードマネージャーアプリのアイコン。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/26/nesHcqjzp-2z_v1.png", :dialogue [{:text "これ。", :speaker "Nei"}], :rect [0 0.6747 0.3774 0.3253]}]} {:pageNumber 95, :title "Arc 0-1: 「パスワードは覚えるな」 — 対策③ パスワード管理（実行）", :panels [{:id "panel:1_JrOiHx5NyU", :panelNumber 1, :visual "パスワードマネージャーアプリの画面。金庫のようなUI。", :imageUrl "/images/episodes/episode:arc0-1-origin/pages/27/1_JrOiHx5NyU_v2.png", :dialogu